+#[test]
+fn face_c_endpoint_transport_rejects_unbound_boundary_and_outside_targets() {
+    let p = BTreeMap::from([
+        (0, [0., 0., 0.]),
+        (1, [0., -1., -1.]),
+        (2, [0., 1., -1.]),
+        (3, [0., 1., 1.]),
+        (4, [0., -1., 1.]),
+    ]);
+    let t = vec![vec![0, 2, 1], vec![0, 3, 2], vec![0, 4, 3], vec![0, 1, 4]];
+    let d = audit(&p, &t, [[1, 0], [0, 3]], 0).unwrap();
+    let source = json!({"perTriangleSourceBounds":[0.001,0.001,0.001,0.001],"triangleCount":4,
+        "fullClosedTriangleDomainsCovered":true,"sharedEdgeRootsAgreeByCommonSlabUniqueness":true,"tolerance":0.01,"commonWorldXSlab":[-1.,1.]});
+    let good = [I::point(0.), I::point(1e-6), I::point(1e-6)];
+    assert!(endpoint_transport(&d, &p, &source, 0, good, 0.01).is_ok());
+    assert_eq!(
+        endpoint_transport(&d, &p, &source, 1, good, 0.01),
+        Err("endpoint_transport_scope")
+    );
+    assert_eq!(
+        endpoint_transport(
+            &d,
+            &p,
+            &source,
+            0,
+            [I::point(0.), I::point(2.), I::point(0.)],
+            0.01
+        ),
+        Err("endpoint_transport_outside_star_kernel")
+    );
+    assert_eq!(
+        endpoint_transport(
+            &d,
+            &p,
+            &source,
+            0,
+            [I::point(2.), I::point(0.), I::point(0.)],
+            0.01
+        ),
+        Err("endpoint_transport_slab")
+    );
+    assert_eq!(
+        endpoint_transport(
+            &d,
+            &p,
+            &source,
+            0,
+            [I::point(0.), I::point(0.1), I::point(0.1)],
+            0.01
+        ),
+        Err("endpoint_transport_error_limit")
+    );
+    let mut bad = source.clone();
+    bad["perTriangleSourceBounds"] = json!([0.001]);
+    assert!(endpoint_transport(&d, &p, &bad, 0, good, 0.01).is_err());
+    let mut changed = p.clone();
+    changed.insert(1, [0., -1.1, -1.]);
+    assert_eq!(
+        endpoint_transport(&d, &changed, &source, 0, good, 0.01),
+        Err("endpoint_transport_point_binding")
+    );
+}
