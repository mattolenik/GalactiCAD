+//! Inject a late emission refusal, after successful source/preflight admission.
+use super::*;
+use crate::sfcc::{
+    feature_set::{compile_feature_set, SfccFeatureSet},
+    shared_twisted_proof::exposure_a::connection_a::without_resolution,
+};
+use serde_json::{json, Value};
+use std::cell::RefCell;
+
+#[derive(Clone, Default)]
+struct State {
+    enabled: bool,
+    remaining: usize,
+    events: Vec<Value>,
+}
+thread_local! {static STATE:RefCell<State>=RefCell::new(State::default());}
+struct Scope(State);
+impl Drop for Scope {
+    fn drop(&mut self) {
+        STATE.with(|s| *s.borrow_mut() = std::mem::take(&mut self.0));
+    }
+}
+fn scope() -> Scope {
+    Scope(STATE.with(|s| {
+        std::mem::replace(
+            &mut *s.borrow_mut(),
+            State {
+                enabled: true,
+                remaining: 1,
+                events: Vec::new(),
+            },
+        )
+    }))
+}
+pub(super) fn refuse_emission(raw: usize, pair: [usize; 2], range: [f64; 2]) -> bool {
+    STATE.with(|s|{
+        let mut s=s.borrow_mut();
+        if !s.enabled||s.remaining==0{return false;}
+        s.remaining-=1;
+        s.events.push(json!({"raw":raw,"pair":pair,"emissionRangeHex":range.map(f64::to_bits),"injection":"one forced emission remake refusal after successful preflight"}));
+        true
+    })
+}
+fn snapshot(f: &SfccFeatureSet) -> Value {
+    let curves:Vec<_>=f.curves.iter().map(|c|{
+        let refine=c.traced_carriers().map(|(_,_,r)|[r.curve_eps.to_bits(),r.min_cross.to_bits(),r.max_displacement.to_bits()]);
+        let samples=[c.t_min,(c.t_min+c.t_max)*0.5,c.t_max].map(|t|c.point_at_checked(t).map(|p|p.map(f64::to_bits)));
+        json!({"id":c.id,"kind":format!("{:?}",c.kind()),"pair":c.adjacent_strata,"native":c.native,"closed":c.closed,"wrap":c.param_wrap.map(f64::to_bits),"range":[c.t_min.to_bits(),c.t_max.to_bits()],"owner":c.owner_node_id,"ends":[c.corner_start,c.corner_end],"index":c.index_polyline.iter().map(|x|x.to_bits()).collect::<Vec<_>>(),"refine":refine,"chart":c.connection_identity(),"checkedSamples":samples})
+    }).collect();
+    let corners:Vec<_>=f.corners.iter().map(|c|json!({"id":c.id,"point":[c.x.to_bits(),c.y.to_bits(),c.z.to_bits()],"strata":c.strata,"ends":c.curve_ends})).collect();
+    json!({"curves":curves,"corners":corners,"unresolvedPaths":f.unresolved_branch_paths})
+}
+#[test]
+fn connection_a_rollback_late_refusal_preserves_original_geometry() {
+    let fixture: Value =
+        serde_json::from_str(include_str!("../../fixtures/shared-arc-full-knob.json")).unwrap();
+    let root =
+        crate::scene_bridge::build_csg_tree_from_json(fixture["sceneJson"].as_str().unwrap())
+            .unwrap();
+    let size =
+        fixture["cube"]["max"][0].as_f64().unwrap() - fixture["cube"]["min"][0].as_f64().unwrap();
+    let tol = crate::tolerances::resolve_tolerances(
+        &crate::tuning::SfccTuning::default(),
+        3_f64.sqrt() * size,
+    );
+    let (baseline, baseline_d) = without_resolution(|| compile_feature_set(&root, &tol));
+    let (injected, injected_d, events) = {
+        let _scope = scope();
+        let (f, d) = compile_feature_set(&root, &tol);
+        let events = STATE.with(|s| s.borrow().events.clone());
+        (f, d, events)
+    };
+    let old = snapshot(&baseline);
+    let new = snapshot(&injected);
+    let equal = old == new;
+    let charts = injected
+        .curves
+        .iter()
+        .filter(|c| c.connection_identity().is_some())
+        .count();
+    let report = json!({"scope":"test-only one late emission refusal; not an observed natural failure","injections":events,"baselineCurves":baseline.curves.len(),"injectedCurves":injected.curves.len(),"baselineCorners":baseline.corners.len(),"injectedCorners":injected.corners.len(),"baselineFingerprint":baseline.fingerprint().to_string(),"injectedFingerprint":injected.fingerprint().to_string(),"explicitGeometryEqual":equal,"installedCharts":charts,"unresolvedBefore":baseline_d.unresolved_trims,"unresolvedAfter":injected_d.unresolved_trims,"baseline":old,"injectedUsesBaseline":equal,"injected":if equal{Value::Null}else{new}});
+    std::fs::write(
+        std::env::var("SFCC_CONNECTION_A_ROLLBACK_RECEIPT")
+            .expect("root rollback receipt required"),
+        serde_json::to_vec_pretty(&report).unwrap(),
+    )
+    .unwrap();
+    assert_eq!(
+        events.len(),
+        1,
+        "actual emission hook must fire exactly once"
+    );
+    assert_eq!(
+        events[0]["pair"],
+        json!([31, 10]),
+        "original-source admitted target selected by runtime, not injection IDs"
+    );
+    assert!(equal,"late refusal must retain every original curve, range, indexing geometry, corner, source membership, refine config and checked sample");
+    assert_eq!(baseline.fingerprint(), injected.fingerprint());
+    assert_eq!(baseline.curves.len(), injected.curves.len());
+    assert_eq!(baseline_d.unresolved_trims, injected_d.unresolved_trims);
+    assert_eq!(
+        charts, 0,
+        "refusal cannot publish certified attachment authority"
+    );
+    assert!(!STATE.with(|s| s.borrow().enabled));
+}
+#[test]
+fn connection_a_rollback_scope_restores_after_unwind() {
+    let result = std::panic::catch_unwind(|| {
+        let _scope = scope();
+        assert!(refuse_emission(1, [2, 3], [0., 1.]));
+        panic!("injected unwind");
+    });
+    assert!(result.is_err());
+    assert!(!STATE.with(|s| s.borrow().enabled));
+    assert!(!refuse_emission(1, [2, 3], [0., 1.]));
+    assert!(STATE.with(|s| s.borrow().events.is_empty()));
+}
