+fn lower_joint(f: &SfccFeatureSet, tol: &ResolvedTolerances) -> Value {
+    let old: Value =
+        serde_json::from_str(include_str!("../../fixtures/exposure-b-baseline.json")).unwrap();
+    let p: [f64; 3] = std::array::from_fn(|i| {
+        f64::from_bits(
+            u64::from_str_radix(old["lowerJoint"]["pointHex"][i].as_str().unwrap(), 16).unwrap(),
+        )
+    });
+    let expected: std::collections::BTreeSet<[usize; 2]> = old["lowerJoint"]["sourcePairs"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|v| {
+            let mut a = [
+                v[0].as_u64().unwrap() as usize,
+                v[1].as_u64().unwrap() as usize,
+            ];
+            a.sort();
+            a
+        })
+        .collect();
+    let nearest = f
+        .corners
+        .iter()
+        .map(|c| (c, (c.x - p[0]).hypot(c.y - p[1]).hypot(c.z - p[2])))
+        .min_by(|a, b| a.1.total_cmp(&b.1));
+    let Some((c, distance)) = nearest else {
+        return json!({"preserved":false,"reason":"no compiled corners","expectedSourcePairs":expected});
+    };
+    let actual: std::collections::BTreeSet<[usize; 2]> = c
+        .curve_ends
+        .iter()
+        .map(|&(id, _)| {
+            let mut pair = f.curves[id].adjacent_strata;
+            pair.sort();
+            pair
+        })
+        .collect();
+    json!({"preserved":distance<=tol.corner_merge_tol&&expected.is_subset(&actual),"nearestCorner":c.id,"distanceHex":hex(distance),"toleranceHex":hex(tol.corner_merge_tol),"pointHex":[hex(c.x),hex(c.y),hex(c.z)],"expectedSourcePairs":expected,"actualSourcePairs":actual,"incidentEnds":c.curve_ends})
+}
+fn collateral(f: &SfccFeatureSet, unresolved: usize) -> Value {
+    use std::collections::{BTreeMap, BTreeSet};
+    let baseline: Value =
+        serde_json::from_str(include_str!("../../fixtures/exposure-b-baseline.json")).unwrap();
+    let current:Vec<_>=f.curves.iter().map(|c|json!({"strata":c.adjacent_strata,"rangeHex":[hex(c.t_min),hex(c.t_max)],"cornerEnds":[c.corner_start,c.corner_end],"indexPolylineHex":c.index_polyline.iter().copied().map(hex).collect::<Vec<_>>()})).collect();
+    let grouped = |curves: &[Value]| {
+        let mut families: BTreeMap<String, Vec<String>> = BTreeMap::new();
+        for c in curves {
+            let mut pair = c["strata"]
+                .as_array()
+                .unwrap()
+                .iter()
+                .map(|v| v.as_u64().unwrap())
+                .collect::<Vec<_>>();
+            pair.sort();
+            let key = format!("{pair:?}");
+            let entry = json!({"strata":c["strata"],"rangeHex":c["rangeHex"],"indexPolylineHex":c["indexPolylineHex"],
+                "wiredEnds":c["cornerEnds"].as_array().unwrap().iter().map(|v|v.as_i64().unwrap()>=0).collect::<Vec<_>>()});
+            families
+                .entry(key)
+                .or_default()
+                .push(serde_json::to_string(&entry).unwrap());
+        }
+        for rows in families.values_mut() {
+            rows.sort();
+        }
+        families
+    };
+    let old = grouped(baseline["curves"].as_array().unwrap());
+    let now = grouped(&current);
+    let keys: BTreeSet<_> = old.keys().chain(now.keys()).cloned().collect();
+    let changed:Vec<_>=keys.into_iter().filter(|k|old.get(k)!=now.get(k)).map(|k|json!({"pair":k,"baselineCurves":old.get(&k).map_or(0,Vec::len),"candidateCurves":now.get(&k).map_or(0,Vec::len)})).collect();
+    let missing = |curves: &[Value]| {
+        curves
+            .iter()
+            .flat_map(|c| c["cornerEnds"].as_array().unwrap())
+            .filter(|v| v.as_i64().unwrap() < 0)
+            .count()
+    };
+    json!({"baseline":{"curves":baseline["counts"]["curves"],"corners":baseline["counts"]["corners"],"unresolvedTrims":baseline["unresolvedTrims"],"unwiredEnds":missing(baseline["curves"].as_array().unwrap())},
+        "candidate":{"curves":f.curves.len(),"corners":f.corners.len(),"unresolvedTrims":unresolved,"unwiredEnds":missing(&current)},
+        "changedSourceFamilies":changed,"comparison":"pair-labelled indexing geometry, ranges and wired-end presence; final IDs may renumber",
+        "baselineSourceReceiptSha256":baseline["sourceReceiptSha256"],"baselineUncertaintyReceiptSha256":baseline["uncertaintyReceiptSha256"]})
+}
