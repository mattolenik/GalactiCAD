+/// Experimental query primitive: source admission remains a separate obligation.
+/// Every successful output keeps the supplied height bit-for-bit.
+#[cfg(test)]
+pub(crate) fn project_to_carrier_pair_at_height_c(
+    sa: &Stratum,
+    sb: &Stratum,
+    seed: [f64; 3],
+    eps: f64,
+    min_cross: f64,
+    max_displacement: f64,
+) -> Option<[f64; 3]> {
+    if seed.iter().any(|v| !v.is_finite()) || !eps.is_finite() || eps <= 0.
+        || !min_cross.is_finite() || min_cross < 0.
+        || !max_displacement.is_finite() || max_displacement < 0. {
+        return None;
+    }
+    let mut p = seed;
+    for _ in 0..24 {
+        let a = sa.raw_field(p[0], p[1], p[2]).normalized_equation()?;
+        let b = sb.raw_field(p[0], p[1], p[2]).normalized_equation()?;
+        let det = a.gradient[0] * b.gradient[2] - a.gradient[2] * b.gradient[0];
+        if !det.is_finite() || det.abs() <= min_cross { return None; }
+        if a.value.abs() <= eps && b.value.abs() <= eps { return Some(p); }
+        let dx = (a.value * b.gradient[2] - a.gradient[2] * b.value) / det;
+        let dz = (a.gradient[0] * b.value - a.value * b.gradient[0]) / det;
+        let before = a.value.abs().max(b.value.abs());
+        let mut alpha = 1.;
+        let mut accepted = None;
+        for _ in 0..8 {
+            let q = [p[0] - alpha * dx, seed[1], p[2] - alpha * dz];
+            let displacement = (q[0] - seed[0]).hypot(q[2] - seed[2]);
+            if q.iter().all(|v| v.is_finite()) && displacement <= max_displacement {
+                let qa = sa.raw_field(q[0], q[1], q[2]).normalized_equation()?;
+                let qb = sb.raw_field(q[0], q[1], q[2]).normalized_equation()?;
+                if qa.value.abs().max(qb.value.abs()) < before { accepted = Some(q); break; }
+            }
+            alpha *= 0.5;
+        }
+        p = accepted?;
     }
     None
 }
