+#[test]
+fn span49_a_actual_consumed_arc_and_query_associations() {
+    let _guard = crate::sfcc::validation::NumericalGuard::new();
+    let (f, _, input, lat) = super::fixture();
+    let saved: Value =
+        serde_json::from_str(include_str!("../../fixtures/span49-consumed-a.json")).unwrap();
+    let result = certify_consumed(
+        &f,
+        &saved,
+        &lat,
+        input["tuning"]["curveChordTolMm"].as_f64().unwrap(),
+        input["tuning"]["surfaceTolMm"].as_f64().unwrap(),
+    );
+    if let Ok(path) = std::env::var("SFCC_SPAN49_A_RECEIPT") {
+        std::fs::write(
+            path,
+            serde_json::to_vec_pretty(&json!({"result":result})).unwrap(),
+        )
+        .unwrap();
+    }
+    assert!(result.is_ok(), "{result:?}");
+}
+#[test]
+fn span49_a_order_requires_strict_parameter_and_canonical_progress() {
+    let image = |z| [I::point(0.), I::point(0.), I::point(z)];
+    assert!(ordered(&[
+        (1., image(3.)),
+        (2., image(2.)),
+        (3., image(1.))
+    ]));
+    assert!(!ordered(&[(1., image(3.)), (1., image(2.))]));
+    assert!(!ordered(&[(1., image(3.)), (2., image(3.))]));
+    assert!(!ordered(&[(1., image(2.)), (2., image(3.))]));
+    assert!(!ordered(&[]));
+}
+
+#[test]
+fn span49_a_rejects_corrupted_original_span_provenance() {
+    let _guard = crate::sfcc::validation::NumericalGuard::new();
+    let (f, _, input, lat) = super::fixture();
+    let saved: Value =
+        serde_json::from_str(include_str!("../../fixtures/span49-consumed-a.json")).unwrap();
+    let chord = input["tuning"]["curveChordTolMm"].as_f64().unwrap();
+    let surface = input["tuning"]["surfaceTolMm"].as_f64().unwrap();
+    let mut bad = saved.clone();
+    bad["edges"][0]["rangeBits"][0] = json!(0u64);
+    assert_eq!(
+        certify_consumed(&f, &bad, &lat, chord, surface).unwrap_err(),
+        "edge_parameter_bits"
+    );
+    let mut bad = saved.clone();
+    bad["edges"][0]["edge"] = Value::Null;
+    assert_eq!(
+        certify_consumed(&f, &bad, &lat, chord, surface).unwrap_err(),
+        "edge_shape"
+    );
+    let mut bad = saved.clone();
+    bad["originalTarget"]["originalPins"][0]["parameterBits"] = json!(0u64);
+    assert_eq!(
+        certify_consumed(&f, &bad, &lat, chord, surface).unwrap_err(),
+        "shared_pin_binding"
+    );
+    let mut bad = saved.clone();
+    bad["outerOriginalPointBinding"][1] = json!(0);
+    assert_eq!(
+        certify_consumed(&f, &bad, &lat, chord, surface).unwrap_err(),
+        "outer_pin_binding"
+    );
+    let mut bad = saved.clone();
+    bad["sharedPoint"] = json!(999999);
+    assert_eq!(
+        certify_consumed(&f, &bad, &lat, chord, surface).unwrap_err(),
+        "shared_vertex_binding"
+    );
+    assert_eq!(
+        certify_consumed(&f, &saved, &lat, chord, 0.).unwrap_err(),
+        "span_scope"
+    );
+    assert_eq!(
+        certify_consumed(&f, &saved, &lat, chord * 2., surface).unwrap_err(),
+        "span_scope"
+    );
+    assert_eq!(
+        certify_consumed(&f, &saved, &lat, chord, surface * 2.).unwrap_err(),
+        "span_scope"
+    );
+}
