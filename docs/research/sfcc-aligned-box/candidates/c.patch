+++ b/docs/research/sfcc-arrangement-c/timing-runner.py
@@ -0,0 +1,24 @@
+from pathlib import Path
+import json,subprocess,time,statistics
+base=Path('/tmp/sfcc-arrangement-c-final-artifacts');out=Path('/tmp/sfcc-arrangement-c-bench')
+record=json.loads((out/'cost-abort.json').read_text());record['termination']='SIGTERM to own driver16202and child16272; exec exit143; subsequent process listing empty.';(out/'cost-abort.json').write_text(json.dumps(record,indent=2)+'\n')
+rows=[];start=time.monotonic();aborted=False
+with (out/'timings.jsonl').open('w') as stream:
+ for pair,scene in enumerate(['box','clipped-box','duplicate-boxes-16']):
+  for version in (['baseline','candidate'] if pair%2==0 else ['candidate','baseline']):
+   remaining=45-(time.monotonic()-start)
+   if remaining<=0:aborted=True;break
+   try:result=subprocess.run([str(base/(version+'-fast')),scene],text=True,capture_output=True,check=True,timeout=remaining)
+   except subprocess.TimeoutExpired as e:
+    (out/'short-timeout.json').write_text(json.dumps({'scene':scene,'version':version,'partialStdout':str(e.stdout),'elapsedSeconds':time.monotonic()-start})+'\n');aborted=True;break
+   for line in result.stdout.splitlines():
+    row=json.loads(line);row.update(version=version,pair=pair);rows.append(row);stream.write(json.dumps(row)+'\n');stream.flush();assert row['ok']
+  if aborted:break
+summary=[]
+for scene in sorted({r['scene'] for r in rows}):
+ grouped={v:[r['elapsedMs'] for r in rows if r['scene']==scene and r['version']==v] for v in ['baseline','candidate']}
+ if any(len(x)!=3 for x in grouped.values()):continue
+ medians={v:statistics.median(t) for v,t in grouped.items()}
+ summary.append({'scene':scene,'samplesPerVersion':3,'baselineMedianMs':medians['baseline'],'candidateMedianMs':medians['candidate'],'medianChangePercent':100*(medians['candidate']/medians['baseline']-1),'ranges':{v:[min(t),max(t)] for v,t in grouped.items()}})
+result={'elapsedSeconds':time.monotonic()-start,'aborted':aborted,'protocol':'Deliberately shortened after oversized256control cost abort. One baseline/candidate process pair per short scene;order alternates by scene;1warmup+3timed exports/process. Quiet window. Raw rows streamed. No speed claim.','results':summary}
+(out/'timing-summary.json').write_text(json.dumps(result,indent=2)+'\n');print(json.dumps(result,indent=2))
