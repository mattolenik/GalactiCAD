+//! Source-derived incoming chart. Only successful source binding grants endpoint authority.
+use super::*;
+use crate::sfcc::{feature_curves::FeatureCurve, trim::TrimFrontier};
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) struct ConnectionChart {
+    pub p: TwistedSideParams,
+    pub edge: [f64; 4],
+    pub orientation: i8,
+    pub radius: f64,
+    pub cylinder_radius: f64,
+    pub incoming_radius: f64,
+    pub sign: i8,
+    pub allowance: f64,
+    pub junction: [f64; 3],
+    pub original_range: [f64; 2],
+    pub raw_curve: usize,
+}
+
+fn quotient(a: I, b: I) -> Option<I> {
+    if b.lo <= 0. && b.hi >= 0. {
+        return None;
+    }
+    mul(a, interval((1. / b.hi).next_down(), (1. / b.lo).next_up())?)
+}
+impl ConnectionChart {
+    fn coordinates(&self, radial: I) -> Option<(I, I, [I; 3])> {
+        let [r0, y0, r1, y1] = self.edge;
+        let dr = I::point(r1).sub(I::point(r0))?;
+        let dy = I::point(y1).sub(I::point(y0))?;
+        let len = sqrt(square(dr)?.add(square(dy)?)?)?;
+        let nr = dy.mul(self.orientation as f64)?;
+        let ny = dr.mul(-(self.orientation as f64))?;
+        let y = quotient(
+            mul(I::point(self.radius), len)?.sub(mul(nr, radial.sub(I::point(r0))?)?)?,
+            ny,
+        )?
+        .add(I::point(y0))?;
+        let mut u = sqrt(square(radial)?.sub(square(I::point(self.p.v0z))?)?)?;
+        if self.sign < 0 {
+            u = u.mul(-1.)?;
+        }
+        if u.lo <= 0. && u.hi >= 0. {
+            return None;
+        }
+        let theta = div(
+            y.sub(I::point(self.p.pos_y))?.add(I::point(self.p.h))?,
+            2. * self.p.h,
+        )?
+        .mul(self.p.twist_rad)?;
+        let (s, c) = sin_cos(theta)?;
+        let image = [
+            mul(u, c)?
+                .sub(s.mul(self.p.v0z)?)?
+                .add(I::point(self.p.pos_x))?,
+            y,
+            mul(u, s)?
+                .add(c.mul(self.p.v0z)?)?
+                .add(I::point(self.p.pos_z))?,
+        ];
+        Some((y, u, image))
+    }
+    pub(crate) fn ideal_image(&self, a: f64, b: f64) -> Option<([f64; 3], [f64; 3])> {
+        if !a.is_finite() || !b.is_finite() || a < 0. || a > b || b > 1. {
+            return None;
+        }
+        let dr = I::point(self.incoming_radius).sub(I::point(self.cylinder_radius))?;
+        let radial = I::point(self.cylinder_radius).add(mul(dr, interval(a, b)?)?)?;
+        let image = self.coordinates(radial)?.2;
+        Some((image.map(|v| v.lo), image.map(|v| v.hi)))
+    }
+    pub(crate) fn image(&self, a: f64, b: f64) -> Option<([f64; 3], [f64; 3])> {
+        let (mut lo, mut hi) = self.ideal_image(a, b)?;
+        if a == 0. {
+            for k in 0..3 {
+                lo[k] = lo[k].min(self.junction[k]);
+                hi[k] = hi[k].max(self.junction[k]);
+            }
+        }
+        Some((lo, hi))
+    }
+    pub(crate) fn point(&self, t: f64) -> Option<[f64; 3]> {
+        if t == 0. {
+            return Some(self.junction);
+        }
+        let (lo, hi) = self.ideal_image(t, t)?;
+        let out = std::array::from_fn(|k| lo[k] * 0.5 + hi[k] * 0.5);
+        let mut d2 = I::point(0.);
+        for k in 0..3 {
+            d2 = d2.add(square(I::point(out[k]).sub(interval(lo[k], hi[k])?)?)?)?;
+        }
+        (sqrt(d2)?.hi <= self.allowance).then_some(out)
+    }
+    pub(crate) fn tangent(&self, t: f64) -> Option<[f64; 3]> {
+        let q = self.point(t)?;
+        let rho = self.cylinder_radius + (self.incoming_radius - self.cylinder_radius) * t;
+        let u = self.sign as f64 * (rho * rho - self.p.v0z * self.p.v0z).sqrt();
+        let dr = self.edge[2] - self.edge[0];
+        let dy = self.edge[3] - self.edge[1];
+        let yprime = dy / dr;
+        let theta = (q[1] - self.p.pos_y + self.p.h) / (2. * self.p.h) * self.p.twist_rad;
+        let (s, c) = theta.sin_cos();
+        let omega = self.p.twist_rad / (2. * self.p.h) * yprime;
+        let tangent = [
+            rho / u * c - omega * (u * s + self.p.v0z * c),
+            yprime,
+            rho / u * s + omega * (u * c - self.p.v0z * s),
+        ];
+        let len = tangent[0].hypot(tangent[1]).hypot(tangent[2]);
+        if !len.is_finite() || len == 0. {
+            return None;
+        }
+        Some(tangent.map(|v| -v / len))
+    }
+    pub(crate) fn words(&self) -> [u64; 22] {
+        [
+            self.p.pos_x,
+            self.p.pos_y,
+            self.p.pos_z,
+            self.p.h,
+            self.p.twist_rad,
+            self.p.v0z,
+            self.edge[0],
+            self.edge[1],
+            self.edge[2],
+            self.edge[3],
+            self.radius,
+            self.cylinder_radius,
+            self.incoming_radius,
+            self.allowance,
+            self.sign as f64,
+            self.orientation as f64,
+            self.junction[0],
+            self.junction[1],
+            self.junction[2],
+            self.original_range[0],
+            self.original_range[1],
+            self.raw_curve as f64,
+        ]
+        .map(f64::to_bits)
+    }
+}
+
+fn distance_bound(point: [f64; 3], image: ([f64; 3], [f64; 3])) -> Option<f64> {
+    let mut d = I::point(0.);
+    for k in 0..3 {
+        d = d.add(square(
+            I::point(point[k]).sub(interval(image.0[k], image.1[k])?)?,
+        )?)?;
+    }
+    Some(sqrt(d)?.hi)
+}
+
+fn meridian_segment(groove: &Leaf, edge_id: usize, chart: &ConnectionChart) -> Option<()> {
+    let Shape::Lathe { edges } = &groove.shape else {
+        return None;
+    };
+    let radial = interval(chart.incoming_radius, chart.cylinder_radius)?;
+    let (y, _, _) = chart.coordinates(radial)?;
+    let e = edges.get(edge_id)?;
+    let dr = I::point(e.r1).sub(I::point(e.r0))?;
+    let dy = I::point(e.y1).sub(I::point(e.y0))?;
+    let wr = radial.sub(I::point(e.r0))?;
+    let wy = y.sub(I::point(e.y0))?;
+    let along = quotient(
+        mul(dr, wr)?.add(mul(dy, wy)?)?,
+        square(dr)?.add(square(dy)?)?,
+    )?;
+    if along.lo <= 0. || along.hi >= 1. {
+        return None;
+    }
+    for (j, e) in edges.iter().enumerate() {
+        if j == edge_id {
+            continue;
+        }
+        let dx = I::point(e.r1).sub(I::point(e.r0))?;
+        let dy = I::point(e.y1).sub(I::point(e.y0))?;
+        let wx = radial.sub(I::point(e.r0))?;
+        let wy = y.sub(I::point(e.y0))?;
+        let t = quotient(
+            mul(dx, wx)?.add(mul(dy, wy)?)?,
+            square(dx)?.add(square(dy)?)?,
+        )?;
+        let t = I {
+            lo: t.lo.clamp(0., 1.),
+            hi: t.hi.clamp(0., 1.),
+        };
+        let rx = wx.sub(mul(dx, t)?)?;
+        let ry = wy.sub(mul(dy, t)?)?;
+        let dist = sqrt(square(rx)?.add(square(ry)?)?)?;
+        if dist.lo <= chart.radius {
+            return None;
+        }
+    }
+    Some(())
+}
+
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct Connection {
+    pub chart: ConnectionChart,
+    pub original_range: [f64; 2],
+    pub source: [usize; 4],
+    pub candidate: [f64; 3],
+    pub incoming_association: f64,
+    pub generated_offset_error: f64,
+}
+
+/// Only a raw start interval is currently replaced. Unsupported ends keep their frontier.
+pub(crate) fn prove(
+    root: &CsgNode,
+    strata: &[Stratum],
+    curve: &FeatureCurve,
+    frontier: TrimFrontier,
+    candidate: [f64; 3],
+    epsilon: f64,
+) -> Option<Connection> {
+    #[cfg(test)]
+    if DISABLED.with(std::cell::Cell::get) {
+        return None;
+    }
+    if curve.closed
+        || curve.t_min != 0.
+        || frontier.initial_other != curve.t_min
+        || frontier.initial_alive <= curve.t_min
+        || frontier.initial_alive >= curve.t_max
+        || frontier.initial_alive > 1.
+        || curve.adjacent_strata.iter().any(|&i| i >= strata.len())
+        || strata.len() > 256
+        || !epsilon.is_finite()
+        || epsilon <= 0.
+    {
+        return None;
+    }
+    let initial = curve.shared_checked_point(curve.t_min)?;
+    let incoming = curve.shared_checked_point(frontier.initial_alive)?;
+    if distance_bound(initial, (candidate, candidate))? > epsilon {
+        return None;
+    }
+    let (a, b, _) = curve.traced_carriers()?;
+    if !a.connection_same_source(&strata[curve.adjacent_strata[0]])
+        || !b.connection_same_source(&strata[curve.adjacent_strata[1]])
+    {
+        return None;
+    }
+    for (native, common) in [
+        (curve.adjacent_strata[0], curve.adjacent_strata[1]),
+        (curve.adjacent_strata[1], curve.adjacent_strata[0]),
+    ] {
+        let Some((p, _)) = strata[native].twisted_source() else {
+            continue;
+        };
+        for field in 0..strata.len() {
+            let Some((_, source_leaf, competitor, round)) =
+                strata[native].round_twisted_source(&strata[field])
+            else {
+                continue;
+            };
+            for cylinder in 0..strata.len() {
+                let Some(junction) = super::junction::prove_junction(
+                    root,
+                    strata,
+                    [native, field, cylinder],
+                    candidate,
+                    epsilon,
+                ) else {
+                    continue;
+                };
+                let branch = branch_at(strata, native, field, cylinder, candidate)?;
+                let source_root = strata[native].exposure_root_a()?;
+                let (cap_cut, sphere, outer_radius) =
+                    pair(source_root, Some((BlendKind::Smax, SminMode::Round))).ok()?;
+                let (groove_cut, cap, _) = pair(cap_cut, None).ok()?;
+                let (hard, groove_node, radius) =
+                    pair(groove_cut, Some((BlendKind::Smax, SminMode::Chamfer))).ok()?;
+                let groove = leaf(groove_node, -1.).ok()?;
+                if groove.pos[1] != 0. {
+                    return None;
+                }
+                let Shape::Lathe { edges } = &groove.shape else {
+                    return None;
+                };
+                let (w, offset) =
+                    strata[common].connection_compound(hard, groove_node, groove_cut)?;
+                let error = quotient(I::point(offset), I::point(w))?.sub(I::point(radius))?;
+                let generated_offset_error = error.lo.abs().max(error.hi.abs());
+                if generated_offset_error > epsilon {
+                    return None;
+                }
+                let radial = (incoming[0] - p.pos_x).hypot(incoming[2] - p.pos_z);
+                if !radial.is_finite() || radial >= branch.cylinder.2 || radial <= p.v0z.abs() {
+                    continue;
+                }
+                let e = edges[junction.groove_edge];
+                let orientation = crate::sfcc::predicates::orient2d(
+                    [edges[0].r0, edges[0].y0],
+                    [edges[1].r0, edges[1].y0],
+                    [edges[2].r0, edges[2].y0],
+                );
+                let chart = ConnectionChart {
+                    p,
+                    edge: [e.r0, e.y0, e.r1, e.y1],
+                    orientation: orientation as i8,
+                    radius,
+                    cylinder_radius: branch.cylinder.2,
+                    incoming_radius: radial,
+                    sign: branch.sign,
+                    allowance: epsilon,
+                    junction: candidate,
+                    original_range: [curve.t_min, frontier.initial_alive],
+                    raw_curve: curve.id,
+                };
+                let (height, u, image) = chart.coordinates(interval(radial, branch.cylinder.2)?)?;
+                meridian_segment(groove, junction.groove_edge, &chart)?;
+                profile_branch(p, source_leaf, [u, I::point(p.v0z)])?;
+                // The compound's angular derivative is w times the native side's;
+                // the lathe term has no angular component.
+                let angular_lower = quotient(
+                    I::point(u.lo.abs().min(u.hi.abs())),
+                    I::point(branch.cylinder.2),
+                )?
+                .lo;
+                let normalized_offset_error =
+                    quotient(I::point(generated_offset_error), I::point(angular_lower))?.hi;
+                if !angular_lower.is_finite()
+                    || angular_lower <= 0.
+                    || normalized_offset_error > epsilon
+                {
+                    return None;
+                }
+                let profile_y = height.sub(I::point(p.pos_y))?;
+                if profile_y.lo <= -p.h || profile_y.hi >= p.h {
+                    return None;
+                }
+                let cylinder_leaf =
+                    strata[cylinder].correlated_cylinder_source_c(&strata[native])?;
+                let Shape::Cylinder { h, .. } = &cylinder_leaf.shape else {
+                    return None;
+                };
+                let cylinder_y = height.sub(I::point(cylinder_leaf.pos[1]))?;
+                if cylinder_y.lo <= -*h || cylinder_y.hi >= *h {
+                    return None;
+                }
+                let radial_box = (
+                    [radial, height.lo, p.pos_z],
+                    [branch.cylinder.2, height.hi, p.pos_z],
+                );
+                // Supported frames are coaxial; shift radial coordinate by their common center.
+                let mut lo = radial_box.0;
+                let mut hi = radial_box.1;
+                let cx = I::point(p.pos_x).add(interval(radial, branch.cylinder.2)?)?;
+                lo[0] = cx.lo;
+                hi[0] = cx.hi;
+                if lathe_lower(competitor, lo, hi)? <= round {
+                    return None;
+                }
+                let cap = leaf(cap, -1.).ok()?;
+                let Shape::Extrude { h, .. } = &cap.shape else {
+                    return None;
+                };
+                if I::point(cap.pos[1]).sub(I::point(*h))?.sub(height)?.lo <= 0. {
+                    return None;
+                }
+                let sphere = leaf(sphere, 1.).ok()?;
+                let Shape::Sphere { r } = &sphere.shape else {
+                    return None;
+                };
+                let sq = square(interval(radial, branch.cylinder.2)?)?
+                    .add(square(height.sub(I::point(sphere.pos[1]))?)?)?;
+                if sq.hi >= square(I::point(*r).sub(I::point(outer_radius))?)?.lo {
+                    return None;
+                }
+                let incoming_association = distance_bound(incoming, chart.ideal_image(1., 1.)?)?;
+                if incoming_association > epsilon
+                    || distance_bound(candidate, chart.ideal_image(0., 0.)?)? > epsilon
+                {
+                    return None;
+                }
+                let image_lo = image.map(|v| v.lo);
+                let image_hi = image.map(|v| v.hi);
+                if (0..3).any(|k| !image_lo[k].is_finite() || !image_hi[k].is_finite()) {
+                    return None;
+                }
+                return Some(Connection {
+                    chart,
+                    original_range: [curve.t_min, frontier.initial_alive],
+                    source: [native, field, cylinder, common],
+                    candidate,
+                    incoming_association,
+                    generated_offset_error,
+                });
+            }
+        }
+    }
+    None
+}
+
+#[cfg(all(test, feature = "serde"))]
+mod tests {
+    use super::*;
+    use serde_json::json;
+    fn inventory(f: &SfccFeatureSet) -> serde_json::Value {
+        json!(f.curves.iter().map(|c|json!({"id":c.id,"pair":c.adjacent_strata,"range":[c.t_min,c.t_max],"ends":[c.corner_start,c.corner_end],"points":c.index_polyline})).collect::<Vec<_>>())
+    }
+    fn p_at(c: &FeatureCurve, t: f64) -> [f64; 3] {
+        c.point_at_checked(t).unwrap()
+    }
+    #[test]
+    fn connection_a_compiled_chart_connects_and_preserves_order() {
+        let fixture: serde_json::Value =
+            serde_json::from_str(include_str!("../../fixtures/shared-arc-full-knob.json")).unwrap();
+        let root =
+            crate::scene_bridge::build_csg_tree_from_json(fixture["sceneJson"].as_str().unwrap())
+                .unwrap();
+        let size = fixture["cube"]["max"][0].as_f64().unwrap()
+            - fixture["cube"]["min"][0].as_f64().unwrap();
+        let tol = crate::tolerances::resolve_tolerances(
+            &crate::tuning::SfccTuning::default(),
+            3_f64.sqrt() * size,
+        );
+        let (baseline, baseline_diag) =
+            without_resolution(|| crate::sfcc::feature_set::compile_feature_set(&root, &tol));
+        reset_events();
+        let (features, diag) = crate::sfcc::feature_set::compile_feature_set(&root, &tol);
+        let mut rows = Vec::new();
+        for c in &features.curves {
+            let Some(identity) = c.connection_identity() else {
+                continue;
+            };
+            let points: Vec<_> = (0..=32)
+                .map(|i| c.point_at_checked(i as f64 / 32.))
+                .collect();
+            rows.push(json!({"curve":c.id,"pair":c.adjacent_strata,"cornerStart":c.corner_start,"identity":identity,"points":points}));
+        }
+        let report = json!({"scope":"source-derived incoming chart and actual compiled attachment; no whole component", "curves":features.curves.len(),"corners":features.corners.len(),"unresolved":diag.unresolved_trims,"connections":rows,"trimEvents":take_events(),"baseline":{"curves":baseline.curves.len(),"corners":baseline.corners.len(),"unresolved":baseline_diag.unresolved_trims,"families":inventory(&baseline)},"candidateFamilies":inventory(&features)});
+        std::fs::write(
+            std::env::var("SFCC_CONNECTION_A_RECEIPT").expect("root receipt required"),
+            serde_json::to_vec_pretty(&report).unwrap(),
+        )
+        .unwrap();
+        let protected = |f: &SfccFeatureSet| {
+            let mut rows:Vec<String>=f.curves.iter().filter(|c|{let mut pair=c.adjacent_strata;pair.sort();pair!=[10,31]}).map(|c|{
+                let corners=[c.corner_start,c.corner_end].map(|id|if id<0{None}else{let k=&f.corners[id as usize];Some([k.x.to_bits(),k.y.to_bits(),k.z.to_bits()])});
+                serde_json::to_string(&json!({"pair":c.adjacent_strata,"range":[c.t_min.to_bits(),c.t_max.to_bits()],"points":c.index_polyline.iter().map(|x|x.to_bits()).collect::<Vec<_>>(),"corners":corners})).unwrap()
+            }).collect();
+            rows.sort();
+            rows
+        };
+        assert_eq!(
+            protected(&baseline),
+            protected(&features),
+            "every non-target source family stays identical to resolver-disabled baseline"
+        );
+        assert_eq!(
+            baseline.curves.len(),
+            features.curves.len(),
+            "attachment repair must not discard an overlapping source representation"
+        );
+        assert!(
+            !rows.is_empty(),
+            "at least one actual incoming chart must be installed"
+        );
+        for c in features
+            .curves
+            .iter()
+            .filter(|c| c.connection_identity().is_some())
+        {
+            assert!(c.corner_start >= 0);
+            let corner = &features.corners[c.corner_start as usize];
+            assert_eq!(
+                c.point_at_checked(0.).unwrap(),
+                [corner.x, corner.y, corner.z]
+            );
+            let points: Vec<_> = (0..=32)
+                .map(|i| c.point_at_checked(i as f64 / 32.).unwrap())
+                .collect();
+            assert!(
+                points.windows(2).all(|w| w[0][1] > w[1][1]),
+                "actual tested height events preserve orientation"
+            );
+            assert!(c.point_at_checked(f64::NAN).is_none());
+            let source_before = features.fingerprint();
+            let mut altered = features.clone();
+            let chart = c.connection_identity().unwrap();
+            assert_ne!(chart, [0; 22]);
+            altered.curves[c.id].mutate_connection_for_test();
+            assert_ne!(source_before, altered.fingerprint());
+            assert!(!c.private_storage_clone_equal_a(&altered.curves[c.id]));
+            let mut invalid = c.clone();
+            invalid.corrupt_connection_junction_for_test(0.001);
+            assert!(
+                invalid.point_at_checked(0.).is_none(),
+                "source chart must retain original carrier residual gate"
+            );
+            {
+                use crate::sfcc::validation::{
+                    numerical_failures, restore_numerical_failures, NumericalGuard,
+                };
+                let _guard = NumericalGuard::new();
+                restore_numerical_failures(Default::default());
+                assert!(
+                    invalid.point_at(0.).iter().all(|v| v.is_nan()),
+                    "failed certified query cannot fall back to an interpolation seed"
+                );
+                assert_eq!(numerical_failures().curve_projection, 1);
+            }
+            let bounds = c.projection_tube(0., 1.).unwrap();
+            assert!((0..3).all(|k| p_at(c, 0.)[k] >= bounds.0[k] && p_at(c, 0.)[k] <= bounds.1[k]));
+            let frontier = TrimFrontier {
+                initial_alive: 0.25,
+                initial_other: 0.,
+                initial_other_status: crate::sfcc::trim::FrontierOtherStatus::Unknown,
+                alive: 0.25,
+                other: 0.125,
+                other_status: crate::sfcc::trim::FrontierOtherStatus::Unknown,
+                reason: crate::sfcc::trim::FrontierReason::UndecidableClassification,
+            };
+            let p = [corner.x, corner.y, corner.z];
+            let wrong = [p[0] + 0.1, p[1], p[2]];
+            assert!(prove(
+                &root,
+                &features.strata,
+                c,
+                frontier,
+                wrong,
+                tol.curve_eps * 8.
+            )
+            .is_none());
+            let mut bad = frontier;
+            bad.initial_other = 0.01;
+            assert!(prove(&root, &features.strata, c, bad, p, tol.curve_eps * 8.).is_none());
+            assert!(prove(&root, &features.strata, c, frontier, p, 0.).is_none());
+            let mut wrong_source = c.clone();
+            wrong_source.adjacent_strata = [0, 1];
+            assert!(prove(
+                &root,
+                &features.strata,
+                &wrong_source,
+                frontier,
+                p,
+                tol.curve_eps * 8.
+            )
+            .is_none());
+        }
+    }
+}
