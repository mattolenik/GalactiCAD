{
    "name": "GalactiCAD",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "workspaceMount": "source=galacticad-workspace,target=/workspace,type=volume",
    "workspaceFolder": "/workspace",
    "forwardPorts": [6900, 7000],
    "portsAttributes": {
        "6900": {
            "label": "dev server",
            "onAutoForward": "notify"
        },
        "7000": {
            "label": "dev server (agent)",
            "onAutoForward": "notify"
        }
    },
    "postCreateCommand": "bash -c 'if [ -f package.json ]; then make setup; fi'"
}
