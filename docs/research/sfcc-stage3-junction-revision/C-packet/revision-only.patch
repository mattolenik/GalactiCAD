+#[cfg(all(test, feature = "serde"))]
+impl Stratum {
+    pub(crate) fn junction_revision_c_identity(&self, depth: usize) -> Option<serde_json::Value> {
+        if depth > 4 { return None; }
+        let mut result = self.graph_capture_identity_b()?;
+        if let Some(compound) = &self.compound {
+            if compound.terms.len() > 8 { return None; }
+            let terms = compound.terms.iter().map(|(s,w)| {
+                Some(serde_json::json!({"weightHex":format!("{:016x}",w.to_bits()),"source":s.junction_revision_c_identity(depth+1)?}))
+            }).collect::<Option<Vec<_>>>()?;
+            result["compoundTermsIncluded"] = serde_json::json!(true);
+            result["compound"] = serde_json::json!({"offsetHex":format!("{:016x}",compound.offset.to_bits()),"terms":terms});
+        }
+        Some(result)
+    }
+}
