+        };
+        let actual = query(original.chart, original.t)?;
+        if actual.p.map(f64::to_bits) != original.p.map(f64::to_bits) {
+            return None;
+        }
+        let slot = self.charts.iter().position(|&id| id == target)?;
+        let [a, b] = self.ranges[slot];
+        let mut knots = vec![a];
+        knots.extend((a.floor() as i64 + 1..b.ceil() as i64).map(|t| t as f64));
+        knots.push(b);
+        let mut rows = vec![];
+        for t in knots {
+            let q = query(target, t)?;
+            if transport_a::accepts(actual.p, q.p, self.epsilon) {
+                return Some(q);
+            }
+            rows.push(q);
+        }
+        let windows: Vec<_> = rows
+            .windows(2)
+            .filter(|w| {
+                actual.p[1] >= w[0].p[1].min(w[1].p[1]) && actual.p[1] <= w[0].p[1].max(w[1].p[1])
+            })
+            .collect();
+        if windows.len() != 1 || windows[0][0].p[1] == windows[0][1].p[1] {
+            return None;
+        }
+        let mut lo = windows[0][0].clone();
+        let mut hi = windows[0][1].clone();
+        let ascending = hi.p[1] > lo.p[1];
+        for i in 0..64 {
+            let candidate = if i < 2 {
+                transport_a::height_proposal(lo.t, hi.t, lo.p[1], hi.p[1], actual.p[1])
+            } else {
+                None
+            };
+            let t = candidate.unwrap_or(lo.t + (hi.t - lo.t) * 0.5);
+            if !t.is_finite() || t <= lo.t || t >= hi.t {
+                return None;
+            }
+            let q = query(target, t)?;
+            if transport_a::accepts(actual.p, q.p, self.epsilon) {
+                return Some(q);
+            }
+            if (q.p[1] < actual.p[1]) == ascending {
+                lo = q;
+            } else {
+                hi = q;
+            }
+        }
+        None
+    }
+}
+
+pub(super) fn sharing_complete() -> bool {
+    SHARING.with(|s| s.get() == (1, false))
+}
+pub(super) fn share_incoming(
+    source_arc: &SharedArc,
+    target: usize,
+    target_nodes: &[usize],
+    target_parameters: &[f64],
+    points: &PointTable,
+    features: &SfccFeatureSet,
+    tolerance: f64,
+) -> Option<(Vec<usize>, Vec<f64>)> {
+    let plan = plan()?;
+    if source_arc.curve == target
+        || !plan.charts.contains(&source_arc.curve)
+        || !plan.charts.contains(&target)
+    {
+        return None;
+    }
+    let slot = plan.charts.iter().position(|&id| id == target)?;
+    if target_parameters
+        .first()
+        .is_some_and(|t| *t >= plan.cuts[slot])
+    {
+        return None;
+    }
+    let result = share_incoming_impl(
+        source_arc,
+        target,
+        target_nodes,
+        target_parameters,
+        points,
+        features,
+        tolerance,
+    );
+    SHARING.with(|s| {
+        let (n, failed) = s.get();
+        s.set((
+            n + usize::from(result.is_some()),
+            failed || result.is_none(),
+        ));
+    });
+    result
+}
+fn share_incoming_impl(
+    source_arc: &SharedArc,
+    target: usize,
+    target_nodes: &[usize],
+    target_parameters: &[f64],
+    points: &PointTable,
+    features: &SfccFeatureSet,
+    tolerance: f64,
+) -> Option<(Vec<usize>, Vec<f64>)> {
+    let plan = plan()?;
+    if !tolerance.is_finite()
+        || tolerance <= 0.
+        || source_arc.curve == target
+        || !plan.charts.contains(&source_arc.curve)
+        || !plan.charts.contains(&target)
+        || source_arc.nodes.len() != source_arc.parameters.len()
+        || target_nodes.len() != target_parameters.len()
+        || source_arc.nodes.len() < 2
+        || target_nodes.len() < 2
+        || source_arc.nodes.len() > 129
+        || target_nodes.len() > 129
+        || source_arc.nodes.first() != target_nodes.first()
+        || source_arc.nodes.last() != target_nodes.last()
+        || source_arc
+            .nodes
+            .iter()
+            .chain(target_nodes)
+            .any(|&id| id >= points.count())
+        || source_arc.parameters.windows(2).any(|r| r[0] >= r[1])
+        || target_parameters.windows(2).any(|r| r[0] >= r[1])
+    {
+        return None;
+    }
+    let source = source(&plan, features)?;
+    let mut ranges = [[0.; 2]; 2];
+    for (id, range) in [
+        (
+            source_arc.curve,
+            [source_arc.parameters[0], *source_arc.parameters.last()?],
+        ),
+        (target, [target_parameters[0], *target_parameters.last()?]),
+    ] {
+        let slot = plan.charts.iter().position(|&x| x == id)?;
+        let c = &features.curves[id];
+        if !c.t_min.is_finite()
+            || !c.t_max.is_finite()
+            || c.t_min >= c.t_max
+            || range.iter().any(|x| !x.is_finite())
+            || range[0] < c.t_min
+            || range[0] >= range[1]
+            || range[1] > plan.cuts[slot]
+            || range[1] > c.t_max
+        {
+            return None;
+        }
+        ranges[slot] = range;
+    }
+    let tubes = [
+        features.curves[plan.charts[0]].projection_tube(ranges[0][0], ranges[0][1])?,
+        features.curves[plan.charts[1]].projection_tube(ranges[1][0], ranges[1][1])?,
+    ];
+    let incoming = Incoming {
+        f: features,
+        source,
+        charts: plan.charts,
+        ranges,
+        tubes,
+        epsilon: plan.epsilon,
+    };
+    let mut mapped = Vec::new();
+    let mut parameters = Vec::new();
+    let mut canonical = Vec::new();
+    for (i, (&id, &t)) in source_arc
+        .nodes
+        .iter()
+        .zip(&source_arc.parameters)
+        .enumerate()
+    {
+        let p = q::pos(points, id);
+        let own = incoming.retained(source_arc.curve, t, p)?;
+        let other = if i == 0 || i + 1 == source_arc.nodes.len() {
+            incoming.retained(
+                target,
+                if i == 0 {
+                    target_parameters[0]
+                } else {
+                    *target_parameters.last()?
+                },
+                p,
+            )?
+        } else {
+            incoming.map(&own, target)?
+        };
+        incoming.position(target, other.t, p)?;
+        if !transport_a::accepts(p, other.p, plan.epsilon)
+            || !transport_a::accepts(own.p, other.p, plan.epsilon)
+        {
+            return None;
+        }
+        canonical.push(incoming.position(source_arc.curve, t, p)?);
+        parameters.push(other.t);
+        mapped.push((own, other));
+    }
+    if mapped.windows(2).any(|r| {
+        r[0].0.t >= r[1].0.t
+            || r[0].1.t >= r[1].1.t
+            || r[0].0.coordinate >= r[1].0.coordinate
+            || r[0].1.coordinate >= r[1].1.coordinate
+    }) || canonical.windows(2).any(|r| r[0] >= r[1])
+    {
+        return None;
+    }
+    let chord_distance = |p: [f64; 3]| {
+        source_arc
+            .nodes
+            .windows(2)
+            .map(|ids| {
+                let a = q::pos(points, ids[0]);
+                let d = q::sub(q::pos(points, ids[1]), a);
+                let len = q::dot(d, d);
+                let u = if len > 0. {
+                    (q::dot(q::sub(p, a), d) / len).clamp(0., 1.)
+                } else {
+                    0.
+                };
+                q::norm(q::sub(p, std::array::from_fn(|k| a[k] + u * d[k])))
+            })
+            .fold(f64::INFINITY, f64::min)
+    };
+    for span in target_parameters.windows(2) {
+        for u in [0.25, 0.5, 0.75] {
+            let t = span[0] + u * (span[1] - span[0]);
+            let own = incoming.query(target, t)?;
+            let other = incoming.map(&own, source_arc.curve)?;
+            if !transport_a::accepts(own.p, other.p, plan.epsilon)
+                || chord_distance(own.p) > tolerance * 0.5
+            {
+                return None;
+            }
+        }
+    }
+    for (&id, &t) in target_nodes.iter().zip(target_parameters) {
+        let p = q::pos(points, id);
+        let own = incoming.retained(target, t, p)?;
+        let other = incoming.map(&own, source_arc.curve)?;
+        incoming.position(source_arc.curve, other.t, p)?;
+        if !transport_a::accepts(p, other.p, plan.epsilon) || chord_distance(p) > tolerance * 0.5 {
+            return None;
+        }
+    }
+    Some((source_arc.nodes.clone(), parameters))
+}
+
+fn number(v: &Value) -> f64 {
+    f64::from_bits(u64::from_str_radix(v.as_str().unwrap(), 16).unwrap())
+}
+fn point_table(pre: &Value, probe: &Value) -> PointTable {
+    let mut p = PointTable::new();
+    p.arrangement = probe["inputArrangement"].as_bool().unwrap();
+    for row in pre["allPrivatePoints"].as_array().unwrap() {
+        let xyz: [f64; 3] = std::array::from_fn(|k| number(&row["positionHex"][k]));
+        let n: [f64; 3] = std::array::from_fn(|k| number(&row["normalHex"][k]));
+        let payload = || [xyz[0], xyz[1], xyz[2], n[0], n[1], n[2]];
+        let id = if let Some(s) = row["key"]["numericHex"].as_str() {
+            p.get_or_create(u64::from_str_radix(s, 16).unwrap() as i64, payload)
+        } else if let Some(s) = row["key"]["string"].as_str() {
+            p.get_or_create_str(s, payload)
+        } else {
+            assert!(row["key"].is_null());
+            p.add(xyz[0], xyz[1], xyz[2], n[0], n[1], n[2])
+        };
+        assert_eq!(id, row["id"].as_u64().unwrap() as usize);
+        assert_eq!(q::pos(&p, id).map(f64::to_bits), xyz.map(f64::to_bits));
+    }
+    assert!(
+        probe["inputProtectedEdges"].as_array().unwrap().is_empty(),
+        "this captured input has no pre-existing protected edge state"
+    );
+    p
+}
+fn records(probe: &Value) -> [HashMap<i64, FaceRecord>; 3] {
+    let map: BTreeMap<_, _> = probe["inputPointBindings"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|r| {
+            (
+                r["global"].as_u64().unwrap() as usize,
+                r["local"].as_u64().unwrap() as usize,
+            )
+        })
+        .collect();
+    let mut out = std::array::from_fn(|_| HashMap::new());
+    for row in probe["faces"].as_array().unwrap() {
+        let axis = row["face"][0].as_u64().unwrap() as usize;
+        let key = row["face"][1].as_i64().unwrap();
+        let len = row["face"][2].as_i64().unwrap();
+        let segments = row["originalSegments"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .map(|s| FaceSegment {
+                a: map[&(s[0].as_u64().unwrap() as usize)],
+                b: map[&(s[1].as_u64().unwrap() as usize)],
+            })
+            .collect();
+        let pins = row["originalPins"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .map(|p| FacePin {
+                curve_id: p["chart"].as_u64().unwrap() as usize,
+                point_id: map[&(p["point"].as_u64().unwrap() as usize)],
+                t: f64::from_bits(p["parameterBits"].as_u64().unwrap()),
+            })
+            .collect();
+        out[axis].insert(
+            key,
+            FaceRecord {
+                axis,
+                key,
+                len,
+                segments,
+                pins,
+                interior_cycle: row["interiorCycle"].as_bool().unwrap(),
+                consumed_fwd: row["consumedForward"]
+                    .as_array()
+                    .unwrap()
+                    .iter()
+                    .map(|v| v.as_u64().unwrap() as u32)
+                    .collect(),
+                consumed_rev: row["consumedReverse"]
+                    .as_array()
+                    .unwrap()
+                    .iter()
+                    .map(|v| v.as_u64().unwrap() as u32)
+                    .collect(),
+            },
+        );
+    }
+    out
+}
+fn gathered(
+    records: &[HashMap<i64, FaceRecord>; 3],
+    lat: &SfccLattice,
+    cell: &SfccCell,
+) -> (Vec<Vec<usize>>, Vec<FacePin>) {
+    let mut segments = Vec::new();
+    let mut pins = Vec::new();
+    gather_segments(records, lat, cell, &mut segments, &mut pins);
+    let mut outgoing = HashMap::new();
+    for (i, s) in segments.iter().enumerate() {
+        assert!(outgoing.insert(s.a, i).is_none());
+    }
+    let mut visited = vec![false; segments.len()];
+    let mut loops = Vec::new();
+    for start in 0..segments.len() {
+        if visited[start] {
+            continue;
+        }
+        let mut at = start;
+        let first = segments[start].a;
+        let mut path = Vec::new();
+        loop {
+            assert!(!visited[at]);
+            visited[at] = true;
+            let s = &segments[at];
+            path.push(s.a);
+            if s.b == first {
+                break;
+            }
+            at = *outgoing.get(&s.b).expect("closed captured boundary");
+            assert!(path.len() <= segments.len());
+        }
+        assert!(path.len() >= 3);
+        loops.push(path);
+    }
+    (loops, pins)
+}
+fn fixture() -> (
+    CsgNode,
+    SfccFeatureSet,
