+    let mut longest = f64::NEG_INFINITY;
+    for (a, b, c) in [(0, 1, 2), (1, 2, 0), (2, 0, 1)] {
+        let d = square(t[a][1].sub(t[b][1])?)?
+            .add(square(t[a][2].sub(t[b][2])?)?)?
