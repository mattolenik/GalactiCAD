+struct Incoming<'a> {
+    f: &'a SfccFeatureSet,
+    source: activation_a::Certificate<'a>,
+    charts: [usize; 2],
+    ranges: [[f64; 2]; 2],
+    tubes: [([f64; 3], [f64; 3]); 2],
+    epsilon: f64,
