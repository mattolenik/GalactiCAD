+/// Recognizing the source event makes its required outgoing incidence mandatory.
+pub(crate) fn event_complete(
+    f: &SfccFeatureSet,
+    ids: [usize; 2],
+    corner: &SfccCorner,
+    eps: f64,
+) -> bool {
+    let Some(tube) = f.curves[ids[0]].projection_tube(0., 1.) else {
+        return true;
+    };
+    let Some(branch) = HelixBranch::identify(f, ids[0], ids[1], tube) else {
+        return true;
+    };
+    let Some(root) = f.strata[branch.native].exposure_root_a() else {
+        return true;
+    };
+    let Some(cert) = bind(root, &f.strata, &branch, 0.5) else {
+        return true;
+    };
+    let point = [corner.x, corner.y, corner.z];
+    if !distance(point, cert.point_image(0.).unwrap()).is_some_and(|d| d <= eps) {
+        return true;
+    }
+    let Some(meta) = f.curves[ids[0]].upper_chart() else {
+        return false;
+    };
+    if meta.outgoing || !meta.event_curves.contains(&ids[1]) {
+        return false;
+    }
+    meta.event_curves.into_iter().enumerate().all(|(i, id)| {
+        let Some(c) = f.curves.get(id) else {
+            return false;
+        };
+        let end = if i == 2 { 0 } else { 1 };
+        let Some(m) = c.upper_chart() else {
+            return false;
+        };
+        m.event_curves == meta.event_curves
+            && m.outgoing == (i == 2)
+            && corner.curve_ends.contains(&(id, end))
+            && [c.corner_start, c.corner_end][end as usize] == corner.id as i64
+            && c.adjacent_strata
+                .iter()
+                .all(|sid| corner.strata.contains(sid))
+    })
+}
+fn checked(c: &FeatureCurve, t: f64) -> Option<[f64; 3]> {
+    #[cfg(test)]
+    WORK.with(|v| {
+        let mut w = v.borrow_mut();
+        if w.active {
+            w.curve_queries += 1;
+        }
+    });
+    c.shared_checked_point(t)
+}
