+fn pair(request: &CheckedEvent, mapped: &CheckedEvent, eps: f64) -> Value {
+    json!({"requestChart":request.chart,"requestParameterBits":request.parameter.to_bits(),
+        "requestedPointBits":request.point.map(f64::to_bits),"targetChart":mapped.chart,
+        "returnedParameterBits":mapped.parameter.to_bits(),"mappedPointBits":mapped.point.map(f64::to_bits),
+        "unchangedAllowanceBits":eps.to_bits(),"outwardDistanceUpperBits":distance_upper(request.point,mapped.point).unwrap().to_bits(),
+        "sourceAndEventGatesPassed":true})
+}
