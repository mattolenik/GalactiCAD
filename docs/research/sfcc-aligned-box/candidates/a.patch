+pub(crate) fn signature(tree: &CsgNode) -> Option<Vec<u64>> {
+    collect(tree, &mut Vec::new(), &mut Vec::new(), &mut 0).ok()?;
+    fn walk(n: &CsgNode, out: &mut Vec<u64>) {
+        match n {
+            CsgNode::Leaf(l) => {
+                out.push(0);
+                out.push(l.sign.to_bits());
+                out.extend(l.pos.map(f64::to_bits));
+                if let Shape::Cuboid { half } = l.shape {
+                    out.extend(half.map(f64::to_bits));
+                }
+            }
+            CsgNode::Min(ch) | CsgNode::Max(ch) => {
+                out.extend([
+                    if matches!(n, CsgNode::Min(_)) { 1 } else { 2 },
+                    ch.len() as u64,
+                ]);
+                for c in ch {
+                    walk(c, out)
+                }
+            }
+            _ => unreachable!(),
+        }
+    }
+    let mut out = vec![0x41525236];
+    walk(tree, &mut out);
+    Some(out)
+}
+
+impl Arrangement {
+    /// Independent point pools and keyed assembly for native partition strategies.
+    pub(crate) fn emit_groups(
+        &self,
+        groups: &[Vec<SfccCell>],
+        tree: &CsgNode,
+        lat: &SfccLattice,
+        pt: &mut super::point_table::PointTable,
+    ) -> Vec<usize> {
+        use super::point_table::{PointKey, PointTable};
+        pt.arrangement = true;
+        let mut tris = Vec::new();
+        for group in groups {
+            let mut local = PointTable::new();
+            let tt = self.emit(group, &mut local);
+            let ids = (0..local.count())
+                .map(|i| {
+                    let p = super::local_coverage::payload(&local, i).map(f64::from_bits);
+                    let PointKey::Str(key) = local.key_at(i) else {
+                        unreachable!()
+                    };
+                    pt.get_or_create_str(key, || p)
+                })
+                .collect::<Vec<_>>();
+            for t in tt.chunks_exact(3) {
+                let t = [t[0], t[1], t[2]];
+                let owner = local.patch(t).unwrap();
+                let t = t.map(|i| ids[i]);
+                pt.set_patch(t, owner);
+                tris.extend(t);
+            }
+            for ((a, b), ii) in local.identified_edges() {
+                for &i in ii {
+                    pt.protect_curve_edge(ids[a], ids[b], i);
+                }
+            }
+            super::local_coverage::import_witnesses(
+                pt,
+                std::mem::take(&mut local.coverage),
+                &ids,
+                lat,
+                tree,
+            );
+        }
+        reverify(pt, tree, lat, &tris);
+        tris
+    }
+}
