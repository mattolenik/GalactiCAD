+// The old algorithm is retained separately. This records its current-layout
+// initial terms and formatter prefix; it does not invent Round16 staged_bytes.
+fn old_debug_probe(f: &SfccFeatureSet, staged: usize) -> Value {
+    struct Count {
+        total: usize,
+        chars: usize,
+        calls: usize,
+    }
+    impl std::fmt::Write for Count {
+        fn write_str(&mut self, s: &str) -> std::fmt::Result {
+            self.chars += s.len();
+            self.calls += 1;
+            self.total = self.total.saturating_add(s.len().saturating_mul(64));
+            if self.total > LIMIT {
+                Err(std::fmt::Error)
+            } else {
+                Ok(())
+            }
+        }
+    }
+    let index = f.index.private_clone_reservation();
+    let inline = size_of::<SfccFeatureSet>();
+    let initial = staged.saturating_add(index).saturating_add(inline);
+    let mut count = Count {
+        total: initial,
+        chars: 0,
+        calls: 0,
+    };
+    let mut rows = Vec::new();
+    let mut failed = false;
+    for component in ["curves", "corners", "strata", "unresolved_paths"] {
+        let before = (count.total, count.chars, count.calls);
+        let result = match component {
+            "curves" => write!(&mut count, "{:?}", f.curves),
+            "corners" => write!(&mut count, "{:?}", f.corners),
+            "strata" => write!(&mut count, "{:?}", f.strata),
+            _ => write!(&mut count, "{:?}", f.unresolved_branch_paths),
+        };
+        rows.push(json!({"component":component,"before":before.0,"after":count.total,"emittedPrefixBytes":count.chars-before.1,"formatterWrites":count.calls-before.2,"refused":result.is_err()}));
+        if result.is_err() {
+            failed = true;
+            break;
+        }
+    }
+    assert_eq!(
+        crate::sfcc::private_arc_a::legacy_reserve_source_view_a(f, staged).is_err(),
+        failed
+    );
+    json!({"stagedBytes":staged,"indexTerm":index,"currentFeatureInlineTerm":inline,"initialTotal":initial,"emittedPrefixBytes":count.chars,"textMultiplier":64,"lastTotal":count.total,"refused":failed,"components":rows,"scope":"retained old algorithm on current layout and declared test staging; not a reconstruction of missing Round16 staging"})
+}
+fn clone_equal(a: &SfccFeatureSet, b: &SfccFeatureSet) -> bool {
+    a.run_id == b.run_id
+        && a.trace_diagnostics == b.trace_diagnostics
+        && a.unresolved_branch_paths == b.unresolved_branch_paths
+        && a.index.private_storage_clone_equal_a(&b.index)
+        && a.curves.len() == b.curves.len()
+        && a.curves
+            .iter()
+            .zip(&b.curves)
+            .all(|(a, b)| a.private_storage_clone_equal_a(b))
+        && a.strata.len() == b.strata.len()
+        && a.strata
+            .iter()
+            .zip(&b.strata)
+            .all(|(a, b)| a.private_storage_clone_equal_a(b))
+        && a.corners.len() == b.corners.len()
+        && a.corners.iter().zip(&b.corners).all(|(a, b)| {
+            a.id == b.id
+                && [a.x, a.y, a.z].map(f64::to_bits) == [b.x, b.y, b.z].map(f64::to_bits)
+                && a.strata == b.strata
+                && a.curve_ends == b.curve_ends
+        })
+}
