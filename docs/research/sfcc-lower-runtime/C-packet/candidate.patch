+#[test]
+fn inverse_c_proposal_requires_finite_interior_bracket_and_scope_restores() {
+    assert_eq!(height_proposal(2., 4., 10., 20., 15.), Some(3.));
+    assert_eq!(height_proposal(2., 4., 20., 10., 15.), Some(3.));
+    for args in [
+        [2., 4., 10., 10., 10.],
+        [2., 2., 10., 20., 15.],
+        [4., 2., 10., 20., 15.],
+        [2., 4., 10., 20., 10.],
+        [2., 4., 10., 20., 20.],
+        [2., 4., 10., 20., 21.],
+        [2., 4., 10., 20., 9.],
+        [2., 4., -f64::MAX, f64::MAX, 0.],
+        [-f64::MAX, f64::MAX, 10., 20., 15.],
+        [1., 1_f64.next_up(), 10., 20., 15.],
+    ] {
+        assert!(height_proposal(args[0], args[1], args[2], args[3], args[4]).is_none());
+    }
+    for invalid in [f64::NAN, f64::INFINITY, f64::NEG_INFINITY] {
+        for i in 0..5 {
+            let mut args = [2., 4., 10., 20., 15.];
+            args[i] = invalid;
+            assert!(height_proposal(args[0], args[1], args[2], args[3], args[4]).is_none());
+        }
+    }
+    assert_eq!(midpoint(1., 1_f64.next_up()), Err(Failure::Stagnation));
+    assert_eq!(
+        window(&[(0., 0.), (1., 1.), (2., 0.)], 0.5),
+        Err(Failure::AmbiguousWindow)
+    );
+    assert!(interpolation_enabled());
+    without_interpolation(|| {
+        assert!(!interpolation_enabled());
+        without_interpolation(|| assert!(!interpolation_enabled()));
+        assert!(!interpolation_enabled());
+    });
+    assert!(interpolation_enabled());
+    assert!(
+        std::panic::catch_unwind(|| without_interpolation(|| panic!("scope control"))).is_err()
+    );
+    assert!(interpolation_enabled());
+}
