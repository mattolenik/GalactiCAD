// Threaded rod (sinusoidal helical profile)
// ρ = r + A·sin(k·y − atan2(z,x)), k = 2π/pitch. By default A = tan(ψ)·pitch/(2π) with ψ = 60°
// so changing pitch keeps the meridional flank angle; use .depth() to set A explicitly.

// Coarse thread — easy to see the helix in preview
let coarse = threadedRod
  .radius(12)
  .height(50)
  .pitch(5.5)
  .shift([0, 50, 0])

// Finer pitch — depth follows automatically (smaller A)
let fine = threadedRod
  .radius(8.5)
  .height(35)
  .pitch(2.8)
  .shift([90, 35, 0])

// Explicit radial amplitude (optional): disables pitch+angle depth
let stub = threadedRod
  .radius(15)
  .height(18)
  .pitch(4)
  .depth(1.2)
  .shift([-100, 18, 0])

// Default threadedRod.radius(...) is FDM (smooth sine). profile.iso() is a triangular V-groove / ISO-ish silhouette.
let isoRod = threadedRod.profile
  .iso()
  .radius(10)
  .height(40)
  .pitch(4)
  .shift([0, 40, -120])

return union(coarse, fine, stub, isoRod)
