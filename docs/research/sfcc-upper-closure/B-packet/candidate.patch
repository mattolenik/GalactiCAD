+impl Stratum {
+    pub(crate) fn connection_same_source(&self, other: &Self) -> bool {
+        if self.correlated_same_chart_source_c(other) {
+            return true;
+        }
+        self.id == other.id
+            && self.sign == other.sign
+            && self.kind == other.kind
+            && self.same_exposed_domain(other)
+            && match (&self.compound, &other.compound) {
+                (Some(a), Some(b)) => std::sync::Arc::ptr_eq(a, b),
+                _ => false,
+            }
+    }
+    pub(crate) fn connection_compound(
+        &self,
+        hard: &crate::sdf::CsgNode,
+        groove: &crate::sdf::CsgNode,
+        owner: &crate::sdf::CsgNode,
+    ) -> Option<(f64, f64)> {
+        if self.sign != 1. || self.field.is_some() {
+            return None;
+        }
+        let domains = self.domain.as_ref()?;
+        if domains.len() != 1 || !std::ptr::eq(domains[0].plain_node()?, owner) {
+            return None;
+        }
+        let c = self.compound.as_ref()?;
+        if c.terms.len() != 2 || !c.offset.is_finite() {
+            return None;
+        }
+        let [(a, w), (b, v)] = c.terms.as_slice() else {
+            return None;
+        };
+        if *w <= 0.
+            || !w.is_finite()
+            || w != v
+            || a.sign != 1.
+            || b.sign != 1.
+            || a.compound.is_some()
+            || b.compound.is_some()
+        {
+            return None;
+        }
+        if !std::ptr::eq(a.field.as_ref()?.plain_node()?, hard)
+            || !std::ptr::eq(b.field.as_ref()?.plain_node()?, groove)
+        {
+            return None;
+        }
+        Some((*w, c.offset))
+    }
+}
