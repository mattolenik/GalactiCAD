+/// Sign of squared distance to the represented meridian line minus a positive level squared.
+/// The caller must separately establish the finite exterior segment branch.
+#[cfg(all(test, feature = "serde"))]
+pub(crate) fn meridian_level_sign(
+    rho: f64, world_y: f64, center_y: f64, a: [f64; 2], b: [f64; 2], level: f64,
+) -> Option<i8> {
+    if ![rho, world_y, center_y, a[0], a[1], b[0], b[1], level]
+        .iter().all(|x| x.is_finite()) || level <= 0. {
+        return None;
+    }
+    let dr = difference(b[0], a[0]);
+    let dy = difference(b[1], a[1]);
+    let length2 = dr.mul(&dr).add(&dy.mul(&dy));
+    if length2.sign() == 0 { return None; }
+    let wr = difference(rho, a[0]);
+    let wy = difference(world_y, center_y).sub(&Dyadic::from(a[1]));
+    let determinant = dy.mul(&wr).sub(&dr.mul(&wy));
+    let level = Dyadic::from(level);
+    Some(determinant.mul(&determinant).sub(&level.mul(&level).mul(&length2)).sign())
+}
