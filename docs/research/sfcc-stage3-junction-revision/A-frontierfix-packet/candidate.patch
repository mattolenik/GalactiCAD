+            let (Some(a), Some(b)) = (
+                c.point_at_checked(i as f64),
+                c.point_at_checked((i + 1) as f64),
+            ) else {
+                continue;
+            };
+            if a[1].min(b[1]) > height[0] || a[1].max(b[1]) < height[1] {
+                continue;
+            }
