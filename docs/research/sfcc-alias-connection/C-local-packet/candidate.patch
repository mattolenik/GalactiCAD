+fn points(pre: &Value) -> PointTable {
+    let mut result = PointTable::new();
+    for row in pre["allPrivatePoints"].as_array().unwrap() {
+        let p: [f64; 3] = std::array::from_fn(|k| number(&row["positionHex"][k]));
+        let n: [f64; 3] = std::array::from_fn(|k| number(&row["normalHex"][k]));
+        let create = || [p[0], p[1], p[2], n[0], n[1], n[2]];
+        let id = if let Some(key) = row["key"]["numericHex"].as_str() {
+            result.get_or_create(u64::from_str_radix(key, 16).unwrap() as i64, create)
+        } else if let Some(key) = row["key"]["string"].as_str() {
+            result.get_or_create_str(key, create)
+        } else {
+            assert!(row["key"].is_null());
+            result.add(p[0], p[1], p[2], n[0], n[1], n[2])
+        };
+        assert_eq!(
+            id,
+            row["id"].as_u64().unwrap() as usize,
+            "point/key insertion must retain captured indices"
+        );
+        assert_eq!(
+            [result.x(id), result.y(id), result.z(id)].map(f64::to_bits),
+            p.map(f64::to_bits)
+        );
+        assert_eq!(
+            [result.nx(id), result.ny(id), result.nz(id)].map(f64::to_bits),
+            n.map(f64::to_bits)
+        );
+    }
+    result
