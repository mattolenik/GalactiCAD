+#[cfg(test)]
+pub(crate) fn without_resolution<T>(f: impl FnOnce() -> T) -> T {
+    struct Reset(bool);
+    impl Drop for Reset {
+        fn drop(&mut self) {
+            DISABLED.with(|x| x.set(self.0));
+        }
+    }
+    let _r = Reset(DISABLED.with(|x| x.replace(true)));
+    f()
+}
