+//! Typed Y-face point certificate only. It does not authorize a face or arc rewrite.
+use super::super::correlated_c::transport_a::{self, Transport};
+use super::*;
+use crate::{
+    math::grid::{
+        face_axes, pack_point, point_to_world, stride_at_level, unpack_point, SfccLattice,
+    },
+    sfcc::{
+        face_contour::{FacePin, FaceRecord},
+        feature_set::SfccFeatureSet,
+        octree::SfccOctree,
+        point_table::{PointKey, PointTable},
+        shared_arc_plan::cell_faces,
+        triangle_quality as q,
+    },
+};
+use serde_json::{json, Value};
+use std::collections::HashMap;
+type BResult<T> = std::result::Result<T, &'static str>;
+type FaceId = (usize, i64, i64);
+fn bound(p: [f64; 3], image: ([f64; 3], [f64; 3])) -> Option<f64> {
+    let mut d = I::point(0.);
+    for k in 0..3 {
+        d = d.add(square(
+            I::point(p[k]).sub(interval(image.0[k], image.1[k])?)?,
+        )?)?;
+    }
+    Some(sqrt(d)?.hi)
+}
+fn actual_consumers(
+    oct: &SfccOctree,
+    faces: &[HashMap<i64, FaceRecord>; 3],
+    id: FaceId,
+) -> BResult<Vec<([i64; 4], usize)>> {
+    let mut out = Vec::new();
+    for c in &oct.leaves {
+        if !cell_faces(oct, faces, c).contains(&id) {
+            continue;
+        }
+        let stride = stride_at_level(&oct.lat, c.level);
+        let base = [c.ix * stride, c.iy * stride, c.iz * stride];
+        let g = unpack_point(&oct.lat, id.1);
+        let side = if g[id.0] == base[id.0] {
+            0
+        } else if g[id.0] == base[id.0] + stride {
+            1
+        } else {
+            return Err("consumer_plane");
+        };
+        out.push(([c.level as i64, c.ix, c.iy, c.iz], side));
+        if out.len() > 2 {
+            return Err("consumer_count");
+        }
+    }
+    if out.len() != 2 || out[0].1 == out[1].1 {
+        return Err("opposite_consumers");
+    }
+    Ok(out)
+}
+pub(crate) fn admit(
+    f: &SfccFeatureSet,
+    cert: &alias_a::Certificate<'_>,
+    budget: &mut Transport<'_>,
+    lat: &SfccLattice,
+    id: FaceId,
+    r: &FaceRecord,
+    plane: f64,
+    live: &PointTable,
+) -> BResult<Value> {
+    if !cert.bound_to(f) || !budget.bound_to(f) {
+        return Err("source_instance");
+    }
+    if id.0 != 1 {
+        return Err("unsupported_face_axis");
+    }
+    if r.len != id.2 {
+        return Err("typed_face_length");
+    }
+    let rect = alias_face_b::rectangle(lat, id.0, id.1, r)?;
+    if plane.to_bits() != rect[0][id.0].to_bits() {
+        return Err("typed_face_plane");
+    }
+    if r.consumed_fwd.len() != r.segments.len()
+        || r.consumed_rev.len() != r.segments.len()
+        || r.consumed_fwd
+            .iter()
+            .chain(&r.consumed_rev)
+            .any(|&n| n != 0)
+    {
+        return Err("not_pregraph_record");
+    }
+    let pair = cert.charts();
+    let target: Vec<_> = r
+        .pins
+        .iter()
+        .filter(|p| pair.contains(&p.curve_id))
+        .copied()
+        .collect();
+    if target.len() != 2 || target[0].curve_id == target[1].curve_id {
+        return Err("pin_inventory");
+    }
+    let pins = [
+        *target.iter().find(|p| p.curve_id == pair[0]).unwrap(),
+        *target.iter().find(|p| p.curve_id == pair[1]).unwrap(),
+    ];
+    if pins[0].point_id == pins[1].point_id {
+        return Err("already_same_point");
+    }
+    let mut points = [[0.; 3]; 2];
+    for (slot, pin) in pins.iter().enumerate() {
+        if pin.point_id >= live.count() {
+            return Err("point_binding");
+        }
+        let expected = format!("F{}:{}:{}:{:.12}", id.0, id.1, pin.curve_id, pin.t);
+        if !matches!(live.key_at(pin.point_id),PointKey::Str(k) if k==&expected) {
+            return Err("pin_provenance");
+        }
+        points[slot] = q::pos(live, pin.point_id);
+    }
+    let eps = cert.allowance();
+    let axes = face_axes(id.0);
+    let boxes = [
+        rounding_face_box(id.0, plane, points[0]).ok_or("pin_rounding_face")?,
+        rounding_face_box(id.0, plane, points[1]).ok_or("pin_rounding_face")?,
+    ];
+    let hull: ([f64; 3], [f64; 3]) = (
+        std::array::from_fn(|k| boxes[0].0[k].min(boxes[1].0[k])),
+        std::array::from_fn(|k| boxes[0].1[k].max(boxes[1].1[k])),
+    );
+    if !(0..3).all(|k| hull.0[k] >= rect[0][k] && hull.1[k] <= rect[1][k]) {
+        return Err("original_rounding_container");
+    }
+    let rho = cert.radial_from_height(plane).ok_or("physical_root")?;
+    let grho = cert
+        .generated_radial_from_height(plane)
+        .ok_or("generated_root")?;
+    let mut physical = cert.image(rho[0], rho[1]).ok_or("physical_root_scope")?;
+    let mut generated = cert
+        .generated_image(grho[0], grho[1])
+        .ok_or("generated_root_scope")?;
+    for image in [&mut physical, &mut generated] {
+        if image.0[id.0] > plane || image.1[id.0] < plane {
+            return Err("root_plane_enclosure");
+        }
+        // The source inverse fixes this coordinate exactly; only transverse coordinates retain interval width.
+        image.0[id.0] = plane;
+        image.1[id.0] = plane;
+        if !(0..3).all(|k| image.0[k] >= hull.0[k] && image.1[k] <= hull.1[k]) {
+            return Err("root_outside_original_container");
+        }
+        if !axes
+            .iter()
+            .all(|&k| image.0[k] > rect[0][k] && image.1[k] < rect[1][k])
+        {
+            return Err("root_not_face_interior");
+        }
+    }
+    let grid = unpack_point(lat, id.1);
+    let mut high_grid = grid;
+    for k in axes {
+        high_grid[k] += id.2;
+    }
+    let lattice_high = point_to_world(lat, high_grid[0], high_grid[1], high_grid[2]);
+    if !axes
+        .iter()
+        .all(|&k| physical.1[k] < lattice_high[k] && generated.1[k] < lattice_high[k])
+    {
+        return Err("root_lattice_corner_extent");
+    }
+    let strict = pair
+        .iter()
+        .filter_map(|&id| f.curves[id].traced_carriers().map(|(_, _, r)| r.curve_eps))
+        .fold(f64::INFINITY, f64::min);
+    if !strict.is_finite() || strict <= 0. {
+        return Err("strict_residual");
+    }
+    for &id in &pair {
+        for &sid in &f.curves[id].adjacent_strata {
+            for p in points {
+                let s = &f.strata[sid];
+                if !s.domain_contains(p, strict)
+                    || !s
+                        .raw_field(p[0], p[1], p[2])
+                        .normalized_equation()
+                        .is_some_and(|v| v.value.is_finite() && v.value.abs() <= strict)
+                {
+                    return Err("original_domain_residual");
+                }
+            }
+        }
+    }
+    let charged_before = budget.charged_queries();
+    let mut rows = Vec::new();
+    let mut queries = Vec::new();
+    for slot in 0..2 {
+        let p = points[slot];
+        let pin = pins[slot];
+        let event = cert
+            .retained_main(pin.curve_id, pin.t, p, budget)
+            .map_err(|_| "actual_own_query")?;
+        let own = event.point();
+        let direct = [
+            bound(p, physical).ok_or("physical_distance")?,
+            bound(own, physical).ok_or("physical_distance")?,
+            bound(p, generated).ok_or("generated_distance")?,
+            bound(own, generated).ok_or("generated_distance")?,
+        ];
+        if direct.iter().any(|&d| d > eps) {
+            return Err("root_association");
+        }
+        if !transport_a::accepts(points[0], own, eps) {
+            return Err("canonical_to_own_query");
+        }
+        queries.push(own);
+        rows.push(json!({"chart":pin.curve_id,"pointId":pin.point_id,"parameterBits":pin.t.to_bits(),"storedBits":p.map(f64::to_bits),"ownBits":own.map(f64::to_bits),"directRootBounds":direct}));
+    }
+    Ok(
+        json!({"scope":"typed original adaptive Y-face point certificate only; complete arc/consumer transaction still required","face":id,"recordFace":[r.axis,r.key,r.len],"rectangleBits":rect.map(|p|p.map(f64::to_bits)),"latticeCornerHighBits":lattice_high.map(f64::to_bits),"planeBits":plane.to_bits(),"originalRoundingHullBits":[hull.0.map(f64::to_bits),hull.1.map(f64::to_bits)],"physicalRootBits":[physical.0.map(f64::to_bits),physical.1.map(f64::to_bits)],"generatedRootBits":[generated.0.map(f64::to_bits),generated.1.map(f64::to_bits)],"pointBindings":rows,"allowance":eps,"strictResidual":strict,"canonicalCandidate":pins[0].point_id,"canonicalPointDirectlyCheckedAgainstBothOwnQueries":true,"chargedBefore":charged_before,"chargedAfter":budget.charged_queries(),"mutationPerformed":false,"publicationAuthority":false}),
+    )
+}
