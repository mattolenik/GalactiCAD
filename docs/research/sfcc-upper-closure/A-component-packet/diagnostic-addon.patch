+#[test]
+fn stage4_component_b_topology_controls() {
+    let tetra = [0, 2, 1, 0, 1, 3, 0, 3, 2, 1, 2, 3];
+    let closed = topology(&tetra, 4).unwrap();
+    assert_eq!(closed["localTopologyValid"], true);
+    assert!(closed["boundaryEdges"].as_array().unwrap().is_empty());
+    let disk = topology(&[0, 1, 2, 0, 2, 3], 4).unwrap();
+    assert_eq!(disk["localTopologyValid"], true);
+    assert_eq!(disk["boundaryEdges"].as_array().unwrap().len(), 4);
+    let bowtie = topology(&[0, 1, 2, 0, 3, 4], 5).unwrap();
+    assert_eq!(bowtie["localTopologyValid"], false);
+    assert_eq!(bowtie["invalidVertexLinks"], json!([0]));
+    let reversed = topology(&[0, 1, 2, 0, 3, 2], 4).unwrap();
+    assert_eq!(reversed["misorientedInternalEdges"], 1);
+    let duplicate = topology(&[0, 1, 2, 0, 2, 1], 3).unwrap();
+    assert_eq!(duplicate["duplicateFaces"], 1);
+    assert!(topology(&[], 0).is_err());
+    assert!(topology(&[0, 1, 4], 4).is_err());
+    assert!(topology(&[0, 1], 4).is_err());
+}
+#[test]
+fn stage4_component_b_request_scope_cleans_up() {
+    let result = std::panic::catch_unwind(|| {
+        let _scope = request(1, [2, 3]);
+        DIAGNOSTIC.with(|s| *s.borrow_mut() = Some(json!({"active":true})));
+        panic!("scope control")
+    });
+    assert!(result.is_err());
+    assert!(REQUEST.with(|s| s.borrow().is_none()));
+    assert!(DIAGNOSTIC.with(|s| s.borrow().is_none()));
+    let unrelated = json!({"owner":"unrelated diagnostic"});
+    DIAGNOSTIC.with(|s| *s.borrow_mut() = Some(unrelated.clone()));
+    let refused = std::panic::catch_unwind(|| request(2, [3, 4]));
+    assert!(refused.is_err());
+    assert!(REQUEST.with(|s| s.borrow().is_none()));
+    assert_eq!(DIAGNOSTIC.with(|s| s.borrow_mut().take()), Some(unrelated));
+}
