+/// Successful prefix only: all source, connected-cover, original-event, corner,
+/// and outgoing endpoint gates execute. No old inverse failure grants admission.
+pub(crate) fn admit(
+    f: &SfccFeatureSet,
+    ids: [usize; 2],
+    tolerance: f64,
+) -> Result<CorrelatedInventory, Refusal> {
+    let mut out = CorrelatedInventory {
+        fingerprint: f.fingerprint(),
+        originals: originals(f, ids),
+        pieces: Vec::new(),
+        endpoints: Vec::new(),
+        original_events: Vec::new(),
+        events: Vec::new(),
+        refusal: None,
+        first_failed_transport: None,
+        scope:
+            "Explicit successful correlated source/event/endpoint admission; publication blocked",
+        publication_ready: false,
+    };
+    attempt(f, ids, tolerance, &mut out, true)?;
+    Ok(out)
+}
+/// Reserve before admit(), including both outgoing-query passes and original knots.
+pub(crate) fn admission_query_reservation(
+    f: &SfccFeatureSet,
+    ids: [usize; 2],
+) -> Result<usize, Refusal> {
+    let c = f
+        .curves
+        .get(ids[0])
+        .ok_or_else(|| fail(f, ids, "chart_selection", "missing admission chart"))?;
+    let mut count = 0usize;
+    for id in ids {
+        let c = f
+            .curves
+            .get(id)
+            .ok_or_else(|| fail(f, ids, "chart_selection", "missing admission chart"))?;
+        let pieces = c.t_max.ceil() - c.t_min.floor();
+        if !pieces.is_finite() || pieces < 1. || pieces > MAX_PIECES as f64 {
+            return Err(fail(f, ids, "piece_cap", "admission reservation"));
+        }
+        count += pieces as usize + 1;
+    }
+    for id in [c.corner_start, c.corner_end] {
+        let corner = usize::try_from(id)
+            .ok()
+            .and_then(|i| f.corners.get(i))
+            .ok_or_else(|| fail(f, ids, "endpoint_missing", "admission reservation"))?;
+        count += 2 * corner.curve_ends.len();
+    }
+    Ok(count)
+}
