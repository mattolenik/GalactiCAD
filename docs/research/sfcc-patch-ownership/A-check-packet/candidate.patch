+//! Source-bound cylinder graph restrictions; not a whole-fan ownership certificate.
+use super::*;
+use serde_json::{json,Value};
+
+pub(crate) fn bound(f:&SfccFeatureSet,cylinder_id:usize,yz_lo:[f64;2],yz_hi:[f64;2])->Option<Value>{
+    if yz_lo.iter().chain(&yz_hi).any(|x|!x.is_finite()) || (0..2).any(|k|yz_lo[k]>yz_hi[k]) {return None;}
+    let (source,_,_)=alias_face_b::select(f)?;
+    let cyl=f.strata.get(cylinder_id)?;
+    let (center,axis,radius)=cyl.certificate_cylinder()?;
+    if axis!=[0.,1.,0.] || !radius.is_finite() || radius<=0. || cyl.sign!=1. {return None;}
+    let root=cyl.exposure_root_a()?;
+    let (cap_cut,sphere,outer_r)=pair(root,Some((BlendKind::Smax,SminMode::Round))).ok()?;
+    let (groove_cut,cap,_)=pair(cap_cut,None).ok()?;
+    let (hard,groove,chamfer_r)=pair(groove_cut,Some((BlendKind::Smax,SminMode::Chamfer))).ok()?;
+    let (inner,cylinder,_)=pair(hard,None).ok()?;
+    let (other,native,inner_r)=pair(inner,Some((BlendKind::Smin,SminMode::Round))).ok()?;
+    let cylinder=leaf(cylinder,1.).ok()?;let native=leaf(native,1.).ok()?;let other=leaf(other,1.).ok()?;
+    let groove=leaf(groove,-1.).ok()?;let cap=leaf(cap,-1.).ok()?;let sphere=leaf(sphere,1.).ok()?;
+    let (p,rn,ro,rr)=f.strata[source[0]].round_twisted_source(&f.strata[source[1]])?;
+    let registered=cyl.correlated_cylinder_source_c(&f.strata[source[0]])?;
+    if !std::ptr::eq(cylinder,registered)||!std::ptr::eq(native,rn)||!std::ptr::eq(other,ro)||rr!=inner_r||cylinder.pos!=center
+        || [native,other,groove,sphere].iter().any(|l|l.pos[0]!=center[0]||l.pos[2]!=center[2]) {return None;}
+    let Shape::Cylinder{r,h}=cylinder.shape else{return None;};if r!=radius{return None;}
+    let y=interval(yz_lo[0],yz_hi[0])?;let z=interval(yz_lo[1],yz_hi[1])?;
+    let radial_z=z.sub(I::point(center[2]))?;
+    let radical=square(I::point(radius))?.sub(square(radial_z)?)?;if radical.lo<=0.{return None;}
+    let radial_x=sqrt(radical)?.mul(-1.)?;let x=radial_x.add(I::point(center[0]))?;
+    let theta=div(y.sub(I::point(p.pos_y))?.add(I::point(p.h))?,2.*p.h)?.mul(p.twist_rad)?;
+    let (sn,cs)=sin_cos(theta)?;
+    let u=mul(radial_x,cs)?.add(mul(radial_z,sn)?)?;
+    let v=mul(radial_z,cs)?.sub(mul(radial_x,sn)?)?;
+    let native_level=u.sub(I::point(p.v0x))?.mul(p.nx2)?.add(v.sub(I::point(p.v0z))?.mul(p.nz2)?)?;
+    let profile=upper_source_a::finite_profile_level(p,native,[u,v],native_level)?;
+    let native_cap=upper_source_a::cap_margin(y,p.pos_y,p.h,native_level)?;
+    let cylinder_cap=upper_source_a::cap_margin(y,center[1],h,I::point(0.))?;
+    let competitor=activation_a::meridian_bound(other,I::point(radius),y)?;
+    let groove_distance=activation_a::meridian_bound(groove,I::point(radius),y)?;
+    if competitor.distance.lo<=inner_r || native_level.hi>=inner_r{return None;}
+    let Shape::Extrude{h:cap_h,..}=cap.shape else{return None;};
+    let cap_margin=I::point(cap.pos[1]).sub(I::point(cap_h))?.sub(y)?.lo;
+    let Shape::Sphere{r:sphere_r}=sphere.shape else{return None;};
+    let sphere_distance=sqrt(square(I::point(radius))?.add(square(y.sub(I::point(sphere.pos[1]))?)?)?;
+    let outer_margin=I::point(sphere_r).sub(I::point(outer_r))?.sub(sphere_distance)?.lo;
+    if cap_margin<=0.||outer_margin<=0.{return None;}
+    let groove_margin=groove_distance.distance.sub(I::point(chamfer_r))?;
+    let exposed=native_level.hi<=0. && groove_margin.lo>=0.;
+    // On this cylinder graph C=0 and I=E. Monotone max ancestors preserve this positive lower witness.
+    let bevel=I::point(chamfer_r).sub(groove_distance.distance)?.mul(std::f64::consts::FRAC_1_SQRT_2)?;
+    let positive_lower=native_level.lo.max(bevel.lo).max(0.);
+    Some(json!({"scope":"entire source cylinder graph over supplied YZ rectangle; not fan coverage or boundary transport",
+        "source":[source[0],source[1],cylinder_id],"sourceFingerprint":f.fingerprint().to_string(),
+        "yzBox":[yz_lo,yz_hi],"worldImage":[[x.lo,y.lo,z.lo],[x.hi,y.hi,z.hi]],
+        "nativeLevel":[native_level.lo,native_level.hi],"otherDistance":[competitor.distance.lo,competitor.distance.hi],
+        "grooveDistance":[groove_distance.distance.lo,groove_distance.distance.hi],
+        "grooveMargin":[groove_margin.lo,groove_margin.hi],"finiteProfileMargin":profile,
+        "nativeCapMargin":native_cap,"cylinderCapMargin":cylinder_cap,"capCutMargin":cap_margin,"outerRoundMargin":outer_margin,
+        "nativeIsInnerField":true,"fullSourceEqualsCylinder":exposed,"composedSourcePositiveLower":positive_lower,
+        "projectionOwnershipDisproved":positive_lower>0.,"cylinderGraphDerivativeLower":(-radial_x.hi)/radius,
+        "wholeFanOwnership":false}))
+}
