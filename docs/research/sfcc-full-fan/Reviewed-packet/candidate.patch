+        "surfaceTolerance":surface_tolerance,"exactFaceIncidencePreserved":false,"surfaceToleranceViolationProved":false,
+        "fullFanGraphRefuted":false,"faceCompatibleAlternativeTransportExcluded":false,"publicationAuthorized":false,
+        "limitation":"a common source lift shared by neighbouring consumers could still be valid; cell-trimmed coverage and conforming interface transport require separate proof"});
+    if let Ok(path) = std::env::var("SFCC_FULLFAN_C_RECEIPT") {
+        std::fs::write(path, serde_json::to_vec_pretty(&report).unwrap()).unwrap();
