// Passenger Car Model
// A classic vintage roadster with flowing curves


// === MAIN BODY ===
// Central body tub - narrow and elegant
let bodyTub = box([0, 0, 8], [44, 14, 6])

// Rounded front cowl
let cowl = sphere([10, 0, 9], { r: 10 })

// Rounded rear deck
let rearDeck = sphere([-16, 0, 8], { r: 9 })

// Smooth the main body
let mainBody = union(4, bodyTub, cowl, rearDeck)

// === LONG HOOD ===
// Classic long hood with power bulge
let hoodBase = box([20, 0, 7], [24, 10, 5])
let hoodTop = sphere([22, 0, 9], { r: 7 })
let hood = union(3, hoodBase, hoodTop)

// Radiator grille at front
let grille = box([34, 0, 7], [4, 8, 7])
let grilleTop = sphere([35, 0, 10], { r: 5 })
let frontEnd = union(2, grille, grilleTop)

// === SEPARATE FENDERS ===
// Front fenders - swooping pontoon style
let fenderFR = sphere([22, 10, 5], { r: 7 })
let fenderFRext = sphere([30, 10, 6], { r: 5 })
let frontFenderR = union(3, fenderFR, fenderFRext)

let fenderFL = sphere([22, -10, 5], { r: 7 })
let fenderFLext = sphere([30, -10, 6], { r: 5 })
let frontFenderL = union(3, fenderFL, fenderFLext)

// Rear fenders - rounded pontoons
let fenderRR = sphere([-18, 10, 5], { r: 7 })
let fenderRRext = sphere([-24, 10, 6], { r: 5 })
let rearFenderR = union(3, fenderRR, fenderRRext)

let fenderRL = sphere([-18, -10, 5], { r: 7 })
let fenderRLext = sphere([-24, -10, 6], { r: 5 })
let rearFenderL = union(3, fenderRL, fenderRLext)

// === RUNNING BOARDS ===
// Connect front and rear fenders
let runningBoardR = box([2, 10, 3], [30, 3, 2])
let runningBoardL = box([2, -10, 3], [30, 3, 2])

// === CABIN ===
// Open cockpit with windshield frame
let cockpit = box([-2, 0, 12], [16, 12, 5])
let windshieldFrame = box([8, 0, 15], [2, 11, 4])
let cabinArea = union(2, cockpit, windshieldFrame)

// Carve out interior
let interior = box([-2, 0, 13], [14, 10, 6])
let openCockpit = subtract(1, cabinArea, interior)

// === SPARE TIRE ===
// Mounted on rear
let spareTire = sphere([-28, 0, 8], { r: 5 })

// === HEADLIGHTS ===
// Classic round headlights on stalks
let headlightR = sphere([32, 9, 9], { r: 3 })
let headlightL = sphere([32, -9, 9], { r: 3 })
let headlights = union(headlightR, headlightL)

// === WHEELS ===
// Wire wheels with whitewall look
let wheelFR = sphere([22, 12, 3], { r: 5 })
let wheelFL = sphere([22, -12, 3], { r: 5 })
let wheelRR = sphere([-18, 12, 3], { r: 5 })
let wheelRL = sphere([-18, -12, 3], { r: 5 })
let wheels = union(wheelFR, wheelFL, wheelRR, wheelRL)

// === TAILLIGHTS ===
let taillightR = sphere([-28, 6, 10], { r: 1.5 })
let taillightL = sphere([-28, -6, 10], { r: 1.5 })
let taillights = union(taillightR, taillightL)

// === DOOR HANDLES ===
let handleR = sphere([0, 8, 10], { r: 1 })
let handleL = sphere([0, -8, 10], { r: 1 })
let handles = union(handleR, handleL)

// === ASSEMBLY ===
// Build up the body
let upperBody = union(3, mainBody, hood, frontEnd, openCockpit)

// Add fenders
let withFenders = union(2, upperBody,
frontFenderR, frontFenderL,
rearFenderR, rearFenderL)

// Add running boards
let withRunning = union(1, withFenders,
runningBoardR, runningBoardL)

// Final details
let details = union(spareTire, headlights, taillights, handles)

// Complete car
return union(1, withRunning, wheels, details)
