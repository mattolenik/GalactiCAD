+//! One native/chamfer source arc, with independent numerical chart events.
+use super::*;
+use crate::sfcc::feature_curves::FeatureCurve;
+use crate::sfcc::shared_twisted_proof::correlated_c::transport_a::{self, Transport};
+
+type AResult<T> = std::result::Result<T, Failure>;
+#[derive(Debug)]
+pub(crate) enum Failure {
+    Source,
+    Range,
+    Query,
+    Container,
+    Association,
+    Order,
+    Ambiguous,
+    Stagnation,
+    RequestCap,
+    Scope,
+    Budget(transport_a::Failure),
+}
+#[derive(Clone)]
+pub(crate) struct Event<'a> {
+    features: &'a SfccFeatureSet,
+    chart: usize,
+    parameter: f64,
+    point: [f64; 3],
+    radial: f64,
+}
+impl Event<'_> {
+    pub(crate) fn chart(&self) -> usize {
+        self.chart
+    }
+    pub(crate) fn parameter(&self) -> f64 {
+        self.parameter
+    }
+    pub(crate) fn point(&self) -> [f64; 3] {
+        self.point
+    }
+    pub(crate) fn radial(&self) -> f64 {
+        self.radial
+    }
+}
+impl std::fmt::Debug for Event<'_> {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_tuple("AliasEvent")
+            .field(&self.chart)
+            .field(&self.parameter)
+            .field(&self.point)
+            .finish()
+    }
+}
+/// The immutable borrow supplies source/curve identity; no authority survives mutation.
+pub(crate) struct Certificate<'a> {
+    features: &'a SfccFeatureSet,
+    source: [usize; 4],
+    charts: [usize; 2],
+    ranges: [[f64; 2]; 2],
+    radial: [f64; 2],
+    allowance: f64,
+    chart: connection_a::ConnectionChart,
+    generated_radius: I,
+    tubes: [([f64; 3], [f64; 3]); 2],
+    source_margins: [f64; 6],
+    authority_box: ([f64; 3], [f64; 3]),
+    authority_alias_margins: [f64; 3],
+    height_derivative_abs_lower: f64,
+    generated_offset_error: I,
+    source_generated_separation_upper: f64,
+}
+fn quotient(a: I, b: I) -> Option<I> {
+    if b.lo <= 0. && b.hi >= 0. {
+        return None;
+    }
+    mul(a, interval((1. / b.hi).next_down(), (1. / b.lo).next_up())?)
+}
+fn absmax(a: I) -> f64 {
+    a.lo.abs().max(a.hi.abs())
+}
+fn distance(p: [f64; 3], image: ([f64; 3], [f64; 3])) -> Option<f64> {
+    let mut d = I::point(0.);
+    for k in 0..3 {
+        d = d.add(square(
+            I::point(p[k]).sub(interval(image.0[k], image.1[k])?)?,
+        )?)?;
+    }
+    Some(sqrt(d)?.hi)
+}
+fn midpoint(i: I) -> f64 {
+    i.lo * 0.5 + i.hi * 0.5
+}
+fn same_pair(a: [usize; 2], b: [usize; 2]) -> bool {
+    a == b || a == [b[1], b[0]]
+}
+fn normal(chart: &connection_a::ConnectionChart) -> Option<(I, I)> {
+    let dr = I::point(chart.edge[2]).sub(I::point(chart.edge[0]))?;
+    let dy = I::point(chart.edge[3]).sub(I::point(chart.edge[1]))?;
+    let len = sqrt(square(dr)?.add(square(dy)?)?)?;
+    Some((
+        quotient(dy.mul(chart.orientation as f64)?, len)?,
+        quotient(dr.mul(-(chart.orientation as f64))?, len)?,
+    ))
+}
+fn coordinates(chart: &connection_a::ConnectionChart, rho: I, radius: I) -> Option<(I, I, [I; 3])> {
+    let (nr, ny) = normal(chart)?;
+    let y = quotient(radius.sub(mul(nr, rho.sub(I::point(chart.edge[0]))?)?)?, ny)?
+        .add(I::point(chart.edge[1]))?;
+    let mut u = sqrt(square(rho)?.sub(square(I::point(chart.p.v0z))?)?)?;
+    if chart.sign < 0 {
+        u = u.mul(-1.)?;
+    }
+    if u.lo <= 0. && u.hi >= 0. {
+        return None;
+    }
+    let p = chart.p;
+    let theta = div(y.sub(I::point(p.pos_y))?.add(I::point(p.h))?, 2. * p.h)?.mul(p.twist_rad)?;
+    let (s, c) = sin_cos(theta)?;
+    let xyz = [
+        mul(u, c)?.sub(s.mul(p.v0z)?)?.add(I::point(p.pos_x))?,
+        y,
+        mul(u, s)?.add(c.mul(p.v0z)?)?.add(I::point(p.pos_z))?,
+    ];
+    Some((y, u, xyz))
+}
+// Check the whole physical/generated radius interval, not only its two endpoints.
+fn groove_interval(
+    groove: &Leaf,
+    edge_id: usize,
+    chart: &connection_a::ConnectionChart,
+    rho: I,
+    radius: I,
+) -> Option<()> {
+    let Shape::Lathe { edges } = &groove.shape else {
+        return None;
+    };
+    if radius.lo <= 0. {
+        return None;
+    }
+    let y = coordinates(chart, rho, radius)?.0;
+    let edge = edges.get(edge_id)?;
+    let dr = I::point(edge.r1).sub(I::point(edge.r0))?;
+    let dy = I::point(edge.y1).sub(I::point(edge.y0))?;
+    let wr = rho.sub(I::point(edge.r0))?;
+    let wy = y.sub(I::point(edge.y0))?;
+    let along = quotient(
+        mul(dr, wr)?.add(mul(dy, wy)?)?,
+        square(dr)?.add(square(dy)?)?,
+    )?;
+    if along.lo <= 0. || along.hi >= 1. {
+        return None;
+    }
+    for (i, e) in edges.iter().enumerate() {
+        if i == edge_id {
+            continue;
+        }
+        let dr = I::point(e.r1).sub(I::point(e.r0))?;
+        let dy = I::point(e.y1).sub(I::point(e.y0))?;
+        let wr = rho.sub(I::point(e.r0))?;
+        let wy = y.sub(I::point(e.y0))?;
+        let t = quotient(
+            mul(dr, wr)?.add(mul(dy, wy)?)?,
+            square(dr)?.add(square(dy)?)?,
+        )?;
+        let t = interval(t.lo.clamp(0., 1.), t.hi.clamp(0., 1.))?;
+        let d = sqrt(square(wr.sub(mul(dr, t)?)?)?.add(square(wy.sub(mul(dy, t)?)?)?)?)?;
+        if d.lo <= radius.hi {
+            return None;
+        }
+    }
+    Some(())
+}
+impl<'a> Certificate<'a> {
+    pub(crate) fn bound_to(&self, f: &SfccFeatureSet) -> bool {
+        std::ptr::eq(self.features, f)
+    }
+    pub(crate) fn source(&self) -> [usize; 4] {
+        self.source
+    }
+    pub(crate) fn charts(&self) -> [usize; 2] {
+        self.charts
+    }
+    pub(crate) fn ranges(&self) -> [[f64; 2]; 2] {
+        self.ranges
+    }
+    pub(crate) fn radial_range(&self) -> [f64; 2] {
+        self.radial
+    }
+    pub(crate) fn allowance(&self) -> f64 {
+        self.allowance
+    }
+    /// Source/container association only; the caller must separately establish actual own-query provenance.
+    pub(crate) fn check_point(&self, chart: usize, t: f64, point: [f64; 3]) -> Option<f64> {
+        let s = self.slot(chart, t).ok()?;
+        if (0..3).any(|k| point[k] < self.tubes[s].0[k] || point[k] > self.tubes[s].1[k]) {
+            return None;
+        }
+        if (0..3).any(|k| point[k] < self.authority_box.0[k] || point[k] > self.authority_box.1[k])
+        {
+            return None;
+        }
+        self.associate(point).ok()
+    }
+
+    pub(crate) fn image(&self, a: f64, b: f64) -> Option<([f64; 3], [f64; 3])> {
+        self.image_radius(a, b, I::point(self.chart.radius))
+    }
+    pub(crate) fn generated_image(&self, a: f64, b: f64) -> Option<([f64; 3], [f64; 3])> {
+        self.image_radius(a, b, self.generated_radius)
+    }
+    fn image_radius(&self, a: f64, b: f64, r: I) -> Option<([f64; 3], [f64; 3])> {
+        if !a.is_finite() || !b.is_finite() || a > b || a < self.radial[0] || b > self.radial[1] {
+            return None;
+        }
+        let xyz = coordinates(&self.chart, interval(a, b)?, r)?.2;
+        Some((xyz.map(|v| v.lo), xyz.map(|v| v.hi)))
+    }
+    pub(crate) fn radial_from_height(&self, y: f64) -> Option<[f64; 2]> {
+        let v = self.radial_for_radius(y, I::point(self.chart.radius))?;
+        Some([v.lo, v.hi])
+    }
+    pub(crate) fn generated_radial_from_height(&self, y: f64) -> Option<[f64; 2]> {
+        let v = self.radial_for_radius(y, self.generated_radius)?;
+        Some([v.lo, v.hi])
+    }
+    fn radial_for_radius(&self, y: f64, r: I) -> Option<I> {
+        if !y.is_finite() {
+            return None;
+        }
+        let (nr, ny) = normal(&self.chart)?;
+        I::point(self.chart.edge[0]).add(quotient(
+            r.sub(mul(ny, I::point(y).sub(I::point(self.chart.edge[1]))?)?)?,
+            nr,
+        )?)
+    }
+    fn associate(&self, p: [f64; 3]) -> AResult<f64> {
+        if p.iter().any(|v| !v.is_finite()) {
+            return Err(Failure::Association);
+        }
+        let rho = midpoint(
+            self.radial_for_radius(p[1], I::point(self.chart.radius))
+                .ok_or(Failure::Association)?,
+        )
+        .clamp(self.radial[0], self.radial[1]);
+        let generated = midpoint(
+            self.radial_for_radius(p[1], self.generated_radius)
+                .ok_or(Failure::Association)?,
+        )
+        .clamp(self.radial[0], self.radial[1]);
+        if !distance(p, self.image(rho, rho).ok_or(Failure::Association)?)
+            .is_some_and(|d| d <= self.allowance)
+            || !distance(
+                p,
+                self.generated_image(generated, generated)
+                    .ok_or(Failure::Association)?,
+            )
+            .is_some_and(|d| d <= self.allowance)
+        {
+            return Err(Failure::Association);
+        }
+        Ok(rho)
+    }
+    fn slot(&self, chart: usize, t: f64) -> AResult<usize> {
+        let s = self
+            .charts
+            .iter()
+            .position(|&id| id == chart)
+            .ok_or(Failure::Source)?;
+        if !t.is_finite() || t < self.ranges[s][0] || t > self.ranges[s][1] {
+            return Err(Failure::Range);
+        }
+        Ok(s)
+    }
+    fn evaluated(&self, chart: usize, t: f64) -> AResult<Event<'a>> {
+        let s = self.slot(chart, t)?;
+        if crate::sfcc::cancel::is_cancelled() {
+            return Err(Failure::Budget(transport_a::Failure::Cancelled));
+        }
+        let p = self.features.curves[chart]
+            .point_at_checked(t)
+            .ok_or(Failure::Query)?;
+        if (0..3).any(|k| p[k] < self.tubes[s].0[k] || p[k] > self.tubes[s].1[k]) {
+            return Err(Failure::Container);
+        }
+        if (0..3).any(|k| p[k] < self.authority_box.0[k] || p[k] > self.authority_box.1[k]) {
+            return Err(Failure::Association);
+        }
+        let radial = self.associate(p)?;
+        Ok(Event {
+            features: self.features,
+            chart,
+            parameter: t,
+            point: p,
+            radial,
+        })
+    }
+    /// Every pre-meshing actual query is charged before entry.
+    pub(crate) fn query_main(
+        &self,
+        chart: usize,
+        t: f64,
+        budget: &mut Transport<'_>,
+    ) -> AResult<Event<'a>> {
+        self.slot(chart, t)?;
+        if !budget.bound_to(self.features) {
+            return Err(Failure::Source);
+        }
+        if crate::sfcc::private_arc_a::generated_queries_active() {
+            return Err(Failure::Scope);
+        }
+        if crate::sfcc::cancel::is_cancelled() {
+            return Err(Failure::Budget(transport_a::Failure::Cancelled));
+        }
+        budget.reserve_external(1).map_err(Failure::Budget)?;
+        budget.external_direct_attempt();
+        self.evaluated(chart, t)
+    }
+    /// The existing generated scope reserves and records every attempted own query.
+    pub(crate) fn query_generated(&self, chart: usize, t: f64) -> AResult<Event<'a>> {
+        if !crate::sfcc::private_arc_a::generated_queries_active() {
+            return Err(Failure::Scope);
+        }
+        self.evaluated(chart, t)
+    }
+    pub(crate) fn retained_generated(
+        &self,
+        chart: usize,
+        t: f64,
+        point: [f64; 3],
+    ) -> AResult<Event<'a>> {
+        let e = self.query_generated(chart, t)?;
+        self.check_point(chart, t, point)
+            .ok_or(Failure::Association)?;
+        if !transport_a::accepts(point, e.point, self.allowance) {
+            return Err(Failure::Association);
+        }
+        Ok(e)
+    }
+    /// Both events are checked directly against the same retained mesh point.
+    pub(crate) fn transport_generated(
+        &self,
+        chart: usize,
+        t: f64,
+        point: [f64; 3],
+        target: usize,
+    ) -> AResult<[Event<'a>; 2]> {
+        let own = self.retained_generated(chart, t, point)?;
+        let other = self.map_generated(&own, target)?;
+        self.check_point(target, other.parameter, point)
+            .ok_or(Failure::Association)?;
+        if !transport_a::accepts(point, other.point, self.allowance) {
+            return Err(Failure::Association);
+        }
+        Ok([own, other])
+    }
+    pub(crate) fn retained_main(
+        &self,
+        chart: usize,
+        t: f64,
+        point: [f64; 3],
+        budget: &mut Transport<'_>,
+    ) -> AResult<Event<'a>> {
+        let event = self.query_main(chart, t, budget)?;
+        let s = self.slot(chart, t)?;
+        if (0..3).any(|k| point[k] < self.tubes[s].0[k] || point[k] > self.tubes[s].1[k]) {
+            return Err(Failure::Container);
+        }
+        self.check_point(chart, t, point)
+            .ok_or(Failure::Association)?;
+        if !transport_a::accepts(point, event.point, self.allowance) {
+            return Err(Failure::Association);
+        }
+        Ok(event)
+    }
+    pub(crate) fn map_main(
+        &self,
+        event: &Event<'a>,
+        target: usize,
+        budget: &mut Transport<'_>,
+    ) -> AResult<Event<'a>> {
+        self.map_with(event, target, |chart, t| self.query_main(chart, t, budget))
+    }
+    pub(crate) fn map_generated(&self, event: &Event<'a>, target: usize) -> AResult<Event<'a>> {
+        self.map_with(event, target, |chart, t| self.query_generated(chart, t))
+    }
+    fn map_with(
+        &self,
+        event: &Event<'a>,
+        target: usize,
+        mut evaluate: impl FnMut(usize, f64) -> AResult<Event<'a>>,
+    ) -> AResult<Event<'a>> {
+        if !std::ptr::eq(self.features, event.features) {
+            return Err(Failure::Source);
+        }
+        let mut count = 0;
+        let mut query = |chart, t| {
+            if count >= transport_a::MAX_REQUEST {
+                return Err(Failure::RequestCap);
+            }
+            count += 1;
+            evaluate(chart, t)
+        };
+        let actual = query(event.chart, event.parameter)?;
+        if actual.point.map(f64::to_bits) != event.point.map(f64::to_bits) {
+            return Err(Failure::Source);
+        }
+        let s = self
+            .charts
+            .iter()
+            .position(|&id| id == target)
+            .ok_or(Failure::Source)?;
+        let [a, b] = self.ranges[s];
+        let mut knots = vec![a];
+        knots.extend((a.floor() as i64 + 1..b.ceil() as i64).map(|t| t as f64));
+        knots.push(b);
+        let mut rows = Vec::new();
+        for t in knots {
+            let e = query(target, t)?;
+            if transport_a::accepts(actual.point, e.point, self.allowance) {
+                return Ok(e);
+            }
+            rows.push(e);
+        }
+        let windows: Vec<_> = rows
+            .windows(2)
+            .filter(|p| {
+                actual.point[1] >= p[0].point[1].min(p[1].point[1])
+                    && actual.point[1] <= p[0].point[1].max(p[1].point[1])
+            })
+            .collect();
+        if windows.len() != 1 || windows[0][0].point[1] == windows[0][1].point[1] {
+            return Err(Failure::Ambiguous);
+        }
+        let mut lo = windows[0][0].clone();
+        let mut hi = windows[0][1].clone();
+        let ascending = hi.point[1] > lo.point[1];
+        for i in 0..transport_a::MAX_ITERATIONS {
+            let proposed = if i < 2 {
+                transport_a::height_proposal(
+                    lo.parameter,
+                    hi.parameter,
+                    lo.point[1],
+                    hi.point[1],
+                    actual.point[1],
+                )
+            } else {
+                None
+            };
+            let t = proposed.unwrap_or(lo.parameter + (hi.parameter - lo.parameter) * 0.5);
+            if !t.is_finite() || t <= lo.parameter || t >= hi.parameter {
+                return Err(Failure::Stagnation);
+            }
+            let e = query(target, t)?;
+            if transport_a::accepts(actual.point, e.point, self.allowance) {
+                return Ok(e);
+            }
+            if (e.point[1] < actual.point[1]) == ascending {
+                lo = e;
+            } else {
+                hi = e;
+            }
+        }
+        Err(Failure::RequestCap)
+    }
+    pub(crate) fn ordered(events: &[(Event<'a>, Event<'a>)]) -> AResult<()> {
+        if events.windows(2).any(|w| {
+            w[0].0.chart != w[1].0.chart
+                || w[0].1.chart != w[1].1.chart
+                || w[0].0.parameter >= w[1].0.parameter
+                || w[0].1.parameter >= w[1].1.parameter
+                || w[0].0.radial <= w[1].0.radial
+                || w[0].1.radial <= w[1].1.radial
+        }) {
+            return Err(Failure::Order);
+        }
+        Ok(())
+    }
+}
