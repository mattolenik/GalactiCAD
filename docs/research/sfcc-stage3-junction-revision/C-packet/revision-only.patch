+#[derive(Default)]
+struct Capture {
+    enabled: bool,
+    selected: Vec<usize>,
+    source: Vec<Value>,
+    raw: Vec<Value>,
+    queries: Vec<Value>,
+    frontiers: Vec<Value>,
+    runs: Vec<Value>,
+}
+thread_local! { static CAPTURE: RefCell<Capture> = RefCell::new(Capture::default()); }
+struct Scope;
+impl Drop for Scope {
+    fn drop(&mut self) {
+        CAPTURE.with(|c| *c.borrow_mut() = Capture::default());
+    }
+}
+fn hex(x: f64) -> String {
+    format!("{:016x}", x.to_bits())
+}
+fn lower() -> [f64; 3] {
+    [0xc022b7c9d907b15a, 0xc003efb1a33e9e36, 0x40158f2508500325].map(f64::from_bits)
+}
+fn distance(a: [f64; 3], b: [f64; 3]) -> f64 {
+    (a[0] - b[0]).hypot(a[1] - b[1]).hypot(a[2] - b[2])
+}
+fn selected(curve: &FeatureCurve) -> bool {
+    CAPTURE.with(|c| {
+        let c = c.borrow();
+        c.enabled && c.selected.contains(&curve.id)
+    })
+}
+fn status(result: Result<bool, ()>) -> &'static str {
+    match result {
+        Ok(true) => "positive",
+        Ok(false) => "negative",
+        Err(()) => "unknown",
+    }
+}
