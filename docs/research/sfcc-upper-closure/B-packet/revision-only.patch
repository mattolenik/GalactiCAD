+use super::*;
+use crate::sfcc::{
+    feature_set::SfccCorner,
+    field_branches::FieldRef,
+    pipeline::{build_pipeline_context, PipelineTuning, SfccWorldCube},
+};
+use serde_json::{json, Value};
+fn hex(v: f64) -> String {
+    format!("{:016x}", v.to_bits())
+}
+fn fixture() -> (CsgNode, SfccFeatureSet, Value) {
+    let config: Value =
+        serde_json::from_str(include_str!("../../fixtures/shared-arc-full-knob.json")).unwrap();
+    let root = crate::scene_bridge::build_csg_tree_from_json(config["sceneJson"].as_str().unwrap())
+        .unwrap();
+    let cube = SfccWorldCube {
+        min_x: config["cube"]["min"][0].as_f64().unwrap(),
+        min_y: config["cube"]["min"][1].as_f64().unwrap(),
+        min_z: config["cube"]["min"][2].as_f64().unwrap(),
+        size: config["cube"]["max"][0].as_f64().unwrap()
+            - config["cube"]["min"][0].as_f64().unwrap(),
+    };
+    let f = build_pipeline_context(&root, &cube, &PipelineTuning::default()).features;
+    (root, f, config)
+}
+fn incoming(f: &SfccFeatureSet) -> [usize; 2] {
+    crate::sfcc::stage4_source_preflight_c::selected_pair_c(f).unwrap()
+}
+fn lifted(f: &SfccFeatureSet) -> [usize; 2] {
+    let ids: Vec<_> = f
+        .strata
+        .iter()
+        .filter_map(|s| {
+            s.upper_closure_field_b()
+                .and_then(|v| v.upper_closure_descriptor_b())
+                .map(|(_, child)| (s.id, child))
+        })
+        .collect();
+    assert_eq!(ids.len(), 2, "unique actual outer lifted pair");
+    [
+        ids.iter().find(|(_, c)| *c == 0).unwrap().0,
+        ids.iter().find(|(_, c)| *c == 1).unwrap().0,
+    ]
+}
+fn nearest(f: &SfccFeatureSet, pair: [usize; 2], point: [f64; 3]) -> (usize, f64, f64) {
+    f.curves
+        .iter()
+        .filter(|c| c.adjacent_strata == pair || c.adjacent_strata == [pair[1], pair[0]])
+        .filter_map(|c| {
+            let proposal = c.project(point[0], point[1], point[2]);
+            let q = c.shared_checked_point(proposal.0)?;
+            let d = distance_upper(q, (point, point))?;
+            Some((c.id, proposal.0, d))
+        })
+        .min_by(|a, b| a.2.total_cmp(&b.2))
+        .expect("actual lifted feature exists")
+}
+fn result<T>(r: &Result<T>) -> Value {
+    match r {
+        Ok(_) => json!({"accepted":true}),
+        Err(reason) => json!({"accepted":false,"reason":reason}),
+    }
+}
+#[test]
+fn closure_b_canonical_membership_is_not_consumed_trace_or_handoff_authority() {
+    let (root, f, config) = fixture();
+    let ids = incoming(&f);
+    let pair = lifted(&f);
+    let before = f.fingerprint();
+    let c = ClosureConsumer::bind(&root, &f, ids, pair, 0.5, 0.02).unwrap();
+    let activation = c.canonical(0.).unwrap();
+    let near = c.canonical(0.0005).unwrap();
+    let interior = c.canonical(0.25).unwrap();
+    let (outgoing, t, d) = nearest(&f, pair, interior.point);
+    let consumed = c.consume(outgoing, t, interior.phi);
+    let (activation_curve, activation_t, activation_distance) = nearest(&f, pair, activation.point);
+    let unmatched = c.consume(activation_curve, activation_t, 0.);
+    let admission = crate::sfcc::private_arc_a::admit(&f, ids, 0.02);
+    let report = json!({"scope":"typed source closure and own-query association prototype; no chart remap, graph mutation or interval authority",
+        "sourceConfigSha256":config["sourceConfigSha256"],"fingerprint":before.to_string(),"incomingCharts":ids,"liftedSources":pair,
+        "sourceIdentities":pair.map(|id|f.strata[id].graph_capture_identity_b()),"allowanceHex":hex(c.epsilon),"residualEpsilonHex":hex(c.residual_epsilon),
+        "canonicalEvents":([&activation,&near,&interior]).map(|p|json!({"phiHex":hex(p.phi),"pointHex":p.point.map(hex),"associationUpperHex":hex(p.association_upper),"ordinaryDiscoveryOwned":p.ordinary_owned,"canonicalClosureMembership":true,"consumedTraceEvent":false})),
+        "interiorOwnQuery":{"chart":outgoing,"parameterHex":hex(t),"proposedDistanceHex":hex(d),"verdict":result(&consumed),"checked":consumed.as_ref().ok().map(|e|json!({"chart":e.chart,"parameterHex":hex(e.parameter),"phiHex":hex(e.phi),"pointHex":e.point.map(hex),"associationUpperHex":hex(e.association_upper)}))},
+        "activationOwnQuery":{"chart":activation_curve,"parameterHex":hex(activation_t),"distanceHex":hex(activation_distance),"verdict":result(&unmatched)},
+        "ordinaryOwnershipPredicateChanged":false,"graphChanged":false,"orderedPrefixTransportEstablished":false,"handoffAuthorized":false,
+        "completeAdmission":match &admission {Ok(_)=>json!({"admitted":true}),Err(e)=>json!({"admitted":false,"refusal":e})}});
+    std::fs::write(
+        std::env::var("SFCC_CLOSURE_B_RECEIPT").expect("root receipt path"),
+        serde_json::to_vec_pretty(&report).unwrap(),
+    )
+    .unwrap();
+    assert_eq!(activation.ordinary_owned, [false; 2]);
+    assert_eq!(near.ordinary_owned, [false; 2]);
+    assert_eq!(interior.ordinary_owned, [true; 2]);
+    assert!(
+        consumed.is_ok(),
+        "the corrected outgoing curve must supply a source-associated own query: {}",
+        result(&consumed)
+    );
+    assert!(
+        unmatched.is_err(),
+        "canonical source closure must not pretend the detached raw trace reaches activation"
+    );
+    assert_eq!(before, f.fingerprint());
+}
+#[test]
+fn closure_b_refuses_wrong_descriptor_registry_source_and_parameters() {
+    let (root, f, _) = fixture();
+    let ids = incoming(&f);
+    let pair = lifted(&f);
+    let c = ClosureConsumer::bind(&root, &f, ids, pair, 0.5, 0.02).unwrap();
+    assert!(c.canonical(-0.0001).is_err());
+    assert!(c.canonical(0.5001).is_err());
+    assert!(c.canonical(f64::NAN).is_err());
+    assert!(ClosureConsumer::bind(&root, &f, ids, pair, 0., 0.02).is_err());
+    assert!(ClosureConsumer::bind(&root, &f, ids, pair, 0.5, 0.).is_err());
+    let near = c.canonical(0.25).unwrap();
+    let (outgoing, t, _) = nearest(&f, pair, near.point);
+    assert!(c.consume(ids[0], f.curves[ids[0]].t_min, 0.).is_err());
+    assert!(c.consume(outgoing, f64::NAN, 0.25).is_err());
+    assert!(c
+        .consume(outgoing, f.curves[outgoing].t_max + 1., 0.25)
+        .is_err());
+    assert!(c.consume(outgoing, t, 0.).is_err());
+    let opposite = f
+        .curves
+        .iter()
+        .find(|curve| {
+            curve.id != outgoing
+                && (curve.adjacent_strata == pair || curve.adjacent_strata == [pair[1], pair[0]])
+        })
+        .expect("other actual source-family branch");
+    assert!(
+        c.consume(opposite.id, opposite.t_min, 0.25).is_err(),
+        "same lifted source labels do not identify the selected spatial branch"
+    );
+    let mut wrong = root.clone();
+    if let CsgNode::Blend { r, .. } = &mut wrong {
+        *r += 0.001;
+    } else {
+        panic!()
+    }
+    assert!(ClosureConsumer::bind(&wrong, &f, ids, pair, 0.5, 0.02).is_err());
+    let (_, foreign, _) = fixture();
+    let other_pair = lifted(&foreign);
+    let mut mixed = f.clone();
+    mixed.strata[pair[0]] = foreign.strata[other_pair[0]].clone();
+    assert!(
+        ClosureConsumer::bind(&root, &mixed, ids, pair, 0.5, 0.02).is_err(),
+        "lifted pair must retain one immutable source copy"
+    );
+    let mut stale = f.clone();
+    for i in 0..2 {
+        stale.strata[pair[i]] = foreign.strata[other_pair[i]].clone();
+    }
+    let closed = ClosureConsumer::bind(&root, &stale, ids, pair, 0.5, 0.02).unwrap();
+    assert_eq!(
+        closed.consume(outgoing, t, 0.25).err(),
+        Some("chart_registry_binding"),
+        "same source values cannot authorize stale embedded chart carriers"
+    );
+    let source = std::sync::Arc::new(root.clone());
+    let descriptor = |partners: Vec<usize>| {
+        FieldRef::new(source.clone(), vec![]).with_branch(
+            vec![0, 0, 0],
+            crate::sfcc::branch_surfaces::FieldBranch::Child(0),
+            1e-8,
+            partners.into(),
+        )
+    };
+    assert!(descriptor(vec![1, usize::MAX, 1])
+        .upper_closure_descriptor_b()
+        .is_some());
+    assert!(descriptor(vec![0, usize::MAX, 1])
+        .upper_closure_descriptor_b()
+        .is_none());
+}
+#[test]
+fn closure_b_point_membership_cannot_hide_missing_incident_sources() {
+    let (root, f, _) = fixture();
+    let ids = incoming(&f);
+    let pair = lifted(&f);
+    let c = ClosureConsumer::bind(&root, &f, ids, pair, 0.5, 0.02).unwrap();
+    let p = c.canonical(0.).unwrap().point;
+    let (outgoing, _, _) = nearest(&f, pair, p);
+    let mut fake = f.clone();
+    let corner = fake.corners.len();
+    let incoming_sources: std::collections::BTreeSet<_> = ids
+        .iter()
+        .flat_map(|&id| fake.curves[id].adjacent_strata)
+        .collect();
+    fake.corners.push(SfccCorner {
+        id: corner,
+        x: p[0],
+        y: p[1],
+        z: p[2],
+        strata: incoming_sources.iter().copied().collect(),
+        curve_ends: vec![(ids[0], 1), (ids[1], 1)],
+    });
+    for id in ids {
+        fake.curves[id].corner_end = corner as i64;
+    }
+    let check = ClosureConsumer::bind(&root, &fake, ids, pair, 0.5, 0.02).unwrap();
+    assert_eq!(
+        check.check_corner(corner, outgoing),
+        Err("required_outgoing_incidence")
+    );
+    fake.curves[outgoing].corner_start = corner as i64;
+    fake.corners[corner].curve_ends.insert(0, (outgoing, 0));
+    let check = ClosureConsumer::bind(&root, &fake, ids, pair, 0.5, 0.02).unwrap();
+    assert_eq!(
+        check.check_corner(corner, outgoing),
+        Err("incident_stratum_omitted")
+    );
+    fake.corners[corner].strata.extend(pair);
+    let check = ClosureConsumer::bind(&root, &fake, ids, pair, 0.5, 0.02).unwrap();
+    assert!(
+        check.check_corner(corner, outgoing).is_err(),
+        "listing sources cannot replace an own endpoint query at the event"
+    );
+}
