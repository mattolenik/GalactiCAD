+// Frozen pre-refactor boolean oracle, used only to verify exact semantics.
+fn original_contains_face_root(proof: &Certificate, axis: usize) -> bool {
+    if axis >= 3 || proof.lo[axis] != proof.hi[axis] {
+        return false;
+    }
+    let axes = [(axis + 1) % 3, (axis + 2) % 3];
+    let mut center = [0.; 3];
+    for k in 0..3 {
+        let Some(m) = midpoint(I {
+            lo: proof.lo[k],
+            hi: proof.hi[k],
+        }) else {
+            return false;
+        };
+        center[k] = m;
+    }
+    center[axis] = proof.lo[axis];
+    let Some(c) = inverse_bound(proof.face_matrix(axis)) else {
+        return false;
+    };
+    let (a, u, r) = proof.cylinder;
+    let Some(f) = radial(a, u, r, center, center).zip(twisted(proof.p, center, center)) else {
+        return false;
+    };
+    let values = [f.0 .0, f.1 .0];
+    let j = proof.face_matrix(axis);
+    (0..2).all(|row| {
+        let result = (|| {
+            let mut k = I::point(center[axes[row]])
+                .sub(values[0].mul(c[row][0])?)?
+                .sub(values[1].mul(c[row][1])?)?;
+            for col in 0..2 {
+                let h = I::point(if row == col { 1. } else { 0. })
+                    .sub(j[0][col].mul(c[row][0])?.add(j[1][col].mul(c[row][1])?)?)?;
+                let delta = I {
+                    lo: proof.lo[axes[col]],
+                    hi: proof.hi[axes[col]],
+                }
+                .sub(I::point(center[axes[col]]))?;
+                k = k.add(mul(h, delta)?)?;
+            }
+            Some(k)
+        })();
+        result.is_some_and(|k| k.lo > proof.lo[axes[row]] && k.hi < proof.hi[axes[row]])
+    })
+}
