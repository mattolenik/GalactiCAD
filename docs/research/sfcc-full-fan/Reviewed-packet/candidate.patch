+#[test]
+fn fullfan_a_refuses_invalid_source_domain_and_tighter_budget() {
+    let _guard = crate::sfcc::validation::NumericalGuard::new();
+    let (f, sid, triangles, tolerance, _) = fixture();
+    assert_eq!(
+        certify(&f, usize::MAX, &triangles, tolerance).unwrap_err(),
+        "source_binding"
+    );
+    let mut foreign = f.clone();
+    foreign.strata[sid].sign = -1.;
+    assert_eq!(
+        certify(&foreign, sid, &triangles, tolerance).unwrap_err(),
+        "source_binding"
+    );
+    for tol in [0., -tolerance, f64::NAN, f64::INFINITY] {
+        assert_eq!(
+            certify(&f, sid, &triangles, tol).unwrap_err(),
+            "invalid_domain"
+        );
+    }
+    assert_eq!(
+        certify(&f, sid, &[], tolerance).unwrap_err(),
+        "invalid_domain"
+    );
+    let mut bad = triangles.clone();
+    bad[0][0][0] = f64::NAN;
+    assert_eq!(
+        certify(&f, sid, &bad, tolerance).unwrap_err(),
+        "invalid_domain"
+    );
+    let mut degenerate = triangles.clone();
+    degenerate[0][1] = degenerate[0][0];
+    assert_eq!(
+        certify(&f, sid, &degenerate, tolerance).unwrap_err(),
+        "invalid_domain"
+    );
+    assert!(
+        certify(&f, sid, &triangles, 1e-14).is_err(),
+        "unproved tighter tolerance cannot borrow original tolerance"
+    );
+    let repeated = triangles.repeat(21);
+    assert_eq!(repeated.len(), 126);
+    assert!(
+        certify(&f, sid, &repeated, tolerance)
+            .unwrap_err()
+            .starts_with("piece_cap:"),
+        "128 attempts apply globally, not per input triangle"
+    );
+}
