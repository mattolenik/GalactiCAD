+// Count EVERY own query while the existing mesher runs, including failed and
+// subsequently discarded probes. The fixed reservation is made before entry.
+const GENERATED_RESERVATION: usize = 2048;
+#[derive(Debug)]
+pub(crate) struct QueryAttempt {
+    pub chart: usize,
+    pub t: f64,
+    pub point: Option<[f64; 3]>,
+}
+struct QueryLog {
+    attempts: Vec<QueryAttempt>,
+    exhausted: bool,
+}
+thread_local! { static QUERY_LOG: RefCell<Option<QueryLog>> = const { RefCell::new(None) }; }
+pub(crate) struct GeneratedQueries;
+impl GeneratedQueries {
+    pub(crate) fn begin(transport: &mut Transport<'_>) -> Result<Self, &'static str> {
+        #[cfg(not(any(test, feature = "sfcc-profile")))]
+        return Err("private construction requires the test/profile diagnostic");
+        if QUERY_LOG.with(|s| s.borrow().is_some()) {
+            return Err("nested generated query scope");
+        }
+        transport
