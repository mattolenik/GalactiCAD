+fn view(f: &SfccFeatureSet, pre: &Value) -> SfccFeatureSet {
+    let ids = crate::sfcc::stage4_source_preflight_c::selected_pair_c(f).unwrap();
+    let mut view = f.clone();
+    view.index.omit_private_curve(ids[1]);
+    for corner in &mut view.corners {
+        if corner.curve_ends.iter().any(|&(id, _)| id == ids[0]) {
+            corner.curve_ends.retain(|&(id, _)| id != ids[1]);
+        }
+    }
+    for row in pre["corners"].as_array().unwrap() {
+        let c = &view.corners[row["id"].as_u64().unwrap() as usize];
+        assert_eq!(
+            [c.x, c.y, c.z].map(f64::to_bits),
+            std::array::from_fn(|k| number(&row["positionHex"][k]).to_bits())
+        );
+        assert_eq!(json!(c.curve_ends), row["curveEnds"]);
+        assert_eq!(json!(c.strata), row["strata"]);
+    }
+    for row in pre["curves"].as_array().unwrap() {
+        let c = &view.curves[row["id"].as_u64().unwrap() as usize];
