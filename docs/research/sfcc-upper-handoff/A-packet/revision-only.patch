+    let mut mixed = f.strata.clone();
+    mixed[branch.field] = other.strata[branch.field].clone();
+    assert!(bind(&other_root, &mixed, &branch, 0.01).is_none());
+    let proposed = mid(cert.point_image(0.).unwrap());
+    for native in [true, false] {
+        let mut clipped = root.clone();
+        let path = if native {
+            vec![0, 0, 0, 0, 1]
+        } else {
+            vec![0, 0, 0, 1]
+        };
+        let CsgNode::Leaf(leaf) = at_mut(&mut clipped, &path) else {
+            panic!()
+        };
+        let cap_height = cert.transition_y.hi - leaf.pos[1] + 0.001;
+        match &mut leaf.shape {
+            Shape::Extrude { h, .. } | Shape::Cylinder { h, .. } => *h = cap_height,
+            _ => panic!(),
+        }
+        let tol = crate::tolerances::resolve_tolerances(&crate::tuning::SfccTuning::default(), 50.);
+        let (clipped_f, _) = compile_feature_set(&clipped, &tol);
+        let ids = roles(&clipped_f);
+        let b = branch_at(&clipped_f.strata, ids[0], ids[1], ids[2], proposed)
+            .expect("changed source still provides a proposed regular radial branch");
+        assert!(
+            bind(&clipped, &clipped_f.strata, &b, 0.01).is_none(),
+            "finite cap must prevent this requested nonzero-level continuation"
+        );
+    }
+}
