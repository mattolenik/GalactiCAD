+            return None;
+        }
+        let (sa, sb, _) = curve.traced_carriers()?;
+        if !((sa.connection_same_source(&f.strata[compound_id]) && sb.connection_same_source(cyl))
+            || (sb.connection_same_source(&f.strata[compound_id])
+                && sa.connection_same_source(cyl)))
