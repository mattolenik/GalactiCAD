+    #[test]
+    fn exposure_a_frontier_keeps_initial_container_when_unknown_bisection_discards_junction() {
+        let c = make_segment_curve(0, -1, [0, 1], 0., 0., 0., 1., 0., 0.);
+        let mut tol =
+            crate::tolerances::resolve_tolerances(&crate::tuning::SfccTuning::default(), 1.);
+        tol.corner_merge_tol = 0.04;
+        let initial = 0.2426778243;
+        for sign in [1., -1.] {
+            let map = |t: f64| if sign > 0. { t } else { 1. - t };
+            let classify = |t: f64| if map(t) > 0.01 { Ok(true) } else { Err(()) };
+            let (_, frontier) =
+                bisect_transition_bounded(&classify, &c, map(initial), map(0.), true, &tol, 40);
+            let frontier = frontier.unwrap();
+            let junction = map(0.);
+            assert_eq!(frontier.initial_alive, map(initial));
+            assert_eq!(frontier.initial_other, junction);
+            assert_eq!(frontier.initial_other_status, FrontierOtherStatus::Unknown);
+            assert_eq!(frontier.other_status, FrontierOtherStatus::Unknown);
+            assert!(
+                junction < frontier.alive.min(frontier.other)
+                    || junction > frontier.alive.max(frontier.other),
+                "the adversarial true junction is outside the final bracket"
+            );
+            assert!(
+                junction >= frontier.initial_alive.min(frontier.initial_other)
+                    && junction <= frontier.initial_alive.max(frontier.initial_other)
+            );
+        }
+        // An initially inactive sample may later meet uncertainty; preserve both facts.
+        let (_, frontier) =
+            bisect_transition_bounded(&|_| Err(()), &c, initial, 0., false, &tol, 40);
+        let frontier = frontier.unwrap();
+        assert_eq!(frontier.initial_other_status, FrontierOtherStatus::Inactive);
+        assert_eq!(frontier.other_status, FrontierOtherStatus::Unknown);
+    }
+
+    #[test]
+    fn exposure_a_frontier_wrap_keeps_both_raw_search_containers() {
+        let c = make_segment_curve(0, -1, [0, 1], 0., 0., 0., 1., 0., 0.);
+        let mut tol =
+            crate::tolerances::resolve_tolerances(&crate::tuning::SfccTuning::default(), 1.);
+        tol.corner_merge_tol = 0.04;
+        let (_, first_end) = bisect_transition_bounded(
+            &|t| if t < 0.23 { Ok(true) } else { Err(()) },
+            &c,
+            0.,
+            0.2426778243,
+            true,
+            &tol,
+            40,
+        );
+        let (_, last_start) = bisect_transition_bounded(
+            &|t| if t > 0.77 { Ok(true) } else { Err(()) },
+            &c,
+            1.,
+            1. - 0.2426778243,
+            true,
+            &tol,
+            40,
+        );
+        let first_end = first_end.unwrap();
+        let last_start = last_start.unwrap();
+        let first = TrimmedRun {
+            curve_idx: 7,
+            t0: 0.,
+            t1: first_end.alive,
+            full_closed: false,
+            frontiers: [None, Some(first_end)],
+        };
+        let last = TrimmedRun {
+            curve_idx: 7,
+            t0: last_start.alive,
+            t1: 1.,
+            full_closed: false,
+            frontiers: [Some(last_start), None],
+        };
+        let joined = join_wrapped_runs(first, last, 1.);
+        assert_eq!(joined.curve_idx, 7);
+        assert!(joined.t0 < 0. && joined.t1 > 0.);
+        assert_eq!(joined.frontiers, [Some(last_start), Some(first_end)]);
+        assert!(
+            joined.frontiers[0].unwrap().initial_other > 0.,
+            "wrapping run coordinates must not translate the original raw-frame search container"
+        );
+        assert_eq!(joined.frontiers[1].unwrap().initial_other, 0.2426778243);
+    }
+}
