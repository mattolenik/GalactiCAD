+        return Err("paired_actual_first_fan_binding");
+    }
+    let face:Face=serde_json::from_value(witness["face"].clone()).map_err(|_|"paired_face_encoding")?;
+    let candidate_edge:[usize;2]=serde_json::from_value(witness["edge"].clone()).map_err(|_|"paired_edge_encoding")?;
+    let boundary:Vec<usize>=serde_json::from_value(fan["boundary"].clone()).map_err(|_|"paired_boundary_encoding")?;
+    if boundary.len()>64 || directed_occurrences(&boundary,candidate_edge)!=1 {return Err("paired_first_fan_edge");}
+    for p in fan["points"].as_array().ok_or("paired_fan_points")? {
+        let point=p["id"].as_u64().ok_or("paired_point_id")? as usize;
+        if point>=candidate.points.count() || p["positionBits"]!=json!(q::pos(&candidate.points,point).map(f64::to_bits)) {
+            return Err("paired_fan_point_payload");
+        }
+    }
+    if face.0>=3 {return Err("paired_face_axis");}
+    let record=faces[face.0].get(&face.1).ok_or("paired_original_face_missing")?;
+    if record.axis!=face.0 || record.key!=face.1 || record.len!=face.2
+        || record.segments.len()>1024 || record.pins.len()>1024 {return Err("paired_original_face_identity");}
+    let fan_triangles:Vec<usize>=serde_json::from_value(fan["triangles"].clone()).map_err(|_|"paired_fan_triangles")?;
+    if fan_triangles.len()>3*128 || fan_triangles.len()%3!=0
+        || fan_triangles.chunks_exact(3).any(|t|!candidate.triangles.chunks_exact(3).any(|c|c==t)) {
+        return Err("paired_fan_not_in_candidate");
