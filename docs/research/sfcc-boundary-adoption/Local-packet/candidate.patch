+//! Simultaneous interior-feature target adoption on one already checked projected disk.
+use super::{combine_error, graph_jacobian_upper, Domain, Point, Result, I};
+use crate::sfcc::loft_seam::{mul, square};
+use serde_json::{json, Value};
+use std::collections::{BTreeMap, BTreeSet};
+
+/// Targets enclose exact source points proved by the caller on this source instance.
+/// This only changes source correspondence; both working and exported mesh points stay fixed.
+pub(crate) fn transport(
+    domain: &Domain,
+    points: &BTreeMap<usize, Point>,
+    source: &Value,
+    targets: &BTreeMap<usize, [I; 3]>,
+    tolerance: f64,
+) -> Result<Value> {
+    let base = combine_error(domain, source, tolerance)?;
+    if targets.is_empty() || targets.len() > 4 || points.len() > 128 {
+        return Err("boundary_transport_scope");
+    }
+    let used: BTreeSet<_> = domain.triangles.iter().copied().collect();
+    if used.iter().any(|id| {
+        points
+            .get(id)
+            .is_none_or(|p| p.iter().any(|x| !x.is_finite()))
+    }) {
+        return Err("boundary_transport_points");
+    }
+    if json!(used
+        .iter()
+        .map(|id| json!([id, points[id].map(f64::to_bits)]))
+        .collect::<Vec<_>>())
+        != domain.report["pointBits"]
+    {
+        return Err("boundary_transport_point_binding");
+    }
+    let boundary: Vec<usize> = serde_json::from_value(domain.report["outerBoundary"].clone())
+        .map_err(|_| "boundary_transport_boundary")?;
+    let slab: [f64; 2] = serde_json::from_value(source["commonWorldXSlab"].clone())
+        .map_err(|_| "boundary_transport_slab")?;
+    if slab.iter().any(|v| !v.is_finite()) || slab[0] >= slab[1] {
+        return Err("boundary_transport_slab");
+    }
+    let mut beta = 0.0_f64;
+    let mut rows = Vec::new();
+    for (&id, target) in targets {
+        if !used.contains(&id) || boundary.contains(&id) {
+            return Err("boundary_transport_target_not_interior");
+        }
+        if target
+            .iter()
+            .any(|v| !v.lo.is_finite() || !v.hi.is_finite() || v.lo > v.hi)
+            || target[0].lo <= slab[0]
+            || target[0].hi >= slab[1]
+        {
+            return Err("boundary_transport_target_enclosure");
+        }
+        let mut distance2 = I::point(0.);
+        for k in 1..3 {
+            distance2 = distance2
+                .add(
+                    square(
+                        target[k]
+                            .sub(I::point(points[&id][k]))
+                            .ok_or("boundary_transport_arithmetic")?,
+                    )
+                    .ok_or("boundary_transport_arithmetic")?,
+                )
+                .ok_or("boundary_transport_arithmetic")?;
+        }
+        let motion = distance2.hi.sqrt().next_up();
+        beta = beta.max(motion);
+        rows.push(json!({"id":id,"originalPointBits":points[&id].map(f64::to_bits),
+            "targetImage":[target.map(|v|v.lo),target.map(|v|v.hi)],"projectedVertexMotionUpper":motion}));
+    }
+    let mut jacobian = 0.0_f64;
+    let mut minimum_margin = f64::INFINITY;
+    let mut changed = Vec::new();
+    for (index, triangle) in domain.triangles.chunks_exact(3).enumerate() {
+        let p = [
+            points[&triangle[0]],
+            points[&triangle[1]],
+            points[&triangle[2]],
+        ];
+        jacobian = jacobian.max(graph_jacobian_upper(p).ok_or("boundary_transport_jacobian")?);
+        if !triangle.iter().any(|id| targets.contains_key(id)) {
+            continue;
+        }
+        // These hulls contain every simultaneous intermediate vertex for every enclosed target.
+        let hull: [[I; 2]; 3] = std::array::from_fn(|i| {
+            std::array::from_fn(|k| {
+                let old = p[i][k + 1];
+                targets.get(&triangle[i]).map_or(I::point(old), |t| I {
+                    lo: old.min(t[k + 1].lo),
+                    hi: old.max(t[k + 1].hi),
+                })
+            })
+        });
+        let a = hull[1][0]
+            .sub(hull[0][0])
+            .ok_or("boundary_transport_arithmetic")?;
+        let b = hull[1][1]
+            .sub(hull[0][1])
+            .ok_or("boundary_transport_arithmetic")?;
+        let c = hull[2][0]
+            .sub(hull[0][0])
+            .ok_or("boundary_transport_arithmetic")?;
+        let d = hull[2][1]
+            .sub(hull[0][1])
+            .ok_or("boundary_transport_arithmetic")?;
+        let sign = domain.report["projectedWinding"]
+            .as_i64()
+            .ok_or("boundary_transport_winding")?;
+        let margin = mul(a, d)
+            .and_then(|v| v.sub(mul(b, c)?))
+            .and_then(|v| v.mul(sign as f64))
+            .ok_or("boundary_transport_arithmetic")?;
+        if margin.lo <= 0. {
+            return Err("boundary_transport_intermediate_fold_not_excluded");
+        }
+        minimum_margin = minimum_margin.min(margin.lo);
+        changed.push(json!({"triangle":index,"ids":triangle,"signedOrientationLower":margin.lo}));
+    }
+    if changed.is_empty() || changed.len() > 128 {
+        return Err("boundary_transport_triangle_inventory");
+    }
+    let source_bounds: Vec<f64> = serde_json::from_value(source["perTriangleSourceBounds"].clone())
+        .map_err(|_| "boundary_transport_source_bounds")?;
+    let delta = source_bounds.iter().copied().fold(0., f64::max);
+    let eta = domain.export_bounds.iter().copied().fold(0., f64::max);
+    let extra = I::point(jacobian)
+        .mul(beta)
+        .ok_or("boundary_transport_arithmetic")?
+        .hi;
+    let total = I::point(delta)
+        .add(I::point(extra))
+        .and_then(|v| v.add(I::point(eta)))
+        .ok_or("boundary_transport_arithmetic")?
+        .hi;
+    if !total.is_finite() || total > tolerance {
+        return Err("boundary_transport_error_limit");
+    }
+    Ok(
+        json!({"scope":"conditional simultaneous source-correspondence transport on the exact supplied projected disk",
+        "targets":rows,"changedTriangles":changed,"strictIntermediateOrientationLower":minimum_margin,
+        "projectedMotionUpper":beta,"meshGraphJacobianUpper":jacobian,"additionalWorkingErrorUpper":extra,
+        "uniformSourceBound":delta,"uniformExportRoundingBound":eta,"sourceToExportAfterTransportUpper":total,
+        "tolerance":tolerance,"originalComposedBound":base,"outerBoundaryFixed":true,
+        "projectedDomainMapsOntoItself":true,"workingAndExportedMeshUnchanged":true,
+        "theorem":"every intermediate PL map has positive triangle Jacobians and fixes the simple disk boundary, so degree one gives a disk homeomorphism; the straight image path remains in D and |Phi(Tu)-M(u)| <= delta + L_mesh*beta + eta",
+        "exactTargetSourceCertificatesRequired":true,"allIncidentConsumerBindingRequired":true,
+        "sourceTriangleOrderBindingRequired":true,"sourceFeatureCurveParameterizationProved":false,
+        "noAdditionalSourceCertificateCall":true,"publicationReady":false}),
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn fixture() -> (BTreeMap<usize, Point>, Domain, Value) {
+        let p = BTreeMap::from([
+            (0, [0., -0.3, 0.]),
+            (1, [0., -1., -1.]),
+            (2, [0., 1., -1.]),
+            (3, [0., 1., 1.]),
+            (4, [0., -1., 1.]),
+            (5, [0., 0.3, 0.]),
+        ]);
+        let patches = [
+            vec![0, 2, 1, 0, 5, 2, 0, 1, 4],
