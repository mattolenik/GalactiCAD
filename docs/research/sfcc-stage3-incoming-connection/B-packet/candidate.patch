+// This proves equality of local zero loci and inherited domains, not endpoint authority.
+#[cfg(all(test, feature = "serde"))]
+pub(crate) fn attachment_zero_locus_b(
+    native: &Stratum,
+    field: &Stratum,
+    lo: [f64; 3],
+    hi: [f64; 3],
+) -> Result<(usize, i8), &'static str> {
+    if !(0..3).all(|k| lo[k].is_finite() && hi[k].is_finite() && lo[k] <= hi[k]) {
+        return Err("invalid_box");
+    }
+    let (p, leaf, other, radius) = native.round_twisted_source(field).ok_or("source_binding")?;
+    let identity = |leaf: &Leaf| leaf.sim.r == [1., 0., 0., 0., 1., 0., 0., 0., 1.]
+        && leaf.sim.t == [0.; 3] && leaf.sim.s == 1.;
+    if !identity(leaf) || !identity(other) { return Err("unsupported_transform"); }
+    let (_, _, _, q) = twisted(p, lo, hi).ok_or("source_coordinates")?;
+    let sign = if q[0].lo > 0. { 1 } else if q[0].hi < 0. { -1 } else {
+        return Err("branch_sign");
+    };
+    let boxes = source_restrictions(p, leaf, Some((other, radius)), lo, hi)
+        .ok_or("source_restrictions")?;
+    Ok((boxes, sign))
+}
