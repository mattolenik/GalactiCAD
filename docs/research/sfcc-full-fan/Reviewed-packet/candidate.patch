+        .fold(f64::INFINITY, f64::min);
+    let maxx = triangles
+        .iter()
+        .flatten()
+        .map(|p| p[0])
+        .fold(f64::NEG_INFINITY, f64::max);
+    let slab = interval(
+        I::point(minx).sub(I::point(tolerance)).ok_or("slab")?.lo,
+        I::point(maxx).add(I::point(tolerance)).ok_or("slab")?.hi,
+    )
+    .ok_or("slab")?;
+    let mut stack: Vec<_> = triangles
+        .iter()
+        .enumerate()
+        .rev()
+        .map(|(i, t)| (i, 0, t.map(|p| p.map(I::point))))
+        .collect();
+    let mut attempts = 0;
+    let mut accepted = Vec::new();
+    let mut bounds = vec![0.0_f64; triangles.len()];
+    let mut failures = Vec::new();
+    while let Some((index, depth, t)) = stack.pop() {
+        if attempts == MAX_PIECES {
+            return Err(format!(
+                "piece_cap: accepted {}, pending {}, last {:?}",
+                accepted.len(),
+                stack.len(),
+                failures.last()
+            ));
+        }
+        attempts += 1;
+        match source.piece(t, slab, tolerance) {
+            Ok(mut row) => {
+                let bound = row["sameYZRootDisplacementUpper"]
+                    .as_f64()
+                    .ok_or("bound_encoding")?;
+                bounds[index] = bounds[index].max(bound);
+                row["triangle"] = json!(index);
+                row["depth"] = json!(depth);
+                accepted.push(row);
+            }
+            Err(reason) => {
+                failures.push(json!({"triangle":index,"depth":depth,"reason":reason}));
+                if depth >= 12 {
+                    return Err(format!(
+                        "unproved_piece: {reason}, triangle {index}, depth {depth}"
+                    ));
+                }
+                let [a, b] = split(t).ok_or("split_arithmetic")?;
+                stack.push((index, depth + 1, b));
+                stack.push((index, depth + 1, a));
+            }
+        }
+    }
+    Ok(
+        json!({"scope":"unique full-source root graph over every supplied closed projected triangle, and same-YZ mesh-to-root displacement; supplied-domain topology and cell-face boundary transport are separate obligations",
+        "sourceFingerprint":source.f.fingerprint().to_string(),"source":source.source,"cylinder":source.cylinder_id,"commonWorldXSlab":[slab.lo,slab.hi],
+        "triangleCount":triangles.len(),"attempts":attempts,"acceptedPieces":accepted.len(),"pieceCap":MAX_PIECES,"perTriangleSourceBounds":bounds,
+        "uniformSourceBound":bounds.iter().copied().fold(0.,f64::max),"tolerance":tolerance,"refinedFailures":failures,"pieces":accepted,
+        "fullClosedTriangleDomainsCovered":true,"sharedEdgeRootsAgreeByCommonSlabUniqueness":true,"fullFieldGloballyMonotoneClaimed":false,"primitiveCylinderClampInactive":true,
+        "cellFaceBoundaryTransportProved":false,"patchLabelsAssigned":false,"publicationReady":false}),
+    )
+}
