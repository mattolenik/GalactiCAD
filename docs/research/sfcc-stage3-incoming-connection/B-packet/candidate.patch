+fn divide(a: I, b: I) -> Option<I> {
+    if b.lo <= 0. && b.hi >= 0. {
+        return None;
+    }
+    mul(a, interval((1. / b.hi).next_down(), (1. / b.lo).next_up())?)
+}
+fn distance(p: [f64; 3], q: [I; 3]) -> Option<f64> {
+    let mut s = I::point(0.);
+    for k in 0..3 {
+        s = s.add(square(I::point(p[k]).sub(q[k])?)?)?;
+    }
+    Some(sqrt(s)?.hi)
+}
+fn absolute(a: I) -> f64 {
+    a.lo.abs().max(a.hi.abs())
+}
