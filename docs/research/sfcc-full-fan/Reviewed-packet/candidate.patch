+#[test]
+fn fullfan_a_actual_closed_source_graph() {
+    let _guard = crate::sfcc::validation::NumericalGuard::new();
+    let (f, sid, triangles, tolerance, parent) = fixture();
+    let result = certify(&f, sid, &triangles, tolerance);
+    if let Ok(path) = std::env::var("SFCC_FULLFAN_A_RECEIPT") {
+        std::fs::write(
+            path,
+            serde_json::to_vec_pretty(&json!({"result":result,"parentReceiptSha256":parent}))
+                .unwrap(),
+        )
+        .unwrap();
+    }
+    let report = result.expect("actual full-fan source graph");
+    assert_eq!(
+        report["tolerance"].as_f64().unwrap().to_bits(),
+        tolerance.to_bits()
+    );
+    assert!(report["uniformSourceBound"].as_f64().unwrap() <= tolerance);
+    let saved: Value = serde_json::from_str(include_str!("../../fixtures/ownership-first-fan-a.json")).unwrap();
+    let points: std::collections::BTreeMap<usize,[f64;3]> = saved["points"].as_array().unwrap().iter().map(|p| {
+        (p["id"].as_u64().unwrap() as usize,std::array::from_fn(|k|f64::from_bits(u64::from_str_radix(p["positionHex"][k].as_str().unwrap(),16).unwrap())))
+    }).collect();
+    let boundary: Vec<usize> = serde_json::from_value(saved["fan"]["polygon"].clone()).unwrap();
+    let ids: Vec<usize> = serde_json::from_value(saved["fan"]["triangles"].clone()).unwrap();
+    assert_eq!(ids.len(),3*triangles.len());
+    for (i,t) in ids.chunks_exact(3).enumerate() {
+        assert_eq!([points[&t[0]],points[&t[1]],points[&t[2]]].map(|p|p.map(f64::to_bits)),triangles[i].map(|p|p.map(f64::to_bits)));
+    }
+    let geometry = crate::sfcc::cell_mesh::fullfan_geometry_b::audit(&boundary,&ids,&points).unwrap();
+    let source_bounds: Vec<f64> = serde_json::from_value(report["perTriangleSourceBounds"].clone()).unwrap();
+    let transport = crate::sfcc::cell_mesh::fullfan_geometry_b::combine_error(&geometry,&source_bounds,tolerance).unwrap();
+    if let Ok(path) = std::env::var("SFCC_FULLFAN_COMBINED_RECEIPT") {
+        let combined = json!({"parentReceiptSha256":parent,"sourceFingerprint":f.fingerprint().to_string(),
+            "sourceCertificate":report,"geometry":geometry.report(),"transport":transport,
+            "sourceAndGeometryUseIdenticalTriangleInput":true,"wholeFanGraphAndApproximationProved":true,
+            "intendedCellTrimCoverageProved":false,"conformingNeighborTransportProved":false,"publicationReady":false});
+        std::fs::write(path,serde_json::to_vec_pretty(&combined).unwrap()).unwrap();
+    }
+
+}
