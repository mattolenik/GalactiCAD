+fn families(f: &SfccFeatureSet) -> std::collections::BTreeMap<[usize; 2], Vec<String>> {
+    let mut result = std::collections::BTreeMap::<[usize; 2], Vec<String>>::new();
+    for c in &f.curves {
+        let mut pair = c.adjacent_strata;
+        pair.sort();
+        let corners = [c.corner_start, c.corner_end].map(|id| {
+            (id >= 0).then(|| {
+                let p = &f.corners[id as usize];
+                [hex(p.x), hex(p.y), hex(p.z)]
+            })
+        });
+        let refine = c
+            .traced_carriers()
+            .map(|(_, _, r)| [hex(r.curve_eps), hex(r.min_cross), hex(r.max_displacement)]);
+        let row = json!({"sourcePair":c.adjacent_strata,"kind":c.kind() as u8,"closed":c.closed,
+            "native":c.native,"owner":c.owner_node_id,"rangeHex":[hex(c.t_min),hex(c.t_max)],
+            "wrapHex":c.param_wrap.map(hex),"indexPolylineHex":c.index_polyline.iter().copied().map(hex).collect::<Vec<_>>(),
+            "cornersHex":corners,"refineHex":refine,"connectionModeBits":c.connection_identity_b()});
+        result
+            .entry(pair)
+            .or_default()
+            .push(serde_json::to_string(&row).unwrap());
+    }
+    for rows in result.values_mut() {
+        rows.sort();
+    }
+    result
+}
+#[test]
+fn connection_b_conservative_refusal_preserves_other_source_families() {
+    let (root, tol) = fixture();
+    let (old, old_diag) = connection_b::with_resolver_disabled(|| compile_feature_set(&root, &tol));
+    let _scope = Scope;
+    CAPTURE.with(|c| c.borrow_mut().enabled = true);
+    let (new, new_diag) = compile_feature_set(&root, &tol);
+    let cases = CAPTURE.with(|c| std::mem::take(&mut c.borrow_mut().cases));
+    let before = families(&old);
+    let after = families(&new);
+    let keys: std::collections::BTreeSet<_> = before.keys().chain(after.keys()).copied().collect();
+    let changed: Vec<_> = keys
+        .into_iter()
+        .filter(|k| before.get(k) != after.get(k))
+        .collect();
+    let symmetric_preserved = before.get(&[7, 31]) == after.get(&[7, 31]);
+    let all_authorities = cases.iter().all(|(p, _, _)| retained(&new, p));
+    let report = json!({"scope":"same-binary resolver-disabled/current exact family comparison; source IDs bound by unchanged extraction",
+        "disabledFingerprint":old.fingerprint().to_string(),"enabledFingerprint":new.fingerprint().to_string(),
+        "disabledCounts":[old.curves.len(),old.corners.len(),old_diag.unresolved_trims],
+        "enabledCounts":[new.curves.len(),new.corners.len(),new_diag.unresolved_trims],
+        "changedSourceFamilies":changed,"symmetricFamilyPreserved":symmetric_preserved,
+        "allAdmittedAuthoritiesRetained":all_authorities,"admittedConnections":cases.len(),
+        "beforeSymmetricFamily":before.get(&[7,31]),"afterSymmetricFamily":after.get(&[7,31])});
+    let path = std::path::PathBuf::from(std::env::var("SFCC_CONNECTION_B_RECEIPT").unwrap())
+        .with_file_name("connection-B-collateral.json");
+    std::fs::write(path, serde_json::to_vec_pretty(&report).unwrap()).unwrap();
+    assert_eq!(
+        old.fingerprint(),
+        13394982552569873070,
+        "disabled candidate must reproduce parent B"
+    );
+    assert!(
+        symmetric_preserved,
+        "ordinary resolved symmetric attachment is left unchanged"
+    );
+    assert_eq!(
+        changed,
+        vec![[10, 31]],
+        "only the missing source family may change in this experiment"
+    );
+    assert!(
+        !cases.is_empty() && all_authorities,
+        "no new authority may be lost by later dedup"
+    );
+}
