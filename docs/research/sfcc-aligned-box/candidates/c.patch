+#[test]
+fn diagonal_corner_contact_is_certified_without_claiming_zero_free() {
+    use gcad_kernel::math::grid::{cell_key, make_lattice};
+    use gcad_kernel::sfcc::octree::SfccCell;
+    let lat = make_lattice(8, -4., -4., -4., 8.);
+    let tree = build_csg_tree_from_json(&box_([1.; 3], [1.; 3]).to_string()).unwrap();
+    let mut cells = Vec::new();
+    for ix in 0..2 {
+        for iy in 0..2 {
+            for iz in 0..2 {
+                cells.push(SfccCell {
+                    level: 1,
+                    ix,
+                    iy,
+                    iz,
+                    key: cell_key(&lat, 1, ix, iy, iz),
+                    degenerate: true,
+                    feature_curve: -1,
+                    feature_corner: -1,
+                });
+            }
+        }
+    }
+    let plan = Plan::build(&tree, &lat, &cells).unwrap();
+    assert_eq!(plan.cell_zero_strata[0], [1, 0, 0]);
+    assert!(!plan.facets.iter().any(|f| f.incident_cells.contains(&0)));
+    assert!(plan
+        .cell_zero_strata
+        .iter()
+        .all(|counts| counts.iter().sum::<usize>() > 0));
+}
