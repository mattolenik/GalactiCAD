+    )
+}
+fn live_digest(faces: &[HashMap<i64, FaceRecord>; 3], live: &PointTable) -> String {
+    let mut h = 0xcbf29ce484222325u64;
+    let mut word = |n: u64| {
+        for b in n.to_le_bytes() {
+            h = (h ^ u64::from(b)).wrapping_mul(0x100000001b3);
+        }
+    };
+    word(live.count() as u64);
+    for id in 0..live.count() {
+        for x in [
+            live.x(id),
+            live.y(id),
+            live.z(id),
+            live.nx(id),
+            live.ny(id),
+            live.nz(id),
+        ] {
+            word(x.to_bits());
+        }
+        for b in format!("{:?}", live.key_at(id)).bytes() {
+            word(u64::from(b));
+        }
+    }
+    for axis in 0..3 {
+        let mut keys: Vec<_> = faces[axis].keys().copied().collect();
+        keys.sort();
+        for key in keys {
+            let r = &faces[axis][&key];
+            word(axis as u64);
+            word(key as u64);
+            word(r.len as u64);
+            for p in &r.pins {
+                word(p.point_id as u64);
+                word(p.curve_id as u64);
+                word(p.t.to_bits());
+            }
+            for s in &r.segments {
+                word(s.a as u64);
+                word(s.b as u64);
+            }
+            for n in r.consumed_fwd.iter().chain(&r.consumed_rev) {
+                word(u64::from(*n));
+            }
+        }
+    }
+    let mut protected: Vec<_> = live.protected_edges().collect();
+    protected.sort();
+    for (a, b) in protected {
+        word(a as u64);
+        word(b as u64);
+    }
+    let mut intervals: Vec<_> = live
+        .identified_edges()
+        .flat_map(|((a, b), is)| {
+            is.iter()
+                .map(move |i| (a, b, i.curve_id, i.start.to_bits(), i.end.to_bits()))
+        })
+        .collect();
+    intervals.sort();
+    for (a, b, c, t, u) in intervals {
+        word(a as u64);
+        word(b as u64);
+        word(c as u64);
+        word(t);
+        word(u);
+    }
+    format!("{h:016x}")
+}
