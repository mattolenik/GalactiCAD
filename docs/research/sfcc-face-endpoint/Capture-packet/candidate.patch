+#[test]
+fn face_c_actual_second_pair_and_whole_face_source_attempt(){
+    use crate::sfcc::{cell_mesh::paired_geometry_b,pipeline::{build_pipeline_context,PipelineTuning,SfccWorldCube},validation::NumericalGuard};
+    let _guard=NumericalGuard::new();
+    let original:Value=serde_json::from_str(include_str!("../../fixtures/shared-arc-full-knob.json")).unwrap();
+    let saved:Value=serde_json::from_str(include_str!("../../fixtures/face-fans-c.json")).unwrap();
+    let tree=crate::scene_bridge::build_csg_tree_from_json(original["sceneJson"].as_str().unwrap()).unwrap();
+    let cube=SfccWorldCube{min_x:original["cube"]["min"][0].as_f64().unwrap(),min_y:original["cube"]["min"][1].as_f64().unwrap(),min_z:original["cube"]["min"][2].as_f64().unwrap(),size:original["cube"]["max"][0].as_f64().unwrap()-original["cube"]["min"][0].as_f64().unwrap()};
+    let context=build_pipeline_context(&tree,&cube,&PipelineTuning::default());let f=&context.features;
+    assert_eq!(f.fingerprint().to_string(),saved["sourceFingerprint"].as_str().unwrap());
+    let points:BTreeMap<usize,Point>=saved["points"].as_array().unwrap().iter().map(|p|(p["id"].as_u64().unwrap() as usize,std::array::from_fn(|k|f64::from_bits(p["positionBits"][k].as_u64().unwrap())))).collect();
+    assert_eq!(points.len(),saved["points"].as_array().unwrap().len());
+    let patches=saved["patches"].as_array().unwrap();assert_eq!(patches.len(),4);
+    let ids:Vec<Vec<usize>>=patches.iter().map(|p|serde_json::from_value(p["triangles"].clone()).unwrap()).collect();
+    let boundaries:Vec<Vec<usize>>=patches.iter().map(|p|serde_json::from_value(p["boundary"].clone()).unwrap()).collect();
+    let segments:[[usize;2];2]=serde_json::from_value(saved["sharedSegments"].clone()).unwrap();
