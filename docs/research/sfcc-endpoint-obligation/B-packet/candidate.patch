+//! Exact replay of the captured early graph failure, without octree construction.
+use super::*;
+use crate::sfcc::{
+    private_arc_a, private_arc_a::graph_b,
+    shared_twisted_proof::correlated_c::transport_a::Transport,
+};
+use serde_json::{json, Value};
+use std::{cell::Cell, collections::BTreeMap};
+
+fn fixture() -> Value {
+    serde_json::from_str(include_str!("../../fixtures/graph-rejection-replay-b.json")).unwrap()
+}
+fn hex(v: &Value) -> f64 {
+    f64::from_bits(u64::from_str_radix(v.as_str().unwrap(), 16).unwrap())
+}
+fn bits(x: f64) -> String {
+    format!("{:016x}", x.to_bits())
+}
+fn id(v: &Value) -> usize {
+    usize::try_from(v.as_u64().unwrap()).unwrap()
+}
+fn restored_points(pre: &Value) -> PointTable {
+    let mut points = PointTable::new();
+    for p in pre["allPrivatePoints"].as_array().unwrap() {
+        let expected = id(&p["id"]);
+        assert_eq!(points.count(), expected, "fixture point order/gap");
+        let payload: [f64; 6] = std::array::from_fn(|i| {
+            if i < 3 {
+                hex(&p["positionHex"][i])
+            } else {
+                hex(&p["normalHex"][i - 3])
+            }
+        });
+        let actual = if let Some(key) = p["key"]["numericHex"].as_str() {
+            points.get_or_create(u64::from_str_radix(key, 16).unwrap() as i64, || payload)
+        } else if let Some(key) = p["key"]["string"].as_str() {
+            points.get_or_create_str(key, || payload)
+        } else {
+            assert!(p["key"].is_null());
+            points.add(
+                payload[0], payload[1], payload[2], payload[3], payload[4], payload[5],
+            )
+        };
+        assert_eq!(actual, expected, "duplicate fixture key would change reuse");
+    }
+    points
+}
+// Normalize process-local sharing labels, retaining their equality partition.
+// The sole large metadata integer (usize::MAX) is represented losslessly as text.
+fn normalized(mut value: Value) -> Value {
+    fn visit(value: &mut Value, roots: &mut BTreeMap<String, usize>) {
+        match value {
+            Value::Object(m) => {
+                for (key, v) in m {
+                    if key == "rootAddressProcessLocal" {
+                        let address = v.as_str().unwrap().to_owned();
+                        let next = roots.len();
+                        let index = *roots.entry(address).or_insert(next);
+                        *v = json!(index);
+                    } else {
+                        visit(v, roots);
+                    }
+                }
+            }
+            Value::Array(a) => {
+                for v in a {
+                    visit(v, roots);
+                }
+            }
+            Value::Number(n) => {
+                if n.as_u64().is_some_and(|n| n > 9_007_199_254_740_991) {
+                    *value = Value::String(n.to_string());
+                }
+            }
+            _ => {}
+        }
+    }
+    visit(&mut value, &mut BTreeMap::new());
+    value
+}
+struct CountingCellQuery<'a> {
+    tree: &'a CsgNode,
+    calls: Cell<usize>,
+}
+impl SdfQuery for CountingCellQuery<'_> {
+    fn f(&self, p: [f64; 3]) -> f64 {
+        self.calls.set(self.calls.get() + 1);
+        self.tree.f(p)
+    }
+    fn grad(&self, p: [f64; 3]) -> (f64, [f64; 3]) {
+        self.calls.set(self.calls.get() + 1);
+        self.tree.grad(p)
+    }
+    fn field_sample(&self, p: [f64; 3]) -> crate::sfcc::field_branches::FieldSample {
+        self.calls.set(self.calls.get() + 1);
+        self.tree.field_sample(p)
+    }
+    fn interval_over_box(&self, c: [f64; 3], h: [f64; 3]) -> (f64, f64) {
+        self.calls.set(self.calls.get() + 1);
+        self.tree.interval_over_box(c, h)
+    }
+    fn active_owners_at(&self, p: [f64; 3], tol: f64) -> Vec<crate::sdf::ActiveOwner<'_>> {
+        self.calls.set(self.calls.get() + 1);
+        self.tree.active_owners_at(p, tol)
+    }
+}
+struct ResetDiagnostic;
+impl Drop for ResetDiagnostic {
+    fn drop(&mut self) {
+        graph_b::test_take();
+    }
+}
+
+fn replay(
+    tree: &CsgNode,
+    features: &SfccFeatureSet,
+    transport: &mut Transport<'_>,
+    f: &Value,
+    seeded_metadata: bool,
+    wrong_pin_chart: bool,
+) -> Value {
+    let _numerical = crate::sfcc::validation::NumericalGuard::new();
+    let expected = &f["capture"];
+    let pre = &expected["pre"];
+    let mut points = restored_points(pre);
+    assert_eq!(points.count(), 633);
+    assert_eq!(points.lookup_str("corner:27"), None);
+    if seeded_metadata {
+        points.protect_curve_edge(
+            618,
+            620,
+            CurveInterval {
+                curve_id: 33,
+                start: 0.,
+                end: 1.,
+            },
+        );
+        points.set_patch([618, 620, 623], 30);
+        points.arrangement = true;
+        points.coverage_cells.insert((7, 36, 79, 29));
+        points.coverage_faces.insert((1, 4796193, 1), (7, 11));
+    }
+    let loops: Vec<Vec<usize>> = pre["loops"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|a| a.as_array().unwrap().iter().map(id).collect())
+        .collect();
+    let mut pins: Vec<FacePin> = pre["pins"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|p| FacePin {
+            point_id: id(&p["id"]),
+            curve_id: id(&p["chart"]),
+            t: hex(&p["parameterHex"]),
+        })
+        .collect();
+    if wrong_pin_chart {
+        pins[0].curve_id = 33;
+    }
+    let corners: Vec<usize> = pre["corners"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|c| id(&c["id"]))
+        .collect();
+    let box6: [f64; 6] = std::array::from_fn(|i| hex(&pre["cellBoxHex"][i]));
+    let o = &pre["options"];
+    let opts = CellMeshOptions {
+        surface_tol: hex(&o["surfaceTolHex"]),
+        curve_chord_tol: hex(&o["chordTolHex"]),
+        max_polyline_points_per_cell: id(&o["maxPolylinePoints"]),
+        project_max_iters: u32::try_from(id(&o["projectMaxIters"])).unwrap(),
+        quality_triangulation: o["qualityTriangulation"].as_bool().unwrap(),
+        features: Some(features),
+        interior_vertex_mode: match o["interiorMode"].as_str().unwrap() {
+            "Project" => InteriorVertexMode::Project,
+            "Centroid" => InteriorVertexMode::Centroid,
+            "Fan" => InteriorVertexMode::Fan,
+            _ => panic!("unknown mode"),
+        },
+    };
+    let c = &expected["context"];
+    let cell = SfccCell {
+        level: u32::try_from(id(&c["cell"][0])).unwrap(),
+        ix: c["cell"][1].as_i64().unwrap(),
+        iy: c["cell"][2].as_i64().unwrap(),
+        iz: c["cell"][3].as_i64().unwrap(),
+        key: 0,
+        degenerate: c["degenerate"].as_bool().unwrap(),
+        feature_corner: c["featureCorner"].as_i64().unwrap(),
+        feature_curve: c["featureCurve"].as_i64().unwrap(),
+    };
+    graph_b::test_begin();
+    let _reset = ResetDiagnostic;
+    graph_b::context(
+        &cell,
+        c["curvedCorner"].as_bool().unwrap(),
+        id(&c["distinctPinCurves"]),
+        c["queryViewPruned"].as_bool().unwrap(),
+    );
+    let queries = private_arc_a::GeneratedQueries::begin(transport).unwrap();
+    let query = CountingCellQuery {
+        tree,
+        calls: Cell::new(0),
+    };
+    let mut triangles = Vec::new();
+    let mut unresolved = false;
+    let accepted = mesh_feature_graph(
+        &loops,
+        &pins,
+        &corners,
+        &box6,
+        &query,
+        &mut points,
+        &opts,
+        features,
+        &mut triangles,
+        &mut unresolved,
+    );
+    let attempts = queries.finish().unwrap();
+    let observed = graph_b::test_take();
+    let capture = &observed["graphCaptureB"];
+    assert!(!accepted);
+    assert!(!unresolved);
+    assert!(triangles.is_empty());
+    assert_eq!(
+        query.calls.get(),
+        0,
+        "incoming cell query must not be read before the observed guard"
+    );
+    assert_eq!(crate::sfcc::validation::numerical_failures().total(), 0);
+    assert_eq!(points.count(), 634);
+    assert_eq!(points.lookup_str("corner:27"), Some(633));
+    assert_eq!(capture["complete"], true);
+    assert_eq!(
+        capture["finalPrivateFailure"], false,
+        "this is graph replay, not the outer private caller"
+    );
+    let queries:Vec<_>=attempts.iter().map(|q|json!({"chart":q.chart,"parameterHex":bits(q.t),"pointHex":q.point.map(|p|p.map(bits)),"querySucceeded":q.point.is_some()})).collect();
+    if wrong_pin_chart {
+        assert_eq!(capture["rejectionCode"], "path_nodes_lt_two");
+        assert!(queries.is_empty());
+    } else {
+        assert_eq!(capture["rejection"], expected["rejection"]);
+        assert_eq!(
+            normalized(capture["context"].clone()),
+            normalized(expected["context"].clone())
+        );
+        assert_eq!(
+            normalized(capture["pre"].clone()),
+            normalized(expected["pre"].clone()),
+            "every captured pre-call value/identity must reconstruct"
+        );
+        assert_eq!(
+            capture["graph"], expected["graph"],
+            "built graph and all new point bits must match"
+        );
+        assert_eq!(
+            Value::Array(queries.clone()),
+            f["graphQueries"],
+            "actual own-curve query sequence must match"
+        );
+        assert_eq!(capture["queryStart"], 0);
+        assert_eq!(capture["queryEnd"], 6);
+    }
+    if seeded_metadata {
+        assert!(points.edge_is_protected(618, 620));
+        assert_eq!(
+            points.curve_intervals(618, 620),
+            vec![CurveInterval {
+                curve_id: 33,
+                start: 0.,
+                end: 1.
+            }]
+        );
+        assert_eq!(points.patch([618, 620, 623]), Some(30));
+        assert!(points.arrangement);
+        assert_eq!(points.coverage_faces[&(1, 4796193, 1)], (7, 11));
+    }
+    json!({"seededMetadata":seeded_metadata,"wrongPinChart":wrong_pin_chart,"accepted":accepted,"rejection":capture["rejection"],"pointCount":points.count(),"incomingCellQueryCalls":query.calls.get(),"queries":queries,"graph":capture["graph"]})
+}
