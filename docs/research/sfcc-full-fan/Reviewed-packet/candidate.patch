+    assert!(polygon.iter().enumerate().any(|(i, &v)| v == edge[0] && polygon[(i + 1) % polygon.len()] == edge[1]));
+    let rows = boundary["points"].as_array().unwrap();
+    let vertices: [[f64; 3]; 2] = edge.map(|id| {
+        let row = rows.iter().find(|r| r["id"].as_u64() == Some(id as u64)).unwrap();
+        let current = fan["points"].as_array().unwrap().iter().find(|r| r["id"] == row["id"]).unwrap();
+        assert_eq!(row["positionHex"], current["positionHex"]);
+        std::array::from_fn(|k| number(&row["positionHex"][k]))
+    });
+    let pin = &boundary["pin"];
+    assert_eq!(pin["id"].as_u64(), Some(edge[0] as u64));
+    let expected = format!("Str(\"F{}:{}:{}:{:.12}\")", axis, key,
+        pin["chart"].as_u64().unwrap(), number(&pin["parameterHex"]));
+    assert_eq!(rows.iter().find(|r| r["id"] == pin["id"]).unwrap()["key"].as_str().unwrap(), expected);
+    assert_eq!(vertices[1][0].to_bits(), plane.to_bits());
+    let pin_chart = pin["chart"].as_u64().unwrap() as usize;
+    let (_, _, refine) = features.curves[pin_chart].traced_carriers().unwrap();
+    let face_allowance = 8. * refine.curve_eps;
+    assert!(face_allowance <= number(&fan["options"]["surfaceTolHex"]) * 0.01);
+    let face_rectangle = bound_record(&boundary, &context.lat, vertices, face_allowance).unwrap();
+    let mut wrong_length = boundary.clone();
+    wrong_length["face"][2] = json!(1);
+    assert!(bound_record(&wrong_length, &context.lat, vertices, face_allowance).is_none());
+    wrong_length["record"]["face"][2] = json!(1);
