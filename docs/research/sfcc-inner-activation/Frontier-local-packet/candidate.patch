+        ix: id[1].as_i64().unwrap(),
+        iy: id[2].as_i64().unwrap(),
+        iz: id[3].as_i64().unwrap(),
+        key: 0,
+        degenerate: ctx["degenerate"].as_bool().unwrap(),
+        feature_curve: ctx["featureCurve"].as_i64().unwrap(),
+        feature_corner: ctx["featureCorner"].as_i64().unwrap(),
+    };
+    cell.key = cell_key(&lat, cell.level, cell.ix, cell.iy, cell.iz);
