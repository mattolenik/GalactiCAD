+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn graph_capture_a_hex_and_byte_limits_are_exact() {
+        assert_eq!(bits(-0.),"8000000000000000");
+        assert_eq!(bits(f64::from_bits(0x7ff8000000000123)),"7ff8000000000123");
+        let mut writer=Limited(Vec::new());
+        assert_eq!(writer.write(&vec![0;BYTE_CAP]).unwrap(),BYTE_CAP);
+        assert!(writer.write(&[1]).is_err());
+        assert_eq!(writer.0.len(),BYTE_CAP);
+        let mut points=PointTable::new();let p=points.add(0.,0.,0.,0.,1.,0.);
+        assert!(point_payloads(&BTreeSet::from([p]),&points).is_some());
+        assert!(point_payloads(&BTreeSet::from([p+1]),&points).is_none());
+        assert!(point_payloads(&(0..POINT_CAP+1).collect(),&points).is_none());
+    }
+}
