+use super::*;
+use crate::sfcc::{feature_set::SfccFeatureSet, source_storage_a, spatial_index::SfccSpatialIndex};
+use serde_json::{json, Value};
+fn empty_source() -> SfccFeatureSet {
+    SfccFeatureSet {
+        unresolved_branch_paths: Vec::new(),
+        trace_diagnostics: Default::default(),
+        curves: Vec::new(),
+        corners: Vec::new(),
+        index: SfccSpatialIndex::new(1.),
+        strata: Vec::new(),
+        run_id: 0,
+    }
+}
+fn example() -> StagingReport {
+    staging(
+        [(0, 12, 1, 10, 2), (1, 13, 2, 4, 3)],
+        [(4, 100), (5, 7)],
+        3,
+        "synthetic count-only staging control; no geometry claim",
+    )
+}
+fn extract(scope: Scope) -> Value {
+    let observation = scope.take();
+    let result = json!(observation);
+    drop(observation);
+    assert!(OBSERVATION.with(|s| s.borrow().is_none()));
+    result
+}
+#[test]
+fn correlated_storage_staging_and_typed_lifecycle_controls() {
+    let valid = example();
+    assert!(valid.allowed);
+    assert_eq!(valid.staged_items, Some(19));
+    assert_eq!(valid.needed_point_count, 3);
+    assert_eq!(valid.point_key_bytes, Some(107));
+    assert_eq!(valid.fixed_helper_bytes, Some(17301504));
+    assert_eq!(valid.staged_bytes, Some(17314732));
+    assert!(valid.historical_round16_staged_bytes.is_none());
+    let segments = staging(
+        [(0, 1, 1, usize::MAX, 0), (1, 2, 1, 1, 0)],
+        [],
+        0,
+        "synthetic segment sum overflow",
+    );
+    assert_eq!(
+        segments.failure.as_ref().unwrap().arithmetic.category,
+        "staging.segment_sum"
+    );
+    assert_eq!(segments.items_prefix, usize::MAX);
+    assert!(segments.staged_items.is_none());
+    let pins = staging(
+        [(0, 1, 1, usize::MAX, 1)],
+        [],
+        0,
+        "synthetic pin sum overflow",
+    );
+    assert_eq!(
+        pins.failure.as_ref().unwrap().arithmetic.category,
+        "staging.pin_sum"
+    );
+    let keys = staging(
+        [],
+        [(2, usize::MAX), (3, 1)],
+        0,
+        "synthetic key sum overflow",
+    );
+    assert_eq!(
+        keys.failure.as_ref().unwrap().arithmetic.category,
+        "staging.key_sum"
+    );
+    assert_eq!(keys.key_bytes_prefix, usize::MAX);
+    assert!(keys.point_key_bytes.is_none());
+    let item_product = staging(
+        [(0, 1, 1, usize::MAX / 512 + 1, 0)],
+        [],
+        0,
+        "synthetic items product overflow",
+    );
+    assert_eq!(
+        item_product.failure.as_ref().unwrap().arithmetic.category,
+        "staging.items"
+    );
+    let point_product = staging([], [], usize::MAX, "synthetic points product overflow");
+    assert_eq!(
+        point_product.failure.as_ref().unwrap().arithmetic.category,
+        "staging.points"
+    );
+    let key_product = staging(
+        [],
+        [(0, usize::MAX / 4 + 1)],
+        0,
+        "synthetic key product overflow",
+    );
+    assert_eq!(
+        key_product.failure.as_ref().unwrap().arithmetic.category,
+        "staging.key_bytes"
+    );
+    let combined = staging(
+        [(0, 1, 1, usize::MAX / 512, 0)],
+        [],
+        0,
+        "synthetic combined staging overflow",
+    );
+    assert_eq!(
+        combined.failure.as_ref().unwrap().arithmetic.category,
+        "staging.combined"
+    );
+    assert!(combined.staged_bytes.is_none());
+    let exact_items = (LIMIT - 17301504) / 512;
+    let at_cap = staging(
+        [(0, 1, 1, exact_items, 0)],
+        [],
+        0,
+        "synthetic exact staging cap",
+    );
+    assert!(at_cap.allowed);
+    assert_eq!(at_cap.staged_bytes, Some(LIMIT));
+    let over_cap = staging(
+        [(0, 1, 1, exact_items + 1, 0)],
+        [],
+        0,
+        "synthetic staging over cap",
+    );
+    assert!(!over_cap.allowed);
+    assert_eq!(
+        over_cap.failure.as_ref().unwrap().arithmetic.operation,
+        "64MiB_cap"
+    );
+    let arithmetic = json!({"valid":valid,"segmentSumOverflow":segments,"pinSumOverflow":pins,"keySumOverflow":keys,"itemsProductOverflow":item_product,"pointsProductOverflow":point_product,"keyProductOverflow":key_product,"combinedOverflow":combined,"exactStagingCap":at_cap,"overStagingCap":over_cap});
+    let source = empty_source();
+    let source_cost =
+        source_storage_a::inspect(&source, 0, "synthetic empty source; no scene query")
+            .combined_bytes
+            .unwrap();
+    let scope = begin();
+    let exact_staging = LIMIT - source_cost;
+    assert_eq!((exact_staging - 17301504) % 4, 0);
+    let boundary_staging = staging(
+        [],
+        [(0, (exact_staging - 17301504) / 4)],
+        0,
+        "synthetic exact combined boundary from the unchanged staging formula",
+    );
+    assert_eq!(boundary_staging.staged_bytes, Some(exact_staging));
+    record_staging(boundary_staging);
+    assert!(crate::sfcc::private_arc_a::reserve_source_view(&source, exact_staging).is_ok());
+    OBSERVATION.with(|s| {
+        let state = s.borrow();
+        let report = state.as_ref().unwrap().source.as_ref().unwrap();
+        assert!(report.allowed);
+        assert_eq!(report.combined_bytes, Some(LIMIT));
+        assert_eq!(report.ledger.rows.capacity(), MAX_ROWS);
+        assert_eq!(report.native_report_storage_bound, NATIVE_STORAGE_BOUND);
+        assert!(report.native_report_storage_bound <= report.accounting_overhead_bytes);
+    });
+    let retained_success = extract(scope);
+    assert_eq!(
+        retained_success["staging"]["staged_bytes"],
+        retained_success["source"]["staged_bytes"]
+    );
+    let scope = begin();
+    let refusal = staging(
+        [(0, 1, 1, usize::MAX, 1)],
+        [],
+        0,
+        "synthetic pre-source staging refusal",
+    );
+    record_staging(refusal);
+    let staging_refusal = extract(scope);
+    assert!(staging_refusal["source"].is_null());
+    assert_eq!(staging_refusal["staging"]["allowed"], false);
+    let scope = begin();
+    // Direct source-guard +1 byte control; staging formula has4-byte granularity,
+    // so no incompatible fabricated staging-term report is attached to this case.
+    assert!(
+        crate::sfcc::private_arc_a::reserve_source_view(&source, LIMIT - source_cost + 1).is_err()
+    );
+    let retained_refusal = extract(scope);
+    assert_eq!(
+        retained_refusal["source"]["combined_bytes"],
+        json!(LIMIT + 1)
+    );
+    assert_eq!(retained_refusal["source"]["allowed"], false);
+    let scope = begin();
+    assert!(crate::sfcc::private_arc_a::reserve_source_view(&source, 0).is_ok());
+    assert!(crate::sfcc::private_arc_a::reserve_source_view(&source, usize::MAX).is_err());
+    let replacement = extract(scope);
+    assert_eq!(
+        replacement["source"]["failure"]["operation"],
+        "checked_add_overflow"
+    );
+    assert_eq!(replacement["source"]["allowed"], false);
+    assert!(replacement["staging"].is_null());
+    {
+        let _abandoned = begin();
+        record_staging(example());
+        assert!(crate::sfcc::private_arc_a::reserve_source_view(&source, 0).is_ok());
+    }
+    assert!(OBSERVATION.with(|s| s.borrow().is_none()));
+    let clean = extract(begin());
+    assert!(clean["source"].is_null() && clean["staging"].is_null());
+    let mut ledger = Ledger::new();
+    let capacity = ledger.rows.capacity();
+    assert_eq!(capacity, MAX_ROWS);
+    let labels = [
+        "r0", "r1", "r2", "r3", "r4", "r5", "r6", "r7", "r8", "r9", "r10", "r11", "r12", "r13",
+        "r14", "r15", "r16", "r17", "r18", "r19", "r20", "r21", "r22", "r23", "r24", "r25", "r26",
+        "r27", "r28", "r29", "r30", "r31",
+    ];
+    for label in labels {
+        ledger.allocation(label, 1, 8, 8).unwrap();
+        assert_eq!(ledger.rows.capacity(), capacity);
+    }
+    assert_eq!(
+        ledger.allocation("row33", 1, 8, 8).unwrap_err().operation,
+        "ledger_category_cap"
+    );
+    assert_eq!(ledger.rows.capacity(), capacity);
+    assert!(NATIVE_STORAGE_BOUND <= source_storage_a::LEDGER_RESERVATION);
+    let receipt = json!({"scope":"focused checked staging and native typed-resource lifecycle; all counts/source here synthetic, no geometry execution","arithmetic":arithmetic,"typedLifecycle":{"success":retained_success,"stagingFailureBeforeSource":staging_refusal,"sourceOneByteOver":retained_refusal,"replacementOverflow":replacement,"afterAbandonedScope":clean,"takeClearsState":true,"dropClearsState":true,"newSourceDropsPriorLedgerBeforeInspect":true,"jsonExpansionOnlyAfterTake":true},"nativeStorage":{"rowSize":size_of::<source_storage_a::Row>(),"rowAlignment":align_of::<source_storage_a::Row>(),"maximumRows":MAX_ROWS,"observedCapacity":capacity,"rowBufferNeverGrew":true,"reportSize":size_of::<Report>(),"stagingReportSize":size_of::<StagingReport>(),"observationCellSize":size_of::<RefCell<Option<Observation>>>(),"ledgerSize":size_of::<Ledger>(),"failureSize":size_of::<Failure>(),"termArraySize":size_of::<[Option<usize>;5]>(),"termsSize":size_of::<Terms>(),"inputSize":size_of::<Input>(),"stagingFailureSize":size_of::<StagingFailure>(),"bound":NATIVE_STORAGE_BOUND,"unchangedReservation":source_storage_a::LEDGER_RESERVATION,"boundScope":"one native report/state/row-buffer with explicit temporary layouts; excludes JSON trees, serialization, unrelated diagnostics and RSS"},"historicalRound16StagedBytes":Value::Null,"publicationReady":false});
+    let bytes = serde_json::to_vec_pretty(&receipt).unwrap();
+    assert!(bytes.len() <= LIMIT);
+    std::fs::write(
+        std::env::var("SFCC_STORAGE_INTEGRATED_RECEIPT")
+            .expect("fresh integrated staging/lifecycle receipt"),
+        bytes,
+    )
+    .unwrap();
+}
