+//! Bounded observations of selected fan hypotheses; never assigns patch authority.
+use super::*;
+use serde_json::{json,Value};
+use std::{cell::RefCell,collections::BTreeMap};
+#[derive(Default)]
+struct Inventory {active:bool,fans:usize,triangles:usize,rows:BTreeMap<(usize,bool,bool),[usize;3]>,first:Option<Value>,overflow:bool}
+thread_local!{static INVENTORY:RefCell<Inventory>=RefCell::new(Inventory::default());}
+pub(crate) fn reset(){INVENTORY.with(|p|*p.borrow_mut()=Inventory{active:true,..Inventory::default()});}
+pub(crate) fn record(boundary:&[usize],s:&Stratum,box_:&[f64;6],points:&PointTable,opts:&CellMeshOptions,tris:&[usize],returned:bool){
+    if !crate::sfcc::private_arc_a::secondary_component_a::enabled() || !crate::sfcc::private_arc_a::generated_queries_active(){return;}
+    INVENTORY.with(|p|{
+        let mut p=p.borrow_mut();if !p.active{return;}p.fans+=1;p.triangles+=tris.len()/3;
+        if p.fans>4096 || p.triangles>4096 || p.rows.len()>=128 {p.overflow=true;return;}
+        let support=crate::sfcc::surface_patch::supports_local_edits(s);
+        let row=p.rows.entry((s.id,opts.quality_triangulation,support)).or_default();row[0]+=1;row[1]+=tris.len()/3;row[2]+=usize::from(returned);
+        if p.first.is_none(){
+            if boundary.len()>64||tris.len()>3*128 {p.overflow=true;return;}
+            let ids:std::collections::BTreeSet<_>=boundary.iter().chain(tris).copied().collect();
+            p.first=Some(json!({"hypothesisStratum":s.id,"carrierKind":format!("{:?}",s.kind),"sourceIdentity":s.graph_capture_identity_b(),
+                "qualityTriangulation":opts.quality_triangulation,"supportedLocalCarrier":support,
+                "diskPathEnabled":opts.quality_triangulation&&support,"boundary":boundary,"triangles":tris,"returned":returned,
+                "cellBoxBits":box_.map(f64::to_bits),"surfaceTolerance":opts.surface_tol,"chordTolerance":opts.curve_chord_tol,
+                "points":ids.into_iter().map(|id|json!({"id":id,"positionBits":q::pos(points,id).map(f64::to_bits)})).collect::<Vec<_>>(),
+                "assignedOwners":tris.chunks_exact(3).map(|t|points.patch([t[0],t[1],t[2]])).collect::<Vec<_>>(),
+                "continuousSourceOwnershipProved":false}));
+        }
+    });
+}
+pub(crate) fn take_report()->Value{INVENTORY.with(|p|{let p=std::mem::take(&mut *p.borrow_mut());json!({"scope":"fan entry/output hypotheses and option gates only; zero additional field or curve queries","fans":p.fans,"triangles":p.triangles,"complete":!p.overflow,"overflow":p.overflow,
+    "rows":p.rows.into_iter().map(|((id,quality,support),counts)|json!({"stratum":id,"qualityTriangulation":quality,"supportedLocalCarrier":support,"counts":counts})).collect::<Vec<_>>(),"first":p.first,"patchLabelsChanged":false})})}
+
+#[test]
+fn ownership_a_inventory_is_bounded_and_inactive_without_request(){reset();assert_eq!(take_report()["fans"],0);INVENTORY.with(|p|{let mut p=p.borrow_mut();p.overflow=true;});assert_eq!(take_report()["complete"],false);assert_eq!(take_report()["fans"],0);}
+
+#[test]
+fn ownership_a_first_actual_fan_source_regions_and_projection_witnesses(){
+    use crate::sfcc::{pipeline::{build_pipeline_context,PipelineTuning,SfccWorldCube},shared_twisted_proof::exposure_a::ownership_source_a};
+    let _numerics=crate::sfcc::validation::NumericalGuard::new();
+    let input:Value=serde_json::from_str(include_str!("../../fixtures/shared-arc-full-knob.json")).unwrap();
+    let saved:Value=serde_json::from_str(include_str!("../../fixtures/ownership-first-fan-a.json")).unwrap();
+    let root=crate::scene_bridge::build_csg_tree_from_json(input["sceneJson"].as_str().unwrap()).unwrap();
+    let cube=SfccWorldCube{min_x:input["cube"]["min"][0].as_f64().unwrap(),min_y:input["cube"]["min"][1].as_f64().unwrap(),min_z:input["cube"]["min"][2].as_f64().unwrap(),size:input["cube"]["max"][0].as_f64().unwrap()-input["cube"]["min"][0].as_f64().unwrap()};
+    let f=build_pipeline_context(&root,&cube,&PipelineTuning::default()).features;
+    assert_eq!(f.fingerprint().to_string(),saved["fingerprint"].as_str().unwrap());
+    assert_eq!(saved["options"]["qualityTriangulation"],false);
+    let sid=saved["fan"]["stratum"].as_u64().unwrap() as usize;
+    assert!(crate::sfcc::surface_patch::supports_local_edits(&f.strata[sid]));
+    let points:BTreeMap<usize,[f64;3]>=saved["points"].as_array().unwrap().iter().map(|p|{
+        let xyz=std::array::from_fn(|k|f64::from_bits(u64::from_str_radix(p["positionHex"][k].as_str().unwrap(),16).unwrap()));(p["id"].as_u64().unwrap() as usize,xyz)
+    }).collect();
+    let triangles:Vec<usize>=serde_json::from_value(saved["fan"]["triangles"].clone()).unwrap();
+    assert_eq!(triangles.len(),18);
+    let mut regions=Vec::new();
+    let weights=[[1.,0.,0.],[0.,1.,0.],[0.,0.,1.],[0.5,0.5,0.],[0.,0.5,0.5],[0.5,0.,0.5],[0.25,0.25,0.5]];
+    for (ti,t) in triangles.chunks_exact(3).enumerate(){let p=[points[&t[0]],points[&t[1]],points[&t[2]]];
+        for (wi,w) in weights.iter().enumerate(){
+            use crate::sdf::enclosure::Interval as I;
+            let yz_interval:[I;2]=std::array::from_fn(|k|{let mut sum=I::point(0.);for i in 0..3{sum=sum.add(I::point(p[i][k+1]).mul(w[i]).unwrap()).unwrap();}sum});
+            let yz:[f64;2]=yz_interval.map(|v|v.lo*0.5+v.hi*0.5);
+            let bound=ownership_source_a::bound(&f,sid,yz_interval.map(|v|v.lo),yz_interval.map(|v|v.hi));
+            regions.push(json!({"triangle":ti,"weights":w,"probeKind":"enclosure of exact dyadic barycentric YZ point on chosen cylinder graph","certificate":bound}));
+            if wi==6 {
+                let lo=yz.map(|x|(x-1e-6).next_down());let hi=yz.map(|x|(x+1e-6).next_up());
+                let chart=p.map(|v|[v[1],v[2]]);
+                let inside=[[lo[0],lo[1]],[lo[0],hi[1]],[hi[0],lo[1]],[hi[0],hi[1]]].iter().all(|&corner|(0..3).all(|i|{
+                    let a=chart[i];let b=chart[(i+1)%3];let sign=crate::sfcc::predicates::orient2d(a,b,chart[(i+2)%3]);
+                    sign!=0 && crate::sfcc::predicates::orient2d(a,b,corner)==sign
+                }));
+                regions.push(json!({"triangle":ti,"probeKind":"open graph rectangle strictly inside triangle chart when flagged","insideTriangleChart":inside,"certificate":if inside{ownership_source_a::bound(&f,sid,lo,hi)}else{None}}));
+            }
+        }
+    }
+    let exposed=regions.iter().filter(|r|r["certificate"]["fullSourceEqualsCylinder"]==true).count();
+    let counter=regions.iter().filter(|r|r["certificate"]["projectionOwnershipDisproved"]==true).count();
+    assert!(exposed>0,"no positive composed-source region in first actual cylinder fan");
+    assert!(regions.iter().any(|r|r["insideTriangleChart"]==true && r["certificate"]["fullSourceEqualsCylinder"]==true),"no open exposed subregion inside actual triangle chart");
+    assert!(regions.len()<=64);
+    let first=*points.values().next().unwrap();
+    assert!(ownership_source_a::bound(&f,sid,[f64::NAN,first[2]],[first[1],first[2]]).is_none());
+    assert!(ownership_source_a::bound(&f,sid,[first[1],100.],[first[1],101.]).is_none());
+    let report=json!({"scope":"first actual six-triangle fan; bounded composed-source graph regions only","parentReceiptSha256":saved["parentReceiptSha256"],"sourceFingerprint":f.fingerprint().to_string(),"stratum":sid,"qualityTriangulation":false,"supportedLocalCarrier":true,
+        "positiveSourceRegions":exposed,"projectionCounterexamples":counter,"regionCount":regions.len(),"regions":regions,
+        "wholeFanCoverageProved":false,"approximateMeshInvalidityProved":false,"patchLabelsAssigned":false,
+        "limitation":"a positive graph witness disproves that projection's ownership, not every possible nearby curved-boundary reconstruction"});
+    if let Ok(path)=std::env::var("SFCC_OWNERSHIP_A_RECEIPT"){std::fs::write(path,serde_json::to_vec_pretty(&report).unwrap()).unwrap();}
+}
