+            BIND_STAGE.with(std::cell::Cell::get)
+        )
+    });
+    let mut budget = budget(&f);
+    let before = budget.charged_queries();
+    let mut rows = Vec::new();
+    for s in 0..2 {
+        let mut mapped = Vec::new();
+        for i in 0..=24 {
+            let t = if i == 24 {
+                ranges[s][1]
+            } else {
+                ranges[s][0] + (ranges[s][1] - ranges[s][0]) * i as f64 / 24.
+            };
+            let own = cert
+                .query_main(charts[s], t, &mut budget)
+                .expect("source checked own query");
+            let other = cert
+                .map_main(&own, charts[1 - s], &mut budget)
+                .expect("actual checked counterpart");
+            assert!(transport_a::accepts(own.point(), other.point(), eps));
+            rows.push(json!({"chart":own.chart(),"parameterBits":own.parameter().to_bits(),"radial":own.radial(),"pointBits":own.point().map(f64::to_bits),"otherChart":other.chart(),"otherParameterBits":other.parameter().to_bits(),"otherRadial":other.radial(),"otherPointBits":other.point().map(f64::to_bits)}));
+            mapped.push((own, other));
+        }
+        Certificate::ordered(&mapped)
+            .expect("both actual parameter and canonical radial event sequences ordered");
+    }
+    let image = cert.image(cert.radial[0], cert.radial[1]).unwrap();
+    let report = json!({"scope":"whole ideal source interval and epsilon-envelope alias equation proof; every accepted query also stays in its independent original projection tube; no universal oldNewton continuity","featureFingerprint":f.fingerprint().to_string(),"source":cert.source,"charts":charts,"ranges":ranges,"globalRanges":charts.map(|c|[f.curves[c].t_min,f.curves[c].t_max]),"globalCorners":charts.map(|c|[f.curves[c].corner_start,f.curves[c].corner_end]),"canonicalRadialRange":cert.radial,"idealImage":image,"sourceMargins":cert.source_margins,"authorityBox":cert.authority_box,"authorityAliasMargins":cert.authority_alias_margins,"rawProjectionTubes":cert.tubes,"heightDerivativeAbsLower":cert.height_derivative_abs_lower,"generatedOffsetError":[cert.generated_offset_error.lo,cert.generated_offset_error.hi],"sourceGeneratedSeparationUpper":cert.source_generated_separation_upper,"allowance":eps,"events":rows,"chargedBefore":before,"chargedAfter":budget.charged_queries(),"rawQueryContinuityProved":false,"wholeChartAliasProved":false,"transactionAuthorized":false});
+    std::fs::write(
