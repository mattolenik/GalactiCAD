+        if radical.lo <= 0. {
+            return None;
+        }
+        let image = [
+            sqrt(radical)?.mul(-1.)?.add(I::point(self.center[0]))?,
+            y,
+            z,
+        ];
+        let check = activation_a::meridian_bound(self.groove, rho, y)?;
+        if !same_meridian(check, branch) {
+            return None;
+        }
+        let margins = self.source_margins(rho, image)?;
+        Some((
+            image,
+            json!({"image":bounds(image),"rhoBounds":[rho.lo,rho.hi],"chamferZeroRadiusBounds":[qrho.lo,qrho.hi],"margins":margins,
