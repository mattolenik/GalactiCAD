+            return false;
+        };
+        if !value.value.is_finite() || value.value.abs() > strict {
+            return false;
+        }
+    }
+    let pair = features.curves[plan.charts[1]].adjacent_strata;
+    let a = features.strata[pair[0]].normal(plan.point[0], plan.point[1], plan.point[2]);
+    let b = features.strata[pair[1]].normal(plan.point[0], plan.point[1], plan.point[2]);
+    let n = std::array::from_fn(|k| a[k] + b[k]);
+    let len = q::norm(n);
+    if !len.is_finite() || len <= 1e-12 {
+        return false;
+    }
+    let n = n.map(|v| v / len);
+    let key = format!("activation:{}:{}", plan.charts[0], plan.charts[1]);
+    if let Some(id) = points.lookup_str(&key) {
+        if q::pos(points, id).map(f64::to_bits) != plan.point.map(f64::to_bits) {
+            return false;
+        }
+    }
+    let id = points.get_or_create_str(&key, || {
+        [
+            plan.point[0],
+            plan.point[1],
+            plan.point[2],
+            n[0],
+            n[1],
+            n[2],
+        ]
+    });
+    for slot in 0..2 {
+        paths
+            .get_mut(&plan.charts[slot])
+            .unwrap()
+            .push((plan.cuts[slot], id));
+    }
+    true
+}
