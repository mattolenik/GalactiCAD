+            f,
+            &cert,
+            &mut budget,
+            &context.lat,
+            (1, key, len + 1),
+            &r,
+            plane,
+            &live
+        )
+        .unwrap_err(),
+        "typed_face_length"
+    );
+    assert_eq!(
