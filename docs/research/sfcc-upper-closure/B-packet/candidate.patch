+//! Positive exposure for a source-bound cylinder/twisted-side branch.
+//! Unsupported configurations return no certificate; they are never declared dead.
+use super::{correlated_c::BranchCertificate, *};
+use crate::{
+    primitives::smin::SminMode,
+    sdf::{BlendKind, CsgNode},
+};
+type Result<T> = std::result::Result<T, &'static str>;
+fn exact_identity(leaf: &Leaf) -> bool {
+    leaf.sim.r == [1., 0., 0., 0., 1., 0., 0., 0., 1.] && leaf.sim.t == [0.; 3] && leaf.sim.s == 1.
+}
+fn pair(node: &CsgNode, kind: Option<(BlendKind, SminMode)>) -> Result<(&CsgNode, &CsgNode, f64)> {
+    match (node, kind) {
+        (CsgNode::Max(c), None) if c.len() == 2 => Ok((&c[0], &c[1], 0.)),
+        (
+            CsgNode::Blend {
+                kind: k,
+                mode: m,
+                r,
+                children: c,
+                ..
+            },
+            Some((ek, em)),
+        ) if *k == ek && *m == em && c.len() == 2 && r.is_finite() && *r > 0. => {
+            Ok((&c[0], &c[1], *r))
+        }
+        _ => Err("source_operator_or_arity"),
+    }
+}
+fn leaf(node: &CsgNode, sign: f64) -> Result<&Leaf> {
+    let CsgNode::Leaf(l) = node else {
+        return Err("source_leaf");
+    };
+    if l.sign != sign || !exact_identity(l) {
+        return Err("source_sign_or_frame");
+    }
+    Ok(l)
+}
+
+fn support(strata: &[Stratum], branch: &HelixBranch, y: I) -> Result<f64> {
+    ancestor_support(strata, branch, y, true)
+}
+
+fn ancestor_support(
+    strata: &[Stratum],
+    branch: &HelixBranch,
+    y: I,
+    require_inactive_groove: bool,
+) -> Result<f64> {
+    let cert =
+        BranchCertificate::bind_strata(strata, branch, y).ok_or("supporting_branch_conditions")?;
+    let root = strata[branch.native]
+        .exposure_root_a()
+        .ok_or("plain_source_root")?;
+    let (cap_cut, sphere, outer_r) = pair(root, Some((BlendKind::Smax, SminMode::Round)))?;
+    let (groove_cut, cap, _) = pair(cap_cut, None)?;
+    let (hard_intersection, groove, chamfer_r) =
+        pair(groove_cut, Some((BlendKind::Smax, SminMode::Chamfer)))?;
+    let (inner_union, cylinder, _) = pair(hard_intersection, None)?;
+    let (other, native, inner_r) = pair(inner_union, Some((BlendKind::Smin, SminMode::Round)))?;
+    let native = leaf(native, 1.)?;
+    let other = leaf(other, 1.)?;
+    let cylinder = leaf(cylinder, 1.)?;
+    let (p, registered_native, registered_other, registered_r) = strata[branch.native]
+        .round_twisted_source(&strata[branch.field])
+        .ok_or("registered_source_pair")?;
+    let registered_cylinder = strata[branch.cylinder_id]
+        .correlated_cylinder_source_c(&strata[branch.native])
+        .ok_or("registered_cylinder")?;
+    if !std::ptr::eq(native, registered_native)
+        || !std::ptr::eq(other, registered_other)
+        || !std::ptr::eq(cylinder, registered_cylinder)
+        || inner_r != registered_r
+    {
+        return Err("different_source_occurrence");
+    }
+    // Above every profile vertex, the meridian winding is outside and distance
+    // to every finite profile segment is at least the axial separation.
+    let groove = leaf(groove, -1.)?;
+    let Shape::Lathe { edges } = &groove.shape else {
+        return Err("groove_not_lathe");
+    };
+    if edges.len() < 3
+        || edges.len() > 64
+        || !edges
+            .iter()
+            .any(|e| !matches!(e.kind, crate::primitives::shapes::LatheEdgeKind::None))
+    {
+        return Err("groove_profile_size");
+    }
+    let mut top = f64::NEG_INFINITY;
+    for (i, edge) in edges.iter().enumerate() {
+        let next = &edges[(i + 1) % edges.len()];
+        if [edge.r0, edge.r1, edge.y0, edge.y1]
+            .iter()
+            .any(|x| !x.is_finite())
+            || edge.r1 != next.r0
+            || edge.y1 != next.y0
+        {
+            return Err("groove_profile_not_closed");
+        }
+        top = top.max(edge.y0).max(edge.y1);
+    }
+    let groove_gap = y
+        .sub(I::point(groove.pos[1]))
+        .and_then(|a| a.sub(I::point(top)))
+        .ok_or("groove_arithmetic")?;
+    let groove_margin = groove_gap
+        .sub(I::point(chamfer_r))
+        .ok_or("groove_arithmetic")?;
+    if require_inactive_groove && groove_margin.lo <= 0. {
+        return Err("groove_chamfer_not_inactive");
+    }
+
+    // Below the extrusion's lower cap, unsigned extrusion distance is at least
+    // that axial separation, regardless of the polygon's radial distance.
+    let cap = leaf(cap, -1.)?;
+    let Shape::Extrude { h, .. } = &cap.shape else {
+        return Err("cap_not_extrude");
+    };
+    if !h.is_finite() || *h <= 0. {
+        return Err("cap_extent");
+    }
+    let cap_gap = I::point(cap.pos[1])
+        .sub(I::point(*h))
+        .and_then(|a| a.sub(y))
+        .ok_or("cap_arithmetic")?;
+    if cap_gap.lo <= 0. {
+        return Err("cap_cut_not_inactive");
+    }
+
+    let sphere = leaf(sphere, 1.)?;
+    let Shape::Sphere { r: sphere_r } = &sphere.shape else {
+        return Err("outer_not_sphere");
+    };
+    if !sphere_r.is_finite()
+        || *sphere_r <= outer_r
+        || sphere.pos[0] != branch.cylinder.0[0]
+        || sphere.pos[2] != branch.cylinder.0[2]
+    {
+        return Err("outer_sphere_frame_or_radius");
+    }
+    // Correlated helix radius is exactly the represented cylinder radius.
+    let axial = y.sub(I::point(sphere.pos[1])).ok_or("sphere_arithmetic")?;
+    let radius_squared = square(I::point(branch.cylinder.2))
+        .and_then(|a| a.add(square(axial)?))
+        .ok_or("sphere_arithmetic")?;
+    let inactive_radius = I::point(*sphere_r)
+        .sub(I::point(outer_r))
+        .ok_or("sphere_arithmetic")?;
+    let inactive_squared = square(inactive_radius).ok_or("sphere_arithmetic")?;
+    if radius_squared.hi >= inactive_squared.lo {
+        return Err("outer_round_not_inactive");
+    }
+    let sphere_margin = inactive_radius
+        .sub(sqrt(radius_squared).ok_or("sphere_arithmetic")?)
+        .ok_or("sphere_arithmetic")?;
+    if sphere_margin.lo <= 0. {
+        return Err("outer_round_not_inactive");
+    }
+
+    // Transverse determinant for (radial squared minus R², twisted side) is
+    // 2*u*nz2. Its nonzero sign rules out tangency/vanishing dihedral here.
+    let determinant = branch
+        .u
+        .mul(2.)
+        .and_then(|a| a.mul(p.nz2))
+        .ok_or("determinant_arithmetic")?;
+    if determinant.lo <= 0. && determinant.hi >= 0. {
+        return Err("carrier_pair_tangent");
+    }
+    Ok(determinant.lo.abs().min(determinant.hi.abs()))
+}
+
+// Bind the borrowed runtime tree to the immutable source copy without a hash
+// collision premise or recursively formatting shared source graphs.
+fn same_source(a: &CsgNode, b: &CsgNode, budget: &mut usize) -> bool {
+    if *budget == 0 {
+        return false;
+    }
+    *budget -= 1;
+    match (a, b) {
+        (CsgNode::Leaf(a), CsgNode::Leaf(b)) => {
+            let bounded = |s: &Shape| match s {
+                Shape::Extrude { verts, .. } => verts.len() <= 128,
+                Shape::Lathe { edges } => edges.len() <= 64,
+                Shape::Sphere { .. } | Shape::Cylinder { .. } => true,
+                _ => false,
+            };
+            bounded(&a.shape)
+                && bounded(&b.shape)
+                && a.sign == b.sign
+                && a.sim == b.sim
+                && a.pos == b.pos
+                && a.index == b.index
+                && a.shape == b.shape
+        }
+        (CsgNode::Min(a), CsgNode::Min(b)) | (CsgNode::Max(a), CsgNode::Max(b)) => {
+            a.len() == b.len()
+                && a.len() == 2
+                && a.iter().zip(b).all(|(a, b)| same_source(a, b, budget))
+        }
+        (
+            CsgNode::Blend {
+                kind: ak,
+                mode: am,
+                r: ar,
+                n: an,
+                children: a,
+            },
+            CsgNode::Blend {
+                kind: bk,
+                mode: bm,
+                r: br,
+                n: bn,
+                children: b,
+            },
+        ) => {
+            ak == bk
+                && am == bm
+                && ar == br
+                && an == bn
+                && a.len() == b.len()
+                && a.len() == 2
+                && a.iter().zip(b).all(|(a, b)| same_source(a, b, budget))
+        }
+        _ => false,
+    }
+}
+
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct Exposure {
+    pub source: [usize; 3],
+    pub sign: i8,
+    pub height: [f64; 2],
+    pub distance_upper: f64,
+    pub determinant_lower: f64,
+}
+
+fn branch_at(
+    strata: &[Stratum],
+    native: usize,
+    field: usize,
+    cylinder_id: usize,
+    point: [f64; 3],
+) -> Option<HelixBranch> {
+    let (p, _, _, _) = strata
+        .get(native)?
+        .round_twisted_source(strata.get(field)?)?;
+    let cylinder = strata.get(cylinder_id)?.certificate_cylinder()?;
+    if strata[native].id != native
+        || strata[field].id != field
+        || strata[cylinder_id].id != cylinder_id
+        || p.sim.r != [1., 0., 0., 0., 1., 0., 0., 0., 1.]
+        || p.sim.t != [0.; 3]
+        || p.sim.s != 1.
+        || p.nx2 != 0.
+        || p.nz2.abs() != 1.
+        || p.pos_x != cylinder.0[0]
+        || p.pos_z != cylinder.0[2]
+        || cylinder.1 != [0., 1., 0.]
+    {
+        return None;
+    }
+    let u2 = square(I::point(cylinder.2))?.sub(square(I::point(p.v0z))?)?;
+    if u2.lo <= 0. {
+        return None;
+    }
+    let x = twisted(p, point, point)?.3[0];
+    let sign = if x.lo > 0. {
+        1
+    } else if x.hi < 0. {
+        -1
+    } else {
+        return None;
+    };
+    let mut u = sqrt(u2)?;
+    if sign < 0 {
+        u = u.mul(-1.)?;
+    }
+    Some(HelixBranch {
+        native,
+        field,
+        cylinder_id,
+        p,
+        cylinder,
+        u,
+        sign,
+    })
+}
+
+fn certificate(
+    runtime_root: &CsgNode,
+    strata: &[Stratum],
+    branch: HelixBranch,
+    point: [f64; 3],
+    epsilon: f64,
+) -> Option<Exposure> {
+    if !same_source(
+        runtime_root,
+        strata.get(branch.native)?.exposure_root_a()?,
+        &mut 64,
+    ) {
+        return None;
+    }
+    let y = interval(
+        (point[1] - epsilon).next_down(),
+        (point[1] + epsilon).next_up(),
+    )?;
+    let determinant_lower = support(strata, &branch, y).ok()?;
+    let exact = BranchCertificate::bind_strata(strata, &branch, I::point(point[1]))?;
+    let (lo, hi) = exact.image_bounds();
+    let mut d2 = I::point(0.);
+    for k in 0..3 {
+        d2 = d2.add(square(I::point(point[k]).sub(interval(lo[k], hi[k])?)?)?)?;
+    }
+    let distance_upper = sqrt(d2)?.hi;
+    if distance_upper > epsilon {
+        return None;
+    }
+    Some(Exposure {
+        source: [branch.native, branch.field, branch.cylinder_id],
+        sign: branch.sign,
+        height: [y.lo, y.hi],
+        distance_upper,
+        determinant_lower,
+    })
+}
