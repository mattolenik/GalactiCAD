
// Arcane Power Cell
// A faceted containment vessel with mechanical detailing

// ═══ CORE ═══
// Chamfer-intersect a cube and sphere to produce a faceted gem shape
let coreBox = box([7, 7, 7])
let coreSphere = sphere.radius(9.5)
let core = intersect(coreBox, coreSphere).chamfer(2)

// ═══ SURFACE DETAIL ═══
// Groove: equatorial cooling channel where the torus ring meets the shell
let coolantRing = torus.smallRadius(0.8).largeRadius(8)
let grooved = groove(core).pattern(coolantRing).radii(0.6, 0.25)

// Tongue: raised sealing ridge along one meridian
let sealLine = box([10, 0.2, 10])
let ridged = tongue(grooved).pattern(sealLine).radii(0.35, 0.15)

// Engrave: shallow inspection port depression on the top face
let port = sphere.radius(4).shift([0, 0, 8.5])
let detailed = engrave(ridged).pattern(port).radius(0.4)

// ═══ CONTAINMENT RING ═══
// Outer halo ring joined to the core with a columns-pattern lattice
let halo = torus.smallRadius(0.6).largeRadius(11)
let contained = union(detailed, halo).columns(1, 8)

// ═══ STABILISER FINS ═══
// Cross-shaped fins with a terraced stairs-blend transition
let finA = box([0.3, 13, 3])
let finB = rotate([0, 0, 90], box([0.3, 13, 3]))
let finned = union(contained, union(finA, finB)).stairs(1.2, 4)

// ═══ STRUCTURAL RIBS ═══
// Pipe skeleton tracing the box-sphere boundary curves
let ribs = pipe(coreBox, coreSphere).radius(0.2)

return union(finned, ribs).round(0.3)
