+// Numerical witness construction uses the existing source evaluator. Its finite
+// bisection is not the independent continuous source theorem.
+fn outgoing_witness(root: &CsgNode, height: f64) -> [f64; 3] {
+    let CsgNode::Leaf(native) = node_at(root, &[0, 0, 0, 0, 1]) else {
+        panic!("native leaf")
+    };
+    let Shape::Extrude {
+        verts,
+        h,
+        twist_rad,
+        ..
+    } = &native.shape
+    else {
+        panic!("native extrusion")
+    };
+    let CsgNode::Leaf(cylinder) = node_at(root, &[0, 0, 0, 1]) else {
+        panic!("cylinder leaf")
+    };
+    let Shape::Cylinder { r, .. } = &cylinder.shape else {
+        panic!("cylinder")
+    };
+    let v0 = verts[7]; // fixture's explicitly selected horizontal side 3
+    assert_eq!(v0, 8.);
+    let point = |rho: f64| {
+        let v = v0 + rho - r;
+        let u = (rho * rho - v * v).sqrt();
+        let theta = (height - native.pos[1] + h) / (2. * h) * twist_rad;
+        let (s, c) = theta.sin_cos();
+        [
+            native.pos[0] + u * c - v * s,
+            height,
+            native.pos[2] + u * s + v * c,
+        ]
+    };
+    let mut lo = r - 0.3;
+    let mut hi = *r;
+    assert!(
+        root.f(point(lo)) < 0. && root.f(point(hi)) > 0.,
+        "numerical witness bracket"
+    );
+    for _ in 0..64 {
+        let mid = lo + (hi - lo) * 0.5;
+        if mid == lo || mid == hi {
+            break;
+        }
+        if root.f(point(mid)) > 0. {
+            hi = mid;
+        } else {
+            lo = mid;
+        }
+    }
+    let p = point(lo + (hi - lo) * 0.5);
+    assert!(root.f(p).abs() < 1e-10);
+    let e = node_at(root, &[0, 0, 0, 0, 1]).f(p);
+    let c = node_at(root, &[0, 0, 0, 1]).f(p);
+    assert!(
+        e < -1e-5 && (e - c).abs() < 1e-10,
+        "actual selected operands agree at nonzero level"
+    );
+    assert!(
+        (node_at(root, &[0, 0, 0, 0]).f(p) - e).abs() < 1e-10,
+        "actual parent field agrees at this point only"
+    );
+    p
+}
+fn lifted_pair(f: &SfccFeatureSet) -> [usize; 2] {
+    [0, 1].map(|child| {
+        let wanted = format!("Child({child})");
+        let ids: Vec<_> = f
+            .strata
+            .iter()
+            .filter_map(|s| {
+                let d = s.graph_capture_identity_b()?;
+                let field = &d["field"];
+                (field["path"] == json!([])
+                    && field["branch"]["path"] == json!([0, 0, 0])
+                    && field["branch"]["kind"] == wanted
+                    && field["partners"] == json!([1, usize::MAX, 1]))
+                .then_some(s.id)
+            })
+            .collect();
+        assert_eq!(ids.len(), 1, "actual lifted hard-Max source occurrence");
+        ids[0]
+    })
+}
+fn nearest_compiled(f: &SfccFeatureSet, pair: [usize; 2], p: [f64; 3]) -> Value {
+    let mut rows = Vec::new();
+    for c in &f.curves {
+        if c.adjacent_strata != pair && c.adjacent_strata != [pair[1], pair[0]] {
+            continue;
+        }
+        let (t, proposal_distance) = c.project(p[0], p[1], p[2]);
+        let own = c.point_at_checked(t);
+        let epsilon = c.traced_carriers().map_or(0., |(_, _, r)| r.curve_eps * 8.);
+        let domains = own.is_some_and(|q| {
+            pair.iter()
+                .all(|&id| f.strata[id].domain_contains(q, epsilon))
+        });
+        let distance = own
+            .filter(|_| domains)
+            .map(|q| (q[0] - p[0]).hypot(q[1] - p[1]).hypot(q[2] - p[2]));
+        rows.push(json!({"curve":c.id,"sourcePair":c.adjacent_strata,"parameterHex":hex(t),"proposalDistance":proposal_distance,"distance":distance,"ownPointHex":own.map(|p|p.map(hex)),"domains":domains,"rangeHex":[hex(c.t_min),hex(c.t_max)],"cornerEnds":[c.corner_start,c.corner_end]}));
+    }
+    rows.sort_by(|a, b| {
+        a["distance"]
+            .as_f64()
+            .unwrap_or(f64::INFINITY)
+            .total_cmp(&b["distance"].as_f64().unwrap_or(f64::INFINITY))
+    });
+    json!({"curves":rows,"nearestDistance":rows.first().map(|r|r["distance"].clone())})
+}
+
+fn families(f: &SfccFeatureSet) -> Value {
+    let mut out = std::collections::BTreeMap::<[usize; 2], Vec<Value>>::new();
+    for c in &f.curves {
+        let mut pair = c.adjacent_strata;
+        pair.sort();
+        out.entry(pair).or_default().push(json!({"id":c.id,"rangeHex":[hex(c.t_min),hex(c.t_max)],"corners":[c.corner_start,c.corner_end],"pointCount":c.index_polyline.len()/3,"endpointHex":[c.point_at_checked(c.t_min).map(|p|p.map(hex)),c.point_at_checked(c.t_max).map(|p|p.map(hex))]}));
+    }
+    json!(out
+        .into_iter()
+        .map(|(pair, curves)| json!({"pair":pair,"curves":curves}))
+        .collect::<Vec<_>>())
+}
