+#[test]
+fn incident_a_incomplete_or_changed_output_cannot_supply_fans() {
+    assert!(emitted_fans(&json!({})).is_err());
+    let mut report = json!({"failedCellCount":0,"featureCellFallbacks":0,"allGeneratedQueriesValidated":true,
+        "originalFaceConsumptionValid":true,"invalidWorkingOrExportedOrientation":[],"cellBoxBits":[1],
+        "triangles":[0,1,2],"points":[{"id":0,"positionBits":[0,0,0]}],"fanCaptureA":{"complete":true,
+        "pairedFans":[{"returned":true,"cellBoxBits":[1],"triangles":[0,1,2],"points":[{"id":0,"positionBits":[1,0,0]}]}]}});
+    assert_eq!(
+        emitted_fans(&report).unwrap_err(),
+        "incident_fan_final_point_binding"
+    );
+    report["fanCaptureA"]["pairedFans"][0]["points"][0]["positionBits"] = json!([0, 0, 0]);
+    report["fanCaptureA"]["pairedFans"][0]["points"] = json!([
+        {"id":0,"positionBits":[0,0,0]}, {"id":1,"positionBits":[0,0,0]}, {"id":2,"positionBits":[0,0,0]}]);
+    report["points"] = report["fanCaptureA"]["pairedFans"][0]["points"].clone();
+    report["triangles"] = json!([0, 1, 2, 2, 1, 0]);
+    assert_eq!(
+        emitted_fans(&report).unwrap_err(),
+        "incident_fan_output_coverage"
+    );
+}
