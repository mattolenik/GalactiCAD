--- a/gcad-wasm/kernel/src/sfcc/upper_cell_sampler_tests.rs
+++ b/gcad-wasm/kernel/src/sfcc/upper_cell_sampler_tests.rs
@@ -0,0 +1,309 @@
+use super::*;
+use crate::sfcc::pipeline::{build_pipeline_context, PipelineTuning, SfccWorldCube};
+use crate::sfcc::validation::{numerical_failures, restore_numerical_failures, NumericalGuard};
+use serde_json::{json, Value};
+
+fn bits(x: f64) -> String {
+    format!("{:016x}", x.to_bits())
+}
+fn number(v: &Value) -> f64 {
+    f64::from_bits(u64::from_str_radix(v.as_str().unwrap(), 16).unwrap())
+}
+fn fixture() -> (SfccFeatureSet, Value, usize) {
+    let w: Value =
+        serde_json::from_str(include_str!("../../fixtures/upper-cell-sampler.json")).unwrap();
+    let source: Value =
+        serde_json::from_str(include_str!("../../fixtures/shared-arc-full-knob.json")).unwrap();
+    assert_eq!(w["sourceConfigSha256"], source["sourceConfigSha256"]);
+    let root = crate::scene_bridge::build_csg_tree_from_json(source["sceneJson"].as_str().unwrap())
+        .unwrap();
+    let cube = SfccWorldCube {
+        min_x: source["cube"]["min"][0].as_f64().unwrap(),
+        min_y: source["cube"]["min"][1].as_f64().unwrap(),
+        min_z: source["cube"]["min"][2].as_f64().unwrap(),
+        size: source["cube"]["max"][0].as_f64().unwrap()
+            - source["cube"]["min"][0].as_f64().unwrap(),
+    };
+    let f = build_pipeline_context(&root, &cube, &PipelineTuning::default()).features;
+    assert_eq!(
+        f.fingerprint().to_string(),
+        w["fingerprint"].as_str().unwrap()
+    );
+    let incoming = crate::sfcc::stage4_source_preflight_c::selected_pair_c(&f).unwrap();
+    let corner = f.curves[incoming[0]].corner_end;
+    assert!(corner >= 0);
+    let candidates: Vec<_> = f.corners[corner as usize]
+        .curve_ends
+        .iter()
+        .filter_map(|&(id, end)| {
+            (!incoming.contains(&id) && end == 0 && f.curves[id].upper_chart().is_some())
+                .then_some(id)
+        })
+        .collect();
+    assert_eq!(
+        candidates.len(),
+        1,
+        "source event has one actual outgoing representation"
+    );
+    let id = candidates[0];
+    assert_eq!(id, w["curve"].as_u64().unwrap() as usize);
+    let expected_pair: [usize; 2] =
+        std::array::from_fn(|k| w["strata"][k].as_u64().unwrap() as usize);
+    assert_eq!(f.curves[id].adjacent_strata, expected_pair);
+    for event in w["capturedCurveQueries"].as_array().unwrap() {
+        let t = number(&event["tHex"]);
+        let expected: [f64; 3] = std::array::from_fn(|k| number(&event["pointHex"][k]));
+        assert_eq!(
+            f.curves[id].point_at_checked(t).unwrap().map(f64::to_bits),
+            expected.map(f64::to_bits),
+            "fresh own query matches actual component capture"
+        );
+    }
+    (f, w, id)
+}
+fn options<'a>(f: &'a SfccFeatureSet, w: &Value) -> CellMeshOptions<'a> {
+    let o = &w["options"];
+    assert_eq!(o["interiorMode"], "Project");
+    CellMeshOptions {
+        surface_tol: number(&o["surfaceTolHex"]),
+        curve_chord_tol: number(&o["chordTolHex"]),
+        max_polyline_points_per_cell: o["maxPolylinePoints"].as_u64().unwrap() as usize,
+        project_max_iters: o["projectMaxIters"].as_u64().unwrap() as u32,
+        quality_triangulation: o["qualityTriangulation"].as_bool().unwrap(),
+        interior_vertex_mode: InteriorVertexMode::Project,
+        features: Some(f),
+    }
+}
+fn legacy<T>(f: impl FnOnce() -> T) -> T {
+    struct Reset(bool);
+    impl Drop for Reset {
+        fn drop(&mut self) {
+            UPPER_CELL_LEGACY.with(|v| v.set(self.0));
+        }
+    }
+    let _reset = Reset(UPPER_CELL_LEGACY.with(|v| v.replace(true)));
+    f()
+}
+#[test]
+fn upper_cell_actual_sampler_consumes_proved_closure() {
+    let (f, w, id) = fixture();
+    let c = &f.curves[id];
+    let opts = options(&f, &w);
+    let span: [f64; 2] = std::array::from_fn(|k| number(&w["spanHex"][k]));
+    let bbox: [f64; 6] = std::array::from_fn(|k| number(&w["cellBoxHex"][k]));
+    let p = c.point_at_checked(span[0]).unwrap();
+    assert_eq!(
+        p.map(bits),
+        std::array::from_fn::<_, 3, _>(|k| w["pointHex"][k].as_str().unwrap().to_owned())
+    );
+    let owned = c
+        .adjacent_strata
+        .map(|sid| f.strata[sid].domain_contains(p, opts.surface_tol));
+    let qualified = c
+        .adjacent_strata
+        .map(|sid| c.upper_source_member(&f.strata, sid, span[0], p, opts.surface_tol));
+    let margin = (0..3)
+        .map(|k| (p[k] - bbox[k]).min(bbox[k + 3] - p[k]))
+        .fold(f64::INFINITY, f64::min);
+    let _numerical = NumericalGuard::new();
+    let mut old_points = PointTable::new();
+    let old = legacy(|| sample_in_cell_arc(c, span[0], span[1], &bbox, &mut old_points, &f, &opts));
+    let old_failures = numerical_failures();
+    restore_numerical_failures(Default::default());
+    let mut points = PointTable::new();
+    let actual = sample_in_cell_arc(c, span[0], span[1], &bbox, &mut points, &f, &opts);
+    let new_failures = numerical_failures();
+    let report = json!({"scope":"actual full-source local sampler replay only; fresh same fingerprint/checked queries; no full graph or component acceptance",
+        "componentReceiptSha256":w["componentReceiptSha256"],"cell":w["cell"],"sourceCurve":id,"sourcePair":c.adjacent_strata,"spanHex":span.map(bits),"cellBoxHex":bbox.map(bits),
+        "sourceFingerprint":f.fingerprint().to_string(),"transitionPointHex":p.map(bits),"strictInsideMargin":margin,"ordinaryOwnership":owned,"qualifiedClosure":qualified,
+        "legacyReturnedSome":old.is_some(),"correctedReturnedSome":actual.is_some(),"legacyPointCount":old_points.count(),"correctedPointCount":points.count(),
+        "legacyFailures":{"curve":old_failures.curve_projection,"chord":old_failures.chord_budget},"correctedFailures":{"curve":new_failures.curve_projection,"chord":new_failures.chord_budget},
+        "actualParametersHex":actual.as_ref().map(|a|a.parameters.iter().copied().map(bits).collect::<Vec<_>>()),"wholeComponentAccepted":false});
+    std::fs::write(
+        std::env::var("SFCC_UPPER_CELL_RECEIPT").expect("root receipt"),
+        serde_json::to_vec_pretty(&report).unwrap(),
+    )
+    .unwrap();
+    assert!(owned.into_iter().all(|x| !x));
+    assert!(qualified.into_iter().all(|x| x));
+    assert!(margin > 0.);
+    assert!(old.is_none());
+    let actual = actual.expect("proved closure must survive actual cell sampler");
+    assert_eq!(
+        actual.parameters.first().unwrap().to_bits(),
+        span[0].to_bits()
+    );
+    assert_eq!(
+        actual.parameters.last().unwrap().to_bits(),
+        span[1].to_bits()
+    );
+    assert_eq!(new_failures, Default::default());
+    // These are the only private feature-view edits; the sampler reads neither index nor incidence.
+    let incoming = crate::sfcc::stage4_source_preflight_c::selected_pair_c(&f).unwrap();
+    let mut view = f.clone();
+    view.index.omit_private_curve(incoming[1]);
+    for corner in &mut view.corners {
+        if corner.curve_ends.iter().any(|&(id, _)| id == incoming[0]) {
+            corner.curve_ends.retain(|&(id, _)| id != incoming[1]);
+        }
+    }
+    let mut private_points = PointTable::new();
+    let private = sample_in_cell_arc(
+        &view.curves[id],
+        span[0],
+        span[1],
+        &bbox,
+        &mut private_points,
+        &view,
+        &options(&view, &w),
+    )
+    .unwrap();
+    assert_eq!(
+        actual
+            .parameters
+            .iter()
+            .map(|t| t.to_bits())
+            .collect::<Vec<_>>(),
+        private
+            .parameters
+            .iter()
+            .map(|t| t.to_bits())
+            .collect::<Vec<_>>()
+    );
+    assert_eq!(points.count(), private_points.count());
+    for i in 0..points.count() {
+        assert_eq!(
+            [points.x(i), points.y(i), points.z(i)].map(f64::to_bits),
+            [
+                private_points.x(i),
+                private_points.y(i),
+                private_points.z(i)
+            ]
+            .map(f64::to_bits)
+        );
+    }
+
+    // All sample/quarter checks in this narrow band require qualified membership at their own t.
+    let narrow = span[1] / 128.;
+    let endpoint = c.point_at_checked(narrow).unwrap();
+    assert!(c
+        .adjacent_strata
+        .iter()
+        .all(|&sid| !f.strata[sid].domain_contains(endpoint, opts.surface_tol)));
+    assert!(sample_in_cell_arc(c, 0., narrow, &bbox, &mut PointTable::new(), &f, &opts).is_some());
+    let reversed = sample_in_cell_arc(
+        c,
+        span[1],
+        span[0],
+        &bbox,
+        &mut PointTable::new(),
+        &f,
+        &opts,
+    )
+    .unwrap();
+    assert_eq!(
+        reversed.parameters.first().unwrap().to_bits(),
+        span[1].to_bits()
+    );
+    assert_eq!(
+        reversed.parameters.last().unwrap().to_bits(),
+        span[0].to_bits()
+    );
+}
+#[test]
+fn upper_cell_unsupported_bad_query_source_and_budget_still_refuse() {
+    let (f, w, id) = fixture();
+    let c = &f.curves[id];
+    let opts = options(&f, &w);
+    let span: [f64; 2] = std::array::from_fn(|k| number(&w["spanHex"][k]));
+    let bbox: [f64; 6] = std::array::from_fn(|k| number(&w["cellBoxHex"][k]));
+    let _scope = NumericalGuard::new();
+    let mut corrupted = c.clone();
+    corrupted.corrupt_upper_query_for_test();
+    assert!(sample_in_cell_arc(
+        &corrupted,
+        span[0],
+        span[1],
+        &bbox,
+        &mut PointTable::new(),
+        &f,
+        &opts
+    )
+    .is_none());
+    assert!(numerical_failures().curve_projection > 0);
+    restore_numerical_failures(Default::default());
+    let mut wrong = f.clone();
+    wrong.strata[c.adjacent_strata[0]].sign = -1.;
+    assert!(sample_in_cell_arc(
+        c,
+        span[0],
+        span[1],
+        &bbox,
+        &mut PointTable::new(),
+        &wrong,
+        &options(&wrong, &w)
+    )
+    .is_none());
+    let no_budget = CellMeshOptions {
+        max_polyline_points_per_cell: 0,
+        ..opts
+    };
+    assert!(sample_in_cell_arc(
+        c,
+        span[0],
+        span[1],
+        &bbox,
+        &mut PointTable::new(),
+        &f,
+        &no_budget
+    )
+    .is_none());
+    assert!(numerical_failures().chord_budget > 0);
+    let (sa, sb, refine) = c.traced_carriers().unwrap();
+    let mut samples = Vec::new();
+    samples.extend_from_slice(&c.point_at_checked(span[0]).unwrap());
+    samples.extend_from_slice(&c.point_at_checked(span[1]).unwrap());
+    let unsupported = super::super::feature_curves::make_traced_curve(
+        id,
+        c.adjacent_strata,
+        samples,
+        false,
+        sa,
+        sb,
+        refine,
+        c.owner_node_id,
+    );
+    assert!(
+        sample_in_cell_arc(
+            &unsupported,
+            0.,
+            1.,
+            &bbox,
+            &mut PointTable::new(),
+            &f,
+            &opts
+        )
+        .is_none(),
+        "no certificate is not permission to bypass ownership"
+    );
+    let away = [
+        bbox[0] + 100.,
+        bbox[1] + 100.,
+        bbox[2] + 100.,
+        bbox[3] + 100.,
+        bbox[4] + 100.,
+        bbox[5] + 100.,
+    ];
+    assert!(sample_in_cell_arc(
+        c,
+        span[0],
+        span[1],
+        &away,
+        &mut PointTable::new(),
+        &f,
+        &opts
+    )
+    .is_none());
+    let _ = std::panic::catch_unwind(|| legacy(|| panic!("scope control")));
+    assert!(upper_cell_closure_enabled());
+}
