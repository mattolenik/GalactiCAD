// Dieselpunk Battle Mech
// A hulking war machine bristling with weapons and pipes


// === TORSO - THE CORE ===
// Main chest housing with layered armor
let chestCore = box([26, 32, 24]).shift([0, 0, 40])
let chestBulge = sphere.radius(19).shift([0, 0, 44])
let chestArmor1 = box([20, 28, 18]).shift([0, 0, 46])
let chestArmor2 = sphere.radius(16).shift([0, 0, 48])
let chest = union(chestCore, chestBulge, chestArmor1, chestArmor2).round(5)

// Chest panel cutouts using subtract
let chestCutout1 = box([12, 20, 16]).shift([8, 0, 42])
let chestCutout2 = box([12, 20, 16]).shift([-8, 0, 42])
let chestWithCutouts = subtract(chest, chestCutout1, chestCutout2).round(1).round(1)

// Armored collar with multiple layers
let collarR = sphere.radius(9).shift([0, 18, 54])
let collarL = sphere.radius(9).shift([0, -18, 54])
let collarFront = sphere.radius(8).shift([12, 0, 54])
let collarBack = sphere.radius(7).shift([-8, 0, 54])
let collarTop = sphere.radius(6).shift([0, 0, 58])
let collar = union(collarR, collarL, collarFront, collarBack, collarTop).round(3)

// Reactor exhaust vents on back - more detailed
let ventR = sphere.radius(6).shift([-16, 12, 50])
let ventL = sphere.radius(6).shift([-16, -12, 50])
let ventTop = sphere.radius(7).shift([-16, 0, 54])
let ventMid = sphere.radius(4).shift([-16, 6, 52])
let ventMid2 = sphere.radius(4).shift([-16, -6, 52])
let vents = union(ventR, ventL, ventTop, ventMid, ventMid2).round(2)

// Vent cutouts for detail
let ventCutoutR = box([6, 3, 3]).shift([-20, 12, 50])
let ventCutoutL = box([6, 3, 3]).shift([-20, -12, 50])
let ventCutoutTop = box([6, 3, 3]).shift([-20, 0, 54])
let ventsWithCutouts = subtract(vents, ventCutoutR, ventCutoutL, ventCutoutTop).round(0.5).round(0.5)

// === HEAD - COCKPIT POD ===
let headCore = sphere.radius(11).shift([5, 0, 64])
let headBack = sphere.radius(9).shift([-2, 0, 64])
let visor = box([7, 16, 5]).shift([12, 0, 62])
let visorFrame = box([8, 18, 6]).shift([12, 0, 62])
let headCrest = sphere.radius(6).shift([0, 0, 74])
let headCrestBase = box([4, 4, 8]).shift([0, 0, 70])
let antenna1 = sphere.radius(2.5).shift([-5, 9, 72])
let antenna2 = sphere.radius(2.5).shift([-5, -9, 72])
let antennaBase1 = box([2, 2, 6]).shift([-5, 9, 68])
let antennaBase2 = box([2, 2, 6]).shift([-5, -9, 68])
let head = union(headCore, headBack, visorFrame, visor, headCrestBase, headCrest, antennaBase1, antennaBase2, antenna1, antenna2).round(4)

// === SHOULDERS - WEAPON MOUNTS ===
// Right shoulder pod - enhanced
let shoulderR = sphere.radius(13).shift([0, 28, 52])
let shoulderPadR = box([12, 10, 12]).shift([0, 32, 54])
let shoulderPadR2 = sphere.radius(6).shift([0, 35, 54])
let rocketPodR = box([10, 8, 16]).shift([0, 38, 56])
let rocketPodR2 = box([8, 6, 12]).shift([0, 40, 58])
let rocketTipR = sphere.radius(3).shift([0, 42, 64])
let rightShoulder = union(shoulderR, shoulderPadR, shoulderPadR2, rocketPodR, rocketPodR2, rocketTipR).round(4)

// Left shoulder pod - enhanced
let shoulderL = sphere.radius(13).shift([0, -28, 52])
let shoulderPadL = box([12, 10, 12]).shift([0, -32, 54])
let shoulderPadL2 = sphere.radius(6).shift([0, -35, 54])
let rocketPodL = box([10, 8, 16]).shift([0, -38, 56])
let rocketPodL2 = box([8, 6, 12]).shift([0, -40, 58])
let rocketTipL = sphere.radius(3).shift([0, -42, 64])
let leftShoulder = union(shoulderL, shoulderPadL, shoulderPadL2, rocketPodL, rocketPodL2, rocketTipL).round(4)

// === RIGHT ARM - GATLING GUN ===
let upperArmR = box([10, 10, 18]).shift([0, 34, 40])
let upperArmR2 = sphere.radius(7).shift([0, 34, 40])
let elbowR = sphere.radius(7).shift([0, 36, 30])
let elbowGuardR = box([6, 4, 8]).shift([0, 38, 30])
let forearmR = box([7, 7, 16]).shift([5, 36, 20])
let forearmR2 = sphere.radius(5).shift([5, 36, 20])
let gatlingHousing = sphere.radius(8).shift([10, 36, 10])
let gatlingHousing2 = box([12, 6, 6]).shift([10, 36, 10])
let gatlingBarrel = box([20, 5, 5]).shift([22, 36, 10])
let gatlingBarrel2 = box([8, 3, 3]).shift([32, 36, 10])
let gatlingTip = sphere.radius(2.5).shift([38, 36, 10])
let rightArm = union(upperArmR, upperArmR2, elbowR, elbowGuardR, forearmR, forearmR2, gatlingHousing, gatlingHousing2, gatlingBarrel, gatlingBarrel2, gatlingTip).round(3)

// === LEFT ARM - CLAW ===
let upperArmL = box([10, 10, 18]).shift([0, -34, 40])
let upperArmL2 = sphere.radius(7).shift([0, -34, 40])
let elbowL = sphere.radius(7).shift([0, -36, 30])
let elbowGuardL = box([6, 4, 8]).shift([0, -38, 30])
let forearmL = box([7, 7, 16]).shift([5, -36, 20])
let forearmL2 = sphere.radius(5).shift([5, -36, 20])
let clawBase = sphere.radius(7).shift([10, -36, 10])
let clawBase2 = box([8, 6, 6]).shift([10, -36, 10])
// Enhanced claw with more fingers
let clawTop = sphere.radius(5).shift([18, -32, 8])
let clawMid = sphere.radius(5).shift([18, -36, 8])
let clawBot = sphere.radius(5).shift([18, -40, 8])
let clawTip1 = sphere.radius(3).shift([24, -30, 6])
let clawTip2 = sphere.radius(3).shift([24, -36, 6])
let clawTip3 = sphere.radius(3).shift([24, -42, 6])
let leftArm = union(upperArmL, upperArmL2, elbowL, elbowGuardL, forearmL, forearmL2, clawBase, clawBase2, clawTop, clawMid, clawBot, clawTip1, clawTip2, clawTip3).round(3)

// === HIP ASSEMBLY ===
let hipCore = box([20, 28, 12]).shift([0, 0, 26])
let hipBulge = sphere.radius(15).shift([0, 0, 26])
let hipCore2 = box([18, 26, 10]).shift([0, 0, 28])
let hips = union(hipCore, hipBulge, hipCore2).round(4)

// Hip armor plates - more detailed
let hipPlateR = sphere.radius(8).shift([8, 20, 26])
let hipPlateR2 = box([6, 4, 8]).shift([8, 22, 26])
let hipPlateL = sphere.radius(8).shift([8, -20, 26])
let hipPlateL2 = box([6, 4, 8]).shift([8, -22, 26])
let hipPlates = union(hipPlateR, hipPlateR2, hipPlateL, hipPlateL2).round(2)

// === LEGS - DIGITIGRADE STYLE ===
// Right leg - enhanced
let thighR = box([10, 10, 16]).shift([0, 16, 16])
let thighR2 = sphere.radius(7).shift([0, 16, 16])
let kneeR = sphere.radius(7).shift([5, 16, 8])
let kneeGuardR = box([6, 4, 10]).shift([5, 18, 8])
let shinR = box([7, 7, 18]).shift([10, 16, -2])
let shinR2 = sphere.radius(5).shift([10, 16, -2])
let ankleR = sphere.radius(6).shift([8, 16, -16])
let footR = box([14, 10, 5]).shift([12, 16, -20])
let footR2 = sphere.radius(6).shift([12, 16, -20])
let toeR = sphere.radius(5).shift([22, 16, -20])
let toeR2 = sphere.radius(4).shift([26, 16, -20])
let rightLeg = union(thighR, thighR2, kneeR, kneeGuardR, shinR, shinR2, ankleR, footR, footR2, toeR, toeR2).round(3)

// Left leg - enhanced
let thighL = box([10, 10, 16]).shift([0, -16, 16])
let thighL2 = sphere.radius(7).shift([0, -16, 16])
let kneeL = sphere.radius(7).shift([5, -16, 8])
let kneeGuardL = box([6, 4, 10]).shift([5, -18, 8])
let shinL = box([7, 7, 18]).shift([10, -16, -2])
let shinL2 = sphere.radius(5).shift([10, -16, -2])
let ankleL = sphere.radius(6).shift([8, -16, -16])
let footL = box([14, 10, 5]).shift([12, -16, -20])
let footL2 = sphere.radius(6).shift([12, -16, -20])
let toeL = sphere.radius(5).shift([22, -16, -20])
let toeL2 = sphere.radius(4).shift([26, -16, -20])
let leftLeg = union(thighL, thighL2, kneeL, kneeGuardL, shinL, shinL2, ankleL, footL, footL2, toeL, toeL2).round(3)

// === BACK MOUNTED SYSTEMS ===
// Reactor core - enhanced
let reactor = sphere.radius(11).shift([-18, 0, 44])
let reactorCasing = box([10, 16, 16]).shift([-20, 0, 44])
let reactorCasing2 = sphere.radius(9).shift([-18, 0, 44])
let reactorUnit = union(reactor, reactorCasing, reactorCasing2).round(4)

// Reactor cutouts for detail
let reactorCutout1 = box([4, 8, 8]).shift([-24, 0, 44])
let reactorCutout2 = box([4, 4, 12]).shift([-24, 0, 44])
let reactorWithCutouts = subtract(reactorUnit, reactorCutout1, reactorCutout2).round(1).round(1)

// Smoke stacks - enhanced
let stack1 = box([5, 5, 18]).shift([-22, 10, 58])
let stackTop1 = sphere.radius(5).shift([-22, 10, 70])
let stack1Mid = sphere.radius(4).shift([-22, 10, 64])
let stack2 = box([5, 5, 18]).shift([-22, -10, 58])
let stackTop2 = sphere.radius(5).shift([-22, -10, 70])
let stack2Mid = sphere.radius(4).shift([-22, -10, 64])
let stack3 = box([5, 5, 18]).shift([-22, 0, 58])
let stackTop3 = sphere.radius(5).shift([-22, 0, 70])
let stacks = union(stack1, stackTop1, stack1Mid, stack2, stackTop2, stack2Mid, stack3, stackTop3).round(2)

// Fuel tanks - enhanced
let tankR = sphere.radius(7).shift([-14, 22, 40])
let tankR2 = box([8, 4, 12]).shift([-14, 24, 40])
let tankL = sphere.radius(7).shift([-14, -22, 40])
let tankL2 = box([8, 4, 12]).shift([-14, -24, 40])
let tanks = union(tankR, tankR2, tankL, tankL2).round(2)

// === DECORATIVE RIVETS & DETAILS ===
// More rivets for detail
let rivet1 = sphere.radius(2).shift([16, 14, 46])
let rivet2 = sphere.radius(2).shift([16, -14, 46])
let rivet3 = sphere.radius(2).shift([16, 0, 52])
let rivet4 = sphere.radius(1.5).shift([14, 10, 38])
let rivet5 = sphere.radius(1.5).shift([14, -10, 38])
let rivet6 = sphere.radius(1.5).shift([12, 18, 44])
let rivet7 = sphere.radius(1.5).shift([12, -18, 44])
let rivet8 = sphere.radius(1.5).shift([10, 22, 40])
let rivet9 = sphere.radius(1.5).shift([10, -22, 40])
let rivet10 = sphere.radius(1.5).shift([-10, 14, 48])
let rivet11 = sphere.radius(1.5).shift([-10, -14, 48])
let rivets = union(rivet1, rivet2, rivet3, rivet4, rivet5, rivet6, rivet7, rivet8, rivet9, rivet10, rivet11)

// Chest searchlight - enhanced
let searchlight = sphere.radius(5).shift([18, 0, 44])
let searchlightFrame = box([6, 6, 6]).shift([18, 0, 44])
let searchlightUnit = union(searchlightFrame, searchlight).round(2)

// Side armor plates
let sidePlateR = box([4, 6, 12]).shift([6, 24, 42])
let sidePlateL = box([4, 6, 12]).shift([6, -24, 42])
let sidePlates = union(sidePlateR, sidePlateL)

// === ASSEMBLY ===
// Upper body
let torso = union(chestWithCutouts, collar, ventsWithCutouts, head).round(4)
let arms = union(rightShoulder, leftShoulder, rightArm, leftArm).round(2)
let upperBody = union(torso, arms).round(3)

// Lower body
let lowerBody = union(hips, hipPlates, rightLeg, leftLeg).round(3)

// Back systems
let backpack = union(reactorWithCutouts, stacks, tanks).round(3)

// Details
let details = union(rivets, searchlightUnit, sidePlates).round(1)

// Final mech
return union(upperBody, lowerBody, backpack, details).round(4)
