+fn id(c: &SfccCell) -> [i64; 4] {
+    [c.level as i64, c.ix, c.iy, c.iz]
+}
+fn image_bits(p: ([f64; 3], [f64; 3])) -> [[u64; 3]; 2] {
+    [p.0.map(f64::to_bits), p.1.map(f64::to_bits)]
+}
