+    let mut changed = BTreeSet::new();
+    let mut affected_points = BTreeSet::new();
+    let mut pin_count = 0;
+    for axis in 0..3 {
+        for (&key, r) in &faces[axis] {
+            for pin in &r.pins {
+                if ids.contains(&pin.curve_id) {
+                    pin_count += 1;
+                    if pin_count > 1024 {
+                        return Err("typed_pin_cap");
+                    }
+                    changed.insert((axis, key, r.len));
+                    affected_points.insert(pin.point_id);
+                }
+            }
+        }
+    }
+    for axis in 0..3 {
+        for (&key, r) in &faces[axis] {
+            if r.pins.iter().any(|p| affected_points.contains(&p.point_id))
+                || r.segments
+                    .iter()
+                    .any(|s| affected_points.contains(&s.a) || affected_points.contains(&s.b))
