+//! Discriminators for reusing a fixed-boundary affine projected correspondence on the full face contour.
+use super::*;
+use crate::sfcc::pipeline::{build_pipeline_context, PipelineTuning, SfccWorldCube};
+use std::collections::BTreeMap;
+
+type Point = [f64; 3];
+
+fn positive_separation(retained: f64, ideal: I) -> Option<I> {
+    if !retained.is_finite() || !ideal.lo.is_finite() || !ideal.hi.is_finite() || ideal.lo > ideal.hi {
+        return None;
+    }
+    let difference = I::point(retained).sub(ideal)?;
+    (difference.lo > 0.).then_some(difference)
+}
+
+// For z(Y)=sqrt((aY+b)^2-c^2), z''=-a^2*c^2/(rho^2-c^2)^(3/2).
+fn strict_chamfer_concavity(ny: I, one_minus_nr: I, c: I, rho: I) -> Option<I> {
+    if ny.lo <= 0. || one_minus_nr.lo <= 0. || rho.lo <= 0. || (c.lo <= 0. && c.hi >= 0.) {
+        return None;
+    }
+    let a = quotient(ny, one_minus_nr)?;
+    let z2 = square(rho)?.sub(square(c)?)?;
+    if z2.lo <= 0. { return None; }
+    let magnitude = quotient(mul(square(a)?, square(c)?)?, mul(z2, sqrt(z2)?)?)?;
+    if magnitude.lo <= 0. || !magnitude.hi.is_finite() { return None; }
+    magnitude.mul(-1.)
+}
+
