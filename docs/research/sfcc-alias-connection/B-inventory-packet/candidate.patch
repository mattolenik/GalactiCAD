+pub(crate) fn inspect(
+    f: &SfccFeatureSet,
+    oct: &SfccOctree,
+    faces: &[HashMap<i64, FaceRecord>; 3],
+    live: &PointTable,
+) -> Result<Value, &'static str> {
+    let (source, common, pair) = select(f).ok_or("secondary_source_selection")?;
+    let primary = crate::sfcc::stage4_source_preflight_c::selected_pair_c(f)
+        .map_err(|_| "primary_selection")?;
+    let branch = HelixBranch::identify(
+        f,
+        primary[0],
+        primary[1],
+        f.curves[primary[0]]
+            .projection_tube(0., 1.)
+            .ok_or("primary_tube")?,
+    )
+    .ok_or("primary_source")?;
+    let physical = *primary
+        .iter()
+        .find(|&&id| f.curves[id].adjacent_strata.contains(&branch.native))
+        .ok_or("primary_physical")?;
+    let alias = *primary
+        .iter()
+        .find(|&&id| id != physical)
+        .ok_or("primary_alias")?;
+    let mut old_changed = BTreeSet::new();
+    let mut old_alias_points = BTreeSet::new();
+    let mut secondary = BTreeSet::new();
+    let mut secondary_points = BTreeSet::new();
+    let mut rows = Vec::new();
+    let mut parameters: [Vec<f64>; 2] = [vec![], vec![]];
+    for axis in 0..3 {
+        let mut keys: Vec<_> = faces[axis].keys().copied().collect();
+        keys.sort_unstable();
+        for key in keys {
+            let r = &faces[axis][&key];
+            let id = (axis, key, r.len);
+            if r.pins.iter().any(|p| primary.contains(&p.curve_id)) {
+                old_changed.insert(id);
+                old_alias_points.extend(
+                    r.pins
+                        .iter()
+                        .filter(|p| p.curve_id == alias)
+                        .map(|p| p.point_id),
+                );
+            }
+            let pins: Vec<_> = r
+                .pins
+                .iter()
+                .filter(|p| pair.contains(&p.curve_id))
+                .collect();
+            if pins.is_empty() {
+                continue;
+            }
+            if rows.len() >= 1536 {
+                return Err("secondary_face_cap");
+            }
+            let rect = rectangle(&oct.lat, axis, key, r)?;
+            secondary.insert(id);
+            secondary_points.extend(pins.iter().map(|p| p.point_id));
+            for p in &pins {
+                if p.point_id >= live.count() {
+                    return Err("secondary_point_binding");
+                }
+                parameters[usize::from(p.curve_id == pair[1])].push(p.t);
+            }
+            let p_rows:Vec<_>=pins.iter().map(|p|json!({"chart":p.curve_id,"point":p.point_id,"parameterBits":p.t.to_bits(),"positionBits":q::pos(live,p.point_id).map(f64::to_bits),"key":format!("{:?}",live.key_at(p.point_id))})).collect();
+            rows.push(json!({"face":id,"rectangleBits":rect.map(|p|p.map(f64::to_bits)),"allPins":r.pins.iter().map(|p|json!({"chart":p.curve_id,"point":p.point_id,"parameterBits":p.t.to_bits()})).collect::<Vec<_>>(),"targetPins":p_rows,"segments":r.segments.iter().map(|s|[s.a,s.b]).collect::<Vec<_>>(),"consumedForward":r.consumed_fwd,"consumedReverse":r.consumed_rev}));
+        }
+    }
+    let mut indirect = BTreeSet::new();
+    for axis in 0..3 {
+        for (&key, r) in &faces[axis] {
+            if r.segments
+                .iter()
+                .any(|s| old_alias_points.contains(&s.a) || old_alias_points.contains(&s.b))
+                || r.pins
+                    .iter()
+                    .any(|p| old_alias_points.contains(&p.point_id))
+            {
+                old_changed.insert((axis, key, r.len));
+            }
+            if r.segments
+                .iter()
+                .any(|s| secondary_points.contains(&s.a) || secondary_points.contains(&s.b))
+                || r.pins
+                    .iter()
+                    .any(|p| secondary_points.contains(&p.point_id))
+            {
+                indirect.insert((axis, key, r.len));
+            }
+        }
+    }
+    let (old_cells, old_required, _) = consumers(oct, faces, &old_changed)?;
+    let mut combined = old_changed.clone();
+    combined.extend(indirect.iter().copied());
+    let (combined_cells, combined_required, users) = consumers(oct, faces, &combined)?;
+    for row in &mut rows {
+        let v = &row["face"];
+        let id = (
+            v[0].as_u64().unwrap() as usize,
+            v[1].as_i64().unwrap(),
+            v[2].as_i64().unwrap(),
+        );
+        row["consumers"] = json!(users.get(&id));
+        row["inOldRequired"] = json!(old_required.contains(&id));
+    }
+    for ts in &mut parameters {
+        ts.sort_by(f64::total_cmp);
+        ts.dedup_by(|a, b| a.to_bits() == b.to_bits());
+    }
+    let report = json!({"scope":"read-only source-family candidate/typed-record/consumer inventory; no query, root certificate, equivalence or mutation authority","featureFingerprint":f.fingerprint().to_string(),"sourceRoles":source,"common":common,"pair":pair,
+        "lattice":{"depth":oct.lat.max_depth,"res":oct.lat.res,"span":oct.lat.span,"origin":[oct.lat.origin_x,oct.lat.origin_y,oct.lat.origin_z],"size":oct.lat.world_size,"step":oct.lat.step},
+        "curves":pair.map(|id|{let c=&f.curves[id];json!({"id":id,"strata":c.adjacent_strata,"rangeBits":[c.t_min.to_bits(),c.t_max.to_bits()],"corners":[c.corner_start,c.corner_end],"indexPointBits":c.index_polyline.iter().map(|v|v.to_bits()).collect::<Vec<_>>()})}),
+        "actualPinParametersBits":parameters.map(|ts|ts.into_iter().map(f64::to_bits).collect::<Vec<_>>()),"faces":rows,"directSecondaryFaces":secondary,"allSecondaryPointUserFaces":indirect,
+        "oldSelection":{"cells":old_cells,"requiredFaces":old_required},"combinedSelection":{"cells":combined_cells,"requiredFaces":combined_required,"newCells":combined_cells.difference(&old_cells).copied().collect::<Vec<_>>()},
+        "withinUnchangedCellFaceCaps":combined_cells.len()<=256&&combined_required.len()<=1536,"newCurveQueries":0,"quotientPrepared":false});
+    if serde_json::to_vec(&report)
+        .map_err(|_| "inventory_serialization")?
+        .len()
+        > 512 * 1024
+    {
+        return Err("inventory_512KiB_cap");
+    }
+    Ok(report)
+}
+
+#[test]
+fn alias_b_typed_rectangle_rejects_wrong_slot_and_extent() {
+    let lat = crate::math::grid::make_lattice(3, -2., -3., -4., 8.);
+    let key = pack_point(&lat, 2, 3, 4);
+    let mut r = FaceRecord {
+        axis: 1,
+        key,
+        len: 1,
+        segments: vec![],
+        pins: vec![],
+        interior_cycle: false,
+        consumed_fwd: vec![],
+        consumed_rev: vec![],
+    };
+    assert_eq!(
+        rectangle(&lat, 1, key, &r).unwrap(),
+        [[0., 0., 0.], [1., 0., 1.]]
+    );
+    assert_eq!(rectangle(&lat, 0, key, &r), Err("typed_face_identity"));
+    r.len = 8;
+    assert_eq!(rectangle(&lat, 1, key, &r), Err("typed_face_domain"));
+    r.len = 0;
+    assert_eq!(rectangle(&lat, 1, key, &r), Err("typed_face_identity"));
+}
+#[test]
+fn alias_b_source_pair_uses_original_occurrences() {
+    let v: Value =
+        serde_json::from_str(include_str!("../../fixtures/shared-arc-full-knob.json")).unwrap();
+    let tree =
+        crate::scene_bridge::build_csg_tree_from_json(v["sceneJson"].as_str().unwrap()).unwrap();
+    let size = v["cube"]["max"][0].as_f64().unwrap() - v["cube"]["min"][0].as_f64().unwrap();
+    let tol = crate::tolerances::resolve_tolerances(
+        &crate::tuning::SfccTuning::default(),
+        size * 3_f64.sqrt(),
+    );
+    let (f, _) = crate::sfcc::feature_set::compile_feature_set(&tree, &tol);
+    let (source, common, ids) = select(&f).unwrap();
+    assert_ne!(ids[0], ids[1]);
+    assert_eq!(f.curves[ids[0]].adjacent_strata, [common, source[0]]);
+    assert_eq!(f.curves[ids[1]].adjacent_strata, [common, source[1]]);
+    assert_eq!(f.curves[ids[0]].corner_start, f.curves[ids[1]].corner_start);
+}
