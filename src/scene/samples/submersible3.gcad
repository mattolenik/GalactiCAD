// Deep-Sea "Experience" Submersible — Final Form
// The Abyss-Class Titan II: Founder's Edition
// "We've addressed all the criticism by making it bigger and adding a hot tub"
// Now with EVEN LESS engineering oversight


// ═══ PRESSURE HULL ═══
// Still a cylinder. Still carbon fibre. But now WIDER
// to fit the wet bar and the DJ booth.
// A whistleblower tried to report the hull to the coast guard
// but was silenced with an NDA and a gift bag.
let hull = box({ pos: [0, 0, 0], size: [12, 12, 22] })
let hullRound = sphere({ pos: [0, 0, 0], r: 28 })
let pressureHull = intersect({ r: 3 }, hull, hullRound)

// Endcaps now held on with construction adhesive
// "It's the same stuff they use on the space shuttle" (it is not)
let endcapTop = sphere({ pos: [0, 0, 20], r: 12 })
let endcapBot = sphere({ pos: [0, 0, -20], r: 12 })
let tube = union({ r: 2 }, pressureHull, endcapTop, endcapBot)

// ═══ VIEWPORT ═══
// Upgraded from one shower door to TWO shower doors
// "Redundancy!" says the billionaire. "That's engineering!"
let vpR = sphere({ pos: [14, 4, 0], r: 5 })
let vpL = sphere({ pos: [14, -4, 0], r: 5 })

// ═══ "FAIRING" ═══
// The intern was promoted to Chief Naval Architect
// He added more flat panels. They are thicker now. "Stronger."
let panelF = box({ pos: [10, 0, 0], size: [3, 14, 18] })
let panelR = box({ pos: [0, 10, 0], size: [14, 3, 18] })
let panelL = box({ pos: [0, -10, 0], size: [14, 3, 18] })
let panelB = box({ pos: [-10, 0, 0], size: [3, 14, 18] })
let fairing = union({ r: 1 }, panelF, panelR, panelL, panelB)

let bodyRaw = union({ r: 2 }, tube, fairing, vpR, vpL)

// ═══ BALLAST "SYSTEM" ═══
// The sandbags are back. Now there are more of them.
// Someone suggested "maybe use actual ballast tanks" and was fired.
let sb1 = sphere({ pos: [0, 12, -14], r: 4 })
let sb2 = sphere({ pos: [0, -12, -14], r: 4 })
let sb3 = sphere({ pos: [0, 12, 14], r: 3.5 })
let sb4 = sphere({ pos: [0, -12, 14], r: 3.5 })
let sb5 = sphere({ pos: [0, 12, 0], r: 3 })
let sb6 = sphere({ pos: [0, -12, 0], r: 3 })
let sb7 = sphere({ pos: [0, 12, 7], r: 3 })
let sb8 = sphere({ pos: [0, -12, 7], r: 3 })
let sb9 = sphere({ pos: [0, 12, -7], r: 3 })
let sb10 = sphere({ pos: [0, -12, -7], r: 3 })
let ballast = union(sb1, sb2, sb3, sb4, sb5, sb6, sb7, sb8, sb9, sb10)

// ═══ PROPULSION ═══
// Two jet ski thrusters now. Both mounted off-centre.
// One points slightly up. The other slightly down.
// "They'll average out" — actual quote from the design review
let thruster1 = sphere({ pos: [-12, 5, -14], r: 4 })
let thruster1Mount = box({ pos: [-10, 5, -14], size: [4, 3, 3] })
let thruster2 = sphere({ pos: [-12, -6, -10], r: 4 })
let thruster2Mount = box({ pos: [-10, -6, -10], size: [4, 3, 3] })
let propulsion = union({ r: 1 }, thruster1, thruster1Mount, thruster2, thruster2Mount)

// ═══ LIFE SUPPORT ═══
// Still camping tanks. Fewer of them now because two fell off
// during the last test dive and nobody replaced them.
// "We'll just breathe slower"
let tank1 = sphere({ pos: [5, 5, 22], r: 2.5 })
let tank2 = sphere({ pos: [-5, -5, 22], r: 2.5 })
let tanks = union(tank1, tank2)

// ═══ LUXURY OBSERVATION DOME ═══
// Even bigger now. Double height. Zero engineering.
// "The guests need to see the bioluminescence"
let loungeDome = sphere({ pos: [0, 0, 26], r: 12 })
let loungeFloor = plane({ pos: [0, 0, 20], n: [0, 0, 1] })
let lounge = subtract(loungeDome, loungeFloor)

// ═══ HOT TUB ═══
// Yes. A hot tub. On a deep-sea submersible.
// Mounted externally on the top because it "didn't fit inside."
// Filled with seawater at depth. "It's a feature."
let tubOuter = sphere({ pos: [0, 0, 36], r: 7 })
let tubInner = sphere({ pos: [0, 0, 38], r: 6 })
let tubFloor = plane({ pos: [0, 0, 34], n: [0, 0, 1] })
let hotTub = subtract(subtract(tubOuter, tubInner), tubFloor)

// ═══ COMMUNICATIONS ═══
// Starlink dish is back, now flanked by two more dishes
// "Mesh networking!" (they are not networked)
let dish1 = sphere({ pos: [0, 0, 42], r: 4 })
let dish1Cut = sphere({ pos: [0, 0, 45], r: 4 })
let dishMain = subtract(dish1, dish1Cut)
let dish2 = sphere({ pos: [5, 0, 40], r: 3 })
let dish2Cut = sphere({ pos: [5, 0, 43], r: 3 })
let dishR = subtract(dish2, dish2Cut)
let dish3 = sphere({ pos: [-5, 0, 40], r: 3 })
let dish3Cut = sphere({ pos: [-5, 0, 43], r: 3 })
let dishL = subtract(dish3, dish3Cut)
let dishMast = box({ pos: [0, 0, 38], size: [1, 1, 6] })
let comms = union({ r: 0.5 }, dishMain, dishR, dishL, dishMast)

// ═══ SPONSORSHIP BILLBOARDS ═══
// Now on BOTH sides. And the back. And the top.
// The billionaire's face is on one of them.
let billboardR = box({ pos: [0, 14, 4], size: [14, 0.5, 10] })
let billboardL = box({ pos: [0, -14, 4], size: [14, 0.5, 10] })
let billboardBack = box({ pos: [-14, 0, 4], size: [0.5, 14, 10] })
let billboardTop = box({ pos: [0, 0, 32], size: [10, 10, 0.5] })
let billboards = union(billboardR, billboardL, billboardBack, billboardTop)

// ═══ "SAFETY" SYSTEM ═══
// The PlayStation controller has been upgraded to a Logitech gamepad
// Found on Amazon for $29.99. "It has more buttons"
// Also: one (1) glow stick
let controller = box({ pos: [8, 0, 22], size: [3, 4, 1] })
let glowStick = box({ pos: [10, 0, 24], size: [0.3, 0.3, 3] })

// ═══ LANDING GEAR ═══
// Upgraded from shopping trolley wheels to go-kart wheels
// Still no suspension. "The ocean floor is flat, right?"
let wheelFR = sphere({ pos: [8, 8, -24], r: 3 })
let wheelFL = sphere({ pos: [8, -8, -24], r: 3 })
let wheelRR = sphere({ pos: [-8, 8, -24], r: 3 })
let wheelRL = sphere({ pos: [-8, -8, -24], r: 3 })
// Bonus: a spare wheel, bolted to the back
let spare = sphere({ pos: [-14, 0, -8], r: 3 })
let wheels = union(wheelFR, wheelFL, wheelRR, wheelRL, spare)
let axleF = box({ pos: [8, 0, -24], size: [1, 9, 1] })
let axleR = box({ pos: [-8, 0, -24], size: [1, 9, 1] })

// ═══ DECORATIVE FINS ═══
// Now FOUR fins because "more fins = more stable"
// The CFD simulation was done in Microsoft Paint
let finR = rotate({ rot: [0, 20, 0] }, box({ pos: [0, 14, -10], size: [8, 1, 10] })
)
let finL = rotate({ rot: [0, -20, 0] }, box({ pos: [0, -14, -10], size: [8, 1, 10] })
)
let finTop = box({ pos: [0, 0, 30], size: [10, 1, 5] })
let finBot = box({ pos: [0, 0, -18], size: [10, 1, 5] })

// ═══ VIP HANDRAIL ═══
// Now gold-plated. $120,000.
// Longer too, so more influencers can pose at once.
let railR = box({ pos: [10, 8, 8], size: [1, 1, 16] })
let railL = box({ pos: [10, -8, 8], size: [1, 1, 16] })
let railTop = box({ pos: [10, 0, 22], size: [1, 9, 1] })
let railBot = box({ pos: [10, 0, -6], size: [1, 9, 1] })
let handrail = union({ r: 0.5 }, railR, railL, railTop, railBot)

// ═══ HELICOPTER PAD ═══
// A flat platform on the very top. For the "emergency helicopter."
// There is no emergency helicopter. There is no helicopter that
// can land on a submerged submarine. But it's in the brochure.
let helipad = box({ pos: [0, 0, 44], size: [12, 12, 0.5] })
let helipadBumper1 = sphere({ pos: [10, 10, 44], r: 1.5 })
let helipadBumper2 = sphere({ pos: [10, -10, 44], r: 1.5 })
let helipadBumper3 = sphere({ pos: [-10, 10, 44], r: 1.5 })
let helipadBumper4 = sphere({ pos: [-10, -10, 44], r: 1.5 })
let helipadAsm = union(helipad, helipadBumper1, helipadBumper2, helipadBumper3, helipadBumper4)

// ═══ ESCAPE POD ═══
// It's a beach ball with a GoPro taped to it.
// "In an emergency, the guest can... float."
let escapePod = sphere({ pos: [-14, 0, 10], r: 4 })
let gopro = box({ pos: [-16, 0, 12], size: [1, 1, 1] })

// ═══ ASSEMBLY ═══
let structure = union({ r: 1 }, bodyRaw, lounge, hotTub, comms, billboards, controller, glowStick)
let externals = union(ballast, propulsion, tanks, handrail)
let landing = union(wheels, axleF, axleR)
let fins = union(finR, finL, finTop, finBot)
let topDeck = union(helipadAsm, escapePod, gopro)

return union({ r: 1 }, structure, externals, landing, fins, topDeck)
