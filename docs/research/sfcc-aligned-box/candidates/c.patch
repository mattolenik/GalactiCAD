+fn construct(scene: &Value, size: f64) -> Result<Plan, Failure> {
+    let tree = build_csg_tree_from_json(&scene.to_string()).unwrap();
+    let cube = SfccWorldCube {
+        min_x: -size / 2.,
+        min_y: -size / 2.,
+        min_z: -size / 2.,
+        size,
+    };
+    let bytes = prepare(&tree, &cube, &PipelineTuning::default());
+    let (lat, cells) = decode_tagged_leaves(&bytes);
+    let plan = Plan::build(&tree, &lat, &cells);
+    if let Ok(p) = &plan {
+        eprintln!(
+            "leaves={} coords={:?} facets={} strata={}",
+            p.cells.len(),
+            p.coordinates.each_ref().map(|v| v.len()),
+            p.facets.len(),
+            p.strata_checked
+        );
+    }
+    plan
