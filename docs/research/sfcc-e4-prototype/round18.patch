+pub(crate) fn quantized_face_root(
+    features: &SfccFeatureSet,
+    a: usize,
+    b: usize,
+    axis: usize,
+    coord: f64,
+    p: [f64; 3],
+    q: [f64; 3],
+) -> bool {
+    if p.map(|v| v as f32) != q.map(|v| v as f32) || p.iter().chain(&q).any(|v| !v.is_finite()) {
+        return false;
+    }
+    let Some((lo, hi)) = rounding_face_box(axis, coord, p) else {
+        return false;
+    };
+    let Some(proof) = certify(features, a, b, lo, hi) else {
+        return false;
+    };
+    if !proof.contains_face_root(axis) {
+        return false;
+    }
+    let Some((_, _, ar)) = features.curves[a].traced_carriers() else {
+        return false;
+    };
+    let Some((_, _, br)) = features.curves[b].traced_carriers() else {
+        return false;
+    };
+    let eps = ar.curve_eps.min(br.curve_eps);
+    if !eps.is_finite() || eps <= 0. {
+        return false;
+    }
+    [a, b].iter().all(|&id| {
+        features.curves[id].adjacent_strata.iter().all(|&sid| {
+            [p, q].iter().all(|&p| {
+                let s = &features.strata[sid];
+                s.domain_contains(p, eps)
+                    && s.raw_field(p[0], p[1], p[2])
+                        .normalized_equation()
+                        .is_some_and(|v| v.value.abs() <= eps)
+            })
+        })
+    })
+}
+
+
+pub(crate) fn rounding_face_box(axis:usize,coord:f64,p:[f64;3]) -> Option<([f64;3],[f64;3])> {
+    if axis >= 3
+        || !coord.is_finite()
+        || p.iter().any(|x| !x.is_finite())
+        || p[axis] as f32 != coord as f32
+    {
+        return None;
+    }
+    let mut lo = [0.; 3];
+    let mut hi = [0.; 3];
+    for k in 0..3 {
+        let x = p[k] as f32;
+        if !x.is_finite() || !x.next_down().is_finite() || !x.next_up().is_finite() {
+            return None;
+        }
+        lo[k] = (x.next_down() as f64 + x as f64) * 0.5;
+        hi[k] = (x.next_up() as f64 + x as f64) * 0.5;
+    }
+    lo[axis] = coord;
+    hi[axis] = coord;
+    Some((lo,hi))
+}
