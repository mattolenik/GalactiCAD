+//! Isolated ROUND0 experiment. No publication or mutation of live inputs.
+use super::{
+    feature_set::SfccFeatureSet,
+    shared_arc_plan::{fail, originals, Event, OriginalChart, Refusal},
+    shared_correlated_gate_c::{self, CorrelatedInventory},
+    shared_twisted_proof::correlated_c::{transport_a::Transport, CheckedEvent},
+};
+use std::cell::RefCell;
+
+#[derive(Debug)]
+#[cfg_attr(feature = "serde", derive(serde::Serialize))]
+pub struct AdmittedArc {
+    pub fingerprint: u64,
+    pub originals: Vec<OriginalChart>,
+    pub physical: usize,
+    pub alias: usize,
+    pub branch_sign: i8,
+    pub events: Vec<Event>,
+    admission: CorrelatedInventory,
+    #[cfg_attr(feature = "serde", serde(skip))]
+    admission_identity: std::rc::Rc<()>,
+}
+impl AdmittedArc {
+    pub(crate) fn admits_transport(&self, transport: &Transport<'_>) -> bool {
+        transport.admission_matches(&self.admission_identity)
+    }
+}
+pub(crate) fn admit<'a>(
+    f: &'a SfccFeatureSet,
+    ids: [usize; 2],
+    tolerance: f64,
+) -> Result<(AdmittedArc, Transport<'a>), Refusal> {
+    if super::cancel::is_cancelled() {
+        return Err(fail(f, ids, "cancelled", "before admission"));
+    }
+    // Endpoint absence is a distinct gate, before any consumer or planner work.
+    let reservation = shared_correlated_gate_c::admission_query_reservation(f, ids)?;
+    let mut transport = Transport::bind(f, ids, tolerance)
+        .map_err(|e| fail(f, ids, "transport_bind", format!("{e:?}")))?;
+    transport
+        .reserve_external(reservation)
+        .map_err(|e| fail(f, ids, "admission_query_budget", format!("{e:?}")))?;
+    let admission = shared_correlated_gate_c::admit(f, ids, tolerance)?;
+    require_admission(f, ids, Some(&admission))?;
+    let mut checked = Vec::new();
+    transport.complete(&mut checked).map_err(|e| {
+        fail(
+            f,
+            ids,
+            "complete_original_transport",
+            format!("{e:?}; accepted prefix {}", checked.len()),
+        )
+    })?;
+    let admission_identity = std::rc::Rc::new(());
+    transport.attach_admission(admission_identity.clone());
+    let [physical, alias] = transport.physical_alias();
+    let events = checked
+        .iter()
+        .map(|e| Event {
+            origin_chart: e[0].chart(),
+            origin_parameter_bits: e[0].parameter().to_bits(),
+            physical_parameter_bits: e[1].parameter().to_bits(),
+            other_parameter_bits: e[2].parameter().to_bits(),
+            position_bits: e[1].point().map(f64::to_bits),
+        })
+        .collect();
+    Ok((
+        AdmittedArc {
+            fingerprint: f.fingerprint(),
+            originals: originals(f, ids),
+            physical,
+            alias,
+            branch_sign: transport.admitted_branch().sign,
+            events,
+            admission,
+            admission_identity,
+        },
+        transport,
+    ))
+}
+fn require_admission(
+    f: &SfccFeatureSet,
+    ids: [usize; 2],
+    admission: Option<&CorrelatedInventory>,
+) -> Result<(), Refusal> {
+    let a = admission.ok_or_else(|| {
+        fail(
+            f,
+            ids,
+            "missing_source_admission",
+            "no successful source/endpoint admission",
+        )
+    })?;
+    if a.refusal.is_some()
+        || a.endpoints.len() != 2
+        || a.original_events.is_empty()
+        || a.pieces.is_empty()
+    {
+        return Err(fail(
+            f,
+            ids,
+            "missing_source_admission",
+            "incomplete source/event/endpoint prefix",
+        ));
+    }
+    Ok(())
+}
+
+pub(crate) fn checked_pair(
+    transport: &mut Transport<'_>,
+    f: &SfccFeatureSet,
+    ids: [usize; 2],
+    chart: usize,
+    t: f64,
+    point: [f64; 3],
+) -> Result<[CheckedEvent; 3], Refusal> {
+    let own = transport.retained(chart, t, point).map_err(|e| {
+        fail(
+            f,
+            ids,
+            "retained_point_own_query",
+            format!(
+                "chart {chart} t {:x} point {:?}: {e:?}",
+                t.to_bits(),
+                point.map(f64::to_bits)
+            ),
+        )
+    })?;
+    let pair = transport.pair(own).map_err(|e| {
+        fail(
+            f,
+            ids,
+            "bounded_event_transport",
+            format!("chart {chart} t {:x}: {e:?}", t.to_bits()),
+        )
+    })?;
+    let eps = transport.allowance();
+    // No chain-of-allowances acceptance for the actual retained numerical point.
+    if pair.iter().any(|e| {
+        !super::shared_twisted_proof::correlated_c::transport_a::accepts(point, e.point(), eps)
+    }) {
+        return Err(fail(
+            f,
+            ids,
+            "retained_point_transport_distance",
+            format!("chart {chart} t {:x}", t.to_bits()),
+        ));
+    }
+    Ok(pair)
+}
+
+pub(crate) fn check_other_point(
+    transport: &mut Transport<'_>,
+    f: &SfccFeatureSet,
+    ids: [usize; 2],
+    chart: usize,
+    t: f64,
+    point: [f64; 3],
+) -> Result<(), Refusal> {
+    transport
+        .reserve_external(1)
+        .map_err(|e| fail(f, ids, "other_event_query_budget", format!("{e:?}")))?;
+    let curve = f
+        .curves
+        .get(chart)
+        .ok_or_else(|| fail(f, ids, "other_event_source", chart.to_string()))?;
+    if !t.is_finite() || t < curve.t_min || t > curve.t_max {
+        return Err(fail(
+            f,
+            ids,
+            "other_event_parameter",
+            format!("{chart}/{:x}", t.to_bits()),
+        ));
+    }
+    let own = if curve.traced_carriers().is_some() {
+        curve.shared_checked_point(t)
+    } else {
+        curve.point_at_checked(t)
+    }
+    .ok_or_else(|| {
+        fail(
+            f,
+            ids,
+            "other_event_query_failed",
+            format!("{chart}/{:x}", t.to_bits()),
+        )
+    })?;
+    let eps = transport.allowance();
+    if !super::shared_twisted_proof::correlated_c::transport_a::accepts(point, own, eps)
+        || curve.adjacent_strata.iter().any(|&sid| {
+            !f.strata.get(sid).is_some_and(|s| {
+                s.domain_contains(point, eps)
+                    && s.raw_field(point[0], point[1], point[2])
+                        .normalized_equation()
+                        .is_some_and(|v| v.value.is_finite() && v.value.abs() <= eps)
+            })
+        })
+    {
+        return Err(fail(
+            f,
+            ids,
+            "other_event_source_condition",
+            format!("{chart}/{:x}", t.to_bits()),
+        ));
+    }
+    if curve.traced_carriers().is_some() {
+        let mut lo = t.floor().max(curve.t_min);
+        let hi = (lo + 1.).min(curve.t_max);
+        if lo == hi {
+            lo = (hi - 1.).max(curve.t_min);
+        }
+        let (low, high) = curve
+            .projection_tube(lo, hi)
+            .ok_or_else(|| fail(f, ids, "other_event_container", chart.to_string()))?;
+        if !(0..3).all(|k| point[k] >= low[k] && point[k] <= high[k]) {
+            return Err(fail(
+                f,
+                ids,
+                "other_event_container",
+                format!("{chart}/{:x}", t.to_bits()),
+            ));
+        }
+    }
+    Ok(())
+}
