--- /dev/null
+++ b/docs/research/sfcc-arrangement-a/exact_facets.py
@@ -0,0 +1,58 @@
+#!/usr/bin/env python3
+"""Independent exact union/rectangle tiling audit for the fixed two-cuboid witness."""
+import json, sys
+from fractions import Fraction as F
+
+def frac(x):
+    return F.from_float(x) if isinstance(x, float) else F(x)
+
+def audit(path):
+    data=json.load(open(path))
+    coords=[[frac(x) for x in row] for row in data['coordinates']]
+    # Independent target derived directly from original three box intervals.
+    boxes=[[(F(-4),F(1,4)),(F(-4),F(4)),(F(-4),F(4))],
+           [(F(1,2),F(3,4)),(F(-4),F(4)),(F(-4),F(4))]]
+    expected=[]
+    for box in boxes:
+        for axis in range(3):
+            uv=[(axis+1)%3,(axis+2)%3]
+            for side in range(2):
+                expected.append((axis,box[axis][side],1 if side else -1,box[uv[0]],box[uv[1]]))
+    bins=[[] for _ in expected]
+    area=F(0)
+    for r in data['rectangles']:
+        a=r['axis'];uv=[(a+1)%3,(a+2)%3];i=r['index']
+        plane=coords[a][i[a]];u=(coords[uv[0]][i[uv[0]]],coords[uv[0]][i[uv[0]]+1]);v=(coords[uv[1]][i[uv[1]]],coords[uv[1]][i[uv[1]]+1])
+        matches=[k for k,(axis,p,n,eu,ev) in enumerate(expected) if axis==a and plane==p and n==r['outward'] and eu[0]<=u[0]<u[1]<=eu[1] and ev[0]<=v[0]<v[1]<=ev[1]]
+        assert len(matches)==1, ('unexpected or ambiguously owned rectangle',r)
+        bins[matches[0]].append((u,v));area+=(u[1]-u[0])*(v[1]-v[0])
+    atoms=0
+    for target,rects in zip(expected,bins):
+        _,_,_,eu,ev=target
+        us=sorted({*eu,*(x for u,v in rects for x in u)})
+        vs=sorted({*ev,*(x for u,v in rects for x in v)})
+        for ua,ub in zip(us,us[1:]):
+            for va,vb in zip(vs,vs[1:]):
+                owners=[r for r in rects if r[0][0]<=ua<ub<=r[0][1] and r[1][0]<=va<vb<=r[1][1]]
+                assert len(owners)==1, ('gap or overlap',target,ua,ub,va,vb,len(owners))
+                atoms+=1
+    # Verify the actual triangle buffer, not just the planned rectangles.
+    pos=[tuple(map(frac,p)) for p in data['positions']]
+    triangles=data['triangles'];actual={}
+    def cyclic(t): return min(tuple(t[k:]+t[:k]) for k in range(3))
+    for k in range(0,len(triangles),3):
+        t=[pos[i] for i in triangles[k:k+3]];key=cyclic(t);actual[key]=actual.get(key,0)+1
+    required={}
+    for r in data['rectangles']:
+        a=r['axis'];u=(a+1)%3;v=(a+2)%3
+        ix=[r['index'][:] for _ in range(4)]
+        ix[1][u]+=1;ix[2][u]+=1;ix[2][v]+=1;ix[3][v]+=1
+        if r['outward']<0: ix[1],ix[3]=ix[3],ix[1]
+        p=[tuple(coords[a][i[a]] for a in range(3)) for i in ix]
+        for inds in [(0,1,2),(0,2,3)]:
+            key=cyclic([p[i] for i in inds]);required[key]=required.get(key,0)+1
+    assert actual==required, 'actual mesh differs from complete exact facet construction'
+    assert set(actual.values())=={1}
+    result={'rectangles':len(data['rectangles']),'triangles':len(triangles)//3,'targetFacets':len(expected),'exactTilingAtoms':atoms,'exactTotalArea':str(area),'cells':len(data['cells']),'passed':True}
+    print(json.dumps(result,indent=2))
+if __name__=='__main__': audit(sys.argv[1])
