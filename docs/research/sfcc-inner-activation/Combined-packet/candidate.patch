+pub(crate) fn bind<'a>(
+    root: &CsgNode,
+    f: &'a SfccFeatureSet,
+    source: [usize; 3],
+    charts: [usize; 2],
+    outgoing_depth: f64,
+) -> Option<Certificate<'a>> {
+    if !outgoing_depth.is_finite()
+        || outgoing_depth <= 0.
+        || outgoing_depth > 0.25
+        || f.strata.len() > 256
+        || f.curves.len() > 256
+        || charts[0] == charts[1]
+    {
+        return None;
+    }
+    let cs = [f.curves.get(charts[0])?, f.curves.get(charts[1])?];
+    if cs
+        .iter()
+        .enumerate()
+        .any(|(i, c)| c.id != charts[i] || c.closed)
+        || cs[0].corner_start < 0
+        || cs[0].corner_start != cs[1].corner_start
+    {
+        return None;
+    }
+    let corner = f.corners.get(cs[0].corner_start as usize)?;
+    if corner.id != cs[0].corner_start as usize {
+        return None;
+    }
+    let point = [corner.x, corner.y, corner.z];
+    let eps = cs
+        .iter()
+        .filter_map(|c| c.traced_carriers().map(|(_, _, r)| r.curve_eps))
+        .fold(f64::INFINITY, f64::min)
+        * 8.;
+    let j = junction::prove_junction(root, &f.strata, source, point, eps)?;
+    let branch = branch_at(&f.strata, source[0], source[1], source[2], point)?;
+    let registered = f.strata[source[0]].exposure_root_a()?;
+    let (cap_cut, sphere, outer_radius) =
+        pair(registered, Some((BlendKind::Smax, SminMode::Round))).ok()?;
+    let (cut, cap, _) = pair(cap_cut, None).ok()?;
+    let (hard, groove_node, radius) = pair(cut, Some((BlendKind::Smax, SminMode::Chamfer))).ok()?;
+    let (inner, cylinder, _) = pair(hard, None).ok()?;
+    let (other, native, inner_radius) =
+        pair(inner, Some((BlendKind::Smin, SminMode::Round))).ok()?;
+    let native = leaf(native, 1.).ok()?;
+    let other = leaf(other, 1.).ok()?;
+    let cylinder = leaf(cylinder, 1.).ok()?;
+    let groove = leaf(groove_node, -1.).ok()?;
+    let cap = leaf(cap, -1.).ok()?;
+    let sphere = leaf(sphere, 1.).ok()?;
+    let (p, rn, ro, rr) = f.strata[source[0]].round_twisted_source(&f.strata[source[1]])?;
+    if !std::ptr::eq(native, rn) || !std::ptr::eq(other, ro) || rr != inner_radius || p != branch.p
+    {
+        return None;
+    }
+    let rc = f.strata[source[2]].correlated_cylinder_source_c(&f.strata[source[0]])?;
+    if !std::ptr::eq(rc, cylinder) {
+        return None;
+    }
+    if [other, groove, sphere]
+        .iter()
+        .any(|v| v.pos[0] != branch.cylinder.0[0] || v.pos[2] != branch.cylinder.0[2])
+    {
+        return None;
+    }
+    let common = cs[0]
+        .adjacent_strata
+        .iter()
+        .copied()
+        .find(|s| cs[1].adjacent_strata.contains(s))?;
+    for (i, c) in cs.iter().enumerate() {
+        if !c.adjacent_strata.contains(&source[i]) || !c.adjacent_strata.contains(&common) {
+            return None;
+        }
+        let (a, b, _) = c.traced_carriers()?;
+        if !a.connection_same_source(f.strata.get(c.adjacent_strata[0])?)
+            || !b.connection_same_source(f.strata.get(c.adjacent_strata[1])?)
+        {
+            return None;
+        }
+    }
+    if f.strata.get(common)?.id != common {
+        return None;
+    }
+    let (weight, offset) = f
+        .strata
+        .get(common)?
+        .connection_compound(hard, groove_node, cut)?;
+    if weight <= 0. || !weight.is_finite() {
+        return None;
+    }
+    let initial_rho = I::point(branch.cylinder.2);
+    let initial_y = interval(j.height[0], j.height[1])?;
+    let g = meridian_bound(groove, initial_rho, initial_y)?;
+    if g.edge != j.groove_edge {
+        return None;
+    }
+    let l = meridian_bound(other, initial_rho, initial_y)?;
+    let physical = source_locus(g, l, inner_radius, I::point(radius))?;
+    let generated = source_locus(
+        g,
+        l,
+        inner_radius,
+        quotient(I::point(offset), I::point(weight))?,
+    )?;
+    for locus in [physical, generated] {
+        if locus.activation_rho.hi >= branch.cylinder.2
+            || locus.activation_rho.lo - outgoing_depth <= p.v0z.abs()
+        {
+            return None;
+        }
+    }
+    let mut cert = Certificate {
+        features: f,
+        source: [source[0], source[1], source[2], common],
+        charts,
+        branch,
+        native,
+        other,
+        groove,
+        cylinder,
+        cap,
+        sphere,
+        inner_radius,
+        outer_radius,
+        common_weight: weight,
+        common_offset: offset,
+        other_line: l,
+        groove_line: g,
+        loci: [physical, generated],
+        outgoing_depth,
+        margins: [f64::INFINITY; 7],
+        height_derivative_lower: physical.slope.lo.min(generated.slope.lo),
+        transverse_lower: f64::INFINITY,
+        activation_separation_upper: 0.,
+    };
+    for locus in cert.loci {
+        for i in 0..16 {
+            let a = i as f64 / 16.;
+            let b = (i + 1) as f64 / 16.;
+            for image in [
+                cert.incoming(interval(a, b)?, locus)?,
+                cert.outgoing(interval(a * outgoing_depth, b * outgoing_depth)?, locus)?,
+                cert.ghost(interval(a * outgoing_depth, b * outgoing_depth)?, locus)?
+                    .0,
+            ] {
+                let (m, rank) = cert.region(image)?;
+                for k in 0..7 {
+                    cert.margins[k] = cert.margins[k].min(m[k]);
+                }
+                cert.transverse_lower = cert.transverse_lower.min(rank);
+            }
+        }
+    }
+    let a = cert.activation_image(false)?;
+    let b = cert.activation_image(true)?;
+    let mut d = I::point(0.);
+    for k in 0..3 {
+        d = d.add(square(
+            interval(a.0[k], a.1[k])?.sub(interval(b.0[k], b.1[k])?)?,
+        )?)?;
+    }
+    cert.activation_separation_upper = sqrt(d)?.hi;
+    if cert.activation_separation_upper > eps {
+        return None;
+    }
+    Some(cert)
+}
