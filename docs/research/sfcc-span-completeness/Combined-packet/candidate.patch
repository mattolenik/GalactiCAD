+            return None;
+        }
+        let Shape::Extrude { h, .. } = source.cap.shape else {
+            return None;
+        };
+        let cap = I::point(source.cap.pos[1])
+            .sub(I::point(h))?
+            .sub(self.y)?
+            .lo;
+        let Shape::Sphere { r } = source.sphere.shape else {
+            return None;
+        };
+        let sphere_distance = sqrt(
+            square(I::point(source.radius))?
+                .add(square(self.y.sub(I::point(source.sphere.pos[1]))?)?)?,
+        )?;
+        let sphere = I::point(r)
+            .sub(I::point(source.outer_radius))?
+            .sub(sphere_distance)?
+            .lo;
+        if cap <= 0. || sphere <= 0. {
+            return None;
+        }
+        let transverse = mul(quotient(x, I::point(source.radius))?, self.branch.ny)?;
+        if abs_lower(transverse) <= 0. {
+            return None;
+        }
+        Some(
+            json!({"fraction":[s.lo,s.hi],"image":bounds(p),"nativeDerivativeInZ":[ez.lo,ez.hi],
+            "nativeFiniteProfileMargin":profile,"nativeCapMargin":native_cap,"cylinderCapMargin":cylinder_cap,
+            "otherDistance":[other.distance.lo,other.distance.hi],"grooveDistance":[groove.distance.lo,groove.distance.hi],
+            "capCutMargin":cap,"outerRoundMargin":sphere,"cylinderGrooveTransverseLower":abs_lower(transverse)}),
+        )
+    }
+    fn proof(&self) -> R<Value> {
+        let mut rows = Vec::new();
+        for i in 0..16 {
+            let part = interval(i as f64 / 16., (i + 1) as f64 / 16.).ok_or("arc_fraction")?;
+            rows.push(
+                self.piece(part)
+                    .ok_or_else(|| format!("arc_source_piece:{i}:generated={}", self.generated))?,
+            );
+        }
+        let u = sqrt(
+            square(I::point(self.source.radius))
+                .and_then(|r| r.sub(square(I::point(self.source.p.v0z))?))
+                .ok_or("corner_arithmetic")?,
+        )
+        .ok_or("corner_arithmetic")?;
+        let determinant = mul(
+            quotient(u, I::point(self.source.radius)).ok_or("corner_arithmetic")?,
+            self.branch.ny,
+        )
+        .ok_or("corner_arithmetic")?;
+        if abs_lower(determinant) <= 0. {
+            return Err("corner_nontransverse".into());
+        }
+        Ok(
+            json!({"coefficientFamily":if self.generated{"generated carrier"}else{"physical source"},
+            "sourceFingerprint":self.source.f.fingerprint().to_string(),"chart":self.source.chart,
+            "heightBounds":[self.y.lo,self.y.hi],"grooveLevelBounds":[self.level.lo,self.level.hi],"terminalImage":bounds(self.terminal),
+            "outerZBits":self.z_end.to_bits(),"terminalNativeCylinderGrooveJacobianLower":abs_lower(determinant),
+            "pieces":rows,"pieceCount":16,"closedCanonicalArcExposed":!self.generated,"generatedCarrierArcRestrictionsProved":self.generated,
+            "closureArgument":"terminal is the correlated native E=0,cylinder rho=R,groove-level event; the native field decreases strictly with world Z on the complete closed cover, so E<=0 including the terminal",
+            "parameterization":"Z=Z_terminal+s*(Z_outer-Z_terminal), s in [0,1], negative-X cylinder branch; midpoint enclosures never replace the exact correlated terminal",
+            "fullPhysicalSourceZeroProved":!self.generated,"generatedCarrierExactPhysicalIdentityClaimed":false,
+            "rawNumericalParameterContinuityProved":false}),
+        )
+    }
+    fn target(
+        &self,
+        id: usize,
+        point: Point,
+        corner: usize,
+        shared: usize,
+        outer: usize,
+        face_x: f64,
+    ) -> Option<Image> {
+        if id == corner {
+            Some(self.terminal)
+        } else if id == shared {
+            self.source
+                .feature(self.branch, self.level, 0, face_x)
+                .map(|v| v.0)
+        } else if id == outer {
+            self.source
+                .feature(self.branch, self.level, 2, self.z_end)
+                .map(|v| v.0)
+        } else {
+            self.source
+                .feature(self.branch, self.level, 2, point[2])
+                .map(|v| v.0)
+        }
+    }
+}
+type Point = [f64; 3];
+fn number(v: &Value) -> R<f64> {
+    let x = f64::from_bits(v.as_u64().ok_or("bits")?);
+    if x.is_finite() {
+        Ok(x)
+    } else {
+        Err("nonfinite".into())
+    }
+}
+fn ordered(rows: &[(f64, Image)]) -> bool {
+    !rows.is_empty()
+        && rows
+            .windows(2)
+            .all(|w| w[0].0 < w[1].0 && w[0].1[2].lo > w[1].1[2].hi)
+}
+fn point_bits(row: &Value) -> R<Point> {
+    Ok([number(&row[0])?, number(&row[1])?, number(&row[2])?])
+}
