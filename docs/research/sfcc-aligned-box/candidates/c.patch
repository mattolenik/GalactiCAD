+mod tests {
+    use super::*;
+    fn fixture() -> (CsgNode, SfccLattice, Vec<SfccCell>) {
+        let tree = crate::sdf::leaf_at(crate::sdf::Shape::Cuboid { half: [1.; 3] }, [0.; 3]);
+        let lat = crate::math::grid::make_lattice(8, -8., -8., -8., 16.);
+        let cells = vec![SfccCell {
+            level: 0,
+            ix: 0,
+            iy: 0,
+            iz: 0,
+            key: 0,
+            degenerate: true,
+            feature_curve: -1,
+            feature_corner: -1,
+        }];
+        (tree, lat, cells)
+    }
+    #[test]
+    fn lattice_and_overlap_validation_precede_arithmetic() {
+        let (tree, lat, cells) = fixture();
+        for bad in [
+            SfccLattice {
+                max_depth: 63,
+                ..lat
+            },
+            SfccLattice { step: 0., ..lat },
+            SfccLattice { span: 1, ..lat },
+            SfccLattice {
+                origin_x: f64::NAN,
+                ..lat
+            },
+        ] {
+            assert_eq!(
+                Plan::build(&tree, &bad, &cells).err(),
+                Some(Failure::InvalidGrid)
+            );
+        }
+        let mut overlap = cells.clone();
+        overlap.push(SfccCell {
+            level: 1,
+            ..cells[0]
+        });
+        assert_eq!(
+            Plan::build(&tree, &lat, &overlap).err(),
+            Some(Failure::OverlappingCells)
+        );
+    }
+    #[test]
+    fn lifecycle_detects_reindex_payload_patch_and_empty_membership_changes() {
+        let (tree, lat, cells) = fixture();
+        let plan = Plan::build(&tree, &lat, &cells).unwrap();
+        let (mut points, tris, _) = plan.tables(lat.step).unwrap();
+        let before = lifecycle(&points, &tris);
+        points.protect_edge(tris[0], tris[2]);
+        assert!(before != lifecycle(&points, &tris));
+        let (mut points, tris, _) = plan.tables(lat.step).unwrap();
+        let before = lifecycle(&points, &tris);
+        points.set_patch([tris[0], tris[1], tris[2]], usize::MAX);
+        assert!(before != lifecycle(&points, &tris));
+        let (mut points, tris, _) = plan.tables(lat.step).unwrap();
+        let before = lifecycle(&points, &tris);
+        let p = super::super::local_coverage::payload(&points, 0).map(f64::from_bits);
+        points.relocate(0, [p[0], p[1], p[2]], [p[3].next_up(), p[4], p[5]]);
+        assert!(before != lifecycle(&points, &tris));
+        let (mut points, mut tris, _) = plan.tables(lat.step).unwrap();
+        let before = lifecycle(&points, &tris);
+        let p = super::super::local_coverage::payload(&points, tris[0]).map(f64::from_bits);
+        let replacement = points.add(p[0], p[1], p[2], p[3], p[4], p[5]);
+        tris[0] = replacement;
+        assert!(before != lifecycle(&points, &tris));
+    }
+    #[test]
+    fn cancellation_does_not_leave_shared_arrangement_state() {
+        let (tree, lat, cells) = fixture();
+        {
+            let _guard = super::super::cancel::CancelGuard::install(Box::new(|| true));
+            assert_eq!(
+                Plan::build(&tree, &lat, &cells).err(),
+                Some(Failure::Cancelled)
+            );
+        }
+        assert!(Plan::build(&tree, &lat, &cells).is_ok());
+    }
