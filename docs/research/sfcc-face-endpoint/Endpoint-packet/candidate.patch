+        ))
+    }
+    fn surface_lift(
+        &self,
+        branch: activation_a::MeridianBound,
+        point: [f64; 3],
+    ) -> Option<(Image, Value)> {
+        let y = I::point(point[1]);
+        let z = I::point(point[2]);
+        let denominator = I::point(1.).sub(branch.nr)?;
+        if denominator.lo <= 0. {
+            return None;
+        }
+        let qrho = quotient(
+            I::point(self.radius)
+                .add(mul(branch.ny, y)?)?
+                .add(branch.offset)?
+                .sub(I::point(self.chamfer_radius))?,
+            denominator,
+        )?;
+        let rho = interval(self.radius.min(qrho.lo), self.radius.min(qrho.hi))?;
