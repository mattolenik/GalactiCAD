+#[derive(Default)]
+struct Capture {
+    enabled: bool,
+    raw: Option<FeatureCurve>,
+    source: Vec<Value>,
+}
+thread_local! { static CAPTURE: RefCell<Capture> = RefCell::new(Capture::default()); }
+struct Scope;
+impl Drop for Scope {
+    fn drop(&mut self) {
+        CAPTURE.with(|c| *c.borrow_mut() = Capture::default());
+    }
+}
+fn hex(v: f64) -> String {
+    format!("{:016x}", v.to_bits())
+}
+fn distance(a: [f64; 3], b: [f64; 3]) -> f64 {
+    (a[0] - b[0]).hypot(a[1] - b[1]).hypot(a[2] - b[2])
+}
+fn lower() -> [f64; 3] {
+    [0xc022b7c9d907b15a, 0xc003efb1a33e9e36, 0x40158f2508500325].map(f64::from_bits)
+}
+
+pub(super) fn capture(tree: &SfccTree<'_>, raw: &[FeatureCurve]) {
+    if !CAPTURE.with(|c| c.borrow().enabled) {
+        return;
+    }
+    let native = tree
+        .strata
+        .iter()
+        .find(|s| {
+            s.local_index == 3
+                && s.graph_capture_identity_b().is_some_and(|v| {
+                    v["field"].is_null() && v["domain"][0]["path"] == json!([0, 0, 0, 0, 1])
+                })
+        })
+        .unwrap()
+        .id;
+    let candidates: Vec<_> = raw
+        .iter()
+        .filter(|c| c.adjacent_strata.contains(&native))
+        .filter(|c| {
+            c.adjacent_strata
+                .iter()
+                .any(|&i| tree.strata[i].kind == CarrierKind::Compound)
+        })
+        .filter(|c| {
+            c.point_at_checked(c.t_min)
+                .is_some_and(|p| distance(p, lower()) < 1e-5)
+        })
+        .collect();
+    assert_eq!(
+        candidates.len(),
+        1,
+        "exact source occurrence and incoming endpoint select one raw trace"
+    );
+    let selected = candidates[0];
+    CAPTURE.with(|c| {
+        let mut c = c.borrow_mut();
+        assert!(c.raw.is_none(), "one bounded observer invocation");
+        c.source = selected
+            .adjacent_strata
+            .iter()
+            .map(|&i| tree.strata[i].graph_capture_identity_b().unwrap())
+            .collect();
+        c.raw = Some(selected.clone());
+    });
+}
+
+fn pointwise_postconditions(curve: &FeatureCurve, t: f64, p: [f64; 3]) -> Value {
+    let (a, b, r) = curve.traced_carriers().unwrap();
+    let seed = curve.original_seed_c(t);
+    let fa = a.raw_field(p[0], p[1], p[2]).normalized_equation().unwrap();
+    let fb = b.raw_field(p[0], p[1], p[2]).normalized_equation().unwrap();
+    let dot = (0..3).map(|i| fa.gradient[i] * fb.gradient[i]).sum::<f64>();
+    let det = 1. - dot * dot;
+    let accepted = fa.value.abs() <= r.curve_eps
+        && fb.value.abs() <= r.curve_eps
+        && det > r.min_cross * r.min_cross
+        && distance(seed, p) <= r.max_displacement;
+    json!({"accepted":accepted,"parameterHex":hex(t),"pointHex":p.map(hex),"seedHex":seed.map(hex),
+        "residualHex":[hex(fa.value),hex(fb.value)],"fullCrossSquaredHex":hex(det),
+        "seedDistanceHex":hex(distance(seed,p)),"displacementCapHex":hex(r.max_displacement)})
+}
