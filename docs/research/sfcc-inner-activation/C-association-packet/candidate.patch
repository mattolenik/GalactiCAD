+fn activation_c_actual_event_parameters_and_frontier_branch_associations() {
+    let (root, f, captured, brackets, box_, eps) = fixture();
+    let cert = source_certificate(&root, &f);
+    let mut ledger = budget(&f);
+    let charged_before = ledger.charged_queries();
+    let mut trace = vec![];
+    let result = prepare(&f, &cert, brackets, box_, eps, &mut ledger, &mut trace);
+    if let Err(ref failure) = result {
+        write(
+            "activation-C-association.json",
+            &json!({"scope":"failed bounded parameter preparation; no mutation","failure":format!("{failure:?}"),"queries":trace,"brackets":brackets,"chargedBefore":charged_before,"chargedAfter":ledger.charged_queries()}),
+        );
