+//! Exact rectilinear construction for bounded hard signed-box expressions.
+//! The coordinate product includes every represented leaf boundary, so restrictions
+//! to shared coarse/fine faces use the same rectangles and vertex identities.
+use super::octree::SfccCell;
+use super::point_table::CurveInterval;
+use crate::math::grid::{
+    cell_aabb, cell_key, face_axes, point_to_world, stride_at_level, SfccLattice,
+};
+use crate::sdf::CsgNode;
+use std::collections::{BTreeMap, BTreeSet};
+
+type P = [f64; 3];
+type Key = [usize; 3];
+type Bounds = [f64; 6];
+const MAX_COORDS: usize = 192;
+const MAX_NODES: usize = 1024;
+const MAX_CELLS: usize = 16384;
+const MAX_STRATA: usize = 2_000_000;
+const MAX_WORK: usize = 64_000_000;
+const MAX_FACETS: usize = 100_000;
+const MAX_OWNER_WORDS: usize = 1_000_000;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Failure {
+    OutsideScope,
+    Budget,
+    InvalidGrid,
+    OutsideDomain,
+    ZeroOnlyStratum,
+    NonManifold,
+    MissingCell,
+    OverlappingCells,
+    Float32Collapse,
+    CorruptPartial,
+    Cancelled,
+}
+impl Failure {
+    pub fn reason(&self) -> &'static str {
+        match self {
+            Self::OutsideScope => "arrangement_outside_scope",
+            Self::Budget => "arrangement_budget",
+            Self::InvalidGrid => "arrangement_grid",
+            Self::OutsideDomain => "arrangement_domain",
+            Self::ZeroOnlyStratum => "arrangement_zero_only_stratum",
+            Self::NonManifold => "arrangement_nonmanifold",
+            Self::MissingCell => "arrangement_missing_cell",
+            Self::OverlappingCells => "arrangement_overlapping_cells",
+            Self::Float32Collapse => "arrangement_float32_collapse",
+            Self::CorruptPartial => "arrangement_corrupt_partial",
+            Self::Cancelled => "arrangement_cancelled",
+        }
+    }
+}
+
+#[derive(Clone, Debug)]
+struct Occurrence {
+    bounds: Bounds,
+    sign: i8,
+    path: Vec<usize>,
+}
+#[derive(Clone, Debug)]
+enum Expr {
+    Leaf(usize),
+    Min(Vec<Expr>),
+    Max(Vec<Expr>),
+}
+impl Expr {
+    fn read(
+        tree: &CsgNode,
+        path: &mut Vec<usize>,
+        leaves: &mut Vec<Occurrence>,
+        nodes: &mut usize,
+    ) -> Result<Self, Failure> {
+        *nodes += 1;
+        if *nodes > MAX_NODES || path.len() > 64 {
+            return Err(Failure::Budget);
+        }
+        match tree {
+            CsgNode::Leaf(l) => {
+                let bounds = super::local_coverage::box_bounds(l).ok_or(Failure::OutsideScope)?;
+                let index = leaves.len();
+                leaves.push(Occurrence {
+                    bounds,
+                    sign: l.sign as i8,
+                    path: path.clone(),
+                });
+                Ok(Self::Leaf(index))
+            }
+            CsgNode::Min(children) | CsgNode::Max(children) if !children.is_empty() => {
+                let mut out = Vec::new();
+                for (i, child) in children.iter().enumerate() {
+                    path.push(i);
+                    out.push(Self::read(child, path, leaves, nodes)?);
+                    path.pop();
+                }
+                Ok(if matches!(tree, CsgNode::Min(_)) {
+                    Self::Min(out)
+                } else {
+                    Self::Max(out)
+                })
+            }
+            _ => Err(Failure::OutsideScope),
+        }
+    }
+    fn sign(&self, leaves: &[Occurrence], lo: P, hi: P) -> i8 {
+        match self {
+            Self::Leaf(i) => {
+                let l = &leaves[*i];
+                let mut zero = false;
+                for a in 0..3 {
+                    if hi[a] < l.bounds[a]
+                        || lo[a] > l.bounds[a + 3]
+                        || (hi[a] == l.bounds[a] && lo[a] < hi[a])
+                        || (lo[a] == l.bounds[a + 3] && lo[a] < hi[a])
+                    {
+                        return l.sign;
+                    }
+                    zero |= lo[a] == hi[a] && (lo[a] == l.bounds[a] || lo[a] == l.bounds[a + 3]);
+                }
+                if zero {
+                    0
+                } else {
+                    -l.sign
+                }
+            }
+            Self::Min(ch) => ch.iter().map(|c| c.sign(leaves, lo, hi)).min().unwrap_or(0),
+            Self::Max(ch) => ch.iter().map(|c| c.sign(leaves, lo, hi)).max().unwrap_or(0),
+        }
+    }
+    // One postorder pass retains all zero ties exactly when this subtree's
+    // signed min/max result is zero. No repeated sign traversal or path dedup.
+    fn owners(&self, leaves: &[Occurrence], lo: P, hi: P, out: &mut Vec<usize>) -> i8 {
+        let start = out.len();
+        let sign = match self {
+            Self::Leaf(i) => {
+                let sign = self.sign(leaves, lo, hi);
+                if sign == 0 {
+                    out.push(*i);
+                }
+                sign
+            }
+            Self::Min(ch) => ch
+                .iter()
+                .map(|c| c.owners(leaves, lo, hi, out))
+                .min()
+                .unwrap_or(0),
+            Self::Max(ch) => ch
+                .iter()
+                .map(|c| c.owners(leaves, lo, hi, out))
+                .max()
+                .unwrap_or(0),
+        };
+        if sign != 0 {
+            out.truncate(start);
+        }
+        sign
+    }
+}
+
+#[derive(Clone, Debug)]
+pub struct Facet {
+    pub axis: usize,
+    pub sign: i8,
+    pub low: Key,
+    pub cell: usize,
+    pub incident_cells: Vec<usize>,
+    pub owner_paths: Vec<Vec<usize>>,
+}
+#[derive(Clone, Debug)]
+pub struct Plan {
+    pub coordinates: [Vec<f64>; 3],
+    pub facets: Vec<Facet>,
+    pub cells: Vec<SfccCell>,
+    pub strata_checked: usize,
+    pub original_occurrences: usize,
+    /// Counts of open zero vertices, edges and faces in each closed leaf domain.
+    pub cell_zero_strata: Vec<[usize; 3]>,
+}
+
+fn insert_coordinate(out: &mut Vec<f64>, x: f64) -> Result<(), Failure> {
+    if !x.is_finite() {
+        return Err(Failure::OutsideScope);
+    }
+    let x = if x == 0. { 0. } else { x };
+    if !out.contains(&x) {
+        if out.len() >= MAX_COORDS {
+            return Err(Failure::Budget);
+        }
+        out.push(x);
+    }
+    Ok(())
+}
+fn product_bounded(n: [usize; 3], limit: usize) -> Result<usize, Failure> {
+    n.into_iter().try_fold(1usize, |p, n| {
+        p.checked_mul(n)
+            .filter(|p| *p <= limit)
+            .ok_or(Failure::Budget)
+    })
+}
+fn each_index(n: [usize; 3], mut f: impl FnMut(Key) -> Result<(), Failure>) -> Result<(), Failure> {
+    for x in 0..n[0] {
+        if super::cancel::is_cancelled() {
+            return Err(Failure::Cancelled);
+        }
+        for y in 0..n[1] {
+            for z in 0..n[2] {
+                f([x, y, z])?;
+            }
+        }
+    }
+    Ok(())
+}
+fn adjacent_intervals(i: usize, len: usize) -> Vec<usize> {
+    if i % 2 == 1 {
+        return vec![i / 2];
+    }
+    let mut out = Vec::with_capacity(2);
+    if i > 0 {
+        out.push(i / 2 - 1);
+    }
+    if i / 2 + 1 < len {
+        out.push(i / 2);
+    }
+    out
+}
+
+impl Plan {
+    pub fn build(tree: &CsgNode, lat: &SfccLattice, cells: &[SfccCell]) -> Result<Self, Failure> {
+        if cells.len() > MAX_CELLS {
+            return Err(Failure::Budget);
+        }
+        if !(1..=14).contains(&lat.max_depth) {
+            return Err(Failure::InvalidGrid);
+        }
+        if lat.res != (1i64 << lat.max_depth)
+            || lat.span != lat.res + 1
+            || !lat.world_size.is_finite()
+            || lat.world_size <= 0.
+            || !lat.step.is_finite()
+            || lat.step <= 0.
+            || lat.step != lat.world_size / lat.res as f64
+            || [lat.origin_x, lat.origin_y, lat.origin_z]
+                .iter()
+                .any(|v| !v.is_finite())
+        {
+            return Err(Failure::InvalidGrid);
+        }
+        let mut occurrences = Vec::new();
+        let mut nodes = 0;
+        let expression = Expr::read(tree, &mut Vec::new(), &mut occurrences, &mut nodes)?;
+        let root_lo = point_to_world(lat, 0, 0, 0);
+        let root_hi = point_to_world(lat, lat.res, lat.res, lat.res);
+        if root_lo.iter().chain(&root_hi).any(|v| !v.is_finite())
+            || (0..3).any(|a| root_lo[a] >= root_hi[a])
+        {
+            return Err(Failure::InvalidGrid);
+        }
+        let mut coordinates: [Vec<f64>; 3] = std::array::from_fn(|a| vec![root_lo[a], root_hi[a]]);
+        for occurrence in &occurrences {
+            for a in 0..3 {
+                for x in [occurrence.bounds[a], occurrence.bounds[a + 3]] {
+                    if x <= root_lo[a] || x >= root_hi[a] {
+                        return Err(Failure::OutsideDomain);
+                    }
+                    insert_coordinate(&mut coordinates[a], x)?;
+                }
+            }
+        }
+        let mut bounds = Vec::with_capacity(cells.len());
+        let mut cell_ids = BTreeSet::new();
+        for c in cells {
+            if c.level > lat.max_depth
+                || [c.ix, c.iy, c.iz]
+                    .iter()
+                    .any(|&x| x < 0 || x >= (1i64 << c.level))
+                || c.key != cell_key(lat, c.level, c.ix, c.iy, c.iz)
+                || !cell_ids.insert((c.level, c.ix, c.iy, c.iz))
+            {
+                return Err(Failure::InvalidGrid);
+            }
+            let stride = stride_at_level(lat, c.level);
+            let grid = [c.ix * stride, c.iy * stride, c.iz * stride];
+            let lo = point_to_world(lat, grid[0], grid[1], grid[2]);
+            let hi = point_to_world(lat, grid[0] + stride, grid[1] + stride, grid[2] + stride);
+            let b = cell_aabb(lat, c.level, c.ix, c.iy, c.iz);
+            if b[..3] != lo || b[3..] != hi || (0..3).any(|a| lo[a] >= hi[a]) {
+                return Err(Failure::InvalidGrid);
+            }
+            for a in 0..3 {
+                insert_coordinate(&mut coordinates[a], lo[a])?;
+                insert_coordinate(&mut coordinates[a], hi[a])?;
+            }
+            bounds.push(b);
+        }
+        for c in cells {
+            for level in 0..c.level {
+                let shift = c.level - level;
+                if cell_ids.contains(&(level, c.ix >> shift, c.iy >> shift, c.iz >> shift)) {
+                    return Err(Failure::OverlappingCells);
+                }
+            }
+        }
+        for v in &mut coordinates {
+            v.sort_by(f64::total_cmp);
+        }
+        let stratum_dims = std::array::from_fn(|a| 2 * coordinates[a].len() - 1);
+        let strata_checked = product_bounded(stratum_dims, MAX_STRATA)?;
+        if strata_checked
+            .checked_mul(nodes)
+            .and_then(|n| n.checked_mul(13))
+            .is_none_or(|n| n > MAX_WORK)
+        {
+            return Err(Failure::Budget);
+        }
+        let mut cell_zero_strata = vec![[0usize; 3]; cells.len()];
+        let mut cell_search_work = 0usize;
+        // Every zero stratum must separate occupied and empty open 3D regions.
+        // In particular A-A and isolated edge/point contacts cannot vanish here.
+        each_index(stratum_dims, |index| {
+            let lo = std::array::from_fn(|a| coordinates[a][index[a] / 2]);
+            let hi = std::array::from_fn(|a| coordinates[a][(index[a] + 1) / 2]);
+            let sign = expression.sign(&occurrences, lo, hi);
+            if (0..3).any(|a| index[a] == 0 || index[a] + 1 == stratum_dims[a]) && sign <= 0 {
+                return Err(Failure::OutsideDomain);
+            }
+            if sign != 0 {
+                return Ok(());
+            }
+            let dimension = index.iter().filter(|&&i| i % 2 == 1).count();
+            if dimension > 2 {
+                return Err(Failure::ZeroOnlyStratum);
+            }
+            cell_search_work = cell_search_work
+                .checked_add(cells.len())
+                .ok_or(Failure::Budget)?;
+            if cell_search_work > MAX_WORK {
+                return Err(Failure::Budget);
+            }
+            for (i, b) in bounds.iter().enumerate() {
+                if (0..3).all(|a| lo[a] >= b[a] && hi[a] <= b[a + 3]) {
+                    cell_zero_strata[i][dimension] += 1;
+                }
+            }
+            let neighbours: [Vec<usize>; 3] =
+                std::array::from_fn(|a| adjacent_intervals(index[a], coordinates[a].len()));
+            let mut negative = false;
+            let mut positive = false;
+            for &x in &neighbours[0] {
+                for &y in &neighbours[1] {
+                    for &z in &neighbours[2] {
+                        let i = [x, y, z];
+                        let l = std::array::from_fn(|a| coordinates[a][i[a]]);
+                        let h = std::array::from_fn(|a| coordinates[a][i[a] + 1]);
+                        let s = expression.sign(&occurrences, l, h);
+                        negative |= s < 0;
+                        positive |= s > 0;
+                    }
+                }
+            }
+            if !negative || !positive {
+                return Err(Failure::ZeroOnlyStratum);
+            }
+            Ok(())
+        })?;
+        let mut facets = Vec::new();
+        let mut ownership_words = 0usize;
+        for axis in 0..3 {
+            let dims = std::array::from_fn(|a| coordinates[a].len() - usize::from(a != axis));
+            each_index(dims, |low| {
+                let mut lo = std::array::from_fn(|a| coordinates[a][low[a]]);
+                let mut hi =
+                    std::array::from_fn(|a| coordinates[a][low[a] + usize::from(a != axis)]);
+                if expression.sign(&occurrences, lo, hi) != 0 {
+                    return Ok(());
+                }
+                if low[axis] == 0 || low[axis] + 1 == coordinates[axis].len() {
+                    return Err(Failure::OutsideDomain);
+                }
+                let mut owners = Vec::new();
+                expression.owners(&occurrences, lo, hi, &mut owners);
+                ownership_words = ownership_words
+                    .checked_add(
+                        owners
+                            .iter()
+                            .map(|&i| occurrences[i].path.len() + 1)
+                            .sum::<usize>(),
+                    )
+                    .ok_or(Failure::Budget)?;
+                if ownership_words > MAX_OWNER_WORDS {
+                    return Err(Failure::Budget);
+                }
+                let plane = lo[axis];
+                lo[axis] = coordinates[axis][low[axis] - 1];
+                let left = expression.sign(&occurrences, lo, hi);
+                lo[axis] = plane;
+                hi[axis] = coordinates[axis][low[axis] + 1];
+                let right = expression.sign(&occurrences, lo, hi);
+                hi[axis] = plane;
+                if left * right != -1 {
+                    return Err(Failure::ZeroOnlyStratum);
+                }
+                cell_search_work = cell_search_work
+                    .checked_add(cells.len())
+                    .ok_or(Failure::Budget)?;
+                if cell_search_work > MAX_WORK {
+                    return Err(Failure::Budget);
+                }
+                let incident_cells: Vec<_> = bounds
+                    .iter()
+                    .enumerate()
+                    .filter(|(_, b)| (0..3).all(|a| lo[a] >= b[a] && hi[a] <= b[a + 3]))
+                    .map(|(i, _)| i)
+                    .collect();
+                if incident_cells.is_empty() {
+                    return Err(Failure::MissingCell);
+                }
+                // Half-open ownership is by sorted geometric leaf ID. Both closed
+                // cell targets retain the facet in incident_cells when coincident.
+                let &cell = incident_cells
+                    .iter()
+                    .min_by_key(|&&i| {
+                        let c = cells[i];
+                        (c.level, c.ix, c.iy, c.iz)
+                    })
+                    .ok_or(Failure::MissingCell)?;
+                if incident_cells.len() > 2 {
+                    return Err(Failure::OverlappingCells);
+                }
+                if facets.len() == MAX_FACETS {
+                    return Err(Failure::Budget);
+                }
+                facets.push(Facet {
+                    axis,
+                    sign: if left < 0 { 1 } else { -1 },
+                    low,
+                    cell,
+                    incident_cells,
+                    owner_paths: owners
+                        .into_iter()
+                        .map(|i| occurrences[i].path.clone())
+                        .collect(),
+                });
+                Ok(())
+            })?;
+        }
+        // A coordinate-wise strictly increasing f32 map is an ambient
+        // homeomorphism of this whole rectilinear complex, unlike epsilon welding.
+        for axis in 0..3 {
+            let used: BTreeSet<_> = facets
+                .iter()
+                .flat_map(|f| f.corners().map(|p| p[axis]))
+                .collect();
+            let mut previous = None;
+            for i in used {
+                let x = coordinates[axis][i] as f32;
+                if !x.is_finite() || previous.is_some_and(|p| p >= x) {
+                    return Err(Failure::Float32Collapse);
+                }
+                previous = Some(x);
+            }
+        }
+        let plan = Self {
+            coordinates,
+            facets,
+            cells: cells.to_vec(),
+            strata_checked,
+            original_occurrences: occurrences.len(),
+            cell_zero_strata,
+        };
+        let mesh = plan.mesh((0..plan.facets.len()).collect())?;
+        if !super::manifold_check::check_manifold(&mesh.tris, true).ok {
+            return Err(Failure::NonManifold);
+        }
+        Ok(plan)
+    }
+    pub fn point(&self, key: Key) -> P {
+        std::array::from_fn(|a| self.coordinates[a][key[a]])
+    }
+    pub fn mesh(&self, facet_ids: Vec<usize>) -> Result<ConstructedMesh, Failure> {
+        let mut keys = BTreeSet::new();
+        for &id in &facet_ids {
+            for p in self
+                .facets
+                .get(id)
+                .ok_or(Failure::CorruptPartial)?
+                .corners()
+            {
+                keys.insert(p);
+            }
+        }
+        let keys: Vec<_> = keys.into_iter().collect();
+        let by_key: BTreeMap<_, _> = keys
+            .iter()
+            .enumerate()
+            .map(|(i, &p)| (p, i as u32))
+            .collect();
+        let mut normal = BTreeMap::<Key, [i32; 3]>::new();
+        // Normals are based on the complete complex, independent of partition.
+        for facet in &self.facets {
+            for p in facet.corners() {
+                normal.entry(p).or_default()[facet.axis] += facet.sign as i32;
+            }
+        }
+        let mut verts = Vec::with_capacity(keys.len() * 8);
+        for p in &keys {
+            let v = self.point(*p);
+            let n = normal.get(p).copied().unwrap_or_default();
+            let length = n.iter().map(|&x| (x as f64).powi(2)).sum::<f64>().sqrt();
+            if length == 0. {
+                return Err(Failure::NonManifold);
+            }
+            verts.extend([
+                v[0] as f32,
+                v[1] as f32,
+                v[2] as f32,
+                0.,
+                (n[0] as f64 / length) as f32,
+                (n[1] as f64 / length) as f32,
+                (n[2] as f64 / length) as f32,
+                0.,
+            ]);
+        }
+        let mut tris = Vec::with_capacity(facet_ids.len() * 6);
+        for &id in &facet_ids {
+            let c = self.facets[id].corners().map(|k| by_key[&k]);
+            tris.extend([c[0], c[1], c[2], c[0], c[2], c[3]]);
+        }
+        Ok(ConstructedMesh { verts, tris })
+    }
+}
+impl Facet {
+    pub fn corners(&self) -> [Key; 4] {
+        let [u, v] = face_axes(self.axis);
+        let mut out = [self.low; 4];
+        out[1][u] += 1;
+        out[2][u] += 1;
+        out[2][v] += 1;
+        out[3][v] += 1;
+        if self.sign < 0 {
+            out.swap(1, 3);
+        }
+        out
+    }
+}
+pub struct ConstructedMesh {
+    pub verts: Vec<f32>,
+    pub tris: Vec<u32>,
+}
+
+impl Plan {
+    fn tables(
+        &self,
+        step: f64,
+    ) -> Result<
+        (
+            super::point_table::PointTable,
+            Vec<usize>,
+            super::feature_set::SfccFeatureSet,
+        ),
+        Failure,
+    > {
+        use super::feature_curves::make_segment_curve;
+        use crate::strata::{Stratum, StratumIdentity};
+        let mut points = super::point_table::PointTable::new();
+        let mut keys = BTreeSet::new();
+        let mut normal = BTreeMap::<Key, [i32; 3]>::new();
+        for f in &self.facets {
+            for p in f.corners() {
+                keys.insert(p);
+                normal.entry(p).or_default()[f.axis] += f.sign as i32;
+            }
+        }
+        let mut ids = BTreeMap::new();
+        for key in keys {
+            let p = self.point(key);
+            let n = normal[&key];
+            let length = n.iter().map(|&x| (x as f64).powi(2)).sum::<f64>().sqrt();
+            if length == 0. {
+                return Err(Failure::NonManifold);
+            }
+            let id =
+                points.get_or_create_str(&format!("arr:{},{},{}", key[0], key[1], key[2]), || {
+                    [
+                        p[0],
+                        p[1],
+                        p[2],
+                        n[0] as f64 / length,
+                        n[1] as f64 / length,
+                        n[2] as f64 / length,
+                    ]
+                });
+            ids.insert(key, id);
+        }
+        let mut triangles = Vec::new();
+        let mut strata = Vec::new();
+        let mut uses = BTreeMap::<(Key, Key), Vec<usize>>::new();
+        for (id, f) in self.facets.iter().enumerate() {
+            let mut n = [0.; 3];
+            n[f.axis] = f.sign as f64;
+            strata.push(Stratum::plane(
+                StratumIdentity {
+                    id,
+                    owner_node_id: -1,
+                    leaf_index: 0,
+                    local_index: id,
+                    sign: 1.,
+                },
+                n[0],
+                n[1],
+                n[2],
+                -n[f.axis] * self.coordinates[f.axis][f.low[f.axis]],
+            ));
+            let k = f.corners();
+            let t = k.map(|p| ids[&p]);
+            for triangle in [[t[0], t[1], t[2]], [t[0], t[2], t[3]]] {
+                points.set_patch(triangle, id);
+                triangles.extend(triangle);
+            }
+            for j in 0..4 {
+                let (a, b) = (k[j], k[(j + 1) % 4]);
+                uses.entry((a.min(b), a.max(b))).or_default().push(id);
+            }
+        }
+        let mut curves = Vec::new();
+        let mut index = super::spatial_index::SfccSpatialIndex::new(step);
+        for ((a, b), f) in uses {
+            if f.len() != 2 {
+                return Err(Failure::NonManifold);
+            }
+            let (fa, fb) = (&self.facets[f[0]], &self.facets[f[1]]);
+            if fa.axis == fb.axis && fa.sign == fb.sign {
+                continue;
+            }
+            let id = curves.len();
+            let p = self.point(a);
+            let q = self.point(b);
+            let curve =
+                make_segment_curve(id, -1, [f[0], f[1]], p[0], p[1], p[2], q[0], q[1], q[2]);
+            index.insert_curve(&curve);
+            curves.push(curve);
+            points.protect_curve_edge(
+                ids[&a],
+                ids[&b],
+                CurveInterval {
+                    curve_id: id,
+                    start: 0.,
+                    end: 1.,
+                },
+            );
+        }
+        let features = super::feature_set::SfccFeatureSet {
+            curves,
+            corners: Vec::new(),
+            index,
+            strata,
+            run_id: super::feature_set::next_feature_set_run_id(),
+            unresolved_branch_paths: Vec::new(),
+            trace_diagnostics: Default::default(),
+        };
+        Ok((points, triangles, features))
+    }
+    pub(crate) fn finish(
+        &self,
+        tree: &CsgNode,
+        lat: &SfccLattice,
+        tuning: &super::pipeline::PipelineTuning,
+    ) -> Result<super::pipeline::SfccPipelineResult, Failure> {
+        let _guard = super::validation::NumericalGuard::new();
+        let (points, tris, features) = self.tables(lat.step)?;
+        self.finish_tables(tree, lat, tuning, points, tris, features)
+    }
+    fn finish_tables(
+        &self,
+        tree: &CsgNode,
+        lat: &SfccLattice,
+        tuning: &super::pipeline::PipelineTuning,
+        mut points: super::point_table::PointTable,
+        tris: Vec<usize>,
+        features: super::feature_set::SfccFeatureSet,
+    ) -> Result<super::pipeline::SfccPipelineResult, Failure> {
+        use super::pipeline::{SfccPipelineResult, SfccStats};
+        use super::validation::{AuditStatus, SfccValidation};
+        #[cfg(feature = "sfcc-profile")]
+        {
+            for (i, c) in self.cells.iter().enumerate() {
+                let local: Vec<_> = self
+                    .facets
+                    .iter()
+                    .enumerate()
+                    .filter(|(_, f)| f.incident_cells.contains(&i))
+                    .flat_map(|(id, _)| tris[id * 6..id * 6 + 6].iter().copied())
+                    .collect();
+                super::diagnosis::mesh(c, &points, &local, "exact-box-arrangement", false);
+            }
+        }
+        let before = lifecycle(&points, &tris);
+        let (refined, unresolved, quality) =
+            super::assembly::finish(tree, &features, &mut points, &tris, lat.step, tuning, None);
+        if super::cancel::is_cancelled() {
+            return Err(Failure::Cancelled);
+        }
+        let preserved = before == lifecycle(&points, &refined);
+        #[cfg(feature = "sfcc-profile")]
+        {
+            let completed: Vec<_> = self
+                .cells
+                .iter()
+                .map(|c| SfccCell {
+                    degenerate: !preserved,
+                    ..*c
+                })
+                .collect();
+            super::diagnosis::snapshot(*lat, &completed, &[], 0, true);
+        }
+        let (verts, out_tris) = points.build_mesh(&refined);
+        let manifold = super::manifold_check::check_manifold(&out_tris, true);
+        let mut validation = SfccValidation::with_topology(&manifold, true);
+        validation.local_coverage.scope = "alignedBoxArrangement".into();
+        let represented = self
+            .cell_zero_strata
+            .iter()
+            .filter(|counts| counts.iter().any(|&n| n > 0))
+            .count();
+        if preserved {
+            validation.local_coverage.certified_cells = represented;
+            validation.local_coverage.excluded_cells = self.cells.len() - represented;
+        } else {
+            validation.local_coverage.unresolved = self
+                .cells
+                .iter()
+                .map(|c| {
+                    (
+                        (c.level, c.ix, c.iy, c.iz),
+                        "arrangement_cleanup_withdrawal".into(),
+                    )
+                })
+                .collect();
+            validation.unresolved_cells = self.cells.len();
+        }
+        validation.feature_chains = Some(super::feature_chain::audit_feature_chains(
+            &points,
+            &refined,
+            &features,
+            tuning.curve_chord_tol_mm,
+        ));
+        validation.quality = quality;
+        validation.face_segments = AuditStatus::Passed;
+        validation.numerical = super::validation::numerical_failures();
+        validation.numerical.chord_budget += unresolved;
+        validation.check_vertices(tree, &verts, tuning.surface_tol_mm);
+        validation.check_triangles(&verts, &out_tris);
+        let stats = SfccStats {
+            leaves: self.cells.len(),
+            degenerate_cells: 0,
+            faces: self.facets.len(),
+            cross_points: points.count(),
+            tris: out_tris.len() / 3,
+            failed_cells: 0,
+            multi_loop_cells: 0,
+            multi_run_faces: 0,
+            boundary_violations: 0,
+            face_audit_failures: 0,
+            feature_curves: features.curves.len(),
+            edge_cells: 0,
+            corner_cells: 0,
+            feature_cell_fallbacks: 0,
+            re_refine_rounds: 0,
+        };
+        Ok(SfccPipelineResult {
+            feature_edges: points.compacted_curve_edges(&refined),
+            verts,
+            tris: out_tris,
+            stats,
+            manifold,
+            ok: validation.ok(),
+            validation,
+            phase_feature_ms: 0.,
+            phase_octree_ms: 0.,
+            phase_contour_ms: 0.,
+            phase_cellmesh_ms: 0.,
+            phase_assemble_ms: 0.,
+            phase_octree_decide_ms: 0.,
+            phase_octree_apply_ms: 0.,
+            octree_rounds: Vec::new(),
+            cancelled: false,
+        })
+    }
+}
+#[derive(PartialEq, Eq)]
+struct Lifecycle {
+    points: Vec<(super::point_table::PointKey, [u64; 6])>,
+    triangles: Vec<([usize; 3], Option<usize>)>,
+    edges: Vec<(usize, usize, bool, Vec<(usize, u64, u64)>)>,
+}
+fn lifecycle(points: &super::point_table::PointTable, tris: &[usize]) -> Lifecycle {
+    let point_records = (0..points.count())
+        .map(|i| {
+            (
+                points.key_at(i).clone(),
+                super::local_coverage::payload(points, i),
+            )
+        })
+        .collect();
+    let mut triangles = Vec::new();
+    let mut edges = BTreeSet::new();
+    for t in tris.chunks_exact(3) {
+        let p = [t[0], t[1], t[2]];
+        let ordered = [p, [p[1], p[2], p[0]], [p[2], p[0], p[1]]]
+            .into_iter()
+            .min()
+            .unwrap_or(p);
+        triangles.push((ordered, points.patch(p)));
+        for j in 0..3 {
+            let (a, b) = (p[j], p[(j + 1) % 3]);
+            edges.insert((a.min(b), a.max(b)));
+        }
+    }
+    triangles.sort();
+    edges.extend(points.protected_edges());
+    edges.extend(points.identified_edges().map(|(e, _)| e));
+    let edges = edges
+        .into_iter()
+        .map(|(a, b)| {
+            let mut intervals: Vec<_> = points
+                .curve_intervals(a, b)
+                .into_iter()
+                .map(|i| (i.curve_id, i.start.to_bits(), i.end.to_bits()))
+                .collect();
+            intervals.sort();
+            (a, b, points.edge_is_protected(a, b), intervals)
+        })
+        .collect();
+    Lifecycle {
+        points: point_records,
+        triangles,
+        edges,
+    }
+}
+/// Replace only prepared cells whose existing criteria exhausted the depth
+/// budget. Later mesher-only failures retain their inherited recovery behavior.
+pub(crate) fn needed(_tree: &CsgNode, oct: &super::octree::SfccOctree) -> bool {
+    oct.leaves.iter().any(|c| c.degenerate)
+}
+
+const PARTIAL_MAGIC: &[u8; 4] = b"BXC1";
+fn put_word(out: &mut Vec<u8>, word: u64) {
+    out.extend(word.to_le_bytes());
+}
+struct Reader<'a> {
+    bytes: &'a [u8],
+    offset: usize,
+}
+impl<'a> Reader<'a> {
+    fn bytes(&mut self, n: usize) -> Result<&'a [u8], Failure> {
+        let end = self.offset.checked_add(n).ok_or(Failure::CorruptPartial)?;
+        let result = self
+            .bytes
+            .get(self.offset..end)
+            .ok_or(Failure::CorruptPartial)?;
+        self.offset = end;
+        Ok(result)
+    }
+    fn word(&mut self) -> Result<u64, Failure> {
+        Ok(u64::from_le_bytes(
+            self.bytes(8)?
+                .try_into()
+                .map_err(|_| Failure::CorruptPartial)?,
+        ))
+    }
+    fn count(&mut self, limit: usize) -> Result<usize, Failure> {
+        let n = usize::try_from(self.word()?).map_err(|_| Failure::CorruptPartial)?;
+        if n > limit {
+            Err(Failure::Budget)
+        } else {
+            Ok(n)
+        }
+    }
+}
+fn signature(tree: &CsgNode, out: &mut Vec<u64>) -> Result<(), Failure> {
+    fn visit(
+        tree: &CsgNode,
+        out: &mut Vec<u64>,
+        depth: usize,
+        nodes: &mut usize,
+    ) -> Result<(), Failure> {
+        *nodes += 1;
+        if *nodes > MAX_NODES || depth > 64 {
+            return Err(Failure::Budget);
+        }
+        match tree {
+            CsgNode::Leaf(l) => {
+                let _ = super::local_coverage::box_bounds(l).ok_or(Failure::OutsideScope)?;
+                let crate::sdf::Shape::Cuboid { half } = l.shape else {
+                    return Err(Failure::OutsideScope);
+                };
+                out.push(0);
+                out.push(l.sign.to_bits());
+                out.extend(l.pos.map(f64::to_bits));
+                out.extend(half.map(f64::to_bits));
+                out.extend(l.sim.r.map(f64::to_bits));
+                out.push(l.sim.s.to_bits());
+                out.extend(l.sim.t.map(f64::to_bits));
+            }
+            CsgNode::Min(ch) | CsgNode::Max(ch) => {
+                out.extend([
+                    if matches!(tree, CsgNode::Min(_)) {
+                        1
+                    } else {
+                        2
+                    },
+                    ch.len() as u64,
+                ]);
+                for c in ch {
+                    visit(c, out, depth + 1, nodes)?;
+                }
+            }
+            _ => return Err(Failure::OutsideScope),
+        }
+        Ok(())
+    }
+    visit(tree, out, 0, &mut 0)
+}
+
+pub(crate) fn is_partial(bytes: &[u8]) -> bool {
+    bytes.starts_with(PARTIAL_MAGIC)
+}
+pub(crate) fn partial(
+    tree: &CsgNode,
+    plan: &Plan,
+    lat: &SfccLattice,
+    manifest: &[u8],
+    group_index: usize,
+    groups: &[Vec<usize>],
+) -> Result<Vec<u8>, Failure> {
+    let selected: BTreeSet<_> = groups
+        .get(group_index)
+        .ok_or(Failure::CorruptPartial)?
+        .iter()
+        .copied()
+        .collect();
+    let facets: Vec<_> = plan
+        .facets
+        .iter()
+        .enumerate()
+        .filter(|(_, f)| selected.contains(&f.cell))
+        .map(|(i, _)| i)
+        .collect();
+    let (points, tris, _) = plan.tables(lat.step)?;
+    let mut out = PARTIAL_MAGIC.to_vec();
+    put_word(&mut out, manifest.len() as u64);
+    out.extend(manifest);
+    let mut sig = Vec::new();
+    signature(tree, &mut sig)?;
+    put_word(&mut out, sig.len() as u64);
+    for w in sig {
+        put_word(&mut out, w);
+    }
+    put_word(&mut out, groups.len() as u64);
+    put_word(&mut out, group_index as u64);
+    put_word(&mut out, facets.len() as u64);
+    for id in facets {
+        put_word(&mut out, id as u64);
+        for &point in &tris[id * 6..id * 6 + 6] {
+            for w in super::local_coverage::payload(&points, point) {
+                put_word(&mut out, w);
+            }
+        }
+    }
+    Ok(out)
+}
+pub(crate) fn merge(
+    tree: &CsgNode,
+    lat: &SfccLattice,
+    tuning: &super::pipeline::PipelineTuning,
+    partials: &[Vec<u8>],
+) -> Result<super::pipeline::SfccPipelineResult, Failure> {
+    let _guard = super::validation::NumericalGuard::new();
+    let mut common_manifest = None;
+    let mut group_count = None;
+    let mut received_groups = BTreeSet::new();
+    let mut received = BTreeMap::<usize, [[u64; 6]; 6]>::new();
+    let mut expected_signature = Vec::new();
+    signature(tree, &mut expected_signature)?;
+    let mut ownership = BTreeMap::new();
+    for partial in partials {
+        let mut r = Reader {
+            bytes: partial,
+            offset: 0,
+        };
+        if r.bytes(4)? != PARTIAL_MAGIC {
+            return Err(Failure::CorruptPartial);
+        }
+        let n = r.count(56 + MAX_CELLS * 48)?;
+        let manifest = r.bytes(n)?;
+        if common_manifest.is_some_and(|old: &[u8]| old != manifest) {
+            return Err(Failure::CorruptPartial);
+        }
+        common_manifest = Some(manifest);
+        let n = r.count(MAX_NODES * 32)?;
+        if n != expected_signature.len() {
+            return Err(Failure::CorruptPartial);
+        }
+        for &word in &expected_signature {
+            if r.word()? != word {
+                return Err(Failure::CorruptPartial);
+            }
+        }
+        let groups = r.count(MAX_CELLS)?;
+        let group = r.count(groups.saturating_sub(1))?;
+        if groups == 0 || group_count.is_some_and(|n| n != groups) || !received_groups.insert(group)
+        {
+            return Err(Failure::CorruptPartial);
+        }
+        group_count = Some(groups);
+        let n = r.count(MAX_FACETS)?;
+        for _ in 0..n {
+            let id = r.count(MAX_FACETS)?;
+            let mut payload = [[0; 6]; 6];
+            for p in &mut payload {
+                for word in p {
+                    *word = r.word()?;
+                }
+            }
+            if received.insert(id, payload).is_some() {
+                return Err(Failure::CorruptPartial);
+            }
+            ownership.insert(id, group);
+        }
+        if r.offset != partial.len() {
+            return Err(Failure::CorruptPartial);
+        }
+    }
+    let count = group_count.ok_or(Failure::CorruptPartial)?;
+    if received_groups.len() != count {
+        return Err(Failure::CorruptPartial);
+    }
+    let manifest = common_manifest.ok_or(Failure::CorruptPartial)?;
+    // Validate the envelope length before the inherited fixed-layout decoder.
+    if manifest.len() < 56 || &manifest[..4] != 0x53464c33u32.to_le_bytes() {
+        return Err(Failure::CorruptPartial);
+    }
+    let n = usize::try_from(u64::from_le_bytes(
+        manifest[48..56]
+            .try_into()
+            .map_err(|_| Failure::CorruptPartial)?,
+    ))
+    .map_err(|_| Failure::CorruptPartial)?;
+    if n > MAX_CELLS || manifest.len() != 56 + n * 48 {
+        return Err(Failure::CorruptPartial);
+    }
+    let (actual_lat, cells) = super::worker::decode_tagged_leaves(manifest);
+    if actual_lat != *lat {
+        return Err(Failure::CorruptPartial);
+    }
+    let plan = Plan::build(tree, lat, &cells)?;
+    let oct = super::octree::rebuild_octree_from_leaves(tree, lat, cells);
+    if !needed(tree, &oct) {
+        return Err(Failure::CorruptPartial);
+    }
+    let groups = super::pipeline::morton_partition_indices(&oct, count);
+    let mut cell_group = vec![0; plan.cells.len()];
+    for (g, cells) in groups.iter().enumerate() {
+        for &c in cells {
+            cell_group[c] = g;
+        }
+    }
+    let (mut points, tris, features) = plan.tables(lat.step)?;
+    if received.len() != plan.facets.len() {
+        return Err(Failure::CorruptPartial);
+    }
+    // These are actual worker triangle payloads. Rechecking against the complete
+    // independent plan is a proof obligation; accepted wire values feed assembly.
+    let mut transported_tris = Vec::with_capacity(tris.len());
+    for (id, facet) in plan.facets.iter().enumerate() {
+        if ownership.get(&id) != Some(&cell_group[facet.cell]) {
+            return Err(Failure::CorruptPartial);
+        }
+        let data = received.get(&id).ok_or(Failure::CorruptPartial)?;
+        for (j, &point) in tris[id * 6..id * 6 + 6].iter().enumerate() {
+            if data[j] != super::local_coverage::payload(&points, point) {
+                return Err(Failure::CorruptPartial);
+            }
+            let p = data[j].map(f64::from_bits);
+            points.relocate(point, [p[0], p[1], p[2]], [p[3], p[4], p[5]]);
+            transported_tris.push(point);
+        }
+    }
+    plan.finish_tables(tree, lat, tuning, points, transported_tris, features)
+}
