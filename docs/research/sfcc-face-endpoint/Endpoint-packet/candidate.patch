+//! Whole captured face neighborhood: projected union and one source slab, not ideal feature transport.
+use super::fullfan_source_a;
+use crate::sdf::enclosure::Interval as I;
+use crate::sfcc::{mesh_edit::GrowingIndex, predicates::orient2d, triangle_quality as q};
+use serde_json::{json, Value};
+use std::collections::{BTreeMap, BTreeSet};
+type Point = [f64; 3];
+type Result<T> = std::result::Result<T, &'static str>;
+fn edge(a: usize, b: usize) -> [usize; 2] {
+    [a.min(b), a.max(b)]
+}
+fn yz(p: Point) -> [f64; 2] {
+    [p[1], p[2]]
+}
+
+pub(crate) struct Domain {
+    report: Value,
+    triangles: Vec<usize>,
+    export_bounds: Vec<f64>,
+}
+impl Domain {
+    pub(crate) fn report(&self) -> &Value {
+        &self.report
+    }
+}
+
+/// All patches must be distinct emitted triangle families in one provenance-bound ID space.
+pub(crate) fn audit(
+    points: &BTreeMap<usize, Point>,
+    patches: &[Vec<usize>],
+    segments: [[usize; 2]; 2],
+    endpoint: usize,
+) -> Result<Domain> {
+    let count = patches
+        .iter()
+        .try_fold(0usize, |n, p| n.checked_add(p.len()))
+        .ok_or("face_triangle_cap")?;
+    if patches.len() < 2
+        || patches.len() > 4
+        || points.len() > 128
+        || count == 0
+        || count % 3 != 0
+        || count > 3 * 128
+        || patches
+            .iter()
+            .any(|p| p.is_empty() || p.len() % 3 != 0 || !p.contains(&endpoint))
+        || segments
+            .iter()
+            .any(|s| s[0] == s[1] || !s.contains(&endpoint))
+        || edge(segments[0][0], segments[0][1]) == edge(segments[1][0], segments[1][1])
+    {
+        return Err("face_domain_inventory");
+    }
+    let triangles: Vec<_> = patches.iter().flatten().copied().collect();
+    let used: BTreeSet<_> = triangles.iter().copied().collect();
+    if used.len() > 128
+        || used.iter().any(|id| {
+            *id >= 4096
+                || points
+                    .get(id)
+                    .is_none_or(|p| p.iter().any(|v| !v.is_finite()))
+        })
+    {
+        return Err("face_point_inventory");
+    }
+    let n = count / 3;
+    let pair_checks = n
+        .checked_mul(n.saturating_sub(1))
+        .ok_or("face_contact_cap")?
+        / 2;
+    if pair_checks > 4096 {
+        return Err("face_contact_cap");
+    }
+    let topology = crate::sfcc::private_arc_a::stage4_component_b::topology(
+        &triangles,
+        used.last().copied().ok_or("face_empty")? + 1,
+    )?;
+    if topology["localTopologyValid"] != true {
+        return Err("face_indexed_topology");
+    }
+    let mut edges: BTreeMap<[usize; 2], Vec<(usize, [usize; 2])>> = BTreeMap::new();
+    for (i, t) in triangles.chunks_exact(3).enumerate() {
+        for k in 0..3 {
+            let d = [t[k], t[(k + 1) % 3]];
+            edges.entry(edge(d[0], d[1])).or_default().push((i, d));
+        }
+    }
+    for s in segments {
+        let uses = edges
+            .get(&edge(s[0], s[1]))
+            .ok_or("face_missing_shared_segment")?;
+        if uses.len() != 2 || uses[0].1 != [uses[1].1[1], uses[1].1[0]] {
+            return Err("face_shared_segment_incidence");
+        }
+    }
+    let mut seen = BTreeSet::new();
+    let mut todo = vec![0usize];
+    while let Some(i) = todo.pop() {
+        if seen.insert(i) {
+            let t = &triangles[3 * i..3 * i + 3];
+            for k in 0..3 {
+                for &(j, _) in &edges[&edge(t[k], t[(k + 1) % 3])] {
+                    if j != i {
+                        todo.push(j);
+                    }
+                }
+            }
+        }
+    }
+    if seen.len() != n {
+        return Err("face_disconnected_triangles");
+    }
+    let boundary: Vec<[usize; 2]> = serde_json::from_value(topology["boundaryEdges"].clone())
+        .map_err(|_| "face_boundary_encoding")?;
+    if boundary.is_empty() || boundary.iter().any(|e| e.contains(&endpoint)) {
+        return Err("face_endpoint_not_interior");
+    }
+    let mut next = BTreeMap::new();
+    let mut incoming = BTreeSet::new();
+    for e in &boundary {
+        if next.insert(e[0], e[1]).is_some() || !incoming.insert(e[1]) {
+            return Err("face_boundary_degree");
+        }
+    }
+    let start = *next.keys().next().ok_or("face_boundary_empty")?;
+    let mut cycle = Vec::new();
+    let mut current = start;
+    loop {
+        if cycle.contains(&current) {
+            return Err("face_boundary_repeated_vertex");
+        }
+        cycle.push(current);
+        current = *next.get(&current).ok_or("face_boundary_gap")?;
+        if current == start {
+            break;
+        }
+        if cycle.len() >= next.len() {
+            return Err("face_boundary_not_closed");
+        }
+    }
+    if cycle.len() != next.len() {
+        return Err("face_multiple_boundary_cycles");
+    }
+    let mut winding = 0i8;
+    for rounded in [false, true] {
+        let mut projected = Vec::new();
+        for id in &used {
+            let p = points[id];
+            let p = if rounded { q::rounded(p) } else { p };
+            if p.iter().any(|v| !v.is_finite()) || projected.contains(&yz(p)) {
+                return Err("face_projected_vertex_collision");
+            }
+            projected.push(yz(p));
+        }
+        let mut index = GrowingIndex::new();
+        let mut this_winding = 0;
+        for t in triangles.chunks_exact(3) {
+            let ids = [t[0], t[1], t[2]];
+            let p = ids.map(|id| {
+                let p = points[&id];
+                let p = if rounded { q::rounded(p) } else { p };
+                [0., p[1], p[2]]
+            });
+            let sign = orient2d(yz(p[0]), yz(p[1]), yz(p[2]));
+            if sign == 0 || (this_winding != 0 && sign != this_winding) {
+                return Err("face_projected_fold");
+            }
+            this_winding = sign;
+            if index.conflicts(ids, p) {
+                return Err("face_projected_contact_working_or_exported");
+            }
+            index.extend([(ids, p)]);
+        }
+        if rounded && this_winding != winding {
+            return Err("face_export_orientation_reversal");
+        }
+        winding = this_winding;
+    }
+    let mut export_bounds = Vec::with_capacity(n);
+    for t in triangles.chunks_exact(3) {
+        let mut bound = 0.0_f64;
+        for id in t {
+            let p = points[id];
+            let rounded = q::rounded(p);
+            let mut norm = I::point(0.);
+            for k in 0..3 {
+                norm = norm
+                    .add(
+                        crate::sfcc::loft_seam::square(
+                            I::point(p[k])
+                                .sub(I::point(rounded[k]))
+                                .ok_or("face_rounding_bound")?,
+                        )
+                        .ok_or("face_rounding_bound")?,
+                    )
+                    .ok_or("face_rounding_bound")?;
+            }
+            bound = bound.max(norm.hi.sqrt().next_up());
+        }
+        if !bound.is_finite() {
+            return Err("face_rounding_bound");
+        }
+        export_bounds.push(bound);
+    }
+    let report = json!({"scope":"complete supplied triangle union around both captured contour segments; source and ideal feature constraints are separate",
+        "triangles":triangles,"patchTriangleCounts":patches.iter().map(|p|p.len()/3).collect::<Vec<_>>(),
+        "pointBits":used.iter().map(|id|json!([id,points[id].map(f64::to_bits)])).collect::<Vec<_>>(),
+        "sharedSegments":segments,"commonEndpoint":endpoint,"endpointIsInterior":true,
+        "connectedIndexedDisk":true,"workingAndExportedProjectedUnionEmbedded":true,"projectedWinding":winding,
+        "trianglePairsCheckedPerPrecision":pair_checks,"outerBoundary":cycle,"topology":topology,
+        "sourceGraphProvedHere":false,"idealFeatureEndpointProved":false,"publicationReady":false});
+    Ok(Domain {
+        report,
+        triangles,
+        export_bounds,
+    })
+}
+
+pub(crate) fn combine_error(domain: &Domain, source: &Value, tolerance: f64) -> Result<Value> {
+    let bounds: Vec<f64> = serde_json::from_value(source["perTriangleSourceBounds"].clone())
+        .map_err(|_| "face_source_bounds")?;
+    if bounds.len() != domain.export_bounds.len()
+        || source["triangleCount"].as_u64() != Some(bounds.len() as u64)
+        || source["fullClosedTriangleDomainsCovered"] != true
+        || source["sharedEdgeRootsAgreeByCommonSlabUniqueness"] != true
+        || source["tolerance"].as_f64().map(f64::to_bits) != Some(tolerance.to_bits())
+        || !tolerance.is_finite()
+        || tolerance <= 0.
+        || domain.report["projectedWinding"] != -1
+    {
+        return Err("face_source_scope");
+    }
+    let mut upper = 0.0_f64;
+    for (&a, &b) in bounds.iter().zip(&domain.export_bounds) {
+        if !a.is_finite() || a < 0. || !b.is_finite() || b < 0. {
+            return Err("face_error_bound");
+        }
+        upper = upper.max(I::point(a).add(I::point(b)).ok_or("face_error_bound")?.hi);
+    }
+    if upper > tolerance {
+        return Err("face_error_tolerance");
+    }
+    Ok(
+        json!({"conditionalSourceToExportUpper":upper,"tolerance":tolerance,
+        "sourceAndGeometryTriangleOrderMustBeBound":true,"commonEndpointSurfaceRootUnique":true,
+        "bothContourSourceTracesCompatible":true,"idealFeatureEndpointProved":false,"publicationReady":false}),
+    )
+}
+
+fn quotient(a: I, b: I) -> Option<I> {
+    if b.lo <= 0. && b.hi >= 0. {
+        return None;
+    }
+    crate::sfcc::loft_seam::mul(
+        a,
+        crate::sfcc::loft_seam::interval((1. / b.hi).next_down(), (1. / b.lo).next_up())?,
+    )
+}
+fn graph_jacobian_upper(p: [Point; 3]) -> Option<f64> {
+    use crate::sfcc::loft_seam::{mul, square};
+    let mut a = [I::point(0.); 3];
+    let mut b = a;
+    for k in 0..3 {
+        a[k] = I::point(p[1][k]).sub(I::point(p[0][k]))?;
+        b[k] = I::point(p[2][k]).sub(I::point(p[0][k]))?;
+    }
+    let determinant = mul(a[1], b[2])?.sub(mul(a[2], b[1])?)?;
+    let x_y = quotient(mul(a[0], b[2])?.sub(mul(a[2], b[0])?)?, determinant)?;
+    let x_z = quotient(mul(a[1], b[0])?.sub(mul(a[0], b[1])?)?, determinant)?;
+    let squared = I::point(1.).add(square(x_y)?)?.add(square(x_z)?)?;
+    let result = squared.hi.sqrt().next_up();
+    result.is_finite().then_some(result)
+}
+
+/// The target is an enclosure of an independently proved exact source point, never its midpoint.
+/// Caller must bind source and target certificates to the same input/source instance.
+pub(crate) fn endpoint_transport(
+    domain: &Domain,
+    points: &BTreeMap<usize, Point>,
+    source: &Value,
+    endpoint: usize,
+    target: [I; 3],
+    tolerance: f64,
+) -> Result<Value> {
+    use crate::sfcc::loft_seam::{mul, square};
+    let base = combine_error(domain, source, tolerance)?;
+    if domain.triangles.len() > 3 * 128
+        || points.len() > 128
+        || domain.report["commonEndpoint"].as_u64() != Some(endpoint as u64)
+        || domain.report["endpointIsInterior"] != true
+        || target
+            .iter()
+            .any(|v| !v.lo.is_finite() || !v.hi.is_finite() || v.lo > v.hi)
+    {
+        return Err("endpoint_transport_scope");
+    }
+    let used: BTreeSet<_> = domain.triangles.iter().copied().collect();
+    if used.iter().any(|id| {
+        points
+            .get(id)
+            .is_none_or(|p| p.iter().any(|x| !x.is_finite()))
+    }) {
+        return Err("endpoint_transport_points");
+    }
+    let bits = json!(used
+        .iter()
+        .map(|id| json!([id, points[id].map(f64::to_bits)]))
+        .collect::<Vec<_>>());
+    if bits != domain.report["pointBits"] {
+        return Err("endpoint_transport_point_binding");
+    }
+    let slab: [f64; 2] = serde_json::from_value(source["commonWorldXSlab"].clone())
+        .map_err(|_| "endpoint_transport_slab")?;
+    if slab.iter().any(|x| !x.is_finite())
+        || slab[0] >= slab[1]
+        || target[0].lo <= slab[0]
+        || target[0].hi >= slab[1]
+    {
+        return Err("endpoint_transport_slab");
+    }
+    let original = *points.get(&endpoint).ok_or("endpoint_transport_point")?;
+    let mut motion2 = I::point(0.);
+    for k in 1..3 {
+        motion2 = motion2
+            .add(
+                square(
+                    target[k]
+                        .sub(I::point(original[k]))
+                        .ok_or("endpoint_transport_arithmetic")?,
+                )
+                .ok_or("endpoint_transport_arithmetic")?,
+            )
+            .ok_or("endpoint_transport_arithmetic")?;
+    }
+    let beta = motion2.hi.sqrt().next_up();
+    let mut minimum_margin = f64::INFINITY;
+    let mut jacobian = 0.0_f64;
+    let mut star_rows = Vec::new();
+    for (index, t) in domain.triangles.chunks_exact(3).enumerate() {
+        let Some(k) = t.iter().position(|&id| id == endpoint) else {
+            continue;
+        };
+        let a = points[&t[(k + 1) % 3]];
+        let b = points[&t[(k + 2) % 3]];
+        let sign = orient2d(yz(a), yz(b), yz(original));
+        if sign == 0 {
+            return Err("endpoint_transport_degenerate_star");
+        }
+        let dy = I::point(b[1])
+            .sub(I::point(a[1]))
+            .ok_or("endpoint_transport_arithmetic")?;
+        let dz = I::point(b[2])
+            .sub(I::point(a[2]))
+            .ok_or("endpoint_transport_arithmetic")?;
+        let ty = target[1]
+            .sub(I::point(a[1]))
+            .ok_or("endpoint_transport_arithmetic")?;
+        let tz = target[2]
+            .sub(I::point(a[2]))
+            .ok_or("endpoint_transport_arithmetic")?;
+        let margin = mul(dy, tz)
+            .and_then(|v| v.sub(mul(dz, ty)?))
+            .and_then(|v| v.mul(sign as f64))
+            .ok_or("endpoint_transport_arithmetic")?;
+        if margin.lo <= 0. {
+            return Err("endpoint_transport_outside_star_kernel");
+        }
+        let local = graph_jacobian_upper([points[&t[0]], points[&t[1]], points[&t[2]]])
+            .ok_or("endpoint_transport_jacobian")?;
+        minimum_margin = minimum_margin.min(margin.lo);
+        jacobian = jacobian.max(local);
+        star_rows.push(json!({"triangle":index,"oppositeEdge":[t[(k+1)%3],t[(k+2)%3]],"signedKernelMarginLower":margin.lo,"meshGraphJacobianUpper":local}));
+    }
+    if star_rows.len() < 3 || star_rows.len() > 128 {
+        return Err("endpoint_transport_star_inventory");
+    }
+    let source_bounds: Vec<f64> = serde_json::from_value(source["perTriangleSourceBounds"].clone())
+        .map_err(|_| "endpoint_transport_source_bounds")?;
+    let delta = source_bounds.iter().copied().fold(0., f64::max);
+    let eta = domain.export_bounds.iter().copied().fold(0., f64::max);
+    let extra = I::point(jacobian)
+        .mul(beta)
+        .ok_or("endpoint_transport_arithmetic")?
+        .hi;
+    let total = I::point(delta)
+        .add(I::point(extra))
+        .and_then(|v| v.add(I::point(eta)))
+        .ok_or("endpoint_transport_arithmetic")?
+        .hi;
+    if !beta.is_finite() || !extra.is_finite() || !total.is_finite() || total > tolerance {
+        return Err("endpoint_transport_error_limit");
+    }
+    Ok(
+        json!({"scope":"piecewise-affine projected interior-vertex transport conditional on the bound source graph and exact feature-root certificate",
+        "endpoint":endpoint,"targetImage":[target.map(|v|v.lo),target.map(|v|v.hi)],"exactFeatureRootCertificateRequired":true,
+        "starTriangles":star_rows,"strictStarKernelMarginLower":minimum_margin,"projectedVertexMotionUpper":beta,
+        "meshGraphJacobianUpper":jacobian,"additionalWorkingErrorUpper":extra,"uniformSourceBound":delta,"uniformExportRoundingBound":eta,
+        "sourceToExportAfterTransportUpper":total,"tolerance":tolerance,"originalComposedBound":base,
+        "starBoundaryAndOuterBoundaryFixed":true,"projectedDomainMapsOntoItself":true,"commonSourceSlabContainsTarget":true,
+        "theorem":"kernel convexity preserves every intermediate star triangulation; T fixes its boundary; |Phi(Tu)-M(u)| <= delta + L_mesh*beta, followed by export rounding",
+        "noAdditionalSourceCertificateCall":true,"sourceFeatureCurveParameterizationProved":false,"meshMutationPerformed":false,"publicationReady":false}),
+    )
+}
