// Extrude, Loft & Lathe Demo
// Demonstrates 2D polygon extrusion, lofting, and revolution

function scene() {
    // === EXTRUDE: Triangle ===
    const tri = polygon2d([[-5, -3], [5, -3], [0, 5]])
    const extrudedTri = extrude(tri, { h: 4 })

    // === EXTRUDE: L-shaped profile with position offset ===
    const lShape = polygon2d([
        [-3, -3], [3, -3], [3, -1], [-1, -1], [-1, 3], [-3, 3]
    ])
    const extrudedL = extrude([20, 0, 0], lShape, { h: 5 })

    // === LOFT: Square to triangle ===
    const square = polygon2d([[-4, -4], [4, -4], [4, 4], [-4, 4]])
    const triangle = polygon2d([[-2, -2], [2, -2], [0, 3]])
    const lofted = loft([0, 0, -20], square, triangle, { h: 8 })

    // === LATHE: Vase ===
    // Profile is in (radius, height) space — revolved around Y axis
    const vaseProfile = polygon2d([
        [0, -5], [3, -5], [3.5, -4.5], [2, -2],
        [1.5, 0], [2, 3], [3, 4.5], [2.5, 5], [0, 5]
    ])
    const vase = lathe([-20, 0, 0], vaseProfile)

    // === ASSEMBLY ===
    return union(
        extrudedTri,
        extrudedL,
        lofted,
        vase
    )
}
