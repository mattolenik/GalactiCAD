+            || parent.path[..parent.path.len() - 1] != path[..]
+            || cylinder.path.len() != path.len() + 1
+            || !cylinder.path.starts_with(path)
+            || cylinder.path.last() != Some(&1)
+        {
+            return false;
+        }
+        let mut node = self.root.as_ref();
+        for (&i, &partner) in path.iter().zip(self.partners.iter()) {
+            let children = match node {
+                CsgNode::Blend { children, .. }
+                    if children.len() == 2 && i < 2 && partner == 1 - i =>
+                {
+                    children
+                }
+                CsgNode::Max(children) if children.len() == 2 && i < 2 && partner == usize::MAX => {
+                    children
+                }
+                _ => return false,
+            };
+            node = &children[i];
+        }
+        matches!(node,CsgNode::Max(c) if c.len()==2)
+    }
