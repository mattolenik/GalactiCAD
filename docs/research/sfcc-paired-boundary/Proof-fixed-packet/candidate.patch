+            "rangeBits":[curve.t_min.to_bits(),curve.t_max.to_bits()],"cornerEnds":[curve.corner_start,curve.corner_end],
+            "stratumSources":curve.adjacent_strata.map(|sid|f.strata[sid].graph_capture_identity_b())}));
+    }
+    let candidate_memberships:Vec<_>=candidate.points.identified_edges().filter(|((a,b),_)|candidate_edge.contains(a)||candidate_edge.contains(b))
+        .flat_map(|((a,b),is)|is.iter().map(move |i|json!({"edge":[a,b],"chart":i.curve_id,"rangeBits":[i.start.to_bits(),i.end.to_bits()]}))).collect();
+    if candidate_memberships.len()>2048 {return Err("paired_membership_cap");}
+    let receipt=json!({"scope":"actual source-bound first fan and unique original opposite face consumer; no geometry authority",
+        "face":face,"consumers":consumers,"insideCell":inside.0,"outsideCell":outside.0,"globalEdgeInCandidateOrder":global_edge,
+        "candidateEdge":candidate_edge,"originalSegments":record.segments.iter().map(|s|[s.a,s.b]).collect::<Vec<_>>(),
+        "originalPins":source_rows,"candidateMembershipsAtSharedPoints":candidate_memberships,"sourceFingerprint":f.fingerprint().to_string(),
+        "publicationAuthorized":false});
+    Ok(PairedTarget{face,outside:outside.0,global_edge,candidate_edge,candidate_fan:fan.clone(),receipt})
+}
+fn select_paired_fan(capture:&Value, edge:[usize;2])->Result<Value> {
+    if capture["complete"]!=true {return Err("paired_fan_capture_incomplete");}
+    let fans=capture["pairedFans"].as_array().ok_or("paired_fan_capture_missing")?;
+    if fans.len()>128 {return Err("paired_fan_capture_cap");}
+    let mut selected=None;
+    for fan in fans {
+        let boundary:Vec<usize>=serde_json::from_value(fan["boundary"].clone()).map_err(|_|"paired_fan_boundary")?;
+        if boundary.len()>64 {return Err("paired_fan_boundary_cap");}
+        let forward=directed_occurrences(&boundary,edge);
+        let reverse=directed_occurrences(&boundary,[edge[1],edge[0]]);
+        if forward+reverse>0 {
+            if forward!=1 || reverse!=0 || selected.is_some() || fan["returned"]!=true {
+                return Err("paired_fan_edge_incidence");
+            }
+            selected=Some(fan.clone());
+        }
+    }
+    selected.ok_or("paired_shared_edge_fan_missing")
+}
+fn require_emitted_fan(fan:&Value,emitted:&[usize])->Result<()> {
+    let triangles:Vec<usize>=serde_json::from_value(fan["triangles"].clone()).map_err(|_|"paired_fan_triangles")?;
+    if triangles.is_empty() || triangles.len()>3*128 || triangles.len()%3!=0 || emitted.len()%3!=0
+        || triangles.chunks_exact(3).any(|t|!emitted.chunks_exact(3).any(|m|m==t)) {
+        return Err("paired_fan_not_in_returned_mesh");
+    }
+    Ok(())
+}
+fn require_final_fan(fan:&Value,emitted:&[usize],points:&PointTable)->Result<()> {
+    require_emitted_fan(fan,emitted)?;
+    let rows=fan["points"].as_array().ok_or("paired_fan_point_payload")?;
+    if rows.len()>128 {return Err("paired_fan_point_cap");}
+    for value in fan["boundary"].as_array().ok_or("paired_fan_boundary")?.iter()
+        .chain(fan["triangles"].as_array().ok_or("paired_fan_triangles")?) {
+        let id=value.as_u64().ok_or("paired_fan_point_id")? as usize;
+        if id>=points.count() {return Err("paired_fan_point_payload");}
+        let mut found=rows.iter().filter(|row|row["id"].as_u64()==Some(id as u64));
+        let row=found.next().ok_or("paired_fan_point_payload")?;
+        if found.next().is_some() || row["positionBits"]!=json!(q::pos(points,id).map(f64::to_bits)) {
+            return Err("paired_fan_point_payload");
+        }
+    }
+    Ok(())
