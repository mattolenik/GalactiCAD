+//! Source-bound three-chart transition. No discovery ownership predicate changes.
+use super::*;
+use crate::sfcc::{
+    feature_curves::FeatureCurve,
+    feature_set::{SfccCorner, SfccFeatureSet},
+};
+
+#[derive(Clone)]
+pub(crate) struct UpperChart {
+    cert: UpperCertificate,
+    source_root: std::sync::Arc<CsgNode>,
+    embedded: [Stratum; 2],
+    /// Incoming last span or outgoing first span, in the remade chart.
+    pub span: [f64; 2],
+    outgoing: bool,
+    join_y: f64,
+    join_phi: f64,
+    ends: [[f64; 3]; 2],
+    source_pair: [usize; 2],
+    event_curves: [usize; 3],
+    original_curve: usize,
+    original_range: [f64; 2],
+    allowance: f64,
+}
+impl std::fmt::Debug for UpperChart {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_tuple("UpperChart").field(&self.words()).finish()
+    }
+}
+fn distance(point: [f64; 3], image: ([f64; 3], [f64; 3])) -> Option<f64> {
+    let mut sum = I::point(0.);
+    for k in 0..3 {
+        sum = sum.add(square(
+            I::point(point[k]).sub(interval(image.0[k], image.1[k])?)?,
+        )?)?;
+    }
+    Some(sqrt(sum)?.hi)
+}
+fn middle(image: ([f64; 3], [f64; 3])) -> [f64; 3] {
+    std::array::from_fn(|k| image.0[k] * 0.5 + image.1[k] * 0.5)
+}
+impl UpperCertificate {
+    fn same_contract(&self, b: &Self) -> bool {
+        self.source == b.source
+            && self.branch.p == b.branch.p
+            && self.branch.cylinder == b.branch.cylinder
+            && self.branch.sign == b.branch.sign
+            && [self.branch.u.lo.to_bits(), self.branch.u.hi.to_bits()]
+                == [b.branch.u.lo.to_bits(), b.branch.u.hi.to_bits()]
+            && [
+                self.outer_radius,
+                self.sphere_radius,
+                self.sphere_y,
+                self.phi_max,
+                self.transition_y.lo,
+                self.transition_y.hi,
+            ]
+            .map(f64::to_bits)
+                == [
+                    b.outer_radius,
+                    b.sphere_radius,
+                    b.sphere_y,
+                    b.phi_max,
+                    b.transition_y.lo,
+                    b.transition_y.hi,
+                ]
+                .map(f64::to_bits)
+    }
+    fn incoming_image(&self, y: I) -> Option<([f64; 3], [f64; 3])> {
+        let p = self.branch.p;
+        let theta =
+            div(y.sub(I::point(p.pos_y))?.add(I::point(p.h))?, 2. * p.h)?.mul(p.twist_rad)?;
+        let (s, c) = sin_cos(theta)?;
+        let q = [
+            mul(self.branch.u, c)?
+                .sub(s.mul(p.v0z)?)?
+                .add(I::point(p.pos_x))?,
+            y,
+            mul(self.branch.u, s)?
+                .add(c.mul(p.v0z)?)?
+                .add(I::point(p.pos_z))?,
+        ];
+        Some((q.map(|i| i.lo), q.map(|i| i.hi)))
+    }
+    fn phi_for(&self, point: [f64; 3], eps: f64) -> Option<f64> {
+        let low = self.image(I::point(0.))?.y;
+        let high = self.image(I::point(self.phi_max))?.y;
+        if point[1] <= low.hi || point[1] >= high.lo {
+            return None;
+        }
+        let (mut a, mut b) = (0., self.phi_max);
+        for _ in 0..64 {
+            let m = a + (b - a) * 0.5;
+            if m == a || m == b {
+                break;
+            }
+            let image = self.point_image(m)?;
+            if distance(point, image)? <= eps * 0.25 {
+                return Some(m);
+            }
+            if (image.0[1] * 0.5 + image.1[1] * 0.5) < point[1] {
+                a = m;
+            } else {
+                b = m;
+            }
+        }
+        let m = a + (b - a) * 0.5;
+        (distance(point, self.point_image(m)?)? <= eps).then_some(m)
+    }
+}
+impl UpperChart {
+    pub(crate) fn private_owned_storage(
+        &self,
+        ledger: &mut crate::sfcc::source_storage_a::Ledger,
+    ) -> crate::sfcc::source_storage_a::Result<()> {
+        let Self {
+            cert,
+            source_root,
+            embedded,
+            span,
+            outgoing,
+            join_y,
+            join_phi,
+            ends,
+            source_pair,
+            event_curves,
+            original_curve,
+            original_range,
+            allowance,
+        } = self;
+        ledger.shared("shared.source_root_handle", source_root)?;
+        for s in embedded {
+            s.private_owned_storage_a(ledger)?;
+        }
+        ledger.inline_copy(&(
+            *span,
+            *outgoing,
+            *join_y,
+            *join_phi,
+            *ends,
+            *source_pair,
+            *event_curves,
+            *original_curve,
+            *original_range,
+            *allowance,
+        ));
+        let UpperCertificate {
+            source,
+            branch,
+            outer_radius,
+            sphere_radius,
+            sphere_y,
+            phi_max,
+            margins,
+            transition_y,
+            height_derivative_lower,
+            transverse_minor_lower,
+        } = cert;
+        ledger.inline_copy(&(
+            *source,
+            *outer_radius,
+            *sphere_radius,
+            *sphere_y,
+            *phi_max,
+            *margins,
+            *transition_y,
+            *height_derivative_lower,
+            *transverse_minor_lower,
+        ));
+        let HelixBranch {
+            native,
+            field,
+            cylinder_id,
+            p,
+            cylinder,
+            u,
+            sign,
+        } = branch;
+        ledger.inline_copy(&(*native, *field, *cylinder_id, *p, *cylinder, *u, *sign));
+        Ok(())
+    }
+    pub(crate) fn installation_matches(
+        &self,
+        c: &FeatureCurve,
+        index: usize,
+        outgoing: bool,
+    ) -> bool {
+        if self.original_curve != c.id
+            || self.source_pair != c.adjacent_strata
+            || self.outgoing != outgoing
+        {
+            return false;
+        }
+        let span = if outgoing {
+            [0., 1.]
+        } else {
+            [index as f64, index as f64 + 1.]
+        };
+        if self.span.map(f64::to_bits) != span.map(f64::to_bits)
+            || self.original_range[0] != (if outgoing { 0. } else { index as f64 })
+        {
+            return false;
+        }
+        let (a, b, _) = match c.traced_carriers() {
+            Some(v) => v,
+            None => return false,
+        };
+        if !a.connection_same_source(&self.embedded[0])
+            || !b.connection_same_source(&self.embedded[1])
+        {
+            return false;
+        }
+        if outgoing {
+            if index != 0 || self.original_range != [0., 1.] {
+                return false;
+            }
+            let Some(start) = checked(c, 0.) else {
+                return false;
+            };
+            let Some(phi) = self.cert.phi_for(start, self.allowance) else {
+                return false;
+            };
+            if phi <= 0. || phi >= self.join_phi {
+                return false;
+            }
+            checked(c, 1.).is_some_and(|p| p.map(f64::to_bits) == self.ends[1].map(f64::to_bits))
+        } else {
+            let t = self.original_range[1];
+            if t <= index as f64 || t >= index as f64 + 1. || t > c.t_max {
+                return false;
+            }
+            checked(c, index as f64)
+                .is_some_and(|p| p.map(f64::to_bits) == self.ends[0].map(f64::to_bits))
+                && checked(c, t).is_some_and(|p| {
+                    distance(p, (self.ends[1], self.ends[1])).is_some_and(|d| d <= self.allowance)
+                })
+        }
+    }
+    #[cfg(test)]
+    pub(crate) fn clone_equal(&self, b: &Self) -> bool {
+        std::sync::Arc::ptr_eq(&self.source_root, &b.source_root)
+            && self.words() == b.words()
+            && self
+                .embedded
+                .iter()
+                .zip(&b.embedded)
+                .all(|(a, b)| a.private_storage_clone_equal_a(b))
+    }
+    #[cfg(test)]
+    pub(crate) fn corrupt_start(&mut self) {
+        self.ends[0][0] += 0.1;
+    }
+    pub(crate) fn contains(&self, t: f64) -> bool {
+        t.is_finite() && t >= self.span[0] && t <= self.span[1]
+    }
+    fn fraction(&self, t: f64) -> Option<f64> {
+        if !self.contains(t) || self.span[0] >= self.span[1] {
+            return None;
+        }
+        Some(((t - self.span[0]) / (self.span[1] - self.span[0])).clamp(0., 1.))
+    }
+    fn ideal_image(&self, a: f64, b: f64) -> Option<([f64; 3], [f64; 3])> {
+        let u = interval(self.fraction(a)?, self.fraction(b)?)?;
+        if self.outgoing {
+            let phi = u.mul(self.join_phi)?;
+            let image = self
+                .cert
+                .image(interval(phi.lo.max(0.), phi.hi.min(self.join_phi))?)?;
+            Some((image.xyz.map(|i| i.lo), image.xyz.map(|i| i.hi)))
+        } else {
+            let y = I::point(self.join_y)
+                .add(mul(self.cert.transition_y.sub(I::point(self.join_y))?, u)?)?;
+            self.cert.incoming_image(y)
+        }
+    }
+    pub(crate) fn image(&self, a: f64, b: f64) -> Option<([f64; 3], [f64; 3])> {
+        let (mut lo, mut hi) = self.ideal_image(a, a)?;
+        let mut previous = a;
+        for i in 1..=16 {
+            let next = if i == 16 {
+                b
+            } else {
+                a + (b - a) * i as f64 / 16.
+            };
+            let (l, h) = self.ideal_image(previous, next)?;
+            for k in 0..3 {
+                lo[k] = lo[k].min(l[k]);
+                hi[k] = hi[k].max(h[k]);
+            }
+            previous = next;
+        }
+        for (t, p) in [(self.span[0], self.ends[0]), (self.span[1], self.ends[1])] {
+            if a <= t && t <= b {
+                for k in 0..3 {
+                    lo[k] = lo[k].min(p[k]);
+                    hi[k] = hi[k].max(p[k]);
+                }
+            }
+        }
+        Some((lo, hi))
+    }
+    pub(crate) fn point(&self, t: f64) -> Option<[f64; 3]> {
+        let image = self.ideal_image(t, t)?;
+        let q = if t == self.span[0] {
+            self.ends[0]
+        } else if t == self.span[1] {
+            self.ends[1]
+        } else {
+            middle(image)
+        };
+        (distance(q, image)? <= self.allowance).then_some(q)
+    }
+    pub(crate) fn tangent(&self, t: f64) -> Option<[f64; 3]> {
+        let p = self.cert.branch.p;
+        let s = self.fraction(t)?;
+        let k = p.twist_rad / (2. * p.h);
+        let (u, v, up, vp, yp, y) = if self.outgoing {
+            let phi = s * self.join_phi;
+            let (sn, cs) = phi.sin_cos();
+            let r = self.cert.outer_radius;
+            let a = r * (cs - 1.);
+            let rho = self.cert.branch.cylinder.2 + a;
+            let q = self.cert.sphere_radius + r * (sn - 1.);
+            let y = self.cert.sphere_y + (q * q - rho * rho).sqrt();
+            let v = p.v0z + a * p.nz2;
+            let u = self.cert.branch.sign as f64 * (rho * rho - v * v).sqrt();
+            let rp = -r * sn;
+            let vp = rp * p.nz2;
+            let up = (rho * rp - v * vp) / u;
+            let yp = r * (q * cs + rho * sn) / (y - self.cert.sphere_y);
+            (u, v, up, vp, yp, y)
+        } else {
+            let y = self.point(t)?[1];
+            (
+                self.cert.branch.u.lo * 0.5 + self.cert.branch.u.hi * 0.5,
+                p.v0z,
+                0.,
+                0.,
+                1.,
+                y,
+            )
+        };
+        let theta = k * (y - p.pos_y + p.h);
+        let (sn, cs) = theta.sin_cos();
+        let q = [
+            up * cs - vp * sn - k * yp * (u * sn + v * cs),
+            yp,
+            up * sn + vp * cs + k * yp * (u * cs - v * sn),
+        ];
+        let n = q[0].hypot(q[1]).hypot(q[2]);
+        (n.is_finite() && n > 0.).then_some(q.map(|x| x / n))
+    }
+    pub(crate) fn words(&self) -> Vec<u64> {
+        let p = self.cert.branch.p;
+        let mut out = vec![self.outgoing as u64, self.original_curve as u64];
+        out.extend(self.source_pair.map(|i| i as u64));
+        out.extend(self.event_curves.map(|i| i as u64));
+        out.extend(self.cert.source.map(|i| i as u64));
+        out.extend(
+            [
+                p.pos_x,
+                p.pos_y,
+                p.pos_z,
+                p.h,
+                p.twist_rad,
+                p.v0z,
+                p.nz2,
+                self.cert.branch.sign as f64,
+                self.cert.branch.cylinder.2,
+                self.cert.outer_radius,
+                self.cert.sphere_radius,
+                self.cert.sphere_y,
+                self.cert.phi_max,
+                self.cert.transition_y.lo,
+                self.cert.transition_y.hi,
+                self.span[0],
+                self.span[1],
+                self.join_y,
+                self.join_phi,
+                self.original_range[0],
+                self.original_range[1],
+                self.allowance,
+            ]
+            .map(f64::to_bits),
+        );
+        out.extend(
+            [
+                p.v0x,
+                p.nx2,
+                p.sim.s,
+                self.cert.branch.u.lo,
+                self.cert.branch.u.hi,
+                self.cert.height_derivative_lower,
+                self.cert.transverse_minor_lower,
+            ]
+            .map(f64::to_bits),
+        );
+        out.extend(p.sim.r.map(f64::to_bits));
+        out.extend(p.sim.t.map(f64::to_bits));
+        out.extend(self.cert.branch.cylinder.0.map(f64::to_bits));
+        out.extend(self.cert.branch.cylinder.1.map(f64::to_bits));
+        out.extend(self.cert.margins.map(f64::to_bits));
+        let mut context = crate::sfcc::provenance::IdentityContext::default();
+        for st in &self.embedded {
+            out.push(st.semantic_identity(&mut context));
+        }
+        for q in self.ends {
+            out.extend(q.map(f64::to_bits));
+        }
+        out
+    }
+    pub(crate) fn member(
+        &self,
+        strata: &[Stratum],
+        pair: [usize; 2],
+        sid: usize,
+        t: f64,
+        point: [f64; 3],
+        eps: f64,
+    ) -> bool {
+        if !self.outgoing
+            || pair != self.source_pair
+            || !pair.contains(&sid)
+            || !self.contains(t)
+            || !eps.is_finite()
+            || eps <= 0.
+            || strata.len() > 256
+        {
+            return false;
+        }
+        let [n, f, c] = self.cert.source;
+        let Some(parent) = strata.get(f) else {
+            return false;
+        };
+        let Some(cylinder) = strata.get(c) else {
+            return false;
+        };
+        if !pair.into_iter().enumerate().all(|(i, id)| {
+            strata
+                .get(id)
+                .is_some_and(|s| s.upper_round_child_matches(parent, cylinder, i))
+        }) {
+            return false;
+        }
+        let Some(root) = strata.get(n).and_then(Stratum::exposure_root_a) else {
+            return false;
+        };
+        if !std::ptr::eq(root, self.source_root.as_ref()) {
+            return false;
+        }
+        let Some(rebound) = bind_region(
+            root,
+            strata,
+            &self.cert.branch,
+            self.cert.phi_max,
+            Some(self.join_y),
+        ) else {
+            return false;
+        };
+        if !self.cert.same_contract(&rebound) {
+            return false;
+        }
+        self.ideal_image(t, t)
+            .and_then(|image| distance(point, image))
+            .is_some_and(|d| d <= eps.min(self.allowance))
+    }
+}
+
+fn source_pair(f: &SfccFeatureSet, branch: &HelixBranch) -> Option<[usize; 2]> {
+    let mut ids = [None, None];
+    for s in &f.strata {
+        for child in 0..2 {
+            if s.upper_round_child_matches(
+                &f.strata[branch.field],
+                &f.strata[branch.cylinder_id],
+                child,
+            ) {
+                if ids[child].replace(s.id).is_some() {
+                    return None;
+                }
+            }
+        }
+    }
+    Some([ids[0]?, ids[1]?])
+}
+fn incoming_span(
+    c: &FeatureCurve,
+    cert: &UpperCertificate,
+    eps: f64,
+) -> Option<(usize, f64, [f64; 3])> {
+    if c.closed
+        || c.corner_end >= 0
+        || c.t_min != 0.
+        || c.t_max != c.t_max.floor()
+        || c.t_max > 128.
+    {
+        return None;
+    }
+    let mut found = None;
+    for i in 0..c.t_max as usize {
+        let a = checked(c, i as f64)?;
+        let b = checked(c, i as f64 + 1.)?;
+        if a[1] < cert.transition_y.lo && b[1] > cert.transition_y.hi {
+            if found.is_some() || distance(a, cert.incoming_image(I::point(a[1]))?)? > eps {
+                return None;
+            }
+            let event = middle(cert.point_image(0.)?);
+            let (mut lo, mut hi) = (i as f64, i as f64 + 1.);
+            let mut parameter = None;
+            for _ in 0..64 {
+                let t = lo + (hi - lo) * 0.5;
+                if t == lo || t == hi {
+                    break;
+                }
+                let q = checked(c, t)?;
+                if distance(q, (event, event))? <= eps {
+                    parameter = Some(t);
+                    break;
+                }
+                if q[1] < event[1] {
+                    lo = t;
+                } else {
+                    hi = t;
+                }
+            }
+            let t = parameter?;
+            if !(t > i as f64 && t < (i + 1) as f64) {
+                return None;
+            }
+            // The finite search proposes a mapping; this actual own query accepts it.
+            if distance(checked(c, t)?, (event, event))? > eps {
+                return None;
+            }
+            found = Some((i, t, a));
+        }
+    }
+    found
+}
+
+/// Complete geometric proposal is prepared before any feature set mutation.
+pub(crate) fn connect(
+    root: &CsgNode,
+    f: &mut SfccFeatureSet,
+    tol: &crate::tolerances::ResolvedTolerances,
+) -> usize {
+    #[cfg(test)]
+    if DISABLED.with(std::cell::Cell::get) {
+        return 0;
+    }
+    if f.curves.len() > 256 || f.strata.len() > 256 {
+        return 0;
+    }
+    #[cfg(test)]
+    let _work = WorkScope::begin();
+    let mut proposals = Vec::new();
+    let mut attempts = 0;
+    for p in 0..f.curves.len() {
+        for a in p + 1..f.curves.len() {
+            if proposals.len() >= 8 {
+                break;
+            }
+            let cp = &f.curves[p];
+            let ca = &f.curves[a];
+            if cp.closed
+                || ca.closed
+                || cp.corner_end >= 0
+                || ca.corner_end >= 0
+                || cp.corner_start < 0
+                || cp.corner_start != ca.corner_start
+            {
+                continue;
+            }
+            let Some(tube) = cp.projection_tube(0., 1.) else {
+                continue;
+            };
+            let Some(branch) = HelixBranch::identify(f, p, a, tube) else {
+                continue;
+            };
+            attempts += 1;
+            if attempts > 64 {
+                return 0;
+            }
+            #[cfg(test)]
+            WORK.with(|v| v.borrow_mut().source_attempts = attempts);
+            let Some(cert) = bind(root, &f.strata, &branch, 0.5) else {
+                continue;
+            };
+            let eps = tol.curve_eps * 8.;
+            let Some((pi, pt, pjoin)) = incoming_span(cp, &cert, eps) else {
+                continue;
+            };
+            let Some((ai, at, ajoin)) = incoming_span(ca, &cert, eps) else {
+                continue;
+            };
+            let low = pjoin[1].min(ajoin[1]);
+            let Some(cert) = bind_region(root, &f.strata, &branch, 0.5, Some(low)) else {
+                continue;
+            };
+            let Some(pair) = source_pair(f, &branch) else {
+                continue;
+            };
+            let event = middle(cert.point_image(0.).unwrap());
+            if f.corners.iter().any(|c| {
+                distance([c.x, c.y, c.z], (event, event)).is_some_and(|d| d <= tol.corner_merge_tol)
+            }) {
+                continue;
+            }
+            let mut outgoing = None;
+            let mut ambiguous = false;
+            for c in &f.curves {
+                if c.adjacent_strata != pair
+                    || c.t_max > 128.
+                    || c.closed
+                    || c.corner_start >= 0
+                    || c.t_min != 0.
+                    || c.t_max <= 1.
+                {
+                    continue;
+                }
+                let Some(start) = checked(c, 0.) else {
+                    continue;
+                };
+                let Some(join) = checked(c, 1.) else {
+                    continue;
+                };
+                if start[1] <= cert.transition_y.hi || join[1] <= start[1] {
+                    continue;
+                }
+                let Some(phi0) = cert.phi_for(start, eps) else {
+                    continue;
+                };
+                let Some(phi) = cert.phi_for(join, eps) else {
+                    continue;
+                };
+                if phi <= phi0 {
+                    continue;
+                }
+                if outgoing.replace((c.id, phi, join)).is_some() {
+                    ambiguous = true;
+                    break;
+                }
+            }
+            if ambiguous {
+                continue;
+            }
+            let Some((o, phi, ojoin)) = outgoing else {
+                continue;
+            };
+            let event_curves = [p, a, o];
+            if proposals
+                .iter()
+                .any(|(ids, _, _): &([usize; 3], [FeatureCurve; 3], [f64; 3])| {
+                    ids.iter().any(|i| event_curves.contains(i))
+                })
+            {
+                continue;
+            }
+            let make = |id: usize, index: usize, cut: f64, join: [f64; 3], out: bool| {
+                let span = if out {
+                    [0., 1.]
+                } else {
+                    [index as f64, index as f64 + 1.]
+                };
+                let chart = UpperChart {
+                    cert: cert.clone(),
+                    source_root: f.strata[branch.native].upper_source_root_handle()?,
+                    embedded: {
+                        let (a, b, _) = f.curves[id].traced_carriers()?;
+                        if !a.connection_same_source(&f.strata[f.curves[id].adjacent_strata[0]])
+                            || !b.connection_same_source(&f.strata[f.curves[id].adjacent_strata[1]])
+                        {
+                            return None;
+                        }
+                        [a, b]
+                    },
+                    span,
+                    outgoing: out,
+                    join_y: if out { low } else { join[1] },
+                    join_phi: phi,
+                    ends: if out { [event, join] } else { [join, event] },
+                    source_pair: f.curves[id].adjacent_strata,
+                    event_curves,
+                    original_curve: id,
+                    original_range: if out { [0., 1.] } else { [index as f64, cut] },
+                    allowance: eps,
+                };
+                f.curves[id].with_upper_chart(chart, index, out)
+            };
+            let (Some(pc), Some(ac), Some(oc)) = (
+                make(p, pi, pt, pjoin, false),
+                make(a, ai, at, ajoin, false),
+                make(o, 0, 1., ojoin, true),
+            ) else {
+                continue;
+            };
+            proposals.push((event_curves, [pc, ac, oc], event));
+        }
+    }
+    let count = proposals.len();
+    #[cfg(test)]
+    if REFUSE_COMMIT.with(std::cell::Cell::get) {
+        REFUSED_COUNT.with(|v| v.set(count));
+        return 0;
+    }
+    for (ids, mut curves, event) in proposals {
+        let corner = f.corners.len();
+        curves[0].corner_end = corner as i64;
+        curves[1].corner_end = corner as i64;
+        curves[2].corner_start = corner as i64;
+        let mut strata = Vec::new();
+        for c in &curves {
+            for s in c.adjacent_strata {
+                if !strata.contains(&s) {
+                    strata.push(s);
+                }
+            }
+        }
+        for (id, c) in ids.into_iter().zip(curves) {
+            f.curves[id] = c;
+        }
+        f.corners.push(SfccCorner {
+            id: corner,
+            x: event[0],
+            y: event[1],
+            z: event[2],
+            strata,
+            curve_ends: vec![(ids[0], 1), (ids[1], 1), (ids[2], 0)],
+        });
+    }
+    count
+}
