// Dieselpunk Battle Mech
// A hulking war machine bristling with weapons and pipes


// === TORSO - THE CORE ===
// Main chest housing with layered armor
let chestCore = box([0, 0, 40], [26, 32, 24])
let chestBulge = sphere([0, 0, 44], { r: 19 })
let chestArmor1 = box([0, 0, 46], [20, 28, 18])
let chestArmor2 = sphere([0, 0, 48], { r: 16 })
let chest = union(5, chestCore, chestBulge, chestArmor1, chestArmor2)

// Chest panel cutouts using subtract
let chestCutout1 = box([8, 0, 42], [12, 20, 16])
let chestCutout2 = box([-8, 0, 42], [12, 20, 16])
let chestWithCutouts = subtract(1, chest, chestCutout1, chestCutout2)

// Armored collar with multiple layers
let collarR = sphere([0, 18, 54], { r: 9 })
let collarL = sphere([0, -18, 54], { r: 9 })
let collarFront = sphere([12, 0, 54], { r: 8 })
let collarBack = sphere([-8, 0, 54], { r: 7 })
let collarTop = sphere([0, 0, 58], { r: 6 })
let collar = union(3, collarR, collarL, collarFront, collarBack, collarTop)

// Reactor exhaust vents on back - more detailed
let ventR = sphere([-16, 12, 50], { r: 6 })
let ventL = sphere([-16, -12, 50], { r: 6 })
let ventTop = sphere([-16, 0, 54], { r: 7 })
let ventMid = sphere([-16, 6, 52], { r: 4 })
let ventMid2 = sphere([-16, -6, 52], { r: 4 })
let vents = union(2, ventR, ventL, ventTop, ventMid, ventMid2)

// Vent cutouts for detail
let ventCutoutR = box([-20, 12, 50], [6, 3, 3])
let ventCutoutL = box([-20, -12, 50], [6, 3, 3])
let ventCutoutTop = box([-20, 0, 54], [6, 3, 3])
let ventsWithCutouts = subtract(0.5, vents, ventCutoutR, ventCutoutL, ventCutoutTop)

// === HEAD - COCKPIT POD ===
let headCore = sphere([5, 0, 64], { r: 11 })
let headBack = sphere([-2, 0, 64], { r: 9 })
let visor = box([12, 0, 62], [7, 16, 5])
let visorFrame = box([12, 0, 62], [8, 18, 6])
let headCrest = sphere([0, 0, 74], { r: 6 })
let headCrestBase = box([0, 0, 70], [4, 4, 8])
let antenna1 = sphere([-5, 9, 72], { r: 2.5 })
let antenna2 = sphere([-5, -9, 72], { r: 2.5 })
let antennaBase1 = box([-5, 9, 68], [2, 2, 6])
let antennaBase2 = box([-5, -9, 68], [2, 2, 6])
let head = union(4, headCore, headBack, visorFrame, visor, headCrestBase, headCrest, antennaBase1, antennaBase2, antenna1, antenna2)

// === SHOULDERS - WEAPON MOUNTS ===
// Right shoulder pod - enhanced
let shoulderR = sphere([0, 28, 52], { r: 13 })
let shoulderPadR = box([0, 32, 54], [12, 10, 12])
let shoulderPadR2 = sphere([0, 35, 54], { r: 6 })
let rocketPodR = box([0, 38, 56], [10, 8, 16])
let rocketPodR2 = box([0, 40, 58], [8, 6, 12])
let rocketTipR = sphere([0, 42, 64], { r: 3 })
let rightShoulder = union(4, shoulderR, shoulderPadR, shoulderPadR2, rocketPodR, rocketPodR2, rocketTipR)

// Left shoulder pod - enhanced
let shoulderL = sphere([0, -28, 52], { r: 13 })
let shoulderPadL = box([0, -32, 54], [12, 10, 12])
let shoulderPadL2 = sphere([0, -35, 54], { r: 6 })
let rocketPodL = box([0, -38, 56], [10, 8, 16])
let rocketPodL2 = box([0, -40, 58], [8, 6, 12])
let rocketTipL = sphere([0, -42, 64], { r: 3 })
let leftShoulder = union(4, shoulderL, shoulderPadL, shoulderPadL2, rocketPodL, rocketPodL2, rocketTipL)

// === RIGHT ARM - GATLING GUN ===
let upperArmR = box([0, 34, 40], [10, 10, 18])
let upperArmR2 = sphere([0, 34, 40], { r: 7 })
let elbowR = sphere([0, 36, 30], { r: 7 })
let elbowGuardR = box([0, 38, 30], [6, 4, 8])
let forearmR = box([5, 36, 20], [7, 7, 16])
let forearmR2 = sphere([5, 36, 20], { r: 5 })
let gatlingHousing = sphere([10, 36, 10], { r: 8 })
let gatlingHousing2 = box([10, 36, 10], [12, 6, 6])
let gatlingBarrel = box([22, 36, 10], [20, 5, 5])
let gatlingBarrel2 = box([32, 36, 10], [8, 3, 3])
let gatlingTip = sphere([38, 36, 10], { r: 2.5 })
let rightArm = union(3, upperArmR, upperArmR2, elbowR, elbowGuardR, forearmR, forearmR2, gatlingHousing, gatlingHousing2, gatlingBarrel, gatlingBarrel2, gatlingTip)

// === LEFT ARM - CLAW ===
let upperArmL = box([0, -34, 40], [10, 10, 18])
let upperArmL2 = sphere([0, -34, 40], { r: 7 })
let elbowL = sphere([0, -36, 30], { r: 7 })
let elbowGuardL = box([0, -38, 30], [6, 4, 8])
let forearmL = box([5, -36, 20], [7, 7, 16])
let forearmL2 = sphere([5, -36, 20], { r: 5 })
let clawBase = sphere([10, -36, 10], { r: 7 })
let clawBase2 = box([10, -36, 10], [8, 6, 6])
// Enhanced claw with more fingers
let clawTop = sphere([18, -32, 8], { r: 5 })
let clawMid = sphere([18, -36, 8], { r: 5 })
let clawBot = sphere([18, -40, 8], { r: 5 })
let clawTip1 = sphere([24, -30, 6], { r: 3 })
let clawTip2 = sphere([24, -36, 6], { r: 3 })
let clawTip3 = sphere([24, -42, 6], { r: 3 })
let leftArm = union(3, upperArmL, upperArmL2, elbowL, elbowGuardL, forearmL, forearmL2, clawBase, clawBase2, clawTop, clawMid, clawBot, clawTip1, clawTip2, clawTip3)

// === HIP ASSEMBLY ===
let hipCore = box([0, 0, 26], [20, 28, 12])
let hipBulge = sphere([0, 0, 26], { r: 15 })
let hipCore2 = box([0, 0, 28], [18, 26, 10])
let hips = union(4, hipCore, hipBulge, hipCore2)

// Hip armor plates - more detailed
let hipPlateR = sphere([8, 20, 26], { r: 8 })
let hipPlateR2 = box([8, 22, 26], [6, 4, 8])
let hipPlateL = sphere([8, -20, 26], { r: 8 })
let hipPlateL2 = box([8, -22, 26], [6, 4, 8])
let hipPlates = union(2, hipPlateR, hipPlateR2, hipPlateL, hipPlateL2)

// === LEGS - DIGITIGRADE STYLE ===
// Right leg - enhanced
let thighR = box([0, 16, 16], [10, 10, 16])
let thighR2 = sphere([0, 16, 16], { r: 7 })
let kneeR = sphere([5, 16, 8], { r: 7 })
let kneeGuardR = box([5, 18, 8], [6, 4, 10])
let shinR = box([10, 16, -2], [7, 7, 18])
let shinR2 = sphere([10, 16, -2], { r: 5 })
let ankleR = sphere([8, 16, -16], { r: 6 })
let footR = box([12, 16, -20], [14, 10, 5])
let footR2 = sphere([12, 16, -20], { r: 6 })
let toeR = sphere([22, 16, -20], { r: 5 })
let toeR2 = sphere([26, 16, -20], { r: 4 })
let rightLeg = union(3, thighR, thighR2, kneeR, kneeGuardR, shinR, shinR2, ankleR, footR, footR2, toeR, toeR2)

// Left leg - enhanced
let thighL = box([0, -16, 16], [10, 10, 16])
let thighL2 = sphere([0, -16, 16], { r: 7 })
let kneeL = sphere([5, -16, 8], { r: 7 })
let kneeGuardL = box([5, -18, 8], [6, 4, 10])
let shinL = box([10, -16, -2], [7, 7, 18])
let shinL2 = sphere([10, -16, -2], { r: 5 })
let ankleL = sphere([8, -16, -16], { r: 6 })
let footL = box([12, -16, -20], [14, 10, 5])
let footL2 = sphere([12, -16, -20], { r: 6 })
let toeL = sphere([22, -16, -20], { r: 5 })
let toeL2 = sphere([26, -16, -20], { r: 4 })
let leftLeg = union(3, thighL, thighL2, kneeL, kneeGuardL, shinL, shinL2, ankleL, footL, footL2, toeL, toeL2)

// === BACK MOUNTED SYSTEMS ===
// Reactor core - enhanced
let reactor = sphere([-18, 0, 44], { r: 11 })
let reactorCasing = box([-20, 0, 44], [10, 16, 16])
let reactorCasing2 = sphere([-18, 0, 44], { r: 9 })
let reactorUnit = union(4, reactor, reactorCasing, reactorCasing2)

// Reactor cutouts for detail
let reactorCutout1 = box([-24, 0, 44], [4, 8, 8])
let reactorCutout2 = box([-24, 0, 44], [4, 4, 12])
let reactorWithCutouts = subtract(1, reactorUnit, reactorCutout1, reactorCutout2)

// Smoke stacks - enhanced
let stack1 = box([-22, 10, 58], [5, 5, 18])
let stackTop1 = sphere([-22, 10, 70], { r: 5 })
let stack1Mid = sphere([-22, 10, 64], { r: 4 })
let stack2 = box([-22, -10, 58], [5, 5, 18])
let stackTop2 = sphere([-22, -10, 70], { r: 5 })
let stack2Mid = sphere([-22, -10, 64], { r: 4 })
let stack3 = box([-22, 0, 58], [5, 5, 18])
let stackTop3 = sphere([-22, 0, 70], { r: 5 })
let stacks = union(2, stack1, stackTop1, stack1Mid, stack2, stackTop2, stack2Mid, stack3, stackTop3)

// Fuel tanks - enhanced
let tankR = sphere([-14, 22, 40], { r: 7 })
let tankR2 = box([-14, 24, 40], [8, 4, 12])
let tankL = sphere([-14, -22, 40], { r: 7 })
let tankL2 = box([-14, -24, 40], [8, 4, 12])
let tanks = union(2, tankR, tankR2, tankL, tankL2)

// === DECORATIVE RIVETS & DETAILS ===
// More rivets for detail
let rivet1 = sphere([16, 14, 46], { r: 2 })
let rivet2 = sphere([16, -14, 46], { r: 2 })
let rivet3 = sphere([16, 0, 52], { r: 2 })
let rivet4 = sphere([14, 10, 38], { r: 1.5 })
let rivet5 = sphere([14, -10, 38], { r: 1.5 })
let rivet6 = sphere([12, 18, 44], { r: 1.5 })
let rivet7 = sphere([12, -18, 44], { r: 1.5 })
let rivet8 = sphere([10, 22, 40], { r: 1.5 })
let rivet9 = sphere([10, -22, 40], { r: 1.5 })
let rivet10 = sphere([-10, 14, 48], { r: 1.5 })
let rivet11 = sphere([-10, -14, 48], { r: 1.5 })
let rivets = union(rivet1, rivet2, rivet3, rivet4, rivet5, rivet6, rivet7, rivet8, rivet9, rivet10, rivet11)

// Chest searchlight - enhanced
let searchlight = sphere([18, 0, 44], { r: 5 })
let searchlightFrame = box([18, 0, 44], [6, 6, 6])
let searchlightUnit = union(2, searchlightFrame, searchlight)

// Side armor plates
let sidePlateR = box([6, 24, 42], [4, 6, 12])
let sidePlateL = box([6, -24, 42], [4, 6, 12])
let sidePlates = union(sidePlateR, sidePlateL)

// === ASSEMBLY ===
// Upper body
let torso = union(4, chestWithCutouts, collar, ventsWithCutouts, head)
let arms = union(2, rightShoulder, leftShoulder, rightArm, leftArm)
let upperBody = union(3, torso, arms)

// Lower body
let lowerBody = union(3, hips, hipPlates, rightLeg, leftLeg)

// Back systems
let backpack = union(3, reactorWithCutouts, stacks, tanks)

// Details
let details = union(1, rivets, searchlightUnit, sidePlates)

// Final mech
return union(4, upperBody, lowerBody, backpack, details)
