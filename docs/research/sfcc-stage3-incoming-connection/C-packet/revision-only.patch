+#[test]
+fn connection_c_actual_source_pinned_queries_have_order_without_attachment_authority() {
+    let fixture: Value =
+        serde_json::from_str(include_str!("../../fixtures/shared-arc-full-knob.json")).unwrap();
+    let root = build_csg_tree_from_json(fixture["sceneJson"].as_str().unwrap()).unwrap();
+    let size =
+        fixture["cube"]["max"][0].as_f64().unwrap() - fixture["cube"]["min"][0].as_f64().unwrap();
+    let tol = resolve_tolerances(&SfccTuning::default(), 3_f64.sqrt() * size);
+    let scope = Scope;
+    CAPTURE.with(|c| c.borrow_mut().enabled = true);
+    let (features, diag) = compile_feature_set(&root, &tol);
+    let (curve, source) = CAPTURE.with(|c| {
+        let mut c = c.borrow_mut();
+        (c.raw.take().unwrap(), c.source.clone())
+    });
+    drop(scope);
+    let params = classification_params(&curve, &tol);
+    let range = [params[0], params[1]];
+    assert!(range[0] == 0. && range[1] > 0. && range[1] < 1.);
+    let p0 = range[1] * 0.25;
+    let p1 = range[1] * 0.75;
+    let q0 = curve.shared_checked_point(p0).unwrap();
+    let q1 = curve.shared_checked_point(p1).unwrap();
+    let forward = [
+        pointwise_postconditions(&curve, p0, q0),
+        pointwise_postconditions(&curve, p1, q1),
+    ];
+    let swapped = [
+        pointwise_postconditions(&curve, p0, q1),
+        pointwise_postconditions(&curve, p1, q0),
+    ];
+    let mut rows = Vec::new();
+    for i in 0..=32 {
+        let t = range[0] + (range[1] - range[0]) * i as f64 / 32.;
+        let seed = curve.height_pinned_seed_c(range, t).unwrap();
+        let pinned = curve.height_pinned_point_c(range, t);
+        let old = curve.point_at_checked(t);
+        rows.push(json!({"parameterHex":hex(t),"seedHeightHex":hex(seed[1]),
+            "pinnedHex":pinned.map(|p|p.map(hex)),"originalHex":old.map(|p|p.map(hex)),
+            "heightBitsPreserved":pinned.map(|p|p[1].to_bits()==seed[1].to_bits()),
+            "pinnedOnSourceDomains":pinned.map(|p|curve.adjacent_strata.iter().all(|&id|features.strata[id].domain_contains(p,tol.curve_eps*8.))),
+            "queryDifferenceHex":pinned.zip(old).map(|(p,q)|hex(distance(p,q)))}));
+    }
+    let pinned: Vec<_> = (0..=32)
+        .map(|i| {
+            curve.height_pinned_point_c(range, range[0] + (range[1] - range[0]) * i as f64 / 32.)
+        })
+        .collect();
+    let heights: Vec<_> = pinned.iter().flatten().map(|p| p[1]).collect();
+    let direction =
+        (curve.original_seed_c(range[1])[1] - curve.original_seed_c(range[0])[1]).signum();
+    let ordered = heights.windows(2).all(|w| direction * (w[1] - w[0]) >= 0.);
+    let report = json!({"scope":"test-only actual-source query alternative; no source admission, attachment or runtime change",
+        "rawCurve":curve.id,"sourcePair":curve.adjacent_strata,"sourceIdentities":source,"originalClassificationRangeHex":range.map(hex),
+        "originalCurveRangeHex":[hex(curve.t_min),hex(curve.t_max)],"sourceConfigSha256":fixture["sourceConfigSha256"],
+        "pointwiseForward":forward,"pointwiseSwapped":swapped,"swappedHeightOrderReversed":(q1[1]-q0[1])*(q0[1]-q1[1])<0.,
+        "counterexampleMeaning":"pointwise residual, conditioning and displacement postconditions permit reversed outputs; actual Newton behavior is not claimed reversed",
+        "pinnedQueries":rows,"pinnedAllQueriesSucceeded":pinned.iter().all(Option::is_some),"pinnedSuccessfulHeightsOrdered":ordered,
+        "orderClaim":"non-strict height order for successful queries by monotone rounded seed interpolation and exact height preservation; no floating evaluator totality",
+        "runtimeFeatureFingerprint":features.fingerprint().to_string(),"unresolvedTrims":diag.unresolved_trims,
+        "sourceConnectionCertified":false,"junctionAttachmentAuthorized":false,"productionQueryChanged":false});
+    let path = std::env::var("SFCC_CONNECTION_C_RECEIPT").expect("root receipt required");
+    std::fs::write(path, serde_json::to_vec_pretty(&report).unwrap()).unwrap();
+    assert!(forward
+        .iter()
+        .chain(&swapped)
+        .all(|v| v["accepted"] == true));
+    assert_ne!(q0[1], q1[1]);
+    assert!(
+        pinned.iter().all(Option::is_some),
+        "actual narrow source interval must support the proposed query"
+    );
+    assert!(rows.iter().all(|r| r["heightBitsPreserved"] == true));
+    assert!(ordered);
+    assert!(curve
+        .height_pinned_point_c(range, range[1].next_up())
+        .is_none());
+}
