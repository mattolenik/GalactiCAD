+#[test]
+fn incident_a_record_owned_tiny_plane_offset_keeps_distinct_geometric_claims() {
+    let left = [7, 26, 58, 86];
+    let right = [7, 26, 58, 87];
+    let raw = BTreeSet::from([right]);
+    assert_eq!(
+        owned_consumers(&[(left, 1), (right, 0)], left, &raw).unwrap(),
+        BTreeSet::from([left, right])
+    );
+    let bound = retained_face_defect(
+        2,
+        [[0., 0., 1.], [1., 1., 1.]],
+        [0.5, 0.5, 1. + 2e-13],
+        3e-7,
+    )
+    .unwrap();
+    assert_eq!(bound["retainedPointExactlyOnPlane"], false);
+    assert!(bound["rectangleDistanceUpperL1"].as_f64().unwrap() < 3e-7);
+    assert!(
+        retained_face_defect(2, [[0., 0., 1.], [1., 1., 1.]], [0.5, 0.5, 1. + 1e-5], 3e-7).is_err()
+    );
+}
+#[test]
+fn incident_a_wrong_record_ownership_cannot_be_fixed_by_small_coordinate_defect() {
+    let left = [7, 26, 58, 86];
+    let right = [7, 26, 58, 87];
+    let other = [7, 27, 58, 87];
+    assert!(owned_consumers(&[(left, 1), (right, 1)], left, &BTreeSet::from([right])).is_err());
+    assert!(owned_consumers(&[(left, 1), (right, 0)], other, &BTreeSet::from([right])).is_err());
+    assert_eq!(
+        owned_consumers(&[(left, 1), (right, 0)], left, &BTreeSet::from([other])).unwrap_err(),
+        "incident_unrepresented_raw_box_consumer"
+    );
+    assert!(retained_face_defect(
+        2,
+        [[0., 0., 1.], [1., 1., 1.]],
+        [1.01, 0.5, 1. + 2e-13],
+        3e-7
+    )
+    .is_err());
+}
