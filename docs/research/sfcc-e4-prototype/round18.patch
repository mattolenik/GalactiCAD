+        if !used.iter().any(|f| changed.contains(f)) {
+            continue;
+        }
+        if leaves.len() >= 256 {
+            return Err("leaf_consumer_cap");
+        }
+        let id = [cell.level as i64, cell.ix, cell.iy, cell.iz];
+        leaves.push(id);
+        required.extend(used.iter().copied());
