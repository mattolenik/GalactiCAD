+/// One exact source-frame family: horizontal polygon side, identity represented
+/// transform, and a coaxial cylinder with unit axis (radius need not be one).
+/// This is a real-equation identity, not bitwise equality of SDF evaluations.
+#[derive(Clone)]
+pub(crate) struct HelixBranch {
+    pub native:usize, pub field:usize, pub cylinder_id:usize,
+    p:TwistedSideParams, cylinder:([f64;3],[f64;3],f64), u:I, pub sign:i8,
+}
+impl HelixBranch {
+    pub(crate) fn identify(features:&SfccFeatureSet,a:usize,b:usize,first:([f64;3],[f64;3]))->Option<Self>{
+        let ca=features.curves.get(a)?;let cb=features.curves.get(b)?;
+        let common=*ca.adjacent_strata.iter().find(|&&id|cb.adjacent_strata.contains(&id)&&features.strata.get(id).and_then(Stratum::certificate_cylinder).is_some())?;
+        let ia=*ca.adjacent_strata.iter().find(|&&id|id!=common)?;let ib=*cb.adjacent_strata.iter().find(|&&id|id!=common)?;
+        let (native,field,p)=if let Some((p,_,_,_))=features.strata[ia].round_twisted_source(&features.strata[ib]){(ia,ib,p)}else{let(p,_,_,_)=features.strata[ib].round_twisted_source(&features.strata[ia])?;(ib,ia,p)};
+        let cylinder=features.strata[common].certificate_cylinder()?;
+        if p.sim.r!=[1.,0.,0.,0.,1.,0.,0.,0.,1.]||p.sim.t!=[0.;3]||p.sim.s!=1.
+            ||p.nx2!=0.||p.nz2.abs()!=1.||p.pos_x!=cylinder.0[0]||p.pos_z!=cylinder.0[2]
+            ||![[0.,1.,0.],[0.,-1.,0.]].contains(&cylinder.1){return None;}
+        let square_u=square(I::point(cylinder.2))?.sub(square(I::point(p.v0z))?)?;
+        if square_u.lo<=0.{return None;}let mut u=sqrt(square_u)?;
+        let x=twisted(p,first.0,first.1)?.3[0];let sign=if x.lo>0.{1}else if x.hi<0.{-1}else{return None;};
+        if sign<0{u=u.mul(-1.)?;}
+        Some(Self{native,field,cylinder_id:common,p,cylinder,u,sign})
+    }
+    /// The same fixed-sign analytic helix covers every axial height in this
+    /// source tube. Interval boxes bound restrictions; they do not choose roots.
+    pub(crate) fn cover(&self,features:&SfccFeatureSet,lo:[f64;3],hi:[f64;3])->Option<([f64;3],[f64;3],usize)> {
+        let y=interval(lo[1],hi[1])?;
+        let theta=div(y.sub(I::point(self.p.pos_y))?.add(I::point(self.p.h))?,2.*self.p.h)?.mul(self.p.twist_rad)?;
+        let(s,c)=sin_cos(theta)?;
+        let x=mul(self.u,c)?.sub(s.mul(self.p.v0z)?)?.add(I::point(self.p.pos_x))?;
+        let z=mul(self.u,s)?.add(c.mul(self.p.v0z)?)?.add(I::point(self.p.pos_z))?;
+        let lower=[lo[0].min(x.lo),lo[1],lo[2].min(z.lo)];let upper=[hi[0].max(x.hi),hi[1],hi[2].max(z.hi)];
+        let(p,leaf,other,r)=features.strata[self.native].round_twisted_source(&features.strata[self.field])?;
+        let boxes=source_restrictions(p,leaf,Some((other,r)),lower,upper)?;
+        let (_,g,_,xz)=twisted(p,lower,upper)?;
+        if (self.sign>0&&xz[0].lo<=0.)||(self.sign<0&&xz[0].hi>=0.){return None;}
+        let (_,radial)=radial(self.cylinder.0,self.cylinder.1,self.cylinder.2,lower,upper)?;
+        inverse_bound([[radial[2],radial[0]],[g[2],g[0]]])?;
+        Some((lower,upper,boxes))
+    }
+}
