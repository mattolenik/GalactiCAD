+    let saved: Value = serde_json::from_str(include_str!(
+        "../../fixtures/shared-arc-round14-a-face.json"
+    ))
+    .unwrap();
+    let root = crate::scene_bridge::build_csg_tree_from_json(config["sceneJson"].as_str().unwrap())
+        .unwrap();
+    let side =
+        config["cube"]["max"][0].as_f64().unwrap() - config["cube"]["min"][0].as_f64().unwrap();
+    let tol = crate::tolerances::resolve_tolerances(
+        &crate::tuning::SfccTuning::default(),
+        (3. * side * side).sqrt(),
+    );
+    let (features, _) = crate::sfcc::feature_set::compile_feature_set(&root, &tol);
+    assert_eq!(features.fingerprint(), 9875508341830920921);
+    let f = &saved["face"];
