+#[test]
+fn lower_a_refuses_bad_source_interval_and_embedded_carrier() {
+    let (root, f) = fixture();
+    let source = roles(&f);
+    let cert = bind(&root, &f.strata, source, EVENT, 1e-7, 0.01).unwrap();
+    for depth in [0., -0.01, 0.251, f64::NAN, f64::INFINITY] {
+        assert!(bind(&root, &f.strata, source, EVENT, 1e-7, depth).is_none());
+    }
+    assert!(cert.image_bounds(-0.011, 0.).is_none());
+    assert!(cert.image_bounds(0., 0.001).is_none());
+    assert!(cert.image_bounds(0., -0.001).is_none());
+    assert!(cert.image_bounds(f64::NAN, 0.).is_none());
+    let mut wrong = root.clone();
+    let CsgNode::Blend { r, .. } = &mut wrong else {
+        panic!()
+    };
+    *r += 0.001;
+    assert!(bind(&wrong, &f.strata, source, EVENT, 1e-7, 0.01).is_none());
+    let mut wrong_point = EVENT;
+    wrong_point[1] += 0.01;
+    assert!(bind(&root, &f.strata, source, wrong_point, 1e-7, 0.01).is_none());
+    let mut wrong_roles = source;
+    wrong_roles.swap(0, 2);
+    assert!(bind(&root, &f.strata, wrong_roles, EVENT, 1e-7, 0.01).is_none());
+    let curve = f
+        .curves
+        .iter()
+        .find(|c| cert.curve_source_matches(&f.strata, c))
+        .unwrap();
+    let mut wrong_curve = curve.clone();
+    wrong_curve.adjacent_strata.swap(0, 1);
+    assert!(!cert.curve_source_matches(&f.strata, &wrong_curve));
+    let (_, foreign) = fixture();
+    assert!(
+        !cert.curve_source_matches(&foreign.strata, curve),
+        "separate source handles cannot authorize embedded carriers"
+    );
+    let foreign_curve = foreign
+        .curves
+        .iter()
+        .find(|c| c.adjacent_strata == cert.lifted_pair)
+        .unwrap();
+    assert!(
+        !cert.curve_source_matches(&foreign.strata, foreign_curve),
+        "coherent foreign registry and embedded carriers cannot borrow old certificate"
+    );
+    let mut altered = f.strata.clone();
+    altered[cert.lifted_pair[0]] = foreign.strata[cert.lifted_pair[0]].clone();
+    altered[cert.lifted_pair[1]] = foreign.strata[cert.lifted_pair[1]].clone();
+    assert!(
+        !cert.curve_source_matches(&altered, foreign_curve),
+        "matching native root cannot authorize foreign lifted embedded descriptors"
+    );
+    let mut bad = cert.clone();
+    bad.edge[2] = bad.edge[0];
+    assert!(
+        bad.image_bounds(-0.01, 0.).is_none(),
+        "vertical groove edge cannot parameterize y"
+    );
+    let mut bad = cert.clone();
+    bad.depth = bad.radius;
+    assert!(
+        bad.image_bounds(-bad.depth, 0.).is_none(),
+        "offset must stay strictly outside groove"
+    );
+}
