+#[test]
+fn fullfan_a_actual_closed_source_graph() {
+    use crate::sfcc::pipeline::{build_pipeline_context, PipelineTuning, SfccWorldCube};
+    let _guard = crate::sfcc::validation::NumericalGuard::new();
+    let input: Value =
+        serde_json::from_str(include_str!("../../fixtures/shared-arc-full-knob.json")).unwrap();
+    let saved: Value =
+        serde_json::from_str(include_str!("../../fixtures/ownership-first-fan-a.json")).unwrap();
+    let root = crate::scene_bridge::build_csg_tree_from_json(input["sceneJson"].as_str().unwrap())
+        .unwrap();
+    let cube = SfccWorldCube {
+        min_x: input["cube"]["min"][0].as_f64().unwrap(),
+        min_y: input["cube"]["min"][1].as_f64().unwrap(),
+        min_z: input["cube"]["min"][2].as_f64().unwrap(),
+        size: input["cube"]["max"][0].as_f64().unwrap() - input["cube"]["min"][0].as_f64().unwrap(),
+    };
+    let f = build_pipeline_context(&root, &cube, &PipelineTuning::default()).features;
+    assert_eq!(
+        f.fingerprint().to_string(),
+        saved["fingerprint"].as_str().unwrap()
+    );
+    let points: std::collections::BTreeMap<usize, [f64; 3]> = saved["points"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|p| {
+            (
+                p["id"].as_u64().unwrap() as usize,
+                std::array::from_fn(|k| {
+                    f64::from_bits(
+                        u64::from_str_radix(p["positionHex"][k].as_str().unwrap(), 16).unwrap(),
+                    )
+                }),
+            )
+        })
+        .collect();
+    let ids: Vec<usize> = serde_json::from_value(saved["fan"]["triangles"].clone()).unwrap();
+    let triangles: Vec<_> = ids
+        .chunks_exact(3)
+        .map(|t| [points[&t[0]], points[&t[1]], points[&t[2]]])
+        .collect();
+    let tolerance = f64::from_bits(
+        u64::from_str_radix(saved["options"]["surfaceTolHex"].as_str().unwrap(), 16).unwrap(),
+    );
+    let result = certify(
+        &f,
+        saved["fan"]["stratum"].as_u64().unwrap() as usize,
+        &triangles,
+        tolerance,
+    );
+    if let Ok(path) = std::env::var("SFCC_FULLFAN_A_RECEIPT") {
+        std::fs::write(
+            path,
+            serde_json::to_vec_pretty(
+                &json!({"result":result,"parentReceiptSha256":saved["parentReceiptSha256"]}),
+            )
+            .unwrap(),
+        )
+        .unwrap();
+    }
+    assert!(result.is_ok(), "{result:?}");
+}
