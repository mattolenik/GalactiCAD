+/// Additional retained request layouts; diagnostic JSON is separately capped and is not RSS.
+pub(crate) fn reserve_plan_storage(
+    features: &SfccFeatureSet,
+    staged: usize,
+    plan: &Plan,
+) -> Result<()> {
+    use crate::sfcc::source_storage_a::Ledger;
+    use std::mem::{align_of, size_of};
+    let mut ledger = Ledger::new();
+    for _ in 0..3 {
+        ledger
+            .allocation("secondary_plan", 1, size_of::<Plan>(), align_of::<Plan>())
+            .map_err(|_| "secondary_storage_arithmetic")?;
+        ledger
+            .vector("secondary_consumers", &plan.consumers)
+            .map_err(|_| "secondary_storage_arithmetic")?;
+        for c in &plan.consumers {
+            for v in &c.incoming {
+                ledger
+                    .vector("secondary_nodes", v)
+                    .map_err(|_| "secondary_storage_arithmetic")?;
+            }
+        }
+    }
+    ledger
+        .allocation(
+            "secondary_visits",
+            2 * plan.consumers.len(),
+            size_of::<bool>(),
+            align_of::<bool>(),
+        )
+        .map_err(|_| "secondary_storage_arithmetic")?;
+    ledger
+        .allocation(
+            "secondary_receipt_rows",
+            plan.consumers.len(),
+            size_of::<Value>(),
+            align_of::<Value>(),
+        )
+        .map_err(|_| "secondary_storage_arithmetic")?;
+    let total = staged
+        .checked_add(ledger.owned_reservation)
+        .ok_or("secondary_storage_arithmetic")?;
+    note(
+        "requestStorage",
+        json!({"layoutLedger":ledger,"baseStagedBytes":staged,"combinedStagedBytes":total,"scope":"retained request layouts with three simultaneous Plan copies; diagnostic JSON and validator workspace not an RSS guarantee"}),
+    );
+    super::reserve_source_view(features, total)
+        .map_err(|_| "secondary_source_and_request_storage_cap")
+}
