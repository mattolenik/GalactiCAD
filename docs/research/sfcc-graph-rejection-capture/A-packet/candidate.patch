+// Streaming size check prevents an oversized temporary serialized buffer.
+struct Limited(Vec<u8>);
+impl Write for Limited {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        if bytes.len() > BYTE_CAP.saturating_sub(self.0.len()) { return Err(io::Error::other("graph capture byte cap")); }
+        self.0.extend_from_slice(bytes); Ok(bytes.len())
+    }
+    fn flush(&mut self) -> io::Result<()> { Ok(()) }
