+use super::*;
+use crate::sfcc::{
+    pipeline::{build_pipeline_context, PipelineTuning, SfccWorldCube},
+    triangle_quality as q,
+};
+use serde_json::{json, Value};
+fn fixture() -> (
+    CsgNode,
+    crate::sfcc::feature_set::SfccFeatureSet,
+    Value,
+    [[f64; 3]; 3],
+) {
+    let config: Value =
+        serde_json::from_str(include_str!("../../fixtures/shared-arc-full-knob.json")).unwrap();
+    let root = crate::scene_bridge::build_csg_tree_from_json(config["sceneJson"].as_str().unwrap())
+        .unwrap();
+    let cube = SfccWorldCube {
+        min_x: config["cube"]["min"][0].as_f64().unwrap(),
+        min_y: config["cube"]["min"][1].as_f64().unwrap(),
+        min_z: config["cube"]["min"][2].as_f64().unwrap(),
+        size: config["cube"]["max"][0].as_f64().unwrap()
+            - config["cube"]["min"][0].as_f64().unwrap(),
+    };
+    let f = build_pipeline_context(&root, &cube, &PipelineTuning::default()).features;
+    let captured: Value = serde_json::from_str(include_str!(
+        "../../fixtures/orientation-first-triangle.json"
+    ))
+    .unwrap();
+    assert_eq!(
+        f.fingerprint().to_string(),
+        captured["featureFingerprint"].as_str().unwrap()
+    );
+    let pts = std::array::from_fn(|i| {
+        std::array::from_fn(|k| {
+            f64::from_bits(captured["working"]["pointBits"][i][k].as_u64().unwrap())
+        })
+    });
+    (root, f, captured, pts)
+}
+fn roles(f: &crate::sfcc::feature_set::SfccFeatureSet) -> [usize; 3] {
+    let ids = crate::sfcc::stage4_source_preflight_c::selected_pair_c(f).unwrap();
+    let tube = f.curves[ids[0]].projection_tube(0., 1.).unwrap();
+    let b = HelixBranch::identify(f, ids[0], ids[1], tube).unwrap();
+    [b.native, b.field, b.cylinder_id]
+}
+#[test]
+fn orientation_b_actual_source_facets_and_reference() {
+    let (root, f, captured, pts) = fixture();
+    let source = roles(&f);
+    let registered = f.strata[source[0]].exposure_root_a().unwrap();
+    let (cap_cut, sphere, outer_r) =
+        pair(registered, Some((BlendKind::Smax, SminMode::Round))).unwrap();
+    let (groove_cut, cap, _) = pair(cap_cut, None).unwrap();
+    let (hard, groove_node, r) =
+        pair(groove_cut, Some((BlendKind::Smax, SminMode::Chamfer))).unwrap();
+    let (inner, cylinder_node, _) = pair(hard, None).unwrap();
+    let (other_node, native_node, inner_r) =
+        pair(inner, Some((BlendKind::Smin, SminMode::Round))).unwrap();
+    let native = leaf(native_node, 1.).unwrap();
+    let cylinder = leaf(cylinder_node, 1.).unwrap();
+    let groove = leaf(groove_node, -1.).unwrap();
+    let common: Vec<_> = f
+        .strata
+        .iter()
+        .filter(|s| {
+            s.connection_compound(hard, groove_node, groove_cut)
+                .is_some()
+        })
+        .map(|s| s.id)
+        .collect();
+    assert_eq!(common.len(), 1);
+    let curve_id = captured["edgeMemberships"][1]["intervals"][0]["curve"]
+        .as_u64()
+        .unwrap() as usize;
+    let curve = &f.curves[curve_id];
+    assert!(
+        curve.adjacent_strata.contains(&source[1]) && curve.adjacent_strata.contains(&common[0])
+    );
+    let n = q::normal(pts);
+    let mut weights = vec![[1., 0., 0.], [0., 1., 0.], [0., 0., 1.]];
+    weights.extend(q::SAMPLES);
+    let mut rows = Vec::new();
+    for w in weights {
+        let p = q::bary(pts, w);
+        let e = native.f(p);
+        let c = cylinder.f(p);
+        let g = groove.f(p) + r;
+        let k = std::f64::consts::FRAC_1_SQRT_2;
+        let facets = [e, c, k * (e + g), k * (c + g)];
+        let full = root.grad(p);
+        let raw = [native_node, cylinder_node, groove_node]
+            .map(|node| crate::sfcc::field_branches::sample_tree(node, p));
+        let normals = [
+            raw[0].gradient,
+            raw[1].gradient,
+            std::array::from_fn(|j| k * (raw[0].gradient[j] + raw[2].gradient[j])),
+            std::array::from_fn(|j| k * (raw[1].gradient[j] + raw[2].gradient[j])),
+        ];
+        let max = facets.into_iter().fold(f64::NEG_INFINITY, f64::max);
+        let active = facets
+            .iter()
+            .enumerate()
+            .max_by(|(_, a), (_, b)| a.total_cmp(b))
+            .unwrap()
+            .0;
+        rows.push(json!({"weights":w,"pointBits":p.map(f64::to_bits),"levels":[e,c,g],"fourFacets":facets,"activeFacet":active,"full":full.0,"maxFacet":max,"fullNormal":full.1,"normalDots":normals.map(|x|q::dot(n,x)),"fullNormalDot":q::dot(n,full.1),"finitePrimitiveNormals":normals,"ancestors":{"other":other_node.f(p),"innerRadius":inner_r,"cap":cap.f(p),"sphere":sphere.f(p),"outerRadius":outer_r},"strata": [source[0],source[1],source[2],common[0]].map(|id|json!({"id":id,"value":f.strata[id].f(p[0],p[1],p[2]),"normal":f.strata[id].normal(p[0],p[1],p[2]),"owned":f.strata[id].domain_contains(p,1e-7)}))}));
+    }
+    let centroid = std::array::from_fn(|j| (pts[0][j] + pts[1][j] + pts[2][j]) / 3.);
+    let refn = root.grad(centroid).1;
+    assert_eq!(
+        refn.map(f64::to_bits),
+        std::array::from_fn(|j| captured["referenceBits"][j].as_u64().unwrap())
+    );
+    let report = json!({"scope":"sampled actual source decomposition and normals, not wholetriangle patch certificate","sourceRoles":source,"commonChamfer":common[0],"sourceIdentities":[source[0],source[1],source[2],common[0]].map(|id|f.strata[id].graph_capture_identity_b()),"curve":curve_id,"curvePair":curve.adjacent_strata,"curveRange":[curve.t_min,curve.t_max],"curveCorners":[curve.corner_start,curve.corner_end],"triangle":captured["triangle"],"triangleNormal":n,"sameCapturedReference":true,"samples":rows,"runtimeChanged":false});
+    std::fs::write(
+        std::env::var("SFCC_ORIENTATION_B_RECEIPT").unwrap(),
+        serde_json::to_vec_pretty(&report).unwrap(),
+    )
+    .unwrap();
+}
