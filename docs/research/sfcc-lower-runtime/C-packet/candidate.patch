+fn height_proposal(lo: f64, hi: f64, low_y: f64, high_y: f64, y: f64) -> Option<f64> {
+    if ![lo, hi, low_y, high_y, y].iter().all(|v| v.is_finite()) || lo >= hi {
+        return None;
+    }
+    let fraction = (y - low_y) / (high_y - low_y);
+    if !fraction.is_finite() || fraction <= 0. || fraction >= 1. {
+        return None;
+    }
+    let t = lo + (hi - lo) * fraction;
+    (t.is_finite() && t > lo && t < hi).then_some(t)
+}
