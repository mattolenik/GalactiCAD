+#[cfg(feature = "serde")]
+pub(crate) fn note_query_cost(phase: &'static str, cost: serde_json::Value) {
+    DIAGNOSTIC.with(|state| {
+        if let Some(report) = state.borrow_mut().as_mut() {
+            if report["queryCosts"].is_null() {
+                report["queryCosts"] = serde_json::json!({});
+            }
+            report["queryCosts"][phase] = cost;
+            report["lastQueryPhase"] = serde_json::json!(phase);
+        }
+    });
+}
+fn note_generated_cost(log: &QueryLog, finished: bool) {
+    #[cfg(feature = "serde")]
+    DIAGNOSTIC.with(|state| {
+        if let Some(report) = state.borrow_mut().as_mut() {
+            report["generatedQueryCost"] = serde_json::json!({
+                "reserved":GENERATED_RESERVATION,"attempted":log.attempts.len(),
+                "successful":log.attempts.iter().filter(|e|e.point.is_some()).count(),
+                "unusedReserved":GENERATED_RESERVATION-log.attempts.len(),
+                "exhausted":log.exhausted,"finished":finished,"refunded":0,
+                "scope":"reservation remains charged, including unused slots; failed and discarded attempts retained"
+            });
+        }
+    });
+    #[cfg(not(feature = "serde"))]
+    let _ = (log, finished);
+}
