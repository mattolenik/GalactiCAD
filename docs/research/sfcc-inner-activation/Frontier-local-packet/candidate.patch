+        return false;
+    };
+    let Some(out_tube) = features.curves[plan.charts[1]].projection_tube(plan.cuts[1], out_end)
+    else {
+        return false;
+    };
+    if !in_tube(out_tube, plan.point) || !in_tube(out_tube, own[1]) {
+        return false;
+    }
+    for id in [plan.source[0], plan.source[1], plan.source[3]] {
+        let Some(value) = features.strata[id]
+            .raw_field(plan.point[0], plan.point[1], plan.point[2])
+            .normalized_equation()
