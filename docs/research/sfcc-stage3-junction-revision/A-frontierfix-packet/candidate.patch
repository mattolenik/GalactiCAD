+//! A source junction location theorem, not permission to attach a traced arc.
+use super::*;
+
+#[derive(Debug)]
+pub(crate) struct Junction {
+    pub source: [usize; 3],
+    pub branch_sign: i8,
+    pub groove_edge: usize,
+    pub height: [f64; 2],
+    pub image: [[f64; 3]; 2],
+    pub association_upper: f64,
+    pub transverse_determinant_lower: f64,
+    pub axial_derivative_lower: f64,
+    pub other_edge_margin: f64,
+}
+
+fn divide(a: I, b: I) -> Option<I> {
+    if b.lo <= 0. && b.hi >= 0. {
+        return None;
+    }
+    mul(a, interval((1. / b.hi).next_down(), (1. / b.lo).next_up())?)
+}
+
+/// Exact represented vertices define the meridian; rounded stored normals are
+/// intentionally not premises. The fixed-radial offset equation is affine in y.
+fn offset_root(groove: &Leaf, radial: f64, radius: f64, edge_id: usize) -> Option<(I, f64, f64)> {
+    let Shape::Lathe { edges } = &groove.shape else {
+        return None;
+    };
+    if edges.len() < 3 || edges.len() > 64 || !radial.is_finite() || radial <= 0. {
+        return None;
+    }
+    let vertex = |i: usize| [edges[i % edges.len()].r0, edges[i % edges.len()].y0];
+    let orientation = crate::sfcc::predicates::orient2d(vertex(0), vertex(1), vertex(2));
+    if orientation == 0 {
+        return None;
+    }
+    for (i, e) in edges.iter().enumerate() {
+        if [e.r0, e.y0, e.r1, e.y1].iter().any(|v| !v.is_finite())
+            || e.r0 <= 0.
+            || e.r1 <= 0.
+            || [e.r1, e.y1] != vertex(i + 1)
+            || matches!(e.kind, crate::primitives::shapes::LatheEdgeKind::None)
+        {
+            return None;
+        }
+        for j in 0..edges.len() {
+            if j != i
+                && j != (i + 1) % edges.len()
+                && crate::sfcc::predicates::orient2d(vertex(i), vertex(i + 1), vertex(j))
+                    != orientation
+            {
+                return None;
+            }
+        }
+    }
+    let e = edges.get(edge_id)?;
+    let dr = I::point(e.r1).sub(I::point(e.r0))?;
+    let dy = I::point(e.y1).sub(I::point(e.y0))?;
+    let len = sqrt(square(dr)?.add(square(dy)?)?)?;
+    let nr_scaled = dy.mul(orientation as f64)?;
+    let ny_scaled = dr.mul(-(orientation as f64))?;
+    let rho = I::point(radial).sub(I::point(e.r0))?;
+    let y = divide(
+        mul(I::point(radius), len)?.sub(mul(nr_scaled, rho)?)?,
+        ny_scaled,
+    )?
+    .add(I::point(e.y0))?;
+    let wy = y.sub(I::point(e.y0))?;
+    let along = divide(
+        mul(dr, rho)?.add(mul(dy, wy)?)?,
+        square(dr)?.add(square(dy)?)?,
+    )?;
+    if along.lo <= 0. || along.hi >= 1. {
+        return None;
+    }
+    // Positive outward line distance and convexity establish outside winding.
+    let signed = divide(mul(nr_scaled, rho)?.add(mul(ny_scaled, wy)?)?, len)?;
+    if signed.lo <= 0. {
+        return None;
+    }
+    let mut margin = f64::INFINITY;
+    for (i, other) in edges.iter().enumerate() {
+        if i == edge_id {
+            continue;
+        }
+        let dx = I::point(other.r1).sub(I::point(other.r0))?;
+        let dz = I::point(other.y1).sub(I::point(other.y0))?;
+        let wx = I::point(radial).sub(I::point(other.r0))?;
+        let wz = y.sub(I::point(other.y0))?;
+        let t = divide(
+            mul(dx, wx)?.add(mul(dz, wz)?)?,
+            square(dx)?.add(square(dz)?)?,
+        )?;
+        let t = I {
+            lo: t.lo.clamp(0., 1.),
+            hi: t.hi.clamp(0., 1.),
+        };
+        let rx = wx.sub(mul(dx, t)?)?;
+        let rz = wz.sub(mul(dz, t)?)?;
+        let dist = sqrt(square(rx)?.add(square(rz)?)?)?;
+        let gap = dist.sub(I::point(radius))?;
+        if gap.lo <= 0. {
+            return None;
+        }
+        margin = margin.min(gap.lo);
+    }
+    let derivative = divide(ny_scaled, len)?;
+    if derivative.lo <= 0. && derivative.hi >= 0. {
+        return None;
+    }
+    Some((
+        y.add(I::point(groove.pos[1]))?,
+        derivative.lo.abs().min(derivative.hi.abs()),
+        margin,
+    ))
+}
+
+/// The certificate locates a regular helix/groove-offset intersection of the
+/// represented source. It does not prove a numerical incoming arc reaches it.
+pub(crate) fn prove_junction(
+    runtime_root: &CsgNode,
+    strata: &[Stratum],
+    source: [usize; 3],
+    point: [f64; 3],
+    epsilon: f64,
+) -> Option<Junction> {
+    if strata.len() > 256
+        || !epsilon.is_finite()
+        || epsilon <= 0.
+        || point.iter().any(|v| !v.is_finite())
+    {
+        return None;
+    }
+    let branch = branch_at(strata, source[0], source[1], source[2], point)?;
+    let root = strata.get(branch.native)?.exposure_root_a()?;
+    if !same_source(runtime_root, root, &mut 64) {
+        return None;
+    }
+    let (cap_cut, _, _) = pair(root, Some((BlendKind::Smax, SminMode::Round))).ok()?;
+    let (groove_cut, _, _) = pair(cap_cut, None).ok()?;
+    let (_, groove_node, radius) =
+        pair(groove_cut, Some((BlendKind::Smax, SminMode::Chamfer))).ok()?;
+    let groove = leaf(groove_node, -1.).ok()?;
+    if groove.pos[0] != branch.cylinder.0[0] || groove.pos[2] != branch.cylinder.0[2] {
+        return None;
+    }
+    let Shape::Lathe { edges } = &groove.shape else {
+        return None;
+    };
+    for i in 0..edges.len().min(64) {
+        let Some((height, derivative, margin)) = offset_root(groove, branch.cylinder.2, radius, i)
+        else {
+            continue;
+        };
+        let Some(cert) = BranchCertificate::bind_strata(strata, &branch, height) else {
+            continue;
+        };
+        let Ok(rank) = ancestor_support(strata, &branch, height, false) else {
+            continue;
+        };
+        let (lo, hi) = cert.image_bounds();
+        let distance = (|| {
+            let mut sum = I::point(0.);
+            for k in 0..3 {
+                sum = sum.add(square(I::point(point[k]).sub(interval(lo[k], hi[k])?)?)?)?;
+            }
+            Some(sqrt(sum)?.hi)
+        })()?;
+        if distance > epsilon {
+            continue;
+        }
+        return Some(Junction {
+            source,
+            branch_sign: branch.sign,
+            groove_edge: i,
+            height: [height.lo, height.hi],
+            image: [lo, hi],
+            association_upper: distance,
+            transverse_determinant_lower: rank,
+            axial_derivative_lower: derivative,
+            other_edge_margin: margin,
+        });
+    }
+    None
+}
