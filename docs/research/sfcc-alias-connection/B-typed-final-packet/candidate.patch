+#[test]
+fn alias_a_rejects_foreign_sources_ranges_points_and_budget() {
+    let (root, f, source, charts, ranges, rho_min, eps) = fixture();
+    let cert = bind(&root, &f, source, charts, ranges, rho_min, eps).unwrap();
+    for bad in [0., f64::NAN, eps * 2.] {
+        assert!(bind(&root, &f, source, charts, ranges, rho_min, bad).is_none());
+    }
+    let mut wrong_root = root.clone();
+    let CsgNode::Blend { r, .. } = &mut wrong_root else {
+        panic!()
+    };
+    *r += 0.1;
+    assert!(bind(&wrong_root, &f, source, charts, ranges, rho_min, eps).is_none());
+    assert!(bind(
+        &root,
+        &f,
+        source,
+        [charts[1], charts[0]],
+        ranges,
+        rho_min,
+        eps
+    )
+    .is_none());
+    let mut wrong_id = f.clone();
+    wrong_id.curves[charts[0]].id += 1;
+    assert!(bind(&root, &wrong_id, source, charts, ranges, rho_min, eps).is_none());
+    let mut bad_ranges = ranges;
+    bad_ranges[0][1] = f.curves[charts[0]].t_max + 1.;
+    assert!(bind(&root, &f, source, charts, bad_ranges, rho_min, eps).is_none());
+    assert!(bind(&root, &f, source, charts, ranges, cert.radial[1], eps).is_none());
+    let mut budget = budget(&f);
+    let own = cert
+        .query_main(charts[0], ranges[0][1] * 0.5, &mut budget)
+        .unwrap();
+    let raw_tube = cert.tubes[0];
+    let mut offbranch = own.point();
+    offbranch[2] += eps * 32.;
+    assert!(
+        (0..3).all(|k| offbranch[k] >= raw_tube.0[k] && offbranch[k] <= raw_tube.1[k]),
+        "offbranch control remains inside original query container"
+    );
+    assert!(cert
+        .check_point(charts[0], own.parameter(), offbranch)
+        .is_none());
+    assert!(cert
+        .retained_main(charts[0], own.parameter(), offbranch, &mut budget)
+        .is_err());
+    let mut wrong = own.point();
+    wrong[0] += 0.01;
+    assert!(cert
+        .retained_main(charts[0], own.parameter(), wrong, &mut budget)
+        .is_err());
+    assert!(cert.check_point(charts[0], f64::NAN, own.point()).is_none());
+    let before = budget.charged_queries();
+    {
+        let _cancel = crate::sfcc::cancel::CancelGuard::install(Box::new(|| true));
+        assert!(cert
+            .query_main(charts[0], own.parameter(), &mut budget)
+            .is_err());
+    }
+    assert_eq!(before, budget.charged_queries());
+    let foreign = f.clone();
+    let mut foreign_budget = super::tests::budget(&foreign);
+    assert!(cert
+        .query_main(charts[0], own.parameter(), &mut foreign_budget)
+        .is_err());
+    budget
+        .reserve_external(16384 - budget.charged_queries())
+        .unwrap();
+    assert!(matches!(
+        cert.query_main(charts[0], own.parameter(), &mut budget),
+        Err(Failure::Budget(transport_a::Failure::TotalCap))
+    ));
+    assert_eq!(budget.charged_queries(), 16384);
+}
