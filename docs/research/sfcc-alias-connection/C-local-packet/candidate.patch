+fn private_face(captured: &Value) -> FaceRecord {
+    let row = &captured["privateFace"];
+    let id = &row["face"];
+    let segments: Vec<_> = row["segments"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|p| crate::sfcc::face_contour::FaceSegment {
+            a: p[0].as_u64().unwrap() as usize,
+            b: p[1].as_u64().unwrap() as usize,
+        })
+        .collect();
+    let n = segments.len();
+    FaceRecord {
+        axis: id[0].as_u64().unwrap() as usize,
+        key: id[1].as_i64().unwrap(),
+        len: id[2].as_i64().unwrap(),
+        segments,
+        pins: row["pins"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .map(|p| FacePin {
+                curve_id: p["chart"].as_u64().unwrap() as usize,
+                point_id: p["pointId"].as_u64().unwrap() as usize,
+                t: f64::from_bits(p["parameterBits"].as_u64().unwrap()),
+            })
+            .collect(),
+        interior_cycle: false,
+        consumed_fwd: vec![0; n],
+        consumed_rev: vec![0; n],
+    }
+}
+fn local_inputs(pre: &Value) -> (Vec<Vec<usize>>, Vec<FacePin>, Vec<usize>, [f64; 6]) {
+    (
+        serde_json::from_value(pre["loops"].clone()).unwrap(),
+        pre["pins"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .map(|p| FacePin {
+                curve_id: p["chart"].as_u64().unwrap() as usize,
+                point_id: p["id"].as_u64().unwrap() as usize,
+                t: number(&p["parameterHex"]),
+            })
+            .collect(),
+        pre["corners"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .map(|c| c["id"].as_u64().unwrap() as usize)
+            .collect(),
+        std::array::from_fn(|k| number(&pre["cellBoxHex"][k])),
+    )
+}
+fn context_for(captured: &Value) {
+    let ctx = &captured["capture"]["context"];
+    let c = &ctx["cell"];
