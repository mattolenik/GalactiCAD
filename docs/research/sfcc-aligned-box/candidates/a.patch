+fn cell_id(c: &SfccCell) -> (u32, i64, i64, i64) {
+    (c.level, c.ix, c.iy, c.iz)
+}
+fn triangle(t: [usize; 3]) -> [usize; 3] {
+    let k = (0..3).min_by_key(|&i| t[i]).unwrap();
+    [t[k], t[(k + 1) % 3], t[(k + 2) % 3]]
+}
+impl Arrangement {
+    pub(crate) fn needed(&self) -> bool {
+        self.cell_rectangles.iter().any(|rows| {
+            (0..3).any(|axis| {
+                rows.iter()
+                    .filter_map(|&i| {
+                        let r = &self.rectangles[i];
+                        (r.axis == axis).then_some(r.index[axis])
+                    })
+                    .collect::<BTreeSet<_>>()
+                    .len()
+                    > 1
+            })
+        })
+    }
+    fn position(&self, p: GridPoint) -> [f64; 3] {
+        std::array::from_fn(|a| self.coordinates[a][p[a]])
+    }
+    fn edges(&self) -> BTreeMap<(GridPoint, GridPoint), Vec<usize>> {
+        let mut edges = BTreeMap::new();
+        for (i, r) in self.rectangles.iter().enumerate() {
+            let p = r.corners();
+            for j in 0..4 {
+                let (a, b) = (p[j], p[(j + 1) % 4]);
+                edges
+                    .entry((a.min(b), a.max(b)))
+                    .or_insert_with(Vec::new)
+                    .push(i);
+            }
+        }
+        edges
+    }
+    /// The complete exposed crease graph comes from adjacent target rectangles.
+    /// Its elementary segments retain every source occurrence in the rectangle
+    /// manifest; the existing quality/audit API uses one canonical active carrier.
+    pub(crate) fn features(&self) -> Result<super::feature_set::SfccFeatureSet, ArrangementError> {
+        use super::feature_set::{SfccCorner, SfccFeatureSet};
+        use crate::strata::{Stratum, StratumIdentity};
+        let mut strata = Vec::new();
+        for r in &self.rectangles {
+            let mut n = [0.; 3];
+            n[r.axis] = r.outward as f64;
+            strata.push(Stratum::plane(
+                StratumIdentity {
+                    id: strata.len(),
+                    owner_node_id: -1,
+                    leaf_index: r.occurrences[0],
+                    local_index: r.axis * 2
+                        + usize::from(
+                            self.coordinates[r.axis][r.index[r.axis]]
+                                == self.occurrences[r.occurrences[0]].bounds[r.axis][1],
+                        ),
+                    sign: 1.,
+                },
+                n[0],
+                n[1],
+                n[2],
+                -n[r.axis] * self.coordinates[r.axis][r.index[r.axis]],
+            ));
+        }
+        let mut curves = Vec::new();
+        let mut corners = Vec::<SfccCorner>::new();
+        let mut by_corner = BTreeMap::<GridPoint, usize>::new();
+        for ((a, b), rs) in self.edges() {
+            if self.rectangles[rs[0]].axis == self.rectangles[rs[1]].axis {
+                continue;
+            }
+            let p = self.position(a);
+            let q = self.position(b);
+            let d = std::array::from_fn::<_, 3, _>(|k| q[k] - p[k]);
+            if (0..3).any(|k| exact_sum_sign(p[k], d[k], q[k]) != Some(0)) {
+                return Err(ArrangementError::Arithmetic);
+            }
+            let mut curve = super::feature_curves::make_segment_curve(
+                curves.len(),
+                -1,
+                [rs[0], rs[1]],
+                p[0],
+                p[1],
+                p[2],
+                q[0],
+                q[1],
+                q[2],
+            );
+            if curve.point_at(0.) != p || curve.point_at(1.) != q {
+                return Err(ArrangementError::Arithmetic);
+            }
+            for (end, g) in [a, b].into_iter().enumerate() {
+                let ci = *by_corner.entry(g).or_insert_with(|| {
+                    let id = corners.len();
+                    let p = self.position(g);
+                    corners.push(SfccCorner {
+                        id,
+                        x: p[0],
+                        y: p[1],
+                        z: p[2],
+                        strata: Vec::new(),
+                        curve_ends: Vec::new(),
+                    });
+                    id
+                });
+                corners[ci].strata.extend(&rs);
+                corners[ci].curve_ends.push((curve.id, end as u8));
+                if end == 0 {
+                    curve.corner_start = ci as i64
+                } else {
+                    curve.corner_end = ci as i64
+                }
+            }
+            curves.push(curve);
+        }
+        let mut index = super::spatial_index::SfccSpatialIndex::new(
+            (self.coordinates[0].last().unwrap() - self.coordinates[0][0]) / 16.,
+        );
+        for c in &curves {
+            index.insert_curve(c)
+        }
+        for c in &mut corners {
+            c.strata.sort();
+            c.strata.dedup();
+            index.insert_corner(c.id, c.x, c.y, c.z)
+        }
+        Ok(SfccFeatureSet {
+            unresolved_branch_paths: Vec::new(),
+            trace_diagnostics: Default::default(),
+            curves,
+            corners,
+            index,
+            strata,
+            run_id: super::feature_set::next_feature_set_run_id(),
+        })
+    }
+    pub(crate) fn emit(
+        &self,
+        subset: &[SfccCell],
+        pt: &mut super::point_table::PointTable,
+    ) -> Vec<usize> {
+        use super::point_table::CurveInterval;
+        pt.arrangement = true;
+        let selected = subset.iter().map(cell_id).collect::<BTreeSet<_>>();
+        let mut by_vertex = BTreeMap::<GridPoint, BTreeSet<(usize, i8)>>::new();
+        for r in &self.rectangles {
+            for p in r.corners() {
+                by_vertex.entry(p).or_default().insert((r.axis, r.outward));
+            }
+        }
+        let mut ids = BTreeMap::new();
+        let mut tris = Vec::new();
+        let mut owned = vec![Vec::new(); self.cells.len()];
+        for (ri, r) in self.rectangles.iter().enumerate() {
+            if !selected.contains(&cell_id(&self.cells[r.owner])) {
+                continue;
+            }
+            let p = r.corners().map(|g| {
+                *ids.entry(g).or_insert_with(|| {
+                    let p = self.position(g);
+                    let mut n = [0.; 3];
+                    for &(a, s) in &by_vertex[&g] {
+                        n[a] += s as f64
+                    }
+                    let len = n.iter().map(|v| v * v).sum::<f64>().sqrt();
+                    if len > 0. {
+                        n = n.map(|x| x / len)
+                    } else {
+                        let &(a, s) = by_vertex[&g].first().unwrap();
+                        n[a] = s as f64;
+                    }
+                    let key = format!(
+                        "arr:{:x}:{:x}:{:x}",
+                        p[0].to_bits(),
+                        p[1].to_bits(),
+                        p[2].to_bits()
+                    );
+                    pt.get_or_create_str(&key, || [p[0], p[1], p[2], n[0], n[1], n[2]])
+                })
+            });
+            for t in [[p[0], p[1], p[2]], [p[0], p[2], p[3]]] {
+                pt.set_patch(t, ri);
+                tris.extend(t);
+                owned[r.owner].push(triangle(t));
+            }
+        }
+        let used_edges = tris
+            .chunks_exact(3)
+            .flat_map(|t| (0..3).map(move |k| (t[k].min(t[(k + 1) % 3]), t[k].max(t[(k + 1) % 3]))))
+            .collect::<BTreeSet<_>>();
+        let mut curve = 0;
+        for ((a, b), rs) in self.edges() {
+            if self.rectangles[rs[0]].axis == self.rectangles[rs[1]].axis {
+                continue;
+            }
+            if let (Some(&a), Some(&b)) = (ids.get(&a), ids.get(&b)) {
+                if used_edges.contains(&(a.min(b), a.max(b))) {
+                    pt.protect_curve_edge(
+                        a,
+                        b,
+                        CurveInterval {
+                            curve_id: curve,
+                            start: 0.,
+                            end: 1.,
+                        },
+                    );
+                }
+            }
+            curve += 1;
+        }
+        for (i, c) in self.cells.iter().enumerate() {
+            if !selected.contains(&cell_id(c)) {
+                continue;
+            }
+            assert!(
+                pt.coverage_cells.insert(cell_id(c)),
+                "duplicate arrangement cell ownership"
+            );
+            let mut triangles = std::mem::take(&mut owned[i]);
+            triangles.sort();
+            let used = triangles.iter().flatten().copied().collect::<BTreeSet<_>>();
+            let edges = triangles
+                .iter()
+                .flat_map(|t| {
+                    (0..3).map(move |k| (t[k].min(t[(k + 1) % 3]), t[k].max(t[(k + 1) % 3])))
+                })
+                .collect::<BTreeSet<_>>();
+            let vertices = used
+                .iter()
+                .map(|&i| {
+                    (
+                        i,
+                        pt.key_at(i).clone(),
+                        super::local_coverage::payload(pt, i),
+                    )
+                })
+                .collect();
+            let curves = pt
+                .identified_edges()
+                .filter(|(e, _)| edges.contains(e))
+                .flat_map(|((a, b), ii)| ii.iter().map(move |&v| (a, b, v)))
+                .collect();
+            let mut cell = *c;
+            cell.degenerate = false;
+            pt.coverage.push(super::local_coverage::Witness {
+                transported: false,
+                cell,
+                reason: None,
+                triangles,
+                vertices,
+                faces: Vec::new(),
+                curves,
+            });
+        }
+        tris
+    }
+}
+pub(crate) fn fallback(
+    tree: &CsgNode,
+    lat: &SfccLattice,
+    cells: &[SfccCell],
+) -> Result<Option<(Arrangement, super::feature_set::SfccFeatureSet)>, ArrangementError> {
+    // An unresolved prepared cell triggers this region-wide construction.
+    // Healthy octrees keep the established path without a tensor preflight.
+    if !cells.iter().any(|c| c.degenerate) {
+        return Ok(None);
+    }
+    let mut boxes = Vec::new();
+    if collect(tree, &mut Vec::new(), &mut boxes, &mut 0).is_err() {
+        return Ok(None);
+    }
+    // This broad trigger does not accept anything; it bounds when a failed
+    // full construction must remain an explicit unresolved fallback request.
+    validate_lattice(lat)?;
+    product(
+        [cells.len(), boxes.len()],
+        ArrangementBudget::default().leaf_visits,
+        ArrangementError::WorkBudget,
+    )?;
+    let mut candidate = false;
+    for c in cells {
+        let b = extent(lat, c)?;
+        for axis in 0..3 {
+            let mut planes = Vec::new();
+            for q in &boxes {
+                if (0..3).any(|a| q.bounds[a][0] > b[a + 3] || q.bounds[a][1] < b[a]) {
+                    continue;
+                }
+                for x in q.bounds[axis] {
+                    if x > b[axis] && x < b[axis + 3] && !planes.contains(&x) {
+                        planes.push(x);
+                    }
+                }
+            }
+            candidate |= planes.len() > 1;
+        }
+    }
+    match Arrangement::build(tree, lat, cells, ArrangementBudget::default()) {
+        Ok(a) if a.needed() => {
+            let f = a.features()?;
+            Ok(Some((a, f)))
+        }
+        Ok(_) => Ok(None),
+        Err(e)
+            if candidate
+                || matches!(
+                    e,
+                    ArrangementError::SingularZeroStratum | ArrangementError::NonManifold
+                ) =>
+        {
+            Err(e)
+        }
+        Err(_) => Ok(None),
+    }
+}
+pub(crate) fn rejected(
+    pt: &mut super::point_table::PointTable,
+    cells: &[SfccCell],
+    error: ArrangementError,
+) {
+    let reason = match error {
+        ArrangementError::CoordinateBudget
+        | ArrangementError::StratumBudget
+        | ArrangementError::WorkBudget => "arrangement_budget",
+        ArrangementError::SingularZeroStratum => "arrangement_zero_only_stratum",
+        ArrangementError::NonManifold => "arrangement_nonmanifold",
+        ArrangementError::Float32Collapse => "arrangement_float_collapse",
+        ArrangementError::GridContact => "arrangement_grid_contact",
+        ArrangementError::MissingCell | ArrangementError::OverlappingCells => {
+            "arrangement_cell_ownership"
+        }
+        _ => "arrangement_arithmetic",
+    };
+    for c in cells {
+        if let Some(w) = pt
+            .coverage
+            .iter_mut()
+            .find(|w| cell_id(&w.cell) == cell_id(c))
+        {
+            w.reason = Some(reason.into());
+            continue;
+        }
+        pt.coverage_cells.insert(cell_id(c));
+        pt.coverage.push(super::local_coverage::Witness {
+            transported: false,
+            cell: *c,
+            reason: Some(reason.into()),
+            triangles: Vec::new(),
+            vertices: Vec::new(),
+            faces: Vec::new(),
+            curves: Vec::new(),
+        });
+    }
+}
+
+/// Receiver checks against a fresh complete construction, including exact keys,
+/// all vertex fields, every interval and every owned triangle. Wire success and
+/// wire snapshots are never used as evidence for any missing obligations.
+pub(crate) fn reverify(
+    pt: &mut super::point_table::PointTable,
+    tree: &CsgNode,
+    lat: &SfccLattice,
+    tris: &[usize],
+) {
+    let cells = pt.coverage.iter().map(|w| w.cell).collect::<Vec<_>>();
+    let expected = Arrangement::build(tree, lat, &cells, ArrangementBudget::default());
+    let Ok(a) = expected else {
+        for w in &mut pt.coverage {
+            w.reason = Some("arrangement_receiver_domain".into())
+        }
+        return;
+    };
+    let mut other = super::point_table::PointTable::new();
+    let other_tris = a.emit(&cells, &mut other);
+    fn bags(pt: &super::point_table::PointTable, tris: &[usize]) -> Vec<[[u64; 6]; 3]> {
+        let mut out = tris
+            .chunks_exact(3)
+            .map(|t| {
+                let t = [t[0], t[1], t[2]].map(|i| super::local_coverage::payload(pt, i));
+                let k = (0..3).min_by_key(|&i| t[i]).unwrap();
+                [t[k], t[(k + 1) % 3], t[(k + 2) % 3]]
+            })
+            .collect::<Vec<_>>();
+        out.sort();
+        out
+    }
+    let actual = pt
+        .coverage
+        .iter()
+        .flat_map(|w| w.triangles.iter().flatten().copied())
+        .collect::<Vec<_>>();
+    let okay = bags(pt, tris) == bags(&other, &other_tris) && bags(pt, &actual) == bags(pt, tris);
+    let mut remap = BTreeMap::new();
+    for i in 0..pt.count() {
+        remap.insert(pt.key_at(i).clone(), i);
+    }
+    let mut rebuilt = Vec::new();
+    for w in other.coverage {
+        let ids = w
+            .vertices
+            .iter()
+            .map(|(i, k, p)| {
+                remap
+                    .get(k)
+                    .copied()
+                    .filter(|&j| super::local_coverage::payload(pt, j) == *p)
+                    .map(|j| (*i, j))
+            })
+            .collect::<Option<BTreeMap<_, _>>>();
+        let Some(ids) = ids else {
+            for w in &mut pt.coverage {
+                w.reason = Some("arrangement_receiver_payload".into())
+            }
+            return;
+        };
+        let mut w = w;
+        for t in &mut w.triangles {
+            *t = triangle(t.map(|i| ids[&i]));
+        }
+        w.triangles.sort();
+        for (i, _, _) in &mut w.vertices {
+            *i = ids[i]
+        }
+        for (a, b, c) in &mut w.curves {
+            *a = ids[a];
+            *b = ids[b];
+            if *a > *b {
+                std::mem::swap(a, b);
+                *c = c.reversed();
+            }
+        }
+        let expected_edges = w
+            .triangles
+            .iter()
+            .flat_map(|t| (0..3).map(move |k| (t[k].min(t[(k + 1) % 3]), t[k].max(t[(k + 1) % 3]))))
+            .collect::<BTreeSet<_>>();
+        let curves_ok = expected_edges.iter().all(|&(a, b)| {
+            let mut expected = w
+                .curves
+                .iter()
+                .filter(|&&(x, y, _)| x == a && y == b)
+                .map(|(_, _, c)| (c.curve_id, c.start.to_bits(), c.end.to_bits()))
+                .collect::<Vec<_>>();
+            expected.sort();
+            let mut actual = pt
+                .curve_intervals(a, b)
+                .iter()
+                .map(|c| (c.curve_id, c.start.to_bits(), c.end.to_bits()))
+                .collect::<Vec<_>>();
+            actual.sort();
+            expected == actual
+        });
+        let ownership = pt
+            .coverage
+            .iter()
+            .find(|old| cell_id(&old.cell) == cell_id(&w.cell))
+            .is_some_and(|old| old.triangles == w.triangles);
+        if !okay || !curves_ok || !ownership {
+            w.reason = Some("arrangement_receiver_complex".into())
+        }
+        rebuilt.push(w);
+    }
+    pt.coverage = rebuilt;
+}
