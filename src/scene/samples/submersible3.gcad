// Deep-Sea "Experience" Submersible — Final Form
// The Abyss-Class Titan II: Founder's Edition
// "We've addressed all the criticism by making it bigger and adding a hot tub"
// Now with EVEN LESS engineering oversight


// ═══ PRESSURE HULL ═══
// Still a cylinder. Still carbon fibre. But now WIDER
// to fit the wet bar and the DJ booth.
// A whistleblower tried to report the hull to the coast guard
// but was silenced with an NDA and a gift bag.
let hull = box([12, 12, 22]).shift([0, 0, 0])
let hullRound = sphere.radius(28).shift([0, 0, 0])
let pressureHull = intersect(hull, hullRound).round(3)

// Endcaps now held on with construction adhesive
// "It's the same stuff they use on the space shuttle" (it is not)
let endcapTop = sphere.radius(12).shift([0, 0, 20])
let endcapBot = sphere.radius(12).shift([0, 0, -20])
let tube = union(pressureHull, endcapTop, endcapBot).round(2)

// ═══ VIEWPORT ═══
// Upgraded from one shower door to TWO shower doors
// "Redundancy!" says the billionaire. "That's engineering!"
let vpR = sphere.radius(5).shift([14, 4, 0])
let vpL = sphere.radius(5).shift([14, -4, 0])

// ═══ "FAIRING" ═══
// The intern was promoted to Chief Naval Architect
// He added more flat panels. They are thicker now. "Stronger."
let panelF = box([3, 14, 18]).shift([10, 0, 0])
let panelR = box([14, 3, 18]).shift([0, 10, 0])
let panelL = box([14, 3, 18]).shift([0, -10, 0])
let panelB = box([3, 14, 18]).shift([-10, 0, 0])
let fairing = union(panelF, panelR, panelL, panelB).round(1)

let bodyRaw = union(tube, fairing, vpR, vpL).round(2)

// ═══ BALLAST "SYSTEM" ═══
// The sandbags are back. Now there are more of them.
// Someone suggested "maybe use actual ballast tanks" and was fired.
let sb1 = sphere.radius(4).shift([0, 12, -14])
let sb2 = sphere.radius(4).shift([0, -12, -14])
let sb3 = sphere.radius(3.5).shift([0, 12, 14])
let sb4 = sphere.radius(3.5).shift([0, -12, 14])
let sb5 = sphere.radius(3).shift([0, 12, 0])
let sb6 = sphere.radius(3).shift([0, -12, 0])
let sb7 = sphere.radius(3).shift([0, 12, 7])
let sb8 = sphere.radius(3).shift([0, -12, 7])
let sb9 = sphere.radius(3).shift([0, 12, -7])
let sb10 = sphere.radius(3).shift([0, -12, -7])
let ballast = union(sb1, sb2, sb3, sb4, sb5, sb6, sb7, sb8, sb9, sb10)

// ═══ PROPULSION ═══
// Two jet ski thrusters now. Both mounted off-centre.
// One points slightly up. The other slightly down.
// "They'll average out" — actual quote from the design review
let thruster1 = sphere.radius(4).shift([-12, 5, -14])
let thruster1Mount = box([4, 3, 3]).shift([-10, 5, -14])
let thruster2 = sphere.radius(4).shift([-12, -6, -10])
let thruster2Mount = box([4, 3, 3]).shift([-10, -6, -10])
let propulsion = union(thruster1, thruster1Mount, thruster2, thruster2Mount).round(1)

// ═══ LIFE SUPPORT ═══
// Still camping tanks. Fewer of them now because two fell off
// during the last test dive and nobody replaced them.
// "We'll just breathe slower"
let tank1 = sphere.radius(2.5).shift([5, 5, 22])
let tank2 = sphere.radius(2.5).shift([-5, -5, 22])
let tanks = union(tank1, tank2)

// ═══ LUXURY OBSERVATION DOME ═══
// Even bigger now. Double height. Zero engineering.
// "The guests need to see the bioluminescence"
let loungeDome = sphere.radius(12).shift([0, 0, 26])
let loungeFloor = plane.withNormal([0, 0, 1]).shift([0, 0, 20])
let lounge = subtract(loungeDome, loungeFloor)

// ═══ HOT TUB ═══
// Yes. A hot tub. On a deep-sea submersible.
// Mounted externally on the top because it "didn't fit inside."
// Filled with seawater at depth. "It's a feature."
let tubOuter = sphere.radius(7).shift([0, 0, 36])
let tubInner = sphere.radius(6).shift([0, 0, 38])
let tubFloor = plane.withNormal([0, 0, 1]).shift([0, 0, 34])
let hotTub = subtract(subtract(tubOuter, tubInner), tubFloor)

// ═══ COMMUNICATIONS ═══
// Starlink dish is back, now flanked by two more dishes
// "Mesh networking!" (they are not networked)
let dish1 = sphere.radius(4).shift([0, 0, 42])
let dish1Cut = sphere.radius(4).shift([0, 0, 45])
let dishMain = subtract(dish1, dish1Cut)
let dish2 = sphere.radius(3).shift([5, 0, 40])
let dish2Cut = sphere.radius(3).shift([5, 0, 43])
let dishR = subtract(dish2, dish2Cut)
let dish3 = sphere.radius(3).shift([-5, 0, 40])
let dish3Cut = sphere.radius(3).shift([-5, 0, 43])
let dishL = subtract(dish3, dish3Cut)
let dishMast = box([1, 1, 6]).shift([0, 0, 38])
let comms = union(dishMain, dishR, dishL, dishMast).round(0.5)

// ═══ SPONSORSHIP BILLBOARDS ═══
// Now on BOTH sides. And the back. And the top.
// The billionaire's face is on one of them.
let billboardR = box([14, 0.5, 10]).shift([0, 14, 4])
let billboardL = box([14, 0.5, 10]).shift([0, -14, 4])
let billboardBack = box([0.5, 14, 10]).shift([-14, 0, 4])
let billboardTop = box([10, 10, 0.5]).shift([0, 0, 32])
let billboards = union(billboardR, billboardL, billboardBack, billboardTop)

// ═══ "SAFETY" SYSTEM ═══
// The PlayStation controller has been upgraded to a Logitech gamepad
// Found on Amazon for $29.99. "It has more buttons"
// Also: one (1) glow stick
let controller = box([3, 4, 1]).shift([8, 0, 22])
let glowStick = box([0.3, 0.3, 3]).shift([10, 0, 24])

// ═══ LANDING GEAR ═══
// Upgraded from shopping trolley wheels to go-kart wheels
// Still no suspension. "The ocean floor is flat, right?"
let wheelFR = sphere.radius(3).shift([8, 8, -24])
let wheelFL = sphere.radius(3).shift([8, -8, -24])
let wheelRR = sphere.radius(3).shift([-8, 8, -24])
let wheelRL = sphere.radius(3).shift([-8, -8, -24])
// Bonus: a spare wheel, bolted to the back
let spare = sphere.radius(3).shift([-14, 0, -8])
let wheels = union(wheelFR, wheelFL, wheelRR, wheelRL, spare)
let axleF = box([1, 9, 1]).shift([8, 0, -24])
let axleR = box([1, 9, 1]).shift([-8, 0, -24])

// ═══ DECORATIVE FINS ═══
// Now FOUR fins because "more fins = more stable"
// The CFD simulation was done in Microsoft Paint
let finR = rotate([0, 20, 0], box([8, 1, 10]).shift([0, 14, -10]))
let finL = rotate([0, -20, 0], box([8, 1, 10]).shift([0, -14, -10]))
let finTop = box([10, 1, 5]).shift([0, 0, 30])
let finBot = box([10, 1, 5]).shift([0, 0, -18])

// ═══ VIP HANDRAIL ═══
// Now gold-plated. $120,000.
// Longer too, so more influencers can pose at once.
let railR = box([1, 1, 16]).shift([10, 8, 8])
let railL = box([1, 1, 16]).shift([10, -8, 8])
let railTop = box([1, 9, 1]).shift([10, 0, 22])
let railBot = box([1, 9, 1]).shift([10, 0, -6])
let handrail = union(railR, railL, railTop, railBot).round(0.5)

// ═══ HELICOPTER PAD ═══
// A flat platform on the very top. For the "emergency helicopter."
// There is no emergency helicopter. There is no helicopter that
// can land on a submerged submarine. But it's in the brochure.
let helipad = box([12, 12, 0.5]).shift([0, 0, 44])
let helipadBumper1 = sphere.radius(1.5).shift([10, 10, 44])
let helipadBumper2 = sphere.radius(1.5).shift([10, -10, 44])
let helipadBumper3 = sphere.radius(1.5).shift([-10, 10, 44])
let helipadBumper4 = sphere.radius(1.5).shift([-10, -10, 44])
let helipadAsm = union(helipad, helipadBumper1, helipadBumper2, helipadBumper3, helipadBumper4)

// ═══ ESCAPE POD ═══
// It's a beach ball with a GoPro taped to it.
// "In an emergency, the guest can... float."
let escapePod = sphere.radius(4).shift([-14, 0, 10])
let gopro = box([1, 1, 1]).shift([-16, 0, 12])

// ═══ ASSEMBLY ═══
let structure = union(bodyRaw, lounge, hotTub, comms, billboards, controller, glowStick).round(1)
let externals = union(ballast, propulsion, tanks, handrail)
let landing = union(wheels, axleF, axleR)
let fins = union(finR, finL, finTop, finBot)
let topDeck = union(helipadAsm, escapePod, gopro)

return union(structure, externals, landing, fins, topDeck).round(1)
