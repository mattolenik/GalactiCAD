+            f,
+            &cert,
+            &mut budget,
+            &context.lat,
+            (1, key, len),
+            &r,
+            plane.next_up(),
+            &live
+        )
+        .unwrap_err(),
+        "typed_face_plane"
+    );
+    let other = f.clone();
+    assert_eq!(
+        admit(
+            &other,
+            &cert,
+            &mut budget,
+            &context.lat,
+            (1, key, len),
+            &r,
+            plane,
+            &live
+        )
+        .unwrap_err(),
+        "source_instance"
+    );
+    let mut bad = PointTable::new();
+    for id in 0..=max {
+        bad.add(live.x(id), live.y(id), live.z(id), 0., 0., 0.);
+    }
+    assert_eq!(
+        admit(
+            f,
+            &cert,
+            &mut budget,
+            &context.lat,
+            (1, key, len),
+            &r,
+            plane,
+            &bad
+        )
+        .unwrap_err(),
+        "pin_provenance"
+    );
+    assert_eq!(budget.charged_queries(), before + 2);
+    std::fs::write(std::env::var("SFCC_ALIAS_B_RECEIPT").unwrap(),serde_json::to_vec_pretty(&json!({"proof":proof,"sourceReceiptSha256":captured["sourceReceiptSha256"],"fixtureScope":"original target FaceRecord and target point bindings; filler point slots are not a full scene replay","negativeControlsPassed":true})).unwrap()).unwrap();
