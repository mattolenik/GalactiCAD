+fn at_mut<'a>(root: &'a mut CsgNode, path: &[usize]) -> &'a mut CsgNode {
+    if path.is_empty() {
+        return root;
+    }
+    match root {
+        CsgNode::Min(c) | CsgNode::Max(c) | CsgNode::Blend { children: c, .. } => {
+            at_mut(&mut c[path[0]], &path[1..])
+        }
+        _ => panic!("source path"),
+    }
+}
