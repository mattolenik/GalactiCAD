+//! Checked original-chart parameters for an interior source activation annotation.
+//! Preparation only: this module edits no feature, face, point or graph.
+use super::*;
+use crate::sfcc::{
+    feature_set::SfccFeatureSet,
+    shared_twisted_proof::correlated_c::transport_a::{self, Transport},
+};
+use serde_json::{json, Value};
