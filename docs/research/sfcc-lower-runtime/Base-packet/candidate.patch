+#[test]
+fn lower_c_generated_reservation_finish_drop_and_failed_attempts_stay_charged() {
+    let (tree, v) = fixture();
+    let size = v["cube"]["max"][0].as_f64().unwrap() - v["cube"]["min"][0].as_f64().unwrap();
+    let tol = crate::tolerances::resolve_tolerances(&crate::tuning::SfccTuning::default(), (3. * size * size).sqrt());
+    let (f, _) = crate::sfcc::feature_set::compile_feature_set(&tree, &tol);
+    let ids = crate::sfcc::stage4_source_preflight_c::selected_pair_c(&f).unwrap();
+    let mut transport = Transport::bind(&f, ids, 0.02).unwrap();
+    DIAGNOSTIC.with(|s| *s.borrow_mut() = Some(json!({})));
+    let before = transport.charged_queries();
+    let scope = GeneratedQueries::begin(&mut transport).unwrap();
+    assert!(GeneratedQueries::begin(&mut transport).is_err());
+    assert!(f.curves[ids[0]].point_at_checked(f64::NAN).is_none());
+    let events = scope.finish().unwrap();
+    assert_eq!(events.len(), 1);
+    assert!(events[0].point.is_none());
+    assert_eq!(transport.charged_queries(), before + GENERATED_RESERVATION);
+    let finished = DIAGNOSTIC.with(|s| s.borrow().as_ref().unwrap()["generatedQueryCost"].clone());
+    assert_eq!(finished["unusedReserved"], GENERATED_RESERVATION - 1);
+    assert_eq!(finished["refunded"], 0);
+    assert_eq!(finished["successful"], 0);
+    assert_eq!(finished["finished"], true);
+    {
+        let _scope = GeneratedQueries::begin(&mut transport).unwrap();
+        assert!(f.curves[ids[0]].point_at_checked(f64::NAN).is_none());
+    }
+    assert_eq!(transport.charged_queries(), before + 2 * GENERATED_RESERVATION);
+    assert!(QUERY_LOG.with(|s| s.borrow().is_none()));
+    let dropped = DIAGNOSTIC.with(|s| s.borrow().as_ref().unwrap()["generatedQueryCost"].clone());
+    assert_eq!(dropped["finished"], false);
+    assert_eq!(dropped["attempted"], 1);
+    // All 2048 actual failed own queries count; the 2049th is refused before evaluation.
+    let scope = GeneratedQueries::begin(&mut transport).unwrap();
+    for _ in 0..GENERATED_RESERVATION { assert!(f.curves[ids[0]].point_at_checked(f64::NAN).is_none()); }
+    assert!(f.curves[ids[0]].point_at_checked(f64::NAN).is_none());
+    assert!(scope.finish().is_err());
+    assert_eq!(transport.charged_queries(), before + 3 * GENERATED_RESERVATION);
+    let exhausted = DIAGNOSTIC.with(|s| s.borrow().as_ref().unwrap()["generatedQueryCost"].clone());
+    assert_eq!(exhausted["attempted"], GENERATED_RESERVATION);
+    assert_eq!(exhausted["unusedReserved"], 0);
+    assert_eq!(exhausted["exhausted"], true);
+    assert!(QUERY_LOG.with(|s| s.borrow().is_none()));
+    drop(transport);
+    let captured = DIAGNOSTIC.with(|s| s.borrow_mut().take()).unwrap();
+    assert_eq!(captured["queryCosts"]["bind"]["ledgerEquationHolds"], true);
+}
