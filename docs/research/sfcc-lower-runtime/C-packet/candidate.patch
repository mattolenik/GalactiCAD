+use super::*;
+use crate::sfcc::feature_curves::make_traced_curve;
+use serde_json::{json, Value};
+
+fn fixture() -> (SfccFeatureSet, [usize; 2]) {
+    let config: Value =
+        serde_json::from_str(include_str!("../../fixtures/shared-arc-full-knob.json")).unwrap();
+    let root = crate::scene_bridge::build_csg_tree_from_json(config["sceneJson"].as_str().unwrap())
+        .unwrap();
+    let size =
+        config["cube"]["max"][0].as_f64().unwrap() - config["cube"]["min"][0].as_f64().unwrap();
+    let tol = crate::tolerances::resolve_tolerances(
+        &crate::tuning::SfccTuning::default(),
+        (3. * size * size).sqrt(),
+    );
+    let (f, _) = crate::sfcc::feature_set::compile_feature_set(&root, &tol);
+    let ids = crate::sfcc::stage4_source_preflight_c::selected_pair_c(&f).unwrap();
+    (f, ids)
+}
+
+fn campaign(f: &SfccFeatureSet, ids: [usize; 2]) -> (Vec<[CheckedEvent; 3]>, Value, f64) {
+    let mut solver = Transport::bind(f, ids, 0.02).unwrap();
+    let mut events = Vec::new();
+    solver.complete(&mut events).unwrap();
+    for slot in 0..2 {
+        let knots = solver.knots[slot].clone();
+        for span in knots.windows(2) {
+            for fraction in [0.25, 0.5, 0.75] {
+                let t = span[0] + fraction * (span[1] - span[0]);
+                let own = solver.own(ids[slot], t).unwrap();
+                let pair = solver.pair(own).unwrap();
+                assert!(pair
+                    .iter()
+                    .all(|p| accepts(pair[0].point, p.point, solver.allowance())));
+                events.push(pair);
+            }
+        }
+    }
+    solver.check_sequences(&events).unwrap();
+    (events, solver.cost_json(), solver.allowance())
+}
