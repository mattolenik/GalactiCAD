+pub(crate) fn status_begin(t: f64) {
+    STATE.with(|s| {
+        if let Some(s) = s.borrow_mut().as_mut() {
+            s.sample = None;
+            if s.curve.is_some_and(|c| selected_pair(c.pair)) {
+                s.sequence += 1;
+                s.sample = Some((s.sequence, t));
+            }
+        }
+    });
+}
+pub(crate) fn status_point(p: [f64; 3]) {
+    if !in_window(p) {
+        STATE.with(|s| {
+            if let Some(s) = s.borrow_mut().as_mut() {
+                s.sample = None;
+            }
+        });
+        return;
+    }
+    if active_sample() {
+        emit("status_point", || json!({"pointHex":point(p)}));
+    }
+}
+pub(crate) fn reason(code: &'static str) {
