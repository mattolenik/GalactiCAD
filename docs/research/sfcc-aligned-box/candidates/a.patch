+    Arrangement::build(&tree, &lat, &cells, ArrangementBudget::default())
+}
+fn sheets() -> Value {
+    json!({"kind":"union","children":[cuboid([-1.875,0.,0.],[2.125,4.,4.]),{"kind":"intersect","lh":cuboid([2.25,0.,0.],[1.75,4.,4.]),"rh":cuboid([-1.625,0.,0.],[2.375,4.,4.])}]})
+}
+fn dump(name: &str, a: &Arrangement) {
+    if let Ok(dir) = std::env::var("SFCC_ARRANGEMENT_A_DIR") {
+        std::fs::create_dir_all(&dir).unwrap();
+        let (p, t) = a.mesh();
+        let rectangles:Vec<_>=a.rectangles.iter().map(|r|json!({"axis":r.axis,"index":r.index,"outward":r.outward,"owner":r.owner,"occurrences":r.occurrences})).collect();
+        let cells: Vec<_> = a
+            .cells
+            .iter()
+            .map(|c| json!([c.level, c.ix, c.iy, c.iz]))
+            .collect();
+        std::fs::write(format!("{dir}/{name}.json"),serde_json::to_string_pretty(&json!({"coordinates":a.coordinates,"positions":p,"triangles":t,"rectangles":rectangles,"cells":cells,"classifiedStrata":a.classified_strata})).unwrap()+"\n").unwrap();
+    }
+}
