+/// A piece additionally binds the ACTUAL original chart interval and its old
+/// projection container. Neither a point nor a caller certificate flag is input
+/// to consume(): the numerical point is independently queried from that chart.
+#[derive(Clone)]
+pub(crate) struct ConsumedPiece<'a> {
+    source: BranchCertificate<'a>,
+    chart: usize,
+    range: [f64; 2],
+    tube: ([f64; 3], [f64; 3]),
+    eps: f64,
+}
+#[derive(Clone, Debug)]
+pub(crate) struct CheckedEvent {
+    chart: usize,
+    parameter: f64,
+    point: [f64; 3],
+    distance_upper: f64,
+}
+impl CheckedEvent {
+    pub(crate) fn chart(&self) -> usize {
+        self.chart
+    }
+    pub(crate) fn parameter(&self) -> f64 {
+        self.parameter
+    }
+    pub(crate) fn point(&self) -> [f64; 3] {
+        self.point
+    }
+    pub(crate) fn distance_upper(&self) -> f64 {
+        self.distance_upper
+    }
+}
+impl<'a> ConsumedPiece<'a> {
+    pub(crate) fn bind(
+        features: &'a SfccFeatureSet,
+        branch: &HelixBranch,
+        ids: [usize; 2],
+        chart: usize,
+        range: [f64; 2],
+        tolerance: f64,
+    ) -> Option<Self> {
+        if !ids.contains(&chart) {
+            return None;
+        }
+        if ids[0] == ids[1] || ids.iter().any(|&id| id >= features.curves.len()) {
+            return None;
+        }
+        let support = ids.map(|id| features.curves[id].adjacent_strata);
+        if !support.iter().all(|s| s.contains(&branch.cylinder_id))
+            || !((support[0].contains(&branch.native) && support[1].contains(&branch.field))
+                || (support[1].contains(&branch.native) && support[0].contains(&branch.field)))
+        {
+            return None;
+        }
+
+        let eps = super::super::shared_arc_plan::numerical(features, ids[0], ids[1], tolerance)?;
+        for id in ids {
+            let curve = features.curves.get(id)?;
+            let (a, b, _) = curve.traced_carriers()?;
+            for (s, index) in [
+                (&a, curve.adjacent_strata[0]),
+                (&b, curve.adjacent_strata[1]),
+            ] {
+                if s.id != index || !s.correlated_same_chart_source_c(features.strata.get(index)?) {
+                    return None;
+                }
+            }
+        }
+        let curve = features.curves.get(chart)?;
+        let tube = curve.projection_tube(range[0], range[1])?;
+        let source = BranchCertificate::bind(features, branch, interval(tube.0[1], tube.1[1])?)?;
+        Some(Self {
+            source,
+            chart,
+            range,
+            tube,
+            eps,
+        })
+    }
+    pub(crate) fn consume(&self, parameter: f64) -> Result<CheckedEvent, EventFailure> {
+        if !parameter.is_finite() || parameter < self.range[0] || parameter > self.range[1] {
+            return Err(EventFailure::ParameterOutsidePiece);
+        }
+        let curve = &self.source.features.curves[self.chart];
+        let point = curve
+            .shared_checked_point(parameter)
+            .ok_or(EventFailure::QueryFailed)?;
+        if !(0..3).all(|k| point[k] >= self.tube.0[k] && point[k] <= self.tube.1[k]) {
+            return Err(EventFailure::OriginalContainer);
+        }
+        let distance_upper = self.source.point_on_branch_within(point, self.eps)?;
+        Ok(CheckedEvent {
+            chart: self.chart,
+            parameter,
+            point,
+            distance_upper,
+        })
+    }
+    pub(crate) fn check_endpoint_point(&self, point: [f64; 3]) -> Result<f64, EventFailure> {
+        self.source.point_on_branch_within(point, self.eps)
+    }
+    pub(crate) fn branch(&self) -> &BranchCertificate<'a> {
+        &self.source
+    }
+    pub(crate) fn original_container(&self) -> ([f64; 3], [f64; 3]) {
+        self.tube
+    }
+    pub(crate) fn allowance(&self) -> f64 {
+        self.eps
+    }
+}
