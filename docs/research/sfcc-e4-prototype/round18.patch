+//! Narrow shared-root certificate for a native twisted side and an inactive
+//! round-union field over that SAME source leaf, intersecting one cylinder.
+//! Real represented equations are enclosed; this is not an SDF evaluator or a
+//! global feature-coverage certificate. Oblique selected profile edges reject.
+use super::{
+    feature_set::SfccFeatureSet,
+    loft_seam::{abs_max, div, gradient, interval, local, mul, norm2, square},
+};
+use crate::{
+    sdf::{enclosure::Interval as I, Leaf, Shape},
+    strata::{Stratum, TwistedSideParams},
+};
+
+fn sqrt(a: I) -> Option<I> {
+    if a.hi < 0. {
+        return None;
+    }
+    interval(
+        a.lo.max(0.).sqrt().next_down().max(0.),
+        a.hi.sqrt().next_up(),
+    )
+}
+fn midpoint(a: I) -> Option<f64> {
+    let m = a.lo * 0.5 + a.hi * 0.5;
+    (m.is_finite() && m >= a.lo && m <= a.hi).then_some(m)
+}
+
+/// Taylor's remainder bound uses |sin^(n)|,|cos^(n)| <=1. No libm trig
+/// accuracy premise. Centered Lipschitz expansion avoids interval dependency
+/// inflation on the wider whole-arc projection tube. Work is fixed (32 terms).
+fn sin_cos(a: I) -> Option<(I, I)> {
+    let c = midpoint(a)?;
+    if c.abs() > 8. {
+        return None;
+    }
+    let c2 = square(I::point(c))?;
+    let (mut s, mut cs) = (I::point(c), I::point(1.));
+    let (mut st, mut ct) = (s, cs);
+    for k in 1..32 {
+        st = div(mul(st, c2)?.mul(-1.)?, ((2 * k) * (2 * k + 1)) as f64)?;
+        ct = div(mul(ct, c2)?.mul(-1.)?, ((2 * k - 1) * (2 * k)) as f64)?;
+        s = s.add(st)?;
+        cs = cs.add(ct)?;
+    }
+    let mut remainder = I::point(1.);
+    for k in 1..=64 {
+        remainder = div(remainder.mul(c.abs())?, k as f64)?;
+    }
+    let cos_error = remainder.hi;
+    let sin_error = div(remainder.mul(c.abs())?, 65.)?.hi;
+    let radius = (c - a.lo).abs().max((a.hi - c).abs()).next_up();
+    let widen = |value: I, error: f64| {
+        let pad = I::point(error).add(I::point(radius))?.hi;
+        interval(
+            (value.lo - pad).next_down().max(-1.),
+            (value.hi + pad).next_up().min(1.),
+        )
+    };
+    Some((widen(s, sin_error)?, widen(cs, cos_error)?))
+}
+
+fn twisted(
+    p: TwistedSideParams,
+    lo: [f64; 3],
+    hi: [f64; 3],
+) -> Option<(I, [I; 3], [I; 3], [I; 2])> {
+    if !p.h.is_finite() || p.h <= 0. || !p.twist_rad.is_finite() || p.twist_rad == 0. {
+        return None;
+    }
+    let q = local(&p.sim, [p.pos_x, p.pos_y, p.pos_z], lo, hi)?;
+    let t = div(q[1].add(I::point(p.h))?, 2. * p.h)?;
+    if t.lo <= 0. || t.hi >= 1. {
+        return None;
+    }
+    let (s, c) = sin_cos(t.mul(p.twist_rad)?)?;
+    let x = mul(c, q[0])?.add(mul(s, q[2])?)?;
+    let z = mul(s, q[0])?.mul(-1.)?.add(mul(c, q[2])?)?;
+    let value = x
+        .sub(I::point(p.v0x))?
+        .mul(p.nx2)?
+        .add(z.sub(I::point(p.v0z))?.mul(p.nz2)?)?;
+    let k = div(I::point(p.twist_rad), 2. * p.h)?;
+    let g = [
+        c.mul(p.nx2)?.sub(s.mul(p.nz2)?)?,
+        mul(k, z.mul(p.nx2)?.sub(x.mul(p.nz2)?)?)?,
+        s.mul(p.nx2)?.add(c.mul(p.nz2)?)?,
+    ];
+    Some((value, gradient(&p.sim, g)?, q, [x, z]))
+}
+
+/// Strict convexity and the actual axis-aligned selected source edge identify
+/// one zero-boundary branch. Other edges use unnormalized represented vectors;
+/// their rounded unit normals are never assumed exactly perpendicular.
+fn profile_branch(p: TwistedSideParams, leaf: &Leaf, q: [I; 2]) -> Option<()> {
+    let Shape::Extrude { verts, .. } = &leaf.shape else {
+        return None;
+    };
+    let n = verts.len() / 2;
+    if n < 3 || n > 64 || verts.len() != 2 * n || verts.iter().any(|v| !v.is_finite()) {
+        return None;
+    }
+    let v = |i: usize| [verts[2 * (i % n)], verts[2 * (i % n) + 1]];
+    let orientation = super::predicates::orient2d(v(0), v(1), v(2));
+    if orientation == 0 {
+        return None;
+    }
+    for i in 0..n {
+        for j in 0..n {
+            if j == i || j == (i + 1) % n {
+                continue;
+            }
+            if super::predicates::orient2d(v(i), v(i + 1), v(j)) != orientation {
+                return None;
+            }
+        }
+    }
+    let selected = (0..n).find(|&i| v(i) == [p.v0x, p.v0z])?;
+    let a = v(selected);
+    let b = v(selected + 1);
+    let d = [b[0] - a[0], b[1] - a[1]];
+    let sign = orientation as f64;
+    let expected = if d[0] == 0. && d[1] != 0. {
+        [sign * d[1].signum(), 0.]
+    } else if d[1] == 0. && d[0] != 0. {
+        [0., -sign * d[0].signum()]
+    } else {
+        return None;
+    };
+    if [p.nx2, p.nz2] != expected {
+        return None;
+    }
+    for i in 0..n {
+        let a = v(i);
+        let b = v(i + 1);
+        // Interval subtraction retains the represented endpoint arithmetic.
+        let ex = I::point(b[0]).sub(I::point(a[0]))?;
+        let ez = I::point(b[1]).sub(I::point(a[1]))?;
+        let wx = q[0].sub(I::point(a[0]))?;
+        let wz = q[1].sub(I::point(a[1]))?;
+        if i == selected {
+            let along = mul(ex, wx)?.add(mul(ez, wz)?)?;
+            let length = square(ex)?.add(square(ez)?)?;
+            if along.lo <= 0. || along.hi >= length.lo {
+                return None;
+            }
+        } else if mul(ex, wz)?.sub(mul(ez, wx)?)?.mul(sign)?.lo <= 0. {
+            return None;
+        }
+    }
+    Some(())
+}
+
+/// A lower bound on one explicitly supported competitor, not a scene query.
+/// Radially beyond every profile vertex the even/odd meridian test is outside.
+fn lathe_lower(leaf: &Leaf, lo: [f64; 3], hi: [f64; 3]) -> Option<f64> {
+    let Shape::Lathe { edges } = &leaf.shape else {
+        return None;
+    };
+    if leaf.sign != 1. || edges.is_empty() || edges.len() > 64 {
+        return None;
+    }
+    let q = local(&leaf.sim, leaf.pos, lo, hi)?;
+    let rho = norm2(q[0], q[2])?;
+    let mut lower = f64::INFINITY;
+    for (i, e) in edges.iter().enumerate() {
+        let next = &edges[(i + 1) % edges.len()];
+        if [e.r0, e.y0, e.r1, e.y1].iter().any(|x| !x.is_finite())
+            || e.r1 != next.r0
+            || e.y1 != next.y0
+            || rho.lo <= e.r0.max(e.r1)
+        {
+            return None;
+        }
+        if matches!(e.kind, crate::primitives::shapes::LatheEdgeKind::None) {
+            continue;
+        }
+        let ex = I::point(e.r1).sub(I::point(e.r0))?;
+        let ey = I::point(e.y1).sub(I::point(e.y0))?;
+        let wx = rho.sub(I::point(e.r0))?;
+        let wy = q[1].sub(I::point(e.y0))?;
+        let length = square(ex)?.add(square(ey)?)?;
+        if length.lo <= 0. {
+            return None;
+        }
+        let along = mul(ex, wx)?.add(mul(ey, wy)?)?;
+        let reciprocal = interval((1. / length.hi).next_down(), (1. / length.lo).next_up())?;
+        let t = mul(along, reciprocal)?;
+        let t = I {
+            lo: t.lo.clamp(0., 1.),
+            hi: t.hi.clamp(0., 1.),
+        };
+        let dx = wx.sub(mul(ex, t)?)?;
+        let dy = wy.sub(mul(ey, t)?)?;
+        lower = lower.min(sqrt(square(dx)?.add(square(dy)?)?)?.lo);
+    }
+    let world = I::point(lower).mul(leaf.sim.s)?;
+    (world.lo.is_finite() && leaf.sim.s > 0.).then_some(world.lo)
+}
+
+fn inactive_competitor(leaf: &Leaf, radius: f64, lo: [f64; 3], hi: [f64; 3]) -> bool {
+    radius.is_finite()
+        && radius > 0.
+        && lathe_lower(leaf, lo, hi).is_some_and(|lower| lower > radius)
+}
+
+/// Cover the ORIGINAL region with at most 64 leaves /127 visited boxes.
+/// Only source restrictions subdivide; the transverse uniqueness bound remains
+/// on the unsplit region. Shared represented split planes leave no gaps.
+fn source_restrictions(
+    p: TwistedSideParams,
+    leaf: &Leaf,
+    other: Option<(&Leaf, f64)>,
+    lo: [f64; 3],
+    hi: [f64; 3],
+) -> Option<usize> {
+    const MAX_DEPTH: usize = 6;
+    const MAX_BOXES: usize = (1 << (MAX_DEPTH + 1)) - 1;
+    let mut pending = vec![(lo, hi, 0)];
+    let mut visited = 0;
+    while let Some((lo, hi, depth)) = pending.pop() {
+        visited += 1;
+        if visited > MAX_BOXES { return None; }
+        let (_, _, _, q) = twisted(p, lo, hi)?;
+        if profile_branch(p, leaf, q).is_some()
+            && other.is_none_or(|(other, r)| inactive_competitor(other, r, lo, hi))
+        { continue; }
+        if depth == MAX_DEPTH { return None; }
+        let axis = (0..3).max_by(|&a, &b| (hi[a]-lo[a]).total_cmp(&(hi[b]-lo[b])))?;
+        let mid = midpoint(interval(lo[axis], hi[axis])?)?;
+        if mid <= lo[axis] || mid >= hi[axis] { return None; }
+        let mut left_hi = hi;
+        let mut right_lo = lo;
+        left_hi[axis] = mid;
+        right_lo[axis] = mid;
+        pending.push((right_lo, hi, depth+1));
+        pending.push((lo, left_hi, depth+1));
+    }
+    Some(visited)
+}
+
+fn radial(
+    a: [f64; 3],
+    u: [f64; 3],
+    radius: f64,
+    lo: [f64; 3],
+    hi: [f64; 3],
+) -> Option<(I, [I; 3])> {
+    if !radius.is_finite() || radius <= 0. || a.iter().chain(&u).any(|x| !x.is_finite()) {
+        return None;
+    }
+    let mut v = [I::point(0.); 3];
+    let mut dot = I::point(0.);
+    for k in 0..3 {
+        v[k] = interval(lo[k], hi[k])?.sub(I::point(a[k]))?;
+        dot = dot.add(v[k].mul(u[k])?)?;
+    }
+    let mut r = [I::point(0.); 3];
+    let mut value = I::point(0.);
+    let mut along = I::point(0.);
+    for k in 0..3 {
+        r[k] = v[k].sub(dot.mul(u[k])?)?;
+        value = value.add(square(r[k])?)?;
+        along = along.add(r[k].mul(u[k])?)?;
+    }
+    let g = [
+        r[0].sub(along.mul(u[0])?)?.mul(2.)?,
+        r[1].sub(along.mul(u[1])?)?.mul(2.)?,
+        r[2].sub(along.mul(u[2])?)?.mul(2.)?,
+    ];
+    Some((value.sub(square(I::point(radius))?)?, g))
+}
+
+fn inverse_bound(j: [[I; 2]; 2]) -> Option<[[f64; 2]; 2]> {
+    let m = [
+        [midpoint(j[0][0])?, midpoint(j[0][1])?],
+        [midpoint(j[1][0])?, midpoint(j[1][1])?],
+    ];
+    let det = m[0][0] * m[1][1] - m[0][1] * m[1][0];
+    if !det.is_finite() || det == 0. {
+        return None;
+    }
+    let c = [
+        [m[1][1] / det, -m[0][1] / det],
+        [-m[1][0] / det, m[0][0] / det],
+    ];
+    for row in 0..2 {
+        let mut norm = I::point(0.);
+        for col in 0..2 {
+            let h = I::point(if row == col { 1. } else { 0. })
+                .sub(j[0][col].mul(c[row][0])?.add(j[1][col].mul(c[row][1])?)?)?;
+            norm = norm.add(I::point(abs_max(h)))?;
+        }
+        if norm.hi >= 1. {
+            return None;
+        }
+    }
+    Some(c)
+}
+
+pub(crate) struct Certificate {
+    p: TwistedSideParams,
+    cylinder: ([f64; 3], [f64; 3], f64),
+    lo: [f64; 3],
+    hi: [f64; 3],
+    jacobian: [[I; 3]; 2],
+}
+impl Certificate {
+    fn face_matrix(&self, axis: usize) -> [[I; 2]; 2] {
+        let axes = [(axis + 1) % 3, (axis + 2) % 3];
+        self.jacobian.map(|r| [r[axes[0]], r[axes[1]]])
+    }
+    fn unique_face(&self, axis: usize) -> bool {
+        axis < 3 && inverse_bound(self.face_matrix(axis)).is_some()
+    }
+    fn face_root_image(&self, axis: usize) -> Option<[I; 3]> {
+        if axis >= 3 || self.lo[axis] != self.hi[axis] {
+            return None;
+        }
+        let axes = [(axis + 1) % 3, (axis + 2) % 3];
+        let mut center = [0.; 3];
+        for k in 0..3 {
+            let Some(m) = midpoint(I {
+                lo: self.lo[k],
+                hi: self.hi[k],
+            }) else {
+                return None;
+            };
+            center[k] = m;
+        }
+        center[axis] = self.lo[axis];
+        let Some(c) = inverse_bound(self.face_matrix(axis)) else {
+            return None;
+        };
+        let (a, u, r) = self.cylinder;
+        let Some(f) = radial(a, u, r, center, center).zip(twisted(self.p, center, center)) else {
+            return None;
+        };
+        let values = [f.0 .0, f.1 .0];
+        let j = self.face_matrix(axis);
+        let mut image = center.map(I::point);
+        for row in 0..2 {
+            let result = (|| {
+                let mut k = I::point(center[axes[row]])
+                    .sub(values[0].mul(c[row][0])?)?
+                    .sub(values[1].mul(c[row][1])?)?;
+                for col in 0..2 {
+                    let h = I::point(if row == col { 1. } else { 0. })
+                        .sub(j[0][col].mul(c[row][0])?.add(j[1][col].mul(c[row][1])?)?)?;
+                    let delta = I {
+                        lo: self.lo[axes[col]],
+                        hi: self.hi[axes[col]],
+                    }
+                    .sub(I::point(center[axes[col]]))?;
+                    k = k.add(mul(h, delta)?)?;
+                }
+                Some(k)
+            })();
+            let k = result?;
+            if !(k.lo > self.lo[axes[row]] && k.hi < self.hi[axes[row]]) { return None; }
+            image[axes[row]] = k;
+        }
+        Some(image)
+    }
+    fn contains_face_root(&self, axis: usize) -> bool {
+        self.face_root_image(axis).is_some()
+    }
+
+}
+
+fn native_restriction<'a>(
+    a: &'a Stratum,
+    b: &'a Stratum,
+) -> Option<(TwistedSideParams, &'a Leaf, Option<(&'a Leaf, f64)>)> {
+    if a.same_primitive_field(b) && a.same_exposed_domain(b) {
+        let (p, leaf) = a.twisted_source()?;
+        return Some((p, leaf, None));
+    }
+    let (p, leaf, other, r) = a.round_twisted_source(b)?;
+    Some((p, leaf, Some((other, r))))
+}
