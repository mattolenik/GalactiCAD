+                return None;
+            }
+        }
+    }
+    for (&node, &t) in target_nodes.iter().zip(target_parameters) {
+        let p = q::pos(points, node);
+        cert.transport_generated(target, t, p, source.curve).ok()?;
+        if distance(p) > tolerance * 0.5 {
+            return None;
+        }
+    }
+    Some((source.nodes.clone(), parameters))
