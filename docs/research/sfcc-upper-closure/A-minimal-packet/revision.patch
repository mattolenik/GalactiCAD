+fn roles(f: &SfccFeatureSet) -> [usize; 3] {
+    let find = |path: Value, is_field: bool, local| {
+        f.strata
+            .iter()
+            .find(|s| {
+                let Some(d) = s.graph_capture_identity_b() else {
+                    return false;
+                };
+                s.local_index == local
+                    && if is_field {
+                        d["field"]["path"] == path
+                    } else {
+                        d["field"].is_null() && d["domain"][0]["path"] == path
+                    }
+            })
+            .unwrap()
+            .id
+    };
+    [
+        find(json!([0, 0, 0, 0, 1]), false, 3),
+        find(json!([0, 0, 0, 0]), true, 0),
+        find(json!([0, 0, 0, 1]), false, 0),
+    ]
+}
+fn initial(f: &SfccFeatureSet) -> (HelixBranch, [usize; 2]) {
+    let ids = crate::sfcc::stage4_source_preflight_c::selected_pair_c(f).unwrap();
+    let tube = f.curves[ids[0]].projection_tube(0., 1.).unwrap();
+    (HelixBranch::identify(f, ids[0], ids[1], tube).unwrap(), ids)
+}
