+//! Read-only adaptive face and consumer inventory for the second source alias.
+use super::*;
+use crate::{
+    math::grid::{
+        face_axes, pack_point, point_to_world, stride_at_level, unpack_point, SfccLattice,
+    },
+    sfcc::{
+        face_contour::FaceRecord, feature_set::SfccFeatureSet, octree::SfccOctree,
+        point_table::PointTable, shared_arc_plan::cell_faces, triangle_quality as q,
+    },
+};
+use serde_json::{json, Value};
+use std::collections::{BTreeMap, BTreeSet, HashMap};
+type FaceId = (usize, i64, i64);
+
+pub(crate) fn select(f: &SfccFeatureSet) -> Option<([usize; 3], usize, [usize; 2])> {
+    let ids = crate::sfcc::stage4_source_preflight_c::selected_pair_c(f).ok()?;
+    let branch =
+        HelixBranch::identify(f, ids[0], ids[1], f.curves[ids[0]].projection_tube(0., 1.)?)?;
+    let source = [branch.native, branch.field, branch.cylinder_id];
+    let root = f.strata[branch.native].exposure_root_a()?;
+    let (cap, _, _) = pair(root, Some((BlendKind::Smax, SminMode::Round))).ok()?;
+    let (cut, _, _) = pair(cap, None).ok()?;
+    let (hard, groove, _) = pair(cut, Some((BlendKind::Smax, SminMode::Chamfer))).ok()?;
+    let common: Vec<_> = f
+        .strata
+        .iter()
+        .filter(|s| s.connection_compound(hard, groove, cut).is_some())
+        .map(|s| s.id)
+        .collect();
+    if common.len() != 1 {
+        return None;
+    }
+    let corner = f.curves[ids[0]].corner_start;
+    let find = |sid| {
+        let found: Vec<_> = f
+            .curves
+            .iter()
+            .filter(|c| {
+                let pair = c.adjacent_strata;
+                !c.closed
+                    && c.corner_start == corner
+                    && pair.contains(&sid)
+                    && pair.contains(&common[0])
+                    && c.traced_carriers().is_some_and(|(a, b, _)| {
+                        a.connection_same_source(&f.strata[pair[0]])
+                            && b.connection_same_source(&f.strata[pair[1]])
+                    })
+            })
+            .map(|c| c.id)
+            .collect();
+        (found.len() == 1).then(|| found[0])
+    };
+    Some((
+        source,
+        common[0],
+        [find(branch.native)?, find(branch.field)?],
+    ))
+}
+
+pub(crate) fn rectangle(
+    lat: &SfccLattice,
+    axis: usize,
+    key: i64,
+    record: &FaceRecord,
+) -> Result<[[f64; 3]; 2], &'static str> {
+    if axis >= 3 || record.axis != axis || record.key != key || record.len <= 0 {
+        return Err("typed_face_identity");
+    }
+    let g = unpack_point(lat, key);
+    let axes = face_axes(axis);
+    if g.iter().any(|&x| x < 0 || x > lat.res)
+        || pack_point(lat, g[0], g[1], g[2]) != key
+        || axes
+            .iter()
+            .any(|&k| g[k].checked_add(record.len).is_none_or(|x| x > lat.res))
+    {
+        return Err("typed_face_domain");
+    }
+    let lo = point_to_world(lat, g[0], g[1], g[2]);
+    let mut hi = lo;
+    let width = record.len as f64 * lat.step;
+    if !width.is_finite() || width <= 0. {
+        return Err("typed_face_extent");
+    }
+    for k in axes {
+        hi[k] += width;
+    }
+    if !(0..3).all(|k| lo[k].is_finite() && hi[k].is_finite() && lo[k] <= hi[k]) {
+        return Err("typed_face_rectangle");
+    }
+    Ok([lo, hi])
+}
+
+fn cell_id(c: &crate::sfcc::octree::SfccCell) -> [i64; 4] {
+    [c.level as i64, c.ix, c.iy, c.iz]
+}
+fn consumers(
+    oct: &SfccOctree,
+    faces: &[HashMap<i64, FaceRecord>; 3],
+    changed: &BTreeSet<FaceId>,
+) -> Result<
+    (
+        BTreeSet<[i64; 4]>,
+        BTreeSet<FaceId>,
+        BTreeMap<FaceId, Vec<([i64; 4], usize)>>,
+    ),
+    &'static str,
+> {
+    let mut cells = BTreeSet::new();
+    let mut required = BTreeSet::new();
+    let mut users: BTreeMap<_, Vec<_>> = BTreeMap::new();
+    for c in &oct.leaves {
+        let used = cell_faces(oct, faces, c);
+        if !used.iter().any(|f| changed.contains(f)) {
+            continue;
+        }
+        cells.insert(cell_id(c));
+        required.extend(used.iter().copied());
+        let stride = stride_at_level(&oct.lat, c.level);
+        let base = [c.ix * stride, c.iy * stride, c.iz * stride];
+        for id in used {
+            let g = unpack_point(&oct.lat, id.1);
+            let side = if g[id.0] == base[id.0] {
+                0
+            } else if g[id.0] == base[id.0] + stride {
+                1
+            } else {
+                return Err("consumer_face_plane");
+            };
+            users.entry(id).or_default().push((cell_id(c), side));
+        }
+    }
+    Ok((cells, required, users))
+}
