+        || b.id != target
+        || source.nodes.first() != target_nodes.first()
+        || source.nodes.last() != target_nodes.last()
+        || source.parameters[0] != a.t_min
+        || target_parameters[0] != b.t_min
+        || source.parameters.windows(2).any(|v| v[0] >= v[1])
+        || target_parameters.windows(2).any(|v| v[0] >= v[1])
+    {
+        return None;
+    }
+    let common: Vec<_> = a
+        .adjacent_strata
+        .into_iter()
+        .filter(|s| b.adjacent_strata.contains(s))
+        .collect();
+    if common.len() != 1 {
+        return None;
+    }
+    let sa = *a.adjacent_strata.iter().find(|&&s| s != common[0])?;
+    let sb = *b.adjacent_strata.iter().find(|&&s| s != common[0])?;
+    let (native, field, charts, ranges) = if features
+        .strata
+        .get(sa)?
+        .round_twisted_source(features.strata.get(sb)?)
+        .is_some()
+    {
+        (
+            sa,
+            sb,
+            [source.curve, target],
+            [
+                [source.parameters[0], *source.parameters.last()?],
+                [target_parameters[0], *target_parameters.last()?],
+            ],
+        )
+    } else if features
+        .strata
+        .get(sb)?
+        .round_twisted_source(features.strata.get(sa)?)
+        .is_some()
+    {
+        (
+            sb,
+            sa,
+            [target, source.curve],
