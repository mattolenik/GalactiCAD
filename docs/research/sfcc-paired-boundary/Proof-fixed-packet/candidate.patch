+//! One common source-root certificate for two supplied incident patches.
+use super::fullfan_source_a;
+use crate::sfcc::feature_set::SfccFeatureSet;
+use serde_json::{json, Value};
+use std::collections::BTreeMap;
+type Point = [f64; 3];
+type Result<T> = std::result::Result<T, &'static str>;
+
+struct BoundPair {
+    triangles: Vec<[Point; 3]>,
+    ids: Vec<usize>,
+    counts: [usize; 2],
+    edge_directions: [[usize; 2]; 2],
+}
+fn bind_pair(
+    points: &BTreeMap<usize, Point>,
+    patches: [&[usize]; 2],
+    shared: [usize; 2],
+) -> Result<BoundPair> {
+    if points.is_empty() || points.len() > 4096 || points.values().flatten().any(|v| !v.is_finite()) || shared[0] == shared[1]
+        || patches.iter().any(|p| p.is_empty() || p.len() % 3 != 0)
+        || patches[0].len().checked_add(patches[1].len()).is_none_or(|n| n > 3 * 128)
+    {
+        return Err("paired_source_inventory");
+    }
+    let mut edge_directions = [[0; 2]; 2];
+    let mut triangles = Vec::with_capacity((patches[0].len() + patches[1].len()) / 3);
+    let mut ids = Vec::with_capacity(patches[0].len() + patches[1].len());
+    for (patch, input) in patches.iter().enumerate() {
+        let mut incidence = 0;
+        for t in input.chunks_exact(3) {
+            if t[0] == t[1] || t[1] == t[2] || t[2] == t[0] {
+                return Err("paired_source_repeated_triangle_vertex");
+            }
+            let get = |id: usize| -> Result<Point> {
+                let p = *points.get(&id).ok_or("paired_source_missing_point")?;
+                if p.iter().any(|v| !v.is_finite()) { return Err("paired_source_nonfinite_point"); }
+                Ok(p)
+            };
+            triangles.push([get(t[0])?, get(t[1])?, get(t[2])?]);
+            ids.extend_from_slice(t);
+            for k in 0..3 {
+                let e = [t[k], t[(k + 1) % 3]];
+                if e == shared || e == [shared[1], shared[0]] {
+                    incidence += 1;
+                    edge_directions[patch] = e;
+                }
+            }
+        }
+        if incidence != 1 { return Err("paired_source_not_single_boundary_edge"); }
+    }
+    if edge_directions[0] != [edge_directions[1][1], edge_directions[1][0]] {
+        return Err("paired_source_shared_edge_direction");
+    }
+    Ok(BoundPair { triangles, ids, counts: patches.map(|p| p.len() / 3), edge_directions })
+}
+
+/// Domain embedding and source-feature incidence are independent caller obligations.
+pub(crate) fn certify_pair(
+    features: &SfccFeatureSet,
+    cylinder_id: usize,
+    points: &BTreeMap<usize, Point>,
+    patches: [&[usize]; 2],
+    shared: [usize; 2],
+    tolerance: f64,
+) -> std::result::Result<Value, String> {
+    let pair = bind_pair(points, patches, shared).map_err(str::to_owned)?;
+    // One call retains a common slab and the existing global 128-check limit.
+    let source = fullfan_source_a::certify(features, cylinder_id, &pair.triangles, tolerance)?;
+    if source["triangleCount"].as_u64() != Some(pair.triangles.len() as u64)
+        || source["fullClosedTriangleDomainsCovered"] != true
+        || source["sharedEdgeRootsAgreeByCommonSlabUniqueness"] != true
+        || source["tolerance"].as_f64().map(f64::to_bits) != Some(tolerance.to_bits())
+    {
+        return Err("paired_source_certificate_scope".into());
+    }
+    Ok(json!({
+        "scope":"one full-source root graph over both supplied closed triangle families; projected union and source-feature correspondence require independent checks",
+        "sourceFingerprint":features.fingerprint().to_string(),
+        "cylinderSource":cylinder_id,
+        "patchTriangleCounts":pair.counts,
+        "triangleOrder":"all inside triangles, then all outside triangles",
+        "triangles":pair.ids,
+        "pointBits":points.iter().filter(|entry|pair.ids.contains(entry.0)).map(|(&id,p)|json!([id,p.map(f64::to_bits)])).collect::<Vec<_>>(),
+        "sharedEdge":shared,
+        "oppositeBoundaryDirections":pair.edge_directions,
+        "sharedPointBits":shared.map(|id|points[&id].map(f64::to_bits)),
+        "sharedRootTraceAgreementProved":true,
+        "traceArgument":"the same affine YZ edge is included in both closed domains; at every edge parameter the one common slab contains exactly one full-source root",
+        "sourceCertificate":source,
+        "projectedUnionEmbeddingProvedHere":false,
+        "sharedSourceFeatureIdentityProved":false,
+        "exactFacePlanePreservationProved":false,
+        "otherInterfacesCovered":false,
+        "publicationReady":false
+    }))
+}
+
+#[test]
+fn paired_c_source_binding_requires_one_opposite_shared_edge() {
+    let points = BTreeMap::from([
+        (0, [0., 0., 0.]), (1, [0., 1., 0.]),
+        (2, [0., 0., 1.]), (3, [0., 0., -1.]),
+        (4, [0., 0., 0.]), (5, [0., 1., 0.]),
+    ]);
+    let pair = bind_pair(&points, [&[0, 1, 2], &[1, 0, 3]], [0, 1]).unwrap();
+    assert_eq!(pair.counts, [1, 1]);
+    assert_eq!(pair.ids, [0, 1, 2, 1, 0, 3]);
+    assert_eq!(pair.edge_directions, [[0, 1], [1, 0]]);
+    assert!(bind_pair(&points, [&[0, 1, 2], &[0, 1, 3]], [0, 1]).is_err());
+    assert!(bind_pair(&points, [&[0, 1, 2], &[5, 4, 3]], [0, 1]).is_err(),
+        "equal coordinates with different IDs are not established shared provenance");
+    assert!(bind_pair(&points, [&[0, 1, 2, 1, 0, 3], &[1, 0, 3]], [0, 1]).is_err());
+    assert!(bind_pair(&points, [&[0, 1, 2], &[1, 0, 3]], [0, 0]).is_err());
+}
+
+#[test]
+fn paired_c_source_binding_rejects_invalid_and_over_cap_inputs() {
+    let mut points = BTreeMap::from([(0, [0., 0., 0.]), (1, [0., 1., 0.]), (2, [0., 0., 1.]), (3, [0., 0., -1.])]);
+    assert!(bind_pair(&points, [&[], &[1, 0, 3]], [0, 1]).is_err());
+    assert!(bind_pair(&points, [&[0, 1], &[1, 0, 3]], [0, 1]).is_err());
+    assert!(bind_pair(&points, [&[0, 1, 1], &[1, 0, 3]], [0, 1]).is_err());
+    assert!(bind_pair(&points, [&[0, 1, 9], &[1, 0, 3]], [0, 1]).is_err());
+    points.insert(2, [f64::NAN, 0., 0.]);
+    assert!(bind_pair(&points, [&[0, 1, 2], &[1, 0, 3]], [0, 1]).is_err());
+    let too_many = [0, 1, 2].repeat(128);
+    assert!(bind_pair(&points, [&too_many, &[1, 0, 3]], [0, 1]).is_err());
+}
