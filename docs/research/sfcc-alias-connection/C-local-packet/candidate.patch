+// Only this controlled replay supplies typed face preparation; production has no scope switch.
+thread_local! {static LOCAL_SHARING:std::cell::Cell<bool>=const{std::cell::Cell::new(false)};}
+pub(super) fn local_sharing_enabled() -> bool {
+    LOCAL_SHARING.with(std::cell::Cell::get)
+}
+fn with_local_sharing<T>(f: impl FnOnce() -> T) -> T {
+    struct Restore(bool);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            LOCAL_SHARING.with(|v| v.set(self.0));
+        }
+    }
+    let _restore = Restore(LOCAL_SHARING.with(|v| v.replace(true)));
+    f()
+}
