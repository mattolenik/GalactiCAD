+        return None;
+    }
+    let distance = |p: [f64; 3]| {
+        source
+            .nodes
+            .windows(2)
+            .map(|ids| {
+                let a = q::pos(points, ids[0]);
+                let d = q::sub(q::pos(points, ids[1]), a);
+                let len = q::dot(d, d);
