+/// Reserve the connected owned Clone graph together with the actual caller's
+/// staging amount, recording the exact structural ledger before any refusal.
+pub(crate) fn reserve_source_view(f:&SfccFeatureSet,already:usize)->Result<(), &'static str>{
+    super::private_storage_observation::prepare_source();
+    let report=super::source_storage_a::inspect(f,already,"actual caller staged_bytes; not inferred from face count");
+    let allowed=report.allowed;
+    super::private_storage_observation::record_source(report);
+    if allowed{Ok(())}else{Err("64MiB combined owned-source/staging reservation refused; typed ledger retained for receipt extraction")}
+}
