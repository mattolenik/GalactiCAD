+#[test]
+fn endpoint_replay_b_actual_source_and_point_keys_reproduce_exact_guard() {
+    let f = fixture();
+    let tree =
+        crate::scene_bridge::build_csg_tree_from_json(f["sceneJson"].as_str().unwrap()).unwrap();
+    let size = f["cube"]["max"][0].as_f64().unwrap() - f["cube"]["min"][0].as_f64().unwrap();
+    let tol = crate::tolerances::resolve_tolerances(
+        &crate::tuning::SfccTuning::default(),
+        (3. * size * size).sqrt(),
+    );
+    let (features, _) = crate::sfcc::feature_set::compile_feature_set(&tree, &tol);
+    assert_eq!(
+        features.fingerprint().to_string(),
+        f["fingerprint"].as_str().unwrap()
+    );
+    for expected in f["originalCharts"].as_array().unwrap() {
+        let curve = &features.curves[id(&expected["id"])];
+        assert_eq!(
+            json!([curve.corner_start, curve.corner_end]),
+            expected["cornerEnds"]
+        );
+        assert_eq!(json!(curve.adjacent_strata), expected["strata"]);
+        assert_eq!(
+            json!([bits(curve.t_min), bits(curve.t_max)]),
+            expected["rangeHex"]
+        );
+        assert_eq!(
+            json!(curve
+                .index_polyline
+                .iter()
+                .copied()
+                .map(bits)
+                .collect::<Vec<_>>()),
+            expected["polylineHex"]
+        );
+    }
+    assert!(features.corners[27].curve_ends.contains(&(20, 1)));
+    assert!(features.corners[27].curve_ends.contains(&(33, 1)));
+    let (admission, mut transport) = private_arc_a::admit(&features, [20, 33], 0.02).unwrap();
+    assert_eq!([admission.physical, admission.alias], [20, 33]);
+    let mut view = features.clone();
+    view.index.omit_private_curve(admission.alias);
+    for corner in &mut view.corners {
+        if corner
+            .curve_ends
+            .iter()
+            .any(|&(c, _)| c == admission.physical)
+        {
+            corner.curve_ends.retain(|&(c, _)| c != admission.alias);
+        }
+    }
+    assert_eq!(view.corners[27].curve_ends, vec![(20, 1)]);
+    let baseline = replay(&tree, &view, &mut transport, &f, false, false);
+    let metadata = replay(&tree, &view, &mut transport, &f, true, false);
+    assert_eq!(baseline["graph"], metadata["graph"]);
+    assert_eq!(baseline["queries"], metadata["queries"]);
+    let mismatched = replay(&tree, &view, &mut transport, &f, false, true);
+    let report = json!({"fixtureSha256":"9127f7986c675ad0868c71d23099aa6a7356f8703fb5cef7dce355d1bd37f00c","sourceReceiptSha256":f["sourceReceiptSha256"],"sourceFingerprint":f["fingerprint"],"scope":"exact replay through observed early guard only; no octree/private constructor/final surface repair",
+        "baseline":baseline,"metadataControl":metadata,"sourceIdentityControl":mismatched,
+        "exactMatches":{"sourceFingerprint":true,"originalChartBits":true,"preCallInputsAndSharing":true,"builtGraphAndNewPointBits":true,"sixCurveQueries":true,"rejectionOperands":true},"controls":{"unusedMetadataUnchanged":true,"pinChartMismatchChangesGuard":true,"duplicateKeyAndUnkeyedIdentity":"separate endpoint_replay_b_duplicate_pre_call_keys_are_rejected test"},"earlyPathReplayEstablished":true,"wholeCellOrSourceContinuationEstablished":false,"publicationReady":false});
+    let path =
+        std::env::var("SFCC_ENDPOINT_REPLAY_B_RECEIPT").expect("root-owned receipt path required");
+    std::fs::write(path, serde_json::to_vec_pretty(&report).unwrap()).unwrap();
+}
