+//! Actual boundary-plane discriminator; a source graph is not an exact cell-interface certificate.
+use crate::math::grid::{cell_aabb, pack_point, point_to_world, stride_at_level, unpack_point, SfccLattice};
+use crate::sdf::enclosure::Interval as I;
+use crate::sfcc::pipeline::{build_pipeline_context, PipelineTuning, SfccWorldCube};
+use crate::sfcc::validation::NumericalGuard;
+use serde_json::{json, Value};
+
+fn excludes_plane(lo: f64, hi: f64, plane: f64) -> bool {
+    [lo, hi, plane].iter().all(|x| x.is_finite())
+        && lo <= hi
+        && (plane < lo || plane > hi)
+}
+fn number(v: &Value) -> f64 {
+    f64::from_bits(u64::from_str_radix(v.as_str().unwrap(), 16).unwrap())
+}
+fn abs_bounds(x: I) -> [f64; 2] {
+    [if x.lo > 0. { x.lo } else if x.hi < 0. { -x.hi } else { 0. },
+     x.lo.abs().max(x.hi.abs())]
+}
+
+fn bound_record(boundary: &Value, lat: &SfccLattice, vertices: [[f64; 3]; 2], allowance: f64) -> Option<[[f64; 3]; 2]> {
+    let face = &boundary["face"];
+    let record = &boundary["record"];
+    if face != &record["face"] || !allowance.is_finite() || allowance <= 0. { return None; }
+    let axis = face[0].as_u64()? as usize;
+    let key = face[1].as_i64()?;
+    let len = face[2].as_i64()?;
+    if axis >= 3 || len <= 0 || len > lat.res { return None; }
+    let low = unpack_point(lat, key);
+    if pack_point(lat, low[0], low[1], low[2]) != key || low.iter().any(|&v|v < 0 || v > lat.res) { return None; }
+    let mut high = low;
+    for k in 0..3 { if k != axis { high[k] = low[k].checked_add(len)?; if high[k] > lat.res { return None; } } }
+    let consumers = record["consumers"].as_array()?;
+    if consumers.len() != 2 { return None; }
+    let mut inside_side = None;
+    let mut sides = [false; 2];
+    for row in consumers {
+        let cell = &row[0];
+        let level = cell[0].as_u64()?;
+        if level > lat.max_depth as u64 { return None; }
+        let level = level as u32;
+        let side = row[1].as_u64()? as usize;
+        if level > lat.max_depth || side > 1 || sides[side] { return None; }
+        sides[side] = true;
+        let stride = stride_at_level(lat, level);
+        let mut base = [0i64; 3];
+        for k in 0..3 { let index = cell[k+1].as_i64()?; if index < 0 || index >= 1i64 << level { return None; } base[k] = index.checked_mul(stride)?; }
+        if low[axis] != base[axis] + side as i64 * stride || (0..3).any(|k|k != axis && (low[k] < base[k] || high[k] > base[k] + stride)) { return None; }
+        if row[2].as_bool()? {
+            if cell != &boundary["cell"] || inside_side.replace(side).is_some() { return None; }
+        }
+    }
+    let side = inside_side?;
+    let edge: [u64; 2] = [boundary["edge"][0].as_u64()?, boundary["edge"][1].as_u64()?];
+    let segment_matches = record["oldSegments"].as_array()?.iter().any(|segment| {
+        let a = segment[0].as_u64().and_then(|id|record["pointBindings"][id.to_string()].as_u64());
+        let b = segment[1].as_u64().and_then(|id|record["pointBindings"][id.to_string()].as_u64());
+        if side == 1 { [b, a] == edge.map(Some) } else { [a, b] == edge.map(Some) }
+    });
+    if !segment_matches { return None; }
+    let rect = [point_to_world(lat, low[0], low[1], low[2]), point_to_world(lat, high[0], high[1], high[2])];
+    for point in vertices {
+        for k in 0..3 {
+            let lower = I::point(rect[0][k]).sub(I::point(allowance))?.lo;
+            let upper = I::point(rect[1][k]).add(I::point(allowance))?.hi;
+            if !point[k].is_finite() || point[k] < lower || point[k] > upper { return None; }
+        }
+    }
+    Some(rect)
+}
