+use super::*;
+use crate::sfcc::{
+    feature_set::SfccFeatureSet,
+    pipeline::{build_pipeline_context, PipelineTuning, SfccWorldCube},
+};
+use serde_json::{json, Value};
+fn fixture() -> (CsgNode, SfccFeatureSet) {
+    let v: Value =
+        serde_json::from_str(include_str!("../../fixtures/shared-arc-full-knob.json")).unwrap();
+    let root =
+        crate::scene_bridge::build_csg_tree_from_json(v["sceneJson"].as_str().unwrap()).unwrap();
+    let cube = SfccWorldCube {
+        min_x: v["cube"]["min"][0].as_f64().unwrap(),
+        min_y: v["cube"]["min"][1].as_f64().unwrap(),
+        min_z: v["cube"]["min"][2].as_f64().unwrap(),
+        size: v["cube"]["max"][0].as_f64().unwrap() - v["cube"]["min"][0].as_f64().unwrap(),
+    };
+    let f = build_pipeline_context(&root, &cube, &PipelineTuning::default()).features;
+    (root, f)
+}
+fn roles(f: &SfccFeatureSet) -> [usize; 3] {
+    let find = |path: Value, is_field: bool, local| {
+        f.strata
+            .iter()
+            .find(|s| {
+                let Some(d) = s.graph_capture_identity_b() else {
+                    return false;
+                };
+                s.local_index == local
+                    && if is_field {
+                        d["field"]["path"] == path
+                    } else {
+                        d["field"].is_null() && d["domain"][0]["path"] == path
+                    }
+            })
+            .unwrap()
+            .id
+    };
+    [
+        find(json!([0, 0, 0, 0, 1]), false, 3),
+        find(json!([0, 0, 0, 0]), true, 0),
+        find(json!([0, 0, 0, 1]), false, 0),
+    ]
+}
+const EVENT: [f64; 3] = [-9.358961851300297, -2.492038035725069, 5.3897897051654455];
+fn midpoint(image: ([f64; 3], [f64; 3])) -> [f64; 3] {
+    std::array::from_fn(|k| image.0[k] * 0.5 + image.1[k] * 0.5)
+}
+fn hex(x: f64) -> String {
+    format!("{:016x}", x.to_bits())
+}
+#[test]
+fn lower_a_full_scalar_interval_and_local_four_ray_star() {
+    let (root, f) = fixture();
+    let source = roles(&f);
+    let cert = bind(&root, &f.strata, source, EVENT, 1e-7, 0.01).expect("lower source interval");
+    let image = cert.image(interval(-cert.depth, 0.).unwrap()).unwrap();
+    let mut samples = Vec::new();
+    for a in [-0.01, -0.0075, -0.005, -0.0025, 0.] {
+        let bounds = cert.image_bounds(a, a).unwrap();
+        let p = midpoint(bounds);
+        let fields = cert.lifted_pair.map(|id| f.strata[id].f(p[0], p[1], p[2]));
+        assert!(
+            root.f(p).abs() < 1e-10,
+            "actual full scalar at a={a}: {}",
+            root.f(p)
+        );
+        assert!(
+            fields.iter().all(|v| v.abs() < 1e-10),
+            "actual lifted scalar at a={a}: {fields:?}"
+        );
+        samples.push(json!({"aHex":hex(a),"pointHex":p.map(hex),"imageHex":[bounds.0.map(hex),bounds.1.map(hex)],
+            "fullScalarHex":hex(root.f(p)),"liftedScalarsHex":fields.map(hex)}));
+    }
+    let matches: Vec<_> = f
+        .curves
+        .iter()
+        .filter(|c| cert.curve_source_matches(&f.strata, c))
+        .map(|c| c.id)
+        .collect();
+    assert!(
+        !matches.is_empty(),
+        "actual embedded lifted source pair exists"
+    );
+    let points: Vec<_> = [-0.01, -0.005, 0.]
+        .map(|a| midpoint(cert.image_bounds(a, a).unwrap()))
+        .into();
+    assert!(points.windows(2).all(|p| p[0][1] < p[1][1]));
+    let report = json!({"scope":"bounded lower ideal source interval plus existence of a local four-ray source star; no numerical trace attachment",
+        "featureFingerprint":f.fingerprint().to_string(),"sourceRoles":source,"liftedPair":cert.lifted_pair,
+        "sourceIdentities":source.map(|id|f.strata[id].graph_capture_identity_b()),
+        "liftedIdentities":cert.lifted_pair.map(|id|f.strata[id].graph_capture_identity_b()),"matchingCurves":matches,
+        "grooveEdge":cert.groove_edge,"aRangeHex":[hex(-cert.depth),hex(0.)],
+        "imageHex":[image.xyz.map(|v|hex(v.lo)),image.xyz.map(|v|hex(v.hi))],"marginsLowerHex":cert.margins.map(hex),
+        "marginOrder":["profile nearest edge","native cap","cylinder cap","groove projection interval","other groove edges","inner round competitor","cap cutter","outer sphere"],
+        "heightDerivativeAbsoluteLowerHex":hex(cert.height_derivative_lower),"coordinateJacobianAbsoluteLowerHex":hex(cert.coordinate_jacobian_lower),
+        "samples":samples,"localSourceFormula":"max(E,C,w*(E+g),w*(C+g)); g=G+r; w=represented FRAC_1_SQRT_2",
+        "localPhysicalRayCount":4,"explicitNeighbourhoodRadiusProved":false,"numericalTraceConnectionProved":false,
+        "floatingQueryTotalityProved":false,"wholeComponentAccepted":false});
+    std::fs::write(
+        std::env::var("SFCC_LOWER_A_RECEIPT").expect("root receipt required"),
+        serde_json::to_vec_pretty(&report).unwrap(),
+    )
+    .unwrap();
+}
+#[test]
+fn lower_a_refuses_bad_source_interval_and_embedded_carrier() {
+    let (root, f) = fixture();
+    let source = roles(&f);
+    let cert = bind(&root, &f.strata, source, EVENT, 1e-7, 0.01).unwrap();
+    for depth in [0., -0.01, 0.251, f64::NAN, f64::INFINITY] {
+        assert!(bind(&root, &f.strata, source, EVENT, 1e-7, depth).is_none());
+    }
+    assert!(cert.image_bounds(-0.011, 0.).is_none());
+    assert!(cert.image_bounds(0., 0.001).is_none());
+    assert!(cert.image_bounds(0., -0.001).is_none());
+    assert!(cert.image_bounds(f64::NAN, 0.).is_none());
+    let mut wrong = root.clone();
+    let CsgNode::Blend { r, .. } = &mut wrong else {
+        panic!()
+    };
+    *r += 0.001;
+    assert!(bind(&wrong, &f.strata, source, EVENT, 1e-7, 0.01).is_none());
+    let mut wrong_point = EVENT;
+    wrong_point[1] += 0.01;
+    assert!(bind(&root, &f.strata, source, wrong_point, 1e-7, 0.01).is_none());
+    let mut wrong_roles = source;
+    wrong_roles.swap(0, 2);
+    assert!(bind(&root, &f.strata, wrong_roles, EVENT, 1e-7, 0.01).is_none());
+    let curve = f
+        .curves
+        .iter()
+        .find(|c| cert.curve_source_matches(&f.strata, c))
+        .unwrap();
+    let mut wrong_curve = curve.clone();
+    wrong_curve.adjacent_strata.swap(0, 1);
+    assert!(!cert.curve_source_matches(&f.strata, &wrong_curve));
+    let (_, foreign) = fixture();
+    assert!(
+        !cert.curve_source_matches(&foreign.strata, curve),
+        "separate source handles cannot authorize embedded carriers"
+    );
+    let foreign_curve = foreign
+        .curves
+        .iter()
+        .find(|c| c.adjacent_strata == cert.lifted_pair)
+        .unwrap();
+    assert!(
+        !cert.curve_source_matches(&foreign.strata, foreign_curve),
+        "coherent foreign registry and embedded carriers cannot borrow old certificate"
+    );
+    let mut altered = f.strata.clone();
+    altered[cert.lifted_pair[0]] = foreign.strata[cert.lifted_pair[0]].clone();
+    altered[cert.lifted_pair[1]] = foreign.strata[cert.lifted_pair[1]].clone();
+    assert!(
+        !cert.curve_source_matches(&altered, foreign_curve),
+        "matching native root cannot authorize foreign lifted embedded descriptors"
+    );
+    let mut bad = cert.clone();
+    bad.edge[2] = bad.edge[0];
+    assert!(
+        bad.image_bounds(-0.01, 0.).is_none(),
+        "vertical groove edge cannot parameterize y"
+    );
+    let mut bad = cert.clone();
+    bad.depth = bad.radius;
+    assert!(
+        bad.image_bounds(-bad.depth, 0.).is_none(),
+        "offset must stay strictly outside groove"
+    );
+}
