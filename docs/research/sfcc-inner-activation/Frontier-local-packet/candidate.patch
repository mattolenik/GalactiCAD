+fn activation_c_actual_event_parameters_and_frontier_branch_associations() {
+    let (root, f, captured, brackets, box_, eps) = fixture();
+    let cert = source_certificate(&root, &f);
+    let mut ledger = budget(&f);
+    let charged_before = ledger.charged_queries();
+    let mut trace = vec![];
+    let result = prepare(&f, &cert, brackets, box_, eps, &mut ledger, &mut trace);
+    if let Err(ref failure) = result {
+        write(
+            "activation-C-association.json",
+            &json!({"scope":"failed bounded parameter preparation; no mutation","failure":format!("{failure:?}"),"queries":trace,"brackets":brackets,"chargedBefore":charged_before,"chargedAfter":ledger.charged_queries()}),
+        );
+    }
+    let event = result.expect("source activation must associate to both original chart queries");
+    write(
+        "activation-C-association.json",
+        &json!({"scope":"event preparation completed; later source-branch checks pending", "event":event.report(), "queries":trace, "chargedBefore":charged_before, "chargedAfter":ledger.charged_queries(), "branchChecksComplete":false}),
+    );
+    assert!(event.bound_to(&f));
+    for i in 0..2 {
+        assert!(event.parameters[i] > brackets[i][0] && event.parameters[i] < brackets[i][1]);
+    }
+    assert!(captured["allNativePinParameterBits"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .all(|v| f64::from_bits(v.as_u64().unwrap()) < event.parameters[0]));
+    let minimum_margin = (0..3)
+        .map(|k| (event.point[k] - box_[k]).min(box_[k + 3] - event.point[k]))
+        .fold(f64::INFINITY, f64::min);
+    assert!(minimum_margin > eps);
+    let mut count = 0;
+    let tail = query(
+        &f,
+        cert.charts[0],
+        f.curves[cert.charts[0]].t_max,
+        event.tubes[0],
+        &mut ledger,
+        &mut count,
+        &mut trace,
+    )
+    .unwrap();
+    let registered = f.strata[cert.source[0]].exposure_root_a().unwrap();
+    let (cap, _, _) = pair(registered, Some((BlendKind::Smax, SminMode::Round))).unwrap();
+    let (cut, _, _) = pair(cap, None).unwrap();
+    let (hard, _, _) = pair(cut, Some((BlendKind::Smax, SminMode::Chamfer))).unwrap();
+    let (inner, _, _) = pair(hard, None).unwrap();
+    let (other, _, inner_r) = pair(inner, Some((BlendKind::Smin, SminMode::Round))).unwrap();
+    let other = leaf(other, 1.).unwrap();
+    let rho = sqrt(
+        square(I::point(tail[0]).sub(I::point(other.pos[0])).unwrap())
+            .unwrap()
+            .add(square(I::point(tail[2]).sub(I::point(other.pos[2])).unwrap()).unwrap())
+            .unwrap(),
+    )
+    .unwrap();
+    let other_branch = activation_a::meridian_bound(other, rho, I::point(tail[1])).unwrap();
+    let deficit = I::point(inner_r).sub(other_branch.distance).unwrap();
+    assert!(deficit.lo > 0. && deficit.hi < cert.outgoing_depth);
+    let z = deficit.lo * 0.5 + deficit.hi * 0.5;
+    let ghost_distances = [false, true]
+        .map(|generated| distance(tail, cert.ghost_image(z, z, generated).unwrap()).unwrap());
+    assert!(ghost_distances.iter().all(|&d| d <= eps));
+    let outgoing = query(
+        &f,
+        cert.charts[1],
+        brackets[1][1],
+        event.tubes[1],
+        &mut ledger,
+        &mut count,
+        &mut trace,
+    )
+    .unwrap();
+    let cylinder = f.strata[cert.source[2]].certificate_cylinder().unwrap();
+    let radial = (outgoing[0] - cylinder.0[0]).hypot(outgoing[2] - cylinder.0[2]);
+    let outgoing_rows: Vec<_> = [false, true]
+        .into_iter()
+        .map(|generated| {
+            let a = cert.activation_radial(generated);
+            let delta = (a[0] * 0.5 + a[1] * 0.5) - radial;
+            assert!(delta > 0. && delta <= cert.outgoing_depth);
+            let d = distance(
+                outgoing,
+                cert.outgoing_image(delta, delta, generated).unwrap(),
+            )
+            .unwrap();
+            assert!(d <= eps);
+            json!({"generated":generated,"radialDrop":delta,"associationUpper":d})
+        })
+        .collect();
+    let report = json!({"scope":"source event and two old numerical cut parameters, plus original endpoint/frontier associations; no graph/face mutation or whole-raw-tail proof",
+        "sourceReceiptSha256":captured["receiptSha256"],"event":event.report(),"minimumCellMargin":minimum_margin,
+        "allCapturedNativeFacePinsBeforeCut":true,"nativeDeclaredEnd":f.curves[cert.charts[0]].t_max,
+        "nativeEndQueryBits":tail.map(f64::to_bits),"nativeEndOtherDeficitBounds":[deficit.lo,deficit.hi],"nativeEndGhostAssociationUpper":ghost_distances,
+        "physicalFrontierQueryBits":outgoing.map(f64::to_bits),"physicalFrontier":outgoing_rows,
+        "queries":trace,"chargedBefore":charged_before,"chargedAfter":ledger.charged_queries(),"fullRawTailContinuityProved":false,"wholeTransactionPrepared":false});
+    write("activation-C-association.json", &report);
+}
