+#[test]
+fn junction_b_local_source_equivalence_is_bound_to_actual_occurrences() {
+    use crate::sfcc::shared_twisted_proof::attachment_zero_locus_b;
+    let fixture: Value =
+        serde_json::from_str(include_str!("../../fixtures/shared-arc-full-knob.json")).unwrap();
+    let root = build_csg_tree_from_json(fixture["sceneJson"].as_str().unwrap()).unwrap();
+    let size =
+        fixture["cube"]["max"][0].as_f64().unwrap() - fixture["cube"]["min"][0].as_f64().unwrap();
+    let tol = resolve_tolerances(&SfccTuning::default(), 3_f64.sqrt() * size);
+    let (f, _) = compile_feature_set(&root, &tol);
+    let report = attachment_alias_audit(&f, &tol);
+    let path = std::env::var("SFCC_JUNCTION_B_RECEIPT").expect("root receipt required");
+    std::fs::write(path, serde_json::to_vec_pretty(&report).unwrap()).unwrap();
+    let rows = report["rows"].as_array().unwrap();
+    assert!(
+        !rows.is_empty(),
+        "the actual source-pair endpoint must be observed"
+    );
+    assert!(rows.iter().any(|r|r["zeroLocusEquivalent"]==true && !r["retainedAliases"].as_array().unwrap().is_empty()),
+        "at least one actual native/alias attachment box must carry the positive zero-locus premise");
+    let [native, field, cylinder] = source_ids(&f);
+    for r in rows.iter().filter(|r| r["zeroLocusEquivalent"] == true) {
+        let decode = |side: usize| {
+            std::array::from_fn(|k| {
+                f64::from_bits(
+                    u64::from_str_radix(r["boxHex"][side][k].as_str().unwrap(), 16).unwrap(),
+                )
+            })
+        };
+        let (lo, hi) = (decode(0), decode(1));
+        assert!(attachment_zero_locus_b(&f.strata[cylinder], &f.strata[field], lo, hi).is_err());
+        let mut wrong = f.strata[native].clone();
+        wrong.sign = -wrong.sign;
+        assert!(attachment_zero_locus_b(&wrong, &f.strata[field], lo, hi).is_err());
+        assert!(
+            attachment_zero_locus_b(&f.strata[native], &f.strata[field], [-32.; 3], [32.; 3])
+                .is_err()
+        );
+        assert!(attachment_zero_locus_b(&f.strata[native], &f.strata[field], hi, lo).is_err());
+    }
+    // A separately compiled equal tree is a different immutable source occurrence.
+    let (other, _) = compile_feature_set(&root, &tol);
+    let row = rows
+        .iter()
+        .find(|r| r["zeroLocusEquivalent"] == true)
+        .unwrap();
+    let decode = |side: usize| {
+        std::array::from_fn(|k| {
+            f64::from_bits(
+                u64::from_str_radix(row["boxHex"][side][k].as_str().unwrap(), 16).unwrap(),
+            )
+        })
+    };
+    assert!(attachment_zero_locus_b(
+        &f.strata[native],
+        &other.strata[field],
+        decode(0),
+        decode(1)
+    )
+    .is_err());
+}
