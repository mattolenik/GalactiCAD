+    let view = build_tree(&root, build_leaf_strata);
+    let t = tol();
+    let x = face(&view, [1., 0., 0.], [1., 1., 0.]);
+    let y = face(&view, [0., 1., 0.], [1., 1., 0.]);
+    assert_eq!(
+        flank_survives(
+            &view,
+            &view.strata[x],
+            &view.strata[y],
+            1.,
+            1.,
+            0.,
+            0.,
+            -1.,
+            0.,
+            &t,
+            0.1,
+            0
+        ),
+        Err(())
+    );
+    assert_eq!(
+        flank_survives(
+            &view,
+            &view.strata[x],
+            &view.strata[y],
+            1.,
+            1.,
+            0.,
+            0.,
+            -1.,
+            0.,
+            &t,
