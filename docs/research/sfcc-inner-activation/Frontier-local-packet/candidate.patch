+        data["origin"][1].as_f64().unwrap(),
+        data["origin"][2].as_f64().unwrap(),
+        data["size"].as_f64().unwrap(),
+    );
+    assert_eq!(lat.step.to_bits(), data["step"].as_f64().unwrap().to_bits());
+    assert_eq!(lat.res, data["res"].as_i64().unwrap());
+    let ctx = &capture["probe"]["graphEvidence"]["graphCaptureB"]["context"];
+    let id = &ctx["cell"];
