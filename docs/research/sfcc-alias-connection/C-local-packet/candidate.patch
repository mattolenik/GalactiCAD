+        || source.nodes.len() != source.parameters.len()
+        || target_nodes.len() != target_parameters.len()
+        || source.nodes.len() < 2
+        || target_nodes.len() < 2
+        || source.nodes.len() > 129
+        || target_nodes.len() > 129
+        || source
+            .nodes
+            .iter()
+            .chain(target_nodes)
+            .any(|&i| i >= points.count())
+    {
+        return None;
+    }
