+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::sfcc::point_table::CurveInterval;
+    fn points() -> PointTable {
+        let mut p=PointTable::new();
+        for i in 0..6 {p.add(i as f64,0.,0.,0.,1.,0.);}
+        p
+    }
+    fn span(p:&mut PointTable,a:usize,b:usize,chart:usize,start:f64,end:f64) {
+        p.protect_curve_edge(a,b,CurveInterval{curve_id:chart,start,end});
+    }
+    fn fixture() -> (PointTable, Vec<usize>, [Vec<Node>;2]) {
+        let mut p=points();
+        span(&mut p,0,1,46,1.,2.);span(&mut p,0,1,66,3.,4.);span(&mut p,1,2,66,4.,5.);
+        (p,vec![0,1,3,1,2,3],[vec![(1.,0)],vec![(3.,0),(5.,2)]])
+    }
+    #[test]
+    fn component_c_exact_activation_coverage_and_dual_incoming() {
+        let (p,t,w)=fixture();
+        let r=validate_consumer(&p,&t,[46,66],[2.,4.],&w,true,[1.,0.,0.]).unwrap();
+        assert_eq!(r["eventPointId"],1);assert_eq!(r["exactWindowCoverage"],true);
+        let w=[vec![(1.,0),(2.,1)],vec![(3.,0),(4.,1)]];
+        assert!(validate_consumer(&p,&[0,1,3],[46,66],[2.,4.],&w,false,[1.,0.,0.]).is_ok());
+    }
+    #[test]
+    fn component_c_refuses_missing_dual_membership_and_native_tail() {
+        let (mut p,t,w)=fixture();
+        span(&mut p,1,2,46,2.,2.5);
+        assert!(validate_consumer(&p,&t,[46,66],[2.,4.],&w,true,[1.,0.,0.]).is_err());
+        let mut p=points();span(&mut p,0,1,46,1.,2.);span(&mut p,0,4,66,3.,3.5);span(&mut p,4,1,66,3.5,4.);span(&mut p,1,2,66,4.,5.);
+        assert_eq!(validate_consumer(&p,&[0,4,3,4,1,3,0,1,3,1,2,3],[46,66],[2.,4.],&w,true,[1.,0.,0.]),Err("secondary_incoming_dual_membership_or_outgoing_native_tail"));
+    }
+    #[test]
+    fn component_c_refuses_disconnected_equal_parameter_and_gaps() {
+        let mut spans=[((1.,0),(2.,1)),((2.,4),(3.,2))];
+        assert_eq!(path(&mut spans,[(1.,0),(3.,2)]),Err("secondary_interval_gap_overlap_or_disconnected_vertex"));
+        let mut spans=[((1.,0),(2.,1)),((2.1,1),(3.,2))];
+        assert!(path(&mut spans,[(1.,0),(3.,2)]).is_err());
+        let mut spans=[((1.,0),(2.,1)),((1.9,1),(3.,2))];
+        assert!(path(&mut spans,[(1.,0),(3.,2)]).is_err());
+    }
+    #[test]
+    fn component_c_refuses_event_relabel_and_duplicate_membership() {
+        let (mut p,t,w)=fixture();
+        assert_eq!(validate_consumer(&p,&t,[46,66],[2.,4.],&w,true,[1.1,0.,0.]),Err("secondary_activation_point_bits"));
+        span(&mut p,0,1,46,1.,1.9);
+        assert_eq!(validate_consumer(&p,&t,[46,66],[2.,4.],&w,true,[1.,0.,0.]),Err("secondary_multiple_chart_memberships"));
+    }
+    #[test]
+    fn component_c_whole_mesh_rejects_cross_cell_contacts_and_export_collapse() {
+        let mut p=PointTable::new();
+        for v in [[0.,0.,0.],[2.,0.,0.],[0.,2.,0.],[0.5,0.5,-1.],[0.5,0.5,1.],[1.,1.,0.]] {
+            p.add(v[0],v[1],v[2],0.,0.,1.);
+        }
+        assert_eq!(validate_mesh(&p,&[0,1,2,3,4,5]),Err("secondary_component_f64_contact"));
+        assert!(validate_mesh(&p,&[0,1,2]).is_ok());
+        let mut p=PointTable::new();
+        for v in [[100_000_000.,0.,0.],[100_000_001.,0.,0.],[100_000_000.,1.,0.]] {
+            p.add(v[0],v[1],v[2],0.,0.,1.);
+        }
+        assert_eq!(validate_mesh(&p,&[0,1,2]),Err("secondary_component_degenerate_or_export_flip"));
+    }
