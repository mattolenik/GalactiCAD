+fn checks(p:TwistedSideParams,leaf:&Leaf,other:&Leaf,r:f64,lo:[f64;3],hi:[f64;3])->Value{
+    let t=twisted(p,lo,hi);
+    json!({"lo":lo,"hi":hi,"twistSupported":t.is_some(),
+        "untwisted":t.map(|x|x.3.map(iv)),
+        "profileRestriction":t.is_some_and(|x|profile_branch(p,leaf,x.3).is_some()),
+        "competitorLower":lathe_lower(other,lo,hi),"roundRadius":r,
+        "inactiveCompetitor":inactive_competitor(other,r,lo,hi)})
+}
+fn restriction_trace(p:TwistedSideParams,leaf:&Leaf,other:&Leaf,r:f64,lo:[f64;3],hi:[f64;3])->Value{
+    let mut pending=vec![(lo,hi,0usize)];let mut records=Vec::new();let mut result="passed";
+    while let Some((lo,hi,depth))=pending.pop(){
+        assert!(records.len()<127,"unchanged depth6 traversal bound");
+        let check=checks(p,leaf,other,r,lo,hi);let supported=check["twistSupported"]==true;
+        let pass=check["profileRestriction"]==true&&check["inactiveCompetitor"]==true;
+        records.push(json!({"depth":depth,"checks":check}));
+        if !supported{result="twist_or_cap_domain_unsupported";break;}
+        if pass{continue;}
+        if depth==6{result="source_restriction_unproved_at_existing_depth";break;}
+        let axis=(0..3).max_by(|&a,&b|(hi[a]-lo[a]).total_cmp(&(hi[b]-lo[b]))).unwrap();
+        let mid=midpoint(interval(lo[axis],hi[axis]).unwrap()).unwrap();
+        if mid<=lo[axis]||mid>=hi[axis]{result="unsplittable";break;}
+        let mut left=hi;left[axis]=mid;let mut right=lo;right[axis]=mid;
+        pending.push((right,hi,depth+1));pending.push((lo,left,depth+1));
+    }
+    let original=source_restrictions(p,leaf,Some((other,r)),lo,hi);
+    assert_eq!(original.is_some(),result=="passed","observer must reproduce existing source-restriction outcome");
+    json!({"result":result,"visited":records.len(),"originalVisitedOnSuccess":original,"records":records})
+}
