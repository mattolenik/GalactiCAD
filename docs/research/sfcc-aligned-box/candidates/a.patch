diff --git a/gcad-wasm/kernel/src/sfcc/box_arrangement.rs b/gcad-wasm/kernel/src/sfcc/box_arrangement.rs
new file mode 100644
--- /dev/null
+++ b/gcad-wasm/kernel/src/sfcc/box_arrangement.rs
@@ -0,0 +1,1238 @@
+//! Complete bounded rectilinear zero-set construction on represented leaf domains.
+//! Sign algebra is applied to every open stratum, including zero-volume strata.
+//! This module does not evaluate the scene SDF or rely on a supplied triangle list.
+use super::octree::SfccCell;
+use super::predicates::exact_sum_sign;
+use crate::math::grid::{
+    cell_aabb, cell_key, face_axes, point_to_world, stride_at_level, SfccLattice,
+};
+use crate::sdf::{CsgNode, Shape};
+use std::collections::{BTreeMap, BTreeSet};
+
+type GridPoint = [usize; 3];
+
+/// Explicit supported-domain or finite-budget failure.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ArrangementError {
+    OutsideScope,
+    Arithmetic,
+    CoordinateBudget,
+    StratumBudget,
+    WorkBudget,
+    NonFiniteSolid,
+    SingularZeroStratum,
+    NonManifold,
+    MissingCell,
+    OverlappingCells,
+    GridContact,
+    Float32Collapse,
+    Cancelled,
+}
+
+/// Fixed budgets checked before Cartesian allocation or classification.
+#[derive(Clone, Copy, Debug)]
+pub struct ArrangementBudget {
+    pub coordinates_per_axis: usize,
+    pub strata: usize,
+    pub sign_work: usize,
+    pub leaf_visits: usize,
+}
+impl Default for ArrangementBudget {
+    fn default() -> Self {
+        Self {
+            coordinates_per_axis: 128,
+            strata: 2_000_000,
+            sign_work: 32_000_000,
+            leaf_visits: 8_000_000,
+        }
+    }
+}
+
+/// Every original leaf occurrence remains distinct even with duplicate geometry.
+#[derive(Clone, Debug)]
+pub struct BoxOccurrence {
+    pub path: Vec<usize>,
+    pub sign: i8,
+    pub bounds: [[f64; 2]; 3],
+    ranges: [[usize; 2]; 3],
+}
+#[derive(Clone, Debug)]
+enum Expr {
+    Leaf(usize),
+    Min(Vec<Expr>),
+    Max(Vec<Expr>),
+}
+impl Expr {
+    fn sign(&self, at: [isize; 3], boxes: &[BoxOccurrence]) -> i8 {
+        match self {
+            Self::Leaf(i) => {
+                let b = &boxes[*i];
+                let mut s = -1;
+                for a in 0..3 {
+                    let lo = 2 * b.ranges[a][0] as isize;
+                    let hi = 2 * b.ranges[a][1] as isize;
+                    s = s.max(if at[a] < lo || at[a] > hi {
+                        1
+                    } else if at[a] == lo || at[a] == hi {
+                        0
+                    } else {
+                        -1
+                    });
+                }
+                s * b.sign
+            }
+            Self::Min(children) => children.iter().map(|c| c.sign(at, boxes)).min().unwrap(),
+            Self::Max(children) => children.iter().map(|c| c.sign(at, boxes)).max().unwrap(),
+        }
+    }
+    fn active(&self, at: [isize; 3], boxes: &[BoxOccurrence], out: &mut Vec<usize>) {
+        match self {
+            Self::Leaf(i) => {
+                if self.sign(at, boxes) == 0 {
+                    out.push(*i)
+                }
+            }
+            Self::Min(ch) | Self::Max(ch) => {
+                let sign = self.sign(at, boxes);
+                for c in ch {
+                    if c.sign(at, boxes) == sign {
+                        c.active(at, boxes, out)
+                    }
+                }
+            }
+        }
+    }
+}
+
+/// One independently enumerated exposed rectangle. u/v axes use cyclic order.
+#[derive(Clone, Debug)]
+pub struct Rectangle {
+    pub axis: usize,
+    pub index: GridPoint,
+    pub outward: i8,
+    pub owner: usize,
+    pub occurrences: Vec<usize>,
+}
+impl Rectangle {
+    pub fn corners(&self) -> [GridPoint; 4] {
+        let [u, v] = face_axes(self.axis);
+        let mut p = [self.index; 4];
+        p[1][u] += 1;
+        p[2][u] += 1;
+        p[2][v] += 1;
+        p[3][v] += 1;
+        if self.outward < 0 {
+            p.swap(1, 3)
+        }
+        p
+    }
+}
+
+/// A complete arrangement. Coordinate identities are exact ordered events,
+/// not a proximity-weld key. Cell rectangles include the entire zero set there.
+#[derive(Clone, Debug)]
+pub struct Arrangement {
+    pub coordinates: [Vec<f64>; 3],
+    pub occurrences: Vec<BoxOccurrence>,
+    pub rectangles: Vec<Rectangle>,
+    pub cells: Vec<SfccCell>,
+    pub cell_rectangles: Vec<Vec<usize>>,
+    pub classified_strata: usize,
+}
+
+fn collect(
+    node: &CsgNode,
+    path: &mut Vec<usize>,
+    boxes: &mut Vec<BoxOccurrence>,
+    nodes: &mut usize,
+) -> Result<Expr, ArrangementError> {
+    *nodes = nodes.checked_add(1).ok_or(ArrangementError::WorkBudget)?;
+    if *nodes > 4096 || path.len() > 128 {
+        return Err(ArrangementError::WorkBudget);
+    }
+    match node {
+        CsgNode::Leaf(l) => {
+            let Shape::Cuboid { half } = l.shape else {
+                return Err(ArrangementError::OutsideScope);
+            };
+            if l.sim.r != [1., 0., 0., 0., 1., 0., 0., 0., 1.]
+                || l.sim.s != 1.
+                || l.sim.t != [0.; 3]
+                || ![-1., 1.].contains(&l.sign)
+            {
+                return Err(ArrangementError::OutsideScope);
+            }
+            let mut bounds = [[0.; 2]; 3];
+            for a in 0..3 {
+                if !half[a].is_finite() || half[a] <= 0. || !l.pos[a].is_finite() {
+                    return Err(ArrangementError::Arithmetic);
+                }
+                bounds[a] = [l.pos[a] - half[a], l.pos[a] + half[a]];
+                if exact_sum_sign(l.pos[a], -half[a], bounds[a][0]) != Some(0)
+                    || exact_sum_sign(l.pos[a], half[a], bounds[a][1]) != Some(0)
+                    || bounds[a][0] >= bounds[a][1]
+                {
+                    return Err(ArrangementError::Arithmetic);
+                }
+            }
+            let i = boxes.len();
+            boxes.push(BoxOccurrence {
+                path: path.clone(),
+                sign: l.sign as i8,
+                bounds,
+                ranges: [[0; 2]; 3],
+            });
+            Ok(Expr::Leaf(i))
+        }
+        CsgNode::Min(ch) | CsgNode::Max(ch) => {
+            if ch.is_empty() {
+                return Err(ArrangementError::OutsideScope);
+            }
+            let mut children = Vec::new();
+            for (i, c) in ch.iter().enumerate() {
+                path.push(i);
+                children.push(collect(c, path, boxes, nodes)?);
+                path.pop();
+            }
+            Ok(if matches!(node, CsgNode::Min(_)) {
+                Expr::Min(children)
+            } else {
+                Expr::Max(children)
+            })
+        }
+        _ => Err(ArrangementError::OutsideScope),
+    }
+}
+fn insert(out: &mut Vec<f64>, x: f64, limit: usize) -> Result<(), ArrangementError> {
+    if !x.is_finite() {
+        return Err(ArrangementError::Arithmetic);
+    }
+    let x = if x == 0. { 0. } else { x };
+    match out.binary_search_by(|v| v.total_cmp(&x)) {
+        Ok(_) => Ok(()),
+        Err(i) => {
+            if out.len() >= limit {
+                return Err(ArrangementError::CoordinateBudget);
+            }
+            out.insert(i, x);
+            Ok(())
+        }
+    }
+}
+fn product(
+    v: impl IntoIterator<Item = usize>,
+    limit: usize,
+    error: ArrangementError,
+) -> Result<usize, ArrangementError> {
+    let n = v
+        .into_iter()
+        .try_fold(1usize, |a, b| a.checked_mul(b))
+        .ok_or(error)?;
+    if n > limit {
+        Err(error)
+    } else {
+        Ok(n)
+    }
+}
+fn validate_lattice(lat: &SfccLattice) -> Result<(), ArrangementError> {
+    if lat.max_depth < 1
+        || lat.max_depth > 14
+        || lat.res != (1i64 << lat.max_depth)
+        || lat.span != lat.res + 1
+        || !lat.world_size.is_finite()
+        || lat.world_size <= 0.
+        || !lat.step.is_finite()
+        || lat.step <= 0.
+        || lat.step != lat.world_size / lat.res as f64
+        || ![lat.origin_x, lat.origin_y, lat.origin_z]
+            .iter()
+            .all(|x| x.is_finite())
+    {
+        Err(ArrangementError::Arithmetic)
+    } else {
+        Ok(())
+    }
+}
+fn extent(lat: &SfccLattice, c: &SfccCell) -> Result<[f64; 6], ArrangementError> {
+    if c.level > lat.max_depth
+        || c.ix < 0
+        || c.iy < 0
+        || c.iz < 0
+        || [c.ix, c.iy, c.iz].iter().any(|&v| v >= (1i64 << c.level))
+        || c.key != cell_key(lat, c.level, c.ix, c.iy, c.iz)
+    {
+        return Err(ArrangementError::Arithmetic);
+    }
+    let s = stride_at_level(lat, c.level);
+    let lo = point_to_world(lat, c.ix * s, c.iy * s, c.iz * s);
+    let hi = point_to_world(lat, (c.ix + 1) * s, (c.iy + 1) * s, (c.iz + 1) * s);
+    let b = cell_aabb(lat, c.level, c.ix, c.iy, c.iz);
+    if (0..3).any(|a| {
+        lo[a] != b[a]
+            || hi[a] != b[a + 3]
+            || !lo[a].is_finite()
+            || !hi[a].is_finite()
+            || lo[a] >= hi[a]
+    }) {
+        return Err(ArrangementError::Arithmetic);
+    }
+    Ok(b)
+}
+
+impl Arrangement {
+    /// Construct exact zero strata and a conforming triangulation plan for every
+    /// supplied actual leaf domain. Missing target coverage is an explicit error.
+    pub fn build(
+        tree: &CsgNode,
+        lat: &SfccLattice,
+        cells: &[SfccCell],
+        budget: ArrangementBudget,
+    ) -> Result<Self, ArrangementError> {
+        Self::build_with_cuts(tree, lat, cells, budget, &[])
+    }
+    fn build_with_cuts(
+        tree: &CsgNode,
+        lat: &SfccLattice,
+        cells: &[SfccCell],
+        budget: ArrangementBudget,
+        cuts: &[[f64; 3]],
+    ) -> Result<Self, ArrangementError> {
+        validate_lattice(lat)?;
+        if cells.len() > 65_536 {
+            return Err(ArrangementError::WorkBudget);
+        }
+        let mut boxes = Vec::new();
+        let mut nodes = 0;
+        let expr = collect(tree, &mut Vec::new(), &mut boxes, &mut nodes)?;
+        if boxes.is_empty() {
+            return Err(ArrangementError::OutsideScope);
+        }
+        if expr.sign([-1; 3], &boxes) < 0 {
+            return Err(ArrangementError::NonFiniteSolid);
+        }
+        let mut coordinates: [Vec<f64>; 3] = Default::default();
+        for b in &boxes {
+            for a in 0..3 {
+                for x in b.bounds[a] {
+                    insert(&mut coordinates[a], x, budget.coordinates_per_axis)?
+                }
+            }
+        }
+        let primitive_planes = coordinates.clone();
+        let bounds = std::array::from_fn::<_, 3, _>(|a| {
+            [coordinates[a][0], *coordinates[a].last().unwrap()]
+        });
+        for p in cuts {
+            for a in 0..3 {
+                if p[a] > bounds[a][0] && p[a] < bounds[a][1] {
+                    insert(&mut coordinates[a], p[a], budget.coordinates_per_axis)?
+                }
+            }
+        }
+        let mut cell_bounds = Vec::with_capacity(cells.len());
+        for cell in cells {
+            let b = extent(lat, cell)?;
+            if (0..3).any(|a| {
+                primitive_planes[a]
+                    .iter()
+                    .any(|&x| x == b[a] || x == b[a + 3])
+            }) {
+                return Err(ArrangementError::GridContact);
+            }
+            for a in 0..3 {
+                for x in [b[a], b[a + 3]] {
+                    if x > bounds[a][0] && x < bounds[a][1] {
+                        insert(&mut coordinates[a], x, budget.coordinates_per_axis)?
+                    }
+                }
+            }
+            cell_bounds.push(b);
+        }
+        for a in 0..3 {
+            if coordinates[a].windows(2).any(|w| {
+                !((w[0] as f32).is_finite()
+                    && (w[1] as f32).is_finite()
+                    && (w[0] as f32) < (w[1] as f32))
+            }) {
+                return Err(ArrangementError::Float32Collapse);
+            }
+        }
+        for b in &mut boxes {
+            for a in 0..3 {
+                for k in 0..2 {
+                    b.ranges[a][k] = coordinates[a]
+                        .binary_search_by(|x| {
+                            x.total_cmp(&if b.bounds[a][k] == 0. {
+                                0.
+                            } else {
+                                b.bounds[a][k]
+                            })
+                        })
+                        .unwrap();
+                }
+            }
+        }
+        let shape = coordinates.each_ref().map(|c| 2 * c.len() - 1);
+        let classified_strata = product(shape, budget.strata, ArrangementError::StratumBudget)?;
+        let depth = boxes.iter().map(|b| b.path.len()).max().unwrap_or(0);
+        product(
+            [classified_strata, nodes, 2 * depth + 3],
+            budget.sign_work,
+            ArrangementError::WorkBudget,
+        )?;
+        let flat = |p: [usize; 3]| (p[0] * shape[1] + p[1]) * shape[2] + p[2];
+        let mut signs = vec![0i8; classified_strata];
+        for x in 0..shape[0] {
+            if super::cancel::is_cancelled() {
+                return Err(ArrangementError::Cancelled);
+            }
+            for y in 0..shape[1] {
+                for z in 0..shape[2] {
+                    signs[flat([x, y, z])] =
+                        expr.sign([x as isize, y as isize, z as isize], &boxes);
+                }
+            }
+        }
+        let mut rectangles = Vec::new();
+        let mut covered = BTreeSet::new();
+        for axis in 0..3 {
+            let [u, v] = face_axes(axis);
+            for plane in 0..coordinates[axis].len() {
+                for i in 0..coordinates[u].len() - 1 {
+                    for j in 0..coordinates[v].len() - 1 {
+                        let mut at = [0usize; 3];
+                        at[axis] = 2 * plane;
+                        at[u] = 2 * i + 1;
+                        at[v] = 2 * j + 1;
+                        if signs[flat(at)] != 0 {
+                            continue;
+                        }
+                        let mut before = at.map(|a| a as isize);
+                        before[axis] -= 1;
+                        let mut after = at.map(|a| a as isize);
+                        after[axis] += 1;
+                        let left = expr.sign(before, &boxes);
+                        let right = expr.sign(after, &boxes);
+                        if left * right != -1 {
+                            return Err(ArrangementError::SingularZeroStratum);
+                        }
+                        let mut index = [0usize; 3];
+                        index[axis] = plane;
+                        index[u] = i;
+                        index[v] = j;
+                        let mut occurrences = Vec::new();
+                        expr.active(at.map(|a| a as isize), &boxes, &mut occurrences);
+                        if rectangles.len() >= 16_384 {
+                            return Err(ArrangementError::WorkBudget);
+                        }
+                        rectangles.push(Rectangle {
+                            axis,
+                            index,
+                            outward: right,
+                            owner: usize::MAX,
+                            occurrences,
+                        });
+                        for du in -1isize..=1 {
+                            for dv in -1isize..=1 {
+                                let mut p = at;
+                                p[u] = (p[u] as isize + du) as usize;
+                                p[v] = (p[v] as isize + dv) as usize;
+                                covered.insert(flat(p));
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        for (i, &s) in signs.iter().enumerate() {
+            if s == 0 && !covered.contains(&i) {
+                return Err(ArrangementError::SingularZeroStratum);
+            }
+        }
+        product(
+            [rectangles.len(), cells.len()],
+            budget.leaf_visits,
+            ArrangementError::WorkBudget,
+        )?;
+        let mut cell_rectangles = vec![Vec::new(); cells.len()];
+        for (i, r) in rectangles.iter_mut().enumerate() {
+            let [u, v] = face_axes(r.axis);
+            let plane = coordinates[r.axis][r.index[r.axis]];
+            for (ci, b) in cell_bounds.iter().enumerate() {
+                if plane < b[r.axis] || plane > b[r.axis + 3] {
+                    continue;
+                }
+                if coordinates[u][r.index[u]] < b[u]
+                    || coordinates[u][r.index[u] + 1] > b[u + 3]
+                    || coordinates[v][r.index[v]] < b[v]
+                    || coordinates[v][r.index[v] + 1] > b[v + 3]
+                {
+                    continue;
+                }
+                if plane == b[r.axis] || plane == b[r.axis + 3] {
+                    return Err(ArrangementError::GridContact);
+                }
+                if r.owner != usize::MAX {
+                    return Err(ArrangementError::OverlappingCells);
+                }
+                r.owner = ci;
+                cell_rectangles[ci].push(i);
+            }
+            if r.owner == usize::MAX {
+                return Err(ArrangementError::MissingCell);
+            }
+        }
+        let out = Self {
+            coordinates,
+            occurrences: boxes,
+            rectangles,
+            cells: cells.to_vec(),
+            cell_rectangles,
+            classified_strata,
+        };
+        let (_, tris) = out.mesh();
+        if !super::manifold_check::check_manifold(&tris, true).ok {
+            return Err(ArrangementError::NonManifold);
+        }
+        Ok(out)
+    }
+    /// Exact rectangle subdivision into two consistently oriented triangles.
+    pub fn mesh(&self) -> (Vec<[f64; 3]>, Vec<u32>) {
+        let mut ids = BTreeMap::<GridPoint, u32>::new();
+        let mut positions = Vec::new();
+        let mut tris = Vec::new();
+        for r in &self.rectangles {
+            let p = r.corners().map(|p| {
+                *ids.entry(p).or_insert_with(|| {
+                    let id = positions.len() as u32;
+                    positions.push(std::array::from_fn(|a| self.coordinates[a][p[a]]));
+                    id
+                })
+            });
+            tris.extend([p[0], p[1], p[2], p[0], p[2], p[3]]);
+        }
+        (positions, tris)
+    }
+}
