+pub(super) fn insert_activation(
+    paths: &mut BTreeMap<usize, Vec<(f64, usize)>>,
+    box_: &[f64; 6],
+    points: &mut PointTable,
+    features: &SfccFeatureSet,
+) -> bool {
+    let Some(plan) = plan() else {
+        return false;
+    };
+    let Some(cert) = source(&plan, features) else {
+        return false;
+    };
+    if box_.map(f64::to_bits) != plan.cell_box.map(f64::to_bits)
+        || points.count() >= 4096
+        || crate::sfcc::cancel::is_cancelled()
+    {
+        return false;
+    }
+    for image in [cert.activation_image(false), cert.activation_image(true)] {
+        let Some(image) = image else {
+            return false;
+        };
+        if !(0..3).all(|k| {
+            image.0[k] > (box_[k] + plan.epsilon).next_up()
+                && image.1[k] < (box_[k + 3] - plan.epsilon).next_down()
+        }) || !distance(plan.point, image).is_some_and(|d| d <= plan.epsilon)
+        {
+            return false;
+        }
+    }
+    let Some(native) = paths.get(&plan.charts[0]) else {
+        return false;
+    };
+    let Some(composite) = paths.get(&plan.charts[1]) else {
+        return false;
+    };
+    if native.len() != 1
+        || composite.len() != 2
+        || native
+            .iter()
+            .any(|(t, _)| !t.is_finite() || *t >= plan.cuts[0])
+        || !composite.iter().any(|(t, _)| *t < plan.cuts[1])
+        || !composite.iter().any(|(t, _)| *t > plan.cuts[1])
+    {
+        return false;
+    }
+    let mut own = [[0.; 3]; 2];
+    let mut strict = f64::INFINITY;
+    for slot in 0..2 {
+        let curve = &features.curves[plan.charts[slot]];
+        if !curve.t_min.is_finite()
+            || !curve.t_max.is_finite()
+            || curve.t_min >= curve.t_max
+            || plan.cuts[slot] <= curve.t_min
+            || plan.cuts[slot] >= curve.t_max
+        {
+            return false;
+        }
+        let Some(p) = curve.point_at_checked(plan.cuts[slot]) else {
+            return false;
+        };
+        own[slot] = p;
+        let Some((_, _, refine)) = curve.traced_carriers() else {
+            return false;
+        };
+        strict = strict.min(refine.curve_eps);
+        if !transport_a::accepts(plan.point, p, plan.epsilon) {
+            return false;
+        }
+        for generated in [false, true] {
+            if !cert
+                .activation_image(generated)
+                .and_then(|image| distance(p, image))
+                .is_some_and(|d| d <= plan.epsilon)
+            {
