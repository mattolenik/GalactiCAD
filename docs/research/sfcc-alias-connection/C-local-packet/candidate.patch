+#[cfg(test)]
+thread_local! {static BIND_STAGE:std::cell::Cell<&'static str>=const{std::cell::Cell::new("not_started")};}
+macro_rules! bind_stage {
+    ($s:expr) => {
+        #[cfg(test)]
+        BIND_STAGE.with(|v| v.set($s));
+    };
+}
+/// Source roles are validated occurrences, not a claim that equal IDs imply equal loci.
+pub(crate) fn bind<'a>(
+    root: &CsgNode,
+    f: &'a SfccFeatureSet,
+    source: [usize; 3],
+    charts: [usize; 2],
+    ranges: [[f64; 2]; 2],
+    rho_min: f64,
+    epsilon: f64,
+) -> Option<Certificate<'a>> {
+    bind_stage!("initial_registry");
+    if f.strata.len() > 256
+        || f.curves.len() > 256
+        || charts[0] == charts[1]
+        || !epsilon.is_finite()
+        || epsilon <= 0.
+    {
+        return None;
+    }
+    bind_stage!("curve_identity");
+    let cs = [f.curves.get(charts[0])?, f.curves.get(charts[1])?];
+    if cs.iter().enumerate().any(|(i, c)| {
+        c.closed
+            || c.id != charts[i]
+            || !c.t_min.is_finite()
+            || !c.t_max.is_finite()
+            || c.t_min < 0.
+            || c.t_min >= c.t_max
+            || c.adjacent_strata.iter().any(|&id| id >= f.strata.len())
+    }) || cs[0].corner_start < 0
+        || cs[0].corner_start != cs[1].corner_start
+    {
+        return None;
+    }
+    bind_stage!("ranges");
+    for i in 0..2 {
+        if !ranges[i][0].is_finite()
+            || !ranges[i][1].is_finite()
+            || ranges[i][0] != cs[i].t_min
+            || ranges[i][0] >= ranges[i][1]
+            || ranges[i][1] > cs[i].t_max
+        {
+            return None;
+        }
+    }
+    if ranges
+        .iter()
+        .map(|r| r[1].ceil() - r[0].floor())
+        .sum::<f64>()
+        > 128.
+    {
+        return None;
+    }
+    bind_stage!("corner");
+    let corner = f.corners.get(cs[0].corner_start as usize)?;
+    if corner.id != cs[0].corner_start as usize {
+        return None;
+    }
+    let point = [corner.x, corner.y, corner.z];
+    bind_stage!("source_junction");
+    let junction = junction::prove_junction(root, &f.strata, source, point, epsilon)?;
+    bind_stage!("branch");
+    let branch = branch_at(&f.strata, source[0], source[1], source[2], point)?;
+    if !rho_min.is_finite() || rho_min <= branch.p.v0z.abs() || rho_min >= branch.cylinder.2 {
+        return None;
+    }
+    bind_stage!("source_operators");
+    let registered = f.strata[source[0]].exposure_root_a()?;
+    let (cap_cut, sphere, outer_r) =
+        pair(registered, Some((BlendKind::Smax, SminMode::Round))).ok()?;
+    let (cut, cap, _) = pair(cap_cut, None).ok()?;
+    let (hard, groove_node, radius) = pair(cut, Some((BlendKind::Smax, SminMode::Chamfer))).ok()?;
+    let (inner, cylinder_node, _) = pair(hard, None).ok()?;
+    let (other_node, native_node, inner_r) =
+        pair(inner, Some((BlendKind::Smin, SminMode::Round))).ok()?;
+    let native = leaf(native_node, 1.).ok()?;
+    let other = leaf(other_node, 1.).ok()?;
+    let cylinder = leaf(cylinder_node, 1.).ok()?;
+    let groove = leaf(groove_node, -1.).ok()?;
+    if groove.pos[1] != 0. {
+        return None;
+    }
+    bind_stage!("registered_native");
+    let (params, rn, ro, rr) = f.strata[source[0]].round_twisted_source(&f.strata[source[1]])?;
+    if !std::ptr::eq(native, rn) || !std::ptr::eq(other, ro) || rr != inner_r || params != branch.p
+    {
+        return None;
+    }
+    bind_stage!("source_pairs");
+    let common = cs[0]
+        .adjacent_strata
+        .iter()
+        .copied()
+        .find(|&id| cs[1].adjacent_strata.contains(&id))?;
+    if !same_pair(cs[0].adjacent_strata, [source[0], common])
+        || !same_pair(cs[1].adjacent_strata, [source[1], common])
+    {
+        return None;
+    }
+    if f.strata[common].id != common {
+        return None;
+    }
+    bind_stage!("common_compound");
+    let (weight, offset) = f.strata[common].connection_compound(hard, groove_node, cut)?;
+    let generated_radius = quotient(I::point(offset), I::point(weight))?;
+    let generated_offset_error = generated_radius.sub(I::point(radius))?;
+    bind_stage!("embedded_and_allowance");
+    for c in cs {
+        let (a, b, refine) = c.traced_carriers()?;
+        if !refine.curve_eps.is_finite() || epsilon > 8. * refine.curve_eps {
+            return None;
+        }
+        if !a.connection_same_source(&f.strata[c.adjacent_strata[0]])
+            || !b.connection_same_source(&f.strata[c.adjacent_strata[1]])
+        {
+            return None;
+        }
+    }
+    bind_stage!("groove_profile");
+    let Shape::Lathe { edges } = &groove.shape else {
+        return None;
+    };
+    let e = edges.get(junction.groove_edge)?;
+    let orientation = crate::sfcc::predicates::orient2d(
+        [edges[0].r0, edges[0].y0],
+        [edges[1].r0, edges[1].y0],
+        [edges[2].r0, edges[2].y0],
+    );
+    let chart = connection_a::ConnectionChart {
+        p: params,
+        edge: [e.r0, e.y0, e.r1, e.y1],
+        orientation: orientation as i8,
+        radius,
+        cylinder_radius: branch.cylinder.2,
+        incoming_radius: rho_min,
+        sign: branch.sign,
+        allowance: epsilon,
+        junction: point,
+        original_range: [0., 1.],
+        raw_curve: charts[0],
+    };
+    bind_stage!("canonical_radial");
+    let radial = interval(rho_min, branch.cylinder.2)?;
+    let radius_hull = interval(
+        radius.min(generated_radius.lo),
+        radius.max(generated_radius.hi),
+    )?;
+    bind_stage!("canonical_coordinates");
+    let (height, u, ideal_hull) = coordinates(&chart, radial, radius_hull)?;
+    bind_stage!("groove_interval");
+    groove_interval(groove, junction.groove_edge, &chart, radial, radius_hull)?;
+    bind_stage!("canonical_profile");
+    let profile = upper_source_a::finite_profile_level(
+        params,
+        native,
+        [u, I::point(params.v0z)],
+        I::point(0.),
+    )?;
+    bind_stage!("canonical_native_cap");
+    let native_cap = upper_source_a::cap_margin(height, params.pos_y, params.h, I::point(0.))?;
+    let Shape::Cylinder { h, .. } = &cylinder.shape else {
+        return None;
+    };
+    bind_stage!("canonical_cylinder_cap");
+    let cylinder_cap = upper_source_a::cap_margin(
+        height,
+        cylinder.pos[1],
+        *h,
+        radial.sub(I::point(branch.cylinder.2))?,
+    )?;
+    bind_stage!("canonical_inner_round");
+    let inner_margin = I::point(lathe_lower(
+        other,
+        ideal_hull.map(|v| v.lo),
+        ideal_hull.map(|v| v.hi),
+    )?)
+    .sub(I::point(inner_r))?
+    .lo;
+    bind_stage!("canonical_cap_cut");
+    let cap = leaf(cap, -1.).ok()?;
+    let Shape::Extrude { h, .. } = &cap.shape else {
+        return None;
+    };
+    let cap_margin = I::point(cap.pos[1]).sub(I::point(*h))?.sub(height)?.lo;
+    bind_stage!("canonical_sphere");
+    let sphere = leaf(sphere, 1.).ok()?;
+    let Shape::Sphere { r } = &sphere.shape else {
+        return None;
+    };
+    let sphere_distance =
+        sqrt(square(radial)?.add(square(height.sub(I::point(sphere.pos[1]))?)?)?)?;
+    let sphere_margin = I::point(*r)
+        .sub(I::point(outer_r))?
+        .sub(sphere_distance)?
+        .lo;
+    bind_stage!("source_margin_signs");
+    if [
+        profile,
+        native_cap,
+        cylinder_cap,
+        inner_margin,
+        cap_margin,
+        sphere_margin,
+    ]
+    .iter()
+    .any(|x| !x.is_finite() || *x <= 0.)
+    {
+        return None;
+    }
+    bind_stage!("height_derivative");
+    let (nr, ny) = normal(&chart)?;
+    let slope = quotient(nr.mul(-1.)?, ny)?;
+    if slope.lo <= 0. {
+        return None;
+    }
+    bind_stage!("offset_separation");
+    let dy = absmax(quotient(generated_offset_error, ny)?);
+    let omega = div(I::point(params.twist_rad), 2. * params.h)?;
+    let separation = I::point(dy)
+        .mul(sqrt(I::point(1.).add(square(omega.mul(branch.cylinder.2)?)?)?)?.hi)?
+        .hi;
+    if separation > epsilon {
+        return None;
+    }
+    bind_stage!("raw_projection_tubes");
+    let tubes = [
+        cs[0].projection_tube(ranges[0][0], ranges[0][1])?,
+        cs[1].projection_tube(ranges[1][0], ranges[1][1])?,
+    ];
+    // Keep original query containers, but grant source authority only inside this independently proved envelope.
+    let authority_box = (
+        ideal_hull.map(|v| (v.lo - epsilon).next_down()),
+        ideal_hull.map(|v| (v.hi + epsilon).next_up()),
+    );
+    let (lo, hi) = authority_box;
+    bind_stage!("authority_twisted");
+    let (e, _, _, uv) = twisted(params, lo, hi)?;
+    if (branch.sign > 0 && uv[0].lo <= 0.) || (branch.sign < 0 && uv[0].hi >= 0.) {
+        return None;
+    }
+    bind_stage!("authority_nearest_profile");
+    let nearest = upper_source_a::finite_profile_level(params, native, uv, e)?;
+    bind_stage!("authority_cap");
+    let finite_cap =
+        upper_source_a::cap_margin(interval(lo[1], hi[1])?, params.pos_y, params.h, e)?;
+    bind_stage!("authority_inner_round");
+    let inactive = I::point(lathe_lower(other, lo, hi)?)
+        .sub(I::point(inner_r))?
+        .lo
+        .min(I::point(inner_r).sub(e)?.lo);
+    if inactive <= 0. {
+        return None;
+    }
+    let authority_alias_margins = [nearest, finite_cap, inactive];
+    bind_stage!("certificate");
+    let cert = Certificate {
+        features: f,
+        source: [source[0], source[1], source[2], common],
+        charts,
+        ranges,
+        radial: [rho_min, branch.cylinder.2],
+        allowance: epsilon,
+        chart,
+        generated_radius,
+        tubes,
+        source_margins: [
+            profile,
+            native_cap,
+            cylinder_cap,
+            inner_margin,
+            cap_margin,
+            sphere_margin,
+        ],
+        authority_box,
+        authority_alias_margins,
+        height_derivative_abs_lower: slope.lo,
+        generated_offset_error,
+        source_generated_separation_upper: separation,
+    };
+    bind_stage!("corner_association");
+    cert.associate(point).ok()?;
+    bind_stage!("accepted");
+    Some(cert)
+}
