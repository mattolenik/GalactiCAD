+#[test]
+fn lower_c_inverse_cost_distinguishes_replayed_lookups_from_new_queries() {
+    let (f, ids) = fixture();
+    let mut solver = Transport::bind(&f, ids, 0.02).unwrap();
+    let source = solver.own(ids[0], f.curves[ids[0]].t_min + 0.25).unwrap();
+    let before = solver.cost.consume_attempts;
+    let mapped = solver.map(&source, ids[1]).unwrap();
+    let first_new = solver.cost.consume_attempts - before;
+    assert!(first_new > 0 && first_new <= MAX_REQUEST);
+    let before_repeat = solver.cost_json();
+    let again = solver.map(&source, ids[1]).unwrap();
+    assert_eq!(mapped.parameter().to_bits(), again.parameter().to_bits());
+    assert_eq!(
+        mapped.point().map(f64::to_bits),
+        again.point().map(f64::to_bits)
+    );
+    assert_eq!(solver.cost.consume_attempts - before, first_new);
+    assert!(solver.cost.lookups > before_repeat["lookups"].as_u64().unwrap() as usize);
+    assert!(
+        solver.cost.inverse_iterations
+            > before_repeat["inverseIterations"].as_u64().unwrap() as usize
+    );
+    assert_eq!(solver.map_request_counts[0], 1);
+    assert_eq!(solver.map_request_counts[first_new], 1);
+    assert_eq!(
+        solver.map_request_counts.iter().sum::<usize>(),
+        solver.cost.maps
+    );
+    assert_eq!(solver.cost.failed_maps, 0);
+    let report = json!({"scope":"observation only; no cap/refund/cache policy changes", "beforeRepeat":before_repeat,"afterRepeat":solver.cost_json(),"newQueriesFirstMap":first_new,"samePointAndParameterOnRepeat":true});
+    std::fs::write(
+        std::env::var("SFCC_LOWER_C_RECEIPT").expect("root receipt path"),
+        serde_json::to_vec_pretty(&report).unwrap(),
+    )
+    .unwrap();
+}
