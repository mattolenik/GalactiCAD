// New Operators Demo 2
// Demonstrates shell, offset, elongate, twist, bend, taper, morph, and seam

// === SHELL ===
// Hollow out a sphere into a thin shell
let shellSphere = shell({ t: 0.3 }, sphere({ pos: [0, 0, 10], r: 5 }))

// Shell of a box - creates a hollow cube
let shellBox = shell({ t: 0.3 }, box({ pos: [15, 0, 10], size: [4, 4, 4] }))

// === OFFSET ===
// Offset a box to round all its edges
let roundedBox = offset({ amount: 0.5 }, box({ pos: [30, 0, 10], size: [3.5, 3.5, 3.5] }))

// Negative offset - shrink a sphere
let shrunkSphere = offset({ amount: -1 }, sphere({ pos: [45, 0, 10], r: 5 }))

// === ELONGATE ===
// Elongate a sphere along Y to make a capsule-like shape
let elongatedSphere = elongate({ h: [0, 4, 0] }, sphere({ pos: [0, 20, 10], r: 3 }))

// Elongate a box along X
let elongatedBox = elongate({ h: [5, 0, 0] }, box({ pos: [20, 20, 10], size: [2, 3, 3] }))

// === TWIST ===
// Twist a box around the Y axis
let twistedBox = twist({ rate: 0.4 }, box({ pos: [40, 20, 10], size: [3, 8, 3] }))

// === BEND ===
// Bend a tall box into an arch
let bentBox = bend({ amount: 0.1 }, box({ pos: [0, -20, 10], size: [8, 3, 3] }))

// === TAPER ===
// Taper a cylinder: wide at bottom, narrow at top
let taperedCyl = taper({ ratio: 0.3, height: 10 }, cylinder({ pos: [20, -20, 5], r: 4, h: 5 }))

// Taper a box: creates a truncated pyramid
let taperedBox = taper({ ratio: 0.5, height: 8 }, box({ pos: [35, -20, 4], size: [4, 4, 4] }))

// === MORPH ===
// Morph 25% between sphere and box (mostly sphere)
let morph25 = morph({ t: 0.25 },
    sphere({ pos: [-20, -20, 10], r: 5 }),
    box({ pos: [-20, -20, 10], size: [4, 4, 4] })
)

// Morph 75% between sphere and box (mostly box)
let morph75 = morph({ t: 0.75 },
    sphere({ pos: [-35, -20, 10], r: 5 }),
    box({ pos: [-35, -20, 10], size: [4, 4, 4] })
)

// === SEAM ===
// Weld bead at the junction of two shapes
let seamDemo = seam({ r: 0.5 },
    sphere({ pos: [-20, 0, 10], r: 4 }),
    box({ pos: [-20, 0, 10], size: [3, 3, 6] })
)

// Seam between two spheres
let seamSpheres = seam({ r: 0.4 },
    sphere({ pos: [-35, 0, 7], r: 4 }),
    sphere({ pos: [-35, 0, 13], r: 4 })
)

// === ASSEMBLY ===
return union(
    shellSphere, shellBox,
    roundedBox, shrunkSphere,
    elongatedSphere, elongatedBox,
    twistedBox,
    bentBox,
    taperedCyl, taperedBox,
    morph25, morph75,
    seamDemo, seamSpheres
)
