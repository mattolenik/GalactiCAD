+/// The certificate locates a regular helix/groove-offset intersection of the
+/// represented source. It does not prove a numerical incoming arc reaches it.
+pub(crate) fn prove_junction(
+    runtime_root: &CsgNode,
+    strata: &[Stratum],
+    source: [usize; 3],
+    point: [f64; 3],
+    epsilon: f64,
+) -> Option<Junction> {
+    if strata.len() > 256
+        || !epsilon.is_finite()
+        || epsilon <= 0.
+        || point.iter().any(|v| !v.is_finite())
+    {
+        return None;
+    }
+    let branch = branch_at(strata, source[0], source[1], source[2], point)?;
+    let root = strata.get(branch.native)?.exposure_root_a()?;
+    if !same_source(runtime_root, root, &mut 64) {
+        return None;
+    }
+    let (cap_cut, _, _) = pair(root, Some((BlendKind::Smax, SminMode::Round))).ok()?;
+    let (groove_cut, _, _) = pair(cap_cut, None).ok()?;
+    let (_, groove_node, radius) =
+        pair(groove_cut, Some((BlendKind::Smax, SminMode::Chamfer))).ok()?;
+    let groove = leaf(groove_node, -1.).ok()?;
+    if groove.pos[0] != branch.cylinder.0[0] || groove.pos[2] != branch.cylinder.0[2] {
+        return None;
+    }
+    let Shape::Lathe { edges } = &groove.shape else {
+        return None;
+    };
+    for i in 0..edges.len().min(64) {
+        let Some((height, derivative, margin)) = offset_root(groove, branch.cylinder.2, radius, i)
+        else {
+            continue;
+        };
+        let Some(cert) = BranchCertificate::bind_strata(strata, &branch, height) else {
+            continue;
+        };
+        let Ok(rank) = ancestor_support(strata, &branch, height, false) else {
+            continue;
+        };
+        let (lo, hi) = cert.image_bounds();
+        let distance = (|| {
+            let mut sum = I::point(0.);
+            for k in 0..3 {
+                sum = sum.add(square(I::point(point[k]).sub(interval(lo[k], hi[k])?)?)?)?;
+            }
+            Some(sqrt(sum)?.hi)
+        })()?;
+        if distance > epsilon {
+            continue;
+        }
+        return Some(Junction {
+            source,
+            branch_sign: branch.sign,
+            groove_edge: i,
+            height: [height.lo, height.hi],
+            image: [lo, hi],
+            association_upper: distance,
+            transverse_determinant_lower: rank,
+            axial_derivative_lower: derivative,
+            other_edge_margin: margin,
+        });
+    }
+    None
+}
