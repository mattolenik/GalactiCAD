+fn other_contour_segment(segments:&[FaceSegment],first:[usize;2],side:usize)->Result<[usize;2]> {
+    if segments.len()!=2 || first[0]==first[1] || side>1 {return Err("second_segment_inventory");}
+    let mut original=None;let mut other=None;
+    for segment in segments {
+        if segment.a==segment.b {return Err("second_segment_inventory");}
+        let oriented=if side==1 {[segment.b,segment.a]} else {[segment.a,segment.b]};
+        if oriented==first {
+            if original.replace(oriented).is_some() {return Err("second_segment_inventory");}
+        } else {
+            if other.replace(oriented).is_some() {return Err("second_segment_inventory");}
+        }
+    }
+    let edge=other.ok_or("second_segment_inventory")?;
+    if original.is_none() || !edge.contains(&first[0]) || edge.contains(&first[1]) {return Err("second_segment_shared_pin");}
+    Ok(edge)
+}
+fn require_fan_source(fan:&Value,features:&SfccFeatureSet)->Result<()> {
+    let sid=fan["hypothesisStratum"].as_u64().ok_or("second_fan_source")? as usize;
+    let source=features.strata.get(sid).and_then(|s|s.graph_capture_identity_b()).ok_or("second_fan_source")?;
+    if fan["sourceIdentity"]!=source {return Err("second_fan_source");}
+    Ok(())
+}
+fn bind_second_segment(
+    target:&PairedTarget,inside_capture:&Value,outside_capture:&Value,
+    features:&SfccFeatureSet,oct:&SfccOctree,faces:&[HashMap<i64,FaceRecord>;3],live:&PointTable,
+    candidate:&PrivateCandidate,points:&PointTable,outside_triangles:&[usize],map:&BTreeMap<usize,usize>,mapping:&[usize],
+)->Result<Value> {
+    if inside_capture["complete"]!=true || inside_capture["cell"]!=target.receipt["insideCell"]
+        || inside_capture["cellBoxBits"]!=target.candidate_fan["cellBoxBits"] {return Err("second_inside_capture_binding");}
+    let inside_id:[i64;4]=serde_json::from_value(target.receipt["insideCell"].clone()).map_err(|_|"second_inside_cell")?;
+    let inside=oct.leaves.iter().find(|c|id(c)==inside_id).ok_or("second_inside_cell")?;
+    let side=cell_side(oct,inside,target.face)?;
+    let record=faces[target.face.0].get(&target.face.1).ok_or("second_face_missing")?;
+    if (record.axis,record.key,record.len)!=target.face {return Err("second_face_identity");}
+    let global=other_contour_segment(&record.segments,target.global_edge,side)?;
+    let candidate_edge=[same_key(&candidate.points,live,global[0])?.ok_or("second_candidate_point")?,
+        same_key(&candidate.points,live,global[1])?.ok_or("second_candidate_point")?];
+    let outside_edge=[*map.get(&global[1]).ok_or("second_outside_point")?,*map.get(&global[0]).ok_or("second_outside_point")?];
+    if outside_edge.iter().any(|&p|p>=mapping.len()) || [mapping[outside_edge[0]],mapping[outside_edge[1]]]!=[candidate_edge[1],candidate_edge[0]] {
+        return Err("second_joined_point_binding");
+    }
+    let inside_fan=select_paired_fan(inside_capture,candidate_edge)?;
+    let outside_fan=select_paired_fan(outside_capture,outside_edge)?;
+    require_final_fan(&inside_fan,&candidate.triangles,&candidate.points)?;
+    require_final_fan(&outside_fan,outside_triangles,points)?;
+    require_fan_source(&inside_fan,features)?;
+    require_fan_source(&outside_fan,features)?;
+    if inside_fan["cellBoxBits"]!=inside_capture["cellBoxBits"] {return Err("second_inside_fan_box");}
+    let outside=oct.leaves.iter().find(|c|id(c)==target.outside).ok_or("second_outside_cell")?;
+    if cell_side(oct,outside,target.face)?==side || outside_fan["cellBoxBits"]!=json!(cell_aabb(&oct.lat,outside.level,outside.ix,outside.iy,outside.iz).map(f64::to_bits)) {
+        return Err("second_outside_fan_box");
+    }
+    let outside_joined=joined_fan(&outside_fan,mapping)?;
+    let memberships:Vec<_>=candidate.points.identified_edges().filter(|((a,b),_)|candidate_edge.contains(a)||candidate_edge.contains(b))
+        .flat_map(|((a,b),is)|is.iter().map(move |iv|json!({"edge":[a,b],"chart":iv.curve_id,"rangeBits":[iv.start.to_bits(),iv.end.to_bits()]}))).collect();
+    if memberships.len()>2048 {return Err("second_membership_cap");}
+    Ok(json!({"scope":"second actual face-contour segment and both emitted incident fan hypotheses; no source or union theorem",
+        "complete":true,"face":target.face,"consumers":target.receipt["consumers"],"insideCell":inside_id,"outsideCell":target.outside,
+        "originalSegments":target.receipt["originalSegments"],"originalPins":target.receipt["originalPins"],
+        "globalEdgeInCandidateOrder":global,"sharedEdgeCandidateOrder":candidate_edge,
+        "sharedEdgeOutsideLocalOrder":outside_edge,"sharedEdgeOutsideOrderJoined":[mapping[outside_edge[0]],mapping[outside_edge[1]]],
+        "sharedFeaturePointCandidate":target.candidate_edge[0],"candidateMembershipsAtSharedPoints":memberships,
+        "insideFan":inside_fan,"outsideLocalFan":outside_fan,"outsideJoinedFan":outside_joined,
+        "sourceFingerprint":features.fingerprint().to_string(),"inputGeometryChanged":false,
+        "sourceOwnershipProved":false,"wholeFaceCompatibilityProved":false,"publicationAuthorized":false}))
+}
