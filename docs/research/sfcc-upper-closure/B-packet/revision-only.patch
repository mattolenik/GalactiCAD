+//! Positive closure evidence is distinct from an owned discovery sample or a consumed trace event.
+use super::*;
+use crate::sfcc::{feature_set::SfccFeatureSet, shared_arc_plan::numerical};
+
+type Result<T> = std::result::Result<T, &'static str>;
+
+pub(crate) struct ClosureConsumer<'a> {
+    features: &'a SfccFeatureSet,
+    source: UpperCertificate,
+    incoming: [usize; 2],
+    lifted: [usize; 2],
+    epsilon: f64,
+    residual_epsilon: f64,
+}
+#[derive(Debug)]
+pub(crate) struct CanonicalClosure {
+    phi: f64,
+    point: [f64; 3],
+    association_upper: f64,
+    ordinary_owned: [bool; 2],
+}
+#[derive(Debug)]
+pub(crate) struct ConsumedClosure {
+    chart: usize,
+    parameter: f64,
+    phi: f64,
+    point: [f64; 3],
+    association_upper: f64,
+}
+fn distance_upper(point: [f64; 3], image: ([f64; 3], [f64; 3])) -> Option<f64> {
+    let mut sum = I::point(0.);
+    for k in 0..3 {
+        sum = sum.add(square(
+            I::point(point[k]).sub(interval(image.0[k], image.1[k])?)?,
+        )?)?;
+    }
+    Some(sqrt(sum)?.hi)
+}
+impl<'a> ClosureConsumer<'a> {
+    pub(crate) fn bind(
+        runtime_root: &CsgNode,
+        features: &'a SfccFeatureSet,
+        incoming: [usize; 2],
+        lifted: [usize; 2],
+        phi_max: f64,
+        tolerance: f64,
+    ) -> Result<Self> {
+        if features.curves.len() > 256
+            || incoming[0] == incoming[1]
+            || incoming
+                .iter()
+                .any(|&id| features.curves.get(id).is_none_or(|c| c.id != id))
+            || lifted[0] == lifted[1]
+            || lifted
+                .iter()
+                .any(|&id| features.strata.get(id).is_none_or(|s| s.id != id))
+        {
+            return Err("source_selection");
+        }
+        let epsilon =
+            numerical(features, incoming[0], incoming[1], tolerance).ok_or("numerical_contract")?;
+        let c = &features.curves[incoming[0]];
+        let span = [c.t_min, (c.t_min.floor() + 1.).min(c.t_max)];
+        let tube = c
+            .projection_tube(span[0], span[1])
+            .ok_or("incoming_container")?;
+        let branch = HelixBranch::identify(features, incoming[0], incoming[1], tube)
+            .ok_or("incoming_source")?;
+        let source = super::bind(runtime_root, &features.strata, &branch, phi_max)
+            .ok_or("source_certificate")?;
+        let a = features.strata[lifted[0]]
+            .upper_closure_field_b()
+            .ok_or("lifted_descriptor")?;
+        let b = features.strata[lifted[1]]
+            .upper_closure_field_b()
+            .ok_or("lifted_descriptor")?;
+        let (aroot, achild) = a.upper_closure_descriptor_b().ok_or("lifted_descriptor")?;
+        let (broot, bchild) = b.upper_closure_descriptor_b().ok_or("lifted_descriptor")?;
+        if achild == bchild
+            || !a.upper_closure_same_root_b(b)
+            || !same_source(runtime_root, aroot, &mut 64)
+            || !same_source(runtime_root, broot, &mut 64)
+        {
+            return Err("lifted_source_binding");
+        }
+        // Native and lifted builders own separate immutable copies; structural source binding above is intentional.
+        let (_, _, a_refine) = features.curves[incoming[0]]
+            .traced_carriers()
+            .ok_or("incoming_refinement")?;
+        let (_, _, b_refine) = features.curves[incoming[1]]
+            .traced_carriers()
+            .ok_or("incoming_refinement")?;
+        let residual_epsilon = a_refine.curve_eps.max(b_refine.curve_eps);
+        if !residual_epsilon.is_finite() || residual_epsilon <= 0. {
+            return Err("numerical_contract");
+        }
+        Ok(Self {
+            features,
+            source,
+            incoming,
+            lifted,
+            epsilon,
+            residual_epsilon,
+        })
+    }
+    fn checked_point(&self, phi: f64, point: [f64; 3]) -> Result<f64> {
+        if !phi.is_finite()
+            || phi < 0.
+            || phi > self.source.phi_max
+            || point.iter().any(|v| !v.is_finite())
+        {
+            return Err("source_parameter");
+        }
+        let image = self.source.point_image(phi).ok_or("source_image")?;
+        let distance = distance_upper(point, image).ok_or("association_arithmetic")?;
+        if distance > self.epsilon {
+            return Err("source_association");
+        }
+        for id in self.lifted {
+            let s = &self.features.strata[id];
+            let field = s
+                .raw_field(point[0], point[1], point[2])
+                .normalized_equation()
+                .ok_or("source_gradient")?;
+            if !field.value.is_finite() || field.value.abs() > self.residual_epsilon {
+                return Err("carrier_residual");
+            }
+        }
+        let root = self.features.strata[self.lifted[0]]
+            .upper_closure_field_b()
+            .and_then(|f| f.upper_closure_descriptor_b())
+            .ok_or("lifted_descriptor")?
+            .0;
+        let root_value = crate::sfcc::field_branches::sample_tree(root, point)
+            .normalized_equation()
+            .ok_or("root_gradient")?;
+        if !root_value.value.is_finite() || root_value.value.abs() > self.residual_epsilon {
+            return Err("root_residual");
+        }
+        Ok(distance)
+    }
+    pub(crate) fn canonical(&self, phi: f64) -> Result<CanonicalClosure> {
+        let (lo, hi) = self.source.point_image(phi).ok_or("source_parameter")?;
+        let point = std::array::from_fn(|k| lo[k] * 0.5 + hi[k] * 0.5);
+        let association_upper = self.checked_point(phi, point)?;
+        let ordinary_owned = self
+            .lifted
+            .map(|id| self.features.strata[id].domain_contains(point, self.epsilon));
+        Ok(CanonicalClosure {
+            phi,
+            point,
+            association_upper,
+            ordinary_owned,
+        })
+    }
+    pub(crate) fn consume(
+        &self,
+        chart: usize,
+        parameter: f64,
+        phi: f64,
+    ) -> Result<ConsumedClosure> {
+        let c = self.features.curves.get(chart).ok_or("chart_missing")?;
+        if c.id != chart
+            || c.closed
+            || !parameter.is_finite()
+            || parameter < c.t_min
+            || parameter > c.t_max
+        {
+            return Err("chart_parameter");
+        }
+        if c.adjacent_strata != self.lifted && c.adjacent_strata != [self.lifted[1], self.lifted[0]]
+        {
+            return Err("chart_source_pair");
+        }
+        let (a, b, _) = c.traced_carriers().ok_or("chart_kind")?;
+        if !a.correlated_same_chart_source_c(&self.features.strata[c.adjacent_strata[0]])
+            || !b.correlated_same_chart_source_c(&self.features.strata[c.adjacent_strata[1]])
+        {
+            return Err("chart_registry_binding");
+        }
+        let point = c
+            .shared_checked_point(parameter)
+            .ok_or("own_query_failed")?;
+        let association_upper = self.checked_point(phi, point)?;
+        Ok(ConsumedClosure {
+            chart,
+            parameter,
+            phi,
+            point,
+            association_upper,
+        })
+    }
+    /// Required incident inventory and point membership only. Never authorizes an interval or handoff.
+    pub(crate) fn check_corner(&self, corner: usize, outgoing: usize) -> Result<()> {
+        let corner_id = corner;
+        let corner = self.features.corners.get(corner).ok_or("corner_missing")?;
+        if corner.id != corner_id {
+            return Err("corner_identity");
+        }
+        let point = [corner.x, corner.y, corner.z];
+        self.checked_point(0., point)?;
+        let required = [self.incoming[0], self.incoming[1], outgoing];
+        if required
+            .iter()
+            .any(|id| !corner.curve_ends.iter().any(|(c, _)| c == id))
+        {
+            return Err("required_outgoing_incidence");
+        }
+        if corner.curve_ends.len() != required.len()
+            || corner
+                .curve_ends
+                .iter()
+                .any(|(id, _)| !required.contains(id))
+            || required
+                .iter()
+                .any(|id| corner.curve_ends.iter().filter(|(c, _)| c == id).count() != 1)
+        {
+            return Err("incident_inventory_ambiguous");
+        }
+        for &(id, end) in &corner.curve_ends {
+            let c = self
+                .features
+                .curves
+                .get(id)
+                .ok_or("incident_chart_missing")?;
+            if end > 1 || [c.corner_start, c.corner_end][end as usize] != corner.id as i64 {
+                return Err("incident_endpoint_identity");
+            }
+            if c.adjacent_strata
+                .iter()
+                .any(|sid| !corner.strata.contains(sid))
+            {
+                return Err("incident_stratum_omitted");
+            }
+        }
+        for &(id, end) in &corner.curve_ends {
+            let c = &self.features.curves[id];
+            let t = if end == 0 { c.t_min } else { c.t_max };
+            let own = c.shared_checked_point(t).ok_or("incident_query_failed")?;
+            if distance_upper(own, (point, point)).ok_or("association_arithmetic")? > self.epsilon {
+                return Err("incident_endpoint_mismatch");
+            }
+            for sid in c.adjacent_strata {
+                let s = self
+                    .features
+                    .strata
+                    .get(sid)
+                    .ok_or("incident_stratum_missing")?;
+                let residual = s
+                    .raw_field(own[0], own[1], own[2])
+                    .normalized_equation()
+                    .ok_or("source_gradient")?;
+                if residual.value.abs() > self.epsilon || !residual.value.is_finite() {
+                    return Err("incident_residual");
+                }
+                if !s.domain_contains(own, self.epsilon) {
+                    // Positive evidence requires THIS incident lifted chart's own query, not a point-only token.
+                    let event = self.consume(id, t, 0.)?;
+                    if event.point.map(f64::to_bits) != own.map(f64::to_bits) {
+                        return Err("query_changed");
+                    }
+                }
+            }
+        }
+        for &sid in &corner.strata {
+            if !corner
+                .curve_ends
+                .iter()
+                .any(|&(id, _)| self.features.curves[id].adjacent_strata.contains(&sid))
+            {
+                let s = self
+                    .features
+                    .strata
+                    .get(sid)
+                    .ok_or("extra_stratum_missing")?;
+                if !s.domain_contains(point, self.epsilon)
+                    || !s
+                        .raw_field(point[0], point[1], point[2])
+                        .normalized_equation()
+                        .is_some_and(|v| v.value.is_finite() && v.value.abs() <= self.epsilon)
+                {
+                    return Err("extra_constraint");
+                }
+            }
+        }
+        // Even a declared outgoing curve must be the source-bound lifted pair.
+        let outgoing_curve = &self.features.curves[outgoing];
+        let end = corner
+            .curve_ends
+            .iter()
+            .find(|(id, _)| *id == outgoing)
+            .ok_or("required_outgoing_incidence")?
+            .1;
+        self.consume(
+            outgoing,
+            if end == 0 {
+                outgoing_curve.t_min
+            } else {
+                outgoing_curve.t_max
+            },
+            0.,
+        )?;
+        Ok(())
+    }
+}
