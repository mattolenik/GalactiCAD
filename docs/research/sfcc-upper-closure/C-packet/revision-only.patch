+use super::*;
+use crate::sfcc::{
+    feature_set::{compile_feature_set, SfccFeatureSet},
+    pipeline::{build_pipeline_context, PipelineTuning, SfccWorldCube},
+};
+use serde_json::{json, Value};
+fn hex(x: f64) -> String {
+    format!("{:016x}", x.to_bits())
+}
+fn mid(image: ([f64; 3], [f64; 3])) -> [f64; 3] {
+    std::array::from_fn(|k| image.0[k] * 0.5 + image.1[k] * 0.5)
+}
+fn fixture() -> (CsgNode, SfccFeatureSet, Value) {
+    let v: Value =
+        serde_json::from_str(include_str!("../../fixtures/shared-arc-full-knob.json")).unwrap();
+    let root =
+        crate::scene_bridge::build_csg_tree_from_json(v["sceneJson"].as_str().unwrap()).unwrap();
+    let cube = SfccWorldCube {
+        min_x: v["cube"]["min"][0].as_f64().unwrap(),
+        min_y: v["cube"]["min"][1].as_f64().unwrap(),
+        min_z: v["cube"]["min"][2].as_f64().unwrap(),
+        size: v["cube"]["max"][0].as_f64().unwrap() - v["cube"]["min"][0].as_f64().unwrap(),
+    };
+    let f = {
+        let context = build_pipeline_context(&root, &cube, &PipelineTuning::default());
+        context.features
+    };
+    (root, f, v)
+}
+fn roles(f: &SfccFeatureSet) -> [usize; 3] {
+    let find = |path: Value, is_field: bool, local| {
+        f.strata
+            .iter()
+            .find(|s| {
+                let Some(d) = s.graph_capture_identity_b() else {
+                    return false;
+                };
+                s.local_index == local
+                    && if is_field {
+                        d["field"]["path"] == path
+                    } else {
+                        d["field"].is_null() && d["domain"][0]["path"] == path
+                    }
+            })
+            .unwrap()
+            .id
+    };
+    [
+        find(json!([0, 0, 0, 0, 1]), false, 3),
+        find(json!([0, 0, 0, 0]), true, 0),
+        find(json!([0, 0, 0, 1]), false, 0),
+    ]
+}
+fn initial(f: &SfccFeatureSet) -> (HelixBranch, [usize; 2]) {
+    let ids = crate::sfcc::stage4_source_preflight_c::selected_pair_c(f).unwrap();
+    let tube = f.curves[ids[0]].projection_tube(0., 1.).unwrap();
+    (HelixBranch::identify(f, ids[0], ids[1], tube).unwrap(), ids)
+}
+#[test]
+fn upper_a_source_transition_has_regular_ordered_continuation() {
+    let (root, f, config) = fixture();
+    let (branch, ids) = initial(&f);
+    let cert = bind(&root, &f.strata, &branch, 0.01)
+        .expect("initial outgoing source interval must be proved");
+    let image = cert.image(interval(0., cert.phi_max).unwrap()).unwrap();
+    let phi_samples = [0., 0.0025, 0.005, 0.01];
+    let samples:Vec<_>=phi_samples.into_iter().map(|phi|{
+        let bounds=cert.point_image(phi).unwrap();let p=mid(bounds);
+        let scalar=root.f(p);
+        let exact=cert.image(I::point(phi)).unwrap();
+        json!({"phiHex":hex(phi),"pointHex":p.map(hex),"imageHex":[bounds.0.map(hex),bounds.1.map(hex)],
+            "fullFieldHex":hex(scalar),"operandLevelHex":[hex(exact.a.lo),hex(exact.a.hi)],
+            "sphereLevelHex":[hex(exact.b.lo),hex(exact.b.hi)]})
+    }).collect();
+    let endpoints:Vec<_>=ids.into_iter().map(|id|{
+        let c=&f.curves[id];let p=c.point_at_checked(c.t_max).unwrap();
+        let residual=cert.native_zero_extension_residual(p[1]).unwrap();
+        json!({"chart":id,"sourcePair":c.adjacent_strata,"parameterHex":hex(c.t_max),"pointHex":p.map(hex),
+            "corner":c.corner_end,"fullFieldAtNumericalPointHex":hex(root.f(p)),
+            "idealNativeZeroExtensionResidualHex":[hex(residual.lo),hex(residual.hi)]})
+    }).collect();
+    let extended = bind(&root, &f.strata, &branch, 0.5);
+    let extended_row=extended.as_ref().map(|c|{
+        let at=c.image(I::point(0.5)).unwrap();
+        json!({"phiMax":0.5,"endHeightHex":[hex(at.y.lo),hex(at.y.hi)],"coversHeightThree":c.transition_y.hi<3.&&at.y.lo>3.,
+            "sourceMarginsLowerHex":c.margins.map(hex),"transverseMinorLowerHex":hex(c.transverse_minor_lower)})
+    });
+    let report = json!({"scope":"bounded represented full-scalar source continuation; no trace attachment or complete private admission",
+        "sourceConfigSha256":config["sourceConfigSha256"],"featureFingerprint":f.fingerprint().to_string(),"sourceRoles":cert.source,
+        "sourceIdentities":cert.source.map(|id|f.strata[id].graph_capture_identity_b()),"branchSign":branch.sign,
+        "phiRangeHex":[hex(0.),hex(cert.phi_max)],"transitionHeightHex":[hex(cert.transition_y.lo),hex(cert.transition_y.hi)],
+        "wholeImageHex":[image.xyz.map(|i|hex(i.lo)),image.xyz.map(|i|hex(i.hi))],"sourceMarginsLowerHex":cert.margins.map(hex),
+        "marginOrder":["other profile edges","native finite cap","cylinder finite cap","inner round competitor","groove/chamfer dominance","cap cutter dominance"],
+        "heightDerivativeLowerHex":hex(cert.height_derivative_lower),"liftedTransverseMinorLowerHex":hex(cert.transverse_minor_lower),
+        "orderedIdealCreaseContinues":true,"floatingQueryTotalityProved":false,"attachmentAuthorized":false,"wholeComponentAccepted":false,
+        "samples":samples,"currentUpperEndpoints":endpoints,"optionalLongerInterval":extended_row,
+        "optionalLongerIntervalRefused":extended.is_none()});
+    std::fs::write(
+        std::env::var("SFCC_UPPER_A_RECEIPT").expect("root receipt required"),
+        serde_json::to_vec_pretty(&report).unwrap(),
+    )
+    .unwrap();
+    assert!(cert.margins.iter().all(|x| *x > 0.));
+    assert!(cert.height_derivative_lower > 0. && cert.transverse_minor_lower > 0.);
+    let final_y = cert.image(I::point(cert.phi_max)).unwrap().y;
+    for id in ids {
+        let end = f.curves[id].point_at_checked(f.curves[id].t_max).unwrap();
+        assert!(
+            cert.transition_y.hi < end[1] && end[1] < final_y.lo,
+            "continuing source interval crosses the actual cutoffs"
+        );
+        assert!(
+            cert.native_zero_extension_residual(end[1]).unwrap().lo > 0.,
+            "native zero extension no longer lies on final zero surface"
+        );
+    }
+    let points: Vec<_> = phi_samples
+        .into_iter()
+        .map(|t| mid(cert.point_image(t).unwrap()))
+        .collect();
+    assert!(points.windows(2).all(|w| w[0][1] < w[1][1]));
+    for p in points {
+        assert!(
+            root.f(p).abs() < 1e-10,
+            "existing evaluator agrees at sampled source points"
+        );
+    }
+}
+fn at_mut<'a>(root: &'a mut CsgNode, path: &[usize]) -> &'a mut CsgNode {
+    if path.is_empty() {
+        return root;
+    }
+    match root {
+        CsgNode::Min(c) | CsgNode::Max(c) | CsgNode::Blend { children: c, .. } => {
+            at_mut(&mut c[path[0]], &path[1..])
+        }
+        _ => panic!("source path"),
+    }
+}
+#[test]
+fn upper_a_rejects_unsupported_sources_caps_and_empty_scope() {
+    let (root, f, config) = fixture();
+    let (branch, _) = initial(&f);
+    let cert = bind(&root, &f.strata, &branch, 0.01).unwrap();
+    assert!(bind(&root, &f.strata, &branch, 0.).is_none());
+    assert!(bind(&root, &f.strata, &branch, 0.51).is_none());
+    assert!(bind(&root, &f.strata, &branch, f64::NAN).is_none());
+    let mut wrong = root.clone();
+    let CsgNode::Blend { r, .. } = &mut wrong else {
+        panic!()
+    };
+    *r += 0.001;
+    assert!(bind(&wrong, &f.strata, &branch, 0.01).is_none());
+    let mut wrong_branch = branch.clone();
+    wrong_branch.sign = -wrong_branch.sign;
+    assert!(bind(&root, &f.strata, &wrong_branch, 0.01).is_none());
+    let (other_root, other, _) = fixture();
+    let mut mixed = f.strata.clone();
+    mixed[branch.field] = other.strata[branch.field].clone();
+    assert!(bind(&other_root, &mixed, &branch, 0.01).is_none());
+    for native in [true, false] {
+        let path = if native {
+            vec![0, 0, 0, 0, 1]
+        } else {
+            vec![0, 0, 0, 1]
+        };
+        let mut source_copy = root.clone();
+        let CsgNode::Leaf(original_leaf) = at_mut(&mut source_copy, &path) else {
+            panic!()
+        };
+        let cap_height = cert.transition_y.hi - original_leaf.pos[1] + 0.001;
+        // Rebuild through the real bridge so immutable leaf.strata match the changed shape.
+        let mut scene: Value = serde_json::from_str(config["sceneJson"].as_str().unwrap()).unwrap();
+        if native {
+            scene["lh"]["lh"]["lh"]["lh"]["children"][1]["h"] = json!(cap_height);
+        } else {
+            scene["lh"]["lh"]["lh"]["rh"]["h"] = json!(cap_height);
+        }
+        let clipped =
+            crate::scene_bridge::build_csg_tree_from_json(&serde_json::to_string(&scene).unwrap())
+                .unwrap();
+        let tol = crate::tolerances::resolve_tolerances(&crate::tuning::SfccTuning::default(), 50.);
+        let (clipped_f, _) = compile_feature_set(&clipped, &tol);
+        let ids = roles(&clipped_f);
+        let (p, _, _, _) = clipped_f.strata[ids[0]]
+            .round_twisted_source(&clipped_f.strata[ids[1]])
+            .unwrap();
+        let radius = clipped_f.strata[ids[2]].certificate_cylinder().unwrap().2;
+        let u = branch.sign as f64 * (radius * radius - p.v0z * p.v0z).sqrt();
+        let y = cert.transition_y.lo * 0.5 + cert.transition_y.hi * 0.5;
+        let theta = (y - p.pos_y + p.h) / (2. * p.h) * p.twist_rad;
+        let (sn, cs) = theta.sin_cos();
+        let proposed = [
+            p.pos_x + u * cs - p.v0z * sn,
+            y,
+            p.pos_z + u * sn + p.v0z * cs,
+        ];
+        let b = branch_at(&clipped_f.strata, ids[0], ids[1], ids[2], proposed)
+            .expect("fresh changed source supplies the proposed regular radial branch");
+        assert!(
+            BranchCertificate::bind_strata(&clipped_f.strata, &b, cert.transition_y).is_some(),
+            "the zero-level transition remains strictly inside both finite caps"
+        );
+        assert!(
+            bind(&clipped, &clipped_f.strata, &b, 0.01).is_none(),
+            "the changed finite cap must prevent the requested outgoing continuation"
+        );
+    }
+}
