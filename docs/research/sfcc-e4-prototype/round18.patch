+#[cfg(test)]
+pub(crate) fn legacy_reserve_source_view_a(f: &SfccFeatureSet, already: usize) -> Result<(), &'static str> {
+    use std::fmt::Write;
+    struct Count {
+        bytes: usize,
+    }
+    impl std::fmt::Write for Count {
+        fn write_str(&mut self, s: &str) -> std::fmt::Result {
+            self.bytes = self.bytes.saturating_add(s.len().saturating_mul(64));
+            if self.bytes > 64 * 1024 * 1024 {
+                Err(std::fmt::Error)
+            } else {
+                Ok(())
+            }
+        }
+    }
+    let mut count = Count {
+        bytes: already
+            .saturating_add(f.index.private_clone_reservation())
+            .saturating_add(std::mem::size_of_val(f)),
+    };
+    write!(
+        &mut count,
+        "{:?}{:?}{:?}{:?}",
+        f.curves, f.corners, f.strata, f.unresolved_branch_paths
+    )
+    .map_err(|_| "64MiB conservative private source-view/staging reservation")
+}
