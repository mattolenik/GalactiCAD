diff --git a/docs/research/sfcc-arrangement-c/fast-path-bench.rs b/docs/research/sfcc-arrangement-c/fast-path-bench.rs
new file mode 100644
--- /dev/null
+++ b/docs/research/sfcc-arrangement-c/fast-path-bench.rs
@@ -0,0 +1,24 @@
+use gcad_kernel::{sdf::{self,CsgNode,Shape},sfcc::{feature_set::build_leaf_strata,pipeline::{run_sfcc_pipeline,PipelineTuning,SfccWorldCube}}};
+use std::time::Instant;
+fn attach(tree:&mut CsgNode,next:&mut usize) {
+ match tree {CsgNode::Leaf(l)=>{l.strata=build_leaf_strata(l,l.index,*next);*next+=l.strata.len();},CsgNode::Min(ch)|CsgNode::Max(ch)|CsgNode::Blend{children:ch,..}=>for c in ch{attach(c,next)}}
+}
+fn main() {
+ let name=std::env::args().nth(1).unwrap();
+ let box_=|p,h|sdf::leaf_at(Shape::Cuboid{half:h},p);
+ let mut tree=match name.as_str(){
+  "clipped-box"=>sdf::intersect(vec![box_([0.;3],[1.;3]),box_([-1.75,0.,0.],[2.25,4.,4.])]),
+  "duplicate-boxes-16"=>sdf::union(vec![box_([0.;3],[3.;3]);16]),
+  "duplicate-boxes-256"=>sdf::union(vec![box_([0.;3],[3.;3]);256]),
+  "box"=>box_([0.;3],[3.;3]),_=>panic!("unknown fixture"),
+ };
+ tree.assign_leaf_indices();attach(&mut tree,&mut 0);
+ let cube=if name=="clipped-box" {SfccWorldCube{min_x:-4.,min_y:-4.,min_z:-4.,size:8.}} else {SfccWorldCube{min_x:-10.,min_y:-10.,min_z:-10.,size:20.}};
+ let tuning=PipelineTuning::default();
+ std::hint::black_box(run_sfcc_pipeline(&tree,&cube,&tuning));
+ for sample in 0..3 {
+  let start=Instant::now();let r=run_sfcc_pipeline(&tree,&cube,&tuning);let elapsed=start.elapsed().as_secs_f64()*1000.;
+  println!("{{\"scene\":\"{name}\",\"sample\":{sample},\"elapsedMs\":{elapsed},\"leaves\":{},\"triangles\":{},\"ok\":{}}}",r.stats.leaves,r.tris.len()/3,r.ok);
+  std::hint::black_box(r);
+ }
+}
