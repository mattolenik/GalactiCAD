+const ATTEMPT_FIELDS: [&str; 11] = [
+    "deltaHex",
+    "displacementHex",
+    "domain",
+    "firstPredicate",
+    "fullResidualHex",
+    "level",
+    "normalErrorHex",
+    "oppositeResidualHex",
+    "ownResidualHex",
+    "pointHex",
+    "sign",
+];
+fn compact_attempts(report: &Value) -> Value {
+    let mut evidence = report.clone();
+    for query in evidence["queries"].as_array_mut().unwrap() {
+        let Some(flanks) = query["flanks"].as_array_mut() else {
+            continue;
+        };
+        for flank in flanks {
+            for attempt in flank["attempts"].as_array_mut().unwrap() {
+                assert_eq!(attempt.as_object().unwrap().len(), ATTEMPT_FIELDS.len());
+                let row: Vec<_> = ATTEMPT_FIELDS
+                    .iter()
+                    .map(|key| attempt.get(*key).unwrap().clone())
+                    .collect();
+                *attempt = json!(row);
+            }
+        }
+    }
+    json!({"encoding":"sfcc-junction-c-columnar-attempts-v1", "attemptFields":ATTEMPT_FIELDS,"evidence":evidence})
+}
+fn expand_attempts(compact: &Value) -> Value {
+    assert_eq!(compact["encoding"], "sfcc-junction-c-columnar-attempts-v1");
+    assert_eq!(compact["attemptFields"], json!(ATTEMPT_FIELDS));
+    let mut evidence = compact["evidence"].clone();
+    for query in evidence["queries"].as_array_mut().unwrap() {
+        let Some(flanks) = query["flanks"].as_array_mut() else {
+            continue;
+        };
+        for flank in flanks {
+            for attempt in flank["attempts"].as_array_mut().unwrap() {
+                let row = attempt.as_array().unwrap();
+                assert_eq!(row.len(), ATTEMPT_FIELDS.len());
+                let object: serde_json::Map<String, Value> = ATTEMPT_FIELDS
+                    .iter()
+                    .zip(row)
+                    .map(|(key, v)| ((*key).into(), v.clone()))
+                    .collect();
+                *attempt = Value::Object(object);
+            }
+        }
+    }
+    evidence
+}
