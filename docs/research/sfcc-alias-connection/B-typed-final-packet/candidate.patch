+        f,
+        source,
+        pair,
+        ranges,
+        branch.cylinder.2 - 0.01,
+        eps,
+    )
+    .unwrap();
+    let (_, mut budget) = private_arc_a::admit(f, primary, 0.02).unwrap();
+    let g = unpack_point(&context.lat, key);
+    let plane = point_to_world(&context.lat, g[0], g[1], g[2])[1];
+    let before = budget.charged_queries();
+    let proof = admit(
