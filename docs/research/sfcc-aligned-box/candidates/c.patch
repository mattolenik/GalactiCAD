+    json!({"kind":"union","children":[box_([-1.875,0.,0.],[2.125,4.,4.]),{"kind":"intersect","lh":box_([2.25,0.,0.],[1.75,4.,4.]),"rh":box_([-1.625,0.,0.],[2.375,4.,4.])}]})
