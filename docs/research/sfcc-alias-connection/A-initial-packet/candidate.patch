+#[test]
+fn alias_a_whole_ideal_interval_and_checked_consumed_events() {
+    let (root, f, source, charts, ranges, rho_min, eps) = fixture();
+    let cert = bind(&root, &f, source, charts, ranges, rho_min, eps)
+        .expect("whole consumed source interval/tubes");
+    let mut budget = budget(&f);
+    let before = budget.charged_queries();
+    let mut rows = Vec::new();
+    for s in 0..2 {
+        let mut mapped = Vec::new();
+        for i in 0..=24 {
+            let t = if i == 24 {
+                ranges[s][1]
+            } else {
+                ranges[s][0] + (ranges[s][1] - ranges[s][0]) * i as f64 / 24.
+            };
+            let own = cert
+                .query(charts[s], t, &mut budget)
+                .expect("source checked own query");
+            let other = cert
+                .map(&own, charts[1 - s], &mut budget)
+                .expect("actual checked counterpart");
+            assert!(transport_a::accepts(own.point(), other.point(), eps));
+            rows.push(json!({"chart":own.chart(),"parameterBits":own.parameter().to_bits(),"radial":own.radial(),"pointBits":own.point().map(f64::to_bits),"otherChart":other.chart(),"otherParameterBits":other.parameter().to_bits(),"otherRadial":other.radial(),"otherPointBits":other.point().map(f64::to_bits)}));
+            mapped.push((own, other));
+        }
+        Certificate::ordered(&mapped)
+            .expect("both actual parameter and canonical radial event sequences ordered");
+    }
+    let image = cert.image(cert.radial[0], cert.radial[1]).unwrap();
+    let report = json!({"scope":"whole ideal source interval and full raw-query-tube alias equation proof; checked actual event transport, not universal oldNewton continuity","featureFingerprint":f.fingerprint().to_string(),"source":cert.source,"charts":charts,"ranges":ranges,"globalRanges":charts.map(|c|[f.curves[c].t_min,f.curves[c].t_max]),"globalCorners":charts.map(|c|[f.curves[c].corner_start,f.curves[c].corner_end]),"canonicalRadialRange":cert.radial,"idealImage":image,"sourceMargins":cert.source_margins,"tubeAliasMargins":cert.tube_alias_margins,"rawProjectionTubes":cert.tubes,"heightDerivativeAbsLower":cert.height_derivative_abs_lower,"generatedOffsetError":[cert.generated_offset_error.lo,cert.generated_offset_error.hi],"sourceGeneratedSeparationUpper":cert.source_generated_separation_upper,"allowance":eps,"events":rows,"chargedBefore":before,"chargedAfter":budget.charged_queries(),"rawQueryContinuityProved":false,"wholeChartAliasProved":false,"transactionAuthorized":false});
+    std::fs::write(
+        std::env::var("SFCC_ALIAS_A_RECEIPT").unwrap(),
+        serde_json::to_vec_pretty(&report).unwrap(),
+    )
+    .unwrap();
+}
+#[test]
+fn alias_a_rejects_foreign_sources_ranges_points_and_budget() {
+    let (root, f, source, charts, ranges, rho_min, eps) = fixture();
+    let cert = bind(&root, &f, source, charts, ranges, rho_min, eps).unwrap();
+    for bad in [0., f64::NAN, eps * 2.] {
+        assert!(bind(&root, &f, source, charts, ranges, rho_min, bad).is_none());
+    }
+    let mut wrong_root = root.clone();
+    let CsgNode::Blend { r, .. } = &mut wrong_root else {
+        panic!()
+    };
+    *r += 0.1;
+    assert!(bind(&wrong_root, &f, source, charts, ranges, rho_min, eps).is_none());
+    assert!(bind(
+        &root,
+        &f,
+        source,
+        [charts[1], charts[0]],
+        ranges,
+        rho_min,
+        eps
+    )
+    .is_none());
+    let mut wrong_id = f.clone();
+    wrong_id.curves[charts[0]].id += 1;
+    assert!(bind(&root, &wrong_id, source, charts, ranges, rho_min, eps).is_none());
+    let mut bad_ranges = ranges;
+    bad_ranges[0][1] = f.curves[charts[0]].t_max + 1.;
+    assert!(bind(&root, &f, source, charts, bad_ranges, rho_min, eps).is_none());
+    assert!(bind(&root, &f, source, charts, ranges, cert.radial[1], eps).is_none());
+    let mut budget = budget(&f);
+    let own = cert
+        .query(charts[0], ranges[0][1] * 0.5, &mut budget)
+        .unwrap();
+    let mut wrong = own.point();
+    wrong[0] += 0.01;
+    assert!(cert
+        .retained(charts[0], own.parameter(), wrong, &mut budget)
+        .is_err());
+    assert!(cert.check_point(charts[0], f64::NAN, own.point()).is_none());
+    let before = budget.charged_queries();
+    {
+        let _cancel = crate::sfcc::cancel::CancelGuard::install(Box::new(|| true));
+        assert!(cert
+            .query_main(charts[0], own.parameter(), &mut budget)
+            .is_err());
+    }
+    assert_eq!(before, budget.charged_queries());
+    let foreign = f.clone();
+    let mut foreign_budget = super::tests::budget(&foreign);
+    assert!(cert
+        .query(charts[0], own.parameter(), &mut foreign_budget)
+        .is_err());
+    budget
+        .reserve_external(16384 - budget.charged_queries())
+        .unwrap();
+    assert!(matches!(
+        cert.query_main(charts[0], own.parameter(), &mut budget),
+        Err(Failure::Budget(transport_a::Failure::TotalCap))
+    ));
+    assert_eq!(budget.charged_queries(), 16384);
+}
