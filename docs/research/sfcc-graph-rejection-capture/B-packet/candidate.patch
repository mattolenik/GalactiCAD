+            active: true,
+            initial_points: 0,
+            finished: false,
+        };
+        drop(c);
+        assert_eq!(
+            DIAGNOSTIC.with(|s| s.borrow().as_ref().unwrap()["graphCaptureB"]["abandoned"].clone()),
+            true
+        );
+        DIAGNOSTIC.with(|s| *s.borrow_mut() = None);
+    }
