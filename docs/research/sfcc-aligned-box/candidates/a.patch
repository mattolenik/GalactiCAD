+        (
+            "annulus",
+            json!({"kind":"subtract","lh":cuboid([0.;3],[3.,3.,1.]),"rh":cuboid([0.;3],[1.,1.,2.])}),
+            1,
+            vec![0],
+        ),
+    ];
+    for (name, scene, components, mut euler) in fixtures {
+        let tree = build_csg_tree_from_json(&scene.to_string()).unwrap();
+        let world = if name == "annulus" {
+            SfccWorldCube {
+                min_x: -512.,
+                min_y: -512.,
+                min_z: -512.,
+                size: 1024.,
+            }
+        } else {
+            world
+        };
+        let r = run_sfcc_pipeline(&tree, &world, &tuning);
+        assert!(r.ok, "{name}:{}", r.validation.to_json());
+        assert_eq!(r.manifold.components, components);
+        let mut got = r.manifold.euler_per_component.clone();
+        got.sort();
+        euler.sort();
+        assert_eq!(got, euler);
+        assert_eq!(
+            r.validation.local_coverage.scope, "signedBoxArrangement",
+            "{name}"
+        );
+    }
+}
+#[test]
+fn signed_tree_reordering_and_duplicate_ids_preserve_exact_geometry() {
+    use gcad_kernel::sfcc::pipeline::run_sfcc_pipeline;
+    let original = sheets();
+    let mut swapped = original.clone();
+    swapped["children"].as_array_mut().unwrap().reverse();
+    let duplicate = json!({"kind":"union","children":[original.clone(),original.clone()]});
+    let world = SfccWorldCube {
+        min_x: -128.,
+        min_y: -128.,
+        min_z: -128.,
+        size: 256.,
+    };
+    let mut outputs = Vec::new();
+    for scene in [original, swapped, duplicate] {
+        let tree = build_csg_tree_from_json(&scene.to_string()).unwrap();
+        let r = run_sfcc_pipeline(&tree, &world, &PipelineTuning::default());
+        assert!(r.ok);
+        let mut triangles = r
+            .tris
+            .chunks_exact(3)
+            .map(|t| {
+                let p = t
+                    .iter()
+                    .map(|&i| {
+                        r.verts[i as usize * 8..i as usize * 8 + 3]
+                            .iter()
+                            .map(|v| v.to_bits())
+                            .collect::<Vec<_>>()
+                    })
+                    .collect::<Vec<_>>();
+                let k = (0..3).min_by_key(|&i| p[i].clone()).unwrap();
+                [p[k].clone(), p[(k + 1) % 3].clone(), p[(k + 2) % 3].clone()]
+            })
+            .collect::<Vec<_>>();
+        triangles.sort();
+        outputs.push(triangles)
+    }
+    assert_eq!(outputs[0], outputs[1]);
+    assert_eq!(outputs[0], outputs[2]);
+}
