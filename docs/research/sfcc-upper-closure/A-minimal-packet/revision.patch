+impl Stratum {
+    pub(crate) fn upper_round_child_matches(
+        &self,
+        parent: &Self,
+        cylinder: &Self,
+        child: usize,
+    ) -> bool {
+        if self.sign != 1. || self.compound.is_some() || parent.sign != 1. || cylinder.sign != 1. {
+            return false;
+        }
+        let Some(field) = &self.field else {
+            return false;
+        };
+        let Some(parent) = &parent.field else {
+            return false;
+        };
+        let Some(cyl) = &cylinder.domain else {
+            return false;
+        };
+        let Some(domain) = &self.domain else {
+            return false;
+        };
+        cyl.len() == 1
+            && domain.len() == 1
+            && domain[0].same_domain(field)
+            && field.upper_round_child_of(parent, &cyl[0], child)
+    }
+}
