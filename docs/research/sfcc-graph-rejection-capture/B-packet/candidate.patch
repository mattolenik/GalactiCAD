@@ -0,0 +1,309 @@
+//! B: pre-call provenance plus exact executed graph refusal. No geometry queries.
+use super::DIAGNOSTIC;
+use crate::sfcc::{
+    cell_mesh::CellMeshOptions,
+    face_contour::FacePin,
+    feature_set::SfccFeatureSet,
+    octree::SfccCell,
+    point_table::{CurveInterval, PointKey, PointTable},
+};
+use serde_json::{json, Value};
+use std::collections::{BTreeMap, BTreeSet};
+const CAP: usize = 512 * 1024;
+const ITEMS: usize = 1024;
+fn bits(x: f64) -> String {
+    format!("{:016x}", x.to_bits())
+}
+fn query_count() -> Option<usize> {
+    super::QUERY_LOG.with(|s| s.borrow().as_ref().map(|log| log.attempts.len()))
+}
+fn bounded(value: Value) -> Value {
+    struct Writer(Vec<u8>);
+    impl std::io::Write for Writer {
+        fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+            if bytes.len() > CAP - self.0.len() {
+                return Err(std::io::ErrorKind::OutOfMemory.into());
+            }
+            self.0.extend_from_slice(bytes);
+            Ok(bytes.len())
+        }
+        fn flush(&mut self) -> std::io::Result<()> {
+            Ok(())
+        }
+    }
+    let mut w = Writer(Vec::with_capacity(CAP));
+    if serde_json::to_writer(&mut w, &value).is_err() {
+        json!({"complete":false,"refusal":"graph_capture_512KiB_cap","byteCap":CAP,"context":value.get("context"),"returned":value.get("returned"),"rejectionCode":value.get("rejectionCode")})
+    } else {
+        value
+    }
+}
+fn point_record(p: &PointTable, id: usize) -> Value {
+    let key = match p.key_at(id) {
+        PointKey::Num(k) => json!({"numericHex":format!("{:016x}", *k as u64)}),
+        PointKey::Str(k) => json!({"string":k}),
+        PointKey::Unkeyed => Value::Null,
+    };
+    json!({"id":id,"key":key,"positionHex":[bits(p.x(id)),bits(p.y(id)),bits(p.z(id))],
+        "normalHex":[bits(p.nx(id)),bits(p.ny(id)),bits(p.nz(id))]})
+}
+fn points_supported(points: &PointTable) -> bool {
+    points.count() <= ITEMS
+        && (0..points.count()).all(|id| match points.key_at(id) {
+            PointKey::Str(k) => k.len() <= 128,
+            _ => true,
+        })
+}
+pub(crate) fn context(cell: &SfccCell, curved: bool, distinct: usize, pruned: bool) {
+    DIAGNOSTIC.with(|s| {
+        if let Some(v) = s.borrow_mut().as_mut() {
+            v["graphContextB"] = json!({"cell":[cell.level as i64,cell.ix,cell.iy,cell.iz],
+            "degenerate":cell.degenerate,"featureCorner":cell.feature_corner,
+            "featureCurve":cell.feature_curve,"curvedCorner":curved,"distinctPinCurves":distinct,
+            "queryViewPruned":pruned});
+            v.as_object_mut().unwrap().remove("graphCaptureB");
+        }
+    });
+}
+pub(crate) struct Capture {
+    active: bool,
+    initial_points: usize,
+    finished: bool,
+}
+impl Capture {
+    pub(crate) fn begin(
+        loops: &[Vec<usize>],
+        pins: &[FacePin],
+        corners: &[usize],
+        cell_box: &[f64; 6],
+        points: &PointTable,
+        features: &SfccFeatureSet,
+        opts: &CellMeshOptions,
+    ) -> Self {
+        let context = DIAGNOSTIC.with(|s| {
+            s.borrow()
+                .as_ref()
+                .and_then(|v| v.get("graphContextB"))
+                .cloned()
+        });
+        let mut this = Self {
+            active: context.is_some(),
+            initial_points: points.count(),
+            finished: false,
+        };
+        let Some(context) = context else {
+            return this;
+        };
+        let count = loops.iter().map(Vec::len).sum::<usize>();
+        let valid = loops.len() <= 64
+            && count <= ITEMS
+            && pins.len() <= ITEMS
+            && corners.len() <= 64
+            && points_supported(points)
+            && loops.iter().flatten().all(|&id| id < points.count())
+            && pins
+                .iter()
+                .all(|p| p.point_id < points.count() && p.curve_id < features.curves.len())
+            && corners.iter().all(|&i| {
+                features
+                    .corners
+                    .get(i)
+                    .is_some_and(|c| c.curve_ends.len() <= 64 && c.strata.len() <= 64)
+            });
+        if !valid {
+            this.store(
+                json!({"context":context,"complete":false,"refusal":"graph_capture_input_bound"}),
+            );
+            return this;
+        }
+        let curve_ids: BTreeSet<_> = pins
+            .iter()
+            .map(|p| p.curve_id)
+            .chain(
+                corners
+                    .iter()
+                    .flat_map(|&id| features.corners[id].curve_ends.iter().map(|p| p.0)),
+            )
+            .collect();
+        if curve_ids.len() > 128 || curve_ids.iter().any(|&id| id >= features.curves.len()) {
+            this.store(
+                json!({"context":context,"complete":false,"refusal":"graph_capture_source_bound"}),
+            );
+            return this;
+        }
+        let mut strata_ids = BTreeSet::new();
+        for &id in &curve_ids {
+            strata_ids.extend(features.curves[id].adjacent_strata);
+        }
+        for &id in corners {
+            strata_ids.extend(features.corners[id].strata.iter().copied());
+        }
+        if strata_ids.len() > 128 || strata_ids.iter().any(|&id| id >= features.strata.len()) {
+            this.store(
+                json!({"context":context,"complete":false,"refusal":"graph_capture_stratum_bound"}),
+            );
+            return this;
+        }
+        let sources: Option<Vec<_>> = strata_ids
+            .into_iter()
+            .map(|id| features.strata[id].graph_capture_identity_b())
+            .collect();
+        let Some(sources) = sources else {
+            this.store(json!({"context":context,"complete":false,"refusal":"graph_capture_source_path_bound"}));
+            return this;
+        };
+        let curves: Vec<_> = curve_ids
+            .into_iter()
+            .map(|id| {
+                let c = &features.curves[id];
+                json!({"id":id,
+            "ownerNodeId":c.owner_node_id,"native":c.native,"kind":format!("{:?}",c.kind()),
+            "strata":c.adjacent_strata,"rangeHex":[bits(c.t_min),bits(c.t_max)],"closed":c.closed,
+            "wrapHex":c.param_wrap.map(bits),"cornerEnds":[c.corner_start,c.corner_end]})
+            })
+            .collect();
+        let corners:Vec<_>=corners.iter().map(|&id|{let c=&features.corners[id];json!({"id":id,
+            "positionHex":[bits(c.x),bits(c.y),bits(c.z)],"curveEnds":c.curve_ends,"strata":c.strata})}).collect();
+        this.store(json!({"context":context,"complete":true,"returned":null,"finalPrivateFailure":false,"queryStart":query_count(),"queryIndexConvention":"half-open indices into generatedQueries; excludes later fallback work",
+            "scope":"local pre-call inputs and executed guard; replay also requires pinned source and private feature-view edits",
+            "pre":{"loops":loops,"pins":pins.iter().map(|p|json!({"id":p.point_id,"chart":p.curve_id,"parameterHex":bits(p.t)})).collect::<Vec<_>>(),
+                "corners":corners,"curves":curves,"strata":sources,"cellBoxHex":cell_box.map(bits),
+                "allPrivatePoints":(0..points.count()).map(|id|point_record(points,id)).collect::<Vec<_>>(),
+                "options":{"surfaceTolHex":bits(opts.surface_tol),"chordTolHex":bits(opts.curve_chord_tol),
+                    "maxPolylinePoints":opts.max_polyline_points_per_cell,"projectMaxIters":opts.project_max_iters,
+                    "qualityTriangulation":opts.quality_triangulation,"interiorMode":format!("{:?}",opts.interior_vertex_mode)}},
+            "bounds":{"serializedBytes":CAP,"points":ITEMS,"loopEntries":ITEMS,"pins":ITEMS,
+                "corners":64,"curves":128,"strata":128,"edges":ITEMS,"memberships":ITEMS},
+            "sourceGeometryIncluded":false,"completeReplayEstablished":false}));
+        this
+    }
+    fn store(&mut self, value: Value) {
+        DIAGNOSTIC.with(|s| {
+            if let Some(v) = s.borrow_mut().as_mut() {
+                v["graphCaptureB"] = bounded(value);
+            }
+        });
+    }
+    pub(crate) fn finish(
+        &mut self,
+        code: &'static str,
+        operands: Value,
+        edges: &BTreeMap<(usize, usize), Option<BTreeSet<usize>>>,
+        memberships: &[(usize, usize, CurveInterval)],
+        points: &PointTable,
+    ) {
+        if !self.active {
+            return;
+        }
+        self.finished = true;
+        DIAGNOSTIC.with(|s|if let Some(v)=s.borrow_mut().as_mut(){
+            let mut capture=v["graphCaptureB"].take();
+            capture["returned"]=json!(false);capture["queryEnd"]=json!(query_count());capture["rejection"]=json!({"code":code,"operands":operands});
+            if edges.len()>ITEMS || edges.values().flatten().any(|s|s.len()>128) || memberships.len()>ITEMS || !points_supported(points) {
+                capture["complete"]=json!(false);capture["postRefusal"]=json!("graph_capture_graph_bound");
+            } else {
+                capture["graph"]=json!({"edges":edges.iter().map(|(&(a,b),s)|json!({"edge":[a,b],"strata":s})).collect::<Vec<_>>(),
+                    "memberships":memberships.iter().map(|(a,b,m)|json!({"edge":[a,b],"chart":m.curve_id,"rangeHex":[bits(m.start),bits(m.end)]})).collect::<Vec<_>>(),
+                    "newPoints":(self.initial_points..points.count()).map(|id|point_record(points,id)).collect::<Vec<_>>(),"pointCount":points.count()});
+            }
+            capture["rejectionCode"]=json!(code);
+            v["graphCaptureB"]=bounded(capture);
+        });
+    }
+    pub(crate) fn success(&mut self) {
+        self.finished = true;
+        if self.active {
+            DIAGNOSTIC.with(|s| {
+                if let Some(v) = s.borrow_mut().as_mut() {
+                    v["graphCaptureB"]["returned"] = json!(true);
+                    v["graphCaptureB"]["queryEnd"] = json!(query_count());
+                }
+            });
+        }
+    }
+}
+impl Drop for Capture {
+    fn drop(&mut self) {
+        if self.active && !self.finished {
+            DIAGNOSTIC.with(|s| {
+                if let Some(v) = s.borrow_mut().as_mut() {
+                    v["graphCaptureB"]["complete"] = json!(false);
+                    v["graphCaptureB"]["abandoned"] = json!(true);
+                }
+            });
+        }
+    }
+}
+pub(crate) fn final_failure(cell: &SfccCell) {
+    DIAGNOSTIC.with(|s| {
+        if let Some(v) = s.borrow_mut().as_mut() {
+            let id = json!([cell.level as i64, cell.ix, cell.iy, cell.iz]);
+            let matches = v["graphCaptureB"]["context"]["cell"] == id;
+            if v.get("graphCaptureB").is_some() {
+                v["graphCaptureB"]["finalPrivateFailure"] = json!(matches);
+            }
+        }
+    });
+}
+#[cfg(test)]
+pub(crate) fn test_begin() {
+    DIAGNOSTIC.with(|s| *s.borrow_mut() = Some(json!({"graphContextB":{"cell":[7,36,79,29]}})));
+}
+#[cfg(test)]
+pub(crate) fn test_take() -> Value {
+    DIAGNOSTIC.with(|s| s.borrow_mut().take().unwrap_or(Value::Null))
+}
+#[cfg(test)]
+mod tests {
