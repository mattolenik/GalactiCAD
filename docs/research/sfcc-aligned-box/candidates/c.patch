+fn canonical(verts: &[f32], tris: &[u32]) -> Vec<Vec<u32>> {
+    let mut out: Vec<_> = tris
+        .chunks_exact(3)
+        .map(|t| {
+            let p: Vec<_> = t
+                .iter()
+                .map(|&i| {
+                    verts[i as usize * 8..i as usize * 8 + 8]
+                        .iter()
+                        .map(|v| v.to_bits())
+                        .collect::<Vec<_>>()
+                })
+                .collect();
+            (0..3)
+                .map(|j| [p[j].clone(), p[(j + 1) % 3].clone(), p[(j + 2) % 3].clone()].concat())
+                .min()
+                .unwrap()
+        })
+        .collect();
+    out.sort();
+    out
+}
+#[test]
+fn raw_worker_groups_and_resumable_keep_actual_geometry() {
+    use gcad_kernel::sfcc::worker::*;
+    let tree = build_csg_tree_from_json(&sheets().to_string()).unwrap();
+    let cube = SfccWorldCube {
+        min_x: -128.,
+        min_y: -128.,
+        min_z: -128.,
+        size: 256.,
+    };
+    let tuning = PipelineTuning::default();
+    let leaves = prepare(&tree, &cube, &tuning);
+    assert_eq!(
+        leaves,
+        build_octree_resumable_inprocess(&tree, &cube, &tuning)
+    );
+    let serial = gcad_kernel::sfcc::pipeline::run_sfcc_pipeline(&tree, &cube, &tuning);
+    let expected = canonical(&serial.verts, &serial.tris);
+    for n in [1, 2, 4, 8] {
+        let mut partials: Vec<_> = (0..n)
+            .map(|i| mesh_partition(&tree, &cube, &tuning, &leaves, i, n))
+            .collect();
+        assert!(partials.iter().all(|p| p.starts_with(b"BXC1")));
+        eprintln!(
+            "workers={n} wireBytes={}",
+            partials.iter().map(Vec::len).sum::<usize>()
+        );
+        for reverse in [false, true] {
+            if reverse {
+                partials.reverse();
+            }
+            let result = merge(&tree, &cube, &tuning, &partials);
+            assert!(!result.serial_recovery);
+            assert!(result.ok);
+            assert_eq!(result.manifold.components, 2);
+            assert_eq!(result.validation, serial.validation);
+            assert_eq!(canonical(&result.verts, &result.tris), expected);
+            assert_eq!(result.feature_edges, serial.feature_edges);
+        }
+        if n == 2 {
+            let mut corrupt = partials.clone();
+            let len = corrupt[0].len();
+            corrupt[0][len - 1] ^= 1;
+            assert!(std::panic::catch_unwind(|| merge(&tree, &cube, &tuning, &corrupt)).is_err());
+            assert!(
+                std::panic::catch_unwind(|| merge(&tree, &cube, &tuning, &partials[..1])).is_err()
+            );
+            let duplicate = vec![partials[0].clone(), partials[0].clone()];
+            assert!(std::panic::catch_unwind(|| merge(&tree, &cube, &tuning, &duplicate)).is_err());
+        }
+    }
