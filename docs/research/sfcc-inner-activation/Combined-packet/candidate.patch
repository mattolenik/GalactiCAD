+    let deficit = I::point(inner_r).sub(other_branch.distance).unwrap();
+    assert!(deficit.lo > 0. && deficit.hi < cert.outgoing_depth);
+    let z = deficit.lo * 0.5 + deficit.hi * 0.5;
+    let ghost_distances = [false, true]
+        .map(|generated| distance(tail, cert.ghost_image(z, z, generated).unwrap()).unwrap());
+    assert!(ghost_distances.iter().all(|&d| d <= eps));
+    let outgoing = query(
+        &f,
+        cert.charts[1],
+        brackets[1][1],
+        event.tubes[1],
+        &mut ledger,
+        &mut count,
+        &mut trace,
+    )
+    .unwrap();
+    let cylinder = f.strata[cert.source[2]].certificate_cylinder().unwrap();
+    let radial = (outgoing[0] - cylinder.0[0]).hypot(outgoing[2] - cylinder.0[2]);
+    let outgoing_rows: Vec<_> = [false, true]
+        .into_iter()
+        .map(|generated| {
+            let a = cert.activation_radial(generated);
+            let delta = (a[0] * 0.5 + a[1] * 0.5) - radial;
+            assert!(delta > 0. && delta <= cert.outgoing_depth);
+            let d = distance(
+                outgoing,
+                cert.outgoing_image(delta, delta, generated).unwrap(),
+            )
+            .unwrap();
+            assert!(d <= eps);
+            json!({"generated":generated,"radialDrop":delta,"associationUpper":d})
+        })
+        .collect();
+    let report = json!({"scope":"source event and two old numerical cut parameters, plus original endpoint/frontier associations; no graph/face mutation or whole-raw-tail proof",
+        "sourceReceiptSha256":captured["receiptSha256"],"event":event.report(),"minimumCellMargin":minimum_margin,
+        "allCapturedNativeFacePinsBeforeCut":true,"nativeDeclaredEnd":f.curves[cert.charts[0]].t_max,
+        "nativeEndQueryBits":tail.map(f64::to_bits),"nativeEndOtherDeficitBounds":[deficit.lo,deficit.hi],"nativeEndGhostAssociationUpper":ghost_distances,
+        "physicalFrontierQueryBits":outgoing.map(f64::to_bits),"physicalFrontier":outgoing_rows,
+        "queries":trace,"chargedBefore":charged_before,"chargedAfter":ledger.charged_queries(),"fullRawTailContinuityProved":false,"wholeTransactionPrepared":false});
+    write("activation-C-association.json", &report);
+}
