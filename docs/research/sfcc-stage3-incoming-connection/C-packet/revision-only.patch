+#[test]
+fn connection_c_original_lerp_can_reverse_one_ulp_while_pinned_chart_does_not() {
+    // Arithmetic control only: this is not a measured reversal on the knob trace.
+    let a = f64::from_bits(0xc003efb1a33e9e36);
+    let b = f64::from_bits(0xc003f141205bc01a);
+    let t = [
+        f64::from_bits(0x3fe0000000000a8d),
+        f64::from_bits(0x3fe0000000000a8e),
+    ];
+    let curve = line(&[a, b]);
+    let old = t.map(|t| curve.original_seed_c(t)[1]);
+    let pinned = t.map(|t| curve.height_pinned_point_c([0., 1.], t).unwrap()[1]);
+    assert!(b < a && t[0] < t[1]);
+    assert!(
+        old[1] > old[0],
+        "the old convex-combination evaluation reverses one ulp"
+    );
+    assert!(
+        pinned[1] <= pinned[0],
+        "the fixed-difference chart retains non-strict order"
+    );
+}
