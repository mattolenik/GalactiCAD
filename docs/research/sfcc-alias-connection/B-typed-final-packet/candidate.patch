+    .unwrap();
+    assert_eq!(budget.charged_queries() - before, 2);
+    assert_eq!(
+        admit(
+            f,
+            &cert,
+            &mut budget,
+            &context.lat,
+            (0, key, len),
+            &r,
+            plane,
+            &live
+        )
+        .unwrap_err(),
+        "unsupported_face_axis"
+    );
+    assert_eq!(
+        admit(
+            f,
+            &cert,
+            &mut budget,
+            &context.lat,
+            (1, key + 1, len),
+            &r,
+            plane,
+            &live
+        )
+        .unwrap_err(),
+        "typed_face_identity"
+    );
+    assert_eq!(
