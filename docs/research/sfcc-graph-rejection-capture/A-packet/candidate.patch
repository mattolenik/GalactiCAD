+#[cfg(test)]
+pub(crate) fn with_test_diagnostic<T>(operation:impl FnOnce()->T)->(T,Value) {
+    struct Reset;
+    impl Drop for Reset {fn drop(&mut self){super::DIAGNOSTIC.with(|s|{s.borrow_mut().take();});}}
+    assert!(super::DIAGNOSTIC.with(|s|s.borrow().is_none()));
+    super::DIAGNOSTIC.with(|s|*s.borrow_mut()=Some(json!({"activePrivateCell":[7,36,79,29]})));
+    let _reset=Reset;
+    let result=operation();
+    let report=super::DIAGNOSTIC.with(|s|s.borrow_mut().take().unwrap());
+    (result,report)
+}
