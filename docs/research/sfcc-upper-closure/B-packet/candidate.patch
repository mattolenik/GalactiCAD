+    // fast path does not answer a different question than sampled trimming.
+    let traced = make_traced_curve(
+        0,
+        [a, b],
+        vec![0., 0., -1., 0., 0., 0., 0., 0., 1.],
+        false,
+        view.strata[a].clone(),
+        view.strata[b].clone(),
