+        json!({"axis":axis,"key":key,"length":len,"latticeMinimum":g,"coordinateBits":coordinate.to_bits(),"pins":pins,"segments":r.segments.iter().map(|s|[s.a,s.b]).collect::<Vec<_>>(),"consumers":consumers.get(&(axis,key,len)),"consumedForward":r.consumed_fwd,"consumedReverse":r.consumed_rev})
