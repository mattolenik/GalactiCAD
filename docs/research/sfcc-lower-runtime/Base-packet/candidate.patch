+#[test]
+fn lower_c_query_cost_preserves_cache_request_and_total_caps() {
+    let (f, ids) = fixture();
+    let mut solver = Transport::bind(&f, ids, 0.02).unwrap();
+    let before = solver.total;
+    let own = solver.own(ids[0], solver.knots[0][0]).unwrap();
+    assert_eq!(solver.total, before);
+    assert_eq!(solver.cost.cache_hits, 1);
+    assert_eq!(solver.cost.consume_attempts, before);
+    let t = f.curves[ids[0]].t_min + 0.25;
+    let mut request = 0;
+    for i in 0..MAX_REQUEST {
+        solver
+            .query(ids[0], t + i as f64 * 1e-6, &mut request)
+            .unwrap();
+    }
+    assert_eq!(request, MAX_REQUEST);
+    assert!(matches!(
+        solver.query(ids[0], t + 0.001, &mut request),
+        Err(Failure::RequestCap)
+    ));
+    assert_eq!(solver.cost.request_cap_refusals, 1);
+    assert_eq!(solver.maximum_request, MAX_REQUEST);
+    // The real reservation API fills the unchanged ledger; no synthetic counter preload.
+    let remainder = MAX_TOTAL - solver.total;
+    solver.reserve_external(remainder).unwrap();
+    assert!(matches!(
+        solver.query(ids[0], t + 0.001, &mut 0),
+        Err(Failure::TotalCap)
+    ));
+    assert!(matches!(solver.reserve_external(1), Err(Failure::TotalCap)));
+    assert_eq!(solver.total, MAX_TOTAL);
+    assert_eq!(solver.cost.external_reserved, remainder);
+    assert_eq!(solver.cost.total_cap_refusals, 2);
+    assert_eq!(
+        solver.total,
+        solver.cost.consume_attempts + solver.cost.external_reserved
+    );
+    assert_eq!(
+        solver.cache.len(),
+        solver.cost.consume_attempts - solver.cost.consume_failures
+    );
+    // Cached authority remains usable at the cap, exactly as before instrumentation.
+    assert_eq!(
+        solver
+            .own(own.chart(), own.parameter())
+            .unwrap()
+            .point()
+            .map(f64::to_bits),
+        own.point().map(f64::to_bits)
+    );
+    assert_eq!(solver.total, MAX_TOTAL);
+}
