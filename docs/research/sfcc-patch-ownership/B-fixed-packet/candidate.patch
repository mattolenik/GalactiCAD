+fn same_key(candidate: &PointTable, outside: &PointTable, p: usize) -> Result<Option<usize>> {
+    let found = match outside.key_at(p) {
+        PointKey::Num(k) => candidate.lookup(*k),
+        PointKey::Str(k) => candidate.lookup_str(k),
+        PointKey::Unkeyed => None,
+    };
+    if found.is_some_and(|c| {
+        q::pos(candidate, c).map(f64::to_bits) != q::pos(outside, p).map(f64::to_bits)
+    }) {
+        return Err("outside_candidate_same_key_different_position");
+    }
+    Ok(found)
+}
+fn join(
+    candidate: &PointTable,
+    inside: &[usize],
+    outside: &PointTable,
+    tris: &[usize],
+) -> Result<Value> {
+    if candidate.count() > 4096
+        || outside.count() > 4096
+        || inside.len() % 3 != 0
+        || tris.len() % 3 != 0
+        || inside.len() + tris.len() > 3 * 4096
+    {
+        return Err("outside_join_geometry_cap");
+    }
+    let mut positions: Vec<_> = (0..candidate.count())
+        .map(|p| q::pos(candidate, p))
+        .collect();
+    let mut mapping = Vec::with_capacity(outside.count());
+    for p in 0..outside.count() {
+        if let Some(c) = same_key(candidate, outside, p)? {
+            mapping.push(c);
+        } else {
+            if positions.len() >= 4096 {
+                return Err("outside_join_vertex_cap");
+            }
+            mapping.push(positions.len());
+            positions.push(q::pos(outside, p));
+        }
+    }
+    let mut indices = [GrowingIndex::new(), GrowingIndex::new()];
+    for t in inside.chunks_exact(3) {
+        if t.iter().any(|&p| p >= candidate.count()) {
+            return Err("outside_candidate_indices");
+        }
+        let ids = [t[0], t[1], t[2]];
+        let p = ids.map(|i| positions[i]);
+        indices[0].extend([(ids, p)]);
+        indices[1].extend([(ids, p.map(q::rounded))]);
+    }
+    let mut joined = inside.to_vec();
+    let mut conflicts = [Vec::new(), Vec::new()];
+    for (i, t) in tris.chunks_exact(3).enumerate() {
+        if t.iter().any(|&p| p >= outside.count()) {
+            return Err("outside_triangle_indices");
+        }
+        let ids = [mapping[t[0]], mapping[t[1]], mapping[t[2]]];
+        let p = ids.map(|i| positions[i]);
+        for (precision, coords) in [p, p.map(q::rounded)].into_iter().enumerate() {
+            if indices[precision].conflicts(ids, coords) {
+                conflicts[precision].push(i);
+            }
+        }
+        joined.extend(ids);
+    }
+    let combined = topology(&joined, positions.len())?;
+    Ok(
+        json!({"scope":"candidate against one actual original-stage outside consumer; no unmeshed outside exclusion",
+        "outsideToJoined":mapping,"candidateTriangleCount":inside.len()/3,"outsideTriangleCount":tris.len()/3,
+        "contactingOutsideTrianglesWorkingOrExported":conflicts[0],"contactingOutsideTrianglesRoundedBroadphase":conflicts[1],
+        "partialJoinedTopology":combined,"partialJoinedLinkFailureMayNeedOtherOutsideConsumers":true,
+        "completeOutsideContactAudit":false,"publicationReady":false}),
+    )
+}
