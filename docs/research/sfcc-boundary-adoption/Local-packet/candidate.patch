+pub(super) fn probe(
+    tree: &CsgNode,
+    features: &SfccFeatureSet,
+    oct: &SfccOctree,
+    faces: &[HashMap<i64, FaceRecord>; 3],
+    live: &PointTable,
+    opts: &CellMeshOptions,
+    candidate: &PrivateCandidate,
+    outside: &Value,
+) -> Value {
+    let mut receipt = json!({"scope":"all discrete incident consumers of two specified feature endpoints, original stage; source and boundary transport remain separate obligations",
+        "sourceFingerprint":features.fingerprint().to_string(),"publicationAuthorized":false,
+        "continuousSourceOwnershipProved":false,"idealTargetAdoptionProved":false,"complete":false});
+    if let Err(reason) = bind(
+        tree,
+        features,
+        oct,
+        faces,
+        live,
+        opts,
+        candidate,
+        outside,
+        &mut receipt,
+    ) {
+        receipt["refusal"] = json!(reason);
+    }
+    receipt
+}
+fn bind(
+    tree: &CsgNode,
+    features: &SfccFeatureSet,
+    oct: &SfccOctree,
+    faces: &[HashMap<i64, FaceRecord>; 3],
+    live: &PointTable,
+    opts: &CellMeshOptions,
+    candidate: &PrivateCandidate,
+    outside: &Value,
+    receipt: &mut Value,
+) -> Result<()> {
+    let inside = &outside["insideTargetFanCaptureB"];
+    if inside["complete"] != true || outside["secondSegmentB"]["complete"] != true {
+        return Err("incident_original_pair_binding");
+    }
+    let inside_cell: [i64; 4] = array(&inside["cell"])?;
+    let outside_cell: [i64; 4] = array(&outside["cell"])?;
+    let endpoint = candidate
+        .points
+        .lookup_str("corner:13")
+        .ok_or("incident_corner_key")?;
+    if endpoint != 647 {
+        return Err("incident_corner_witness");
+    }
+    let corner = features.corners.get(13).ok_or("incident_corner_source")?;
+    let p = q::pos(&candidate.points, endpoint);
+    if corner.id != 13 || [corner.x, corner.y, corner.z].map(f64::to_bits) != p.map(f64::to_bits) {
+        return Err("incident_corner_source_point");
+    }
+    let containing: Vec<_> = oct
+        .leaves
+        .iter()
+        .filter(|cell| {
+            let b = cell_aabb(&oct.lat, cell.level, cell.ix, cell.iy, cell.iz);
+            (0..3).all(|k| p[k] >= b[k] && p[k] <= b[k + 3])
+        })
+        .collect();
+    if containing.len() != 1 || id(containing[0]) != inside_cell {
+        return Err("incident_corner_leaf_closure");
+    }
+    let inside_fans = inside["pairedFans"]
+        .as_array()
+        .ok_or("incident_inside_fans")?;
+    let mut patches = inside_fans.clone();
+    let inside_triangles: Vec<usize> = patches
+        .iter()
+        .map(|f| array::<Vec<usize>>(&f["triangles"]))
+        .collect::<Result<Vec<_>>>()?
+        .into_iter()
+        .flatten()
+        .collect();
+    for fan in &patches {
+        require_final_fan(fan, &candidate.triangles, &candidate.points)?;
+        require_fan_source(fan, features)?;
+    }
+    let actual_corner: Vec<_> = candidate
+        .triangles
+        .chunks_exact(3)
+        .filter(|t| t.contains(&endpoint))
+        .map(|t| t.to_vec())
+        .collect();
+    let captured_corner: Vec<_> = inside_triangles
+        .chunks_exact(3)
+        .filter(|t| t.contains(&endpoint))
+        .map(|t| t.to_vec())
+        .collect();
+    if actual_corner.is_empty() || actual_corner != captured_corner {
+        return Err("incident_corner_triangle_closure");
+    }
+    receipt["corner647"] = json!({"point":endpoint,"sourceCorner":13,"positionBits":p.map(f64::to_bits),
+        "closedBoxConsumerCells":containing.iter().map(|c|id(c)).collect::<Vec<_>>(),"incidentTriangles":actual_corner,
+        "completeCandidateTriangleStarBound":true,"cellPatchCount":patches.len(),"cellTriangleCount":inside_triangles.len()/3});
+    let mapping: Vec<usize> = array(&outside["joined"]["outsideToJoined"])?;
+    let local = mapping
+        .iter()
+        .position(|&p| p == 1116)
+        .ok_or("incident_outer_endpoint_mapping")?;
+    if mapping.iter().filter(|&&p| p == 1116).count() != 1 {
+        return Err("incident_outer_endpoint_ambiguous");
+    }
+    let bindings: Vec<[usize; 2]> = array(&outside["pointBindings"])?;
+    let globals: Vec<_> = bindings
+        .iter()
+        .filter(|b| b[1] == local)
+        .map(|b| b[0])
+        .collect();
+    if globals.len() != 1 || globals[0] >= live.count() {
+        return Err("incident_outer_global_binding");
+    }
+    let global = globals[0];
+    let rows = outside["points"]
+        .as_array()
+        .ok_or("incident_outer_points")?;
+    if rows
+        .get(local)
+        .is_none_or(|r| r["positionBits"] != json!(q::pos(live, global).map(f64::to_bits)))
+    {
+        return Err("incident_outer_point_bits");
+    }
+    let mut incident_faces = BTreeSet::new();
+    let mut face_rows = Vec::new();
+    for axis in 0..3 {
+        for (&key, record) in &faces[axis] {
+            if record
+                .segments
+                .iter()
+                .any(|s| s.a == global || s.b == global)
+                || record.pins.iter().any(|p| p.point_id == global)
+            {
+                if record.axis != axis
+                    || record.key != key
+                    || record.len <= 0
+                    || incident_faces.len() >= 24
+                {
+                    return Err("incident_face_identity_or_cap");
+                }
+                let face = (axis, key, record.len);
+                incident_faces.insert(face);
+                let pins: Vec<_> = record
+                    .pins
+                    .iter()
+                    .filter(|p| p.point_id == global)
+                    .collect();
+                if pins.len() != 1 || pins[0].curve_id != 49 {
+                    return Err("incident_original_pin_source");
+                }
+                let pin = pins[0];
+                let curve = features
+                    .curves
+                    .get(pin.curve_id)
+                    .ok_or("incident_pin_chart")?;
+                if !pin.t.is_finite()
+                    || pin.t < curve.t_min
+                    || pin.t > curve.t_max
+                    || !matches!(live.key_at(global),PointKey::Str(k) if k==&format!("F{}:{}:{}:{:.12}",axis,key,pin.curve_id,pin.t))
+                {
+                    return Err("incident_original_pin_parameter");
+                }
+                face_rows.push(json!({"face":face,"segments":record.segments.iter().map(|s|[s.a,s.b]).collect::<Vec<_>>(),
+                "pin":{"globalPoint":global,"chart":pin.curve_id,"parameterBits":pin.t.to_bits(),"strata":curve.adjacent_strata,
+                "sourceIdentities":curve.adjacent_strata.map(|sid|features.strata[sid].graph_capture_identity_b())}}));
+            }
+        }
+    }
+    if incident_faces.is_empty() {
+        return Err("incident_original_face_missing");
+    }
+    let selected: BTreeSet<_> = candidate.receipt.consumers.iter().copied().collect();
+    let mut consumers = BTreeMap::new();
+    for cell in &oct.leaves {
+        for face in cell_faces(oct, faces, cell)
+            .into_iter()
+            .filter(|f| incident_faces.contains(f))
+        {
+            consumers
+                .entry(face)
+                .or_insert_with(Vec::new)
+                .push((id(cell), cell_side(oct, cell, face)?));
+        }
+    }
+    let mut new_cells = BTreeSet::new();
+    for face in &incident_faces {
+        let entries = consumers
+            .get(face)
+            .ok_or("incident_face_without_consumer")?;
+        if entries.len() != 2
+            || entries[0].1 == entries[1].1
+            || !entries.iter().any(|e| e.0 == outside_cell)
+        {
+            return Err("incident_opposite_consumer_inventory");
+        }
+        for (cell, _) in entries {
+            if *cell != outside_cell {
+                new_cells.insert(*cell);
+            }
+        }
+    }
+    receipt["endpoint1116"] = json!({"joinedPoint":1116,"outsideLocalPoint":local,"globalPoint":global,"positionBits":q::pos(live,global).map(f64::to_bits),
+        "faces":face_rows,"consumers":consumers.iter().map(|(face,c)|json!({"face":face,"cellsAndSides":c})).collect::<Vec<_>>(),
+        "newConsumerCells":new_cells,"allOriginalFaceRecordsAndLeavesExamined":true});
+    if new_cells.len() != 1 || new_cells.iter().any(|c| selected.contains(c)) {
+        return Err("incident_requires_one_uncaptured_original_consumer");
+    }
+    if selected.len() + 1 + new_cells.len() > 256 {
+        return Err("incident_combined_cell_cap");
+    }
+    let expanded: BTreeSet<_> = selected
+        .iter()
+        .copied()
+        .chain([outside_cell])
+        .chain(new_cells.iter().copied())
+        .collect();
+    let mut required_faces = BTreeSet::new();
+    for cell in &oct.leaves {
+        if expanded.contains(&id(cell)) {
+            required_faces.extend(cell_faces(oct, faces, cell));
+            if required_faces.len() > 1536 {
+                return Err("incident_combined_face_cap");
+            }
+        }
+    }
+    let outer_position = q::pos(live, global);
+    let point_consumers: BTreeSet<_> = oct
+        .leaves
+        .iter()
+        .filter(|cell| {
+            let b = cell_aabb(&oct.lat, cell.level, cell.ix, cell.iy, cell.iz);
+            (0..3).all(|k| outer_position[k] >= b[k] && outer_position[k] <= b[k + 3])
+        })
+        .map(id)
+        .collect();
+    if same_key(&candidate.points, live, global)?.is_some() {
+        return Err("incident_outer_point_already_in_candidate");
+    }
+    let primary = selected_pair_c(features).map_err(|_| "incident_source_pair")?;
+    let allowance = crate::sfcc::shared_arc_plan::numerical(
+        features,
+        primary[0],
+        primary[1],
+        opts.curve_chord_tol,
+    )
+    .ok_or("incident_original_allowance")?;
+    let mut defects = Vec::new();
+    for (&face, entries) in &consumers {
+        // The original record, exact integer leaf-side plane, and extents were bound above.
+        let owners = owned_consumers(entries, outside_cell, &point_consumers)?;
+        let low = unpack_point(&oct.lat, face.1);
+        let mut high = low;
+        if crate::math::grid::pack_point(&oct.lat, low[0], low[1], low[2]) != face.1
+            || low.iter().any(|&v| v < 0 || v > oct.lat.res)
+        {
+            return Err("incident_face_lattice_extent");
+        }
+        for k in 0..3 {
+            if k != face.0 {
+                high[k] = low[k]
+                    .checked_add(face.2)
+                    .ok_or("incident_face_lattice_extent")?;
+                if high[k] > oct.lat.res {
+                    return Err("incident_face_lattice_extent");
+                }
+            }
+        }
+        let rect =
+            [low, high].map(|g| crate::math::grid::point_to_world(&oct.lat, g[0], g[1], g[2]));
+        let defect = retained_face_defect(face.0, rect, outer_position, allowance)?;
+        defects.push(
+            json!({"face":face,"exactRecordConsumerCells":owners,"retainedPointDefect":defect}),
+        );
+    }
+    receipt["endpoint1116"]["rawClosedBoxConsumerCells"] = json!(point_consumers);
+    receipt["endpoint1116"]["faceOwnershipAndRetainedDefect"] = json!(defects);
+    receipt["endpoint1116"]["discreteOwnershipBasis"] = json!("original FaceRecord incidence, exact integer plane and leaf-side extents; raw boxes only exclude unrepresented owners");
+    receipt["endpoint1116"]["idealTargetFaceMembershipProved"] = json!(false);
+    receipt["expandedComponentCells"] = json!(expanded.len());
+    receipt["expandedComponentFaces"] = json!(required_faces.len());
+    let mut keys = BTreeMap::<String, usize>::new();
+    let mut point_bits = BTreeMap::<usize, [u64; 3]>::new();
+    for p in 0..candidate.points.count() {
+        point_bits.insert(p, q::pos(&candidate.points, p).map(f64::to_bits));
+        if !matches!(candidate.points.key_at(p), PointKey::Unkeyed) {
+            keys.insert(format!("{:?}", candidate.points.key_at(p)), p);
+        }
+    }
+    for row in rows {
+        let local: usize = array(&row["id"])?;
+        let id = *mapping.get(local).ok_or("incident_outer_mapping")?;
+        let bits = array(&row["positionBits"])?;
+        if point_bits.insert(id, bits).is_some_and(|old| old != bits) {
+            return Err("incident_outer_join_bits");
+        }
+        let key = row["key"].as_str().ok_or("incident_outer_key")?;
+        if key != "Unkeyed" && keys.insert(key.to_owned(), id).is_some_and(|old| old != id) {
+            return Err("incident_outer_join_key");
+        }
+    }
+    let start = patches.len();
+    for fan in emitted_fans(outside)? {
+        require_fan_source(&fan, features)?;
+        patches.push(joined_fan(&fan, &mapping)?);
+    }
+    let outside_triangles: Vec<usize> = array::<Vec<usize>>(&outside["triangles"])?
+        .into_iter()
+        .map(|i| mapping[i])
+        .collect();
+    let mut cells = vec![
+        json!({"cell":inside_cell,"triangles":inside_triangles,"patchIndices":(0..start).collect::<Vec<_>>()}),
+        json!({"cell":outside_cell,"triangles":outside_triangles,"patchIndices":(start..patches.len()).collect::<Vec<_>>()}),
+    ];
+    let new_id = *new_cells.iter().next().ok_or("incident_new_consumer")?;
+    let cell = oct
+        .leaves
+        .iter()
+        .find(|c| id(c) == new_id)
+        .ok_or("incident_new_leaf")?;
+    let saved = SavedDiagnostic::begin();
+    let outcome = replay_cell(
+        tree,
+        features,
+        oct,
+        faces,
+        live,
+        opts,
+        candidate,
+        cell,
+        &incident_faces,
+        json!({"selectionRule":"unique actual opposite consumer of the endpoint's original face records","cellCap":256}),
+        None,
+        None,
+        true,
+    );
+    let evidence = private_arc_a::DIAGNOSTIC
+        .with(|s| s.borrow_mut().take())
+        .unwrap_or(Value::Null);
+    drop(saved);
+    let mut replay = match outcome {
+        Ok(v) => v,
+        Err(reason) => json!({"refusal":reason}),
+    };
+    replay["queryAndGraphEvidence"] = evidence;
+    replay["queryBudgetScope"]=json!("separate observational ledger, unchanged 16384 total / 2048 reservation; not pooled with either previous ledger");
+    receipt["newConsumerReplay"] = replay.clone();
+    let fans = emitted_fans(&replay)?;
+    let mut next = point_bits.keys().next_back().copied().unwrap_or(0) + 1;
+    let mut remap = Vec::new();
+    for row in replay["points"].as_array().ok_or("incident_new_points")? {
+        if row["id"].as_u64() != Some(remap.len() as u64) {
+            return Err("incident_new_point_order");
+        }
+        let key = row["key"].as_str().ok_or("incident_new_key")?;
+        let bits: [u64; 3] = array(&row["positionBits"])?;
+        let id = if key != "Unkeyed" {
+            keys.get(key).copied()
+        } else {
+            None
+        };
+        let id = match id {
+            Some(id) => {
+                if point_bits.get(&id) != Some(&bits) {
+                    return Err("incident_new_key_position_mismatch");
+                }
+                id
+            }
+            None => {
+                let id = next;
+                next += 1;
+                point_bits.insert(id, bits);
+                if key != "Unkeyed" {
+                    keys.insert(key.to_owned(), id);
+                }
+                id
+            }
+        };
+        if point_bits.len() > 4096 {
+            return Err("incident_joined_vertex_cap");
+        }
+        remap.push(id);
+    }
+    let start = patches.len();
+    for fan in fans {
+        require_fan_source(&fan, features)?;
+        patches.push(joined_fan(&fan, &remap)?);
+    }
+    let triangles: Vec<usize> = array::<Vec<usize>>(&replay["triangles"])?
+        .into_iter()
+        .map(|i| remap[i])
+        .collect();
+    cells.push(json!({"cell":new_id,"triangles":triangles,"patchIndices":(start..patches.len()).collect::<Vec<_>>(),"localToJoined":remap}));
+    let triangle_count: usize = cells
+        .iter()
+        .map(|c| c["triangles"].as_array().map_or(0, |v| v.len() / 3))
+        .sum();
+    if triangle_count > 4096
+        || candidate.triangles.len() / 3 + outside_triangles.len() / 3 + triangles.len() / 3 > 4096
+    {
+        return Err("incident_joined_triangle_cap");
+    }
+    let used: BTreeSet<_> = patches
+        .iter()
+        .flat_map(|p| {
+            p["triangles"]
+                .as_array()
+                .into_iter()
+                .flatten()
+                .filter_map(Value::as_u64)
+        })
+        .map(|p| p as usize)
+        .collect();
+    receipt["points"] = json!(used
+        .iter()
+        .map(|id| json!({"id":id,"positionBits":point_bits[id]}))
+        .collect::<Vec<_>>());
+    receipt["patches"] = json!(patches);
+    receipt["cells"] = json!(cells);
+    receipt["triangleCount"] = json!(triangle_count);
+    receipt["cylinderSource"] = outside["pairedCandidateFanA"]["sourceIdentity"].clone();
+    receipt["surfaceTolerance"] = json!(opts.surface_tol);
+    receipt["commonEndpoint"] = json!(40);
+    receipt["sharedSegments"] = json!([[40, 38], [39, 40]]);
+    receipt["complete"] = json!(true);
+    Ok(())
+}
