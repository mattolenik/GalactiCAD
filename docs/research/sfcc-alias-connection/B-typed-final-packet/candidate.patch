+fn alias_a_whole_ideal_interval_and_checked_consumed_events() {
+    let (root, f, source, charts, ranges, rho_min, eps) = fixture();
+    let cert = bind(&root, &f, source, charts, ranges, rho_min, eps).unwrap_or_else(|| {
