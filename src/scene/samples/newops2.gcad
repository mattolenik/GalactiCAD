// New Operators Demo 2
// Demonstrates shell, offset, elongate, twist, bend, taper, morph, and seam

// === SHELL ===
// Hollow out a sphere into a thin shell
let shellSphere = shell(0.3, sphere([0, 0, 10], { r: 5 }))

// Shell of a box - creates a hollow cube
let shellBox = shell(0.3, box([15, 0, 10], [4, 4, 4]))

// === OFFSET ===
// Offset a box to round all its edges
let roundedBox = offset(0.5, box([30, 0, 10], [3.5, 3.5, 3.5]))

// Negative offset - shrink a sphere
let shrunkSphere = offset(-1, sphere([45, 0, 10], { r: 5 }))

// === ELONGATE ===
// Elongate a sphere along Y to make a capsule-like shape
let elongatedSphere = elongate([0, 4, 0], sphere([0, 20, 10], { r: 3 }))

// Elongate a box along X
let elongatedBox = elongate([5, 0, 0], box([20, 20, 10], [2, 3, 3]))

// === TWIST ===
// Twist a box around the Y axis
let twistedBox = twist(0.4, box([40, 20, 10], [3, 8, 3]))

// === BEND ===
// Bend a tall box into an arch
let bentBox = bend(0.1, box([0, -20, 10], [8, 3, 3]))

// === TAPER ===
// Taper a cylinder: wide at bottom, narrow at top
let taperedCyl = taper(0.3, 10, cylinder([20, -20, 5], { r: 4, h: 5 }))

// Taper a box: creates a truncated pyramid
let taperedBox = taper(0.5, 8, box([35, -20, 4], [4, 4, 4]))

// === MORPH ===
// Morph 25% between sphere and box (mostly sphere)
let morph25 = morph(0.25,
    sphere([-20, -20, 10], { r: 5 }),
    box([-20, -20, 10], [4, 4, 4])
)

// Morph 75% between sphere and box (mostly box)
let morph75 = morph(0.75,
    sphere([-35, -20, 10], { r: 5 }),
    box([-35, -20, 10], [4, 4, 4])
)

// === SEAM ===
// Weld bead at the junction of two shapes
let seamDemo = seam(
    sphere([-20, 0, 10], { r: 4 }),
    box([-20, 0, 10], [3, 3, 6]),
    0.5
)

// Seam between two spheres
let seamSpheres = seam(
    sphere([-35, 0, 7], { r: 4 }),
    sphere([-35, 0, 13], { r: 4 }),
    0.4
)

// === ASSEMBLY ===
return union(
    shellSphere, shellBox,
    roundedBox, shrunkSphere,
    elongatedSphere, elongatedBox,
    twistedBox,
    bentBox,
    taperedCyl, taperedBox,
    morph25, morph75,
    seamDemo, seamSpheres
)
