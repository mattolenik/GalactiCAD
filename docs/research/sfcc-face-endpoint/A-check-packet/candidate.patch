+}
+#[test]
+fn feature49_a_actual_endpoint_source_and_query_obligations() {
+    use crate::sfcc::shared_twisted_proof::correlated_c::transport_a::Transport;
+    let _guard = crate::sfcc::validation::NumericalGuard::new();
+    let (f, saved, input, lat) = fixture();
+    let pins = saved["originalTarget"]["originalPins"].as_array().unwrap();
+    assert_eq!(pins.len(), 1);
+    let pin = &pins[0];
+    let chart = pin["chart"].as_u64().unwrap() as usize;
+    let id = pin["candidatePoint"].as_u64().unwrap() as usize;
+    let t = f64::from_bits(pin["parameterBits"].as_u64().unwrap());
+    let curve = &f.curves[chart];
+    assert_eq!(
+        curve.adjacent_strata,
+        serde_json::from_value::<[usize; 2]>(pin["strata"].clone()).unwrap()
+    );
+    assert_eq!(
+        [curve.t_min.to_bits(), curve.t_max.to_bits()],
+        serde_json::from_value::<[u64; 2]>(pin["rangeBits"].clone()).unwrap()
+    );
+    let row = saved["points"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .find(|r| r["id"].as_u64() == Some(id as u64))
+        .unwrap();
+    let point: [f64; 3] =
+        std::array::from_fn(|k| f64::from_bits(row["positionBits"][k].as_u64().unwrap()));
+    let face: [i64; 3] = serde_json::from_value(saved["face"].clone()).unwrap();
+    assert_eq!(face[0], 0);
+    assert_eq!(face[2], 2);
+    let grid = crate::math::grid::unpack_point(&lat, face[1]);
+    let plane = crate::math::grid::point_to_world(&lat, grid[0], grid[1], grid[2])[0];
+    assert!(t.is_finite() && t >= curve.t_min && t <= curve.t_max);
+    let primary = crate::sfcc::stage4_source_preflight_c::selected_pair_c(&f).unwrap();
+    let tolerance = input["tuning"]["curveChordTolMm"]
+        .as_f64()
+        .expect("original chord tolerance");
+    let mut budget = Transport::bind(&f, primary, tolerance).unwrap();
+    let before = budget.charged_queries();
+    budget.phase("feature49_endpoint_own_query");
+    budget.reserve_external(1).unwrap();
+    budget.external_direct_attempt();
+    let own = curve
+        .point_at_checked(t)
+        .expect("original numerical own query");
+    assert_eq!(own.map(f64::to_bits), point.map(f64::to_bits));
+    let (_, _, refine) = curve.traced_carriers().unwrap();
+    let result = endpoint_geometry(&f, chart, point, plane);
+    if result.is_none() {
+        if let Ok(path) = std::env::var("SFCC_FEATURE49_A_RECEIPT") {
+            std::fs::write(path,serde_json::to_vec_pretty(&json!({"refusal":"source endpoint geometry","sourceBindSucceeded":Source::bind(&f,chart).is_some(),"chart":chart,"parameterBits":t.to_bits(),"pointBits":point.map(f64::to_bits),"facePlaneBits":plane.to_bits()})).unwrap()).unwrap();
+        }
+    }
+    let mut proof = result.expect("source endpoint geometry");
+    let candidate: [f64; 3] = serde_json::from_value(proof["candidate"].clone()).unwrap();
+    let physical: [[f64; 3]; 2] =
+        serde_json::from_value(proof["physicalFaceFeature"]["image"].clone()).unwrap();
+    let generated: [[f64; 3]; 2] =
+        serde_json::from_value(proof["generatedFaceCarrierFeature"]["image"].clone()).unwrap();
+    let make = |p: [[f64; 3]; 2]| -> Image {
+        std::array::from_fn(|k| interval(p[0][k], p[1][k]).unwrap())
+    };
+    let mut lo = t.floor().max(curve.t_min);
+    let hi = (lo + 1.).min(curve.t_max);
+    if lo == hi {
+        lo = (hi - 1.).max(curve.t_min);
+    }
+    let tube = curve.projection_tube(lo, hi).unwrap();
+    let residuals = |p: [f64; 3]| -> Vec<Value> {
+        curve.adjacent_strata.iter().map(|&sid|{
+        let s=&f.strata[sid];let v=s.raw_field(p[0],p[1],p[2]).normalized_equation().unwrap();
+        json!({"stratum":sid,"normalizedResidual":v.value,"strictResidualPass":v.value.is_finite()&&v.value.abs()<=refine.curve_eps,
+            "strictDomainPass":s.domain_contains(p,refine.curve_eps)||curve.upper_source_member(&f.strata,sid,t,p,refine.curve_eps)})
+    }).collect()
+    };
+    let candidate_checks = residuals(candidate);
+    let own_checks = residuals(own);
+    let allowance = budget.allowance().min(8. * refine.curve_eps);
+    let own_physical = distance(own.map(I::point), make(physical)).unwrap()[1];
+    let own_generated = distance(own.map(I::point), make(generated)).unwrap()[1];
+    let direct = distance(candidate.map(I::point), own.map(I::point)).unwrap()[1];
+    let mut upper_grid = grid;
+    upper_grid[1] += face[2];
+    upper_grid[2] += face[2];
+    let low_face = crate::math::grid::point_to_world(&lat, grid[0], grid[1], grid[2]);
+    let high_face =
+        crate::math::grid::point_to_world(&lat, upper_grid[0], upper_grid[1], upper_grid[2]);
+    let face_contains =
+        |image: Image| (1..3).all(|k| image[k].lo > low_face[k] && image[k].hi < high_face[k]);
+    let admitted = own_physical <= allowance
+        && own_generated <= allowance
+        && direct <= allowance
+        && face_contains(make(physical))
+        && face_contains(make(generated))
+        && contains(tube, make(physical))
+        && contains(tube, make(generated))
+        && contains(tube, candidate.map(I::point))
+        && candidate_checks
+            .iter()
+            .all(|r| r["strictResidualPass"] == true && r["strictDomainPass"] == true);
+    proof["numericalAssociation"] = json!({"originalParameterBits":t.to_bits(),"originalPointBits":point.map(f64::to_bits),"ownQueryBits":own.map(f64::to_bits),
+        "ownStrictCarrierChecks":own_checks,"candidateStrictCarrierChecks":candidate_checks,"strictCarrierResidualLimit":refine.curve_eps,
+        "primaryAssociationAllowance":budget.allowance(),"curve49FaceAllowance":8.*refine.curve_eps,"retainedAssociationAllowance":allowance,
+        "ownToPhysicalFeatureUpper":own_physical,"ownToGeneratedFeatureUpper":own_generated,"candidateToOwnUpper":direct,
+        "originalFace":face,"originalFaceRectangle":[low_face,high_face],"physicalFeatureImageStrictlyInFace":face_contains(make(physical)),"generatedFeatureImageStrictlyInFace":face_contains(make(generated)),
