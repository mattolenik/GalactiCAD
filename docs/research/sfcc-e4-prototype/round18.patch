+//! Frozen independent pre-cache decision path and bounded differential controls.
+use super::*;
+fn frozen_between(a: [f64; 2], b: [f64; 2], p: [f64; 2]) -> bool {
+    orient2d(a, b, p) == 0 && (0..2).all(|k| p[k] >= a[k].min(b[k]) && p[k] <= a[k].max(b[k]))
+}
+fn frozen_coplanar(a: [P3; 3], b: [P3; 3], ia: [usize; 3], ib: [usize; 3]) -> bool {
+    let n = q::normal(a);
+    let axis = (0..3)
+        .max_by(|&i, &j| n[i].abs().total_cmp(&n[j].abs()))
+        .unwrap();
+    let flat = |p: P3| [p[(axis + 1) % 3], p[(axis + 2) % 3]];
+    let a = a.map(flat);
+    let b = b.map(flat);
+    for k in 0..3 {
+        for l in 0..3 {
+            let (i, j) = (k, (k + 1) % 3);
+            let (u, v) = (l, (l + 1) % 3);
+            let s = [
+                orient2d(a[i], a[j], b[u]),
+                orient2d(a[i], a[j], b[v]),
+                orient2d(b[u], b[v], a[i]),
+                orient2d(b[u], b[v], a[j]),
+            ];
+            if s[0] * s[1] < 0 && s[2] * s[3] < 0 {
+                return true;
+            }
+            // A contact is legal only at the same topological vertex. This catches
+            // T-junctions and coincident but separately indexed sheets too.
+            for (p, id) in [(b[u], ib[u]), (b[v], ib[v])] {
+                if frozen_between(a[i], a[j], p) && id != ia[i] && id != ia[j] {
+                    return true;
+                }
+            }
+            for (p, id) in [(a[i], ia[i]), (a[j], ia[j])] {
+                if frozen_between(b[u], b[v], p) && id != ib[u] && id != ib[v] {
+                    return true;
+                }
+            }
+        }
+    }
+    for (x, y) in [(a, b), (b, a)] {
+        for p in x {
+            let s = [
+                orient2d(y[0], y[1], p),
+                orient2d(y[1], y[2], p),
+                orient2d(y[2], y[0], p),
+            ];
+            if s.iter().all(|&s| s > 0) || s.iter().all(|&s| s < 0) {
+                return true;
+            }
+        }
+    }
+    // Identical triangles have no strictly interior vertex or crossing edge.
+    ia.iter().all(|v| ib.contains(v))
+}
+fn frozen_edge_hits(a: P3, b: P3, t: [P3; 3], sa: i8, sb: i8) -> bool {
+    if sa != 0 && sa == sb {
+        return false;
+    }
+    let s = [
+        orient3d(a, b, t[0], t[1]),
+        orient3d(a, b, t[1], t[2]),
+        orient3d(a, b, t[2], t[0]),
+    ];
+    s.iter().all(|&v| v >= 0) || s.iter().all(|&v| v <= 0)
+}
+fn frozen_intersects(a: [P3; 3], b: [P3; 3], ia: [usize; 3], ib: [usize; 3]) -> bool {
+    if !a.iter().chain(b.iter()).flatten().all(|v| v.is_finite()) {
+        return true;
+    }
+    if !overlap(bounds(a), bounds(b)) {
+        return false;
+    }
+    let sa = b.map(|p| orient3d(a[0], a[1], a[2], p));
+    if sa.iter().all(|&v| v > 0) || sa.iter().all(|&v| v < 0) {
+        return false;
+    }
+    if sa == [0; 3] {
+        return frozen_coplanar(a, b, ia, ib);
+    }
+    for (direction, (x, y, ix, iy)) in [(a, b, ia, ib), (b, a, ib, ia)].into_iter().enumerate() {
+        let sides = if direction == 1 { sa } else { a.map(|p| orient3d(b[0],b[1],b[2],p)) };
+        for k in 0..3 {
+            let j = (k + 1) % 3;
+            let shared_a = iy.contains(&ix[k]);
+            let shared_b = iy.contains(&ix[j]);
+            if shared_a && shared_b {
+                continue;
+            }
+            if shared_a || shared_b {
+                // Non-coplanar segment with one shared endpoint meets this plane
+                // only there. A segment lying in the plane needs the 2D test.
+                if sides[if shared_a { j } else { k }] != 0 {
+                    continue;
+                }
+                if frozen_coplanar(y, [x[k], x[j], x[k]], iy, [ix[k], ix[j], ix[k]]) {
+                    return true;
+                }
+            } else {
+                let a = sides[k];
+                let b = sides[j];
+                if a == 0 && b == 0 {
+                    if frozen_coplanar(y, [x[k], x[j], x[k]], iy, [ix[k], ix[j], ix[k]]) {
+                        return true;
+                    }
+                } else if frozen_edge_hits(x[k], x[j], y, a, b) {
+                    return true;
+                }
+            }
+        }
+    }
+    false
+}
+
+fn cached_coplanar_with_work(a:[P3;3],b:[P3;3],ia:[usize;3],ib:[usize;3])->(bool,usize){
+    COPLANAR_SIGN_EVALUATIONS.with(|n|n.set(0));
+    let result=coplanar(a,b,ia,ib);
+    let work=COPLANAR_SIGN_EVALUATIONS.with(|n|n.get());
+    assert!(work<=18,"more than18 primitive sign evaluations in one call: {work}");
+    (result,work)
+}
+fn compare(a:[P3;3],b:[P3;3],ia:[usize;3],ib:[usize;3]){
+    assert_eq!(intersects(a,b,ia,ib),frozen_intersects(a,b,ia,ib));
+    assert_eq!(intersects(b,a,ib,ia),frozen_intersects(b,a,ib,ia));
+    assert_eq!(intersects_both(a,b,ia,ib),frozen_intersects(a,b,ia,ib)||frozen_intersects(a.map(q::rounded),b.map(q::rounded),ia,ib));
+}
