+#[test]
+fn inverse_c_paired_original_and_interior_events_keep_acceptance_and_reduce_new_queries() {
+    let (f, ids) = fixture();
+    let (old, old_cost, old_eps) = without_interpolation(|| campaign(&f, ids));
+    let (new, new_cost, eps) = campaign(&f, ids);
+    assert_eq!(old_eps.to_bits(), eps.to_bits());
+    assert_eq!(old.len(), new.len());
+    let mut changed_parameters = 0;
+    let mut maximum_difference = 0_f64;
+    let mut rows = Vec::new();
+    for (a, b) in old.iter().zip(&new) {
+        assert_eq!(a[0].chart, b[0].chart);
+        assert_eq!(a[0].parameter.to_bits(), b[0].parameter.to_bits());
+        assert_eq!(a[0].point.map(f64::to_bits), b[0].point.map(f64::to_bits));
+        for k in 1..3 {
+            assert!(accepts(a[0].point, a[k].point, eps));
+            assert!(accepts(b[0].point, b[k].point, eps));
+            let difference = distance_upper(a[k].point, b[k].point).unwrap();
+            maximum_difference = maximum_difference.max(difference);
+            assert!(difference <= (2. * eps).next_up());
+            changed_parameters += usize::from(a[k].parameter.to_bits() != b[k].parameter.to_bits());
+        }
+        rows.push(
+            json!({"originChart":a[0].chart,"originParameterBits":a[0].parameter.to_bits(),
+            "oldParametersBits":a.each_ref().map(|e|e.parameter.to_bits()),
+            "newParametersBits":b.each_ref().map(|e|e.parameter.to_bits()),
+            "oldPointBits":a.each_ref().map(|e|e.point.map(f64::to_bits)),
+            "newPointBits":b.each_ref().map(|e|e.point.map(f64::to_bits))}),
+        );
+    }
+    assert!(
+        new_cost["consumeAttempts"].as_u64().unwrap()
+            < old_cost["consumeAttempts"].as_u64().unwrap()
+    );
+    assert!(new_cost["maximumRequest"].as_u64().unwrap() <= MAX_REQUEST as u64);
+    let report = json!({"scope":"same original and quarter/midpoint events under old/new numerical proposals; all actual source/query/container/3D and sequence gates retained; not component acceptance",
+        "featureFingerprint":f.fingerprint().to_string(),"sourceCharts":ids,"unchangedAllowance":eps,
+        "events":rows,"eventCount":new.len(),"oldCost":old_cost,"newCost":new_cost,
+        "changedMappedParameters":changed_parameters,"maximumOldNewPointDifferenceUpper":maximum_difference,
+        "bitIdentityRequired":false,"limits":{"request":MAX_REQUEST,"total":MAX_TOTAL,"iterations":MAX_ITERATIONS}});
+    std::fs::write(
+        std::env::var("SFCC_INVERSE_C_RECEIPT").expect("root receipt path"),
+        serde_json::to_vec_pretty(&report).unwrap(),
+    )
+    .unwrap();
+}
