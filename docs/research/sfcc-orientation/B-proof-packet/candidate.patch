+fn quotient_b(a: I, b: I) -> Option<I> {
+    if b.lo <= 0. && b.hi >= 0. {
+        return None;
+    }
+    mul(a, interval((1. / b.hi).next_down(), (1. / b.lo).next_up())?)
+}
+fn cross_b(a: [I; 3], b: [I; 3]) -> Option<[I; 3]> {
+    Some([
+        mul(a[1], b[2])?.sub(mul(a[2], b[1])?)?,
+        mul(a[2], b[0])?.sub(mul(a[0], b[2])?)?,
+        mul(a[0], b[1])?.sub(mul(a[1], b[0])?)?,
+    ])
+}
+fn dot_b(a: [I; 3], b: [I; 3]) -> Option<I> {
+    let mut sum = I::point(0.);
+    for k in 0..3 {
+        sum = sum.add(mul(a[k], b[k])?)?;
+    }
+    Some(sum)
+}
+fn bounds_b(x: I) -> [f64; 2] {
+    [x.lo, x.hi]
+}
+struct RegionB {
+    fields: [I; 4],
+    gradients: [[I; 3]; 4],
+    margins: [f64; 8],
+    rank: f64,
+    common: usize,
+}
+// Test-only finite-source certificate; the box does not authorize assigning a mesh patch.
+fn region_b(
+    root: &CsgNode,
+    f: &crate::sfcc::feature_set::SfccFeatureSet,
+    lo: [f64; 3],
+    hi: [f64; 3],
+) -> Option<RegionB> {
+    if (0..3).any(|k| !lo[k].is_finite() || !hi[k].is_finite() || lo[k] > hi[k]) {
+        return None;
+    }
+    let source = roles(f);
+    let ids = crate::sfcc::stage4_source_preflight_c::selected_pair_c(f).ok()?;
+    let tube = f.curves[ids[0]].projection_tube(0., 1.)?;
+    let branch = HelixBranch::identify(f, ids[0], ids[1], tube)?;
+    let corner = f.corners.get(f.curves[ids[0]].corner_start as usize)?;
+    let junction = junction::prove_junction(
+        root,
+        &f.strata,
+        source,
+        [corner.x, corner.y, corner.z],
+        1e-6,
+    )?;
+    let registered = f.strata[source[0]].exposure_root_a()?;
+    let (cap_cut, sphere, outer_r) =
+        pair(registered, Some((BlendKind::Smax, SminMode::Round))).ok()?;
+    let (groove_cut, cap, _) = pair(cap_cut, None).ok()?;
+    let (hard, groove_node, r) =
+        pair(groove_cut, Some((BlendKind::Smax, SminMode::Chamfer))).ok()?;
+    let (inner, cylinder_node, _) = pair(hard, None).ok()?;
+    let (other_node, native_node, inner_r) =
+        pair(inner, Some((BlendKind::Smin, SminMode::Round))).ok()?;
+    let native = leaf(native_node, 1.).ok()?;
+    let other = leaf(other_node, 1.).ok()?;
+    let cylinder = leaf(cylinder_node, 1.).ok()?;
+    let groove = leaf(groove_node, -1.).ok()?;
+    let (params, registered_native, registered_other, registered_r) =
+        f.strata[source[0]].round_twisted_source(&f.strata[source[1]])?;
+    if !std::ptr::eq(native, registered_native)
+        || !std::ptr::eq(other, registered_other)
+        || inner_r != registered_r
+    {
+        return None;
+    }
+    let (e, ge, _, uv) = twisted(params, lo, hi)?;
+    let profile = upper_source_a::finite_profile_level(params, native, uv, e)?;
+    let y = interval(lo[1], hi[1])?;
+    let native_cap = upper_source_a::cap_margin(y, params.pos_y, params.h, e)?;
+    let x = interval(lo[0], hi[0])?.sub(I::point(branch.cylinder.0[0]))?;
+    let z = interval(lo[2], hi[2])?.sub(I::point(branch.cylinder.0[2]))?;
+    let rho = sqrt(square(x)?.add(square(z)?)?)?;
+    if rho.lo <= 0. {
+        return None;
+    }
+    let c = rho.sub(I::point(branch.cylinder.2))?;
+    let Shape::Cylinder { h, .. } = &cylinder.shape else {
+        return None;
+    };
+    let cylinder_cap = upper_source_a::cap_margin(y, cylinder.pos[1], *h, c)?;
+    let gc = [quotient_b(x, rho)?, I::point(0.), quotient_b(z, rho)?];
+    let Shape::Lathe { edges } = &groove.shape else {
+        return None;
+    };
+    let edge = edges.get(junction.groove_edge)?;
+    let orientation = crate::sfcc::predicates::orient2d(
+        [edges[0].r0, edges[0].y0],
+        [edges[1].r0, edges[1].y0],
+        [edges[2].r0, edges[2].y0],
+    ) as f64;
+    let dr = I::point(edge.r1).sub(I::point(edge.r0))?;
+    let dy = I::point(edge.y1).sub(I::point(edge.y0))?;
+    let len = sqrt(square(dr)?.add(square(dy)?)?)?;
+    let nr = quotient_b(dy.mul(orientation)?, len)?;
+    let ny = quotient_b(dr.mul(-orientation)?, len)?;
+    let wr = rho.sub(I::point(edge.r0))?;
+    let wy = y.sub(I::point(groove.pos[1]))?.sub(I::point(edge.y0))?;
+    let along = quotient_b(
+        mul(dr, wr)?.add(mul(dy, wy)?)?,
+        square(dr)?.add(square(dy)?)?,
+    )?;
+    let projection = along.lo.min(1. - along.hi);
+    if projection <= 0. {
+        return None;
+    }
+    let distance = mul(nr, wr)?.add(mul(ny, wy)?)?;
+    if distance.lo <= 0. {
+        return None;
+    }
+    let mut nearest = f64::INFINITY;
+    for (i, other) in edges.iter().enumerate() {
+        if i == junction.groove_edge {
+            continue;
+        }
+        let dx = I::point(other.r1).sub(I::point(other.r0))?;
+        let dy = I::point(other.y1).sub(I::point(other.y0))?;
+        let wx = rho.sub(I::point(other.r0))?;
+        let wy = y.sub(I::point(groove.pos[1]))?.sub(I::point(other.y0))?;
+        let t = quotient_b(
+            mul(dx, wx)?.add(mul(dy, wy)?)?,
+            square(dx)?.add(square(dy)?)?,
+        )?;
+        let t = interval(t.lo.clamp(0., 1.), t.hi.clamp(0., 1.))?;
+        let d = sqrt(square(wx.sub(mul(dx, t)?)?)?.add(square(wy.sub(mul(dy, t)?)?)?)?)?;
+        nearest = nearest.min(d.sub(I::point(distance.hi))?.lo);
+    }
+    if nearest <= 0. {
+        return None;
+    }
+    let g = I::point(r).sub(distance)?;
+    let gg = [
+        mul(nr, gc[0])?.mul(-1.)?,
+        ny.mul(-1.)?,
+        mul(nr, gc[2])?.mul(-1.)?,
+    ];
+    let inner_margin = I::point(lathe_lower(other, lo, hi)?)
+        .sub(I::point(inner_r))?
+        .lo
+        .min(I::point(inner_r).sub(e)?.lo);
+    if inner_margin <= 0. {
+        return None;
+    }
+    let w = std::f64::consts::FRAC_1_SQRT_2;
+    let fields = [e, c, e.add(g)?.mul(w)?, c.add(g)?.mul(w)?];
+    let f_box = interval(
+        fields
+            .iter()
+            .map(|x| x.lo)
+            .fold(f64::NEG_INFINITY, f64::max),
+        fields
+            .iter()
+            .map(|x| x.hi)
+            .fold(f64::NEG_INFINITY, f64::max),
+    )?;
+    // G is inactive relative to E throughout this box, so max(H,G,w(H+G+r)) is max of four facets.
+    if e.lo <= -distance.lo {
+        return None;
+    }
+    let cap = leaf(cap, -1.).ok()?;
+    let Shape::Extrude { h, .. } = &cap.shape else {
+        return None;
+    };
+    let cap_upper = y.sub(I::point(cap.pos[1]))?.add(I::point(*h))?.hi;
+    let cap_margin = I::point(f_box.lo).sub(I::point(cap_upper))?.lo;
+    if cap_upper >= 0. || cap_margin <= 0. {
+        return None;
+    }
+    let sphere = leaf(sphere, 1.).ok()?;
+    let Shape::Sphere { r: sphere_r } = &sphere.shape else {
+        return None;
+    };
+    let sphere_distance = sqrt(square(rho)?.add(square(y.sub(I::point(sphere.pos[1]))?)?)?)?;
+    let sphere_margin = I::point(*sphere_r)
+        .sub(I::point(outer_r))?
+        .sub(sphere_distance)?
+        .lo;
+    if sphere_margin <= 0. || f_box.lo <= -outer_r {
+        return None;
+    }
+    let chamfer_e = [
+        ge[0].add(gg[0])?.mul(w)?,
+        ge[1].add(gg[1])?.mul(w)?,
+        ge[2].add(gg[2])?.mul(w)?,
+    ];
+    let chamfer_c = [
+        gc[0].add(gg[0])?.mul(w)?,
+        gc[1].add(gg[1])?.mul(w)?,
+        gc[2].add(gg[2])?.mul(w)?,
+    ];
+    let transverse = cross_b(ge, gg)?;
+    let rank = transverse
+        .iter()
+        .filter(|x| x.lo > 0. || x.hi < 0.)
+        .map(|x| x.lo.abs().min(x.hi.abs()))
+        .fold(0., f64::max);
+    if rank <= 0. {
+        return None;
+    }
+    let common: Vec<_> = f
+        .strata
+        .iter()
+        .filter(|s| {
+            s.connection_compound(hard, groove_node, groove_cut)
+                .is_some()
+        })
+        .map(|s| s.id)
+        .collect();
+    if common.len() != 1 {
+        return None;
+    }
+    Some(RegionB {
+        fields,
+        gradients: [ge, gc, chamfer_e, chamfer_c],
+        margins: [
+            profile,
+            native_cap,
+            cylinder_cap,
+            projection,
+            nearest,
+            inner_margin,
+            cap_margin,
+            sphere_margin,
+        ],
+        rank,
+        common: common[0],
+    })
+}
+#[test]
+fn orientation_b_whole_triangle_source_normal_cone_and_alias_equations() {
+    let (root, f, captured, points) = fixture();
+    let exported = points.map(q::rounded);
+    let lo = std::array::from_fn(|k| {
+        points
+            .iter()
+            .chain(exported.iter())
+            .map(|p| p[k])
+            .fold(f64::INFINITY, f64::min)
+    });
+    let hi = std::array::from_fn(|k| {
+        points
+            .iter()
+            .chain(exported.iter())
+            .map(|p| p[k])
+            .fold(f64::NEG_INFINITY, f64::max)
+    });
+    let cert = region_b(&root, &f, lo, hi)
+        .expect("finite source box and local max-four branch restrictions");
+    let mut stages = Vec::new();
+    for (name, p) in [("working", points), ("exported", exported)] {
+        let a = std::array::from_fn(|k| I::point(p[1][k]).sub(I::point(p[0][k])).unwrap());
+        let b = std::array::from_fn(|k| I::point(p[2][k]).sub(I::point(p[0][k])).unwrap());
+        let normal = cross_b(a, b).unwrap();
+        let dots = cert.gradients.map(|g| dot_b(normal, g).unwrap());
+        assert!(
+            dots.iter().all(|d| d.hi < 0.),
+            "triangle opposes every possible local facet normal, not just sampled centroid: {:?}",
+            dots.map(bounds_b)
+        );
+        stages.push(json!({"stage":name,"exactNormalEnclosure":normal.map(bounds_b),"dotEveryFacetEnclosures":dots.map(bounds_b)}));
+    }
+    let source = roles(&f);
