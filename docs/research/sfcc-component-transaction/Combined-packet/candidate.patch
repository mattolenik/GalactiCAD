+pub(crate) struct Prepared<'a> {
+    features: &'a SfccFeatureSet,
+    root: Arc<CsgNode>,
+    source: [usize; 4],
+    charts: [usize; 2],
+    epsilon: f64,
+    event: activation_event_c::Event<'a>,
+    images: [[[u64; 3]; 2]; 2],
+    frontier: [i64; 4],
+    equivalences: BTreeMap<usize, usize>,
+    changed: BTreeSet<FaceId>,
+}
+impl Prepared<'_> {
+    pub(crate) fn install(
+        &self,
+        equivalences: &mut BTreeMap<usize, usize>,
+        changed: &mut BTreeSet<FaceId>,
+    ) -> Result<()> {
+        merge_equivalences(equivalences, &self.equivalences)?;
+        changed.extend(&self.changed);
+        Ok(())
+    }
+    pub(crate) fn meshing_plan(
+        &self,
+        tree: &CsgNode,
+        view: &SfccFeatureSet,
+        primary: [usize; 2],
+        oct: &SfccOctree,
+        faces: &[HashMap<i64, FaceRecord>; 3],
+        selected: &[SfccCell],
+        points: &mut PointTable,
+    ) -> Result<Plan> {
+        if !self.event.bound_to(self.features) || self.charts.iter().any(|c| primary.contains(c)) {
+            return Err("secondary_view_source");
+        }
+        // The caller creates this view only by cloning and removing the independent primary alias.
+        // Rebind the secondary source on that actual instance and require its event images unchanged.
+        let (source, _, charts) = alias_face_b::select(view).ok_or("secondary_view_selection")?;
+        if charts != self.charts || source != [self.source[0], self.source[1], self.source[2]] {
+            return Err("secondary_view_selection");
+        }
+        let cert = activation_a::bind(tree, view, source, charts, 0.2)
+            .ok_or("secondary_view_certificate")?;
+        let root = view.strata[self.source[0]]
+            .upper_source_root_handle()
+            .ok_or("secondary_view_root")?;
+        if !Arc::ptr_eq(&root, &self.root)
+            || cert.source != self.source
+            || [
+                image_bits(cert.activation_image(false).ok_or("secondary_view_image")?),
+                image_bits(cert.activation_image(true).ok_or("secondary_view_image")?),
+            ] != self.images
+        {
+            return Err("secondary_view_source_drift");
+        }
+        for chart in charts {
+            let a = &self.features.curves[chart];
+            let b = &view.curves[chart];
+            if a.id != b.id
+                || a.t_min.to_bits() != b.t_min.to_bits()
+                || a.t_max.to_bits() != b.t_max.to_bits()
+                || a.closed != b.closed
+                || a.corner_start != b.corner_start
+                || a.corner_end != b.corner_end
+                || a.adjacent_strata != b.adjacent_strata
+            {
+                return Err("secondary_view_chart_drift");
+            }
+        }
+        let mut consumers: Vec<Consumer> = Vec::new();
+        for cell in selected {
+            let relevant = id(cell) == self.frontier
+                || cell_faces(oct, faces, cell)
+                    .iter()
+                    .any(|f| self.changed.contains(f));
+            if !relevant {
+                continue;
+            }
+            consumers.push(component_consumers_b::prepare_consumer(
+                oct,
+                faces,
+                cell,
+                points,
+                view,
+                charts,
+                id(cell) == self.frontier,
+            )?);
+        }
+        if consumers.is_empty()
+            || consumers.len() > 256
+            || consumers.iter().filter(|c| c.activation).count() != 1
+        {
+            return Err("secondary_consumer_inventory");
+        }
+        note("preparedConsumers",json!(consumers.iter().map(|c|json!({"cell":id(&c.cell),"cellBoxBits":c.cell_box.map(f64::to_bits),"activation":c.activation,"windows":c.incoming.iter().map(|p|p.iter().map(|&(t,id)|json!([t.to_bits(),id])).collect::<Vec<_>>()).collect::<Vec<_>>()})).collect::<Vec<_>>()));
+        Ok(Plan {
+            root,
+            fingerprint: view.fingerprint(),
+            source: self.source,
+            charts,
+            cuts: self.event.parameters(),
+            point: self.event.point(),
+            epsilon: self.epsilon,
+            consumers,
+        })
+    }
+}
+fn merge_equivalences(
+    existing: &mut BTreeMap<usize, usize>,
+    added: &BTreeMap<usize, usize>,
+) -> Result<()> {
+    if added.iter().any(|(&from, &to)| {
+        from == to
+            || existing.get(&from).is_some_and(|&old| old != to)
+            || existing.contains_key(&to)
+            || added.contains_key(&to)
+            || existing.values().any(|&v| v == from)
+    }) {
+        return Err("secondary_equivalence_conflict");
+    }
+    existing.extend(added);
+    Ok(())
+}
+pub(crate) fn prepare<'a>(
+    tree: &CsgNode,
+    f: &'a SfccFeatureSet,
+    oct: &SfccOctree,
+    faces: &[HashMap<i64, FaceRecord>; 3],
+    live: &PointTable,
+    tolerance: f64,
+    budget: &mut Transport<'_>,
+) -> Result<Prepared<'a>> {
+    if !enabled() || !budget.bound_to(f) {
+        return Err("secondary_request_source");
+    }
+    let (source, _, charts) = alias_face_b::select(f).ok_or("secondary_source")?;
+    let epsilon = crate::sfcc::shared_arc_plan::numerical(f, charts[0], charts[1], tolerance)
+        .ok_or("secondary_allowance")?;
+    let proof = alias_typed_face_b::observe(tree, f, oct, faces, live, budget);
+    super::note_secondary_faces_b(proof.clone());
+    let rows = proof["rows"].as_array().ok_or("secondary_face_proof")?;
+    if rows.is_empty() || rows.len() > 64 || rows.iter().any(|r| r.get("refusal").is_some()) {
+        return Err("secondary_face_proof");
+    }
+    let mut changed = BTreeSet::new();
+    let mut equivalences = BTreeMap::new();
+    for row in rows {
+        let face = (
+            row["face"][0].as_u64().ok_or("secondary_face_id")? as usize,
+            row["face"][1].as_i64().ok_or("secondary_face_id")?,
+            row["face"][2].as_i64().ok_or("secondary_face_id")?,
+        );
+        if face.0 >= 3 || !changed.insert(face) {
+            return Err("secondary_face_identity");
+        }
+        let r = faces[face.0].get(&face.1).ok_or("secondary_face_record")?;
+        let pins = charts.map(|c| {
+            r.pins
+                .iter()
+                .filter(|p| p.curve_id == c)
+                .collect::<Vec<_>>()
+        });
+        if pins.iter().any(|p| p.len() != 1) || r.len != face.2 {
+            return Err("secondary_face_pins");
+        }
+        if row["canonicalCandidate"].as_u64() != Some(pins[0][0].point_id as u64)
+            || row["canonicalPointDirectlyCheckedAgainstBothOwnQueries"] != true
+        {
+            return Err("secondary_face_canonical");
+        }
+        let from = pins[1][0].point_id;
+        let to = pins[0][0].point_id;
+        if equivalences.insert(from, to).is_some_and(|old| old != to) {
+            return Err("secondary_face_equivalence");
+        }
+    }
+    let inventory = alias_face_b::inspect(f, oct, faces, live)?;
+    let (inventory_pair, frontier_face, frontier) =
+        super::activation_frontier_c::pair_and_frontier(&inventory)?;
+    if inventory_pair != charts {
+        return Err("secondary_frontier_pair");
+    }
+    let cells: Vec<_> = oct.leaves.iter().filter(|c| id(c) == frontier).collect();
+    if cells.len() != 1 {
+        return Err("secondary_frontier_leaf");
+    }
+    let cell = cells[0];
+    let used = cell_faces(oct, faces, cell);
+    if !used.contains(&frontier_face) || !used.iter().any(|f| changed.contains(f)) {
+        return Err("secondary_frontier_binding");
+    }
+    let mut params: [Vec<f64>; 2] = std::array::from_fn(|_| Vec::new());
+    for &(axis, key, _) in &used {
+        for pin in &faces[axis][&key].pins {
+            for i in 0..2 {
+                if pin.curve_id == charts[i]
+                    && !params[i].iter().any(|t| t.to_bits() == pin.t.to_bits())
+                {
+                    params[i].push(pin.t);
+                }
+            }
+        }
+    }
+    if params[0].len() != 1 || params[1].len() != 2 {
+        return Err("secondary_frontier_paths");
+    }
+    params[1].sort_by(f64::total_cmp);
+    let cert =
+        activation_a::bind(tree, f, source, charts, 0.2).ok_or("secondary_activation_source")?;
+    let box_ = cell_aabb(&oct.lat, cell.level, cell.ix, cell.iy, cell.iz);
+    let mut trace = Vec::new();
+    let event = activation_event_c::prepare(
+        f,
+        &cert,
+        [
+            [params[0][0], f.curves[charts[0]].t_max],
+            [params[1][0], params[1][1]],
+        ],
+        box_,
+        epsilon,
+        budget,
+        &mut trace,
+    )
+    .map_err(|e| {
+        note(
+            "eventRefusal",
+            json!({"reason":format!("{e:?}"),"queries":trace}),
+        );
+        "secondary_activation_event"
+    })?;
+    let root = f.strata[source[0]]
+        .upper_source_root_handle()
+        .ok_or("secondary_root")?;
+    let images = [
+        image_bits(cert.activation_image(false).ok_or("secondary_image")?),
+        image_bits(cert.activation_image(true).ok_or("secondary_image")?),
+    ];
+    note(
+        "preparation",
+        json!({"pairedFaces":changed,"equivalences":equivalences.iter().map(|(&a,&b)|[a,b]).collect::<Vec<_>>(),"frontierFace":frontier_face,"frontierCell":frontier,"event":event.report(),"eventQueries":trace,"sourceFingerprint":f.fingerprint().to_string(),"mutationPerformed":false,"publicationReady":false}),
+    );
+    Ok(Prepared {
+        features: f,
+        root,
+        source: cert.source,
+        charts,
+        epsilon,
+        event,
+        images,
+        frontier,
+        equivalences,
+        changed,
+    })
+}
