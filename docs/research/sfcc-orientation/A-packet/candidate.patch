+#[cfg(test)]
+mod orientation_tests {
+    use super::*;
+    #[test]
+    fn orientation_a_target_capture_is_lazy_and_survives_next_cell() {
+        DIAGNOSTIC.with(|s| *s.borrow_mut() = Some(json!({"graphContextB":{"cell":[1,0,0,0]}})));
+        orientation_note("inactive", || panic!("inactive capture must not evaluate"));
+        assert!(test_peek().get("orientationCaptureA").is_none());
+        DIAGNOSTIC.with(|s|*s.borrow_mut()=Some(json!({"graphContextB":{"cell":[7,25,58,86]},"graphCaptureB":{"pre":{"loops":[[1,2,3]]},"complete":true}})));
+        orientation_note("graph", || json!({"stratum":31,"boundary":[1,2,3]}));
+        new_cell();
+        let value = test_take();
+        assert!(value.get("graphContextB").is_none());
+        assert_eq!(
+            value["orientationCaptureA"]["preGraph"]["pre"]["loops"],
+            json!([[1, 2, 3]])
+        );
+        assert_eq!(
+            value["orientationCaptureA"]["events"][0]["data"]["stratum"],
+            31
+        );
+        assert_eq!(value["orientationCaptureA"]["complete"], true);
+    }
+    #[test]
+    fn orientation_a_event_and_byte_limits_are_explicit() {
+        DIAGNOSTIC.with(|s| {
+            *s.borrow_mut() =
+                Some(json!({"graphContextB":{"cell":[7,25,58,86]},"graphCaptureB":{}}))
+        });
+        for i in 0..128 {
+            orientation_note("row", || json!(i));
+        }
+        orientation_note("overflow", || panic!("overflow closure must not run"));
+        assert_eq!(
+            test_peek()["orientationCaptureA"]["refusal"],
+            "orientation_event_cap"
+        );
+        orientation_note("after", || panic!("refused capture must not evaluate"));
+        test_take();
+        DIAGNOSTIC.with(|s| {
+            *s.borrow_mut() =
+                Some(json!({"graphContextB":{"cell":[7,25,58,86]},"graphCaptureB":{}}))
+        });
+        orientation_note("large", || json!({"text":"x".repeat(CAP)}));
+        let value = test_take();
+        assert_eq!(value["orientationCaptureA"]["complete"], false);
+        assert_eq!(
+            value["orientationCaptureA"]["refusal"],
+            "graph_capture_512KiB_cap"
+        );
+    }
