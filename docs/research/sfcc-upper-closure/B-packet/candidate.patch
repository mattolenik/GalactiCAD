+fn parameter_at_height(
+    c: &crate::sfcc::feature_curves::FeatureCurve,
+    mut a: f64,
+    mut b: f64,
+    y: f64,
+) -> Option<f64> {
+    let ascending = c.point_at_checked(a)?[1] < c.point_at_checked(b)?[1];
+    for _ in 0..48 {
+        let t = a + (b - a) * 0.5;
+        let h = c.point_at_checked(t)?[1];
+        if (h < y) == ascending {
+            a = t;
+        } else {
+            b = t;
+        }
+    }
+    Some(a + (b - a) * 0.5)
