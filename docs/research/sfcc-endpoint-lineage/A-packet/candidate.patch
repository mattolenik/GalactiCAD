+//! Test-only, bounded observations of the existing trace/trim/wiring path.
+use super::*;
+use serde_json::{json, Value};
+use std::{cell::RefCell, collections::BTreeMap, io::Write};
+const BYTE_CAP: usize = 512 * 1024;
+const EVENT_CAP: usize = 4096;
+const TARGET: [f64; 3] = [-6.721694817707532, 2.6909777686167193, -8.453331815184598];
+pub(super) fn hex(v: f64) -> String {
+    format!("{:016x}", v.to_bits())
+}
+pub(super) fn point(p: [f64; 3]) -> [String; 3] {
+    p.map(hex)
+}
+pub(super) fn pair(c: &FeatureCurve) -> bool {
+    matches!(c.adjacent_strata, [10, 15] | [15, 10] | [30, 15] | [15, 30])
+}
+pub(super) fn near(p: [f64; 3]) -> bool {
+    (0..3).all(|k| (p[k] - TARGET[k]).abs() <= 0.05)
+}
+#[derive(Clone, Copy)]
+pub(super) enum Scope {
+    Global,
+    Curve,
+    Point,
+}
+#[derive(Default)]
+struct State {
+    events: Vec<Value>,
+    bytes: usize,
+    incomplete: Option<&'static str>,
+    raw: Option<(usize, usize, [usize; 2])>,
+    raw_origin: Option<(usize, usize, [usize; 2])>,
+    probe: Option<(f64, [f64; 3])>,
+}
+thread_local! { static STATE: RefCell<Option<State>> = const { RefCell::new(None) }; }
+fn encoded_size(value: &Value, limit: usize) -> Option<usize> {
+    struct Count {
+        used: usize,
+        limit: usize,
+    }
+    impl Write for Count {
+        fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+            if bytes.len() > self.limit - self.used {
+                return Err(std::io::ErrorKind::OutOfMemory.into());
+            }
+            self.used += bytes.len();
+            Ok(bytes.len())
+        }
+        fn flush(&mut self) -> std::io::Result<()> {
+            Ok(())
+        }
+    }
+    let mut count = Count { used: 0, limit };
+    serde_json::to_writer(&mut count, value).ok()?;
+    Some(count.used)
+}
+pub(super) fn record(kind: &'static str, scope: Scope, make: impl FnOnce() -> Value) {
+    STATE.with(|s| {
+        let mut s = s.borrow_mut();
+        let Some(s) = s.as_mut() else { return; };
+        let selected = match scope { Scope::Global => true, Scope::Curve => s.raw.is_some(), Scope::Point => s.probe.is_some() };
+        if s.incomplete.is_some() || !selected { return; }
+        if s.events.len() >= EVENT_CAP { s.incomplete = Some("event_cap"); return; }
+        let value = json!({"kind":kind,"raw":s.raw,"rawOrigin":s.raw_origin,
+            "probe":s.probe.map(|(t,p)|json!({"parameterHex":hex(t),"pointHex":point(p)})),"data":make()});
+        let Some(bytes) = encoded_size(&value, BYTE_CAP - s.bytes) else { s.incomplete = Some("byte_cap"); return; };
+        s.bytes += bytes; s.events.push(value);
+    });
+}
+pub(super) fn start_raw(ci: usize, c: &FeatureCurve) {
+    STATE.with(|s| {
+        if let Some(s) = s.borrow_mut().as_mut() {
+            s.raw = pair(c).then_some((ci, c.id, c.adjacent_strata));
+            s.raw_origin = Some((ci, c.id, c.adjacent_strata));
+            s.probe = None;
+        }
+    });
+    if c.index_polyline.len() > 12288 {
+        STATE.with(|s| {
+            if let Some(s) = s.borrow_mut().as_mut() {
+                if s.raw.is_some() {
+                    s.incomplete = Some("raw_polyline_cap");
+                }
+            }
+        });
+        return;
+    }
+    record("raw_curve", Scope::Curve, || curve(c));
+}
+pub(super) fn clear_raw() {
+    STATE.with(|s| {
+        if let Some(s) = s.borrow_mut().as_mut() {
+            s.raw = None;
+            s.raw_origin = None;
+            s.probe = None;
+        }
+    });
+}
+pub(super) fn clear_probe() {
+    STATE.with(|s| {
+        if let Some(s) = s.borrow_mut().as_mut() {
+            s.probe = None;
+        }
+    });
+}
+pub(super) fn probe(c: &FeatureCurve, t: f64, p: [f64; 3]) {
+    STATE.with(|s| {
+        if let Some(s) = s.borrow_mut().as_mut() {
+            s.probe = (s.raw.is_some() && pair(c) && near(p)).then_some((t, p));
+        }
+    });
+}
+pub(super) fn candidate(p: [f64; 3], id: usize, merged: bool, retained: [f64; 3]) {
+    if near(p) || near(retained) {
+        record(
+            "candidate",
+            Scope::Global,
+            || json!({"incomingHex":point(p),"candidate":id,"merged":merged,"retainedHex":point(retained)}),
+        );
+        STATE.with(|s| {
+            if let Some(s) = s.borrow_mut().as_mut() {
+                if s.raw_origin.is_some() && s.raw.is_none() {
+                    s.incomplete = Some("near_candidate_origin_outside_selected_raw_capture");
+                }
+            }
+        });
+    }
+}
+fn curve(c: &FeatureCurve) -> Value {
+    json!({"id":c.id,"strata":c.adjacent_strata,"native":c.native,"ownerNodeId":c.owner_node_id,
+        "kind":format!("{:?}",c.kind()),"closed":c.closed,"rangeHex":[hex(c.t_min),hex(c.t_max)],
+        "wrapHex":c.param_wrap.map(hex),"corners":[c.corner_start,c.corner_end],
+        "polylineHex":c.index_polyline.iter().copied().map(hex).collect::<Vec<_>>()})
+}
+pub(super) fn run(run: &TrimmedRun, c: &FeatureCurve) {
+    if pair(c) {
+        record(
+            "trim_run",
+            Scope::Curve,
+            || json!({"rawIndex":run.curve_idx,"rangeHex":[hex(run.t0),hex(run.t1)],"closed":run.full_closed}),
+        );
+    }
+}
+pub(super) fn remade(run: &TrimmedRun, c: &FeatureCurve) {
+    if pair(c) {
+        if c.index_polyline.len() > 12288 {
+            STATE.with(|s| {
+                if let Some(s) = s.borrow_mut().as_mut() {
+                    s.incomplete = Some("remade_polyline_cap");
+                }
+            });
+            return;
+        }
+        record(
+            "remade_pre_dedup",
+            Scope::Global,
+            || json!({"rawIndex":run.curve_idx,"runRangeHex":[hex(run.t0),hex(run.t1)],"curve":curve(c)}),
+        );
+    }
+}
+pub(super) fn dedup(c: &FeatureCurve, duplicate: bool, new_id: usize) {
+    if pair(c) {
+        record(
+            "dedup",
+            Scope::Global,
+            || json!({"preDedupId":c.id,"duplicate":duplicate,"newIdIfRetained":new_id,"cornersBeforeCompaction":[c.corner_start,c.corner_end],"strata":c.adjacent_strata}),
+        );
+    }
+}
+pub(super) fn final_state(
+    curves: &[FeatureCurve],
+    corners: &[SfccCorner],
+    remap: &std::collections::HashMap<usize, usize>,
+) {
+    let coordinates = curves
+        .iter()
+        .filter(|c| pair(c))
+        .try_fold(0usize, |n, c| n.checked_add(c.index_polyline.len()));
+    if curves.len() > 1024
+        || corners.len() > 1024
+        || remap.len() > 1024
+        || coordinates.is_none_or(|n| n > 12288)
+        || corners
+            .iter()
+            .filter(|c| near([c.x, c.y, c.z]))
+            .any(|c| c.curve_ends.len() > 64 || c.strata.len() > 64)
+    {
+        STATE.with(|s| {
+            if let Some(s) = s.borrow_mut().as_mut() {
+                s.incomplete = Some("final_geometry_count_cap");
+            }
+        });
+        return;
+    }
+    record(
+        "final",
+        Scope::Global,
+        || json!({"cornerRemap":remap.iter().map(|(&a,&b)|(a,b)).collect::<BTreeMap<_,_>>(),"selectedCurves":curves.iter().filter(|c|pair(c)).map(curve).collect::<Vec<_>>(),"nearCorners":corners.iter().filter(|c|near([c.x,c.y,c.z])).map(|c|json!({"id":c.id,"pointHex":point([c.x,c.y,c.z]),"ends":c.curve_ends,"strata":c.strata})).collect::<Vec<_>>() }),
+    );
+}
+struct Guard;
+impl Guard {
+    fn begin() -> Self {
+        STATE.with(|s| {
+            assert!(s.borrow().is_none());
+            *s.borrow_mut() = Some(State::default());
+        });
+        Self
+    }
+    fn finish(self) -> Value {
+        let s = STATE.with(|s| s.borrow_mut().take().unwrap());
+        let result = json!({"events":s.events,"eventBytes":s.bytes,"complete":s.incomplete.is_none(),"incompleteReason":s.incomplete,"limits":{"serializedCaptureBytes":BYTE_CAP,"events":EVENT_CAP,"polylineScalarsPerRecord":12288},"selection":{"pairs":[[10,15],[30,15]],"pointWindowCenterHex":point(TARGET),"pointWindowHalfExtentHex":hex(0.05)},"extraGeometryQueries":false});
+        if encoded_size(&result, BYTE_CAP).is_some() {
+            result
+        } else {
+            json!({"complete":false,"incompleteReason":"final_capture_byte_cap","eventCount":result["events"].as_array().unwrap().len(),"eventBytes":s.bytes})
+        }
+    }
+}
+impl Drop for Guard {
+    fn drop(&mut self) {
+        STATE.with(|s| {
+            s.borrow_mut().take();
+        });
+    }
+}
+fn normalize_roots(v: &mut Value, ids: &mut BTreeMap<String, usize>) {
+    match v {
+        Value::Object(m) => {
+            if let Some(v) = m.get_mut("rootAddressProcessLocal") {
+                let key = v.as_str().unwrap().to_string();
+                let n = ids.len();
+                *v = json!(*ids.entry(key).or_insert(n));
+            }
+            for x in m.values_mut() {
+                normalize_roots(x, ids);
+            }
+        }
+        Value::Array(a) => {
+            for x in a {
+                normalize_roots(x, ids);
+            }
+        }
+        Value::Number(n) if n.as_u64().is_some_and(|n| n > 9_007_199_254_740_991) => {
+            *v = json!(n.to_string())
+        }
+        _ => {}
+    }
+}
+fn compiled(f: &super::super::feature_set::SfccFeatureSet) -> Value {
+    let curves:Vec<_>=f.curves.iter().map(|c|{let mut v=curve(c);v["tracedRefine"]=c.traced_carriers().map(|(a,b,r)|json!({"strata":[a.id,b.id],"curveEpsHex":hex(r.curve_eps),"minCrossHex":hex(r.min_cross),"maxDisplacementHex":hex(r.max_displacement)})).unwrap_or(Value::Null);v}).collect();
+    let mut result = json!({"curves":curves,"corners":f.corners.iter().map(|c|json!({"id":c.id,"pointHex":point([c.x,c.y,c.z]),"ends":c.curve_ends,"strata":c.strata})).collect::<Vec<_>>(),"strata":f.strata.iter().map(|s|s.graph_capture_identity_b()).collect::<Option<Vec<_>>>().unwrap(),"unresolved":f.unresolved_branch_paths,"traceDiagnostics":format!("{:?}",f.trace_diagnostics)});
+    normalize_roots(&mut result, &mut BTreeMap::new());
+    result
+}
+#[test]
+fn endpoint_lineage_a_controls() {
+    assert_eq!(
+        encoded_size(&json!("x".repeat(BYTE_CAP - 2)), BYTE_CAP),
+        Some(BYTE_CAP)
+    );
+    assert!(encoded_size(&json!("x".repeat(BYTE_CAP - 1)), BYTE_CAP).is_none());
+    let called = std::cell::Cell::new(false);
+    record("off", Scope::Global, || {
+        called.set(true);
+        json!({})
+    });
+    assert!(!called.get());
+    {
+        let _g = Guard::begin();
+        record("only", Scope::Global, || json!({"x":hex(-0.)}));
+    }
+    assert!(STATE.with(|s| s.borrow().is_none()));
+    let g = Guard::begin();
+    for _ in 0..EVENT_CAP + 1 {
+        record("bounded", Scope::Global, || json!({}));
+    }
+    let v = g.finish();
+    assert_eq!(v["complete"], false);
+    assert_eq!(v["incompleteReason"], "event_cap");
+    let g = Guard::begin();
+    record(
+        "huge",
+        Scope::Global,
+        || json!({"text":"x".repeat(BYTE_CAP)}),
+    );
+    let v = g.finish();
+    assert_eq!(v["complete"], false);
+    assert_eq!(v["incompleteReason"], "byte_cap");
+}
+#[test]
+fn endpoint_lineage_a_original_feature_compilation() {
+    let config: Value =
+        serde_json::from_str(include_str!("../../fixtures/shared-arc-full-knob.json")).unwrap();
+    let tree = crate::scene_bridge::build_csg_tree_from_json(config["sceneJson"].as_str().unwrap())
+        .unwrap();
+    let size =
+        config["cube"]["max"][0].as_f64().unwrap() - config["cube"]["min"][0].as_f64().unwrap();
+    let tol = crate::tolerances::resolve_tolerances(
+        &crate::tuning::SfccTuning::default(),
+        (3. * size * size).sqrt(),
+    );
+    let (plain, _) = super::super::feature_set::compile_feature_set(&tree, &tol);
+    let baseline = compiled(&plain);
+    assert_eq!(plain.fingerprint(), 9875508341830920921);
+    let guard = Guard::begin();
+    let (observed, _) = super::super::feature_set::compile_feature_set(&tree, &tol);
+    let capture = guard.finish();
+    let observation = compiled(&observed);
+    assert_eq!(baseline, observation);
+    assert_eq!(observed.fingerprint(), 9875508341830920921);
+    let result = json!({"capture":capture,"sourceFingerprint":observed.fingerprint().to_string(),"observedAndUnobservedCompiledGeometryEqual":true,"compared":"all public curve fields/indexing arrays/traced refinement values; all corners/incidences; stratum source identities normalized for shared-root labels; unresolved and trace counters","hiddenGeometryScope":"constructors and original runtime tokens unchanged; no recursive immutable-tree Debug expansion","sourceScene":config["sceneJson"],"sourceStrata":observed.strata.iter().filter(|s|[10,15,30].contains(&s.id)).map(|s|s.graph_capture_identity_b()).collect::<Option<Vec<_>>>().unwrap(),"tolerances":{"curveEpsHex":hex(tol.curve_eps),"probeDeltaHex":hex(tol.probe_delta),"cornerMergeHex":hex(tol.corner_merge_tol)},"firstLossEstablished":false,"newGeometryAccepted":false});
+    std::fs::write(
+        std::env::var("SFCC_ENDPOINT_LINEAGE_A_RECEIPT").expect("root receipt path"),
+        serde_json::to_vec_pretty(&result).unwrap(),
+    )
+    .unwrap();
+    assert_eq!(
+        result["capture"]["complete"], true,
+        "bounded capture incomplete; do not infer missing lineage"
+    );
+}
