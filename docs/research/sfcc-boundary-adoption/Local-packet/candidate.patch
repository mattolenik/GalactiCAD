+//! Bounded incident-cell inventory; this observation never publishes a repair.
+use super::*;
+
+// Discrete ownership comes from original records, never rounded coordinate coincidence.
+fn owned_consumers(
+    entries: &[([i64; 4], usize)],
+    known: [i64; 4],
+    raw: &BTreeSet<[i64; 4]>,
+) -> Result<BTreeSet<[i64; 4]>> {
+    if entries.len() != 2
+        || entries[0].0 == entries[1].0
+        || entries.iter().any(|e| e.1 > 1)
+        || entries[0].1 == entries[1].1
+        || !entries.iter().any(|e| e.0 == known)
+    {
+        return Err("incident_opposite_consumer_inventory");
+    }
+    let owners: BTreeSet<_> = entries.iter().map(|e| e.0).collect();
+    if !raw.is_subset(&owners) {
+        return Err("incident_unrepresented_raw_box_consumer");
+    }
+    Ok(owners)
+}
+fn retained_face_defect(
+    axis: usize,
+    rect: [[f64; 3]; 2],
+    point: [f64; 3],
+    allowance: f64,
+) -> Result<Value> {
+    use crate::sdf::enclosure::Interval as I;
+    if axis >= 3
+        || !allowance.is_finite()
+        || allowance <= 0.
+        || rect
+            .iter()
+            .flatten()
+            .chain(point.iter())
+            .any(|v| !v.is_finite())
+        || (0..3).any(|k| rect[0][k] > rect[1][k])
+        || rect[0][axis] != rect[1][axis]
+    {
+        return Err("incident_face_defect_input");
+    }
+    let plane = I::point(point[axis])
+        .sub(I::point(rect[0][axis]))
+        .ok_or("incident_face_defect_interval")?;
+    let mut coordinate = [0.; 3];
+    let mut l1 = I::point(0.);
+    for k in 0..3 {
+        let closest = point[k].clamp(rect[0][k], rect[1][k]);
+        if point[k] != closest {
+            let delta = I::point(point[k])
+                .sub(I::point(closest))
+                .ok_or("incident_face_defect_interval")?;
+            coordinate[k] = delta.lo.abs().max(delta.hi.abs());
+            l1 = l1
+                .add(I::point(coordinate[k]))
+                .ok_or("incident_face_defect_interval")?;
+        }
+    }
+    if l1.hi > allowance {
+        return Err("incident_retained_point_outside_original_allowance");
+    }
+    Ok(
+        json!({"planeSignedDefectInterval":[plane.lo,plane.hi],"coordinateDefectUpper":coordinate,
+        "rectangleDistanceUpperL1":l1.hi,"originalAllowance":allowance,"rectangleBits":rect.map(|p|p.map(f64::to_bits)),
+        "retainedPointExactlyOnPlane":point[axis]==rect[0][axis],
+        "scope":"retained point distance to represented original face rectangle, not ideal-target containment or exact geometric ownership"}),
+    )
+}
+
+fn array<T: serde::de::DeserializeOwned>(value: &Value) -> Result<T> {
+    serde_json::from_value(value.clone()).map_err(|_| "incident_payload_encoding")
+}
+fn emitted_fans(report: &Value) -> Result<Vec<Value>> {
+    if report["failedCellCount"] != 0
+        || report["featureCellFallbacks"] != 0
+        || report["allGeneratedQueriesValidated"] != true
+        || report["originalFaceConsumptionValid"] != true
+        || report["invalidWorkingOrExportedOrientation"] != json!([])
+        || report["fanCaptureA"]["complete"] != true
+    {
+        return Err("incident_original_consumer_not_validated");
+    }
+    let fans = report["fanCaptureA"]["pairedFans"]
+        .as_array()
+        .ok_or("incident_fans_missing")?;
+    let triangles: Vec<usize> = array(&report["triangles"])?;
+    let rows = report["points"]
+        .as_array()
+        .ok_or("incident_points_missing")?;
+    if fans.len() > 128 || rows.len() > 4096 {
+        return Err("incident_capture_cap");
+    }
+    let mut flattened = Vec::new();
+    for fan in fans {
+        require_emitted_fan(fan, &triangles)?;
+        if fan["returned"] != true || fan["cellBoxBits"] != report["cellBoxBits"] {
+            return Err("incident_fan_cell_binding");
+        }
+        for row in fan["points"].as_array().ok_or("incident_fan_points")? {
+            let id = row["id"].as_u64().ok_or("incident_point_id")? as usize;
+            if rows
+                .get(id)
+                .is_none_or(|r| r["id"] != row["id"] || r["positionBits"] != row["positionBits"])
+            {
+                return Err("incident_fan_final_point_binding");
+            }
+        }
+        let fan_points = fan["points"].as_array().ok_or("incident_fan_points")?;
+        for point in fan["boundary"]
+            .as_array()
+            .into_iter()
+            .flatten()
+            .chain(fan["triangles"].as_array().into_iter().flatten())
+        {
+            if fan_points.iter().filter(|row| row["id"] == *point).count() != 1 {
+                return Err("incident_fan_final_point_binding");
+            }
+        }
+        flattened.extend(array::<Vec<usize>>(&fan["triangles"])?);
+    }
+    if flattened != triangles {
+        return Err("incident_fan_output_coverage");
+    }
+    Ok(fans.clone())
+}
