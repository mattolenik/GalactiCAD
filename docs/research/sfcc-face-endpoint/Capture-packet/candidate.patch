+type Image = [I; 3];
+fn quotient(a: I, b: I) -> Option<I> {
+    if b.lo <= 0. && b.hi >= 0. {
+        return None;
+    }
+    mul(a, interval((1. / b.hi).next_down(), (1. / b.lo).next_up())?)
+}
+fn bounds(p: Image) -> [[f64; 3]; 2] {
+    [p.map(|v| v.lo), p.map(|v| v.hi)]
+}
+fn midpoint_image(p: Image) -> [f64; 3] {
+    p.map(|v| v.lo * 0.5 + v.hi * 0.5)
+}
+fn abs_lower(v: I) -> f64 {
+    if v.lo > 0. {
+        v.lo
+    } else if v.hi < 0. {
+        -v.hi
+    } else {
+        0.
+    }
+}
+fn distance(a: Image, b: Image) -> Option<[f64; 2]> {
+    let mut lo = I::point(0.);
+    let mut hi = I::point(0.);
+    for k in 0..3 {
+        let d = a[k].sub(b[k])?;
+        lo = lo.add(square(I::point(abs_lower(d)))?)?;
+        hi = hi.add(square(d)?)?;
+    }
+    Some([sqrt(lo)?.lo, sqrt(hi)?.hi])
+}
+fn contains(tube: ([f64; 3], [f64; 3]), image: Image) -> bool {
+    (0..3).all(|k| image[k].lo >= tube.0[k] && image[k].hi <= tube.1[k])
+}
+fn same_meridian(a: activation_a::MeridianBound, b: activation_a::MeridianBound) -> bool {
+    a.edge == b.edge
+        && [a.nr.lo, a.nr.hi, a.ny.lo, a.ny.hi, a.offset.lo, a.offset.hi].map(f64::to_bits)
+            == [b.nr.lo, b.nr.hi, b.ny.lo, b.ny.hi, b.offset.lo, b.offset.hi].map(f64::to_bits)
+}
+struct Source<'a> {
+    f: &'a SfccFeatureSet,
+    source: [usize; 3],
+    chart: usize,
+    cylinder_id: usize,
+    compound_id: usize,
+    center: [f64; 3],
+    radius: f64,
+    half: f64,
+    p: TwistedSideParams,
+    native: &'a Leaf,
+    other: &'a Leaf,
+    groove: &'a Leaf,
+    cap: &'a Leaf,
+    sphere: &'a Leaf,
