+#[test]
+fn fullfan_c_original_triangle_slabs_protect_shared_mesh_fibers() {
+    let a = [[-2., 0., 0.], [1., 1., 0.], [-4., 0., 1.]];
+    let b = [[1., 1., 0.], [-2., 0., 0.], [5., 1., -1.]];
+    let tolerance = 0.01;
+    let sa = triangle_slab(&a, tolerance).unwrap();
+    let sb = triangle_slab(&b, tolerance).unwrap();
+    // Shared-edge affine heights lie in the convex hull of these exact endpoint heights.
+    for x in [-2., 1.] {
+        let fiber = I::point(x).add(interval(-tolerance, tolerance).unwrap()).unwrap();
+        assert!(sa.lo <= fiber.lo && fiber.hi <= sa.hi);
+        assert!(sb.lo <= fiber.lo && fiber.hi <= sb.hi);
+    }
+    assert!(sa.hi < sb.hi && sa.lo < sb.lo);
+    for bad in [0., -1., f64::NAN, f64::INFINITY] {
+        assert!(triangle_slab(&a, bad).is_none());
+    }
+    let mut bad = a;
+    bad[0][0] = f64::INFINITY;
+    assert!(triangle_slab(&bad, tolerance).is_none());
+}
