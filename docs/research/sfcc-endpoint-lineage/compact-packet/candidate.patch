@@ -0,0 +1,856 @@
+//! B: bounded observation of actual trim decisions; no geometry evaluations.
+use super::TrimmedRun;
+use crate::sfcc::{
+    feature_curves::FeatureCurve,
+    feature_set::{SfccCorner, SfccFeatureSet},
+};
+use serde_json::{json, Value};
+use std::{
+    cell::RefCell,
+    io::{self, Write},
+};
+const BYTE_CAP: usize = 512 * 1024;
+const EVENT_CAP: usize = 4096;
+const WORD_CAP: usize = 8192;
+#[derive(Clone, Copy)]
+struct Context {
+    index: usize,
+    id: usize,
+    pair: [usize; 2],
+}
+struct State {
+    rows: Vec<Value>,
+    bytes: usize,
+    incomplete: Option<&'static str>,
+    curve: Option<Context>,
+    sample: Option<(u64, f64)>,
+    sequence: u64,
+}
+thread_local! { static STATE: RefCell<Option<State>> = const { RefCell::new(None) }; }
+pub(crate) fn hex(x: f64) -> String {
+    format!("{:016x}", x.to_bits())
+}
+fn point(p: [f64; 3]) -> [String; 3] {
+    p.map(hex)
+}
+fn selected_pair(pair: [usize; 2]) -> bool {
+    matches!(pair, [10, 15] | [15, 10] | [30, 15] | [15, 30])
+}
+fn selected(c: &FeatureCurve) -> bool {
+    selected_pair(c.adjacent_strata)
+}
+fn in_window(p: [f64; 3]) -> bool {
+    p[0] >= -6.9 && p[0] <= -6.5 && p[1] >= 2.67 && p[1] <= 2.72 && p[2] >= -8.65 && p[2] <= -8.2
+}
+struct Count(usize);
+impl Write for Count {
+    fn write(&mut self, b: &[u8]) -> io::Result<usize> {
+        self.0 = self
+            .0
+            .checked_add(b.len())
+            .filter(|&n| n <= BYTE_CAP)
+            .ok_or(io::ErrorKind::OutOfMemory)?;
+        Ok(b.len())
+    }
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+fn bounded_report(value: Value) -> Value {
+    let mut count = Count(0);
+    if serde_json::to_writer(&mut count, &value).is_err() {
+        json!({"complete":false,"incompleteReason":"final_byte_cap","eventCount":value.get("eventCount"),"compiledOutputExactlyEqual":value.get("compiledOutputExactlyEqual"),"byteCap":BYTE_CAP})
+    } else {
+        value
+    }
+}
+fn emit(kind: &'static str, make: impl FnOnce() -> Value) {
+    STATE.with(|s|{
+ let mut slot=s.borrow_mut();let Some(state)=slot.as_mut()else{return;};
+ if state.incomplete.is_some(){return;} if state.rows.len()>=EVENT_CAP{state.incomplete=Some("event_cap");return;}
+ let row=json!({"kind":kind,"raw":state.curve.map(|c|json!({"index":c.index,"id":c.id,"strata":c.pair})),"sample":state.sample.map(|(id,t)|json!({"id":id,"parameterHex":hex(t)})),"data":make()});
+ let mut count=Count(0);if serde_json::to_writer(&mut count,&row).is_err(){state.incomplete=Some("row_byte_cap");return;}
+ let Some(total)=state.bytes.checked_add(count.0).filter(|&n|n<=BYTE_CAP)else{state.incomplete=Some("aggregate_byte_cap");return;};state.bytes=total;state.rows.push(row);
+});
+}
+fn enabled() -> bool {
+    STATE.with(|s| s.borrow().is_some())
+}
+fn active_curve() -> bool {
+    STATE.with(|s| {
+        s.borrow()
+            .as_ref()
+            .is_some_and(|s| s.curve.is_some_and(|c| selected_pair(c.pair)))
+    })
+}
+fn active_sample() -> bool {
+    STATE.with(|s| s.borrow().as_ref().is_some_and(|s| s.sample.is_some()))
+}
+fn refuse(reason: &'static str) {
+    STATE.with(|s| {
+        if let Some(v) = s.borrow_mut().as_mut() {
+            v.incomplete.get_or_insert(reason);
+        }
+    });
+}
+pub(crate) struct Scope;
+impl Scope {
+    pub(crate) fn begin() -> Self {
+        STATE.with(|s| {
+            assert!(s.borrow().is_none(), "nested lineage scope");
+            *s.borrow_mut() = Some(State {
+                rows: Vec::new(),
+                bytes: 0,
+                incomplete: None,
+                curve: None,
+                sample: None,
+                sequence: 0,
+            });
+        });
+        Self
+    }
+    pub(crate) fn finish(self) -> Value {
+        let s = STATE.with(|s| s.borrow_mut().take().unwrap());
+        json!({"complete":s.incomplete.is_none(),"incompleteReason":s.incomplete,"eventCount":s.rows.len(),"eventBytes":s.bytes,"limits":{"bytes":BYTE_CAP,"events":EVENT_CAP,"wordsPerCurve":WORD_CAP},"selection":{"strataPairs":[[10,15],[30,15]],"statusWindow":[[-6.9,2.67,-8.65],[-6.5,2.72,-8.2]],"scope":"actual original feature compile; no observer queries"},"events":s.rows})
+    }
+}
+impl Drop for Scope {
+    fn drop(&mut self) {
+        STATE.with(|s| {
+            s.borrow_mut().take();
+        });
+    }
+}
+pub(crate) fn sources(strata: &[crate::strata::Stratum]) {
+    if !enabled() {
+        return;
+    }
+    let mut values = Vec::new();
+    for id in [10, 15, 30] {
+        let Some(st) = strata.get(id) else {
+            refuse("source_stratum_absent");
+            return;
+        };
+        let Some(mut v) = st.graph_capture_identity_b() else {
+            refuse("source_descriptor_bound");
+            return;
+        };
+        safe_integers(&mut v);
+        values.push(v);
+    }
+    emit(
+        "source_occurrences",
+        || json!({"strata":values,"rootLabelsAreProcessLocal":true}),
+    );
+}
+pub(crate) struct CurveScope(Option<Context>);
+impl Drop for CurveScope {
+    fn drop(&mut self) {
+        STATE.with(|s| {
+            if let Some(s) = s.borrow_mut().as_mut() {
+                s.curve = self.0;
+                s.sample = None;
+            }
+        });
+    }
+}
+pub(crate) fn curve_scope(index: usize, c: &FeatureCurve) -> CurveScope {
+    let old = STATE.with(|s| {
+        s.borrow_mut()
+            .as_mut()
+            .map(|s| {
+                let old = s.curve;
+                s.curve = Some(Context {
+                    index,
+                    id: c.id,
+                    pair: c.adjacent_strata,
+                });
+                s.sample = None;
+                old
+            })
+            .flatten()
+    });
+    if active_curve() {
+        if c.index_polyline.len() > WORD_CAP {
+            refuse("raw_polyline_cap");
+        } else {
+            if let Some(record) = source_record(c) {
+                emit("raw_received", || record);
+            } else {
+                refuse("raw_stored_carrier_descriptor_bound");
+            }
+        }
+    }
+    CurveScope(old)
+}
+fn safe_integers(value: &mut Value) {
+    match value {
+        Value::Number(n) => {
+            if let Some(v) = n.as_u64().filter(|&v| v > 9_007_199_254_740_991) {
+                *value = json!(format!("u64:{v:016x}"));
+            }
+        }
+        Value::Array(a) => a.iter_mut().for_each(safe_integers),
+        Value::Object(m) => m.values_mut().for_each(safe_integers),
+        _ => {}
+    }
+}
+fn source_record(c: &FeatureCurve) -> Option<Value> {
+    let mut stored = c.lineage_stored_carriers_b()?;
+    safe_integers(&mut stored);
+    let mut record = curve_record(c);
+    record["storedTracedCarriers"] = stored;
+    Some(record)
+}
+fn curve_record(c: &FeatureCurve) -> Value {
