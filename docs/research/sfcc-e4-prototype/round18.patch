+//! Bounded numerical inverse proposal. Height guides search; only checked 3D
+//! separation grants a correspondence. No exclusion or monotonicity theorem.
+use super::*;
+use std::collections::BTreeMap;
+
+const MAX_REQUEST: usize = 64;
+const MAX_TOTAL: usize = 16_384;
+const MAX_ITERATIONS: usize = 64;
+const MAX_PIECES: usize = 128;
+const MAX_EVENTS: usize = 2048;
+const MAX_BYTES: usize = 64 * 1024 * 1024;
+
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) enum Failure {
+    Source,
+    Query(EventFailure),
+    Cancelled,
+    RequestCap,
+    TotalCap,
+    PieceCap,
+    EventCap,
+    MemoryCap,
+    AmbiguousWindow,
+    Stagnation,
+    IterationCap,
+    Distance,
+    Endpoint,
+    Order,
+}
+
+pub(crate) struct Transport<'a> {
+    // Cache identity is this immutable borrowed feature instance plus chart id.
+    features: &'a SfccFeatureSet,
+    ids: [usize; 2],
+    pieces: Vec<ConsumedPiece<'a>>,
+    knots: [Vec<f64>; 2],
+    cache: BTreeMap<(usize, u64), CheckedEvent>,
+    total: usize,
+    maximum_request: usize,
+    admission_identity: Option<std::rc::Rc<()>>,
+}
+
+fn distance_upper(a: [f64; 3], b: [f64; 3]) -> Option<f64> {
+    let mut sum = I::point(0.);
+    for k in 0..3 {
+        sum = sum.add(square(I::point(a[k]).sub(I::point(b[k]))?)?)?;
+    }
+    Some(sqrt(sum)?.hi)
+}
+pub(crate) fn accepts(a: [f64; 3], b: [f64; 3], epsilon: f64) -> bool {
+    distance_upper(a, b).is_some_and(|d| d <= epsilon)
+}
+fn midpoint(lo: f64, hi: f64) -> Result<f64, Failure> {
+    let t = lo + (hi - lo) * 0.5;
+    if !t.is_finite() || t <= lo || t >= hi {
+        Err(Failure::Stagnation)
+    } else {
+        Ok(t)
+    }
+}
+fn window(knots: &[(f64, f64)], y: f64) -> Result<[f64; 2], Failure> {
+    let mut found = None;
+    for pair in knots.windows(2) {
+        let a = pair[0];
+        let b = pair[1];
+        if y >= a.1.min(b.1) && y <= a.1.max(b.1) {
+            if a.1 == b.1 || found.is_some() {
+                return Err(Failure::AmbiguousWindow);
+            }
+            found = Some([a.0, b.0]);
+        }
+    }
+    found.ok_or(Failure::AmbiguousWindow)
+}
+
+impl<'a> Transport<'a> {
+    pub(crate) fn bind(
+        features: &'a SfccFeatureSet,
+        ids: [usize; 2],
+        tolerance: f64,
+    ) -> Result<Self, Failure> {
+        if ids[0] == ids[1] || ids.iter().any(|&id| id >= features.curves.len()) {
+            return Err(Failure::Source);
+        }
+        let mut knots = [Vec::new(), Vec::new()];
+        for (slot, &id) in ids.iter().enumerate() {
+            let c = &features.curves[id];
+            if c.closed || !c.t_min.is_finite() || !c.t_max.is_finite() || c.t_min >= c.t_max {
+                return Err(Failure::Source);
+            }
+            if c.t_max.ceil() - c.t_min.floor() > MAX_PIECES as f64 {
+                return Err(Failure::PieceCap);
+            }
+            knots[slot].push(c.t_min);
+            knots[slot]
+                .extend((c.t_min.floor() as i64 + 1..c.t_max.ceil() as i64).map(|k| k as f64));
+            knots[slot].push(c.t_max);
+        }
+        if knots.iter().map(|k| k.len() - 1).sum::<usize>() > MAX_PIECES {
+            return Err(Failure::PieceCap);
+        }
+        let c = &features.curves[ids[0]];
+        let tube = c
+            .projection_tube(knots[0][0], knots[0][1])
+            .ok_or(Failure::Source)?;
+        let branch =
+            HelixBranch::identify(features, ids[0], ids[1], tube).ok_or(Failure::Source)?;
+        let mut pieces = Vec::new();
+        for (slot, &id) in ids.iter().enumerate() {
+            for p in knots[slot].windows(2) {
+                pieces.push(
+                    ConsumedPiece::bind(features, &branch, ids, id, [p[0], p[1]], tolerance)
+                        .ok_or(Failure::Source)?,
+                );
+            }
+        }
+        let mut result = Self {
+            features,
+            ids,
+            pieces,
+            knots,
+            cache: BTreeMap::new(),
+            total: 0,
+            maximum_request: 0,
+            admission_identity: None,
+        };
+        for slot in 0..2 {
+            for t in result.knots[slot].clone() {
+                result.query(ids[slot], t, &mut 0)?;
+            }
+        }
+        Ok(result)
+    }
+    fn query(
+        &mut self,
+        chart: usize,
+        t: f64,
+        request: &mut usize,
+    ) -> Result<CheckedEvent, Failure> {
+        if crate::sfcc::cancel::is_cancelled() {
+            return Err(Failure::Cancelled);
+        }
+        if let Some(event) = self.cache.get(&(chart, t.to_bits())) {
+            return Ok(event.clone());
+        }
+        if *request >= MAX_REQUEST {
+            return Err(Failure::RequestCap);
+        }
+        if self.total >= MAX_TOTAL {
+            return Err(Failure::TotalCap);
+        }
+        // A deliberately generous bound for these bounded-size records and tree nodes.
+        if (self.cache.len() + 1) * 1024 + self.pieces.len() * 4096 > MAX_BYTES {
+            return Err(Failure::MemoryCap);
+        }
+        let piece = self
+            .pieces
+            .iter()
+            .find(|p| p.chart == chart && t >= p.range[0] && t <= p.range[1])
+            .ok_or(Failure::Source)?;
+        *request += 1;
+        self.total += 1;
+        crate::sfcc::private_arc_a::note_query_charge(self.total);
+        self.maximum_request = self.maximum_request.max(*request);
+        let event = piece.consume(t).map_err(Failure::Query)?;
+        self.cache.insert((chart, t.to_bits()), event.clone());
+        Ok(event)
+    }
+
+    pub(crate) fn reserve_external(&mut self, count: usize) -> Result<(), Failure> {
+        if count > MAX_TOTAL - self.total {
+            return Err(Failure::TotalCap);
+        }
+        self.total += count;
+        crate::sfcc::private_arc_a::note_query_charge(self.total);
+        Ok(())
+    }
+    pub(crate) fn attach_admission(&mut self, identity: std::rc::Rc<()>) {
+        self.admission_identity = Some(identity);
+    }
+    pub(crate) fn admission_matches(&self, identity: &std::rc::Rc<()>) -> bool {
+        self.admission_identity
+            .as_ref()
+            .is_some_and(|ours| std::rc::Rc::ptr_eq(ours, identity))
+    }
+    pub(crate) fn bound_to(&self, features: &SfccFeatureSet) -> bool {
+        std::ptr::eq(self.features, features)
+    }
+    pub(crate) fn admitted_branch(&self) -> &HelixBranch {
+        &self.pieces[0].source.branch
+    }
+    pub(crate) fn allowance(&self) -> f64 {
+        self.pieces[0].eps
+    }
+    pub(crate) fn charged_queries(&self) -> usize {
+        self.total
+    }
+    pub(crate) fn physical_alias(&self) -> [usize; 2] {
+        let physical = self
+            .ids
+            .into_iter()
+            .find(|&id| {
+                self.features.curves[id]
+                    .adjacent_strata
+                    .contains(&self.pieces[0].source.branch.native)
+            })
+            .unwrap();
+        [
+            physical,
+            *self.ids.iter().find(|&&id| id != physical).unwrap(),
+        ]
+    }
+    pub(crate) fn own(&mut self, chart: usize, t: f64) -> Result<CheckedEvent, Failure> {
+        self.query(chart, t, &mut 0)
+    }
+    /// A retained point is checked directly against its own actual query; the
+    /// point also receives its own source/branch and original-container checks.
+    pub(crate) fn retained(
+        &mut self,
+        chart: usize,
+        t: f64,
+        point: [f64; 3],
+    ) -> Result<CheckedEvent, Failure> {
+        let own = self.own(chart, t)?;
+        let piece = self
+            .pieces
+            .iter()
+            .find(|p| p.chart == chart && t >= p.range[0] && t <= p.range[1])
+            .ok_or(Failure::Source)?;
+        if !(0..3).all(|k| point[k] >= piece.tube.0[k] && point[k] <= piece.tube.1[k]) {
+            return Err(Failure::Query(EventFailure::OriginalContainer));
+        }
+        piece.check_endpoint_point(point).map_err(Failure::Query)?;
+        if !accepts(point, own.point, piece.eps) {
+            return Err(Failure::Distance);
+        }
+        Ok(own)
+    }
+    pub(crate) fn pair(&mut self, original: CheckedEvent) -> Result<[CheckedEvent; 3], Failure> {
+        let [physical, alias] = self.physical_alias();
+        let p = if original.chart == physical {
+            original.clone()
+        } else {
+            self.map(&original, physical)?
+        };
+        let a = if original.chart == alias {
+            original.clone()
+        } else {
+            self.map(&p, alias)?
+        };
+        let eps = self.pieces[0].eps;
+        if !accepts(original.point, p.point, eps)
+            || !accepts(p.point, a.point, eps)
+            || !accepts(original.point, a.point, eps)
+        {
+            return Err(Failure::Distance);
+        }
+        Ok([original, p, a])
+    }
+    pub(crate) fn check_sequences(&self, events: &[[CheckedEvent; 3]]) -> Result<(), Failure> {
+        let [physical, alias] = self.physical_alias();
+        let a = &self.features.curves[physical];
+        let b = &self.features.curves[alias];
+        let direction = if a.corner_start == b.corner_start {
+            1.
+        } else {
+            -1.
+        };
+        for origin in self.ids {
+            let mut list: Vec<_> = events.iter().filter(|e| e[0].chart == origin).collect();
+            list.sort_by(|a, b| a[0].parameter.total_cmp(&b[0].parameter));
+            for pair in list.windows(2) {
+                Self::ordered(Some(pair[0][0].parameter), &pair[1][0], 1.)?;
+                Self::ordered(
+                    Some(pair[0][1].parameter),
+                    &pair[1][1],
+                    if origin == physical { 1. } else { direction },
+                )?;
+                Self::ordered(
+                    Some(pair[0][2].parameter),
+                    &pair[1][2],
+                    if origin == alias { 1. } else { direction },
+                )?;
+            }
+        }
+        Ok(())
+    }
+    pub(crate) fn map(
+        &mut self,
+        origin: &CheckedEvent,
+        target: usize,
+    ) -> Result<CheckedEvent, Failure> {
+        let mut request = 0;
+        // Independently recover the point from this source-bound instance. An
+        // event created against another instance cannot become query authority.
+        let actual = self.query(origin.chart, origin.parameter, &mut request)?;
+        if actual.point.map(f64::to_bits) != origin.point.map(f64::to_bits) {
+            return Err(Failure::Source);
+        }
+        let slot = self
+            .ids
+            .iter()
+            .position(|&id| id == target)
+            .ok_or(Failure::Source)?;
+        let origin_curve = &self.features.curves[origin.chart];
+        let target_curve = &self.features.curves[target];
+        let eps = self.pieces[0].eps;
+        let corner = if origin.parameter.to_bits() == origin_curve.t_min.to_bits() {
+            Some(origin_curve.corner_start)
+        } else if origin.parameter.to_bits() == origin_curve.t_max.to_bits() {
+            Some(origin_curve.corner_end)
+        } else {
+            None
+        };
+        if let Some(corner) = corner {
+            if corner < 0 {
+                return Err(Failure::Endpoint);
+            }
+            let t = if corner == target_curve.corner_start {
+                target_curve.t_min
+            } else if corner == target_curve.corner_end {
+                target_curve.t_max
+            } else {
+                return Err(Failure::Endpoint);
+            };
+            let event = self.query(target, t, &mut request)?;
+            return accepts(actual.point, event.point, eps)
+                .then_some(event)
+                .ok_or(Failure::Distance);
+        }
+        let mut heights = Vec::new();
+        for t in self.knots[slot].clone() {
+            let event = self.query(target, t, &mut request)?;
+            if accepts(actual.point, event.point, eps) {
+                return Ok(event);
+            }
+            heights.push((t, event.point[1]));
+        }
+        let [mut lo, mut hi] = window(&heights, actual.point[1])?;
+        let low = self.query(target, lo, &mut request)?;
+        let high = self.query(target, hi, &mut request)?;
+        let ascending = high.point[1] > low.point[1];
+        for _ in 0..MAX_ITERATIONS {
+            let t = midpoint(lo, hi)?;
+            let event = self.query(target, t, &mut request)?;
+            if accepts(actual.point, event.point, eps) {
+                return Ok(event);
+            }
+            if (event.point[1] < actual.point[1]) == ascending {
+                lo = t;
+            } else {
+                hi = t;
+            }
+            // This is only a numerical search; shrinking a window never proves
+            // the rejected side lacks a solution. Stagnation simply refuses.
+        }
+        Err(Failure::IterationCap)
+    }
+    /// Complete original-event transport, keeping all pairwise obligations.
+    /// A partial prefix is diagnostic only; only Ok certifies the whole list.
+    pub(crate) fn complete(&mut self, output: &mut Vec<[CheckedEvent; 3]>) -> Result<(), Failure> {
+        if !output.is_empty() {
+            return Err(Failure::Order);
+        }
+        let physical = self
+            .ids
+            .into_iter()
+            .find(|&id| {
+                self.features.curves[id]
+                    .adjacent_strata
+                    .contains(&self.pieces[0].source.branch.native)
+            })
+            .ok_or(Failure::Source)?;
+        let alias = self
+            .ids
+            .into_iter()
+            .find(|&id| id != physical)
+            .ok_or(Failure::Source)?;
+        let a = &self.features.curves[physical];
+        let b = &self.features.curves[alias];
+        if [a.corner_start, a.corner_end] != [b.corner_start, b.corner_end]
+            && [a.corner_start, a.corner_end] != [b.corner_end, b.corner_start]
+        {
+            return Err(Failure::Endpoint);
+        }
+        let direction = if a.corner_start == b.corner_start {
+            1.
+        } else {
+            -1.
+        };
+        let eps = self.pieces[0].eps;
+        for slot in 0..2 {
+            let origin = self.ids[slot];
+            let mut previous = None;
+            for t in self.knots[slot].clone() {
+                if output.len() >= MAX_EVENTS {
+                    return Err(Failure::EventCap);
+                }
+                let original = self.query(origin, t, &mut 0)?;
+                let physical_event = if origin == physical {
+                    original.clone()
+                } else {
+                    self.map(&original, physical)?
+                };
+                let alias_event = self.map(&physical_event, alias)?;
+                if !accepts(original.point, physical_event.point, eps)
+                    || !accepts(physical_event.point, alias_event.point, eps)
+                    || !accepts(original.point, alias_event.point, eps)
+                {
+                    return Err(Failure::Distance);
+                }
+                let mapped = if origin == physical {
+                    &alias_event
+                } else {
+                    &physical_event
+                };
+                Self::ordered(previous, mapped, direction)?;
+                previous = Some(mapped.parameter);
+                output.push([original, physical_event, alias_event]);
+            }
+        }
+        self.check_sequences(output)
+    }
+    fn ordered(previous: Option<f64>, event: &CheckedEvent, direction: f64) -> Result<(), Failure> {
+        crate::sfcc::shared_arc_plan::strictly_ordered(previous, event.parameter, direction)
+            .then_some(())
+            .ok_or(Failure::Order)
+    }
+}
