+use super::*;
+use crate::{
+    sdf::{self, Shape},
+    sfcc::{feature_set::build_leaf_strata, tree::build_tree},
+    strata::StratumIdentity,
+    tolerances::resolve_tolerances,
+    tuning::SfccTuning,
+};
+fn tol() -> ResolvedTolerances {
+    resolve_tolerances(&SfccTuning::default(), 4.)
+}
+fn face(view: &SfccTree, normal: [f64; 3], p: [f64; 3]) -> usize {
+    view.strata
+        .iter()
+        .find(|s| s.normal(p[0], p[1], p[2]) == normal && s.f(p[0], p[1], p[2]).abs() < 1e-10)
+        .unwrap()
+        .id
+}
