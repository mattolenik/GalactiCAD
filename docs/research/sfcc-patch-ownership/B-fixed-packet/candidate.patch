+#[test]
+fn outside_b_identity_requires_original_key_and_position() {
+    let mut a = PointTable::new();
+    a.get_or_create(7, || [0., 0., 0., 0., 0., 1.]);
+    let mut b = PointTable::new();
+    let x = b.get_or_create(7, || [0., 0., 0., 0., 0., 1.]);
+    assert_eq!(same_key(&a, &b, x), Ok(Some(0)));
+    let y = b.add(0., 0., 0., 0., 0., 1.);
+    assert_eq!(same_key(&a, &b, y), Ok(None));
+    let mut wrong = PointTable::new();
+    wrong.get_or_create(7, || [1., 0., 0., 0., 0., 1.]);
+    assert_eq!(
+        same_key(&a, &wrong, 0),
+        Err("outside_candidate_same_key_different_position")
+    );
+}
+#[test]
+fn outside_b_join_checks_actual_contacts_and_partial_topology() {
+    let mut a = PointTable::new();
+    for (i, p) in [[0., 0., 0.], [1., 0., 0.], [0., 1., 0.]]
+        .iter()
+        .enumerate()
+    {
+        a.get_or_create(i as i64, || [p[0], p[1], p[2], 0., 0., 1.]);
+    }
+    let mut b = PointTable::new();
+    for (i, p) in [(0, [0., 0., 0.]), (1, [1., 0., 0.]), (3, [0., -1., 0.])] {
+        b.get_or_create(i, || [p[0], p[1], p[2], 0., 0., 1.]);
+    }
+    let good = join(&a, &[0, 1, 2], &b, &[1, 0, 2]).unwrap();
+    assert_eq!(
+        good["contactingOutsideTrianglesWorkingOrExported"],
+        json!([])
+    );
+    assert_eq!(good["partialJoinedTopology"]["localTopologyValid"], true);
+    assert_eq!(good["completeOutsideContactAudit"], false);
+    let mut crossing = PointTable::new();
+    for p in [[0.25, 0.25, -1.], [0.25, 0.25, 1.], [0.5, 0.5, 0.]] {
+        crossing.add(p[0], p[1], p[2], 0., 0., 1.);
+    }
+    let bad = join(&a, &[0, 1, 2], &crossing, &[0, 1, 2]).unwrap();
+    assert_eq!(
+        bad["contactingOutsideTrianglesWorkingOrExported"],
+        json!([0])
+    );
+}
