+    let outside=*consumers.iter().find(|v|!v.2).ok_or("paired_outside_consumer")?;
+    let expected_inside:[i64;4]=serde_json::from_value(witness["cell"].clone()).map_err(|_|"paired_inside_encoding")?;
+    if inside.0!=expected_inside {return Err("paired_first_fan_cell");}
+    let inside_leaf=oct.leaves.iter().find(|c|id(c)==inside.0).ok_or("paired_inside_leaf")?;
+    if fan["cellBoxBits"]!=json!(cell_aabb(&oct.lat,inside_leaf.level,inside_leaf.ix,inside_leaf.iy,inside_leaf.iz).map(f64::to_bits)) {
+        return Err("paired_first_fan_cell_box");
+    }
+    let mut global_edge=None;
+    for segment in &record.segments {
