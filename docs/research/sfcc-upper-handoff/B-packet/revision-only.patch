+fn hex(x: f64) -> String {
+    format!("{:016x}", x.to_bits())
+}
+fn node_at<'a>(mut node: &'a CsgNode, path: &[usize]) -> &'a CsgNode {
+    for &i in path {
+        node = match node {
+            CsgNode::Min(c) | CsgNode::Max(c) | CsgNode::Blend { children: c, .. } => &c[i],
+            _ => panic!("fixture source path"),
+        };
+    }
+    node
+}
+fn fixture() -> (CsgNode, Value, SfccWorldCube, PipelineTuning) {
+    let v: Value =
+        serde_json::from_str(include_str!("../../fixtures/shared-arc-full-knob.json")).unwrap();
+    let root =
+        crate::scene_bridge::build_csg_tree_from_json(v["sceneJson"].as_str().unwrap()).unwrap();
+    let cube = SfccWorldCube {
+        min_x: v["cube"]["min"][0].as_f64().unwrap(),
+        min_y: v["cube"]["min"][1].as_f64().unwrap(),
+        min_z: v["cube"]["min"][2].as_f64().unwrap(),
+        size: v["cube"]["max"][0].as_f64().unwrap() - v["cube"]["min"][0].as_f64().unwrap(),
+    };
+    (root, v, cube, PipelineTuning::default())
+}
+fn bits(sample: FieldSample) -> Value {
+    json!({"valueHex":hex(sample.value),"gradientHex":sample.gradient.map(hex)})
+}
+fn same(a: FieldSample, b: FieldSample) {
+    assert_eq!(a.value.to_bits(), b.value.to_bits());
+    assert_eq!(a.gradient.map(f64::to_bits), b.gradient.map(f64::to_bits));
+}
