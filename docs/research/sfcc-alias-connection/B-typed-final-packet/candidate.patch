+            point_id: p["point"].as_u64().unwrap() as usize,
+            t: f64::from_bits(p["parameterBits"].as_u64().unwrap()),
+        })
+        .collect();
+    let segments: Vec<_> = face["segments"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|s| FaceSegment {
+            a: s[0].as_u64().unwrap() as usize,
+            b: s[1].as_u64().unwrap() as usize,
+        })
+        .collect();
+    let n = segments.len();
+    let r = FaceRecord {
+        axis: 1,
+        key,
+        len,
+        segments,
+        pins,
+        interior_cycle: false,
+        consumed_fwd: vec![0; n],
+        consumed_rev: vec![0; n],
+    };
+    let mut live = PointTable::new();
+    let max = r.pins.iter().map(|p| p.point_id).max().unwrap();
+    for id in 0..=max {
+        if let Some(row) = face["targetPins"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .find(|p| p["point"].as_u64().unwrap() as usize == id)
+        {
+            let point: [f64; 3] =
+                std::array::from_fn(|k| f64::from_bits(row["positionBits"][k].as_u64().unwrap()));
+            let chart = row["chart"].as_u64().unwrap();
+            let t = f64::from_bits(row["parameterBits"].as_u64().unwrap());
+            let name = format!("F1:{key}:{chart}:{t:.12}");
+            assert_eq!(
+                live.get_or_create_str(&name, || [point[0], point[1], point[2], 0., 0., 0.]),
