diff --git a/docs/research/sfcc-arrangement-a/cost.mjs b/docs/research/sfcc-arrangement-a/cost.mjs
new file mode 100644
--- /dev/null
+++ b/docs/research/sfcc-arrangement-a/cost.mjs
@@ -0,0 +1,29 @@
+import { readFileSync } from 'node:fs'
+import { pathToFileURL } from 'node:url'
+import assert from 'node:assert/strict'
+const baseline = await import(pathToFileURL(process.argv[2] + '/gcad_wasm.js'))
+const candidate = await import(pathToFileURL(process.argv[3] + '/gcad_wasm.js'))
+for (const [api, dir] of [[baseline,process.argv[2]],[candidate,process.argv[3]]]) api.initSync({ module:readFileSync(dir+'/gcad_wasm_bg.wasm') })
+const box = (pos, half) => ({kind:'box',pos,half})
+const a=box([0,0,0],[3,3,3])
+const fixtures=[['single-box',a,[-10,-10,-10,20]],['duplicate-box4',{kind:'union',children:Array(4).fill(a)},[-10,-10,-10,20]],['duplicate-box16',{kind:'union',children:Array(16).fill(a)},[-10,-10,-10,20]],['clipped-box',{kind:'intersect',lh:box([0,0,0],[1,1,1]),rh:box([-1.75,0,0],[2.25,4,4])},[-4,-4,-4,8]]]
+function canonical(verts,tris,edges) {
+ const bits=new Uint32Array(verts.buffer,verts.byteOffset,verts.length)
+ const point=i=>Array.from(bits.subarray(i*8,i*8+8)).join(',')
+ const triangles=[]
+ for(let i=0;i<tris.length;i+=3) {const p=[point(tris[i]),point(tris[i+1]),point(tris[i+2])];triangles.push([p.join('|'),[p[1],p[2],p[0]].join('|'),[p[2],p[0],p[1]].join('|')].sort()[0])}
+ const curve=[]
+ const f64=x=>{const b=new ArrayBuffer(8),v=new DataView(b);v.setFloat64(0,x,true);return v.getBigUint64(0,true).toString(16)}
+ for(let i=0;i<edges.length;i+=5) {let a=point(edges[i]),b=point(edges[i+1]),s=edges[i+3],t=edges[i+4];if(a>b){[a,b]=[b,a];[s,t]=[t,s]}curve.push([a,b,edges[i+2],f64(s),f64(t)].join('|'))}
+ return {triangles:triangles.sort(),edges:curve.sort()}
+}
+function run(api,scene,cube) {const start=performance.now();const r=api.export_sfcc(scene,'{}',...cube);const ms=performance.now()-start;try {const stats=JSON.parse(r.stats_json);return {ms,...canonical(r.verts,r.tris,r.feature_edges),validation:stats.validation,ok:r.ok}} finally {r.free()}}
+for (const [name,raw,cube] of fixtures) {
+ const scene=JSON.stringify(raw)
+ const first=run(baseline,scene,cube),second=run(candidate,scene,cube)
+ assert.deepEqual({...first,ms:0},{...second,ms:0},name+' must preserve full output')
+ const rows=[]
+ for(let i=0;i<5;i++) {let b,c;if(i%2===0){b=run(baseline,scene,cube);c=run(candidate,scene,cube)}else{c=run(candidate,scene,cube);b=run(baseline,scene,cube)}rows.push({pair:i,baselineMs:b.ms,candidateMs:c.ms})}
+ const median=k=>rows.map(r=>r[k]).sort((a,b)=>a-b)[2]
+ console.log(JSON.stringify({name,rows,baselineMedian:median('baselineMs'),candidateMedian:median('candidateMs'),changePercent:100*(median('candidateMs')/median('baselineMs')-1),unchanged:true}))
+}
