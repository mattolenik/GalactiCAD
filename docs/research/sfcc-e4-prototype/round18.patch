+use super::*;
+use crate::sfcc::face_contour::FaceSegment;
+use serde_json::{json, Value};
+
+fn record(saved: &Value, pins: [FacePin; 2]) -> FaceRecord {
+    FaceRecord {
+        axis: saved["axis"].as_u64().unwrap() as usize,
+        key: saved["key"].as_i64().unwrap(),
+        len: saved["length"].as_i64().unwrap(),
+        segments: saved["segments"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .map(|v| FaceSegment {
+                a: v[0].as_u64().unwrap() as usize,
+                b: v[1].as_u64().unwrap() as usize,
+            })
+            .collect(),
+        pins: pins.to_vec(),
+        interior_cycle: false,
+        consumed_fwd: serde_json::from_value(saved["consumedForward"].clone()).unwrap(),
+        consumed_rev: serde_json::from_value(saved["consumedReverse"].clone()).unwrap(),
+    }
+}
