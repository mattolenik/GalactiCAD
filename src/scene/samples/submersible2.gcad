// Deep-Sea "Luxury" Submersible
// The Abyss-Class Titan — "It's basically a submarine, how hard can it be?"
// Designed by someone who�replaced the engineering team with yes-men


// ═══ PRESSURE HULL ═══
// Why use a proven titanium sphere when you can "innovate"
// with a carbon fibre cylinder? It's lighter! It's cheaper!
// (The engineers who quit said something about "compression loads"
//  but they were just being negative)
let hull = box([8, 8, 22]).shift([0, 0, 0])
let hullRound = sphere.radius(24).shift([0, 0, 0])
let pressureHull = intersect(hull, hullRound).round(3)

// Glued-on titanium endcaps (the only real engineering here)
let endcapTop = sphere.radius(9).shift([0, 0, 20])
let endcapBot = sphere.radius(9).shift([0, 0, -20])

let tube = union(pressureHull, endcapTop, endcapBot).round(2)

// ═══ VIEWPORT ═══
// One single acrylic viewport. Not rated for depth.
// "The supplier said it was fine" (the supplier makes shower doors)
let viewport = sphere.radius(5).shift([10, 0, 0])

// ═══ "FAIRING" ═══
// No hydrodynamic fairing — just bolted-on flat panels
// The intern did the CAD over a weekend
let panelF = box([2, 10, 18]).shift([8, 0, 0])
let panelR = box([10, 2, 18]).shift([0, 8, 0])
let panelL = box([10, 2, 18]).shift([0, -8, 0])
let panelB = box([2, 10, 18]).shift([-8, 0, 0])
let fairing = union(panelF, panelR, panelL, panelB).round(1)

let bodyRaw = union(tube, fairing, viewport).round(2)

// ═══ BALLAST "SYSTEM" ═══
// Bags of sand zip-tied to the outside
// (The ballast engineer was "let go" to save costs)
let sandbag1 = sphere.radius(4).shift([0, 10, -12])
let sandbag2 = sphere.radius(4).shift([0, -10, -12])
let sandbag3 = sphere.radius(3.5).shift([0, 10, 12])
let sandbag4 = sphere.radius(3.5).shift([0, -10, 12])
let sandbag5 = sphere.radius(3).shift([0, 8, 0])
let sandbag6 = sphere.radius(3).shift([0, -8, 0])
let ballast = union(sandbag1, sandbag2, sandbag3, sandbag4, sandbag5, sandbag6)

// ═══ PROPULSION ═══
// A single thruster from a jet ski. Mounted off-centre.
// ("It was on sale!")
let thruster = sphere.radius(4).shift([-10, 3, -14])
let thrusterMount = box([4, 3, 3]).shift([-8, 3, -14])
let propulsion = union(thruster, thrusterMount).round(1)

// ═══ LIFE SUPPORT ═══
// Camping oxygen tanks duct-taped to the roof
// "Each one is good for like two hours. We have four."
let tank1 = sphere.radius(2.5).shift([4, 4, 20])
let tank2 = sphere.radius(2.5).shift([4, -4, 20])
let tank3 = sphere.radius(2.5).shift([-4, 4, 20])
let tank4 = sphere.radius(2.5).shift([-4, -4, 20])
let tanks = union(tank1, tank2, tank3, tank4).round(0.5)

// ═══ LUXURY INTERIOR DOME ═══
// Because what's a sub without a glass observation lounge?
// Rated to 10 metres. We're going to 4,000.
let loungeDome = sphere.radius(8).shift([0, 0, 22])
let loungeFloor = plane.withNormal([0, 0, 1]).shift([0, 0, 20])
let lounge = subtract(loungeDome, loungeFloor)

// ═══ COMMUNICATIONS ═══
// A Starlink dish. Underwater.
// "Elon said it would work" (he did not say that)
let dish = sphere.radius(5).shift([0, 0, 28])
let dishCut = sphere.radius(5).shift([0, 0, 32])
let dishScoop = subtract(dish, dishCut)
let dishMast = box([1, 1, 4]).shift([0, 0, 26])
let comms = union(dishScoop, dishMast).round(0.5)

// ═══ SPONSORSHIP BILLBOARD ═══
// Giant flat panel on the side for the logo
// (adds enormous drag but "the brand needs visibility")
let billboard = box([12, 0.5, 8]).shift([0, 10, 4])

// ═══ "SAFETY" SYSTEM ═══
// A single road flare and a PlayStation controller
// (The backup plan is "thoughts and prayers")
// We'll represent the controller as a small box on top
let controller = box([2, 3, 1]).shift([6, 0, 22])

// ═══ LANDING GEAR ═══
// Shopping trolley wheels. Not joking.
let wheelFR = sphere.radius(2).shift([6, 6, -22])
let wheelFL = sphere.radius(2).shift([6, -6, -22])
let wheelRR = sphere.radius(2).shift([-6, 6, -22])
let wheelRL = sphere.radius(2).shift([-6, -6, -22])
let wheels = union(wheelFR, wheelFL, wheelRR, wheelRL)

// Axles (zip ties, again)
let axleF = box([1, 7, 1]).shift([6, 0, -22])
let axleR = box([1, 7, 1]).shift([-6, 0, -22])

// ═══ DECORATIVE FINS ═══
// Purely cosmetic. The billionaire saw them on a SpaceX render.
// They actually make the hydrodynamics worse.
let finR = rotate([0, 20, 0], box([6, 1, 8]).shift([0, 10, -10]))
let finL = rotate([0, -20, 0], box([6, 1, 8]).shift([0, -10, -10]))
let finTop = box([8, 1, 4]).shift([0, 0, 24])

// ═══ VIP HANDRAIL ═══
// For the Instagram photo op before boarding
// Structurally does nothing. Cost $40,000.
let railR = box([1, 1, 14]).shift([8, 6, 8])
let railL = box([1, 1, 14]).shift([8, -6, 8])
let railTop = box([1, 7, 1]).shift([8, 0, 20])
let handrail = union(railR, railL, railTop).round(0.5)

// ═══ ASSEMBLY ═══
let structure = union(bodyRaw, lounge, comms, billboard, controller).round(1)
let externals = union(ballast, propulsion, tanks, handrail)
let landing = union(wheels, axleF, axleR)
let fins = union(finR, finL, finTop)

return union(structure, externals, landing, fins).round(1)
