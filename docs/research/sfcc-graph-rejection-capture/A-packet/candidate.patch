+        if points.count().saturating_sub(self.before_count)>POINT_CAP {self.incomplete=Some("added_point_cap");}
+        else {self.point_ids.extend(self.before_count..points.count());}
+        self.report["queryAttemptEnd"]=json!(super::QUERY_LOG.with(|s|s.borrow().as_ref().map(|q|q.attempts.len())));
+        self.report["rejection"]=json!({"code":code,"operands":operands});
+        self.report["pointCountAtRejection"]=json!(points.count());
+        self.report["sortedPaths"]=json!(self.paths);
+        self.report["completedRotations"]=json!(self.rotations);
+        if let Some(payloads)=point_payloads(&self.point_ids,points) {self.report["pointsAtRejection"]=json!(payloads);} else {self.incomplete=Some("rejection_point_cap_or_key");}
+        self.report["completeObservedState"]=json!(self.incomplete.is_none());
+        self.report["incompleteReason"]=json!(self.incomplete);
+        self.report["limits"]=json!({"bytes":BYTE_CAP,"points":POINT_CAP,"graphItems":ITEM_CAP,"paths":128,"sourceDescriptorEntries":4096,"sourceDescriptorDepth":16,"keyBytes":128});
+        if !fits(&self.report) {
+            self.report=json!({"cell":self.report["cell"],"rejection":self.report["rejection"],"completeObservedState":false,"incompleteReason":"serialized_byte_cap","exactReplayEstablished":false});
+        }
+        super::DIAGNOSTIC.with(|s| {if let Some(r)=s.borrow_mut().as_mut(){r["featureGraphCaptureA"]=self.report;}});
+    }
+}
+fn point_payloads(ids:&BTreeSet<usize>,points:&PointTable)->Option<Vec<Value>> {
+    if ids.len()>POINT_CAP || ids.iter().any(|&id| id>=points.count() || matches!(points.key_at(id),PointKey::Str(s) if s.len()>128)) {return None;}
+    Some(ids.iter().map(|&id|{
+        let key=match points.key_at(id){PointKey::Num(n)=>json!({"numericDecimal":n.to_string()}),PointKey::Str(s)=>json!({"string":s}),PointKey::Unkeyed=>json!({"unkeyed":true})};
+        json!({"id":id,"key":key,"positionHex":[points.x(id),points.y(id),points.z(id)].map(bits),"normalHex":[points.nx(id),points.ny(id),points.nz(id)].map(bits)})
+    }).collect())
+}
