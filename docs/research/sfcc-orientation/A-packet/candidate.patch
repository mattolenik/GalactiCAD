+// This selector only chooses diagnostic evidence; it never changes geometry authority.
+fn orientation_target() -> bool {
+    DIAGNOSTIC.with(|s| {
+        s.borrow()
+            .as_ref()
+            .is_some_and(|v| v["graphContextB"]["cell"] == json!([7, 25, 58, 86]))
+    })
+}
+pub(crate) fn orientation_note(stage: &'static str, record: impl FnOnce() -> Value) {
+    if !orientation_target() {
+        return;
+    }
+    DIAGNOSTIC.with(|s| {
+        if let Some(v)=s.borrow_mut().as_mut() {
+            if v["orientationCaptureA"].is_null() {
+                v["orientationCaptureA"]=json!({"scope":"selected successful cell graph/patch provenance; observational, no added geometry queries","preGraph":v["graphCaptureB"],"events":[],"complete":true,"byteCap":CAP});
+            }
+            let capture=&mut v["orientationCaptureA"];
+            if capture["complete"]!=json!(true) { return; }
+            let events=capture["events"].as_array_mut().unwrap();
+            if events.len()>=128 {
+                capture["complete"]=json!(false);capture["refusal"]=json!("orientation_event_cap");return;
+            }
+            events.push(json!({"stage":stage,"data":record()}));
+            let checked=bounded(capture.take());
+            *capture=checked;
+        }
+    });
+}
+pub(crate) fn orientation_points(points: &PointTable, start: usize) -> Value {
+    if start > points.count() || !points_supported(points) {
+        return json!({"complete":false,"refusal":"orientation_point_cap"});
+    }
+    json!({"complete":true,"points":(start..points.count()).map(|id|point_record(points,id)).collect::<Vec<_>>()})
 }
