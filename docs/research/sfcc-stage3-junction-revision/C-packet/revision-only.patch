+#[test]
+fn junction_revision_c_captures_lower_frontier_without_changing_compilation() {
+    let fixture: Value =
+        serde_json::from_str(include_str!("../../fixtures/shared-arc-full-knob.json")).unwrap();
+    let root = build_csg_tree_from_json(fixture["sceneJson"].as_str().unwrap()).unwrap();
+    let size =
+        fixture["cube"]["max"][0].as_f64().unwrap() - fixture["cube"]["min"][0].as_f64().unwrap();
+    let tol = resolve_tolerances(&SfccTuning::default(), 3_f64.sqrt() * size);
+    let (before, before_diag) = compile_feature_set(&root, &tol);
+    CAPTURE.with(|c| c.borrow_mut().enabled = true);
+    let guard = Scope;
+    let (after, after_diag) = compile_feature_set(&root, &tol);
+    let report=CAPTURE.with(|c| {let c=c.borrow();json!({"scope":"test-only original-source lower-junction finite-query and frontier capture; no certificate or runtime repair",
+        "sourceConfigSha256":fixture["sourceConfigSha256"],"lowerPointHex":lower().map(hex),"tolerancesHex":{"probeDelta":hex(tol.probe_delta),"curveEps":hex(tol.curve_eps),"cornerMerge":hex(tol.corner_merge_tol)},
+        "sources":c.source,"rawCurves":c.raw,"queries":c.queries,"frontiers":c.frontiers,"runs":c.runs,
+        "observationalFingerprintEqual":before.fingerprint()==after.fingerprint(),"explicitPublicCurveCornerRefineValuesEqual":equal,
+        "lowerJoint":{"preserved":preserved,"nearestCorner":nearest.id,"pointHex":[nearest.x,nearest.y,nearest.z].map(hex),"distanceHex":hex(distance([nearest.x,nearest.y,nearest.z],lower())),"expectedSourcePairs":expected,"actualSourcePairs":actual,"incidentEnds":nearest.curve_ends},"runtimeCandidateAccepted":false,"unresolvedBefore":before_diag.unresolved_trims,"unresolvedAfter":after_diag.unresolved_trims,
+        "noJunctionAuthorityGranted":true,"intervalEquivalenceEstablished":false})});
+    let bytes = serde_json::to_vec_pretty(&report).unwrap();
+    std::fs::write(
+        std::env::var("SFCC_JUNCTION_C_RECEIPT").expect("receipt path required"),
+        &bytes,
+    )
+    .unwrap();
+    assert!(
+        bytes.len() <= 512 * 1024,
+        "capture exceeds declared 512KiB cap"
+    );
+    assert!(
+        equal,
+        "observing queries must preserve explicit compiled values"
+    );
+    assert_eq!(before.fingerprint(), after.fingerprint());
+    assert_eq!(before_diag.unresolved_trims, after_diag.unresolved_trims);
+    assert!(!report["queries"].as_array().unwrap().is_empty());
+    assert!(report["rawCurves"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .any(|r| r["sourcePair"] == json!([31, 10]) || r["sourcePair"] == json!([10, 31])));
+    drop(guard);
+    assert!(!CAPTURE.with(|c| c.borrow().enabled));
+}
+#[test]
+fn junction_revision_c_scope_resets_after_unwind() {
+    let result = std::panic::catch_unwind(|| {
+        CAPTURE.with(|c| c.borrow_mut().enabled = true);
+        let _guard = Scope;
+        panic!("scope control");
+    });
+    assert!(result.is_err());
+    assert!(!CAPTURE.with(|c| c.borrow().enabled));
+}
