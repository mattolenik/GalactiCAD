+fn captured_bits(row:&Value)->Result<[u64;3]> {
+    let values=row["positionHex"].as_array().ok_or("second_capture_point_bits")?;
+    if values.len()!=3 {return Err("second_capture_point_bits");}
+    let mut bits=[0;3];
+    for k in 0..3 {bits[k]=values[k].as_str().and_then(|v|u64::from_str_radix(v,16).ok()).ok_or("second_capture_point_bits")?;}
+    if bits.iter().any(|&v|!f64::from_bits(v).is_finite()) {return Err("second_capture_point_bits");}
+    Ok(bits)
+}
+fn inside_fans_from_orientation(capture:&Value,features:&SfccFeatureSet,candidate:&PrivateCandidate)->Result<Value> {
+    let graph=&capture["preGraph"];
+    if capture["complete"]!=true || graph["complete"]!=true {return Err("second_orientation_capture_incomplete");}
+    let events=capture["events"].as_array().ok_or("second_orientation_events")?;
+    if events.len()>128 {return Err("second_orientation_event_cap");}
+    let mut graph_events=events.iter().filter(|e|e["stage"]=="graph");
+    let initial=graph_events.next().ok_or("second_orientation_graph")?;
+    if graph_events.next().is_some() || initial["data"]["points"]["complete"]!=true {return Err("second_orientation_graph");}
+    let mut success=events.iter().filter(|e|e["stage"]=="success");
+    let final_event=success.next().ok_or("second_orientation_success")?;
+    if success.next().is_some() || final_event["data"]["retainedUnresolved"]!=false {return Err("second_orientation_success");}
+    let graph_triangles:Vec<usize>=serde_json::from_value(final_event["data"]["triangles"].clone()).map_err(|_|"second_orientation_triangles")?;
+    if graph_triangles.is_empty() || graph_triangles.len()>3*4096 || graph_triangles.len()%3!=0
+        || graph_triangles.chunks_exact(3).any(|t|!candidate.triangles.chunks_exact(3).any(|c|c==t)) {return Err("second_orientation_not_emitted");}
+    let mut captured=BTreeMap::new();
+    let mut append=|rows:&Value|->Result<()> {
+        let rows=rows.as_array().ok_or("second_orientation_points")?;
+        if rows.len()>1024 {return Err("second_orientation_point_cap");}
+        for row in rows {
+            let id=row["id"].as_u64().ok_or("second_orientation_point")? as usize;let bits=captured_bits(row)?;
+            if id>=candidate.points.count() || q::pos(&candidate.points,id).map(f64::to_bits)!=bits
+                || captured.insert(id,bits).is_some_and(|old|old!=bits) || captured.len()>1024 {return Err("second_orientation_point_binding");}
+        }
+        Ok(())
+    };
+    append(&initial["data"]["points"]["points"])?;
+    for event in events.iter().filter(|e|e["stage"]=="patch_output") {
+        if event["data"]["newPoints"]["complete"]!=true {return Err("second_orientation_new_points");}
+        append(&event["data"]["newPoints"]["points"])?;
+    }
+    drop(append);
+    let mut box_bits=[0u64;6];
+    for k in 0..6 {box_bits[k]=graph["pre"]["cellBoxHex"][k].as_str().and_then(|v|u64::from_str_radix(v,16).ok()).ok_or("second_orientation_cell_box")?;}
+    let mut fans=Vec::new();let mut emitted=Vec::new();
+    for event in events.iter().filter(|e|e["stage"]=="patch_output") {
+        if fans.len()>=128 {return Err("second_orientation_fan_cap");}
+        let data=&event["data"];let sid=data["stratum"].as_u64().ok_or("second_orientation_stratum")? as usize;
+        let stratum=features.strata.get(sid).ok_or("second_orientation_stratum")?;
+        let identity=stratum.graph_capture_identity_b().ok_or("second_orientation_stratum")?;
+        let strata=graph["pre"]["strata"].as_array().ok_or("second_orientation_strata")?;
+        if strata.len()>128 || strata.iter().filter(|s|s["id"].as_u64()==Some(sid as u64) && **s==identity).count()!=1 {return Err("second_orientation_source_binding");}
+        let boundary:Vec<usize>=serde_json::from_value(data["polygon"].clone()).map_err(|_|"second_orientation_boundary")?;
+        let triangles:Vec<usize>=serde_json::from_value(data["triangles"].clone()).map_err(|_|"second_orientation_triangles")?;
+        if boundary.len()>64 || triangles.len()>3*128 || data["fanReturned"]!=true
+            || data["triangleStart"].as_u64()!=Some((emitted.len()/3) as u64) {return Err("second_orientation_patch_output");}
+        emitted.extend_from_slice(&triangles);
+        let ids:BTreeSet<_>=boundary.iter().chain(&triangles).copied().collect();
+        if ids.len()>128 {return Err("second_orientation_patch_points");}
+        let mut points=Vec::new();for id in ids {points.push(json!({"id":id,"positionBits":captured.get(&id).ok_or("second_orientation_patch_point_missing")?}));}
+        let mut tolerance=[0.;2];for (k,key) in ["surfaceTolHex","chordTolHex"].iter().enumerate() {
+            tolerance[k]=f64::from_bits(graph["pre"]["options"][*key].as_str().and_then(|v|u64::from_str_radix(v,16).ok()).ok_or("second_orientation_option")?);
+            if !tolerance[k].is_finite() || tolerance[k]<=0. {return Err("second_orientation_option");}
+        }
+        let fan=json!({"hypothesisStratum":sid,"carrierKind":format!("{:?}",stratum.kind),"sourceIdentity":identity,
+            "boundary":boundary,"triangles":triangles,"returned":true,"points":points,"cellBoxBits":box_bits,
+            "surfaceTolerance":tolerance[0],"chordTolerance":tolerance[1],"qualityTriangulation":graph["pre"]["options"]["qualityTriangulation"],
+            "continuousSourceOwnershipProved":false});
+        require_final_fan(&fan,&candidate.triangles,&candidate.points)?;
+        fans.push(fan);
+    }
+    if fans.is_empty() || emitted!=graph_triangles {return Err("second_orientation_patch_coverage");}
+    Ok(json!({"scope":"existing bounded orientation capture bound to final emitted candidate geometry; no new capture channel or queries",
+        "cell":graph["context"]["cell"],"cellBoxBits":box_bits,"complete":true,"pairedFans":fans}))
+}
