+        }
+    }
+    let report = json!({"scope":"interval certificate over box enclosing both precision triangles; source facets and normal cone, no wholecell patch assignment or numerical chart correspondence",
+ "fixtureReceiptSha256":captured["receiptSha256"],"box":[lo,hi],"sourceRoles":source,"common":cert.common,"marginOrder":["finite profile","native cap","cylinder cap","groove projection","groove other edges","inner round","cap cutter","outer sphere"],"margins":cert.margins,"facetIntervals":cert.fields.map(bounds_b),"facetGradientIntervals":cert.gradients.map(|g|g.map(bounds_b)),"nativeGrooveTransverseComponentLower":cert.rank,"normalStages":stages,"nativeChamferCurves":native,"aliasChamferCurves":alias,"nativeAndInnerFieldIdenticalOnBox":true,"sameCommonCarrierPreserved":true,"rawChartTransportProved":false,"sourcePatchAssignmentAuthorized":false});
+    let base = std::env::var("SFCC_ORIENTATION_B_RECEIPT").unwrap();
