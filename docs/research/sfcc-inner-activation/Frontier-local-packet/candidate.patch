+}
+fn options<'a>(features: &'a SfccFeatureSet, capture: &Value) -> CellMeshOptions<'a> {
+    let p = &capture["probe"]["graphEvidence"]["graphCaptureB"]["pre"]["options"];
+    assert_eq!(p["interiorMode"], "Project");
+    CellMeshOptions {
+        surface_tol: number(&p["surfaceTolHex"]),
+        curve_chord_tol: number(&p["chordTolHex"]),
+        interior_vertex_mode: InteriorVertexMode::Project,
+        quality_triangulation: p["qualityTriangulation"].as_bool().unwrap(),
+        project_max_iters: p["projectMaxIters"].as_u64().unwrap() as u32,
+        max_polyline_points_per_cell: p["maxPolylinePoints"].as_u64().unwrap() as usize,
+        features: Some(features),
+    }
+}
