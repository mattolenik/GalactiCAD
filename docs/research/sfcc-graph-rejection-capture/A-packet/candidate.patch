+#[cfg(test)]
+mod lifecycle_tests {
+    use super::*;
+    #[test]
+    fn graph_capture_a_truncation_and_cell_binding_do_not_leak() {
+        let tree=crate::sdf::leaf_at(crate::sdf::Shape::Sphere{r:1.},[0.;3]);
+        let f=crate::sfcc::feature_set::compile_native_features(&tree);
+        let points=PointTable::new();
+        let opts=CellMeshOptions{surface_tol:0.01,interior_vertex_mode:crate::sfcc::cell_mesh::InteriorVertexMode::Project,quality_triangulation:false,project_max_iters:8,curve_chord_tol:0.02,max_polyline_points_per_cell:16,features:Some(&f)};
+        assert!(Capture::begin(&[],&[],&[],&[0.;6],&points,&opts,&f).is_none());
+        let (_,report)=with_test_diagnostic(|| {
+            let capture=Capture::begin(&vec![vec![];65],&[],&[],&[0.;6],&points,&opts,&f).unwrap();
+            capture.reject("synthetic_limit",json!({}),&points);
+        });
+        assert_eq!(report["featureGraphCaptureA"]["completeObservedState"],false);
+        assert_eq!(report["featureGraphCaptureA"]["incompleteReason"],"pre_call_item_cap");
+        let (_,report)=with_test_diagnostic(|| {
+            let capture=Capture::begin(&[],&[],&[],&[0.;6],&points,&opts,&f).unwrap();
+            capture.reject("empty_loops",json!({}),&points);
+            super::super::note_active_cell(&crate::sfcc::octree::SfccCell{level:1,ix:0,iy:0,iz:0,key:0,degenerate:false,feature_curve:-1,feature_corner:-1});
+        });
+        assert!(report.get("featureGraphCaptureA").is_none());
+        let (_,report)=with_test_diagnostic(|| {drop(Capture::begin(&[],&[],&[],&[0.;6],&points,&opts,&f));});
+        assert!(report.get("featureGraphCaptureA").is_none());
+        assert!(Capture::begin(&[],&[],&[],&[0.;6],&points,&opts,&f).is_none());
+    }
+}
