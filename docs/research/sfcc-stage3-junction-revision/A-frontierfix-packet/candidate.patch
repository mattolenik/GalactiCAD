+#[cfg(all(test, feature = "serde"))]
+mod exposure_a_endpoint_tests {
+    use super::*;
+    #[test]
+    fn exposure_a_uncertain_endpoint_cannot_snap_to_an_existing_corner() {
+        let candidates = [Candidate {
+            x: 1.,
+            y: 2.,
+            z: 3.,
+        }];
+        assert_eq!(
+            endpoint_candidate(false, &candidates, [1., 2., 3.], 0.1, |_| true),
+            0
+        );
+        assert_eq!(
+            endpoint_candidate(true, &candidates, [1., 2., 3.], 0.1, |_| panic!(
+                "uncertain endpoint must not seek corner authority"
+            )),
+            -1
+        );
+    }
+    #[test]
+    fn exposure_a_frontier_retains_raw_orientation_and_work_exhaustion() {
+        let c = make_segment_curve(0, -1, [0, 1], 0., 0., 0., 1., 0., 0.);
+        let mut tol =
+            crate::tolerances::resolve_tolerances(&crate::tuning::SfccTuning::default(), 1.);
+        tol.corner_merge_tol = 0.;
+        for (alive, other) in [(0., 1.), (1., 0.)] {
+            let (end, frontier) = bisect_transition_bounded(
+                &|_| panic!("zero budget"),
+                &c,
+                alive,
+                other,
+                false,
+                &tol,
+                0,
+            );
+            assert_eq!(end, alive);
+            assert_eq!(
+                frontier,
+                Some(TrimFrontier {
+                    initial_alive: alive,
+                    initial_other: other,
+                    initial_other_status: FrontierOtherStatus::Inactive,
+                    alive,
+                    other,
+                    other_status: FrontierOtherStatus::Inactive,
+                    reason: FrontierReason::WorkLimit
+                })
+            );
+        }
+        let (end, frontier) = bisect_transition_bounded(&|_| Ok(true), &c, 0., 1., false, &tol, 40);
+        let frontier = frontier.expect("exhaustion cannot authorize a corner");
+        assert_eq!(frontier.reason, FrontierReason::WorkLimit);
+        assert_eq!(frontier.alive, end);
+        assert!(frontier.alive < frontier.other);
+        let (_, frontier) =
+            bisect_transition_bounded(&|_| Ok(false), &c, 1., 1_f64.next_up(), false, &tol, 40);
+        assert_eq!(frontier.unwrap().reason, FrontierReason::Stagnation);
+        tol.corner_merge_tol = 0.1;
+        let (end, frontier) = bisect_transition_bounded(&|_| Err(()), &c, 0., 1., true, &tol, 40);
+        let frontier = frontier.unwrap();
+        assert_eq!(frontier.reason, FrontierReason::UndecidableClassification);
+        assert_eq!(frontier.alive, end);
+        assert_eq!(end, 0.);
+        assert!(frontier.other > 0. && frontier.other < 1.);
+    }
+    #[test]
+    fn exposure_a_frontier_keeps_initial_container_when_unknown_bisection_discards_junction() {
+        let c = make_segment_curve(0, -1, [0, 1], 0., 0., 0., 1., 0., 0.);
+        let mut tol =
+            crate::tolerances::resolve_tolerances(&crate::tuning::SfccTuning::default(), 1.);
+        tol.corner_merge_tol = 0.04;
+        let initial = 0.2426778243;
+        for sign in [1., -1.] {
+            let map = |t: f64| if sign > 0. { t } else { 1. - t };
+            let classify = |t: f64| if map(t) > 0.01 { Ok(true) } else { Err(()) };
+            let (_, frontier) =
+                bisect_transition_bounded(&classify, &c, map(initial), map(0.), true, &tol, 40);
+            let frontier = frontier.unwrap();
+            let junction = map(0.);
+            assert_eq!(frontier.initial_alive, map(initial));
+            assert_eq!(frontier.initial_other, junction);
+            assert_eq!(frontier.initial_other_status, FrontierOtherStatus::Unknown);
+            assert_eq!(frontier.other_status, FrontierOtherStatus::Unknown);
+            assert!(
+                junction < frontier.alive.min(frontier.other)
+                    || junction > frontier.alive.max(frontier.other),
+                "the adversarial true junction is outside the final bracket"
+            );
+            assert!(
+                junction >= frontier.initial_alive.min(frontier.initial_other)
+                    && junction <= frontier.initial_alive.max(frontier.initial_other)
+            );
+        }
+        // An initially inactive sample may later meet uncertainty; preserve both facts.
+        let (_, frontier) =
+            bisect_transition_bounded(&|_| Err(()), &c, initial, 0., false, &tol, 40);
+        let frontier = frontier.unwrap();
+        assert_eq!(frontier.initial_other_status, FrontierOtherStatus::Inactive);
+        assert_eq!(frontier.other_status, FrontierOtherStatus::Unknown);
+    }
