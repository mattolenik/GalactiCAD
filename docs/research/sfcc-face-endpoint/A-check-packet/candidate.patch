+//! Source-bound feature endpoint images; no mesh mutation or raw-parameter continuity claim.
+use super::*;
+use serde_json::{json, Value};
+
+type Image = [I; 3];
+fn quotient(a: I, b: I) -> Option<I> {
+    if b.lo <= 0. && b.hi >= 0. {
+        return None;
+    }
+    mul(a, interval((1. / b.hi).next_down(), (1. / b.lo).next_up())?)
+}
+fn bounds(p: Image) -> [[f64; 3]; 2] {
+    [p.map(|v| v.lo), p.map(|v| v.hi)]
+}
+fn midpoint_image(p: Image) -> [f64; 3] {
+    p.map(|v| v.lo * 0.5 + v.hi * 0.5)
+}
+fn abs_lower(v: I) -> f64 {
+    if v.lo > 0. {
+        v.lo
+    } else if v.hi < 0. {
+        -v.hi
+    } else {
+        0.
+    }
+}
+fn distance(a: Image, b: Image) -> Option<[f64; 2]> {
+    let mut lo = I::point(0.);
+    let mut hi = I::point(0.);
+    for k in 0..3 {
+        let d = a[k].sub(b[k])?;
+        lo = lo.add(square(I::point(abs_lower(d)))?)?;
+        hi = hi.add(square(d)?)?;
+    }
+    Some([sqrt(lo)?.lo, sqrt(hi)?.hi])
+}
+fn contains(tube: ([f64; 3], [f64; 3]), image: Image) -> bool {
+    (0..3).all(|k| image[k].lo >= tube.0[k] && image[k].hi <= tube.1[k])
+}
+struct Source<'a> {
+    f: &'a SfccFeatureSet,
+    source: [usize; 3],
+    chart: usize,
+    cylinder_id: usize,
+    compound_id: usize,
+    center: [f64; 3],
+    radius: f64,
+    half: f64,
+    p: TwistedSideParams,
+    native: &'a Leaf,
+    other: &'a Leaf,
+    groove: &'a Leaf,
+    cap: &'a Leaf,
+    sphere: &'a Leaf,
+    inner_radius: f64,
+    chamfer_radius: f64,
+    outer_radius: f64,
+    weight: f64,
+    offset: f64,
+}
+impl<'a> Source<'a> {
+    fn bind(f: &'a SfccFeatureSet, chart: usize) -> Option<Self> {
+        let curve = f.curves.get(chart)?;
+        if curve.id != chart
+            || curve.closed
+            || !curve.t_min.is_finite()
+            || !curve.t_max.is_finite()
+            || curve.t_min >= curve.t_max
+        {
+            return None;
+        }
+        let (source, _, _) = alias_face_b::select(f)?;
+        let cylinder_id = curve.adjacent_strata.iter().copied().find(|&id| {
+            f.strata
+                .get(id)
+                .is_some_and(|s| s.certificate_cylinder().is_some())
+        })?;
+        let compound_id = *curve
+            .adjacent_strata
+            .iter()
+            .find(|&&id| id != cylinder_id)?;
+        let cyl = f.strata.get(cylinder_id)?;
+        let (center, axis, radius) = cyl.certificate_cylinder()?;
+        if axis != [0., 1., 0.] || cyl.sign != 1. || !radius.is_finite() || radius < 1e-6 {
+            return None;
+        }
+        let root = cyl.exposure_root_a()?;
+        let (cap_cut, sphere, outer_radius) =
+            pair(root, Some((BlendKind::Smax, SminMode::Round))).ok()?;
+        let (cut, cap, _) = pair(cap_cut, None).ok()?;
+        let (hard, groove_node, chamfer_radius) =
+            pair(cut, Some((BlendKind::Smax, SminMode::Chamfer))).ok()?;
+        let (inner, cylinder, _) = pair(hard, None).ok()?;
+        let (other, native, inner_radius) =
+            pair(inner, Some((BlendKind::Smin, SminMode::Round))).ok()?;
+        let cylinder = leaf(cylinder, 1.).ok()?;
+        let native = leaf(native, 1.).ok()?;
+        let other = leaf(other, 1.).ok()?;
+        let groove = leaf(groove_node, -1.).ok()?;
+        let cap = leaf(cap, -1.).ok()?;
+        let sphere = leaf(sphere, 1.).ok()?;
+        let (p, rn, ro, rr) = f.strata[source[0]].round_twisted_source(&f.strata[source[1]])?;
+        let registered = cyl.correlated_cylinder_source_c(&f.strata[source[0]])?;
+        let (weight, offset) =
+            f.strata
+                .get(compound_id)?
+                .connection_compound(hard, groove_node, cut)?;
+        if !std::ptr::eq(cylinder, registered)
+            || !std::ptr::eq(native, rn)
+            || !std::ptr::eq(other, ro)
+            || rr != inner_radius
+            || cylinder.pos != center
+            || [native, other, groove, sphere]
+                .iter()
+                .any(|l| l.pos[0] != center[0] || l.pos[2] != center[2])
+        {
+            return None;
+        }
+        let Shape::Cylinder { r, h } = cylinder.shape else {
+            return None;
+        };
+        if r != radius || !h.is_finite() || h < 1e-6 {
+            return None;
+        }
+        let (sa, sb, _) = curve.traced_carriers()?;
+        if !((sa.connection_same_source(&f.strata[compound_id]) && sb.connection_same_source(cyl))
+            || (sb.connection_same_source(&f.strata[compound_id])
+                && sa.connection_same_source(cyl)))
+        {
+            return None;
+        }
+        Some(Self {
+            f,
+            source,
+            chart,
+            cylinder_id,
+            compound_id,
+            center,
+            radius,
+            half: h,
+            p,
+            native,
+            other,
+            groove,
+            cap,
+            sphere,
+            inner_radius,
+            chamfer_radius,
+            outer_radius,
+            weight,
+            offset,
+        })
+    }
+    fn source_margins(&self, rho: I, image: Image) -> Option<Value> {
+        let y = image[1];
+        let x = image[0].sub(I::point(self.center[0]))?;
+        let z = image[2].sub(I::point(self.center[2]))?;
+        let ly = y.sub(I::point(self.p.pos_y))?;
+        if !self.p.h.is_finite() || self.p.h <= 0. || ly.lo < -self.p.h || ly.hi > self.p.h {
+            return None;
+        }
+        let theta = div(ly.add(I::point(self.p.h))?, 2. * self.p.h)?.mul(self.p.twist_rad)?;
+        let (sn, cs) = sin_cos(theta)?;
+        let u = mul(x, cs)?.add(mul(z, sn)?)?;
+        let v = mul(z, cs)?.sub(mul(x, sn)?)?;
+        let e = u
+            .sub(I::point(self.p.v0x))?
+            .mul(self.p.nx2)?
+            .add(v.sub(I::point(self.p.v0z))?.mul(self.p.nz2)?)?;
+        let profile = upper_source_a::finite_profile_level(self.p, self.native, [u, v], e)?;
+        let native_cap = upper_source_a::cap_margin(y, self.p.pos_y, self.p.h, e)?;
+        let c = rho.sub(I::point(self.radius))?;
+        let cylinder_cap = upper_source_a::cap_margin(y, self.center[1], self.half, c)?;
+        let other = activation_a::meridian_bound(self.other, rho, y)?;
+        let groove = activation_a::meridian_bound(self.groove, rho, y)?;
+        if other.distance.lo <= self.inner_radius
+            || e.hi >= self.inner_radius
+            || e.hi >= c.lo
+            || groove.distance.lo <= 0.
+        {
+            return None;
+        }
+        let Shape::Extrude { h: ch, .. } = self.cap.shape else {
+            return None;
+        };
+        let cap = I::point(self.cap.pos[1]).sub(I::point(ch))?.sub(y)?.lo;
+        let Shape::Sphere { r: sr } = self.sphere.shape else {
+            return None;
+        };
+        let sphere = I::point(sr)
+            .sub(I::point(self.outer_radius))?
+            .sub(sqrt(
+                square(rho)?.add(square(y.sub(I::point(self.sphere.pos[1]))?)?)?,
+            )?)?
+            .lo;
+        if cap <= 0. || sphere <= 0. {
+            return None;
+        }
+        Some(
+            json!({"nativeLevel":[e.lo,e.hi],"cylinderLevel":[c.lo,c.hi],"nativeStrictlyBelowCylinder":true,"otherDistance":[other.distance.lo,other.distance.hi],
+            "grooveDistance":[groove.distance.lo,groove.distance.hi],"grooveEdge":groove.edge,"nativeFiniteProfileMargin":profile,"nativeCapMargin":native_cap,
+            "cylinderCapMargin":cylinder_cap,"capCutMargin":cap,"outerRoundMargin":sphere}),
+        )
+    }
+    fn feature(
+        &self,
+        branch: activation_a::MeridianBound,
+        level: I,
+        fixed_axis: usize,
+        fixed: f64,
+    ) -> Option<(Image, Value)> {
+        if !fixed.is_finite() || !matches!(fixed_axis, 0 | 2) {
+            return None;
+        }
+        let rho = I::point(self.radius);
+        let y = quotient(
+            level.sub(mul(branch.nr, rho)?)?.sub(branch.offset)?,
+            branch.ny,
+        )?;
+        let rfixed = I::point(fixed).sub(I::point(self.center[fixed_axis]))?;
+        let radical = square(rho)?.sub(square(rfixed)?)?;
+        if radical.lo <= 0. {
+            return None;
+        }
+        let free = sqrt(radical)?;
+        let image = if fixed_axis == 0 {
+            if rfixed.hi >= 0. {
+                return None;
+            }
+            [I::point(fixed), y, free.add(I::point(self.center[2]))?]
+        } else {
+            if rfixed.lo <= 0. {
+                return None;
+            }
+            [
+                free.mul(-1.)?.add(I::point(self.center[0]))?,
+                y,
+                I::point(fixed),
+            ]
+        };
+        let check = activation_a::meridian_bound(self.groove, rho, y)?;
+        if check.edge != branch.edge || abs_lower(branch.ny) <= 0. {
+            return None;
+        }
+        let margins = self.source_margins(rho, image)?;
+        let free_component = if fixed_axis == 0 {
+            image[2].sub(I::point(self.center[2]))?
+        } else {
+            image[0].sub(I::point(self.center[0]))?
+        };
+        let determinant = mul(quotient(free_component, rho)?, branch.ny)?;
+        if abs_lower(determinant) <= 0. {
+            return None;
+        }
+        Some((
+            image,
+            json!({"margins":margins,"fixedAxis":fixed_axis,"fixedCoordinateBits":fixed.to_bits(),"image":bounds(image),
+            "radius":self.radius,"grooveLevelBounds":[level.lo,level.hi],"finiteBranch":branch.edge,"constraintJacobianAbsLower":abs_lower(determinant),
+            "correlation":"rho=R and nr*R+ny*Y+offset=level by construction; interval re-evaluation need not produce exact zero"}),
+        ))
+    }
+    fn surface_lift(
+        &self,
+        branch: activation_a::MeridianBound,
+        point: [f64; 3],
+    ) -> Option<(Image, Value)> {
+        let y = I::point(point[1]);
+        let z = I::point(point[2]);
+        let denominator = I::point(1.).sub(branch.nr)?;
+        if denominator.lo <= 0. {
+            return None;
+        }
+        let qrho = quotient(
+            I::point(self.radius)
+                .add(mul(branch.ny, y)?)?
+                .add(branch.offset)?
+                .sub(I::point(self.chamfer_radius))?,
+            denominator,
+        )?;
+        let rho = interval(self.radius.min(qrho.lo), self.radius.min(qrho.hi))?;
+        let radical = square(rho)?.sub(square(z.sub(I::point(self.center[2]))?)?)?;
+        if radical.lo <= 0. {
+            return None;
+        }
+        let image = [
+            sqrt(radical)?.mul(-1.)?.add(I::point(self.center[0]))?,
+            y,
+            z,
+        ];
+        let check = activation_a::meridian_bound(self.groove, rho, y)?;
+        if check.edge != branch.edge {
+            return None;
+        }
+        let margins = self.source_margins(rho, image)?;
+        Some((
+            image,
+            json!({"image":bounds(image),"rhoBounds":[rho.lo,rho.hi],"chamferZeroRadiusBounds":[qrho.lo,qrho.hi],"margins":margins,
+            "zeroArgument":"native below cylinder, groove negative: max(C,w*(C-d+r))=0 uniquely at rho=min(R,rho_Q(Y)) on admitted negative-X branch",
+            "fullPhysicalSourceZeroProved":true,"sameYZAsOriginalPoint":true}),
+        ))
+    }
+}
+
+pub(crate) fn endpoint_geometry(
+    f: &SfccFeatureSet,
+    chart: usize,
+    point: [f64; 3],
+    face_x: f64,
+) -> Option<Value> {
+    if point.iter().any(|v| !v.is_finite()) {
+        return None;
+    }
+    let source = Source::bind(f, chart)?;
+    let branch =
+        activation_a::meridian_bound(source.groove, I::point(source.radius), I::point(point[1]))?;
+    let physical = I::point(source.chamfer_radius);
+    let generated = div(I::point(source.offset), source.weight)?;
+    let (face, face_report) = source.feature(branch, physical, 0, face_x)?;
+    let (generated_face, generated_report) = source.feature(branch, generated, 0, face_x)?;
+    let (fixed_z, fixed_z_report) = source.feature(branch, physical, 2, point[2])?;
+    let (surface, surface_report) = source.surface_lift(branch, point)?;
+    let original = point.map(I::point);
+    let feature_height_gap = I::point(point[1]).sub(face[1])?;
+    let (candidate, radius_label) = (
+        midpoint_image(face),
+        "physical feature and original X-face root",
+    );
+    Some(
+        json!({"scope":"source-bound endpoint images and pointwise comparison only; no raw parameter continuity or mesh mutation",
+        "sourceFingerprint":source.f.fingerprint().to_string(),"chart":source.chart,"source":source.source,"strata":[source.compound_id,source.cylinder_id],
+        "weightBits":source.weight.to_bits(),"offsetBits":source.offset.to_bits(),"physicalChamferRadius":source.chamfer_radius,"generatedRadiusBounds":[generated.lo,generated.hi],
+        "physicalFaceFeature":face_report,"generatedFaceCarrierFeature":generated_report,"physicalFixedZFeature":fixed_z_report,"commonXSurfaceLift":surface_report,
+        "physicalFeatureZeroAndExposureProved":true,"generatedCarrierNotClaimedExactPhysicalFeature":true,
+        "originalToPhysicalFaceFeatureDistance":distance(original,face)?,"originalToPhysicalFixedZFeatureDistance":distance(original,fixed_z)?,
+        "originalToCommonXSurfaceLiftDistance":distance(original,surface)?,"surfaceLiftToFixedZFeatureDistance":distance(surface,fixed_z)?,
+        "physicalGeneratedFaceSeparationUpper":distance(face,generated_face)?[1],"originalYMinusIdealFeatureY":[feature_height_gap.lo,feature_height_gap.hi],
+        "surfaceLiftOffIdealFeatureProved":abs_lower(feature_height_gap)>0.,"surfaceLiftExactIdealFeatureMembershipProved":false,
+        "candidate":candidate,"candidateKind":radius_label,"candidatePhysicalImageDistanceUpper":distance(candidate.map(I::point),face)?[1],
+        "candidateGeneratedImageDistanceUpper":distance(candidate.map(I::point),generated_face)?[1],
+        "exactCurveParameterMapProved":false,"neighboringPatchTransportProved":false,"publicationAuthorized":false}),
+    )
+}
