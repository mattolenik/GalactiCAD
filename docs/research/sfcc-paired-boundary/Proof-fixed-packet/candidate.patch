+struct PairedTarget {
+    face: Face,
+    outside: [i64;4],
+    global_edge: [usize;2],
+    candidate_edge: [usize;2],
+    candidate_fan: Value,
+    receipt: Value,
+}
+fn cell_side(oct:&SfccOctree, cell:&SfccCell, face:Face)->Result<usize> {
+    if face.0>=3 || face.2<=0 {return Err("paired_face_identity");}
+    let stride=stride_at_level(&oct.lat,cell.level);
+    let base=[cell.ix*stride,cell.iy*stride,cell.iz*stride];
+    let grid=unpack_point(&oct.lat,face.1);
+    if (0..3).filter(|&k|k!=face.0).any(|k|grid[k]<base[k] || grid[k]+face.2>base[k]+stride) {
+        return Err("paired_face_extent");
+    }
+    if grid[face.0]==base[face.0] {Ok(0)}
+    else if grid[face.0]==base[face.0]+stride {Ok(1)}
+    else {Err("paired_face_plane")}
+}
+fn directed_occurrences(boundary:&[usize],edge:[usize;2])->usize {
+    boundary.iter().enumerate().filter(|&(i,&a)|a==edge[0] && boundary[(i+1)%boundary.len()]==edge[1]).count()
+}
+fn paired_target(
+    f:&SfccFeatureSet,oct:&SfccOctree,faces:&[HashMap<i64,FaceRecord>;3],live:&PointTable,
