+fn attachment_alias_audit(f: &SfccFeatureSet, tol: &ResolvedTolerances) -> Value {
+    use crate::sfcc::shared_twisted_proof::attachment_zero_locus_b;
+    let [native, field, _] = source_ids(f);
+    let old: Value =
+        serde_json::from_str(include_str!("../../fixtures/exposure-b-baseline.json")).unwrap();
+    let junction: [f64; 3] = std::array::from_fn(|i| {
+        f64::from_bits(
+            u64::from_str_radix(old["lowerJoint"]["pointHex"][i].as_str().unwrap(), 16).unwrap(),
+        )
+    });
+    let mut rows = Vec::new();
+    for c in &f.curves {
+        if !c.adjacent_strata.contains(&native) {
+            continue;
+        }
+        let Some(&common) = c
+            .adjacent_strata
+            .iter()
+            .find(|&&s| s != native && f.strata[s].kind == crate::strata::CarrierKind::Compound)
+        else {
+            continue;
+        };
+        for (end, t, corner) in [(0, c.t_min, c.corner_start), (1, c.t_max, c.corner_end)] {
+            let Some(p) = c.point_at_checked(t) else {
+                rows.push(json!({"curve":c.id,"end":end,"queryFailed":true}));
+                continue;
+            };
+            // Select this previously declared witness; the proof has no witness coordinates.
+            let distance = (p[0] - junction[0])
+                .hypot(p[1] - junction[1])
+                .hypot(p[2] - junction[2]);
+            if distance > tol.probe_delta * 4. {
+                continue;
+            }
+            let lo =
+                std::array::from_fn(|k| (p[k].min(junction[k]) - tol.curve_eps * 8.).next_down());
+            let hi =
+                std::array::from_fn(|k| (p[k].max(junction[k]) + tol.curve_eps * 8.).next_up());
+            let proof = attachment_zero_locus_b(&f.strata[native], &f.strata[field], lo, hi);
+            let aliases: Vec<_> = f
+                .curves
+                .iter()
+                .filter(|a| {
+                    a.adjacent_strata.contains(&field) && a.adjacent_strata.contains(&common)
+                })
+                .flat_map(|a| {
+                    [(0, a.t_min, a.corner_start), (1, a.t_max, a.corner_end)]
+                        .into_iter()
+                        .filter_map(move |(e, t, cid)| {
+                            if cid < 0 {
+                                return None;
+                            }
+                            let q = a.point_at_checked(t)?;
+                            let delta = (q[0] - junction[0])
+                                .hypot(q[1] - junction[1])
+                                .hypot(q[2] - junction[2]);
+                            (delta <= tol.corner_merge_tol).then(|| {
+                                json!({"curve":a.id,"end":e,"parameterHex":hex(t),
+                        "pointHex":q.map(hex),"corner":cid,"sourcePair":a.adjacent_strata})
+                            })
+                        })
+                })
+                .collect();
+            rows.push(json!({"curve":c.id,"end":end,"parameterHex":hex(t),"sourcePair":c.adjacent_strata,"endpointUnwired":corner<0,
+                "pointHex":p.map(hex),"junctionDistanceHex":hex(distance),"boxHex":[lo.map(hex),hi.map(hex)],
+                "sourceIdentities":[f.strata[native].graph_capture_identity_b(),f.strata[field].graph_capture_identity_b(),f.strata[common].graph_capture_identity_b()],
+                "zeroLocusEquivalent":proof.is_ok(),"visitedSourceBoxes":proof.ok().map(|r|r.0),
+                "intrinsicBranchSign":proof.ok().map(|r|r.1),"refusal":proof.err(),"retainedAliases":aliases,
+                "orderedRawFrontier":"not retained by this candidate","sourceJunctionCertificate":"not implemented",
+                "attachmentTransportAuthorized":false}));
+        }
+    }
+    json!({"scope":"bounded equality of native/round-field zero loci and inherited domains; same common compound is retained",
+        "notProved":["common-intersection connectivity","ordered raw-parameter transport","genuine source junction","whole physical arc"],
+        "rows":rows,"runtimeTransportPerformed":false})
+}
