+use super::*;
+use crate::sfcc::{feature_set::compile_feature_set, field_branches::FieldRef};
+use serde_json::{json, Value};
+fn decode(s: &str) -> f64 {
+    f64::from_bits(u64::from_str_radix(s, 16).unwrap())
+}
+fn encode(v: f64) -> String {
+    format!("{:016x}", v.to_bits())
+}
+fn fixture() -> (CsgNode, crate::tolerances::ResolvedTolerances) {
+    let config: Value =
+        serde_json::from_str(include_str!("../../fixtures/shared-arc-full-knob.json")).unwrap();
+    let root = crate::scene_bridge::build_csg_tree_from_json(config["sceneJson"].as_str().unwrap())
+        .unwrap();
+    let size =
+        config["cube"]["max"][0].as_f64().unwrap() - config["cube"]["min"][0].as_f64().unwrap();
+    let tol = crate::tolerances::resolve_tolerances(
+        &crate::tuning::SfccTuning::default(),
+        (3. * size * size).sqrt(),
+    );
+    (root, tol)
+}
+fn parameter_at_height(
+    c: &crate::sfcc::feature_curves::FeatureCurve,
+    mut a: f64,
+    mut b: f64,
+    y: f64,
+) -> Option<f64> {
+    let ascending = c.point_at_checked(a)?[1] < c.point_at_checked(b)?[1];
+    for _ in 0..48 {
+        let t = a + (b - a) * 0.5;
+        let h = c.point_at_checked(t)?[1];
+        if (h < y) == ascending {
+            a = t;
+        } else {
+            b = t;
+        }
+    }
+    Some(a + (b - a) * 0.5)
+}
+/// The stored source span is joined to a continuous ideal-branch certificate.
+/// Queries are additional numerical checks, not a universal evaluator-totality proof.
+fn coverage(
+    root: &CsgNode,
+    f: &SfccFeatureSet,
+    pair: [usize; 2],
+    sign: i8,
+    height: [f64; 2],
+    eps: f64,
+) -> Vec<Value> {
+    let mut matches = Vec::new();
+    for c in &f.curves {
+        if c.adjacent_strata != pair && c.adjacent_strata != [pair[1], pair[0]] {
+            continue;
+        }
+        let Some((sa, sb, _)) = c.traced_carriers() else {
+            continue;
+        };
+        if !sa.correlated_same_chart_source_c(&f.strata[c.adjacent_strata[0]])
+            || !sb.correlated_same_chart_source_c(&f.strata[c.adjacent_strata[1]])
+        {
+            continue;
+        }
+        for i in 0..c.index_polyline.len() / 3 - 1 {
+            let (Some(a), Some(b)) = (
+                c.point_at_checked(i as f64),
+                c.point_at_checked((i + 1) as f64),
+            ) else {
+                continue;
+            };
+            if a[1].min(b[1]) > height[0] || a[1].max(b[1]) < height[1] {
+                continue;
+            }
+            let Some(ta) = parameter_at_height(c, i as f64, (i + 1) as f64, height[0]) else {
+                continue;
+            };
+            let Some(tb) = parameter_at_height(c, i as f64, (i + 1) as f64, height[1]) else {
+                continue;
+            };
+            let Some(p) = c.point_at_checked((ta + tb) * 0.5) else {
+                continue;
+            };
+            let Some(proof) = prove(root, &f.strata, pair, p, eps) else {
+                continue;
+            };
+            if proof.sign != sign {
+                continue;
+            }
+            let branch = branch_at(
+                &f.strata,
+                proof.source[0],
+                proof.source[1],
+                proof.source[2],
+                p,
+            )
+            .unwrap();
+            let rank =
+                support(&f.strata, &branch, interval(height[0], height[1]).unwrap()).unwrap();
+            let checks:Option<Vec<_>>=[ta,ta+(tb-ta)*0.25,(ta+tb)*0.5,ta+(tb-ta)*0.75,tb].into_iter().map(|t|{
+                let p=c.point_at_checked(t)?;let q=prove(root, &f.strata,pair,p,eps)?;if q.sign!=sign{return None;}
+                Some(json!({"parameterHex":encode(t),"pointHex":p.map(encode),"associationUpperHex":encode(q.distance_upper)}))
+            }).collect();
+            let Some(checks) = checks else {
+                continue;
+            };
+            matches.push(json!({"curve":c.id,"sourcePair":c.adjacent_strata,"cornerEnds":[c.corner_start,c.corner_end],"indexingPiece":i,"ownParameterRangeHex":[encode(ta),encode(tb)],"requiredHeightHex":height.map(encode),"sourceDeterminantLowerHex":encode(rank),"checkedQueries":checks}));
+        }
+    }
+    matches
+}
+fn families(f: &SfccFeatureSet) -> Value {
+    let mut groups = std::collections::BTreeMap::<[usize; 2], [usize; 3]>::new();
+    for c in &f.curves {
+        let mut pair = c.adjacent_strata;
+        pair.sort();
+        let row = groups.entry(pair).or_default();
+        row[0] += 1;
+        row[1] += usize::from(c.corner_start < 0);
+        row[2] += usize::from(c.corner_end < 0);
+    }
+    json!(groups.into_iter().map(|(pair,[curves,unwired_start,unwired_end])|json!({"sourcePair":pair,"curves":curves,"unwiredStarts":unwired_start,"unwiredEnds":unwired_end})).collect::<Vec<_>>())
+}
+fn lower_joint(old: &SfccFeatureSet, new: &SfccFeatureSet, tolerance: f64) -> (bool, Value) {
+    // Baseline chart identity is pinned by the legacy fingerprint; candidate IDs are not assumed.
+    let baseline = &old.corners[old.curves[20].corner_start as usize];
+    let pairs = |f: &SfccFeatureSet, c: &crate::sfcc::feature_set::SfccCorner| {
+        c.curve_ends
+            .iter()
+            .map(|&(id, _)| {
+                let mut p = f.curves[id].adjacent_strata;
+                p.sort();
+                p
+            })
+            .collect::<std::collections::BTreeSet<_>>()
+    };
+    let required = pairs(old, baseline);
+    let mut preserved = false;
+    let mut nearby = Vec::new();
+    for c in &new.corners {
+        let distance = (c.x - baseline.x)
+            .hypot(c.y - baseline.y)
+            .hypot(c.z - baseline.z);
+        if distance > tolerance {
+            continue;
+        }
+        let actual = pairs(new, c);
+        let all = required.is_subset(&actual);
+        preserved |= all;
+        nearby.push(json!({"corner":c.id,"distanceHex":encode(distance),"sourcePairs":actual,"allRequiredPairs":all}));
+    }
+    (
+        preserved,
+        json!({"baselinePointHex":[baseline.x,baseline.y,baseline.z].map(encode),"requiredSourcePairs":required,"candidateNearbyCorners":nearby,"toleranceHex":encode(tolerance),"preserved":preserved,"identityPremise":"same original expression and unchanged stratum extraction; compare carrier-pair identities and geometry, not candidate curve/corner IDs"}),
+    )
+}
+#[test]
+fn exposure_a_original_compilation_retains_the_required_source_interval() {
+    let (root, tol) = fixture();
+    let (old, old_d) = with_legacy(|| compile_feature_set(&root, &tol));
+    assert_eq!(
+        old.fingerprint(),
+        9875508341830920921,
+        "test-only legacy path must reproduce the frozen baseline before attribution"
+    );
+    let (new, new_d) = compile_feature_set(&root, &tol);
+    let p = ["c01ae303f75efc73", "4005871f5a33c661", "c020e81b1b90e888"].map(decode);
+    let proof = prove(&root, &new.strata, [10, 15], p, tol.curve_eps * 8.).unwrap();
+    let height = [2.6910277686167188, 2.69107776861672];
+    let before = coverage(
+        &root,
+        &old,
+        [10, 15],
+        proof.sign,
+        height,
+        tol.curve_eps * 8.,
+    );
+    let physical = coverage(
+        &root,
+        &new,
+        [10, 15],
+        proof.sign,
+        height,
+        tol.curve_eps * 8.,
+    );
+    let alias = coverage(
+        &root,
+        &new,
+        [30, 15],
+        proof.sign,
+        height,
+        tol.curve_eps * 8.,
+    );
+    let (lower_preserved, lower_record) = lower_joint(&old, &new, tol.corner_merge_tol);
+    let report = json!({"scope":"actual original-source compiled interval plus continuous ideal-source certificate; not component reconstruction",
+        "baselineFingerprint":old.fingerprint().to_string(),"candidateFingerprint":new.fingerprint().to_string(),
+        "baselineCoverage":before,"physicalCompiledCoverage":physical,"aliasCompiledCoverage":alias,
+        "baselineUnresolvedTrims":old_d.unresolved_trims,"candidateUnresolvedTrims":new_d.unresolved_trims,
+        "baselineCurves":old.curves.len(),"candidateCurves":new.curves.len(),"baselineCorners":old.corners.len(),"candidateCorners":new.corners.len(),
+        "baselineFamilies":families(&old),"candidateFamilies":families(&new),"lowerJoint":lower_record,
+        "unchangedAssociationEpsilonHex":encode(tol.curve_eps*8.),"floatingEvaluatorTotalityProved":false,"laterBlendHandoffProved":false,"componentAccepted":false});
+    let bytes = serde_json::to_vec_pretty(&report).unwrap();
+    assert!(bytes.len() < 65536);
+    std::fs::write(
+        std::env::var("SFCC_EXPOSURE_A_RECEIPT").expect("root receipt path"),
+        bytes,
+    )
+    .unwrap();
+    assert!(
+        before.is_empty(),
+        "baseline must fail actual compiled interval"
+    );
+    assert!(
+        !physical.is_empty() && !alias.is_empty(),
+        "both actual source identities must retain the required continuation"
+    );
+    assert!(
+        new_d.unresolved_trims > 0,
+        "undecided negative searches stay reported"
+    );
+    for row in physical.iter().chain(&alias) {
+        let c = &new.curves[row["curve"].as_u64().unwrap() as usize];
+        let end = c.point_at_checked(c.t_max).unwrap();
+        assert!(end[1] > height[1]);
+        assert_eq!(
+            c.corner_end, -1,
+            "unknown upper transition must not become an authoritative corner"
+        );
+    }
+    assert!(lower_preserved,"material collateral failure: original lower source junction must retain its incident source pairs");
+}
+#[test]
+fn exposure_a_rejects_wrong_sources_hidden_extensions_and_insufficient_budget() {
+    let (root, tol) = fixture();
+    let (f, _) = with_legacy(|| compile_feature_set(&root, &tol));
+    let p = ["c01ae303f75efc73", "4005871f5a33c661", "c020e81b1b90e888"].map(decode);
+    let eps = tol.curve_eps * 8.;
+    let proof = prove(&root, &f.strata, [10, 15], p, eps).unwrap();
+    assert!(prove(&root, &f.strata, [10, 10], p, eps).is_none());
+    let unrelated = crate::sdf::leaf_at(Shape::Sphere { r: 1. }, [0.; 3]);
+    assert!(
+        prove(&unrelated, &f.strata, [10, 15], p, eps).is_none(),
+        "certificate source must match the actual queried tree"
+    );
+    assert!(
+        prove(&root, &f.strata, [10, 15], [p[0] + 0.001, p[1], p[2]], eps).is_none(),
+        "nearby is not the same supporting locus"
+    );
+    assert!(prove(&root, &f.strata, [10, 15], p, 0.).is_none());
+    let mut too_many = f.strata.clone();
+    while too_many.len() <= 256 {
+        too_many.push(f.strata[0].clone());
+    }
+    assert!(prove(&root, &too_many, [10, 15], p, eps).is_none());
+    let mut wrong = f.strata.clone();
+    wrong[15] = wrong[15].clone().with_domain(FieldRef::new(
+        std::sync::Arc::new(root.clone()),
+        vec![0, 0, 0, 1],
+    ));
+    assert!(
+        prove(&root, &wrong, [10, 15], p, eps).is_none(),
+        "equal coefficients from another root must not authorize source identity"
+    );
+    let mut branch = branch_at(
+        &f.strata,
+        proof.source[0],
+        proof.source[1],
+        proof.source[2],
+        p,
+    )
+    .unwrap();
+    assert_eq!(
+        support(&f.strata, &branch, interval(3., 3.0001).unwrap()).unwrap_err(),
+        "outer_round_not_inactive"
+    );
+    assert!(
+        support(&f.strata, &branch, interval(20., 20.0001).unwrap()).is_err(),
+        "capped supporting extension unsupported"
+    );
+    let config: Value =
+        serde_json::from_str(include_str!("../../fixtures/shared-arc-full-knob.json")).unwrap();
+    let mut tangent_scene: Value =
+        serde_json::from_str(config["sceneJson"].as_str().unwrap()).unwrap();
+    tangent_scene["lh"]["lh"]["lh"]["rh"]["r"] = json!(8.);
+    let tangent_root =
+        crate::scene_bridge::build_csg_tree_from_json(&tangent_scene.to_string()).unwrap();
+    let mut tangent_view =
+        crate::sfcc::tree::build_tree(&tangent_root, crate::sfcc::feature_set::build_leaf_strata);
+    crate::sfcc::blend_surfaces::append_chamfer_carriers(&mut tangent_view);
+    assert!(
+        branch_at(&tangent_view.strata, 10, 30, 15, p).is_none(),
+        "radius equal to selected side offset has no nonzero transverse determinant"
+    );
+    branch.sign = -branch.sign;
+    assert!(
+        BranchCertificate::bind_strata(&f.strata, &branch, I::point(p[1])).is_none(),
+        "conditioning/source branch may not be forged"
+    );
+}
