+//! One globally budgeted source attempt over the provenance-bound incident triangle inventory.
+use super::fullfan_source_a;
+use crate::sfcc::pipeline::{build_pipeline_context, PipelineTuning, SfccWorldCube};
+use crate::sfcc::validation::NumericalGuard;
+use serde_json::{json, Value};
+use std::collections::{BTreeMap, BTreeSet};
+
+#[test]
+fn adoption_source_c_actual_incident_union_attempt() {
+    let _guard = NumericalGuard::new();
+    let original: Value =
+        serde_json::from_str(include_str!("../../fixtures/shared-arc-full-knob.json")).unwrap();
+    let fixture_text = match std::env::var("SFCC_ADOPTION_C_FIXTURE") {
+        Ok(path) => std::fs::read_to_string(path).unwrap(),
+        Err(std::env::VarError::NotPresent) => {
+            include_str!("../../fixtures/face-fans-c.json").to_owned()
+        }
+        Err(error) => panic!("invalid incident fixture path: {error}"),
+    };
+    let saved: Value = serde_json::from_str(&fixture_text).unwrap();
+    let tree =
+        crate::scene_bridge::build_csg_tree_from_json(original["sceneJson"].as_str().unwrap())
+            .unwrap();
+    let cube = SfccWorldCube {
+        min_x: original["cube"]["min"][0].as_f64().unwrap(),
+        min_y: original["cube"]["min"][1].as_f64().unwrap(),
+        min_z: original["cube"]["min"][2].as_f64().unwrap(),
+        size: original["cube"]["max"][0].as_f64().unwrap()
+            - original["cube"]["min"][0].as_f64().unwrap(),
+    };
+    let context = build_pipeline_context(&tree, &cube, &PipelineTuning::default());
+    assert_eq!(
+        context.features.fingerprint().to_string(),
+        saved["sourceFingerprint"].as_str().unwrap()
+    );
+    let points: BTreeMap<usize, [f64; 3]> = saved["points"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|p| {
+            (
+                p["id"].as_u64().unwrap() as usize,
+                std::array::from_fn(|k| f64::from_bits(p["positionBits"][k].as_u64().unwrap())),
+            )
+        })
+        .collect();
+    assert_eq!(points.len(), saved["points"].as_array().unwrap().len());
+    let mut flat = Vec::new();
+    let mut counts = Vec::new();
+    for patch in saved["patches"].as_array().unwrap() {
+        let ids: Vec<usize> = serde_json::from_value(patch["triangles"].clone()).unwrap();
+        assert!(!ids.is_empty() && ids.len() % 3 == 0);
+        counts.push(ids.len() / 3);
+        flat.extend(ids);
+    }
+    let mut unique = BTreeSet::new();
+    let triangles: Vec<_> = flat
+        .chunks_exact(3)
+        .map(|t| {
+            let mut key = [t[0], t[1], t[2]];
+            key.sort_unstable();
+            assert!(
+                unique.insert(key),
+                "duplicate emitted triangle must not create a second budget domain"
+            );
+            [points[&t[0]], points[&t[1]], points[&t[2]]]
+        })
+        .collect();
+    let tolerance = saved["surfaceTolerance"].as_f64().unwrap();
+    assert_eq!(
+        tolerance.to_bits(),
+        original["tuning"]["surfaceTolMm"]
+            .as_f64()
+            .unwrap()
+            .to_bits()
+    );
+    let cylinder = saved["cylinderSource"].as_u64().unwrap() as usize;
+    let attempt = fullfan_source_a::attempt(&context.features, cylinder, &triangles, tolerance);
+    let proved = attempt["result"]["Ok"].is_object();
+    let report = json!({"scope":"one source-root graph attempt over exactly the supplied emitted triangle union; geometric union, target ownership and transport are independent obligations",
+        "sourceFingerprint":context.features.fingerprint().to_string(),"parentReceiptSha256":saved["parentReceiptSha256"],
+        "cells":saved["cells"],"patchTriangleCounts":counts,"triangles":flat,
+        "trianglePointBits":triangles.iter().map(|t|t.map(|p|p.map(f64::to_bits))).collect::<Vec<_>>(),
+        "sourceAttempt":attempt,"wholeSuppliedSourceGraphProved":proved,
+        "sourceCalls":1,"priorCertificateReuse":false,"perFanBudgetReset":false,
+        "boundaryTransportProved":false,"idealCurveAdoptionProved":false,"publicationReady":false});
+    if let Ok(path) = std::env::var("SFCC_ADOPTION_C_RECEIPT") {
+        std::fs::write(path, serde_json::to_vec_pretty(&report).unwrap()).unwrap();
+    }
+    assert!(
+        proved,
+        "source gate is preserved in the attempt receipt: {}",
+        report["sourceAttempt"]
+    );
+}
