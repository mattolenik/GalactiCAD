+/// A positive certificate only. No-result means unknown, never absence.
+/// The supported class and ancestor restrictions are deliberately narrower
+/// than arbitrary CSG; the existing numerical probe still supplies its positives.
+pub(crate) fn prove(
+    runtime_root: &CsgNode,
+    strata: &[Stratum],
+    pair: [usize; 2],
+    point: [f64; 3],
+    epsilon: f64,
+) -> Option<Exposure> {
+    if strata.len() > 256
+        || !epsilon.is_finite()
+        || epsilon <= 0.
+        || point.iter().any(|x| !x.is_finite())
+        || pair[0] == pair[1]
+        || pair.iter().any(|&i| i >= strata.len())
+    {
+        return None;
+    }
+    for (cylinder, other) in [(pair[0], pair[1]), (pair[1], pair[0])] {
+        if strata[cylinder].certificate_cylinder().is_none() {
+            continue;
+        }
+        if strata[other].twisted_source().is_some() {
+            for field in 0..strata.len() {
+                if let Some(branch) = branch_at(strata, other, field, cylinder, point) {
+                    if let Some(proof) = certificate(runtime_root, strata, branch, point, epsilon) {
+                        return Some(proof);
+                    }
+                }
+            }
+        } else {
+            for native in 0..strata.len() {
+                if let Some(branch) = branch_at(strata, native, other, cylinder, point) {
+                    if let Some(proof) = certificate(runtime_root, strata, branch, point, epsilon) {
+                        return Some(proof);
+                    }
+                }
+            }
+        }
+    }
+    None
+}
