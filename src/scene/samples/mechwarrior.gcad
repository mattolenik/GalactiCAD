// Dieselpunk Battle Mech
// A hulking war machine bristling with weapons and pipes


// === TORSO - THE CORE ===
// Main chest housing with layered armor
let chestCore = box({ pos: [0, 0, 40], size: [26, 32, 24] })
let chestBulge = sphere({ pos: [0, 0, 44], r: 19 })
let chestArmor1 = box({ pos: [0, 0, 46], size: [20, 28, 18] })
let chestArmor2 = sphere({ pos: [0, 0, 48], r: 16 })
let chest = union({ r: 5 }, chestCore, chestBulge, chestArmor1, chestArmor2)

// Chest panel cutouts using subtract
let chestCutout1 = box({ pos: [8, 0, 42], size: [12, 20, 16] })
let chestCutout2 = box({ pos: [-8, 0, 42], size: [12, 20, 16] })
let chestWithCutouts = subtract({ r: 1 }, chest, chestCutout1, chestCutout2)

// Armored collar with multiple layers
let collarR = sphere({ pos: [0, 18, 54], r: 9 })
let collarL = sphere({ pos: [0, -18, 54], r: 9 })
let collarFront = sphere({ pos: [12, 0, 54], r: 8 })
let collarBack = sphere({ pos: [-8, 0, 54], r: 7 })
let collarTop = sphere({ pos: [0, 0, 58], r: 6 })
let collar = union({ r: 3 }, collarR, collarL, collarFront, collarBack, collarTop)

// Reactor exhaust vents on back - more detailed
let ventR = sphere({ pos: [-16, 12, 50], r: 6 })
let ventL = sphere({ pos: [-16, -12, 50], r: 6 })
let ventTop = sphere({ pos: [-16, 0, 54], r: 7 })
let ventMid = sphere({ pos: [-16, 6, 52], r: 4 })
let ventMid2 = sphere({ pos: [-16, -6, 52], r: 4 })
let vents = union({ r: 2 }, ventR, ventL, ventTop, ventMid, ventMid2)

// Vent cutouts for detail
let ventCutoutR = box({ pos: [-20, 12, 50], size: [6, 3, 3] })
let ventCutoutL = box({ pos: [-20, -12, 50], size: [6, 3, 3] })
let ventCutoutTop = box({ pos: [-20, 0, 54], size: [6, 3, 3] })
let ventsWithCutouts = subtract({ r: 0.5 }, vents, ventCutoutR, ventCutoutL, ventCutoutTop)

// === HEAD - COCKPIT POD ===
let headCore = sphere({ pos: [5, 0, 64], r: 11 })
let headBack = sphere({ pos: [-2, 0, 64], r: 9 })
let visor = box({ pos: [12, 0, 62], size: [7, 16, 5] })
let visorFrame = box({ pos: [12, 0, 62], size: [8, 18, 6] })
let headCrest = sphere({ pos: [0, 0, 74], r: 6 })
let headCrestBase = box({ pos: [0, 0, 70], size: [4, 4, 8] })
let antenna1 = sphere({ pos: [-5, 9, 72], r: 2.5 })
let antenna2 = sphere({ pos: [-5, -9, 72], r: 2.5 })
let antennaBase1 = box({ pos: [-5, 9, 68], size: [2, 2, 6] })
let antennaBase2 = box({ pos: [-5, -9, 68], size: [2, 2, 6] })
let head = union({ r: 4 }, headCore, headBack, visorFrame, visor, headCrestBase, headCrest, antennaBase1, antennaBase2, antenna1, antenna2)

// === SHOULDERS - WEAPON MOUNTS ===
// Right shoulder pod - enhanced
let shoulderR = sphere({ pos: [0, 28, 52], r: 13 })
let shoulderPadR = box({ pos: [0, 32, 54], size: [12, 10, 12] })
let shoulderPadR2 = sphere({ pos: [0, 35, 54], r: 6 })
let rocketPodR = box({ pos: [0, 38, 56], size: [10, 8, 16] })
let rocketPodR2 = box({ pos: [0, 40, 58], size: [8, 6, 12] })
let rocketTipR = sphere({ pos: [0, 42, 64], r: 3 })
let rightShoulder = union({ r: 4 }, shoulderR, shoulderPadR, shoulderPadR2, rocketPodR, rocketPodR2, rocketTipR)

// Left shoulder pod - enhanced
let shoulderL = sphere({ pos: [0, -28, 52], r: 13 })
let shoulderPadL = box({ pos: [0, -32, 54], size: [12, 10, 12] })
let shoulderPadL2 = sphere({ pos: [0, -35, 54], r: 6 })
let rocketPodL = box({ pos: [0, -38, 56], size: [10, 8, 16] })
let rocketPodL2 = box({ pos: [0, -40, 58], size: [8, 6, 12] })
let rocketTipL = sphere({ pos: [0, -42, 64], r: 3 })
let leftShoulder = union({ r: 4 }, shoulderL, shoulderPadL, shoulderPadL2, rocketPodL, rocketPodL2, rocketTipL)

// === RIGHT ARM - GATLING GUN ===
let upperArmR = box({ pos: [0, 34, 40], size: [10, 10, 18] })
let upperArmR2 = sphere({ pos: [0, 34, 40], r: 7 })
let elbowR = sphere({ pos: [0, 36, 30], r: 7 })
let elbowGuardR = box({ pos: [0, 38, 30], size: [6, 4, 8] })
let forearmR = box({ pos: [5, 36, 20], size: [7, 7, 16] })
let forearmR2 = sphere({ pos: [5, 36, 20], r: 5 })
let gatlingHousing = sphere({ pos: [10, 36, 10], r: 8 })
let gatlingHousing2 = box({ pos: [10, 36, 10], size: [12, 6, 6] })
let gatlingBarrel = box({ pos: [22, 36, 10], size: [20, 5, 5] })
let gatlingBarrel2 = box({ pos: [32, 36, 10], size: [8, 3, 3] })
let gatlingTip = sphere({ pos: [38, 36, 10], r: 2.5 })
let rightArm = union({ r: 3 }, upperArmR, upperArmR2, elbowR, elbowGuardR, forearmR, forearmR2, gatlingHousing, gatlingHousing2, gatlingBarrel, gatlingBarrel2, gatlingTip)

// === LEFT ARM - CLAW ===
let upperArmL = box({ pos: [0, -34, 40], size: [10, 10, 18] })
let upperArmL2 = sphere({ pos: [0, -34, 40], r: 7 })
let elbowL = sphere({ pos: [0, -36, 30], r: 7 })
let elbowGuardL = box({ pos: [0, -38, 30], size: [6, 4, 8] })
let forearmL = box({ pos: [5, -36, 20], size: [7, 7, 16] })
let forearmL2 = sphere({ pos: [5, -36, 20], r: 5 })
let clawBase = sphere({ pos: [10, -36, 10], r: 7 })
let clawBase2 = box({ pos: [10, -36, 10], size: [8, 6, 6] })
// Enhanced claw with more fingers
let clawTop = sphere({ pos: [18, -32, 8], r: 5 })
let clawMid = sphere({ pos: [18, -36, 8], r: 5 })
let clawBot = sphere({ pos: [18, -40, 8], r: 5 })
let clawTip1 = sphere({ pos: [24, -30, 6], r: 3 })
let clawTip2 = sphere({ pos: [24, -36, 6], r: 3 })
let clawTip3 = sphere({ pos: [24, -42, 6], r: 3 })
let leftArm = union({ r: 3 }, upperArmL, upperArmL2, elbowL, elbowGuardL, forearmL, forearmL2, clawBase, clawBase2, clawTop, clawMid, clawBot, clawTip1, clawTip2, clawTip3)

// === HIP ASSEMBLY ===
let hipCore = box({ pos: [0, 0, 26], size: [20, 28, 12] })
let hipBulge = sphere({ pos: [0, 0, 26], r: 15 })
let hipCore2 = box({ pos: [0, 0, 28], size: [18, 26, 10] })
let hips = union({ r: 4 }, hipCore, hipBulge, hipCore2)

// Hip armor plates - more detailed
let hipPlateR = sphere({ pos: [8, 20, 26], r: 8 })
let hipPlateR2 = box({ pos: [8, 22, 26], size: [6, 4, 8] })
let hipPlateL = sphere({ pos: [8, -20, 26], r: 8 })
let hipPlateL2 = box({ pos: [8, -22, 26], size: [6, 4, 8] })
let hipPlates = union({ r: 2 }, hipPlateR, hipPlateR2, hipPlateL, hipPlateL2)

// === LEGS - DIGITIGRADE STYLE ===
// Right leg - enhanced
let thighR = box({ pos: [0, 16, 16], size: [10, 10, 16] })
let thighR2 = sphere({ pos: [0, 16, 16], r: 7 })
let kneeR = sphere({ pos: [5, 16, 8], r: 7 })
let kneeGuardR = box({ pos: [5, 18, 8], size: [6, 4, 10] })
let shinR = box({ pos: [10, 16, -2], size: [7, 7, 18] })
let shinR2 = sphere({ pos: [10, 16, -2], r: 5 })
let ankleR = sphere({ pos: [8, 16, -16], r: 6 })
let footR = box({ pos: [12, 16, -20], size: [14, 10, 5] })
let footR2 = sphere({ pos: [12, 16, -20], r: 6 })
let toeR = sphere({ pos: [22, 16, -20], r: 5 })
let toeR2 = sphere({ pos: [26, 16, -20], r: 4 })
let rightLeg = union({ r: 3 }, thighR, thighR2, kneeR, kneeGuardR, shinR, shinR2, ankleR, footR, footR2, toeR, toeR2)

// Left leg - enhanced
let thighL = box({ pos: [0, -16, 16], size: [10, 10, 16] })
let thighL2 = sphere({ pos: [0, -16, 16], r: 7 })
let kneeL = sphere({ pos: [5, -16, 8], r: 7 })
let kneeGuardL = box({ pos: [5, -18, 8], size: [6, 4, 10] })
let shinL = box({ pos: [10, -16, -2], size: [7, 7, 18] })
let shinL2 = sphere({ pos: [10, -16, -2], r: 5 })
let ankleL = sphere({ pos: [8, -16, -16], r: 6 })
let footL = box({ pos: [12, -16, -20], size: [14, 10, 5] })
let footL2 = sphere({ pos: [12, -16, -20], r: 6 })
let toeL = sphere({ pos: [22, -16, -20], r: 5 })
let toeL2 = sphere({ pos: [26, -16, -20], r: 4 })
let leftLeg = union({ r: 3 }, thighL, thighL2, kneeL, kneeGuardL, shinL, shinL2, ankleL, footL, footL2, toeL, toeL2)

// === BACK MOUNTED SYSTEMS ===
// Reactor core - enhanced
let reactor = sphere({ pos: [-18, 0, 44], r: 11 })
let reactorCasing = box({ pos: [-20, 0, 44], size: [10, 16, 16] })
let reactorCasing2 = sphere({ pos: [-18, 0, 44], r: 9 })
let reactorUnit = union({ r: 4 }, reactor, reactorCasing, reactorCasing2)

// Reactor cutouts for detail
let reactorCutout1 = box({ pos: [-24, 0, 44], size: [4, 8, 8] })
let reactorCutout2 = box({ pos: [-24, 0, 44], size: [4, 4, 12] })
let reactorWithCutouts = subtract({ r: 1 }, reactorUnit, reactorCutout1, reactorCutout2)

// Smoke stacks - enhanced
let stack1 = box({ pos: [-22, 10, 58], size: [5, 5, 18] })
let stackTop1 = sphere({ pos: [-22, 10, 70], r: 5 })
let stack1Mid = sphere({ pos: [-22, 10, 64], r: 4 })
let stack2 = box({ pos: [-22, -10, 58], size: [5, 5, 18] })
let stackTop2 = sphere({ pos: [-22, -10, 70], r: 5 })
let stack2Mid = sphere({ pos: [-22, -10, 64], r: 4 })
let stack3 = box({ pos: [-22, 0, 58], size: [5, 5, 18] })
let stackTop3 = sphere({ pos: [-22, 0, 70], r: 5 })
let stacks = union({ r: 2 }, stack1, stackTop1, stack1Mid, stack2, stackTop2, stack2Mid, stack3, stackTop3)

// Fuel tanks - enhanced
let tankR = sphere({ pos: [-14, 22, 40], r: 7 })
let tankR2 = box({ pos: [-14, 24, 40], size: [8, 4, 12] })
let tankL = sphere({ pos: [-14, -22, 40], r: 7 })
let tankL2 = box({ pos: [-14, -24, 40], size: [8, 4, 12] })
let tanks = union({ r: 2 }, tankR, tankR2, tankL, tankL2)

// === DECORATIVE RIVETS & DETAILS ===
// More rivets for detail
let rivet1 = sphere({ pos: [16, 14, 46], r: 2 })
let rivet2 = sphere({ pos: [16, -14, 46], r: 2 })
let rivet3 = sphere({ pos: [16, 0, 52], r: 2 })
let rivet4 = sphere({ pos: [14, 10, 38], r: 1.5 })
let rivet5 = sphere({ pos: [14, -10, 38], r: 1.5 })
let rivet6 = sphere({ pos: [12, 18, 44], r: 1.5 })
let rivet7 = sphere({ pos: [12, -18, 44], r: 1.5 })
let rivet8 = sphere({ pos: [10, 22, 40], r: 1.5 })
let rivet9 = sphere({ pos: [10, -22, 40], r: 1.5 })
let rivet10 = sphere({ pos: [-10, 14, 48], r: 1.5 })
let rivet11 = sphere({ pos: [-10, -14, 48], r: 1.5 })
let rivets = union(rivet1, rivet2, rivet3, rivet4, rivet5, rivet6, rivet7, rivet8, rivet9, rivet10, rivet11)

// Chest searchlight - enhanced
let searchlight = sphere({ pos: [18, 0, 44], r: 5 })
let searchlightFrame = box({ pos: [18, 0, 44], size: [6, 6, 6] })
let searchlightUnit = union({ r: 2 }, searchlightFrame, searchlight)

// Side armor plates
let sidePlateR = box({ pos: [6, 24, 42], size: [4, 6, 12] })
let sidePlateL = box({ pos: [6, -24, 42], size: [4, 6, 12] })
let sidePlates = union(sidePlateR, sidePlateL)

// === ASSEMBLY ===
// Upper body
let torso = union({ r: 4 }, chestWithCutouts, collar, ventsWithCutouts, head)
let arms = union({ r: 2 }, rightShoulder, leftShoulder, rightArm, leftArm)
let upperBody = union({ r: 3 }, torso, arms)

// Lower body
let lowerBody = union({ r: 3 }, hips, hipPlates, rightLeg, leftLeg)

// Back systems
let backpack = union({ r: 3 }, reactorWithCutouts, stacks, tanks)

// Details
let details = union({ r: 1 }, rivets, searchlightUnit, sidePlates)

// Final mech
return union({ r: 4 }, upperBody, lowerBody, backpack, details)
