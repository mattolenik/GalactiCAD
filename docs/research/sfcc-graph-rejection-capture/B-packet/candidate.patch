+    #[test]
+    fn graph_b_byte_cap_and_hex_are_exact() {
+        assert_eq!(bits(-0.), "8000000000000000");
+        let finite = f64::from_bits(0x3ff0000000000001);
+        assert_eq!(
+            u64::from_str_radix(&bits(finite), 16).unwrap(),
+            finite.to_bits()
+        );
+        assert_eq!(bounded(json!({"text":"x".repeat(CAP)}))["complete"], false);
+    }
+    #[test]
+    fn graph_b_query_indices_are_read_only() {
+        super::super::QUERY_LOG.with(|s| {
+            *s.borrow_mut() = Some(super::super::QueryLog {
+                attempts: Vec::new(),
+                exhausted: false,
+            })
+        });
+        assert_eq!(query_count(), Some(0));
