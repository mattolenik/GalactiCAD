+pub(crate) fn remake(
+    raw_index: usize,
+    source: &FeatureCurve,
+    run: &TrimmedRun,
+    adjusted: [f64; 2],
+    corner_ids: [i64; 2],
+    next: &FeatureCurve,
+) {
+    if !selected(source) {
+        return;
+    }
+    if next.index_polyline.len() > WORD_CAP {
+        refuse("remade_polyline_cap");
+        return;
+    }
+    emit(
+        "remake",
+        || json!({"rawIndex":raw_index,"rawId":source.id,"rawStrata":source.adjacent_strata,"trimmedRangeHex":[hex(run.t0),hex(run.t1)],"adjustedRangeHex":adjusted.map(hex),"preCompactCorners":corner_ids,"preDedupCurve":curve_record(next)}),
+    );
+}
+pub(crate) fn dedup(c: &FeatureCurve, new_id: Option<usize>) {
+    if selected(c) {
+        emit(
+            "dedup",
+            || json!({"preDedupId":c.id,"finalCurveId":new_id,"strata":c.adjacent_strata,"preCompactCorners":[c.corner_start,c.corner_end]}),
+        );
+    }
+}
+fn final_bounds(
+    c: &[FeatureCurve],
+    corners: &[SfccCorner],
+    remap_count: usize,
+) -> Result<(), &'static str> {
+    if remap_count > 512 || corners.len() > 512 {
+        return Err("final_corner_count_cap");
+    }
+    if c.len() > 4096 {
+        return Err("final_input_curve_count_cap");
+    }
+    let mut count = 0usize;
+    let mut words = 0usize;
+    for curve in c.iter().filter(|c| selected(c)) {
+        count = count.checked_add(1).ok_or("final_curve_count_overflow")?;
+        words = words
+            .checked_add(curve.index_polyline.len())
+            .ok_or("final_polyline_words_overflow")?;
+        if count > 64 || curve.index_polyline.len() > WORD_CAP {
+            return Err("final_curve_cap");
+        }
+        if words > WORD_CAP {
+            return Err("final_aggregate_polyline_cap");
+        }
+    }
+    let mut incidence = 0usize;
+    for corner in corners {
+        if corner.strata.len() > 128 || corner.curve_ends.len() > 128 {
+            return Err("final_corner_incidence_cap");
+        }
+        incidence = incidence
+            .checked_add(corner.strata.len())
+            .and_then(|n| n.checked_add(corner.curve_ends.len()))
+            .ok_or("final_corner_incidence_overflow")?;
+        if incidence > 4096 {
+            return Err("final_total_incidence_cap");
+        }
+    }
+    Ok(())
+}
+pub(crate) fn finish(
+    c: &[FeatureCurve],
+    corners: &[SfccCorner],
+    remap: &std::collections::HashMap<usize, usize>,
+) {
+    if !enabled() {
+        return;
+    }
+    if let Err(reason) = final_bounds(c, corners, remap.len()) {
+        refuse(reason);
+        return;
+    }
+    let selected: Vec<_> = c.iter().filter(|c| selected(c)).collect();
+    emit("final", || {
+        let mut mapping: Vec<_> = remap.iter().map(|(&a, &b)| [a, b]).collect();
+        mapping.sort();
+        json!({"cornerRemap":mapping,"curves":selected.iter().map(|c|curve_record(c)).collect::<Vec<_>>(),"corners":corners.iter().filter(|p|p.curve_ends.iter().any(|(id,_)|selected.iter().any(|c|c.id==*id))).map(|c|json!({"id":c.id,"positionHex":point([c.x,c.y,c.z]),"strata":c.strata,"curveEnds":c.curve_ends})).collect::<Vec<_>>()})
+    });
+}
