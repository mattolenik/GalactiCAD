+    if u2.lo <= 0. {
+        return None;
+    }
+    let u = sqrt(u2)?.mul(sign as f64)?;
+    let theta = div(y.sub(I::point(p.pos_y))?.add(I::point(p.h))?, 2. * p.h)?.mul(p.twist_rad)?;
+    let (s, c) = sin_cos(theta)?;
+    Some([
+        mul(u, c)?.sub(s.mul(p.v0z)?)?.add(I::point(p.pos_x))?,
+        y,
+        mul(u, s)?.add(c.mul(p.v0z)?)?.add(I::point(p.pos_z))?,
+    ])
+}
+fn rounding(a: [f64; 3], b: [f64; 3]) -> Option<f64> {
+    let mut sum = I::point(0.);
+    for k in 0..3 {
+        let mag = I::point(a[k].abs()).add(I::point(b[k].abs()))?.hi;
+        let diff = (b[k] - a[k]).abs();
+        let out = I::point(a[k].abs()).add(I::point(diff))?.hi;
+        if !mag.next_up().is_finite() || !diff.next_up().is_finite() || !out.next_up().is_finite() {
+            return None;
+        }
+        sum = sum
+            .add(I::point(mag.next_up() - mag))?
+            .add(I::point(diff.next_up() - diff))?
+            .add(I::point(out.next_up() - out))?;
+    }
+    Some(sum.hi)
+}
+fn groove_interval(groove: &Leaf, edge: usize, rho: I, y: I, radius: f64) -> Option<()> {
+    let Shape::Lathe { edges } = &groove.shape else {
+        return None;
+    };
+    let e = edges.get(edge)?;
+    let y = y.sub(I::point(groove.pos[1]))?;
+    let ex = I::point(e.r1).sub(I::point(e.r0))?;
+    let ey = I::point(e.y1).sub(I::point(e.y0))?;
+    let wx = rho.sub(I::point(e.r0))?;
+    let wy = y.sub(I::point(e.y0))?;
+    let t = divide(
+        mul(ex, wx)?.add(mul(ey, wy)?)?,
+        square(ex)?.add(square(ey)?)?,
+    )?;
+    if t.lo <= 0. || t.hi >= 1. {
+        return None;
+    }
+    // Convexity/orientation and the positive offset were proved by the root theorem.
+    for (i, o) in edges.iter().enumerate() {
+        if i == edge {
+            continue;
+        }
+        let dx = I::point(o.r1).sub(I::point(o.r0))?;
+        let dy = I::point(o.y1).sub(I::point(o.y0))?;
+        let x = rho.sub(I::point(o.r0))?;
+        let z = y.sub(I::point(o.y0))?;
+        let t = divide(mul(dx, x)?.add(mul(dy, z)?)?, square(dx)?.add(square(dy)?)?)?;
+        let t = I {
+            lo: t.lo.clamp(0., 1.),
+            hi: t.hi.clamp(0., 1.),
+        };
+        let d = sqrt(square(x.sub(mul(dx, t)?)?)?.add(square(z.sub(mul(dy, t)?)?)?)?)?;
+        if d.lo <= radius {
+            return None;
+        }
+    }
+    Some(())
+}
+
+/// Admit one actual raw knot span, ordered from a source junction to a positive
+/// interior event. The whole short chord, not merely sampled points, is bounded.
+pub(crate) fn bind(
+    runtime_root: &CsgNode,
+    strata: &[Stratum],
+    curve: &FeatureCurve,
+    source: [usize; 3],
+    common: usize,
+    range: [f64; 2],
+    corner: [f64; 3],
+    epsilon: f64,
+) -> Option<Connection> {
+    if strata.len() > 256
+        || common >= strata.len()
+        || !epsilon.is_finite()
+        || epsilon <= 0.
+        || range[0] == range[1]
+        || curve.closed
+        || curve.native
+    {
+        return None;
+    }
+    let [native, field, cylinder] = source;
+    if curve.adjacent_strata != [common, native] && curve.adjacent_strata != [native, common] {
+        return None;
+    }
+    // Only a raw end is extended. Interior unknown gaps need a separate theorem.
+    if range[0] != curve.t_min && range[0] != curve.t_max {
+        return None;
+    }
+    let (seed0, seed1, seed_round) = curve.connection_seed_chord_b(range[0], range[1])?;
+    let (a, b, _) = curve.traced_carriers()?;
+    for (s, id) in [
+        (&a, curve.adjacent_strata[0]),
+        (&b, curve.adjacent_strata[1]),
+    ] {
+        if !s.connection_same_source_b(strata.get(id)?) {
+            return None;
+        }
+    }
+    let junction = junction::prove_junction(runtime_root, strata, source, corner, epsilon)?;
+    let branch = branch_at(strata, native, field, cylinder, corner)?;
+    let root = strata[native].exposure_root_a()?;
+    let (cap_cut, _, _) = pair(root, Some((BlendKind::Smax, SminMode::Round))).ok()?;
+    let (groove_cut, _, _) = pair(cap_cut, None).ok()?;
+    let (hard, groove_node, radius) =
+        pair(groove_cut, Some((BlendKind::Smax, SminMode::Chamfer))).ok()?;
+    let (weight, offset) =
+        strata[common].connection_chamfer_b(hard, groove_node, groove_cut, radius)?;
+    let generated_level = divide(I::point(offset), I::point(weight))?;
+    let level_error = absolute(generated_level.sub(I::point(radius))?);
+    if level_error > epsilon {
+        return None;
+    }
+    let groove = leaf(groove_node, -1.).ok()?;
+    let Shape::Lathe { edges } = &groove.shape else {
+        return None;
+    };
+    let e = edges.get(junction.groove_edge)?;
+    let dr = I::point(e.r1).sub(I::point(e.r0))?;
+    let dy = I::point(e.y1).sub(I::point(e.y0))?;
+    let slope = divide(dr, dy)?;
+    let q = curve.shared_checked_point(range[1])?;
+    let root_y = interval(junction.height[0], junction.height[1])?;
+    let delta_y = I::point(q[1]).sub(root_y)?;
+    if delta_y.lo <= 0. && delta_y.hi >= 0. {
+        return None;
+    }
+    let delta_r = mul(slope, delta_y)?;
+    // rho(lambda)=R+lambda*delta_r, so every open incoming point has rho<R.
+    if delta_r.hi >= 0. {
+        return None;
+    }
+    let rho1 = I::point(branch.cylinder.2).add(delta_r)?;
+    let rho = interval(
+        rho1.lo.min(branch.cylinder.2),
+        rho1.hi.max(branch.cylinder.2),
+    )?;
+    let y = interval(q[1].min(root_y.lo), q[1].max(root_y.hi))?;
+    ancestor_support(strata, &branch, y, false).ok()?;
+    let (p, selected, competitor, round_radius) =
+        strata[native].round_twisted_source(&strata[field])?;
+    let u2 = square(rho)?.sub(square(I::point(p.v0z))?)?;
+    if u2.lo <= 0. {
+        return None;
+    }
+    let u = sqrt(u2)?;
+    profile_branch(p, selected, [u.mul(branch.sign as f64)?, I::point(p.v0z)])?;
+    let radial_x = I::point(branch.cylinder.0[0]).add(rho)?;
+    if lathe_lower(
+        competitor,
+        [radial_x.lo, y.lo, branch.cylinder.0[2]],
+        [radial_x.hi, y.hi, branch.cylinder.0[2]],
+    )? <= round_radius
+    {
+        return None;
+    }
+    groove_interval(groove, junction.groove_edge, rho, y, radius)?;
+    let start_image = std::array::from_fn(|k| I {
+        lo: junction.image[0][k],
+        hi: junction.image[1][k],
+    });
+    let end_image = image(p, branch.sign, rho1, I::point(q[1]))?;
+    let endpoint_error = distance(corner, start_image)?.max(distance(q, end_image)?);
+    let seed_endpoint_error = distance(seed0, start_image)?.max(distance(seed1, end_image)?);
+    let m = I::point(absolute(slope));
+    let k = div(I::point(p.twist_rad), 2. * p.h)?;
+    let kk = I::point(absolute(k));
+    let rmax = I::point(rho.hi);
+    let umin = I::point(u.lo);
+    // |P''(y)| <= |u''|+2|theta' u'|+theta'^2 rho for u=sqrt(rho^2-v^2).
+    let upp = divide(
+        mul(square(m)?, square(I::point(p.v0z))?)?,
+        mul(square(umin)?, umin)?,
+    )?;
+    let up = divide(mul(m, rmax)?, umin)?;
+    let second = upp
+        .add(mul(kk, up)?.mul(2.)?)?
+        .add(mul(square(kk)?, rmax)?)?;
+    let sag = div(mul(second, square(delta_y)?)?, 8.)?.hi;
+    let chord_error = I::point(endpoint_error)
+        .add(I::point(sag))?
+        .add(I::point(rounding(corner, q)?))?
+        .hi;
+    let seed_error = I::point(seed_endpoint_error)
+        .add(I::point(sag))?
+        .add(I::point(seed_round))?
+        .hi;
+    if chord_error > epsilon || seed_error > epsilon {
+        return None;
+    }
+    for point in [corner, q] {
+        for id in [native, common] {
+            if !strata[id].domain_contains(point, epsilon)
+                || !strata[id]
+                    .raw_field(point[0], point[1], point[2])
+                    .normalized_equation()
+                    .is_some_and(|f| f.value.abs() <= epsilon)
+            {
+                return None;
+            }
+        }
+    }
+    Some(Connection {
+        source: [native, field, cylinder, common],
+        raw_range: range,
+        ends: [corner, q],
+        height: [y.lo, y.hi],
+        radial_delta: [delta_r.lo, delta_r.hi],
+        source_chord_error: chord_error,
+        seed_error,
+        generated_level_error: level_error,
+        epsilon,
+        carriers: [a, b],
+    })
+}
+impl Connection {
+    pub(crate) fn matches_carriers(&self, a: &Stratum, b: &Stratum) -> bool {
+        a.connection_same_source_b(&self.carriers[0])
+            && b.connection_same_source_b(&self.carriers[1])
+    }
+}
