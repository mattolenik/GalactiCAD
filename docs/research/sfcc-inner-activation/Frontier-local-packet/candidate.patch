+            }
+        }
+    }
+    if !transport_a::accepts(own[0], own[1], plan.epsilon) {
+        return false;
+    }
+    let Some(out_end) = composite
+        .iter()
+        .filter(|(t, _)| *t > plan.cuts[1])
+        .map(|(t, _)| *t)
+        .min_by(f64::total_cmp)
