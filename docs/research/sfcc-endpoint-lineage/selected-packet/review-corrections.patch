+fn final_bounds(
+    c: &[FeatureCurve],
+    corners: &[SfccCorner],
+    remap_count: usize,
+) -> Result<(), &'static str> {
+    if remap_count > 512 || corners.len() > 512 {
+        return Err("final_corner_count_cap");
+    }
+    if c.len() > 4096 {
+        return Err("final_input_curve_count_cap");
+    }
+    let mut count = 0usize;
+    let mut words = 0usize;
+    for curve in c.iter().filter(|c| selected(c)) {
+        count = count.checked_add(1).ok_or("final_curve_count_overflow")?;
+        words = words
+            .checked_add(curve.index_polyline.len())
+            .ok_or("final_polyline_words_overflow")?;
+        if count > 64 || curve.index_polyline.len() > WORD_CAP {
+            return Err("final_curve_cap");
+        }
+        if words > WORD_CAP {
+            return Err("final_aggregate_polyline_cap");
+        }
+    }
+    let mut incidence = 0usize;
+    for corner in corners {
+        if corner.strata.len() > 128 || corner.curve_ends.len() > 128 {
+            return Err("final_corner_incidence_cap");
+        }
+        incidence = incidence
+            .checked_add(corner.strata.len())
+            .and_then(|n| n.checked_add(corner.curve_ends.len()))
+            .ok_or("final_corner_incidence_overflow")?;
+        if incidence > 4096 {
+            return Err("final_total_incidence_cap");
+        }
+    }
+    Ok(())
+}
