+#[test]
+fn alias_a_generated_scope_charges_exact_actual_attempts_and_cleans_up() {
+    use crate::sfcc::private_arc_a::{generated_queries_active, GeneratedQueries};
+    let (root, f, source, charts, ranges, rho_min, eps) = fixture();
+    let cert = bind(&root, &f, source, charts, ranges, rho_min, eps).unwrap();
+    let mut ledger = budget(&f);
+    assert!(matches!(
+        cert.query_generated(charts[0], ranges[0][0]),
+        Err(Failure::Scope)
+    ));
+    let before = ledger.charged_queries();
+    let scope = GeneratedQueries::begin(&mut ledger).unwrap();
+    assert!(generated_queries_active());
+    assert_eq!(ledger.charged_queries(), before + 2048);
+    let reserved = ledger.charged_queries();
+    assert!(matches!(
+        cert.query_main(charts[0], ranges[0][0], &mut ledger),
+        Err(Failure::Scope)
+    ));
+    let e = cert.query_generated(charts[0], ranges[0][1] * 0.5).unwrap();
+    let mapped = cert.map_generated(&e, charts[1]).unwrap();
+    assert!(transport_a::accepts(e.point(), mapped.point(), eps));
+    assert_eq!(ledger.charged_queries(), reserved);
+    let rows = scope.finish().unwrap();
+    assert!(rows.len() > 2 && rows.len() <= 65);
+    assert!(rows.iter().all(|q| q.point.is_some()));
+    assert!(!generated_queries_active());
+    assert!(matches!(
+        cert.map_generated(&e, charts[1]),
+        Err(Failure::Scope)
+    ));
+    {
+        let scope = GeneratedQueries::begin(&mut ledger).unwrap();
+        for _ in 0..2048 {
+            cert.query_generated(charts[0], ranges[0][0]).unwrap();
+        }
+        assert!(matches!(
+            cert.query_generated(charts[0], ranges[0][0]),
+            Err(Failure::Query)
+        ));
+        assert!(scope.finish().is_err());
+    }
+    assert!(!generated_queries_active());
+    let aborted = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        let _scope = GeneratedQueries::begin(&mut ledger).unwrap();
+        panic!("scope unwind");
+    }));
+    assert!(aborted.is_err());
+    assert!(!generated_queries_active());
+}
