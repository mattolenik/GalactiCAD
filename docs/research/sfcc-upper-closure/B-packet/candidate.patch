+    pub(crate) fn upper_closure_field_b(&self) -> Option<&FieldRef> {
+        if self.sign != 1. || self.kind != CarrierKind::Field || self.compound.is_some() { return None; }
+        let field = self.field.as_ref()?;
+        let domains = self.domain.as_ref()?;
+        if domains.len() != 1 || !domains[0].same_domain(field) { return None; }
+        field.upper_closure_descriptor_b()?;
+        Some(field)
+    }
