+#[test]
+fn face_c_actual_second_pair_and_whole_face_source_attempt() {
+    use crate::sfcc::{
+        cell_mesh::paired_geometry_b,
+        pipeline::{build_pipeline_context, PipelineTuning, SfccWorldCube},
+        validation::NumericalGuard,
+    };
+    let _guard = NumericalGuard::new();
+    let original: Value =
+        serde_json::from_str(include_str!("../../fixtures/shared-arc-full-knob.json")).unwrap();
+    let saved: Value =
+        serde_json::from_str(include_str!("../../fixtures/face-fans-c.json")).unwrap();
+    let tree =
+        crate::scene_bridge::build_csg_tree_from_json(original["sceneJson"].as_str().unwrap())
+            .unwrap();
+    let cube = SfccWorldCube {
+        min_x: original["cube"]["min"][0].as_f64().unwrap(),
+        min_y: original["cube"]["min"][1].as_f64().unwrap(),
+        min_z: original["cube"]["min"][2].as_f64().unwrap(),
+        size: original["cube"]["max"][0].as_f64().unwrap()
+            - original["cube"]["min"][0].as_f64().unwrap(),
+    };
+    let context = build_pipeline_context(&tree, &cube, &PipelineTuning::default());
+    let f = &context.features;
+    assert_eq!(
+        f.fingerprint().to_string(),
+        saved["sourceFingerprint"].as_str().unwrap()
+    );
+    let points: BTreeMap<usize, Point> = saved["points"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|p| {
+            (
+                p["id"].as_u64().unwrap() as usize,
+                std::array::from_fn(|k| f64::from_bits(p["positionBits"][k].as_u64().unwrap())),
+            )
+        })
+        .collect();
+    assert_eq!(points.len(), saved["points"].as_array().unwrap().len());
+    let patches = saved["patches"].as_array().unwrap();
+    assert_eq!(patches.len(), 4);
+    let ids: Vec<Vec<usize>> = patches
+        .iter()
+        .map(|p| serde_json::from_value(p["triangles"].clone()).unwrap())
+        .collect();
+    let boundaries: Vec<Vec<usize>> = patches
+        .iter()
+        .map(|p| serde_json::from_value(p["boundary"].clone()).unwrap())
+        .collect();
+    let segments: [[usize; 2]; 2] =
+        serde_json::from_value(saved["sharedSegments"].clone()).unwrap();
+    let endpoint = saved["commonEndpoint"].as_u64().unwrap() as usize;
+    let tolerance = saved["surfaceTolerance"].as_f64().unwrap();
+    assert_eq!(
+        tolerance.to_bits(),
+        original["tuning"]["surfaceTolMm"]
+            .as_f64()
+            .unwrap()
+            .to_bits()
+    );
+    let second = paired_geometry_b::audit(
+        [&boundaries[2], &boundaries[3]],
+        [&ids[2], &ids[3]],
+        segments[1],
+        &points,
+    );
+    let geometry = audit(&points, &ids, segments, endpoint);
+    let flat: Vec<_> = ids.iter().flatten().copied().collect();
+    let triangles: Vec<_> = flat
+        .chunks_exact(3)
+        .map(|t| [points[&t[0]], points[&t[1]], points[&t[2]]])
+        .collect();
+    // One call retains the original GLOBAL work cap across every supplied patch.
+    let source = fullfan_source_a::certify(
+        f,
+        saved["cylinderSource"].as_u64().unwrap() as usize,
+        &triangles,
+        tolerance,
+    );
+    let exact = geometry.as_ref().is_ok_and(|g| {
+        g.triangles == flat
+            && g.report["pointBits"]
+                == json!(points
+                    .iter()
+                    .map(|(&id, p)| json!([id, p.map(f64::to_bits)]))
+                    .collect::<Vec<_>>())
+    });
+    let combined: std::result::Result<Value, String> = match (&geometry, &source) {
+        (Ok(g), Ok(s)) if exact => combine_error(g, s, tolerance).map_err(str::to_owned),
+        (Err(e), _) => Err(format!("face_geometry: {e}")),
+        (_, Err(e)) => Err(format!("face_source: {e}")),
+        _ => Err("face_exact_input_binding".into()),
+    };
+    let second_report = second
+        .as_ref()
+        .map(|g| g.report().clone())
+        .map_err(|e| e.to_string());
+    let geometry_report = geometry
+        .as_ref()
+        .map(|g| g.report().clone())
+        .map_err(|e| e.to_string());
+    let endpoint_result = match (&geometry, &source) {
+        (Ok(g), Ok(s)) if exact => bind_feature_endpoint_transport(
+            f,
+            &context.lat,
+            &original,
+            &saved,
+            &points,
+            g,
+            s,
+            tolerance,
+        ),
+        _ => Err("endpoint_requires_complete_source_and_domain".into()),
+    };
+    let report = json!({"parentReceiptSha256":saved["parentReceiptSha256"],"sourceFingerprint":saved["sourceFingerprint"],"face":saved["face"],"insideCell":saved["insideCell"],"outsideCell":saved["outsideCell"],
+        "secondPairGeometry":second_report,"wholeFaceGeometry":geometry_report,"wholeFaceSource":source,"combined":combined,
+        "exactSourceGeometryInputBinding":exact,"oneSourceCallGlobal128Cap":true,"wholeFaceSourceGraphAndUnionProved":combined.is_ok(),
+        "endpointTransport":endpoint_result,"idealFeatureEndpointProved":endpoint_result.is_ok(),"sourceFeatureParameterTransportProved":false,"publicationReady":false});
+    if let Ok(path) = std::env::var("SFCC_FACE_C_RECEIPT") {
+        std::fs::write(path, serde_json::to_vec_pretty(&report).unwrap()).unwrap();
+    }
+    assert!(second.is_ok(), "{second_report:?}");
+    assert!(geometry.is_ok(), "{geometry_report:?}");
+    assert!(source.is_ok(), "{source:?}");
+    assert!(combined.is_ok(), "{combined:?}");
+    assert!(endpoint_result.is_ok(), "{endpoint_result:?}");
+}
