+#[test]
+fn endpoint_replay_b_duplicate_pre_call_keys_are_rejected() {
+    let mut unkeyed_fixture = fixture();
+    let entries = unkeyed_fixture["capture"]["pre"]["allPrivatePoints"]
+        .as_array_mut()
+        .unwrap();
+    let unkeyed: Vec<_> = entries
+        .iter()
+        .enumerate()
+        .filter(|(_, p)| p["key"].is_null())
+        .map(|(i, _)| i)
+        .take(2)
+        .collect();
+    assert_eq!(unkeyed.len(), 2);
+    entries[unkeyed[1]]["positionHex"] = entries[unkeyed[0]]["positionHex"].clone();
+    entries[unkeyed[1]]["normalHex"] = entries[unkeyed[0]]["normalHex"].clone();
+    let restored = restored_points(&unkeyed_fixture["capture"]["pre"]);
+    assert_eq!(
+        restored.count(),
+        633,
+        "equal unkeyed payloads retain distinct IDs"
+    );
+    assert_ne!(unkeyed[0], unkeyed[1]);
+    let mut f = fixture();
+    let points = f["capture"]["pre"]["allPrivatePoints"]
+        .as_array_mut()
+        .unwrap();
+    let keyed: Vec<_> = points
+        .iter()
+        .enumerate()
+        .filter(|(_, p)| !p["key"].is_null())
+        .map(|(i, _)| i)
+        .take(2)
+        .collect();
+    assert_eq!(keyed.len(), 2);
+    points[keyed[1]]["key"] = points[keyed[0]]["key"].clone();
+    assert!(std::panic::catch_unwind(|| restored_points(&f["capture"]["pre"])).is_err());
+}
