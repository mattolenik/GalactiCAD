+fn axis_root(
+    cert: &alias_a::Certificate<'_>,
+    axis: usize,
+    plane: f64,
+    generated: bool,
+) -> BResult<(([f64; 3], [f64; 3]), [f64; 2], [f64; 2])> {
+    let range = cert.radial_range();
+    let derivative = cert
+        .axis_derivative(axis, range[0], range[1], generated)
+        .ok_or("root_derivative")?;
+    if derivative[0] <= 0. && derivative[1] >= 0. {
+        return Err("root_not_unique");
+    }
+    let image = |a, b| {
+        if generated {
+            cert.generated_image(a, b)
+        } else {
+            cert.image(a, b)
+        }
+    };
+    let radial = if axis == 1 {
+        if generated {
+            cert.generated_radial_from_height(plane)
+        } else {
+            cert.radial_from_height(plane)
+        }
+        .ok_or("root_inverse")?
+    } else {
+        let low = image(range[0], range[0]).ok_or("root_scope")?;
+        let high = image(range[1], range[1]).ok_or("root_scope")?;
+        let increasing = derivative[0] > 0.;
+        if !(if increasing {
+            low.1[axis] < plane && high.0[axis] > plane
+        } else {
+            low.0[axis] > plane && high.1[axis] < plane
+        }) {
+            return Err("root_not_bracketed");
+        }
+        let (mut lo, mut hi) = (range[0], range[1]);
+        for _ in 0..64 {
+            let middle = lo * 0.5 + hi * 0.5;
+            if !middle.is_finite() || middle <= lo || middle >= hi {
+                break;
+            }
+            let at = image(middle, middle).ok_or("root_image")?;
+            let d = cert
+                .axis_derivative(axis, lo, hi, generated)
+                .ok_or("root_derivative")?;
+            let denom = interval(d[0], d[1]).ok_or("root_derivative")?;
+            if denom.lo <= 0. && denom.hi >= 0. {
+                return Err("root_not_unique");
+            }
+            let reciprocal = interval((1. / denom.hi).next_down(), (1. / denom.lo).next_up())
+                .ok_or("root_arithmetic")?;
+            let residual = interval(at.0[axis], at.1[axis])
+                .and_then(|v| v.sub(I::point(plane)))
+                .ok_or("root_arithmetic")?;
+            let n = I::point(middle)
+                .sub(mul(residual, reciprocal).ok_or("root_arithmetic")?)
+                .ok_or("root_arithmetic")?;
+            let (next_lo, next_hi) = (lo.max(n.lo), hi.min(n.hi));
+            if next_lo > next_hi {
+                return Err("root_empty_image");
+            }
+            if next_lo == lo && next_hi == hi {
+                break;
+            }
+            lo = next_lo;
+            hi = next_hi;
+        }
+        [lo, hi]
+    };
+    let bounds = image(radial[0], radial[1]).ok_or("root_scope")?;
+    Ok((bounds, radial, derivative))
+}
