+/// Freezes face pins during one meshing/reverification call. The only mutable
+/// access updates consumption counters, which do not affect parameter lookup.
+pub(crate) struct CoverageFaces<'a> {
+    faces: &'a mut [HashMap<i64, FaceRecord>; 3],
+    parameters: std::cell::OnceCell<HashMap<(usize, usize), Result<u64, &'static str>>>,
+}
+impl<'a> CoverageFaces<'a> {
+    pub(crate) fn new(faces: &'a mut [HashMap<i64, FaceRecord>; 3]) -> Self {
+        Self { faces, parameters: std::cell::OnceCell::new() }
+    }
+    pub(crate) fn records(&self) -> &[HashMap<i64, FaceRecord>; 3] {
+        self.faces
+    }
+    pub(crate) fn consume(&mut self, axis: usize, key: i64, segment: usize, reversed: bool) {
+        let record = self.faces[axis].get_mut(&key).unwrap();
+        if reversed {
+            record.consumed_rev[segment] += 1;
+        } else {
+            record.consumed_fwd[segment] += 1;
+        }
+    }
+    fn parameter(&self, point: usize, curve_id: usize) -> Result<Option<f64>, &'static str> {
+        let parameters = self.parameters.get_or_init(|| {
+            crate::sfcc::perf::add(31, 1);
+            let mut parameters = HashMap::new();
+            for pin in self.faces.iter().flat_map(|f| f.values()).flat_map(|f| &f.pins) {
+                crate::sfcc::perf::add(32, 1);
+                let bits = pin.t.to_bits();
+                let entry = parameters.entry((pin.point_id, pin.curve_id)).or_insert(Ok(bits));
+                if *entry != Ok(bits) {
+                    *entry = Err("box_conflicting_pin_parameter");
+                }
+            }
+            crate::sfcc::perf::maximum(34, parameters.len());
+            crate::sfcc::perf::maximum(35, parameters.capacity());
+            parameters
+        });
+        crate::sfcc::perf::add(33, 1);
+        parameters.get(&(point, curve_id)).copied().transpose().map(|v| v.map(f64::from_bits))
+    }
 }
