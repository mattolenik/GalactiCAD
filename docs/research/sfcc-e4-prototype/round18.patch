+        }
+        let exact = Self::image_at(&self.branch, I::point(point[1]))
+            .ok_or(EventFailure::SourceCondition)?;
+        let dx = I::point(point[0])
+            .sub(exact[0])
+            .ok_or(EventFailure::SourceCondition)?;
+        let dz = I::point(point[2])
+            .sub(exact[2])
+            .ok_or(EventFailure::SourceCondition)?;
+        let distance = sqrt(
+            square(dx)
+                .and_then(|x| x.add(square(dz)?))
+                .ok_or(EventFailure::SourceCondition)?,
+        )
+        .ok_or(EventFailure::SourceCondition)?
+        .hi;
+        if !distance.is_finite() || distance > eps {
+            return Err(EventFailure::HelixDistance);
+        }
+        // These are checks on THIS numerical point. Never substitute the radial
+        // proxy or image box for its actual source/profile/domain conditions.
+        let (p, leaf, other, r) = self.features.strata[self.branch.native]
+            .round_twisted_source(&self.features.strata[self.branch.field])
+            .ok_or(EventFailure::SourceBinding)?;
+        let (_, _, _, xz) = twisted(p, point, point).ok_or(EventFailure::SourceCondition)?;
+        if profile_branch(p, leaf, xz).is_none()
+            || !inactive_competitor(other, r, point, point)
+            || (self.branch.sign > 0 && xz[0].lo <= 0.)
+            || (self.branch.sign < 0 && xz[0].hi >= 0.)
+        {
+            return Err(EventFailure::SourceCondition);
+        }
+        for id in [
+            self.branch.native,
+            self.branch.field,
+            self.branch.cylinder_id,
+        ] {
+            let st = &self.features.strata[id];
+            if !st.domain_contains(point, eps)
+                || !st
+                    .raw_field(point[0], point[1], point[2])
+                    .normalized_equation()
+                    .is_some_and(|f| f.value.is_finite() && f.value.abs() <= eps)
+            {
+                return Err(EventFailure::SourceCondition);
+            }
+        }
+        Ok(distance)
+    }
+}
