+#[test]
+fn upper_b_original_source_lifted_field_and_outgoing_curve_recover() {
+    let (root, fixture, cube, tuning) = fixture();
+    let point = outgoing_witness(&root, 3.);
+    let path = [0, 0, 0];
+    let partners = [1, usize::MAX, 1];
+    let old_fields: [FieldSample; 2] = std::array::from_fn(|i| {
+        with_upper_legacy_chamfer(|| {
+            sample_override(&root, &path, &FieldBranch::Child(i), &partners, point)
+        })
+    });
+    let new_fields: [FieldSample; 2] = std::array::from_fn(|i| {
+        sample_override(&root, &path, &FieldBranch::Child(i), &partners, point)
+    });
+    let old_valid: [bool; 2] = std::array::from_fn(|i| {
+        with_upper_legacy_chamfer(|| {
+            override_valid(&root, &path, &FieldBranch::Child(i), &partners, point, 1e-8)
+        })
+    });
+    let new_valid: [bool; 2] = std::array::from_fn(|i| {
+        override_valid(&root, &path, &FieldBranch::Child(i), &partners, point, 1e-8)
+    });
+    let (old, old_runs) = capture_runs(|| {
+        with_upper_legacy_chamfer(|| build_pipeline_context(&root, &cube, &tuning).features)
+    });
+    let (new, new_runs) = capture_runs(|| build_pipeline_context(&root, &cube, &tuning).features);
+    let old_ids = lifted_pair(&old);
+    let new_ids = lifted_pair(&new);
+    let old_near = nearest_compiled(&old, old_ids, point);
+    let new_near = nearest_compiled(&new, new_ids, point);
+    let source_ids = crate::sfcc::stage4_source_preflight_c::selected_pair_c(&new);
+    let admission = source_ids.map(|ids| {
+        match crate::sfcc::private_arc_a::admit(&new, ids, tuning.curve_chord_tol_mm) {
+            Ok(_) => json!({"admitted":true}),
+            Err(e) => json!({"admitted":false,"refusal":e}),
+        }
+    });
+    let report = json!({"scope":"intermediate-operator semantics and sampled actual outgoing feature recovery; no continuous handoff or component proof",
+        "sourceConfigSha256":fixture["sourceConfigSha256"],"witnessPointHex":point.map(hex),"height":3.,"actualRoot":bits(sample_tree(&root,point)),
+        "hardSourcePath":path,"partners":partners,"legacyFields":old_fields.map(bits),"correctedFields":new_fields.map(bits),"legacyValidity":old_valid,"correctedValidity":new_valid,
+        "legacy":{"fingerprint":old.fingerprint().to_string(),"counts":[old.curves.len(),old.corners.len(),old.strata.len(),old.trace_diagnostics.unresolved_trims],"liftedPair":old_ids,"nearest":old_near,"families":families(&old)},
+        "candidate":{"fingerprint":new.fingerprint().to_string(),"counts":[new.curves.len(),new.corners.len(),new.strata.len(),new.trace_diagnostics.unresolved_trims],"liftedPair":new_ids,"nearest":new_near,"families":families(&new),"sourceIdentities":new_ids.map(|id|new.strata[id].graph_capture_identity_b())},
+        "upperRawRuns":{"legacy":old_runs,"candidate":new_runs,"scope":"read-only stored polyline and actual trim frontiers; no added geometry queries"},"completeAdmission":admission,"lowerRepairMustPassSeparateUnchangedGate":true,"wholeComponentAccepted":false});
+    let bytes = serde_json::to_vec_pretty(&report).unwrap();
+    assert!(bytes.len() <= 512 * 1024, "bounded feature evidence");
+    std::fs::write(
+        std::env::var("SFCC_UPPER_B_RECEIPT").expect("root receipt path"),
+        bytes,
+    )
+    .unwrap();
+    assert_eq!(
+        old.fingerprint(),
+        5850573460878635130,
+        "legacy scope reproduces selected parent geometry fingerprint"
+    );
+    assert!(old_fields.iter().all(|s| s.value.abs() > 0.01));
+    assert!(new_fields.iter().all(|s| s.value.abs() < 1e-10));
+    assert_eq!(old_valid, [false, false]);
+    assert_eq!(new_valid, [true, true]);
+    let eps = new
+        .curves
+        .iter()
+        .filter(|c| c.adjacent_strata == new_ids || c.adjacent_strata == [new_ids[1], new_ids[0]])
+        .find_map(|c| c.traced_carriers().map(|(_, _, r)| r.curve_eps * 8.))
+        .unwrap_or(0.);
+    assert!(
+        old_near["nearestDistance"]
+            .as_f64()
+            .is_none_or(|d| d > 0.01),
+        "old source did not represent this outgoing branch near the witness"
+    );
+    assert!(
+        new_near["nearestDistance"]
+            .as_f64()
+            .is_some_and(|d| d <= eps),
+        "correct branch semantics must recover the actual outgoing feature witness"
+    );
+}
