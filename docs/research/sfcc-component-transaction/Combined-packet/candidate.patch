+#[test]
+fn component_a_scope_restores_and_conflicting_merge_is_atomic() {
+    assert!(!enabled());
+    {
+        let _s = Scope::begin();
+        assert!(enabled());
+        {
+            let _nested = Scope::begin();
+            assert!(enabled());
+        }
+        assert!(enabled());
+    }
+    assert!(!enabled());
+    let result = std::panic::catch_unwind(|| {
+        let _s = Scope::begin();
+        panic!("secondary transaction scope");
+    });
+    assert!(result.is_err());
+    assert!(!enabled());
+    let mut map = BTreeMap::from([(2, 1)]);
+    let before = map.clone();
+    assert!(merge_equivalences(&mut map, &BTreeMap::from([(2, 4), (5, 6)])).is_err());
+    assert_eq!(map, before);
+    assert!(merge_equivalences(&mut map, &BTreeMap::from([(1, 4)])).is_err());
+    assert_eq!(map, before);
+    merge_equivalences(&mut map, &BTreeMap::from([(5, 6)])).unwrap();
+    assert_eq!(map[&5], 6);
+}
