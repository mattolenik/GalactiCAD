+    let original = point.map(I::point);
+    let feature_height_gap = I::point(point[1]).sub(face[1])?;
+    let (candidate, radius_label) = (
+        midpoint_image(face),
+        "physical feature and original X-face root",
+    );
+    Some(
+        json!({"scope":"source-bound endpoint images and pointwise comparison only; no raw parameter continuity or mesh mutation",
+        "sourceFingerprint":source.f.fingerprint().to_string(),"chart":source.chart,"source":source.source,"strata":[source.compound_id,source.cylinder_id],
+        "weightBits":source.weight.to_bits(),"offsetBits":source.offset.to_bits(),"physicalChamferRadius":source.chamfer_radius,"generatedRadiusBounds":[generated.lo,generated.hi],
