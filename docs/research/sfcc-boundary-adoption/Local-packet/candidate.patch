+fn triangle_slab(t: &[[f64; 3]; 3], tolerance: f64) -> Option<I> {
+    if !tolerance.is_finite() || tolerance <= 0. || t.iter().flatten().any(|v| !v.is_finite()) {
+        return None;
+    }
+    let lo = t.iter().map(|p| p[0]).fold(f64::INFINITY, f64::min);
+    let hi = t.iter().map(|p| p[0]).fold(f64::NEG_INFINITY, f64::max);
+    interval(I::point(lo).sub(I::point(tolerance))?.lo,
+        I::point(hi).add(I::point(tolerance))?.hi)
+}
