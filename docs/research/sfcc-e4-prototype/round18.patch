+#[test]
+fn correlated_transport_a_full_inventory_and_controls() {
+    let config: Value =
+        serde_json::from_str(include_str!("../../fixtures/shared-arc-full-knob.json")).unwrap();
+    let root = crate::scene_bridge::build_csg_tree_from_json(config["sceneJson"].as_str().unwrap())
+        .unwrap();
+    let size =
+        config["cube"]["max"][0].as_f64().unwrap() - config["cube"]["min"][0].as_f64().unwrap();
+    let tol = crate::tolerances::resolve_tolerances(
+        &crate::tuning::SfccTuning::default(),
+        (3. * size * size).sqrt(),
+    );
+    let (f, _) = crate::sfcc::feature_set::compile_feature_set(&root, &tol);
+    let ids = [20, 33];
+    let fingerprint = f.fingerprint();
+    assert_eq!(
+        fingerprint.to_string(),
+        config["featureFingerprint"].as_str().unwrap()
+    );
+    // The unchanged inspector preserves all original pieces/events, outgoing
+    // endpoint checks and the exact old inverse negative. Its independent
+    // diagnostic queries are not hidden helper work or helper cache authority.
+    let old = crate::sfcc::shared_correlated_gate_c::inspect(&f, ids, 0.02);
+    assert_eq!(old.pieces.len(), 62);
+    assert_eq!(old.original_events.len(), 64);
+    assert_eq!(old.refusal.as_ref().unwrap().reason, "transport_distance");
+    assert!(!old.publication_ready);
+    let negative = old.first_failed_transport.as_ref().unwrap();
+    assert!(
+        f64::from_bits(negative.existing_separation_norm_bits)
+            > f64::from_bits(negative.unchanged_allowance_bits)
+    );
+    let mut solver = Transport::bind(&f, ids, 0.02).unwrap();
+    assert_eq!(solver.pieces.len(), 62);
+    assert_eq!(solver.total, 64);
+    let eps = solver.pieces[0].eps;
+    assert_eq!(eps.to_bits(), negative.unchanged_allowance_bits);
+    let mut transported = Vec::new();
+    let failure = solver.complete(&mut transported).err();
+    let events: Vec<_> = transported
+        .iter()
+        .map(|[original, p, a]| {
+            // Retained endpoint association is checked against actual original IDs,
+            // rather than an approximate geometric endpoint test.
+            let c = &f.curves[original.chart];
+            let t = original.parameter;
+            if t.to_bits() == c.t_min.to_bits() || t.to_bits() == c.t_max.to_bits() {
+                let corner = if t.to_bits() == c.t_min.to_bits() {
+                    c.corner_start
+                } else {
+                    c.corner_end
+                };
+                for e in [p, a] {
+                    let target = &f.curves[e.chart];
+                    let exact = if corner == target.corner_start {
+                        target.t_min
+                    } else {
+                        assert_eq!(corner, target.corner_end);
+                        target.t_max
+                    };
+                    assert_eq!(e.parameter.to_bits(), exact.to_bits());
+                }
+            }
+            json!({"originChart":original.chart,"originalParameterBits":t.to_bits(),
+            "pairs":[pair(original,p,eps),pair(p,a,eps),pair(original,a,eps)]})
+        })
+        .collect();
+    let original_event = solver.query(20, 1., &mut 0).unwrap();
+    let repaired = solver.map(&original_event, 33);
+    let repaired_receipt = match &repaired {
+        Ok(e) => pair(&original_event, e, eps),
+        Err(e) => json!({"refusal":format!("{e:?}")}),
+    };
+    let mut controls = serde_json::Map::new();
+    let first = solver.pieces[0].clone();
+    let event = first.consume(0.5).unwrap();
+    let mut off = event.point;
+    off[0] += 0.001;
+    assert_eq!(off[1].to_bits(), event.point[1].to_bits());
+    assert!(!accepts(event.point, off, eps));
+    assert!(first.check_endpoint_point(off).is_err());
+    controls.insert("sameHeightOffBranchRejected".into(), json!(true));
