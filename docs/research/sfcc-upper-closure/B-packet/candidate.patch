+thread_local! {
+    static UPPER_RUNS: std::cell::RefCell<Option<Vec<Value>>> = const { std::cell::RefCell::new(None) };
+}
+fn capture_runs<T>(f: impl FnOnce() -> T) -> (T, Vec<Value>) {
+    struct Reset;
+    impl Drop for Reset {
+        fn drop(&mut self) {
+            UPPER_RUNS.with(|v| *v.borrow_mut() = None);
+        }
+    }
+    UPPER_RUNS.with(|v| {
+        assert!(v.borrow().is_none());
+        *v.borrow_mut() = Some(Vec::new());
+    });
+    let _reset = Reset;
+    let out = f();
+    let rows = UPPER_RUNS.with(|v| v.borrow_mut().take().unwrap());
+    (out, rows)
+}
+pub(crate) fn observe_upper_runs(
+    tree: &SfccTree<'_>,
+    curve: &crate::sfcc::feature_curves::FeatureCurve,
+    raw: usize,
+    runs: &[crate::sfcc::trim::TrimmedRun],
+) {
+    if !UPPER_RUNS.with(|v| v.borrow().is_some()) {
+        return;
+    }
+    let identities = curve
+        .adjacent_strata
+        .map(|id| tree.strata[id].graph_capture_identity_b());
+    let native = |d: &Option<Value>| {
+        d.as_ref().is_some_and(|d| {
+            d["field"].is_null()
+                && d["domain"][0]["path"] == json!([0, 0, 0, 0, 1])
+                && d["localIndex"] == 3
+        })
+    };
+    let field = |d: &Option<Value>| {
+        d.as_ref()
+            .is_some_and(|d| d["field"]["path"] == json!([0, 0, 0, 0]))
+    };
+    let cylinder = |d: &Option<Value>| {
+        d.as_ref().is_some_and(|d| {
+            d["field"].is_null()
+                && d["domain"][0]["path"] == json!([0, 0, 0, 1])
+                && d["localIndex"] == 0
+        })
+    };
+    if !((cylinder(&identities[0]) && (native(&identities[1]) || field(&identities[1])))
+        || (cylinder(&identities[1]) && (native(&identities[0]) || field(&identities[0]))))
+    {
+        return;
+    }
+    if !curve.index_polyline.chunks_exact(3).any(|p| {
+        p[1] >= 2.4 && p[1] <= 3.2 && p[0] > -8. && p[0] < -5.5 && p[2] > -10. && p[2] < -7.
+    }) {
+        return;
+    }
+    let row = json!({"rawCurve":raw,"sourcePair":curve.adjacent_strata,"sourceIdentities":identities,"rawRangeHex":[hex(curve.t_min),hex(curve.t_max)],
+        "rawIndexPolylineHex":curve.index_polyline.iter().copied().map(hex).collect::<Vec<_>>(),
+        "trimmedRuns":runs.iter().map(|r|json!({"rangeHex":[hex(r.t0),hex(r.t1)],"frontiers":r.frontiers.map(|f|f.map(|f|json!({"initialAliveOtherHex":[hex(f.initial_alive),hex(f.initial_other)],"finalAliveOtherHex":[hex(f.alive),hex(f.other)],"initialOtherStatus":format!("{:?}",f.initial_other_status),"finalOtherStatus":format!("{:?}",f.other_status),"reason":format!("{:?}",f.reason)})))})).collect::<Vec<_>>()});
+    UPPER_RUNS.with(|v| {
+        let mut v = v.borrow_mut();
+        let rows = v.as_mut().unwrap();
+        assert!(rows.len() < 8, "bounded original upper raw runs");
+        rows.push(row);
+    });
+}
+
+fn hex(x: f64) -> String {
+    format!("{:016x}", x.to_bits())
+}
+fn node_at<'a>(mut node: &'a CsgNode, path: &[usize]) -> &'a CsgNode {
+    for &i in path {
+        node = match node {
+            CsgNode::Min(c) | CsgNode::Max(c) | CsgNode::Blend { children: c, .. } => &c[i],
+            _ => panic!("fixture source path"),
+        };
+    }
+    node
+}
