+const HEIGHT: [f64; 2] = [2.6910277686167188, 2.69107776861672];
+const CORNER: [f64; 3] = [
+    f64::from_bits(0xc01ae303f75efc73),
+    f64::from_bits(0x4005871f5a33c661),
+    f64::from_bits(0xc020e81b1b90e888),
