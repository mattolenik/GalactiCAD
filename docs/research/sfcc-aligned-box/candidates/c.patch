@@ -0,0 +1,82 @@
+/** Complete coarse signed-box construction through real WASM worker instances. */
+import assert from "node:assert/strict"
+import { readFileSync, mkdirSync, writeFileSync } from "node:fs"
+import { Worker } from "node:worker_threads"
+import { test } from "node:test"
+import { initSync, export_sfcc, sfcc_worker_prepare, sfcc_worker_merge } from "../wasm/pkg/gcad_wasm.js"
+initSync({ module: readFileSync(new URL("../wasm/pkg/gcad_wasm_bg.wasm", import.meta.url)) })
+const box = (pos, half) => ({ kind: "box", pos, half })
+const scene = JSON.stringify({ kind: "union", children: [box([-1.875, 0, 0], [2.125, 4, 4]),
+    { kind: "intersect", lh: box([2.25, 0, 0], [1.75, 4, 4]), rh: box([-1.625, 0, 0], [2.375, 4, 4]) }] })
+const cube = [-128, -128, -128, 256]
+function worker(data) {
+    return new Promise((resolve, reject) => {
+        const w = new Worker(new URL("./sfcc-discovery-worker.mjs", import.meta.url), { workerData: data })
+        let output
+        w.once("message", value => { output = value })
+        w.once("error", reject)
+        w.once("exit", code => code === 0 && output !== undefined ? resolve(output) : reject(new Error(`worker exit ${code}`)))
+    })
+}
+function canonical(verts, tris) {
+    const bits = new Uint32Array(verts.buffer, verts.byteOffset, verts.length)
+    const rows = []
+    for (let i = 0; i < tris.length; i += 3) {
+        const p = [0, 1, 2].map(j => Array.from(bits.subarray(tris[i + j] * 8, tris[i + j] * 8 + 8)).join(","))
+        rows.push([p.join("|"), [p[1], p[2], p[0]].join("|"), [p[2], p[0], p[1]].join("|")].sort()[0])
+    }
+    return rows.sort()
+}
+test("coarse exact arrangement and real raw workers agree without recovery", { timeout: 180_000 }, async () => {
+    const serial = export_sfcc(scene, "{}", ...cube)
+    try {
+        assert.equal(serial.ok, true)
+        const stats = JSON.parse(serial.stats_json)
+        assert.equal(stats.components, 2)
+        assert.equal(stats.tris, 848)
+        assert.equal(stats.validation.localCoverage.scope, "alignedBoxArrangement")
+        assert.equal(stats.validation.localCoverage.certifiedCells, stats.leaves)
+        assert.equal(stats.validation.unresolvedCells, 0)
+        const expected = canonical(serial.verts, serial.tris)
+        const leaves = sfcc_worker_prepare(scene, "{}", ...cube)
+        const rows = []
+        for (const count of [1, 2, 4, 8]) {
+            const parts = await Promise.all(Array.from({ length: count }, (_, index) => worker({ task: "mesh", scene, tuning: "{}", cube, leaves, index, count })))
+            assert.ok(parts.every(p => new TextDecoder().decode(p.subarray(0, 4)) === "BXC1"))
+            for (const reversed of [false, true]) {
+                const merged = sfcc_worker_merge(scene, "{}", ...cube, reversed ? [...parts].reverse() : parts)
+                try {
+                    const actual = JSON.parse(merged.stats_json)
+                    assert.equal(actual.serialRecovery, false)
+                    assert.equal(merged.ok, true)
+                    assert.deepEqual(actual.validation, stats.validation)
+                    assert.deepEqual(canonical(merged.verts, merged.tris), expected)
+                    assert.deepEqual(merged.feature_edges, serial.feature_edges)
+                    rows.push({ count, reversed, serialRecovery: actual.serialRecovery, wireBytes: parts.reduce((sum, p) => sum + p.length, 0) })
+                } finally { merged.free() }
+            }
+        }
+        if (process.env.SFCC_ARRANGEMENT_C_DIR) {
+            mkdirSync(process.env.SFCC_ARRANGEMENT_C_DIR, { recursive: true })
+            writeFileSync(`${process.env.SFCC_ARRANGEMENT_C_DIR}/wasm-coarse.json`, JSON.stringify({ verts: Array.from(serial.verts), tris: Array.from(serial.tris), stats, workers: rows }) + "\n")
+        }
+    } finally { serial.free() }
+})
+
+test("zero-only shells, edges and points remain explicit incomplete exports", () => {
+    const a = box([0, 0, 0], [1, 1, 1])
+    const cases = [
+        { kind: "subtract", lh: a, rh: a },
+        { kind: "intersect", lh: a, rh: box([2, 2, 0], [1, 1, 1]) },
+        { kind: "intersect", lh: a, rh: box([2, 2, 2], [1, 1, 1]) },
+    ]
+    for (const value of cases) {
+        const result = export_sfcc(JSON.stringify(value), "{}", -8, -8, -8, 16)
+        try {
+            const validation = JSON.parse(result.stats_json).validation
+            assert.equal(result.ok, false)
+            assert.ok(validation.unresolvedCells > 0)
+            assert.ok(validation.localCoverage.unresolved.some(row => row.reason === "arrangement_zero_only_stratum"))
+        } finally { result.free() }
+    }
+})
