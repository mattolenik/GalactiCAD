+#[derive(Debug)]
+pub(crate) enum Failure {
+    Source,
+    Range,
+    Cell,
+    Query,
+    Budget(transport_a::Failure),
+    RequestCap,
+    Container,
+    Bracket,
+    Stagnation,
+    Association,
+    Residual,
+}
+type CResult<T> = std::result::Result<T, Failure>;
+
+pub(crate) struct Event<'a> {
+    features: &'a SfccFeatureSet,
+    point: [f64; 3],
+    parameters: [f64; 2],
+    queries: [[f64; 3]; 2],
+    brackets: [[f64; 2]; 2],
+    cell_box: [f64; 6],
+    source: [usize; 4],
+    charts: [usize; 2],
+    physical_image: ([f64; 3], [f64; 3]),
+    generated_image: ([f64; 3], [f64; 3]),
+    tubes: [([f64; 3], [f64; 3]); 2],
+    allowance: f64,
+}
+impl Event<'_> {
+    pub(crate) fn bound_to(&self, features: &SfccFeatureSet) -> bool {
+        std::ptr::eq(features, self.features)
+    }
+    pub(crate) fn point(&self) -> [f64; 3] {
+        self.point
+    }
+    pub(crate) fn parameters(&self) -> [f64; 2] {
+        self.parameters
+    }
+    pub(crate) fn charts(&self) -> [usize; 2] {
+        self.charts
+    }
+    pub(crate) fn cell_box(&self) -> [f64; 6] {
+        self.cell_box
+    }
+    pub(crate) fn report(&self) -> Value {
+        json!({"scope":"checked interior source event and original numerical parameters; no graph mutation or publication authority",
+            "source":self.source,"charts":self.charts,"pointBits":self.point.map(f64::to_bits),
+            "parametersBits":self.parameters.map(f64::to_bits),"ownQueryBits":self.queries.map(|p|p.map(f64::to_bits)),
+            "originalBracketBits":self.brackets.map(|p|p.map(f64::to_bits)),"cellBoxBits":self.cell_box.map(f64::to_bits),
+            "physicalImageBits":[self.physical_image.0.map(f64::to_bits),self.physical_image.1.map(f64::to_bits)],
+            "generatedImageBits":[self.generated_image.0.map(f64::to_bits),self.generated_image.1.map(f64::to_bits)],
+            "originalTubeBits":self.tubes.map(|p|[p.0.map(f64::to_bits),p.1.map(f64::to_bits)]),
+            "allowance":self.allowance,"zeroStrata":[self.source[0],self.source[1],self.source[3]],
+            "nonzeroSourceCondition":"other lathe distance equals inner-round radius; not its zero carrier",
+            "rawParameterUniquenessProved":false,"rawQueryContinuityProved":false,"mutationPerformed":false})
+    }
+}
+fn middle(image: ([f64; 3], [f64; 3])) -> [f64; 3] {
+    std::array::from_fn(|k| image.0[k] * 0.5 + image.1[k] * 0.5)
+}
+fn distance(point: [f64; 3], image: ([f64; 3], [f64; 3])) -> Option<f64> {
+    let mut sum = I::point(0.);
+    for k in 0..3 {
+        sum = sum.add(square(
+            I::point(point[k]).sub(interval(image.0[k], image.1[k])?)?,
+        )?)?;
+    }
+    Some(sqrt(sum)?.hi)
+}
+fn contains(tube: ([f64; 3], [f64; 3]), p: [f64; 3]) -> bool {
+    p.iter().all(|v| v.is_finite()) && (0..3).all(|k| p[k] >= tube.0[k] && p[k] <= tube.1[k])
+}
+fn query(
+    f: &SfccFeatureSet,
+    chart: usize,
+    t: f64,
+    tube: ([f64; 3], [f64; 3]),
+    budget: &mut Transport<'_>,
+    count: &mut usize,
+    trace: &mut Vec<Value>,
+) -> CResult<[f64; 3]> {
+    if !budget.bound_to(f) || crate::sfcc::private_arc_a::generated_queries_active() {
+        return Err(Failure::Source);
+    }
+    let c = f.curves.get(chart).ok_or(Failure::Source)?;
+    if c.id != chart || !t.is_finite() || t < c.t_min || t > c.t_max {
+        return Err(Failure::Range);
+    }
+    if crate::sfcc::cancel::is_cancelled() {
+        return Err(Failure::Budget(transport_a::Failure::Cancelled));
+    }
+    if *count >= transport_a::MAX_REQUEST {
+        return Err(Failure::RequestCap);
+    }
+    budget.reserve_external(1).map_err(Failure::Budget)?;
+    budget.external_direct_attempt();
+    *count += 1;
+    let p = c.point_at_checked(t);
+    trace.push(json!({"chart":chart,"parameterBits":t.to_bits(),"pointBits":p.map(|p|p.map(f64::to_bits))}));
+    let p = p.ok_or(Failure::Query)?;
+    if !contains(tube, p) {
+        return Err(Failure::Container);
+    }
+    Ok(p)
+}
+fn locate(
+    f: &SfccFeatureSet,
+    chart: usize,
+    range: [f64; 2],
+    tube: ([f64; 3], [f64; 3]),
+    physical: ([f64; 3], [f64; 3]),
+    generated: ([f64; 3], [f64; 3]),
+    epsilon: f64,
+    budget: &mut Transport<'_>,
+    trace: &mut Vec<Value>,
+) -> CResult<(f64, [f64; 3])> {
+    let target = middle(physical)[1];
+    let mut count = 0;
+    let mut low = (
+        range[0],
+        query(f, chart, range[0], tube, budget, &mut count, trace)?,
+    );
+    let mut high = (
+        range[1],
+        query(f, chart, range[1], tube, budget, &mut count, trace)?,
+    );
+    let accepted = |p| {
+        distance(p, physical).is_some_and(|d| d <= epsilon)
+            && distance(p, generated).is_some_and(|d| d <= epsilon)
+    };
+    if accepted(low.1) || accepted(high.1) {
+        return Err(Failure::Range); // This plan requires an interior cut, not an endpoint relabel.
+    }
+    if low.1[1] == high.1[1]
+        || target <= low.1[1].min(high.1[1])
+        || target >= low.1[1].max(high.1[1])
+    {
+        return Err(Failure::Bracket);
+    }
+    let ascending = high.1[1] > low.1[1];
+    for iteration in 0..transport_a::MAX_ITERATIONS {
+        let proposal = if iteration < 2 {
+            transport_a::height_proposal(low.0, high.0, low.1[1], high.1[1], target)
+        } else {
+            None
+        };
+        let t = proposal.unwrap_or(low.0 + (high.0 - low.0) * 0.5);
+        if !t.is_finite() || t <= low.0 || t >= high.0 {
+            return Err(Failure::Stagnation);
+        }
+        let p = query(f, chart, t, tube, budget, &mut count, trace)?;
+        if accepted(p) {
+            return Ok((t, p));
+        }
+        if (p[1] < target) == ascending {
+            low = (t, p);
+        } else {
+            high = (t, p);
+        }
+    }
+    Err(Failure::RequestCap)
+}
+
+pub(crate) fn prepare<'a>(
+    f: &'a SfccFeatureSet,
+    cert: &activation_a::Certificate<'a>,
+    brackets: [[f64; 2]; 2],
+    cell_box: [f64; 6],
+    epsilon: f64,
+    budget: &mut Transport<'_>,
+    trace: &mut Vec<Value>,
+) -> CResult<Event<'a>> {
+    if !cert.bound_to(f) || !budget.bound_to(f) || !epsilon.is_finite() || epsilon <= 0. {
+        return Err(Failure::Source);
+    }
+    if cell_box.iter().any(|v| !v.is_finite()) || (0..3).any(|k| cell_box[k] >= cell_box[k + 3]) {
+        return Err(Failure::Cell);
+    }
+    let mut strict = f64::INFINITY;
+    let mut tubes = [([0.; 3], [0.; 3]); 2];
+    for i in 0..2 {
+        let c = f.curves.get(cert.charts[i]).ok_or(Failure::Source)?;
+        if c.id != cert.charts[i]
+            || c.closed
+            || !brackets[i].iter().all(|t| t.is_finite())
+            || brackets[i][0] < c.t_min
+            || brackets[i][1] > c.t_max
+            || brackets[i][0] >= brackets[i][1]
+        {
+            return Err(Failure::Range);
+        }
+        strict = strict.min(c.traced_carriers().ok_or(Failure::Source)?.2.curve_eps);
+        tubes[i] = c
+            .projection_tube(brackets[i][0], brackets[i][1])
+            .ok_or(Failure::Container)?;
+    }
+    if !strict.is_finite() || strict <= 0. || epsilon > 8. * strict {
+        return Err(Failure::Source);
+    }
+    let physical = cert.activation_image(false).ok_or(Failure::Source)?;
+    let generated = cert.activation_image(true).ok_or(Failure::Source)?;
+    for image in [physical, generated] {
+        if !(0..3).all(|k| {
+            image.0[k] > (cell_box[k] + epsilon).next_up()
+                && image.1[k] < (cell_box[k + 3] - epsilon).next_down()
+        }) {
+            return Err(Failure::Cell);
+        }
+    }
+    let point = middle(physical);
+    if !contains(tubes[0], point)
+        || !contains(tubes[1], point)
+        || !distance(point, physical).is_some_and(|d| d <= epsilon)
+        || !distance(point, generated).is_some_and(|d| d <= epsilon)
+    {
+        return Err(Failure::Association);
+    }
+    for id in [cert.source[0], cert.source[1], cert.source[3]] {
+        let value = f
+            .strata
+            .get(id)
+            .ok_or(Failure::Source)?
+            .raw_field(point[0], point[1], point[2])
+            .normalized_equation()
+            .ok_or(Failure::Residual)?
+            .value;
+        if !value.is_finite() || value.abs() > strict {
+            return Err(Failure::Residual);
+        }
+    }
+    let first = locate(
+        f,
+        cert.charts[0],
+        brackets[0],
+        tubes[0],
+        physical,
+        generated,
+        epsilon,
+        budget,
+        trace,
+    )?;
+    let second = locate(
+        f,
+        cert.charts[1],
+        brackets[1],
+        tubes[1],
+        physical,
+        generated,
+        epsilon,
+        budget,
+        trace,
+    )?;
+    if !transport_a::accepts(point, first.1, epsilon)
+        || !transport_a::accepts(point, second.1, epsilon)
+        || !transport_a::accepts(first.1, second.1, epsilon)
+    {
+        return Err(Failure::Association);
+    }
+    Ok(Event {
+        features: f,
+        point,
+        parameters: [first.0, second.0],
+        queries: [first.1, second.1],
+        brackets,
+        cell_box,
+        source: cert.source,
+        charts: cert.charts,
+        physical_image: physical,
+        generated_image: generated,
+        tubes,
+        allowance: epsilon,
+    })
+}
