+#[test]
+fn inverse_c_preserves_source_distance_order_cancellation_and_total_refusals() {
+    let (f, ids) = fixture();
+    let mut solver = Transport::bind(&f, ids, 0.02).unwrap();
+    let t = f.curves[ids[0]].t_min + 0.25;
+    let own = solver.own(ids[0], t).unwrap();
+    let mapped = solver.map(&own, ids[1]).unwrap();
+    let charged = solver.total;
+    let repeated = solver.map(&own, ids[1]).unwrap();
+    assert_eq!(mapped.parameter.to_bits(), repeated.parameter.to_bits());
+    assert_eq!(
+        mapped.point.map(f64::to_bits),
+        repeated.point.map(f64::to_bits)
+    );
+    assert_eq!(solver.total, charged);
+    let mut forged = own.clone();
+    forged.point[0] += 0.001;
+    assert_eq!(forged.point[1].to_bits(), own.point[1].to_bits());
+    assert_eq!(solver.map(&forged, ids[1]).unwrap_err(), Failure::Source);
+    assert!(solver.retained(ids[0], t, forged.point).is_err());
+    assert_eq!(
+        Transport::ordered(Some(mapped.parameter), &mapped, 1.),
+        Err(Failure::Order)
+    );
+    assert_eq!(
+        Transport::ordered(Some(mapped.parameter + 1.), &mapped, 1.),
+        Err(Failure::Order)
+    );
+    {
+        let _cancel = crate::sfcc::cancel::CancelGuard::install(Box::new(|| true));
+        assert_eq!(solver.map(&own, ids[1]).unwrap_err(), Failure::Cancelled);
+    }
+    assert_eq!(solver.total, charged);
+    let mut wrong = f.clone();
+    wrong.strata[solver.admitted_branch().cylinder_id].sign = -1.;
+    assert!(matches!(
+        Transport::bind(&wrong, ids, 0.02),
+        Err(Failure::Source)
+    ));
+    let mut limited = Transport::bind(&f, ids, 0.02).unwrap();
+    let own = limited.own(ids[0], t).unwrap();
+    limited.reserve_external(MAX_TOTAL - limited.total).unwrap();
+    assert_eq!(limited.map(&own, ids[1]).unwrap_err(), Failure::TotalCap);
+    assert_eq!(limited.total, MAX_TOTAL);
+    assert_eq!(limited.cost.consume_failures, 0);
+    assert_eq!(limited.cost.total_cap_refusals, 1);
+    assert_eq!(limited.cost.failed_maps, 1);
+}
