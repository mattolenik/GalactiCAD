+// Zero-locus agreement is insufficient at a<0: prove this finite side is nearest.
+fn finite_profile_level(p: TwistedSideParams, leaf: &Leaf, q: [I; 2], a: I) -> Option<f64> {
+    profile_branch(p, leaf, q)?;
+    let Shape::Extrude { verts, .. } = &leaf.shape else {
+        return None;
+    };
+    let n = verts.len() / 2;
+    let v = |i: usize| [verts[2 * (i % n)], verts[2 * (i % n) + 1]];
+    let selected = (0..n).find(|&i| v(i) == [p.v0x, p.v0z])?;
+    let orientation = crate::sfcc::predicates::orient2d(v(0), v(1), v(2)) as f64;
+    let mut margin = f64::INFINITY;
+    for i in 0..n {
+        if i == selected {
+            continue;
+        }
+        let start = v(i);
+        let end = v(i + 1);
+        let ex = I::point(end[0]).sub(I::point(start[0]))?;
+        let ez = I::point(end[1]).sub(I::point(start[1]))?;
+        let wx = q[0].sub(I::point(start[0]))?;
+        let wz = q[1].sub(I::point(start[1]))?;
+        let line = quotient(
+            mul(ex, wz)?.sub(mul(ez, wx)?)?.mul(orientation)?,
+            sqrt(square(ex)?.add(square(ez)?)?)?,
+        )?;
+        let gap = line.sub(I::point(max_abs(a)))?;
+        if gap.lo <= 0. {
+            return None;
+        }
+        margin = margin.min(gap.lo);
+    }
+    Some(margin)
+}
+fn cap_margin(y: I, center: f64, half: f64, a: I) -> Option<f64> {
+    if !half.is_finite() || half <= 0. {
+        return None;
+    }
+    let local = y.sub(I::point(center))?;
+    let cap = I::point(max_abs(local)).sub(I::point(half))?;
+    let margin = I::point(a.lo).sub(cap)?;
+    (margin.lo > 0.).then_some(margin.lo)
+}
+fn negative_groove_upper(groove: &Leaf, y: I) -> Option<f64> {
+    let Shape::Lathe { edges } = &groove.shape else {
+        return None;
+    };
+    if edges.len() < 3
+        || edges.len() > 64
+        || !edges
+            .iter()
+            .any(|e| !matches!(e.kind, crate::primitives::shapes::LatheEdgeKind::None))
+    {
+        return None;
+    }
+    let mut top = f64::NEG_INFINITY;
+    for (i, e) in edges.iter().enumerate() {
+        let next = &edges[(i + 1) % edges.len()];
+        if [e.r0, e.r1, e.y0, e.y1].iter().any(|v| !v.is_finite())
+            || e.r1 != next.r0
+            || e.y1 != next.y0
+        {
+            return None;
+        }
+        top = top.max(e.y0).max(e.y1);
+    }
+    let gap = y.sub(I::point(groove.pos[1]))?.sub(I::point(top))?;
+    (gap.lo > 0.).then_some(-gap.lo)
+}
