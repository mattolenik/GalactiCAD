// Straight knurl (axial ridges): `knurl` wraps groove + repeatPolar + tooth box sizing.
// Base and pattern cylinders use the same layout as the manual recipe (Y-up, centered on Y in XZ).

const cylR = 2.2
const cylHHalf = 3 // 6 units tall — `Cylinder.h` is half-height along Y
const cylCy = cylHHalf

const cyl = cylinder.radius(cylR).height(cylHHalf).shift([0, cylCy, 0])

// Pattern cylinder: r → radial bite (box half-extent x), h → caps axial band (min with base h, ×0.92)
const knurlTool = cylinder.radius(0.14).height(cylHHalf)

return knurl(cyl).pattern(knurlTool, 32)
