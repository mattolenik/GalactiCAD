// Passenger Car Model
// A classic vintage roadster with flowing curves


// === MAIN BODY ===
// Central body tub - narrow and elegant
let bodyTub = box({ pos: [0, 0, 8], size: [44, 14, 6] })

// Rounded front cowl
let cowl = sphere({ pos: [10, 0, 9], r: 10 })

// Rounded rear deck
let rearDeck = sphere({ pos: [-16, 0, 8], r: 9 })

// Smooth the main body
let mainBody = union({ r: 4 }, bodyTub, cowl, rearDeck)

// === LONG HOOD ===
// Classic long hood with power bulge
let hoodBase = box({ pos: [20, 0, 7], size: [24, 10, 5] })
let hoodTop = sphere({ pos: [22, 0, 9], r: 7 })
let hood = union({ r: 3 }, hoodBase, hoodTop)

// Radiator grille at front
let grille = box({ pos: [34, 0, 7], size: [4, 8, 7] })
let grilleTop = sphere({ pos: [35, 0, 10], r: 5 })
let frontEnd = union({ r: 2 }, grille, grilleTop)

// === SEPARATE FENDERS ===
// Front fenders - swooping pontoon style
let fenderFR = sphere({ pos: [22, 10, 5], r: 7 })
let fenderFRext = sphere({ pos: [30, 10, 6], r: 5 })
let frontFenderR = union({ r: 3 }, fenderFR, fenderFRext)

let fenderFL = sphere({ pos: [22, -10, 5], r: 7 })
let fenderFLext = sphere({ pos: [30, -10, 6], r: 5 })
let frontFenderL = union({ r: 3 }, fenderFL, fenderFLext)

// Rear fenders - rounded pontoons
let fenderRR = sphere({ pos: [-18, 10, 5], r: 7 })
let fenderRRext = sphere({ pos: [-24, 10, 6], r: 5 })
let rearFenderR = union({ r: 3 }, fenderRR, fenderRRext)

let fenderRL = sphere({ pos: [-18, -10, 5], r: 7 })
let fenderRLext = sphere({ pos: [-24, -10, 6], r: 5 })
let rearFenderL = union({ r: 3 }, fenderRL, fenderRLext)

// === RUNNING BOARDS ===
// Connect front and rear fenders
let runningBoardR = box({ pos: [2, 10, 3], size: [30, 3, 2] })
let runningBoardL = box({ pos: [2, -10, 3], size: [30, 3, 2] })

// === CABIN ===
// Open cockpit with windshield frame
let cockpit = box({ pos: [-2, 0, 12], size: [16, 12, 5] })
let windshieldFrame = box({ pos: [8, 0, 15], size: [2, 11, 4] })
let cabinArea = union({ r: 2 }, cockpit, windshieldFrame)

// Carve out interior
let interior = box({ pos: [-2, 0, 13], size: [14, 10, 6] })
let openCockpit = subtract({ r: 1 }, cabinArea, interior)

// === SPARE TIRE ===
// Mounted on rear
let spareTire = sphere({ pos: [-28, 0, 8], r: 5 })

// === HEADLIGHTS ===
// Classic round headlights on stalks
let headlightR = sphere({ pos: [32, 9, 9], r: 3 })
let headlightL = sphere({ pos: [32, -9, 9], r: 3 })
let headlights = union(headlightR, headlightL)

// === WHEELS ===
// Wire wheels with whitewall look
let wheelFR = sphere({ pos: [22, 12, 3], r: 5 })
let wheelFL = sphere({ pos: [22, -12, 3], r: 5 })
let wheelRR = sphere({ pos: [-18, 12, 3], r: 5 })
let wheelRL = sphere({ pos: [-18, -12, 3], r: 5 })
let wheels = union(wheelFR, wheelFL, wheelRR, wheelRL)

// === TAILLIGHTS ===
let taillightR = sphere({ pos: [-28, 6, 10], r: 1.5 })
let taillightL = sphere({ pos: [-28, -6, 10], r: 1.5 })
let taillights = union(taillightR, taillightL)

// === DOOR HANDLES ===
let handleR = sphere({ pos: [0, 8, 10], r: 1 })
let handleL = sphere({ pos: [0, -8, 10], r: 1 })
let handles = union(handleR, handleL)

// === ASSEMBLY ===
// Build up the body
let upperBody = union({ r: 3 }, mainBody, hood, frontEnd, openCockpit)

// Add fenders
let withFenders = union({ r: 2 }, upperBody,
frontFenderR, frontFenderL,
rearFenderR, rearFenderL)

// Add running boards
let withRunning = union({ r: 1 }, withFenders,
runningBoardR, runningBoardL)

// Final details
let details = union(spareTire, headlights, taillights, handles)

// Complete car
return union({ r: 1 }, withRunning, wheels, details)
