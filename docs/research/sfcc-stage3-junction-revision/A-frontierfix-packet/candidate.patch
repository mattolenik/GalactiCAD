+        let c = make_segment_curve(0, -1, [0, 1], 0., 0., 0., 1., 0., 0.);
+        let mut tol =
+            crate::tolerances::resolve_tolerances(&crate::tuning::SfccTuning::default(), 1.);
+        tol.corner_merge_tol = 0.04;
+        let (_, first_end) = bisect_transition_bounded(
+            &|t| if t < 0.23 { Ok(true) } else { Err(()) },
+            &c,
+            0.,
+            0.2426778243,
+            true,
+            &tol,
+            40,
+        );
+        let (_, last_start) = bisect_transition_bounded(
+            &|t| if t > 0.77 { Ok(true) } else { Err(()) },
+            &c,
+            1.,
+            1. - 0.2426778243,
+            true,
+            &tol,
+            40,
+        );
+        let first_end = first_end.unwrap();
+        let last_start = last_start.unwrap();
+        let first = TrimmedRun {
+            curve_idx: 7,
+            t0: 0.,
+            t1: first_end.alive,
+            full_closed: false,
+            frontiers: [None, Some(first_end)],
+        };
+        let last = TrimmedRun {
+            curve_idx: 7,
+            t0: last_start.alive,
+            t1: 1.,
+            full_closed: false,
+            frontiers: [Some(last_start), None],
+        };
+        let joined = join_wrapped_runs(first, last, 1.);
+        assert_eq!(joined.curve_idx, 7);
+        assert!(joined.t0 < 0. && joined.t1 > 0.);
+        assert_eq!(joined.frontiers, [Some(last_start), Some(first_end)]);
+        assert!(
+            joined.frontiers[0].unwrap().initial_other > 0.,
+            "wrapping run coordinates must not translate the original raw-frame search container"
+        );
+        assert_eq!(joined.frontiers[1].unwrap().initial_other, 0.2426778243);
+    }
