+            let checks:Option<Vec<_>>=[ta,ta+(tb-ta)*0.25,(ta+tb)*0.5,ta+(tb-ta)*0.75,tb].into_iter().map(|t|{
+                let p=c.point_at_checked(t)?;let q=prove(root, &f.strata,pair,p,eps)?;if q.sign!=sign || q.source!=expected_source{return None;}
+                Some(json!({"parameterHex":encode(t),"pointHex":p.map(encode),"associationUpperHex":encode(q.distance_upper)}))
+            }).collect();
+            let Some(checks) = checks else {
+                continue;
+            };
+            matches.push(json!({"curve":c.id,"sourcePair":c.adjacent_strata,"sourceRoles":expected_source,"branchSign":sign,"cornerEnds":[c.corner_start,c.corner_end],"indexingPiece":i,"ownParameterRangeHex":[encode(ta),encode(tb)],"requiredHeightHex":height.map(encode),"sourceDeterminantLowerHex":encode(rank),"checkedQueries":checks}));
+        }
+    }
