+//! Test-only corruptions: a source event does not make a declared star complete.
+use super::*;
+use crate::sfcc::{
+    feature_curves::{make_traced_curve, FeatureCurve},
+    feature_set::{next_feature_set_run_id, SfccCorner, SfccFeatureSet},
+    pipeline::{build_pipeline_context, PipelineTuning, SfccWorldCube},
+    private_arc_a, shared_arc_plan,
+    shared_twisted_proof::correlated_c::transport_a::Transport,
+    spatial_index::SfccSpatialIndex,
+};
+use serde_json::{json, Value};
+
+fn hex(x: f64) -> String {
+    format!("{:016x}", x.to_bits())
+}
+fn middle(image: ([f64; 3], [f64; 3])) -> [f64; 3] {
+    std::array::from_fn(|k| image.0[k] * 0.5 + image.1[k] * 0.5)
+}
+fn event_point(source: &UpperCertificate, eps: f64) -> ([f64; 3], f64) {
+    let image = source.point_image(0.).unwrap();
+    let point = middle(image);
+    let mut sum = I::point(0.);
+    for k in 0..3 {
+        sum = sum
+            .add(
+                square(
+                    I::point(point[k])
+                        .sub(interval(image.0[k], image.1[k]).unwrap())
+                        .unwrap(),
+                )
+                .unwrap(),
+            )
+            .unwrap();
+    }
+    let bound = sqrt(sum).unwrap().hi;
+    assert!(
+        bound <= eps,
+        "numerical event representative must be source-associated"
+    );
+    (point, bound)
+}
+fn fixture() -> (CsgNode, SfccFeatureSet, [usize; 2], UpperCertificate, Value) {
+    let config: Value =
+        serde_json::from_str(include_str!("../../fixtures/shared-arc-full-knob.json")).unwrap();
+    let root = crate::scene_bridge::build_csg_tree_from_json(config["sceneJson"].as_str().unwrap())
+        .unwrap();
+    let cube = SfccWorldCube {
+        min_x: config["cube"]["min"][0].as_f64().unwrap(),
+        min_y: config["cube"]["min"][1].as_f64().unwrap(),
+        min_z: config["cube"]["min"][2].as_f64().unwrap(),
+        size: config["cube"]["max"][0].as_f64().unwrap()
+            - config["cube"]["min"][0].as_f64().unwrap(),
+    };
+    let features = build_pipeline_context(&root, &cube, &PipelineTuning::default()).features;
+    let ids = crate::sfcc::stage4_source_preflight_c::selected_pair_c(&features).unwrap();
+    let tube = features.curves[ids[0]].projection_tube(0., 1.).unwrap();
+    let branch = HelixBranch::identify(&features, ids[0], ids[1], tube).unwrap();
+    let source = bind(&root, &features.strata, &branch, 0.5)
+        .expect("actual full-scalar source continuation must be independently established");
+    (root, features, ids, source, config)
+}
+fn lifted_sources(f: &SfccFeatureSet) -> [usize; 2] {
+    std::array::from_fn(|side| {
+        let matches: Vec<_> = f
+            .strata
+            .iter()
+            .filter(|s| {
+                let Some(d) = s.graph_capture_identity_b() else {
+                    return false;
+                };
+                d["field"]["path"] == json!([])
+                    && d["field"]["branch"]["path"] == json!([0, 0, 0])
+                    && d["field"]["branch"]["kind"] == format!("Child({side})")
+                    && d["field"]["partners"] == json!([1, usize::MAX, 1])
+            })
+            .map(|s| s.id)
+            .collect();
+        assert_eq!(
+            matches.len(),
+            1,
+            "actual lifted source occurrence is unique"
+        );
+        matches[0]
+    })
+}
+fn outgoing(f: &SfccFeatureSet, source: &UpperCertificate, eps: f64) -> (usize, u8) {
+    let pair = lifted_sources(f);
+    let witness = middle(source.point_image(0.25).unwrap());
+    let event = middle(source.point_image(0.).unwrap());
+    let matches: Vec<_> = f
+        .curves
+        .iter()
+        .filter(|c| c.adjacent_strata == pair || c.adjacent_strata == [pair[1], pair[0]])
+        .filter_map(|c| {
+            let t = c.project(witness[0], witness[1], witness[2]).0;
+            let p = c.shared_checked_point(t)?;
+            super::super::super::correlated_c::transport_a::accepts(witness, p, eps).then_some(c.id)
+        })
+        .collect();
+    assert_eq!(matches.len(), 1, "one actual checked outgoing witness");
+    let id = matches[0];
+    let c = &f.curves[id];
+    let distance = |t| {
+        let p = c.shared_checked_point(t).unwrap();
+        (p[0] - event[0])
+            .hypot(p[1] - event[1])
+            .hypot(p[2] - event[2])
+    };
+    let end = if distance(c.t_min) < distance(c.t_max) {
+        0
+    } else {
+        1
+    };
+    assert_eq!([c.corner_start, c.corner_end][end as usize], -1);
+    (id, end)
+}
+fn replace_endpoint(c: &FeatureCurve, end: u8, point: [f64; 3]) -> FeatureCurve {
+    assert!(!c.closed && c.connection_identity().is_none());
+    let (sa, sb, refine) = c.traced_carriers().unwrap();
+    let mut samples = c.index_polyline.clone();
+    let offset = if end == 0 { 0 } else { samples.len() - 3 };
+    samples[offset..offset + 3].copy_from_slice(&point);
+    let mut out = make_traced_curve(
+        c.id,
+        c.adjacent_strata,
+        samples,
+        false,
+        sa,
+        sb,
+        refine,
+        c.owner_node_id,
+    );
+    out.native = c.native;
+    out.corner_start = c.corner_start;
+    out.corner_end = c.corner_end;
+    out
+}
+fn rebuild_index(f: &mut SfccFeatureSet) {
+    // The corruption control keeps a valid conservative index and a fresh cache identity.
+    let mut index = SfccSpatialIndex::new(1.);
+    for c in &f.curves {
+        index.insert_curve(c);
+    }
+    for c in &f.corners {
+        index.insert_corner(c.id, c.x, c.y, c.z);
+    }
+    f.index = index;
+    f.run_id = next_feature_set_run_id();
+}
+fn counterfactual(
+    original: &SfccFeatureSet,
+    incoming: [usize; 2],
+    point: [f64; 3],
+    outgoing: Option<(usize, u8)>,
+    rebuild_endpoints: bool,
+) -> (SfccFeatureSet, usize) {
+    let mut f = original.clone();
+    let corner = f.corners.len();
+    let mut ends = incoming.map(|id| (id, 1_u8)).to_vec();
+    if let Some(outgoing) = outgoing {
+        ends.push(outgoing);
+    }
+    let mut strata = std::collections::BTreeSet::new();
+    for &(id, end) in &ends {
+        assert_eq!(
+            [f.curves[id].corner_start, f.curves[id].corner_end][end as usize],
+            -1
+        );
+        if rebuild_endpoints {
+            f.curves[id] = replace_endpoint(&f.curves[id], end, point);
+        }
+        if end == 0 {
+            f.curves[id].corner_start = corner as i64;
+        } else {
+            f.curves[id].corner_end = corner as i64;
+        }
+        strata.extend(f.curves[id].adjacent_strata);
+    }
+    f.corners.push(SfccCorner {
+        id: corner,
+        x: point[0],
+        y: point[1],
+        z: point[2],
+        strata: strata.into_iter().collect(),
+        curve_ends: ends,
+    });
+    rebuild_index(&mut f);
+    (f, corner)
+}
+fn endpoint_result(f: &SfccFeatureSet, ids: [usize; 2], corner: usize, eps: f64) -> Value {
+    match shared_arc_plan::endpoint(f, ids, corner as i64, eps) {
+        Ok(v) => json!({"accepted":true,"endpoint":v}),
+        Err(e) => json!({"accepted":false,"refusal":e}),
+    }
+}
+fn admit_result(f: &SfccFeatureSet, ids: [usize; 2]) -> Value {
+    match private_arc_a::admit(f, ids, 0.02) {
+        Ok((v, t)) => {
+            json!({"accepted":true,"physical":v.physical,"alias":v.alias,"events":v.events.len(),"chargedQueries":t.charged_queries()})
+        }
+        Err(e) => json!({"accepted":false,"refusal":e}),
+    }
+}
+fn write(tag: Option<&str>, value: &Value) {
+    let path = std::path::PathBuf::from(
+        std::env::var("SFCC_CLOSURE_C_RECEIPT").expect("root receipt required"),
+    );
+    let path = match tag {
+        Some(tag) => path.with_file_name(format!("closure-C-{tag}.json")),
+        None => path,
+    };
+    let bytes = serde_json::to_vec_pretty(value).unwrap();
+    assert!(bytes.len() <= 512 * 1024, "bounded counterexample receipt");
+    std::fs::write(path, bytes).unwrap();
+}
+
+#[test]
+fn closure_c_declared_endpoint_success_is_not_other_consumer_authority() {
+    let (_root, f, ids, source, config) = fixture();
+    let before = f.fingerprint();
+    let eps = shared_arc_plan::numerical(&f, ids[0], ids[1], 0.02).unwrap();
+    let (event, association) = event_point(&source, eps);
+    let out = outgoing(&f, &source, eps);
+
+    let (ids_only, c0) = counterfactual(&f, ids, event, None, false);
+    let ids_only_result = endpoint_result(&ids_only, ids, c0, eps);
+
+    let (complete, corner) = counterfactual(&f, ids, event, Some(out), true);
+    let complete_result = endpoint_result(&complete, ids, corner, eps);
+    let mut omitted = complete.clone();
+    let native: std::collections::BTreeSet<_> = ids
+        .into_iter()
+        .flat_map(|id| omitted.curves[id].adjacent_strata)
+        .collect();
+    omitted.corners[corner]
+        .strata
+        .retain(|s| native.contains(s));
+    let omitted_result = endpoint_result(&omitted, ids, corner, eps);
+    let outgoing_t = if out.1 == 0 {
+        omitted.curves[out.0].t_min
+    } else {
+        omitted.curves[out.0].t_max
+    };
+    let actual = omitted.curves[out.0]
+        .shared_checked_point(outgoing_t)
+        .unwrap();
+    let mut transport = Transport::bind(&omitted, ids, 0.02)
+        .expect("counterfactual incoming source chart containers remain supported");
+    let other =
+        private_arc_a::check_other_point(&mut transport, &omitted, ids, out.0, outgoing_t, actual);
+    let other_row = match &other {
+        Ok(()) => json!({"accepted":true}),
+        Err(e) => json!({"accepted":false,"refusal":e}),
+    };
+    let admission = admit_result(&omitted, ids);
+    let report = json!({"scope":"test-only endpoint/membership corruptions on actual compiled source; no runtime handoff",
+        "sourceConfigSha256":config["sourceConfigSha256"],"originalFingerprint":before.to_string(),
+        "sourceEventImageHex":[source.point_image(0.).unwrap().0.map(hex),source.point_image(0.).unwrap().1.map(hex)],
+        "eventPointHex":event.map(hex),"eventAssociationUpperHex":hex(association),"sourceContinuationProved":true,"incoming":ids,"outgoing":out,
+        "endpointIdsOnly":ids_only_result,"completeDeclaredStrata":complete.corners[corner].strata,
+        "completeDeclaredMembershipResult":complete_result,"omittedLiftedStrata":omitted.corners[corner].strata,
+        "omittedMembershipEndpointResult":omitted_result,"otherPointConsumer":other_row,"completeAdmission":admission,
+        "outgoingActualEndpointHex":actual.map(hex),"outgoingDomainChecks":omitted.curves[out.0].adjacent_strata.map(|sid|omitted.strata[sid].domain_contains(actual,eps)),
+        "originalFeatureFingerprintPreserved":f.fingerprint()==before,"counterfactualSourceIntervalCoverageProved":false});
+    write(Some("consumers"), &report);
+    assert_eq!(f.fingerprint(), before);
+    assert_eq!(
+        ids_only_result["accepted"], false,
+        "corner IDs do not move checked queries"
+    );
+    assert_eq!(
+        complete_result["accepted"], false,
+        "owned-domain exclusion remains a real gate"
+    );
+    assert_eq!(
+        omitted_result["accepted"], true,
+        "the narrow helper checks declared corner membership, not completeness of its declaration"
+    );
+    assert!(
+        other.is_err(),
+        "generated/retained event consumer must not inherit narrow endpoint success"
+    );
+    assert_eq!(
+        admission["accepted"], false,
+        "full admission must not accept unqualified lifted closure by metadata omission"
+    );
+}
+
+#[test]
+fn closure_c_required_outgoing_source_obligation_cannot_be_omitted() {
+    let (_root, f, ids, source, config) = fixture();
+    let before = f.fingerprint();
+    let eps = shared_arc_plan::numerical(&f, ids[0], ids[1], 0.02).unwrap();
+    let (event, association) = event_point(&source, eps);
+    let (incoming_only, corner) = counterfactual(&f, ids, event, None, true);
+    let eps = shared_arc_plan::numerical(&incoming_only, ids[0], ids[1], 0.02).unwrap();
+    let endpoint = endpoint_result(&incoming_only, ids, corner, eps);
+    let admission = admit_result(&incoming_only, ids);
+    let remaining_after_alias = incoming_only.corners[corner]
+        .curve_ends
+        .iter()
+        .filter(|(id, _)| *id != ids[1])
+        .count();
+    let report = json!({"scope":"test-only omission of proved outgoing source obligation; not a naturally produced feature set",
+        "sourceConfigSha256":config["sourceConfigSha256"],"originalFingerprint":before.to_string(),"eventPointHex":event.map(hex),"eventAssociationUpperHex":hex(association),
+        "sourceRoles":source.source,"sourceContinuationProved":true,"sourcePhiRange":[0.,source.phi_max],
+        "positiveTransverseMinor":source.transverse_minor_lower,"incoming":ids,"syntheticCorner":incoming_only.corners[corner].id,
+        "declaredStrata":incoming_only.corners[corner].strata,"declaredCurveEnds":incoming_only.corners[corner].curve_ends,
+        "physicalIncidentEndsAfterAliasRemoval":remaining_after_alias,"declaredMetadataInternallyConsistent":true,
+        "narrowEndpointResult":endpoint,"completeAdmission":admission,"originalFeatureFingerprintPreserved":f.fingerprint()==before,
+        "sourceCompleteHandoff":false,"requiredBehavior":"a known continuing source crease cannot be accepted as an incoming-only terminal after alias removal"});
+    write(None, &report);
+    assert_eq!(f.fingerprint(), before);
+    assert_eq!(remaining_after_alias, 1);
+    assert_eq!(
+        endpoint["accepted"], true,
+        "the internally coherent incoming-only metadata passes the narrow endpoint gate"
+    );
+    assert_eq!(admission["accepted"], false,
+        "passing declared endpoint/transport checks must not be mistaken for complete incident source coverage");
+}
