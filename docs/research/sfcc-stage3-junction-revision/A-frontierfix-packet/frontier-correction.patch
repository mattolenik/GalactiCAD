+
+fn join_wrapped_runs(first: TrimmedRun, last: TrimmedRun, wrap: f64) -> TrimmedRun {
+    TrimmedRun {
+        curve_idx: first.curve_idx,
+        t0: last.t0 - wrap,
+        t1: first.t1,
+        full_closed: false,
+        frontiers: [last.frontiers[0], first.frontiers[1]],
+    }
 }
 
