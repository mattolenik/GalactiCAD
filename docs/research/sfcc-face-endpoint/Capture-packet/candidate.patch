+//! Whole captured face neighborhood: projected union and one source slab, not ideal feature transport.
+use super::fullfan_source_a;
+use crate::sfcc::{mesh_edit::GrowingIndex, predicates::orient2d, triangle_quality as q};
+use crate::sdf::enclosure::Interval as I;
+use serde_json::{json,Value};
+use std::collections::{BTreeMap,BTreeSet};
+type Point=[f64;3];
+type Result<T>=std::result::Result<T,&'static str>;
+fn edge(a:usize,b:usize)->[usize;2]{[a.min(b),a.max(b)]}
+fn yz(p:Point)->[f64;2]{[p[1],p[2]]}
+
+pub(crate) struct Domain { report:Value, triangles:Vec<usize>, export_bounds:Vec<f64> }
+impl Domain { pub(crate) fn report(&self)->&Value{&self.report} }
+
+/// All patches must be distinct emitted triangle families in one provenance-bound ID space.
+pub(crate) fn audit(
+    points:&BTreeMap<usize,Point>, patches:&[Vec<usize>], segments:[[usize;2];2], endpoint:usize,
+)->Result<Domain>{
+    let count=patches.iter().try_fold(0usize,|n,p|n.checked_add(p.len())).ok_or("face_triangle_cap")?;
+    if patches.len()<2 || patches.len()>4 || points.len()>128 || count==0 || count%3!=0 || count>3*128
+        || patches.iter().any(|p|p.is_empty()||p.len()%3!=0||!p.contains(&endpoint))
+        || segments.iter().any(|s|s[0]==s[1]||!s.contains(&endpoint))
+        || edge(segments[0][0],segments[0][1])==edge(segments[1][0],segments[1][1]) {
+        return Err("face_domain_inventory");
+    }
+    let triangles:Vec<_>=patches.iter().flatten().copied().collect();
+    let used:BTreeSet<_>=triangles.iter().copied().collect();
+    if used.len()>128 || used.iter().any(|id|*id>=4096||points.get(id).is_none_or(|p|p.iter().any(|v|!v.is_finite()))) {
+        return Err("face_point_inventory");
+    }
+    let n=count/3;
+    let pair_checks=n.checked_mul(n.saturating_sub(1)).ok_or("face_contact_cap")?/2;
+    if pair_checks>4096 {return Err("face_contact_cap");}
+    let topology=crate::sfcc::private_arc_a::stage4_component_b::topology(&triangles,used.last().copied().ok_or("face_empty")?+1)?;
+    if topology["localTopologyValid"]!=true {return Err("face_indexed_topology");}
+    let mut edges:BTreeMap<[usize;2],Vec<(usize,[usize;2])>>=BTreeMap::new();
+    for (i,t) in triangles.chunks_exact(3).enumerate(){for k in 0..3{
+        let d=[t[k],t[(k+1)%3]];edges.entry(edge(d[0],d[1])).or_default().push((i,d));
+    }}
+    for s in segments {
+        let uses=edges.get(&edge(s[0],s[1])).ok_or("face_missing_shared_segment")?;
+        if uses.len()!=2 || uses[0].1!=[uses[1].1[1],uses[1].1[0]] {return Err("face_shared_segment_incidence");}
+    }
+    let mut seen=BTreeSet::new();let mut todo=vec![0usize];
+    while let Some(i)=todo.pop(){if seen.insert(i){
+        let t=&triangles[3*i..3*i+3];
+        for k in 0..3 {for &(j,_) in &edges[&edge(t[k],t[(k+1)%3])] {if j!=i {todo.push(j);}}}
+    }}
+    if seen.len()!=n {return Err("face_disconnected_triangles");}
+    let boundary:Vec<[usize;2]>=serde_json::from_value(topology["boundaryEdges"].clone()).map_err(|_|"face_boundary_encoding")?;
+    if boundary.is_empty() || boundary.iter().any(|e|e.contains(&endpoint)) {return Err("face_endpoint_not_interior");}
+    let mut next=BTreeMap::new();let mut incoming=BTreeSet::new();
+    for e in &boundary {if next.insert(e[0],e[1]).is_some()||!incoming.insert(e[1]){return Err("face_boundary_degree");}}
+    let start=*next.keys().next().ok_or("face_boundary_empty")?;let mut cycle=Vec::new();let mut current=start;
+    loop {
+        if cycle.contains(&current){return Err("face_boundary_repeated_vertex");}
+        cycle.push(current);current=*next.get(&current).ok_or("face_boundary_gap")?;
+        if current==start{break;} if cycle.len()>=next.len(){return Err("face_boundary_not_closed");}
+    }
+    if cycle.len()!=next.len(){return Err("face_multiple_boundary_cycles");}
+    let mut winding=0i8;
+    for rounded in [false,true] {
+        let mut projected=Vec::new();
+        for id in &used {
+            let p=points[id];let p=if rounded{q::rounded(p)}else{p};
+            if p.iter().any(|v|!v.is_finite())||projected.contains(&yz(p)){return Err("face_projected_vertex_collision");}
+            projected.push(yz(p));
+        }
+        let mut index=GrowingIndex::new();let mut this_winding=0;
+        for t in triangles.chunks_exact(3) {
+            let ids=[t[0],t[1],t[2]];
+            let p=ids.map(|id|{let p=points[&id];let p=if rounded{q::rounded(p)}else{p};[0.,p[1],p[2]]});
+            let sign=orient2d(yz(p[0]),yz(p[1]),yz(p[2]));
+            if sign==0 || (this_winding!=0&&sign!=this_winding){return Err("face_projected_fold");}
+            this_winding=sign;
+            if index.conflicts(ids,p){return Err("face_projected_contact_working_or_exported");}
+            index.extend([(ids,p)]);
+        }
+        if rounded && this_winding!=winding{return Err("face_export_orientation_reversal");}
+        winding=this_winding;
+    }
+    let mut export_bounds=Vec::with_capacity(n);
+    for t in triangles.chunks_exact(3){let mut bound=0.0_f64;
+        for id in t {let p=points[id];let rounded=q::rounded(p);let mut norm=I::point(0.);
+            for k in 0..3 {norm=norm.add(crate::sfcc::loft_seam::square(I::point(p[k]).sub(I::point(rounded[k])).ok_or("face_rounding_bound")?).ok_or("face_rounding_bound")?).ok_or("face_rounding_bound")?;}
+            bound=bound.max(norm.hi.sqrt().next_up());
+        }
+        if !bound.is_finite(){return Err("face_rounding_bound");}export_bounds.push(bound);
+    }
+    let report=json!({"scope":"complete supplied triangle union around both captured contour segments; source and ideal feature constraints are separate",
+        "triangles":triangles,"patchTriangleCounts":patches.iter().map(|p|p.len()/3).collect::<Vec<_>>(),
+        "pointBits":used.iter().map(|id|json!([id,points[id].map(f64::to_bits)])).collect::<Vec<_>>(),
+        "sharedSegments":segments,"commonEndpoint":endpoint,"endpointIsInterior":true,
+        "connectedIndexedDisk":true,"workingAndExportedProjectedUnionEmbedded":true,"projectedWinding":winding,
+        "trianglePairsCheckedPerPrecision":pair_checks,"outerBoundary":cycle,"topology":topology,
+        "sourceGraphProvedHere":false,"idealFeatureEndpointProved":false,"publicationReady":false});
+    Ok(Domain{report,triangles,export_bounds})
+}
+
+pub(crate) fn combine_error(domain:&Domain, source:&Value, tolerance:f64)->Result<Value>{
+    let bounds:Vec<f64>=serde_json::from_value(source["perTriangleSourceBounds"].clone()).map_err(|_|"face_source_bounds")?;
+    if bounds.len()!=domain.export_bounds.len() || source["triangleCount"].as_u64()!=Some(bounds.len() as u64)
+        || source["fullClosedTriangleDomainsCovered"]!=true || source["sharedEdgeRootsAgreeByCommonSlabUniqueness"]!=true
+        || source["tolerance"].as_f64().map(f64::to_bits)!=Some(tolerance.to_bits())
+        || !tolerance.is_finite() || tolerance<=0. || domain.report["projectedWinding"]!=-1 {
+        return Err("face_source_scope");
+    }
+    let mut upper=0.0_f64;
+    for (&a,&b) in bounds.iter().zip(&domain.export_bounds){
+        if !a.is_finite()||a<0.||!b.is_finite()||b<0.{return Err("face_error_bound");}
+        upper=upper.max(I::point(a).add(I::point(b)).ok_or("face_error_bound")?.hi);
+    }
+    if upper>tolerance{return Err("face_error_tolerance");}
+    Ok(json!({"conditionalSourceToExportUpper":upper,"tolerance":tolerance,
+        "sourceAndGeometryTriangleOrderMustBeBound":true,"commonEndpointSurfaceRootUnique":true,
+        "bothContourSourceTracesCompatible":true,"idealFeatureEndpointProved":false,"publicationReady":false}))
+}
+
+#[test]
+fn face_c_union_requires_all_sectors_and_conforming_projection(){
+    let mut p=BTreeMap::from([(0,[0.,0.,0.]),(1,[0.,-1.,-1.]),(2,[0.,1.,-1.]),(3,[0.,1.,1.]),(4,[0.,-1.,1.])]);
+    let t=vec![vec![0,1,2],vec![0,2,3],vec![0,3,4],vec![0,4,1]];
+    let r=audit(&p,&t,[[1,0],[0,3]],0).unwrap();assert_eq!(r.report()["endpointIsInterior"],true);
+    assert!(audit(&p,&t[..3],[[1,0],[0,3]],0).is_err());
+    let mut duplicated=t.clone();duplicated[3]=duplicated[0].clone();assert!(audit(&p,&duplicated,[[1,0],[0,3]],0).is_err());
+    p.insert(3,[0.,-2.,0.]);assert!(audit(&p,&t,[[1,0],[0,3]],0).is_err());
+}
+#[test]
+fn face_c_rejects_renamed_endpoint_and_export_collapse(){
+    let mut p=BTreeMap::from([(0,[0.,0.,0.]),(1,[0.,-1.,-1.]),(2,[0.,1.,-1.]),(3,[0.,1.,1.]),(4,[0.,-1.,1.]),(5,[0.,0.,0.])]);
+    let mut t=vec![vec![0,1,2],vec![0,2,3],vec![0,3,4],vec![0,4,1]];
+    t[3][0]=5;assert!(audit(&p,&t,[[1,0],[0,3]],0).is_err());t[3][0]=0;
+    p.insert(2,[0.,-1.+1e-10,-1.]);assert!(audit(&p,&t,[[1,0],[0,3]],0).is_err());
+}
