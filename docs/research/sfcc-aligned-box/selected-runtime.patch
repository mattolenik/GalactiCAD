+fn canonical(v: &[f32], t: &[u32]) -> Vec<Vec<u32>> {
+    let mut out = Vec::new();
+    for t in t.chunks_exact(3) {
+        let vv: Vec<Vec<_>> = t
+            .iter()
+            .map(|&i| {
+                v[i as usize * 8..i as usize * 8 + 8]
+                    .iter()
+                    .map(|v| v.to_bits())
+                    .collect()
+            })
+            .collect();
+        let t = (0..3)
+            .map(|i| {
+                vv[i]
+                    .iter()
+                    .chain(&vv[(i + 1) % 3])
+                    .chain(&vv[(i + 2) % 3])
+                    .copied()
+                    .collect::<Vec<_>>()
+            })
+            .min()
+            .unwrap();
+        out.push(t);
+    }
+    out.sort();
+    out
