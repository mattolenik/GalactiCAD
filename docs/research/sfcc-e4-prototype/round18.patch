+/// Attempt the full original two-chart interval/event inventory; named refusal
+/// retains every original range and every enumerated piece. No cell execution.
+pub(crate) fn inspect(f: &SfccFeatureSet, ids: [usize; 2], tolerance: f64) -> CorrelatedInventory {
+    let mut report=CorrelatedInventory{fingerprint:f.fingerprint(),originals:originals(f,ids),pieces:Vec::new(),endpoints:Vec::new(),original_events:Vec::new(),events:Vec::new(),refusal:None,first_failed_transport:None,
