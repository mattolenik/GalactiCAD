+    fn setup() -> (
+        CsgNode,
+        SfccLattice,
+        super::super::point_table::PointTable,
+        Vec<usize>,
+    ) {
+        let tree = crate::scene_bridge::build_csg_tree_from_json(
+            r#"{"kind":"box","pos":[0,0,0],"half":[1,1,1]}"#,
+        )
+        .unwrap();
+        let lat = crate::math::grid::make_lattice(8, -4., -4., -4., 8.);
+        let c = SfccCell {
+            level: 0,
+            ix: 0,
+            iy: 0,
+            iz: 0,
+            key: 0,
+            degenerate: false,
+            feature_curve: -1,
+            feature_corner: -1,
+        };
+        let a = Arrangement::build(&tree, &lat, &[c], ArrangementBudget::default()).unwrap();
+        let mut pt = super::super::point_table::PointTable::new();
+        let t = a.emit(&[c], &mut pt);
+        (tree, lat, pt, t)
+    }
+    #[test]
+    fn receiver_rebuilds_erased_snapshot_then_cleanup_rejects_mutation() {
+        let (tree, lat, mut pt, t) = setup();
+        for w in &mut pt.coverage {
+            w.vertices.clear();
+            w.curves.clear();
+        }
+        reverify(&mut pt, &tree, &lat, &t);
+        assert!(pt
+            .coverage
+            .iter()
+            .all(|w| w.reason.is_none() && !w.vertices.is_empty() && !w.curves.is_empty()));
+        pt.set_normal(0, 0.1, 0.2, 0.3);
+        super::super::local_coverage::finish(&mut pt, &t, &t);
+        assert!(pt.coverage.iter().all(|w| w.reason.is_some()));
+    }
+    #[test]
+    fn receiver_rejects_omitted_facet_and_appended_curve_membership() {
+        let (tree, lat, mut pt, mut t) = setup();
+        t.truncate(t.len() - 3);
+        reverify(&mut pt, &tree, &lat, &t);
+        assert!(pt.coverage.iter().all(|w| w.reason.is_some()));
+        let (tree, lat, mut pt, t) = setup();
+        let (e, i) = pt
+            .identified_edges()
+            .next()
+            .map(|(e, i)| (e, i[0]))
+            .unwrap();
+        pt.protect_curve_edge(
+            e.0,
+            e.1,
+            super::super::point_table::CurveInterval {
+                end: i.end.next_up(),
+                ..i
+            },
+        );
+        reverify(&mut pt, &tree, &lat, &t);
+        assert!(pt.coverage.iter().all(|w| w.reason.is_some()));
+    }
+    #[test]
+    fn successful_decimal_fast_box_remains_outside_exact_arrangement_attempt() {
+        let tree = crate::scene_bridge::build_csg_tree_from_json(
+            r#"{"kind":"box","pos":[0.1,0.2,0.3],"half":[1.1,1.2,1.3]}"#,
+        )
+        .unwrap();
+        let lat = crate::math::grid::make_lattice(8, -4., -4., -4., 8.);
+        assert!(matches!(fallback(&tree, &lat, &[]), Ok(None)));
+    }
+}
