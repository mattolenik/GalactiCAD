+//! Exact transport of supplied pregraph metadata; no source-patch authority.
+use crate::sfcc::{
+    face_contour::{FacePin, FaceRecord},
+    point_table::{CurveInterval, PointKey, PointTable},
+};
+use std::collections::{BTreeMap, BTreeSet, HashMap};
+type FaceId = (usize, i64, i64);
+type Result<T> = std::result::Result<T, &'static str>;
+
+pub(crate) struct Inputs<'a> {
+    pub live: &'a PointTable,
+    pub private: &'a PointTable,
+    pub faces: &'a [HashMap<i64, FaceRecord>; 3],
+    pub staged: &'a [HashMap<i64, FaceRecord>; 3],
+    pub required: &'a BTreeSet<FaceId>,
+    pub needed: &'a BTreeSet<usize>,
+    pub equivalences: &'a BTreeMap<usize, usize>,
+    pub map: &'a BTreeMap<usize, usize>,
+    pub primary: [usize; 2],
+    pub pin_parameters: &'a BTreeMap<usize, [f64; 2]>,
+}
+#[derive(Debug, serde::Serialize)]
+pub(crate) struct Receipt {
+    original_points: usize,
+    canonical_points: usize,
+    merged_point_keys: usize,
+    unkeyed_points: usize,
+    faces: usize,
+    original_pins: usize,
+    primary_alias_pins: usize,
+    removed_zero_segments: usize,
+    retained_protected_edges: usize,
+    retained_curve_memberships: usize,
+    exact_payload_keys_and_pin_transport: bool,
+    protection_interval_bits_preserved: bool,
+    new_query_attempts: usize,
+    checker_dynamic_allocations: usize,
+    scope: &'static str,
+}
+impl Inputs<'_> {
+    fn canonical(&self, id: usize) -> usize {
+        self.equivalences.get(&id).copied().unwrap_or(id)
+    }
+    fn mapped(&self, id: usize) -> Result<usize> {
+        if id >= self.live.count() || !self.needed.contains(&id) {
+            return Err("metadata_original_point_scope");
+        }
+        let canonical = self.canonical(id);
+        if canonical >= self.live.count()
+            || !self.needed.contains(&canonical)
+            || self.canonical(canonical) != canonical
+        {
+            return Err("metadata_canonical_point_scope");
+        }
+        self.map
+            .get(&canonical)
+            .copied()
+            .filter(|&p| p < self.private.count())
+            .ok_or("metadata_private_point_binding")
+    }
+    fn pin(&self, pin: &FacePin) -> Result<FacePin> {
+        if !pin.t.is_finite() {
+            return Err("metadata_nonfinite_pin_parameter");
+        }
+        let mut expected = *pin;
+        expected.point_id = self.mapped(pin.point_id)?;
+        if expected.curve_id == self.primary[1] {
+            let pair = self
+                .pin_parameters
+                .get(&self.canonical(pin.point_id))
+                .ok_or("metadata_primary_pin_transport");
+            let pair = pair?;
+            if !pair.iter().all(|t| t.is_finite()) || pin.t.to_bits() != pair[1].to_bits() {
+                return Err("metadata_primary_pin_parameter");
+            }
+            expected.curve_id = self.primary[0];
+            expected.t = pair[0];
+        }
+        Ok(expected)
+    }
+}
+fn payload(points: &PointTable, id: usize) -> [u64; 6] {
+    [
+        points.x(id),
+        points.y(id),
+        points.z(id),
+        points.nx(id),
+        points.ny(id),
+        points.nz(id),
+    ]
+    .map(f64::to_bits)
+}
+fn same_pin(a: &FacePin, b: &FacePin) -> bool {
+    a.point_id == b.point_id && a.curve_id == b.curve_id && a.t.to_bits() == b.t.to_bits()
+}
+fn same_interval(a: &CurveInterval, b: &CurveInterval) -> bool {
+    a.curve_id == b.curve_id
+        && a.start.to_bits() == b.start.to_bits()
+        && a.end.to_bits() == b.end.to_bits()
+}
+
+/// Uses borrowed caller collections and scalar iteration only. JSON serialization is outside this checker.
+pub(crate) fn audit(input: Inputs<'_>) -> Result<Receipt> {
+    if input.primary[0] == input.primary[1]
+        || input.needed.len() > 4096
+        || input.map.len() > 4096
+        || input.private.count() > 4096
+        || input.required.len() > 1536
+    {
+        return Err("metadata_scope_cap");
+    }
+    let mut r = Receipt { original_points: input.needed.len(), canonical_points: input.map.len(),
+        merged_point_keys: 0, unkeyed_points: 0, faces: input.required.len(), original_pins: 0,
+        primary_alias_pins: 0, removed_zero_segments: 0, retained_protected_edges: 0,
+        retained_curve_memberships: 0, exact_payload_keys_and_pin_transport: true,
+        protection_interval_bits_preserved: true, new_query_attempts: 0, checker_dynamic_allocations: 0,
+        scope: "supplied pregraph point/face/protection/interval records under already-authorized equivalences; not emitted-edge realization, unsupplied metadata, patch ownership, or whole-program memory" };
+    for (&canonical, &local) in input.map {
+        if input.canonical(canonical) != canonical
+            || !input.needed.contains(&canonical)
+            || local >= input.private.count()
+            || input
+                .map
+                .iter()
+                .any(|(&other, &p)| other != canonical && p == local)
+        {
+            return Err("metadata_noninjective_canonical_map");
+        }
+    }
+    for &old in input.needed {
+        let local = input.mapped(old)?;
+        let canonical = input.canonical(old);
+        if payload(input.live, canonical) != payload(input.private, local)
+            || input.live.key_at(canonical) != input.private.key_at(local)
+        {
+            return Err("metadata_canonical_payload_or_key_changed");
+        }
+        r.merged_point_keys += usize::from(old != canonical);
+        r.unkeyed_points += usize::from(matches!(input.live.key_at(old), PointKey::Unkeyed));
+    }
+    for &(axis, key, len) in input.required {
+        if axis >= 3 {
+            return Err("metadata_face_axis");
+        }
+        let old = input.faces[axis]
+            .get(&key)
+            .ok_or("metadata_original_face_missing")?;
+        let new = input.staged[axis]
+            .get(&key)
+            .ok_or("metadata_staged_face_missing")?;
+        if old.axis != axis
+            || old.key != key
+            || old.len != len
+            || new.axis != axis
+            || new.key != key
+            || new.len != len
+            || old.interior_cycle != new.interior_cycle
+            || new.consumed_fwd.len() != new.segments.len()
+            || new.consumed_rev.len() != new.segments.len()
+        {
+            return Err("metadata_face_identity_or_shape");
+        }
+        let mut position = 0;
+        for segment in &old.segments {
+            let (a, b) = (input.mapped(segment.a)?, input.mapped(segment.b)?);
+            if a == b {
+                r.removed_zero_segments += 1;
+                continue;
+            }
+            if !new
+                .segments
+                .get(position)
+                .is_some_and(|s| s.a == a && s.b == b)
+            {
+                return Err("metadata_directed_segment_transport");
+            }
+            position += 1;
+        }
+        if position != new.segments.len() {
+            return Err("metadata_invented_segment");
+        }
+        r.original_pins = r
+            .original_pins
+            .checked_add(old.pins.len())
+            .ok_or("metadata_pin_cap")?;
+        if r.original_pins > 1024 || new.pins.len() > 1024 {
+            return Err("metadata_pin_cap");
+        }
+        for pin in &old.pins {
+            let expected = input.pin(pin)?;
+            r.primary_alias_pins += usize::from(pin.curve_id == input.primary[1]);
+            if !new.pins.iter().any(|p| same_pin(p, &expected)) {
+                return Err("metadata_missing_or_changed_pin");
+            }
+        }
+        for (i, pin) in new.pins.iter().enumerate() {
+            if new.pins[..i].iter().any(|p| same_pin(p, pin)) {
+                return Err("metadata_duplicate_pin");
+            }
+            let mut found = false;
+            for original in &old.pins {
+                if same_pin(pin, &input.pin(original)?) {
+                    found = true;
+                    break;
+                }
+            }
+            if !found {
+                return Err("metadata_invented_pin");
+            }
+        }
+    }
+    for (a, b) in input.live.protected_edges() {
+        if !input.needed.contains(&a) && !input.needed.contains(&b) {
+            continue;
+        }
+        r.retained_protected_edges += 1;
+        if r.retained_protected_edges > 2048 {
+            return Err("metadata_protected_edge_cap");
+        }
+        let (a, b) = (input.mapped(a)?, input.mapped(b)?);
+        if a == b || !input.private.edge_is_protected(a, b) {
+            return Err("metadata_protected_edge_lost");
+        }
+    }
+    for ((a, b), intervals) in input.live.identified_edges() {
+        if !input.needed.contains(&a) && !input.needed.contains(&b) {
+            continue;
+        }
+        let (a, b) = (input.mapped(a)?, input.mapped(b)?);
+        if a == b {
+            return Err("metadata_interval_collapsed");
+        }
+        for interval in intervals {
+            r.retained_curve_memberships += 1;
+            if r.retained_curve_memberships > 2048 {
+                return Err("metadata_interval_cap");
+            }
+            if !interval.start.is_finite()
+                || !interval.end.is_finite()
+                || interval.start == interval.end
+            {
+                return Err("metadata_invalid_original_interval");
+            }
+            let expected = if a < b {
+                *interval
+            } else {
+                interval.reversed()
+            };
+            if !input.private.identified_edges().any(|(edge, rows)| {
+                edge == (a.min(b), a.max(b)) && rows.iter().any(|row| same_interval(row, &expected))
+            }) {
+                return Err("metadata_oriented_interval_lost");
+            }
+        }
+    }
+    Ok(r)
+}
+
