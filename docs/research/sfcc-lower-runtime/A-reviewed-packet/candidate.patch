+//! Atomic attachment of the proved lower lifted interval to its existing source event.
+use super::*;
+use crate::sfcc::feature_set::{SfccCorner, SfccFeatureSet};
+
+#[derive(Clone)]
+pub(crate) struct LowerChart {
+    cert: LowerCertificate,
+    pub span: [f64; 2],
+    ends: [[f64; 3]; 2],
+    curve: usize,
+    corner: usize,
+    original_range: [f64; 2],
+    original_ends: Vec<(usize, u8)>,
+    allowance: f64,
+}
+impl std::fmt::Debug for LowerChart {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_tuple("LowerChart").field(&self.words()).finish()
+    }
+}
+fn distance(point: [f64; 3], image: ([f64; 3], [f64; 3])) -> Option<f64> {
+    let mut d = I::point(0.);
+    for k in 0..3 {
+        d = d.add(square(
+            I::point(point[k]).sub(interval(image.0[k], image.1[k])?)?,
+        )?)?;
+    }
+    Some(sqrt(d)?.hi)
+}
+fn middle(image: ([f64; 3], [f64; 3])) -> [f64; 3] {
+    std::array::from_fn(|k| image.0[k] * 0.5 + image.1[k] * 0.5)
+}
+impl LowerChart {
+    pub(crate) fn contains(&self, t: f64) -> bool {
+        t.is_finite() && t >= self.span[0] && t <= self.span[1]
+    }
+    fn level(&self, t: f64) -> Option<f64> {
+        if !self.contains(t) || self.span[0] >= self.span[1] {
+            return None;
+        }
+        Some(
+            (-self.cert.depth * (1. - (t - self.span[0]) / (self.span[1] - self.span[0])))
+                .clamp(-self.cert.depth, 0.),
+        )
+    }
+    fn ideal_image(&self, a: f64, b: f64) -> Option<([f64; 3], [f64; 3])> {
+        if a > b {
+            return None;
+        }
+        self.cert.image_bounds(self.level(a)?, self.level(b)?)
+    }
+    pub(crate) fn image(&self, a: f64, b: f64) -> Option<([f64; 3], [f64; 3])> {
+        let (mut lo, mut hi) = self.ideal_image(a, a)?;
+        let mut previous = a;
+        for i in 1..=16 {
+            let next = if i == 16 {
+                b
+            } else {
+                a + (b - a) * i as f64 / 16.
+            };
+            let (l, h) = self.ideal_image(previous, next)?;
+            for k in 0..3 {
+                lo[k] = lo[k].min(l[k]);
+                hi[k] = hi[k].max(h[k]);
+            }
+            previous = next;
+        }
+        for (t, p) in self.span.into_iter().zip(self.ends) {
+            if a <= t && t <= b {
+                for k in 0..3 {
+                    lo[k] = lo[k].min(p[k]);
+                    hi[k] = hi[k].max(p[k]);
+                }
+            }
+        }
+        Some((lo, hi))
+    }
+    pub(crate) fn point(&self, t: f64) -> Option<[f64; 3]> {
+        let image = self.ideal_image(t, t)?;
+        let p = if t == self.span[0] {
+            self.ends[0]
+        } else if t == self.span[1] {
+            self.ends[1]
+        } else {
+            middle(image)
+        };
+        (distance(p, image)? <= self.allowance).then_some(p)
+    }
+    pub(crate) fn tangent(&self, t: f64) -> Option<[f64; 3]> {
+        let a = self.level(t)?;
+        let p = self.cert.branch.p;
+        let (nr, ny) = self.cert.normal()?;
+        let nr = (nr.lo + nr.hi) * 0.5;
+        let ny = (ny.lo + ny.hi) * 0.5;
+        let yp = (1. - nr) / ny;
+        let rho = self.cert.branch.cylinder.2 + a;
+        let v = p.v0z + p.nz2 * a;
+        let u = self.cert.branch.sign as f64 * (rho * rho - v * v).sqrt();
+        let up = (rho - v * p.nz2) / u;
+        let y = middle(self.cert.image_bounds(a, a)?)[1];
+        let k = p.twist_rad / (2. * p.h);
+        let (sn, cs) = (k * (y - p.pos_y + p.h)).sin_cos();
+        let d = [
+            up * cs - p.nz2 * sn - k * yp * (u * sn + v * cs),
+            yp,
+            up * sn + p.nz2 * cs + k * yp * (u * cs - v * sn),
+        ];
+        let norm = d[0].hypot(d[1]).hypot(d[2]);
+        (norm.is_finite() && norm > 0.).then_some(d.map(|v| v / norm))
+    }
+    pub(crate) fn installation_matches(&self, c: &FeatureCurve) -> bool {
+        if c.id != self.curve
+            || c.adjacent_strata != self.cert.lifted_pair
+            || c.corner_end >= 0
+            || self.original_range != [c.t_min, c.t_max]
+            || self.span != [c.t_max - 1., c.t_max]
+        {
+            return false;
+        }
+        let Some((a, b, _)) = c.traced_carriers() else {
+            return false;
+        };
+        if !a.connection_same_source(&self.cert.embedded[0])
+            || !b.connection_same_source(&self.cert.embedded[1])
+        {
+            return false;
+        }
+        checked(c, self.span[0])
+            .is_some_and(|p| p.map(f64::to_bits) == self.ends[0].map(f64::to_bits))
+    }
+    pub(crate) fn member(
+        &self,
+        strata: &[Stratum],
+        c: &FeatureCurve,
+        sid: usize,
+        t: f64,
+        p: [f64; 3],
+        eps: f64,
+    ) -> bool {
+        if !eps.is_finite()
+            || eps <= 0.
+            || c.id != self.curve
+            || c.closed
+            || self.original_range != [c.t_min, c.t_max]
+            || self.span != [c.t_max - 1., c.t_max]
+            || c.corner_end != self.corner as i64
+            || !self.cert.lifted_pair.contains(&sid)
+            || !self.contains(t)
+            || !self.cert.curve_source_matches(strata, c)
+        {
+            return false;
+        }
+        let Some(root) = strata
+            .get(self.cert.source[0])
+            .and_then(Stratum::exposure_root_a)
+        else {
+            return false;
+        };
+        let Some(rebound) = bind(
+            root,
+            strata,
+            self.cert.source,
+            self.ends[1],
+            self.allowance,
+            self.cert.depth,
+        ) else {
+            return false;
+        };
+        if self.cert_words() != certificate_words(&rebound) {
+            return false;
+        }
+        self.ideal_image(t, t)
+            .and_then(|image| distance(p, image))
+            .is_some_and(|d| d <= eps.min(self.allowance))
+    }
+    fn cert_words(&self) -> Vec<u64> {
+        certificate_words(&self.cert)
+    }
+    pub(crate) fn words(&self) -> Vec<u64> {
+        let mut out = self.cert_words();
+        out.extend([self.curve as u64, self.corner as u64]);
+        out.extend(self.span.map(f64::to_bits));
+        out.extend(self.original_range.map(f64::to_bits));
+        out.push(self.allowance.to_bits());
+        for p in self.ends {
+            out.extend(p.map(f64::to_bits));
+        }
+        out.push(self.original_ends.len() as u64);
+        for &(c, e) in &self.original_ends {
+            out.extend([c as u64, e as u64]);
+        }
+        out
+    }
+    pub(crate) fn private_owned_storage(
+        &self,
+        l: &mut crate::sfcc::source_storage_a::Ledger,
+    ) -> crate::sfcc::source_storage_a::Result<()> {
+        let Self {
+            cert,
+            span,
+            ends,
+            curve,
+            corner,
+            original_range,
+            original_ends,
+            allowance,
+        } = self;
+        l.inline_copy(&(*span, *ends, *curve, *corner, *original_range, *allowance));
+        l.vector("curve.lower_ends", original_ends)?;
+        let LowerCertificate {
+            branch,
+            source_root,
+            embedded,
+            edge,
+            orientation,
+            groove_y,
+            radius,
+            depth,
+            source,
+            lifted_pair,
+            groove_edge,
+            margins,
+            height_derivative_lower,
+            coordinate_jacobian_lower,
+        } = cert;
+        l.shared("shared.source_root_handle", source_root)?;
+        for s in embedded {
+            s.private_owned_storage_a(l)?;
+        }
+        l.inline_copy(&(
+            *edge,
+            *orientation,
+            *groove_y,
+            *radius,
+            *depth,
+            *source,
+            *lifted_pair,
+            *groove_edge,
+            *margins,
+            *height_derivative_lower,
+            *coordinate_jacobian_lower,
+        ));
+        let HelixBranch {
+            native,
+            field,
+            cylinder_id,
+            p,
+            cylinder,
+            u,
+            sign,
+        } = branch;
+        l.inline_copy(&(*native, *field, *cylinder_id, *p, *cylinder, *u, *sign));
+        Ok(())
+    }
+    #[cfg(test)]
+    pub(crate) fn clone_equal(&self, b: &Self) -> bool {
+        std::sync::Arc::ptr_eq(&self.cert.source_root, &b.cert.source_root)
+            && self.words() == b.words()
+            && self
+                .cert
+                .embedded
+                .iter()
+                .zip(&b.cert.embedded)
+                .all(|(a, b)| a.private_storage_clone_equal_a(b))
+    }
+    #[cfg(test)]
+    pub(crate) fn corrupt_end(&mut self) {
+        self.ends[1][0] += 0.1;
+    }
+}
+fn certificate_words(c: &LowerCertificate) -> Vec<u64> {
+    let p = c.branch.p;
+    let mut out = Vec::new();
+    out.extend(c.source.map(|v| v as u64));
+    out.extend(c.lifted_pair.map(|v| v as u64));
+    out.extend([
+        c.groove_edge as u64,
+        c.orientation as i64 as u64,
+        c.branch.sign as i64 as u64,
+    ]);
+    out.extend(c.edge.map(f64::to_bits));
+    out.extend(c.margins.map(f64::to_bits));
+    out.extend(
+        [
+            c.groove_y,
+            c.radius,
+            c.depth,
+            c.height_derivative_lower,
+            c.coordinate_jacobian_lower,
+            p.pos_x,
+            p.pos_y,
+            p.pos_z,
+            p.h,
+            p.twist_rad,
+            p.v0x,
+            p.v0z,
+            p.nx2,
+            p.nz2,
+            p.sim.s,
+            c.branch.cylinder.2,
+            c.branch.u.lo,
+            c.branch.u.hi,
+        ]
+        .map(f64::to_bits),
+    );
+    out.extend(p.sim.r.map(f64::to_bits));
+    out.extend(p.sim.t.map(f64::to_bits));
+    out.extend(c.branch.cylinder.0.map(f64::to_bits));
+    out.extend(c.branch.cylinder.1.map(f64::to_bits));
+    let mut ctx = crate::sfcc::provenance::IdentityContext::default();
+    for s in &c.embedded {
+        out.push(s.semantic_identity(&mut ctx));
+    }
+    out
+}
+fn source_roles(f: &SfccFeatureSet, ids: [usize; 2]) -> Option<[usize; 3]> {
+    let c = f.curves.get(ids[0])?;
+    let tube = c.projection_tube(0., 1.)?;
+    let b = HelixBranch::identify(f, ids[0], ids[1], tube)?;
+    Some([b.native, b.field, b.cylinder_id])
+}
+fn common_stratum(f: &SfccFeatureSet, cert: &LowerCertificate) -> Option<usize> {
+    let (cap, _, _) = pair(&cert.source_root, Some((BlendKind::Smax, SminMode::Round))).ok()?;
+    let (cut, _, _) = pair(cap, None).ok()?;
+    let (hard, groove, r) = pair(cut, Some((BlendKind::Smax, SminMode::Chamfer))).ok()?;
+    let mut found = None;
+    for s in &f.strata {
+        if let Some((w, o)) = s.connection_compound(hard, groove, cut) {
+            let e = quotient(I::point(o), I::point(w))?.sub(I::point(r))?;
+            if e.lo.abs().max(e.hi.abs()) > f64::EPSILON * 8. * r.max(1.) {
+                continue;
+            }
+            if found.replace(s.id).is_some() {
+                return None;
+            }
+        }
+    }
+    found
+}
+fn bounded_corner(f: &SfccFeatureSet, corner: &SfccCorner) -> bool {
+    if corner.id >= f.corners.len()
+        || corner.curve_ends.len() > f.curves.len() * 2
+        || corner.strata.len() > f.strata.len()
+    {
+        return false;
+    }
+    for (i, &(id, end)) in corner.curve_ends.iter().enumerate() {
+        if id >= f.curves.len() || end > 1 || corner.curve_ends[..i].contains(&(id, end)) {
+            return false;
+        }
+    }
+    for (i, &sid) in corner.strata.iter().enumerate() {
+        if sid >= f.strata.len() || corner.strata[..i].contains(&sid) {
+            return false;
+        }
+    }
+    true
+}
+fn incident_roles(
+    f: &SfccFeatureSet,
+    corner: &SfccCorner,
+    cert: &LowerCertificate,
+    require_lifted: bool,
+) -> bool {
+    if !bounded_corner(f, corner) {
+        return false;
+    }
+    let Some(common) = common_stratum(f, cert) else {
+        return false;
+    };
+    let [n, a, c] = cert.source;
+    let has = |pair: [usize; 2]| {
+        corner.curve_ends.iter().any(|&(id, end)| {
+            f.curves.get(id).is_some_and(|curve| {
+                end <= 1
+                    && [curve.corner_start, curve.corner_end][end as usize] == corner.id as i64
+                    && (curve.adjacent_strata == pair
+                        || curve.adjacent_strata == [pair[1], pair[0]])
+                    && curve.traced_carriers().is_some_and(|(x, y, _)| {
+                        x.connection_same_source(&f.strata[curve.adjacent_strata[0]])
+                            && y.connection_same_source(&f.strata[curve.adjacent_strata[1]])
+                    })
+            })
+        })
+    };
+    (has([n, c]) || has([a, c]))
+        && (has([n, common]) || has([a, common]))
+        && has([c, common])
+        && (!require_lifted || has(cert.lifted_pair))
+}
+/// Source recognition is independent of optional chart metadata.
+pub(crate) fn event_complete(
+    f: &SfccFeatureSet,
+    ids: [usize; 2],
+    corner: &SfccCorner,
+    eps: f64,
+) -> bool {
+    let Some(source) = source_roles(f, ids) else {
+        return true;
+    };
+    let Some(root) = f.strata[source[0]].exposure_root_a() else {
+        return true;
+    };
+    let p = [corner.x, corner.y, corner.z];
+    let Some(cert) = bind(root, &f.strata, source, p, eps, 0.01) else {
+        return true;
+    };
+    if !incident_roles(f, corner, &cert, true) {
+        return false;
+    }
+    let mut matches = 0;
+    for &(id, end) in &corner.curve_ends {
+        let Some(c) = f.curves.get(id) else {
+            return false;
+        };
+        if c.adjacent_strata != cert.lifted_pair {
+            continue;
+        }
+        let Some(m) = c.lower_chart() else {
+            return false;
+        };
+        if end != 1
+            || c.closed
+            || m.original_range != [c.t_min, c.t_max]
+            || m.span != [c.t_max - 1., c.t_max]
+            || m.corner != corner.id
+            || m.curve != id
+            || !m.cert.curve_source_matches(&f.strata, c)
+            || m.ends[1].map(f64::to_bits) != p.map(f64::to_bits)
+            || !m
+                .original_ends
+                .iter()
+                .all(|e| corner.curve_ends.contains(e))
+            || !c.adjacent_strata.iter().all(|s| corner.strata.contains(s))
+        {
+            return false;
+        }
+        matches += 1;
+    }
+    matches == 1
+}
+
+pub(crate) fn connect(
+    root: &CsgNode,
+    f: &mut SfccFeatureSet,
+    tol: &crate::tolerances::ResolvedTolerances,
+) -> usize {
+    #[cfg(test)]
+    if DISABLED.with(std::cell::Cell::get) {
+        return 0;
+    }
+    if f.curves.len() > 256 || f.strata.len() > 256 || f.corners.len() > 256 {
+        return 0;
+    }
+    let _work = WorkScope::begin();
+    let mut proposals: Vec<(usize, FeatureCurve, SfccCorner)> = Vec::new();
+    let mut attempts = 0;
+    for p in 0..f.curves.len() {
+        for a in p + 1..f.curves.len() {
+            let cp = &f.curves[p];
+            let ca = &f.curves[a];
+            if cp.corner_start < 0 || cp.corner_start != ca.corner_start || cp.closed || ca.closed {
+                continue;
+            }
+            let corner_id = cp.corner_start as usize;
+            if proposals.iter().any(|(_, _, c)| c.id == corner_id) {
+                continue;
+            }
+            let Some(source) = source_roles(f, [p, a]) else {
+                continue;
+            };
+            let Some(corner) = f.corners.get(corner_id) else {
+                continue;
+            };
+            let point = [corner.x, corner.y, corner.z];
+            let eps = tol.curve_eps * 8.;
+            attempts += 1;
+            if attempts > 64 {
+                return 0;
+            }
+            note_attempts(attempts);
+            let Some(initial) = bind(root, &f.strata, source, point, eps, 0.01) else {
+                continue;
+            };
+            if !incident_roles(f, corner, &initial, false) {
+                continue;
+            }
+            let mut candidate = None;
+            let mut ambiguous = false;
+            for c in &f.curves {
+                if c.closed
+                    || c.corner_end >= 0
+                    || c.t_min != 0.
+                    || c.t_max < 2.
+                    || c.t_max > 128.
+                    || c.t_max != c.t_max.floor()
+                    || !initial.curve_source_matches(&f.strata, c)
+                {
+                    continue;
+                }
+                let Some(join) = checked(c, c.t_max - 1.) else {
+                    continue;
+                };
+                let Some(end) = checked(c, c.t_max) else {
+                    continue;
+                };
+                let Some((nr, ny)) = initial.normal() else {
+                    continue;
+                };
+                let slope = (1. - (nr.lo + nr.hi) * 0.5) / ((ny.lo + ny.hi) * 0.5);
+                let Some(event_image) = initial.image_bounds(0., 0.) else {
+                    continue;
+                };
+                let y0 = middle(event_image)[1];
+                let aj = (join[1] - y0) / slope;
+                let ae = (end[1] - y0) / slope;
+                if !aj.is_finite() || aj >= ae || ae >= 0. || aj < -0.25 {
+                    continue;
+                }
+                attempts += 1;
+                if attempts > 64 {
+                    return 0;
+                }
+                note_attempts(attempts);
+                let Some(cert) = bind(root, &f.strata, source, point, eps, -aj) else {
+                    continue;
+                };
+                if !cert
+                    .image_bounds(aj, aj)
+                    .and_then(|i| distance(join, i))
+                    .is_some_and(|d| d <= eps)
+                    || !cert
+                        .image_bounds(ae, ae)
+                        .and_then(|i| distance(end, i))
+                        .is_some_and(|d| d <= eps)
+                    || !cert
+                        .image_bounds(0., 0.)
+                        .and_then(|i| distance(point, i))
+                        .is_some_and(|d| d <= eps)
+                {
+                    continue;
+                }
+                let meta = LowerChart {
+                    cert,
+                    span: [c.t_max - 1., c.t_max],
+                    ends: [join, point],
+                    curve: c.id,
+                    corner: corner_id,
+                    original_range: [c.t_min, c.t_max],
+                    original_ends: corner.curve_ends.clone(),
+                    allowance: eps,
+                };
+                let Some(mut replacement) = c.with_lower_chart(meta) else {
+                    continue;
+                };
+                replacement.corner_end = corner_id as i64;
+                if candidate.replace((c.id, replacement)).is_some() {
+                    ambiguous = true;
+                    break;
+                }
+            }
+            if ambiguous {
+                continue;
+            }
+            let Some((id, replacement)) = candidate else {
+                continue;
+            };
+            if proposals.iter().any(|(existing, _, _)| *existing == id) {
+                return 0;
+            }
+            let mut event = corner.clone();
+            event.curve_ends.push((id, 1));
+            for s in replacement.adjacent_strata {
+                if !event.strata.contains(&s) {
+                    event.strata.push(s);
+                }
+            }
+            proposals.push((id, replacement, event));
+            if proposals.len() > 8 {
+                return 0;
+            }
+        }
+    }
+    if work_exhausted() {
+        return 0;
+    }
+    #[cfg(test)]
+    if REFUSE_COMMIT.with(std::cell::Cell::get) {
+        REFUSED_COUNT.with(|v| v.set(proposals.len()));
+        return 0;
+    }
+    let count = proposals.len();
+    for (id, c, corner) in proposals {
+        let ci = corner.id;
+        f.curves[id] = c;
+        f.corners[ci] = corner;
+    }
+    count
+}
+#[derive(Default)]
+struct Work {
+    active: bool,
+    queries: usize,
+    attempts: usize,
+    exhausted: bool,
+}
+thread_local! {static WORK:std::cell::RefCell<Work>=std::cell::RefCell::new(Work::default());}
+struct WorkScope;
+impl WorkScope {
+    fn begin() -> Self {
+        WORK.with(|v| {
+            *v.borrow_mut() = Work {
+                active: true,
+                ..Work::default()
+            }
+        });
+        Self
+    }
+}
+impl Drop for WorkScope {
+    fn drop(&mut self) {
+        WORK.with(|v| v.borrow_mut().active = false);
+    }
+}
+fn checked(c: &FeatureCurve, t: f64) -> Option<[f64; 3]> {
+    let allowed = WORK.with(|v| {
+        let mut w = v.borrow_mut();
+        if !w.active {
+            return true;
+        }
+        if w.queries >= 1024 {
+            w.exhausted = true;
+            return false;
+        }
+        w.queries += 1;
+        true
+    });
+    allowed.then(|| c.shared_checked_point(t)).flatten()
+}
+fn note_attempts(n: usize) {
+    WORK.with(|v| v.borrow_mut().attempts = n);
+}
+fn work_exhausted() -> bool {
+    WORK.with(|v| v.borrow().exhausted)
+}
+#[cfg(test)]
+thread_local! {static DISABLED:std::cell::Cell<bool>=const{std::cell::Cell::new(false)};static REFUSE_COMMIT:std::cell::Cell<bool>=const{std::cell::Cell::new(false)};static REFUSED_COUNT:std::cell::Cell<usize>=const{std::cell::Cell::new(0)};}
+#[cfg(test)]
+pub(crate) fn disabled<T>(f: impl FnOnce() -> T) -> T {
+    struct Reset(bool);
+    impl Drop for Reset {
+        fn drop(&mut self) {
+            DISABLED.with(|v| v.set(self.0));
+        }
+    }
+    let _r = Reset(DISABLED.with(|v| v.replace(true)));
+    f()
+}
