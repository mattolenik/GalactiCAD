+#[test]
+fn production_serial_and_raw_partitions_reconstruct_without_recovery() {
+    use gcad_kernel::sfcc::{
+        pipeline::run_sfcc_pipeline,
+        worker::{merge, mesh_partition},
+    };
+    let tree = build_csg_tree_from_json(&sheets().to_string()).unwrap();
+    let world = SfccWorldCube {
+        min_x: -128.,
+        min_y: -128.,
+        min_z: -128.,
+        size: 256.,
+    };
+    let tuning = PipelineTuning::default();
+    let r = run_sfcc_pipeline(&tree, &world, &tuning);
+    eprintln!(
+        "serial{} tri{} {}",
+        r.ok,
+        r.tris.len() / 3,
+        r.validation.to_json()
+    );
+    assert!(r.ok);
+    assert_eq!(r.manifold.components, 2);
+    assert_eq!(r.validation.local_coverage.scope, "signedBoxArrangement");
+    if let Ok(dir) = std::env::var("SFCC_ARRANGEMENT_A_DIR") {
+        std::fs::create_dir_all(&dir).unwrap();
+        std::fs::write(
+            format!("{dir}/coarse-production.json"),
+            serde_json::to_string(
+                &json!({"verts":r.verts,"tris":r.tris,"validation":r.validation.to_json()}),
+            )
+            .unwrap(),
+        )
+        .unwrap();
+    }
+    let canonical = |v: &[f32], t: &[u32]| {
+        let mut out = t
+            .chunks_exact(3)
+            .map(|t| {
+                let p = t
+                    .iter()
+                    .map(|&i| {
+                        v[i as usize * 8..i as usize * 8 + 8]
+                            .iter()
+                            .map(|v| v.to_bits())
+                            .collect::<Vec<_>>()
+                    })
+                    .collect::<Vec<_>>();
+                let k = (0..3).min_by_key(|&i| p[i].clone()).unwrap();
+                [p[k].clone(), p[(k + 1) % 3].clone(), p[(k + 2) % 3].clone()]
+            })
+            .collect::<Vec<_>>();
+        out.sort();
+        out
+    };
+    let reference = canonical(&r.verts, &r.tris);
+    let leaves = prepare(&tree, &world, &tuning);
+    assert_eq!(leaves,gcad_kernel::sfcc::worker::build_octree_resumable_inprocess(&tree,&world,&tuning));
+    for count in [1, 2, 4, 8] {
+        let mut pp = (0..count)
+            .map(|i| mesh_partition(&tree, &world, &tuning, &leaves, i, count))
+            .collect::<Vec<_>>();
+        for _ in 0..2 {
+            let m = merge(&tree, &world, &tuning, &pp);
+            eprintln!("workers{count} {} {}", m.ok, m.validation.to_json());
+            assert!(!m.serial_recovery);
+            assert!(m.ok);
+            assert_eq!(m.manifold.components, 2);
+            assert_eq!(canonical(&m.verts, &m.tris), reference);
+            assert_eq!(m.validation, r.validation);
+            pp.reverse();
+        }
+    }
+}
