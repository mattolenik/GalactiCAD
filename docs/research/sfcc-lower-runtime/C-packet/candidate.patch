+#[test]
+fn inverse_c_actual_failed_projection_still_costs_and_refuses() {
+    let (f, ids) = fixture();
+    let solver = Transport::bind(&f, ids, 0.02).unwrap();
+    let first = solver.pieces.iter().find(|p| p.chart == ids[0]).unwrap();
+    let mut failed = f.clone();
+    let old = &f.curves[ids[0]];
+    let (a, b, mut refine) = old.traced_carriers().unwrap();
+    refine.max_displacement = 0.;
+    let mut replacement = make_traced_curve(
+        old.id,
+        old.adjacent_strata,
+        old.index_polyline.clone(),
+        old.closed,
+        a,
+        b,
+        refine,
+        old.owner_node_id,
+    );
+    replacement.corner_start = old.corner_start;
+    replacement.corner_end = old.corner_end;
+    failed.curves[ids[0]] = replacement;
+    let piece = ConsumedPiece::bind(
+        &failed,
+        &first.source.branch,
+        ids,
+        ids[0],
+        first.range,
+        0.02,
+    )
+    .unwrap();
+    let mut failed_solver = Transport {
+        features: &failed,
+        ids,
+        pieces: vec![piece],
+        knots: [vec![], vec![]],
+        cache: BTreeMap::new(),
+        total: 0,
+        maximum_request: 0,
+        admission_identity: None,
+        cost: QueryCost::default(),
+        map_request_counts: [0; MAX_REQUEST + 1],
+        phase: "failed_query_control",
+    };
+    assert!(matches!(
+        failed_solver.query(ids[0], (first.range[0] + first.range[1]) * 0.5, &mut 0),
+        Err(Failure::Query(EventFailure::QueryFailed))
+    ));
+    assert_eq!(failed_solver.total, 1);
+    assert_eq!(failed_solver.cost.consume_attempts, 1);
+    assert_eq!(failed_solver.cost.consume_failures, 1);
+    assert!(failed_solver.cache.is_empty());
+}
