+/// `plane` is checked against the live slot/record/lattice; it cannot select a
+/// nearby plane merely because the same normal f32 bin contains it.
+pub(crate) fn admit(
+    features: &SfccFeatureSet,
+    plan: &AdmittedArc,
+    transport: &mut Transport<'_>,
+    lat: &SfccLattice,
+    axis: usize,
+    key: i64,
+    record: &FaceRecord,
+    plane: f64,
+    pins: [FacePin; 2],
+    points: [[f64; 3]; 2],
+) -> Result<Evidence, Evidence> {
+    let branch = transport.admitted_branch().clone();
+    let ids = [plan.physical, plan.alias];
+    let mut e = Evidence {
+        gate: "unexamined",
+        detail: String::new(),
+        face: (axis, key, record.len),
+        record_face: (record.axis, record.key, record.len),
+        claimed_plane_bits: plane.to_bits(),
+        typed_plane_bits: None,
+        charts: pins.map(|p| p.curve_id),
+        point_ids: pins.map(|p| p.point_id),
+        parameter_bits: pins.map(|p| p.t.to_bits()),
+        point_bits: points.map(|p| p.map(f64::to_bits)),
+        allowance_bits: transport.allowance().to_bits(),
+        original_strict_residual_bits: None,
+        source_native_field_cylinder: [branch.native, branch.field, branch.cylinder_id],
+        admitted_branch_sign: plan.branch_sign,
+        source_branch_u_bits: [branch.u.lo.to_bits(), branch.u.hi.to_bits()],
+        face_rectangle_bits: None,
+        rounding_boxes_bits: None,
+        hull_bits: None,
+        twisted_source_bits: None,
+        cylinder_bits: None,
+        source_boxes: None,
+        derivative_interval_bits: None,
+        actual_axis_inverse_bits: None,
+        root_image_bits: None,
+        pin_to_root_upper_bits: None,
+        final_charged_queries: transport.charged_queries(),
+        publication_authority: false,
+    };
+    if !transport.bound_to(features)
+        || plan.fingerprint != features.fingerprint()
+        || transport.physical_alias() != ids
+    {
+        return refuse(
+            e,
+            "face_source_instance",
+            "current immutable source and admitted original charts differ",
+        );
+    }
+    if !plan.admits_transport(transport) {
+        return refuse(
+            e,
+            "face_admission_identity",
+            "plan and transport did not come from the same successful admission",
+        );
+    }
+    if branch.sign != plan.branch_sign {
+        return refuse(e, "face_admitted_branch", "retained branch sign differs");
+    }
+    if axis >= 3 || record.axis != axis || record.key != key || record.len <= 0 {
+        return refuse(
+            e,
+            "typed_face_identity",
+            "slot/record axis, key or length differs",
+        );
+    }
+    let grid = unpack_point(lat, key);
+    let axes = face_axes(axis);
+    if grid.iter().any(|&g| g < 0 || g > lat.res)
+        || axes
+            .iter()
+            .any(|&k| grid[k].checked_add(record.len).is_none_or(|v| v > lat.res))
+        || pack_point(lat, grid[0], grid[1], grid[2]) != key
+    {
+        return refuse(e, "typed_face_domain", "face lies outside actual lattice");
+    }
+    let low = point_to_world(lat, grid[0], grid[1], grid[2]);
+    e.typed_plane_bits = Some(low[axis].to_bits());
+    if plane.to_bits() != low[axis].to_bits() {
+        return refuse(
+            e,
+            "typed_face_plane",
+            "exact typed plane differs, irrespective of rounding bin",
+        );
+    }
+    let extent = record.len as f64 * lat.step;
+    let mut high = low;
+    for k in axes {
+        high[k] += extent;
+    }
+    e.face_rectangle_bits = Some(box_bits(low, high));
+    if !extent.is_finite()
+        || extent <= 0.
+        || !(0..3).all(|k| low[k].is_finite() && high[k].is_finite() && low[k] <= high[k])
+    {
+        return refuse(
+            e,
+            "typed_face_rectangle",
+            "invalid minimum-plus-extent rectangle",
+        );
+    }
+    for slot in 0..2 {
+        if pins[slot].curve_id != ids[slot]
+            || !record.pins.iter().any(|p| {
+                p.point_id == pins[slot].point_id
+                    && p.curve_id == pins[slot].curve_id
+                    && p.t.to_bits() == pins[slot].t.to_bits()
+            })
+        {
+            return refuse(
+                e,
+                "typed_face_pin_binding",
+                "original chart/id/parameter not present in actual face record",
+            );
+        }
+        // Cache reuse is safe under the borrowed immutable source. No required
+        // own-query or actual-point check is bypassed by this mathematical gate.
+        if let Err(reason) = crate::sfcc::private_arc_a::checked_pair(
+            transport,
+            features,
+            ids,
+            pins[slot].curve_id,
+            pins[slot].t,
+            points[slot],
+        ) {
+            e.final_charged_queries = transport.charged_queries();
+            return refuse(e, "face_pin_own_source_event", format!("{reason:?}"));
+        }
+    }
+    e.final_charged_queries = transport.charged_queries();
+    let Some((_, _, physical_refine)) = features.curves[ids[0]].traced_carriers() else {
+        return refuse(
+            e,
+            "face_original_residual",
+            "missing original physical refinement contract",
+        );
+    };
+    let Some((_, _, alias_refine)) = features.curves[ids[1]].traced_carriers() else {
+        return refuse(
+            e,
+            "face_original_residual",
+            "missing original alias refinement contract",
+        );
+    };
+    let strict_eps = physical_refine.curve_eps.min(alias_refine.curve_eps);
+    e.original_strict_residual_bits = Some(strict_eps.to_bits());
+    if !strict_eps.is_finite() || strict_eps <= 0. {
+        return refuse(
+            e,
+            "face_original_residual",
+            "invalid original strict residual allowance",
+        );
+    }
+    for id in ids {
+        for &sid in &features.curves[id].adjacent_strata {
+            for (slot, &point) in points.iter().enumerate() {
+                let st = &features.strata[sid];
+                if !st.domain_contains(point, strict_eps)
+                    || !st
+                        .raw_field(point[0], point[1], point[2])
+                        .normalized_equation()
+                        .is_some_and(|v| v.value.abs() <= strict_eps)
+                {
+                    return refuse(e,"face_original_residual",format!("original min(curve_eps) domain/residual gate: chart {id}, stratum {sid}, pin {slot}"));
+                }
+            }
+        }
+    }
+    let Some(a) = rounding_face_box(axis, plane, points[0]) else {
+        return refuse(
+            e,
+            "pin_rounding_face_domain",
+            "physical pin normal bin differs from typed plane",
+        );
+    };
+    let Some(b) = rounding_face_box(axis, plane, points[1]) else {
+        return refuse(
+            e,
+            "pin_rounding_face_domain",
+            "alias pin normal bin differs from typed plane",
+        );
+    };
+    e.rounding_boxes_bits = Some([box_bits(a.0, a.1), box_bits(b.0, b.1)]);
+    // Finite neighboring f32 midpoints are exactly representable in f64.
+    let lo: [f64; 3] = std::array::from_fn(|k| a.0[k].min(b.0[k]));
+    let hi: [f64; 3] = std::array::from_fn(|k| a.1[k].max(b.1[k]));
+    e.hull_bits = Some(box_bits(lo, hi));
+    if lo[axis].to_bits() != plane.to_bits()
+        || hi[axis].to_bits() != plane.to_bits()
+        || !(0..3).all(|k| lo[k] >= low[k] && hi[k] <= high[k])
+        || points
+            .iter()
+            .any(|p| axes.iter().any(|&k| p[k] < lo[k] || p[k] > hi[k]))
+    {
+        return refuse(
+            e,
+            "face_hull_outside_rectangle",
+            "complete original bin domains and tangential data must fit; no clipping",
+        );
+    }
+    let Some(height) = interval(lo[1], hi[1]) else {
+        return refuse(e, "face_height_domain", "invalid height interval");
+    };
+    if BranchCertificate::bind(features, &branch, height).is_none() {
+        return refuse(
+            e,
+            "face_correlated_source",
+            "finite cylinder occurrence, axial range or correlated branch restrictions failed",
+        );
+    }
+    let Some((p, leaf, other, r)) =
+        features.strata[branch.native].round_twisted_source(&features.strata[branch.field])
+    else {
+        return refuse(
+            e,
+            "face_source_occurrence",
+            "native/Field source correspondence missing",
+        );
+    };
+    let cylinder = features.strata[branch.cylinder_id].certificate_cylinder();
+    if p != branch.p || cylinder != Some(branch.cylinder) {
+        return refuse(
+            e,
+            "face_source_equations",
+            "proof source differs from admitted represented equations",
+        );
+    }
+    e.twisted_source_bits = Some(
+        p.sim
+            .r
+            .into_iter()
+            .chain(p.sim.t)
+            .chain([
+                p.sim.s,
+                p.pos_x,
+                p.pos_y,
+                p.pos_z,
+                p.v0x,
+                p.v0z,
+                p.nx2,
+                p.nz2,
+                p.h,
+                p.twist_rad,
+            ])
+            .map(f64::to_bits)
+            .collect(),
+    );
+    let (center, axis_vector, radius) = branch.cylinder;
+    e.cylinder_bits = Some(
+        [
+            center[0],
+            center[1],
+            center[2],
+            axis_vector[0],
+            axis_vector[1],
+            axis_vector[2],
+            radius,
+        ]
+        .map(f64::to_bits),
+    );
+    let Some((_, twisted_gradient, _, xz)) = twisted(p, lo, hi) else {
+        return refuse(
+            e,
+            "face_twisted_domain",
+            "interval or axial domain unsupported",
+        );
+    };
+    if (branch.sign > 0 && xz[0].lo <= 0.) || (branch.sign < 0 && xz[0].hi >= 0.) {
+        return refuse(
+            e,
+            "face_fixed_branch",
+            "hull does not retain the admitted fixed sign",
+        );
+    }
+    e.source_boxes = source_restrictions(p, leaf, Some((other, r)), lo, hi);
+    if e.source_boxes.is_none() {
+        return refuse(
+            e,
+            "face_box_source_restrictions",
+            "unchanged source-restriction prerequisite refused; no uniqueness claim",
+        );
+    }
+    let Some((_, radial_gradient)) = radial(center, axis_vector, radius, lo, hi) else {
+        return refuse(
+            e,
+            "face_radial_domain",
+            "radial interval prerequisite unsupported",
+        );
+    };
+    let jacobian = [radial_gradient, twisted_gradient];
+    let transverse = [(axis + 1) % 3, (axis + 2) % 3];
+    e.derivative_interval_bits =
+        Some(jacobian.map(|row| row.map(|i| [i.lo.to_bits(), i.hi.to_bits()])));
+    let Some(inverse) = inverse_bound(jacobian.map(|row| [row[transverse[0]], row[transverse[1]]]))
+    else {
+        return refuse(
+            e,
+            "face_axis_inverse",
+            "uniform inverse failed for actual typed face axis",
+        );
+    };
+    e.actual_axis_inverse_bits = Some(inverse.map(|row| row.map(f64::to_bits)));
+    let Some(proof) = certify(features, ids[0], ids[1], lo, hi) else {
+        return refuse(
+            e,
+            "face_source_certificate",
+            "unchanged source certificate refused after explicit branch/box checks",
+        );
+    };
+    if proof.p != branch.p || proof.cylinder != branch.cylinder {
+        return refuse(
+            e,
+            "face_certificate_source",
+            "certificate equation identity differs from admitted branch",
+        );
+    }
+    let Some(image) = proof.face_root_image(axis) else {
+        return refuse(
+            e,
+            "face_root_inclusion",
+            "actual-axis Krawczyk image is not strictly inside the complete hull",
+        );
+    };
+    e.root_image_bits = Some(box_bits(image.map(|i| i.lo), image.map(|i| i.hi)));
+    match associate_points(points, image, transport.allowance()) {
+        Ok(upper) => e.pin_to_root_upper_bits = Some(upper.map(f64::to_bits)),
+        Err(upper) => {
+            e.pin_to_root_upper_bits = upper.map(|u| u.map(f64::to_bits));
+            return refuse(
+                e,
+                "pin_to_root_image_distance",
+                "nonfinite bound or unchanged direct association allowance exceeded",
+            );
+        }
+    }
+    e.gate = "source_bound_unique_existing_root";
+    Ok(e)
+}
