+//! Source activation and regular composite continuation; no trace mutation authority.
+use super::*;
+
+fn quotient(a: I, b: I) -> Option<I> {
+    if b.lo <= 0. && b.hi >= 0. {
+        return None;
+    }
+    mul(a, interval((1. / b.hi).next_down(), (1. / b.lo).next_up())?)
+}
+fn abs_lower(a: I) -> Option<f64> {
+    if a.lo <= 0. && a.hi >= 0. {
+        None
+    } else {
+        Some(a.lo.abs().min(a.hi.abs()))
+    }
+}
+fn hull(a: I, b: I) -> Option<I> {
+    interval(a.lo.min(b.lo), a.hi.max(b.hi))
+}
+#[derive(Clone, Copy)]
+pub(crate) struct MeridianBound {
+    pub(crate) edge: usize,
+    pub(crate) nr: I,
+    pub(crate) ny: I,
+    /// Exterior distance = nr*rho + ny*world_y + offset on this finite branch.
+    pub(crate) offset: I,
+    pub(crate) distance: I,
+    pub(crate) projection_margin: f64,
+    pub(crate) nearest_margin: f64,
+    pub(crate) outside_by_ray: bool,
+}
+
+/// Positive exterior finite-segment distance, including nonconvex profiles.
+/// rho is measured about leaf.pos[X,Z], while y is a WORLD height.
+pub(crate) fn meridian_bound(leaf: &Leaf, rho: I, world_y: I) -> Option<MeridianBound> {
+    if !exact_identity(leaf)
+        || !matches!(leaf.sign, -1. | 1.)
+        || rho.lo <= 0.
+        || [rho.lo, rho.hi, world_y.lo, world_y.hi]
+            .iter()
+            .any(|v| !v.is_finite())
+        || rho.lo > rho.hi
+        || world_y.lo > world_y.hi
+        || leaf.pos.iter().any(|v| !v.is_finite())
+    {
+        return None;
+    }
+    let Shape::Lathe { edges } = &leaf.shape else {
+        return None;
+    };
+    if edges.len() < 3 || edges.len() > 64 {
+        return None;
+    }
+    for (i, e) in edges.iter().enumerate() {
+        let next = &edges[(i + 1) % edges.len()];
+        if [e.r0, e.y0, e.r1, e.y1].iter().any(|v| !v.is_finite())
+            || e.r0 < 0.
+            || e.r1 < 0.
+            || e.r1 != next.r0
+            || e.y1 != next.y0
+            || matches!(e.kind, crate::primitives::shapes::LatheEdgeKind::None)
+            || (e.r0 == e.r1 && e.y0 == e.y1)
+        {
+            return None;
+        }
+    }
+    let y = world_y.sub(I::point(leaf.pos[1]))?;
+    let mut no_right_crossing = true;
+    for e in edges {
+        let low = y.lo.max(e.y0.min(e.y1));
+        let high = y.hi.min(e.y0.max(e.y1));
+        if low > high {
+            continue;
+        }
+        if e.y0 == e.y1 {
+            if e.r0.max(e.r1) >= rho.lo {
+                no_right_crossing = false;
+            }
+        } else {
+            let t = quotient(
+                interval(low, high)?.sub(I::point(e.y0))?,
+                I::point(e.y1).sub(I::point(e.y0))?,
+            )?;
+            let t = interval(t.lo.clamp(0., 1.), t.hi.clamp(0., 1.))?;
+            let radial = I::point(e.r0).add(mul(I::point(e.r1).sub(I::point(e.r0))?, t)?)?;
+            if radial.hi >= rho.lo {
+                no_right_crossing = false;
+            }
+        }
+    }
+    let mut selected = None;
+    for (i, e) in edges.iter().enumerate() {
+        let dr = I::point(e.r1).sub(I::point(e.r0))?;
+        let dy = I::point(e.y1).sub(I::point(e.y0))?;
+        let length2 = square(dr)?.add(square(dy)?)?;
+        let length = sqrt(length2)?;
+        let wr = rho.sub(I::point(e.r0))?;
+        let wy = y.sub(I::point(e.y0))?;
+        let along = quotient(mul(dr, wr)?.add(mul(dy, wy)?)?, length2)?;
+        let projection_margin = along.lo.min(1. - along.hi);
+        if projection_margin <= 0. {
+            continue;
+        }
+        let raw = quotient(mul(dy, wr)?.sub(mul(dr, wy)?)?, length)?;
+        let orientation = if raw.lo > 0. {
+            1.
+        } else if raw.hi < 0. {
+            -1.
+        } else {
+            continue;
+        };
+        let distance = raw.mul(orientation)?;
+        let separating = edges.iter().all(|v| {
+            crate::sfcc::predicates::orient2d([e.r0, e.y0], [e.r1, e.y1], [v.r0, v.y0]) as f64
+                * orientation
+                >= 0.
+        });
+        if !no_right_crossing && !separating {
+            continue;
+        }
+        let mut nearest = f64::INFINITY;
+        for (j, o) in edges.iter().enumerate() {
+            if i == j {
+                continue;
+            }
+            let ox = I::point(o.r1).sub(I::point(o.r0))?;
+            let oy = I::point(o.y1).sub(I::point(o.y0))?;
+            let wx = rho.sub(I::point(o.r0))?;
+            let wy = y.sub(I::point(o.y0))?;
+            let t = quotient(
+                mul(ox, wx)?.add(mul(oy, wy)?)?,
+                square(ox)?.add(square(oy)?)?,
+            )?;
+            let t = interval(t.lo.clamp(0., 1.), t.hi.clamp(0., 1.))?;
+            let d = sqrt(square(wx.sub(mul(ox, t)?)?)?.add(square(wy.sub(mul(oy, t)?)?)?)?)?;
+            nearest = nearest.min(d.sub(I::point(distance.hi))?.lo);
+        }
+        if nearest <= 0. {
+            continue;
+        }
+        let nr = quotient(dy.mul(orientation)?, length)?;
+        let ny = quotient(dr.mul(-orientation)?, length)?;
+        let offset = mul(nr, I::point(e.r0))?
+            .add(mul(ny, I::point(e.y0).add(I::point(leaf.pos[1]))?)?)?
+            .mul(-1.)?;
+        let value = MeridianBound {
+            edge: i,
+            nr,
+            ny,
+            offset,
+            distance,
+            projection_margin,
+            nearest_margin: nearest,
+            outside_by_ray: no_right_crossing,
+        };
+        if selected.replace(value).is_some() {
+            return None;
+        }
+    }
+    selected
+}
+
+#[derive(Clone, Copy)]
+struct Locus {
+    radius: I,
+    activation_rho: I,
+    activation_y: I,
+    slope: I,
+    competitor_slope: I,
+}
+#[derive(Clone, Copy)]
+struct Image {
+    rho: I,
+    y: I,
+    level: I,
+    u: I,
+    v: I,
+    xyz: [I; 3],
+    native_weight: I,
+}
+/// Immutable source theorem only; no numerical trace identity or mutation is granted.
+pub(crate) struct Certificate<'a> {
+    features: &'a SfccFeatureSet,
+    pub(crate) source: [usize; 4],
+    pub(crate) charts: [usize; 2],
+    branch: HelixBranch,
+    native: &'a Leaf,
+    other: &'a Leaf,
+    groove: &'a Leaf,
+    cylinder: &'a Leaf,
+    cap: &'a Leaf,
+    sphere: &'a Leaf,
+    inner_radius: f64,
+    outer_radius: f64,
+    pub(crate) common_weight: f64,
+    pub(crate) common_offset: f64,
+    other_line: MeridianBound,
+    groove_line: MeridianBound,
+    loci: [Locus; 2],
+    pub(crate) outgoing_depth: f64,
+    pub(crate) margins: [f64; 7],
+    pub(crate) height_derivative_lower: f64,
+    pub(crate) transverse_lower: f64,
+    pub(crate) activation_separation_upper: f64,
+}
+fn source_locus(g: MeridianBound, l: MeridianBound, inner: f64, radius: I) -> Option<Locus> {
+    let slope = quotient(g.nr.mul(-1.)?, g.ny)?;
+    let intercept = quotient(radius.sub(g.offset)?, g.ny)?;
+    let k = l.nr.add(mul(l.ny, slope)?)?;
+    if k.lo <= 0. || slope.lo <= 0. {
+        return None;
+    }
+    let b = mul(l.ny, intercept)?.add(l.offset)?;
+    let rho = quotient(I::point(inner).sub(b)?, k)?;
+    let y = mul(slope, rho)?.add(intercept)?;
+    Some(Locus {
+        radius,
+        activation_rho: rho,
+        activation_y: y,
+        slope,
+        competitor_slope: k,
+    })
+}
+impl<'a> Certificate<'a> {
+    pub(crate) fn bound_to(&self, f: &SfccFeatureSet) -> bool {
+        std::ptr::eq(self.features, f)
+    }
+    pub(crate) fn activation_radial(&self, generated: bool) -> [f64; 2] {
+        let r = self.loci[usize::from(generated)].activation_rho;
+        [r.lo, r.hi]
+    }
+    pub(crate) fn activation_height(&self, generated: bool) -> [f64; 2] {
+        let y = self.loci[usize::from(generated)].activation_y;
+        [y.lo, y.hi]
+    }
+    fn xyz(&self, rho: I, y: I, level: I, native_weight: I) -> Option<Image> {
+        let p = self.branch.p;
+        let v = I::point(p.v0z).add(level.mul(p.nz2)?)?;
+        let mut u = sqrt(square(rho)?.sub(square(v)?)?)?;
+        if self.branch.sign < 0 {
+            u = u.mul(-1.)?;
+        }
+        abs_lower(u)?;
+        let theta =
+            div(y.sub(I::point(p.pos_y))?.add(I::point(p.h))?, 2. * p.h)?.mul(p.twist_rad)?;
+        let (sn, cs) = sin_cos(theta)?;
+        let xyz = [
+            mul(u, cs)?.sub(mul(v, sn)?)?.add(I::point(p.pos_x))?,
+            y,
+            mul(u, sn)?.add(mul(v, cs)?)?.add(I::point(p.pos_z))?,
+        ];
+        Some(Image {
+            rho,
+            y,
+            level,
+            u,
+            v,
+            xyz,
+            native_weight,
+        })
+    }
+    fn incoming(&self, t: I, locus: Locus) -> Option<Image> {
+        if t.lo < 0. || t.hi > 1. || t.lo > t.hi {
+            return None;
+        }
+        let delta = mul(
+            I::point(self.branch.cylinder.2).sub(locus.activation_rho)?,
+            I::point(1.).sub(t)?,
+        )?;
+        let rho = locus.activation_rho.add(delta)?;
+        // This is a convex combination of the source event and cylinder radius.
+        let rho = interval(
+            rho.lo.max(locus.activation_rho.lo),
+            rho.hi.min(self.branch.cylinder.2),
+        )?;
+        let y = locus.activation_y.add(mul(locus.slope, delta)?)?;
+        self.xyz(rho, y, I::point(0.), I::point(1.))
+    }
+    fn outgoing(&self, delta: I, locus: Locus) -> Option<Image> {
+        if delta.lo < 0. || delta.hi > self.outgoing_depth || delta.lo > delta.hi {
+            return None;
+        }
+        let rho = locus.activation_rho.sub(delta)?;
+        let y = locus.activation_y.sub(mul(locus.slope, delta)?)?;
+        let z = mul(locus.competitor_slope, delta)?;
+        let z = interval(z.lo.max(0.), z.hi)?;
+        if z.hi >= self.inner_radius {
+            return None;
+        }
+        let rem = sqrt(square(I::point(self.inner_radius))?.sub(square(z)?)?)?;
+        if rem.lo <= 0. {
+            return None;
+        }
+        // Rationalization preserves the nonnegative level at activation.
+        let a = quotient(square(z)?, I::point(self.inner_radius).add(rem)?)?;
+        let a = interval(a.lo.max(0.), a.hi)?;
+        self.xyz(rho, y, a, div(rem, self.inner_radius)?)
+    }
+    pub(crate) fn incoming_image(
+        &self,
+        a: f64,
+        b: f64,
+        generated: bool,
+    ) -> Option<([f64; 3], [f64; 3])> {
+        let q = self.incoming(interval(a, b)?, self.loci[usize::from(generated)])?;
+        Some((q.xyz.map(|v| v.lo), q.xyz.map(|v| v.hi)))
+    }
+    pub(crate) fn outgoing_image(
+        &self,
+        a: f64,
+        b: f64,
+        generated: bool,
+    ) -> Option<([f64; 3], [f64; 3])> {
+        let q = self.outgoing(interval(a, b)?, self.loci[usize::from(generated)])?;
+        Some((q.xyz.map(|v| v.lo), q.xyz.map(|v| v.hi)))
+    }
+    pub(crate) fn activation_image(&self, generated: bool) -> Option<([f64; 3], [f64; 3])> {
+        self.outgoing_image(0., 0., generated)
+    }
+    fn ghost(&self, z: I, locus: Locus) -> Option<(Image, I, I)> {
+        if z.lo < 0. || z.hi > self.outgoing_depth || z.lo > z.hi {
+            return None;
+        }
+        let rem = sqrt(square(I::point(self.inner_radius))?.add(square(z)?)?)?;
+        let inner = quotient(square(z)?, I::point(self.inner_radius).add(rem)?)?.mul(-1.)?;
+        let distance = locus.radius.add(inner)?;
+        if distance.lo <= 0. {
+            return None;
+        }
+        let l = I::point(self.inner_radius).sub(z)?;
+        let g_rhs = distance.sub(self.groove_line.offset)?;
+        let l_rhs = l.sub(self.other_line.offset)?;
+        let det = mul(self.groove_line.nr, self.other_line.ny)?
+            .sub(mul(self.groove_line.ny, self.other_line.nr)?)?;
+        let rho = quotient(
+            mul(g_rhs, self.other_line.ny)?.sub(mul(self.groove_line.ny, l_rhs)?)?,
+            det,
+        )?;
+        let y = quotient(
+            mul(self.groove_line.nr, l_rhs)?.sub(mul(g_rhs, self.other_line.nr)?)?,
+            det,
+        )?;
+        let image = self.xyz(
+            rho,
+            y,
+            I::point(0.),
+            quotient(I::point(self.inner_radius), rem)?,
+        )?;
+        if image.rho.sub(I::point(self.branch.cylinder.2))?.hi >= inner.lo {
+            return None;
+        }
+        Some((image, inner, distance))
+    }
+    /// z>0 gives a regular single-Q surface patch; z=0 is the shared activation limit.
+    pub(crate) fn ghost_image(
+        &self,
+        a: f64,
+        b: f64,
+        generated: bool,
+    ) -> Option<([f64; 3], [f64; 3])> {
+        let q = self
+            .ghost(interval(a, b)?, self.loci[usize::from(generated)])?
+            .0;
+        Some((q.xyz.map(|v| v.lo), q.xyz.map(|v| v.hi)))
+    }
+    fn region(&self, image: Image) -> Option<([f64; 7], f64)> {
+        let other = meridian_bound(self.other, image.rho, image.y)?;
+        let groove = meridian_bound(self.groove, image.rho, image.y)?;
+        if other.edge != self.other_line.edge || groove.edge != self.groove_line.edge {
+            return None;
+        }
+        let same_line = |a: MeridianBound, b: MeridianBound| {
+            [a.nr.lo, a.nr.hi, a.ny.lo, a.ny.hi, a.offset.lo, a.offset.hi].map(f64::to_bits)
+                == [b.nr.lo, b.nr.hi, b.ny.lo, b.ny.hi, b.offset.lo, b.offset.hi].map(f64::to_bits)
+        };
+        if !same_line(other, self.other_line) || !same_line(groove, self.groove_line) {
+            return None;
+        }
+        let profile = upper_source_a::finite_profile_level(
+            self.branch.p,
+            self.native,
+            [image.u, image.v],
+            image.level,
+        )?;
+        let native_cap =
+            upper_source_a::cap_margin(image.y, self.branch.p.pos_y, self.branch.p.h, image.level)?;
+        let Shape::Cylinder { h, .. } = &self.cylinder.shape else {
+            return None;
+        };
+        let cylinder_cap = upper_source_a::cap_margin(
+            image.y,
+            self.cylinder.pos[1],
+            *h,
+            image.rho.sub(I::point(self.branch.cylinder.2))?,
+        )?;
+        let Shape::Extrude { h, .. } = &self.cap.shape else {
+            return None;
+        };
+        let cutter = I::point(self.cap.pos[1])
+            .sub(I::point(*h))?
+            .sub(image.y)?
+            .lo;
+        let Shape::Sphere { r } = &self.sphere.shape else {
+            return None;
+        };
+        let sd =
+            sqrt(square(image.rho)?.add(square(image.y.sub(I::point(self.sphere.pos[1]))?)?)?)?;
+        let outer = I::point(*r).sub(I::point(self.outer_radius))?.sub(sd)?.lo;
+        let rank = mul(
+            quotient(image.u, image.rho)?,
+            mul(image.native_weight, self.groove_line.ny)?,
+        )?
+        .mul(self.branch.p.nz2)?;
+        let rank = abs_lower(rank)?;
+        let margins = [
+            profile,
+            native_cap,
+            cylinder_cap,
+            other.projection_margin.min(groove.projection_margin),
+            other.nearest_margin.min(groove.nearest_margin),
+            cutter,
+            outer,
+        ];
+        if margins.iter().any(|v| !v.is_finite() || *v <= 0.) {
+            return None;
+        }
+        Some((margins, rank))
+    }
+}
