+#[derive(Clone)]
+struct Plan {
+    root: Arc<CsgNode>,
+    fingerprint: u64,
+    source: [usize; 4],
+    charts: [usize; 2],
+    cuts: [f64; 2],
+    point: [f64; 3],
+    cell_box: [f64; 6],
+    epsilon: f64,
+}
+thread_local! { static PLAN: RefCell<Option<Plan>> = const { RefCell::new(None) }; static SHARING:Cell<(usize,bool)>=const{Cell::new((0,false))}; }
+pub(super) fn enabled() -> bool {
+    PLAN.with(|p| p.borrow().is_some())
+}
+fn scoped<T>(plan: Plan, f: impl FnOnce() -> T) -> T {
+    struct Restore(Option<Plan>, (usize, bool));
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            PLAN.with(|p| *p.borrow_mut() = self.0.take());
+            SHARING.with(|s| s.set(self.1));
+        }
+    }
+    let _r = Restore(
+        PLAN.with(|p| p.replace(Some(plan))),
+        SHARING.with(|s| s.replace((0, false))),
+    );
+    f()
+}
+fn plan() -> Option<Plan> {
+    PLAN.with(|p| p.borrow().clone())
+}
+fn source<'a>(plan: &Plan, features: &'a SfccFeatureSet) -> Option<activation_a::Certificate<'a>> {
+    if !private_arc_a::generated_queries_active()
+        || features.fingerprint() != plan.fingerprint
+        || !plan.epsilon.is_finite()
+        || plan.epsilon <= 0.
+    {
+        return None;
+    }
+    let strict = plan
+        .charts
+        .iter()
+        .map(|&id| {
+            features
+                .curves
+                .get(id)?
+                .traced_carriers()
+                .map(|(_, _, r)| r.curve_eps)
+        })
+        .collect::<Option<Vec<_>>>()?
+        .into_iter()
+        .fold(f64::INFINITY, f64::min);
+    if !strict.is_finite() || strict <= 0. || plan.epsilon > 8. * strict {
+        return None;
+    }
+    let root = features
+        .strata
+        .get(plan.source[0])?
+        .upper_source_root_handle()?;
+    if !Arc::ptr_eq(&root, &plan.root) {
+        return None;
+    }
+    let cert = activation_a::bind(
+        &root,
+        features,
+        [plan.source[0], plan.source[1], plan.source[2]],
+        plan.charts,
+        0.2,
+    )?;
+    (cert.source == plan.source && cert.charts == plan.charts).then_some(cert)
+}
+fn distance(point: [f64; 3], image: ([f64; 3], [f64; 3])) -> Option<f64> {
+    use crate::sdf::enclosure::Interval as I;
+    let mut d = I::point(0.);
+    for k in 0..3 {
+        let delta =
+            I::point(point[k]).sub(crate::sfcc::loft_seam::interval(image.0[k], image.1[k])?)?;
+        d = d.add(crate::sfcc::loft_seam::square(delta)?)?;
+    }
+    Some(d.hi.sqrt().next_up())
+}
+fn in_tube(tube: ([f64; 3], [f64; 3]), p: [f64; 3]) -> bool {
+    p.iter().all(|x| x.is_finite()) && (0..3).all(|k| p[k] >= tube.0[k] && p[k] <= tube.1[k])
+}
