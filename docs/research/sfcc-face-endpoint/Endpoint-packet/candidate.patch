+fn bind_feature_endpoint_transport(
+    f: &crate::sfcc::feature_set::SfccFeatureSet,
+    lat: &crate::math::grid::SfccLattice,
+    original: &Value,
+    saved: &Value,
+    points: &BTreeMap<usize, Point>,
+    domain: &Domain,
+    source: &Value,
+    tolerance: f64,
+) -> std::result::Result<Value, String> {
+    use crate::sfcc::shared_twisted_proof::correlated_c::transport_a::Transport;
+    if saved["sourceFingerprint"] != saved["originalTarget"]["sourceFingerprint"]
+        || saved["face"] != saved["originalTarget"]["face"]
+    {
+        return Err("endpoint_original_target_binding".into());
+    }
+    let endpoint = saved["commonEndpoint"].as_u64().ok_or("endpoint_id")? as usize;
+    let point = *points.get(&endpoint).ok_or("endpoint_point")?;
+    let pins = saved["originalTarget"]["originalPins"]
+        .as_array()
+        .ok_or("endpoint_pins")?;
+    if pins.len() > 1024 {
+        return Err("endpoint_pin_cap".into());
+    }
+    let mut found = pins
+        .iter()
+        .filter(|p| p["candidatePoint"].as_u64() == Some(endpoint as u64));
+    let pin = found.next().ok_or("endpoint_pin_missing")?;
+    if found.next().is_some() {
+        return Err("endpoint_pin_ambiguous".into());
+    }
+    let chart = pin["chart"].as_u64().ok_or("endpoint_chart")? as usize;
+    let t = f64::from_bits(pin["parameterBits"].as_u64().ok_or("endpoint_parameter")?);
+    let curve = f.curves.get(chart).ok_or("endpoint_curve")?;
+    let strata: [usize; 2] =
+        serde_json::from_value(pin["strata"].clone()).map_err(|_| "endpoint_strata")?;
+    let ranges: [u64; 2] =
+        serde_json::from_value(pin["rangeBits"].clone()).map_err(|_| "endpoint_ranges")?;
+    if strata != curve.adjacent_strata
+        || ranges != [curve.t_min.to_bits(), curve.t_max.to_bits()]
+        || !t.is_finite()
+        || t < curve.t_min
+        || t > curve.t_max
+    {
+        return Err("endpoint_original_curve_binding".into());
+    }
+    let face: [i64; 3] =
+        serde_json::from_value(saved["face"].clone()).map_err(|_| "endpoint_face")?;
+    if face[0] != 0 || face[2] <= 0 {
+        return Err("endpoint_face_axis_or_extent".into());
+    }
+    let grid = crate::math::grid::unpack_point(lat, face[1]);
+    let low = crate::math::grid::point_to_world(lat, grid[0], grid[1], grid[2]);
+    let mut far = grid;
+    far[1] = far[1].checked_add(face[2]).ok_or("endpoint_face_extent")?;
+    far[2] = far[2].checked_add(face[2]).ok_or("endpoint_face_extent")?;
+    let high = crate::math::grid::point_to_world(lat, far[0], far[1], far[2]);
+    let feature = super::feature49_a::endpoint_geometry(f, chart, point, low[0])
+        .ok_or("endpoint_source_feature")?;
+    if feature["physicalFeatureZeroAndExposureProved"] != true
+        || feature["sourceFingerprint"] != source["sourceFingerprint"]
+        || feature["chart"].as_u64() != Some(chart as u64)
+        || feature["physicalFaceFeature"]["fixedAxis"] != 0
+        || feature["physicalFaceFeature"]["fixedCoordinateBits"].as_u64() != Some(low[0].to_bits())
+    {
+        return Err("endpoint_source_feature_binding".into());
+    }
+    let image: [[f64; 3]; 2] =
+        serde_json::from_value(feature["physicalFaceFeature"]["image"].clone())
+            .map_err(|_| "endpoint_feature_image")?;
+    let mut target = [I::point(0.); 3];
+    for k in 0..3 {
+        target[k] = crate::sfcc::loft_seam::interval(image[0][k], image[1][k])
+            .ok_or("endpoint_feature_image")?;
+    }
+    if image[0][0].to_bits() != low[0].to_bits()
+        || image[1][0].to_bits() != low[0].to_bits()
+        || !(1..3).all(|k| target[k].lo > low[k] && target[k].hi < high[k])
+    {
+        return Err("endpoint_feature_face_rectangle".into());
+    }
+    let primary = crate::sfcc::stage4_source_preflight_c::selected_pair_c(f)
+        .map_err(|_| "endpoint_primary_source")?;
+    let chord = original["tuning"]["curveChordTolMm"]
+        .as_f64()
+        .ok_or("endpoint_original_chord_tolerance")?;
+    let mut budget =
+        Transport::bind(f, primary, chord).map_err(|_| "endpoint_query_budget_bind")?;
+    let before = budget.charged_queries();
+    budget.phase("face_endpoint_transport_own_query");
+    budget
+        .reserve_external(1)
+        .map_err(|_| "endpoint_own_query_budget")?;
+    budget.external_direct_attempt();
+    let own = curve.point_at_checked(t).ok_or_else(|| {
+        format!(
+            "endpoint_original_own_query_failed: chart {chart}, t {:x}, charged {before}->{}",
+            t.to_bits(),
+            budget.charged_queries()
+        )
+    })?;
+    if own.map(f64::to_bits) != point.map(f64::to_bits) {
+        return Err("endpoint_original_own_query_identity".into());
+    }
+    let (_, _, refine) = curve
+        .traced_carriers()
+        .ok_or("endpoint_original_carriers")?;
+    let allowance = budget.allowance().min(8. * refine.curve_eps);
+    let distance = feature["originalToPhysicalFaceFeatureDistance"][1]
+        .as_f64()
+        .ok_or("endpoint_feature_distance")?;
+    if !allowance.is_finite() || allowance <= 0. || !distance.is_finite() || distance > allowance {
+        return Err("endpoint_original_association_allowance".into());
+    }
+    let mut lo = t.floor().max(curve.t_min);
+    let hi = (lo + 1.).min(curve.t_max);
+    if lo == hi {
+        lo = (hi - 1.).max(curve.t_min);
+    }
+    let tube = curve
+        .projection_tube(lo, hi)
+        .ok_or("endpoint_original_tube")?;
+    if !(0..3).all(|k| {
+        own[k] >= tube.0[k]
+            && own[k] <= tube.1[k]
+            && target[k].lo >= tube.0[k]
+            && target[k].hi <= tube.1[k]
+    }) {
+        return Err("endpoint_original_tube_membership".into());
+    }
+    if !curve.adjacent_strata.iter().all(|&sid| {
+        f.strata.get(sid).is_some_and(|s| {
+            (s.domain_contains(own, budget.allowance())
+                || curve.upper_source_member(&f.strata, sid, t, own, budget.allowance()))
+                && s.raw_field(own[0], own[1], own[2])
+                    .normalized_equation()
+                    .is_some_and(|v| v.value.is_finite() && v.value.abs() <= budget.allowance())
+        })
+    }) {
+        return Err("endpoint_original_source_contract".into());
+    }
+    let transport = endpoint_transport(domain, points, source, endpoint, target, tolerance)
+        .map_err(str::to_owned)?;
+    Ok(
+        json!({"featureGeometry":feature,"transport":transport,"chart":chart,"originalParameterBits":t.to_bits(),
+        "originalPointBits":point.map(f64::to_bits),"ownQueryBits":own.map(f64::to_bits),"originalFace":face,
+        "originalFaceRectangle":[low,high],"originalTube":[tube.0,tube.1],"retainedAssociationAllowance":allowance,
+        "ownToPhysicalFeatureImageUpper":distance,"originalOwnContractPass":true,"sameSourceAndPointInputsBound":true,
+        "targetIsExactCorrelatedPhysicalFeatureRoot":true,"fixedFaceFeatureEndpointTransportProved":true,
+        "originalParameterAssociationRetained":true,"exactIdealParameterizationProved":false,"entireFeatureCurveTransportProved":false,
+        "budgetScope":"separate proof-observation ledger; not component construction cost","chargedBefore":before,"chargedAfter":budget.charged_queries(),
