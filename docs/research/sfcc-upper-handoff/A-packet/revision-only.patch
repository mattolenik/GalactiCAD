+    let cert = bind(&root, &f.strata, &branch, 0.01).unwrap();
+    assert!(bind(&root, &f.strata, &branch, 0.).is_none());
+    assert!(bind(&root, &f.strata, &branch, 0.51).is_none());
+    assert!(bind(&root, &f.strata, &branch, f64::NAN).is_none());
+    let mut wrong = root.clone();
