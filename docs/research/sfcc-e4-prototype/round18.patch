+            if changed.contains(&f) {
+                let g = unpack_point(&oct.lat, f.1);
+                let side = if g[f.0] == base[f.0] {
+                    Some(0)
+                } else if g[f.0] == base[f.0] + stride {
+                    Some(1)
+                } else {
+                    None
+                };
