+#[test]
+fn stage4_component_b_original_source_attempt() {
+    let fixture: Value =
+        serde_json::from_str(include_str!("../../fixtures/shared-arc-full-knob.json")).unwrap();
+    let root =
+        crate::scene_bridge::build_csg_tree_from_json(fixture["sceneJson"].as_str().unwrap())
+            .unwrap();
+    let cube = SfccWorldCube {
+        min_x: fixture["cube"]["min"][0].as_f64().unwrap(),
+        min_y: fixture["cube"]["min"][1].as_f64().unwrap(),
+        min_z: fixture["cube"]["min"][2].as_f64().unwrap(),
+        size: fixture["cube"]["max"][0].as_f64().unwrap()
+            - fixture["cube"]["min"][0].as_f64().unwrap(),
+    };
+    let tuning = PipelineTuning::default();
+    let effective = super::diagnostic::effective_tuning(&tuning);
+    for (key, value) in effective.as_object().unwrap() {
+        let requested = &fixture["tuning"][key];
+        if value.is_number() && requested.is_number() {
+            assert_eq!(
+                value.as_f64(),
+                requested.as_f64(),
+                "fixture/native tuning drift: {key}"
+            );
+        } else {
+            assert_eq!(value, requested, "fixture/native tuning drift: {key}");
+        }
+    }
+    let context = crate::sfcc::pipeline::build_pipeline_context(&root, &cube, &tuning);
+    let f = &context.features;
+    let selected = selected_pair_c(f);
+    let mut report = json!({"stage":"FEATURE_SOURCE_PREFLIGHT_BEFORE_OCTREE","sourceConfigSha256":fixture["sourceConfigSha256"],
+        "fingerprint":f.fingerprint().to_string(),"effectiveTuning":super::diagnostic::effective_tuning(&tuning),
+        "constructionAttempted":false,"octreeBuilt":false,"facesPrepared":false,"fullComponentAccepted":false,"publicationReady":false});
+    let ids = match selected {
+        Ok(ids) => ids,
+        Err(reason) => {
+            report["outcome"] = json!({"kind":"refusal","reason":reason});
+            write_report(&report);
+            return;
+        }
+    };
+    report["sources"] = source_rows(f, ids);
+    match super::admit(f, ids, tuning.curve_chord_tol_mm) {
+        Err(refusal) => {
+            report["outcome"] = json!({"kind":"refusal","refusal":refusal});
+            report["topologyAndInterfaceAudits"] = json!("not_reached_no_private_candidate");
+            write_report(&report);
+            return;
+        }
+        Ok((_, _)) => {}
+    }
+    let _scope = request(f.fingerprint(), ids);
+    drop(context);
+    let result = crate::sfcc::pipeline::run_sfcc_pipeline(&root, &cube, &tuning);
+    assert!(
+        result.cancelled,
+        "private diagnostic must stop before publication"
+    );
+    let report: Value = serde_json::from_slice(
+        &std::fs::read(std::env::var("SFCC_STAGE4_COMPONENT_B_RECEIPT").unwrap()).unwrap(),
+    )
+    .unwrap();
+    assert_eq!(report["liveStatePreserved"], true);
+    assert_eq!(report["publicationReady"], false);
+}
