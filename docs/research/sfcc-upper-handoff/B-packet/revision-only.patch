+    let repeated = CsgNode::Max(vec![child.clone(), child]);
+    let p = [1., 0., 0.];
+    for kind in [BlendKind::Smin, BlendKind::Smax] {
+        for partner in [
+            crate::sdf::leaf_at(Shape::Sphere { r: 1. }, [10., 0., 0.]),
+            crate::sdf::leaf_at(Shape::Sphere { r: 20. }, [0.; 3]),
+            crate::sdf::leaf_at(Shape::Sphere { r: 1. }, [0.5, 0., 0.]),
+        ] {
+            let root = CsgNode::Blend {
+                kind,
+                mode: SminMode::Chamfer,
+                r: 1.,
+                n: 4.,
+                children: vec![repeated.clone(), partner],
+            };
+            let actual = sample_tree(&root, p);
+            let overridden = sample_override(&root, &[0], &FieldBranch::Child(0), &[1], p);
+            same(actual, overridden);
+            assert!(override_valid(
+                &root,
+                &[0],
+                &FieldBranch::Child(0),
+                &[1],
+                p,
+                1e-10
+            ));
+        }
+    }
+    let root = CsgNode::Blend {
+        kind: BlendKind::Smax,
+        mode: SminMode::Chamfer,
+        r: 1.,
+        n: 4.,
+        children: vec![
+            repeated,
+            crate::sdf::leaf_at(Shape::Sphere { r: 20. }, [0.; 3]),
