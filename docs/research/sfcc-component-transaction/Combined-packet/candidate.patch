+//! Request-local secondary alias preparation; live faces and source features stay immutable.
+use crate::sfcc::{
+    cell_mesh::component_consumers_b::{self, Consumer, Plan},
+    face_contour::FaceRecord,
+    feature_set::SfccFeatureSet,
+    octree::{SfccCell, SfccOctree},
+    point_table::PointTable,
+    shared_arc_plan::cell_faces,
+    shared_twisted_proof::{
+        correlated_c::transport_a::Transport,
+        exposure_a::{activation_a, activation_event_c, alias_face_b, alias_typed_face_b},
+    },
+};
+use crate::{math::grid::cell_aabb, sdf::CsgNode};
+use serde_json::{json, Value};
+use std::{
+    cell::Cell,
+    collections::{BTreeMap, BTreeSet, HashMap},
+    sync::Arc,
+};
+type FaceId = (usize, i64, i64);
+type Result<T> = std::result::Result<T, &'static str>;
+thread_local! {static ACTIVE:Cell<bool>=const{Cell::new(false)};}
+pub(crate) struct Scope(bool);
+impl Scope {
+    pub(crate) fn begin() -> Self {
+        Self(ACTIVE.with(|s| s.replace(true)))
+    }
+}
+impl Drop for Scope {
+    fn drop(&mut self) {
+        ACTIVE.with(|s| s.set(self.0));
+    }
+}
+pub(crate) fn enabled() -> bool {
+    ACTIVE.with(Cell::get)
+}
+pub(crate) fn note(key: &str, value: Value) {
+    super::DIAGNOSTIC.with(|s| {
+        if let Some(v) = s.borrow_mut().as_mut() {
+            v["secondaryTransactionA"][key] = value;
+        }
+    });
