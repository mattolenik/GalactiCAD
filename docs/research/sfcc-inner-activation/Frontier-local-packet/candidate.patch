+fn record(face: &Value) -> FaceRecord {
+    FaceRecord {
+        axis: face["face"][0].as_u64().unwrap() as usize,
+        key: face["face"][1].as_i64().unwrap(),
+        len: face["face"][2].as_i64().unwrap(),
+        pins: face["allPins"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .map(|p| FacePin {
+                curve_id: p["chart"].as_u64().unwrap() as usize,
+                point_id: p["point"].as_u64().unwrap() as usize,
+                t: f64::from_bits(p["parameterBits"].as_u64().unwrap()),
+            })
+            .collect(),
+        segments: face["segments"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .map(|s| FaceSegment {
+                a: s[0].as_u64().unwrap() as usize,
+                b: s[1].as_u64().unwrap() as usize,
+            })
+            .collect(),
+        interior_cycle: false,
+        consumed_fwd: face["consumedForward"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .map(|v| v.as_u64().unwrap() as u32)
+            .collect(),
+        consumed_rev: face["consumedReverse"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .map(|v| v.as_u64().unwrap() as u32)
+            .collect(),
+    }
+}
+fn points(face: &Value, record: &FaceRecord) -> PointTable {
+    let mut out = PointTable::new();
+    let max = record.pins.iter().map(|p| p.point_id).max().unwrap();
+    assert!(max < 100_000);
+    for id in 0..=max {
+        if let Some(row) = face["targetPins"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .find(|p| p["point"].as_u64().unwrap() as usize == id)
+        {
+            let p: [f64; 3] =
+                std::array::from_fn(|k| f64::from_bits(row["positionBits"][k].as_u64().unwrap()));
+            let t = f64::from_bits(row["parameterBits"].as_u64().unwrap());
+            let chart = row["chart"].as_u64().unwrap();
+            let key = format!("F{}:{}:{}:{:.12}", record.axis, record.key, chart, t);
+            assert_eq!(
+                format!("{:?}", PointKey::Str(key.clone())),
+                row["key"].as_str().unwrap()
+            );
+            assert_eq!(
+                out.get_or_create_str(&key, || [p[0], p[1], p[2], 0., 0., 0.]),
+                id
+            );
+        } else {
+            assert_eq!(out.add(0., 0., 0., 0., 0., 0.), id);
+        }
+    }
+    out
