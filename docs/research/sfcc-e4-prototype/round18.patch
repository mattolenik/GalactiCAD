+        let mut sum = I::point(0.);
+        for k in 0..3 {
+            sum = sum.add(square(I::point(points[slot][k]).sub(image[k])?)?)?;
+        }
+        upper[slot] = sqrt(sum)?.hi;
+    }
+    (epsilon.is_finite() && epsilon > 0. && upper.iter().all(|&d| d.is_finite())).then_some(upper)
+}
+
+fn associate_points(
+    points: [[f64; 3]; 2],
+    image: [I; 3],
+    epsilon: f64,
+) -> Result<[f64; 2], Option<[f64; 2]>> {
+    let upper = image_distances(points, image, epsilon).ok_or(None)?;
+    if upper.iter().any(|&d| d > epsilon) {
+        Err(Some(upper))
+    } else {
+        Ok(upper)
+    }
+}
