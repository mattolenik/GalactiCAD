+pub(crate) fn certify_consumed(
+    f: &SfccFeatureSet,
+    saved: &Value,
+    lat: &crate::math::grid::SfccLattice,
+    chord: f64,
+    surface: f64,
+) -> R<Value> {
+    if saved["sourceFingerprint"].as_str() != Some(f.fingerprint().to_string().as_str())
+        || !chord.is_finite()
+        || chord <= 0.
+        || !surface.is_finite()
+        || surface <= 0.
+        || saved["surfaceTolerance"].as_f64().map(f64::to_bits) != Some(surface.to_bits())
+        || saved["chordTolerance"].as_f64().map(f64::to_bits) != Some(chord.to_bits())
+    {
+        return Err("span_scope".into());
+    }
