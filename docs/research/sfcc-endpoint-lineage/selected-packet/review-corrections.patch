+fn safe_integers(value: &mut Value) {
+    match value {
+        Value::Number(n) => {
+            if let Some(v) = n.as_u64().filter(|&v| v > 9_007_199_254_740_991) {
+                *value = json!(format!("u64:{v:016x}"));
+            }
+        }
+        Value::Array(a) => a.iter_mut().for_each(safe_integers),
+        Value::Object(m) => m.values_mut().for_each(safe_integers),
+        _ => {}
+    }
+}
