+fn refinement_source(curve: &FeatureCurve, source: Value) -> Result<Value, &'static str> {
+    if !selected(curve) {
+        return Ok(source);
+    }
+    let index = STATE.with(|s| {
+        let slot = s.borrow();
+        let state = slot
+            .as_ref()
+            .ok_or("refinement_raw_reference_scope_missing")?;
+        let context = state
+            .curve
+            .ok_or("refinement_raw_reference_context_missing")?;
+        if context.id != curve.id || context.pair != curve.adjacent_strata {
+            return Err("refinement_raw_reference_context_mismatch");
+        }
+        let mut rows = state.rows.iter().filter(|r| {
+            r["kind"] == "raw_received" && r["raw"]["index"].as_u64() == Some(context.index as u64)
+        });
+        let row = rows.next().ok_or("refinement_raw_reference_missing")?;
+        if rows.next().is_some() {
+            return Err("refinement_raw_reference_ambiguous");
+        }
+        if row["data"] != source {
+            return Err("refinement_raw_reference_source_mismatch");
+        }
+        Ok(context.index)
+    })?;
+    Ok(json!({"reference":"raw_received.data","rawIndex":index}))
+}
+pub(crate) fn refinement(
+    curve: &FeatureCurve,
+    t: f64,
+    seed: [f64; 3],
+    best: Option<[f64; 3]>,
+    distance: f64,
+    limit: f64,
+) {
+    if active_curve() || in_window(seed) || best.is_some_and(in_window) {
+        if curve.index_polyline.len() > WORD_CAP {
+            refuse("refinement_source_cap");
+            return;
+        }
+        if !enabled() {
+            return;
+        }
+        let Some(source) = source_record(curve) else {
+            refuse("refinement_stored_carrier_descriptor_bound");
+            return;
+        };
+        let source = match refinement_source(curve, source) {
+            Ok(source) => source,
+            Err(reason) => {
+                refuse(reason);
+                return;
+            }
+        };
+        emit(
+            "refine_transition",
+            || json!({"source":source,"parameterHex":hex(t),"seedHex":point(seed),"selectedHex":best.map(point),"outputHex":point(best.unwrap_or(seed)),"reason":if best.is_some(){"accepted_projected_candidate"}else{"no_accepted_candidate_seed_retained"},"bestDistanceHex":hex(distance),"maxDistanceHex":hex(limit)}),
+        );
+    }
+}
