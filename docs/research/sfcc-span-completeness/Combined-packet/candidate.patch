+        return Err("face_join_not_strictly_inside".into());
+    }
+    let rho_q = |height: I| -> Option<I> {
+        quotient(
+            I::point(source.radius)
+                .add(mul(branch.ny, height)?)?
+                .add(branch.offset)?
+                .sub(I::point(source.chamfer_radius))?,
+            one_minus_nr,
+        )
+    };
+    let bottom_radius = rho_q(I::point(y.lo)).ok_or("face_lower_root")?;
+    let top_radius = rho_q(I::point(y.hi)).ok_or("face_upper_root")?;
+    if bottom_radius.lo <= x.lo.abs().max(x.hi.abs())
+        || bottom_radius.hi >= source.radius
+        || top_radius.lo <= source.radius
+    {
+        return Err("face_root_branch_order".into());
+    }
+    let bottom_z = sqrt(
+        square(bottom_radius)
+            .and_then(|v| v.sub(square(x)?))
+            .ok_or("face_lower_root")?,
+    )
+    .ok_or("face_lower_root")?;
