+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn fixture() -> (BTreeMap<usize, Point>, [Vec<usize>; 2], [Vec<usize>; 2]) {
+        let p = BTreeMap::from([
+            (0, [0., -0.5, 0.]),
+            (1, [0., 0., -1.]),
+            (2, [0., 0., 1.]),
+            (3, [0., -1., 1.]),
+            (4, [0., -1., -1.]),
+            (5, [0., 1., -1.]),
+            (6, [0., 1., 1.]),
+            (7, [0., 0.5, 0.]),
+        ]);
+        (
+            p,
+            [vec![1, 2, 3, 4], vec![2, 1, 5, 6]],
+            [
+                vec![0, 1, 2, 0, 2, 3, 0, 3, 4, 0, 4, 1],
+                vec![7, 2, 1, 7, 1, 5, 7, 5, 6, 7, 6, 2],
+            ],
+        )
+    }
+    #[test]
+    fn paired_b_two_disks_share_one_edge_and_tile_union() {
+        let (p, b, t) = fixture();
+        let d = audit([&b[0], &b[1]], [&t[0], &t[1]], [1, 2], &p).unwrap();
+        assert_eq!(d.report()["joinedProjectedDomainIsDisk"], true);
+        assert_eq!(d.report()["joinedBoundary"].as_array().unwrap().len(), 6);
+        assert!(combine_error(&d, &[0.001; 8], 0.01).is_ok());
+        assert!(combine_error(&d, &[0.001; 7], 0.01).is_err());
+        assert!(combine_error(&d, &[0.02; 8], 0.01).is_err());
+    }
+    #[test]
+    fn paired_b_refuses_renamed_shared_vertex_and_wrong_shared_edge() {
+        let (mut p, mut b, mut t) = fixture();
+        assert!(audit([&b[0], &b[1]], [&t[0], &t[1]], [1, 3], &p).is_err());
+        p.insert(8, p[&1]);
+        for id in b[1].iter_mut().chain(&mut t[1]) {
+            if *id == 1 {
+                *id = 8;
+            }
+        }
+        assert!(audit([&b[0], &b[1]], [&t[0], &t[1]], [1, 2], &p).is_err());
+    }
+    #[test]
+    fn paired_b_exact_cross_patch_contact_rejects_crossing_containment_and_t_junction() {
+        let p = BTreeMap::from([
+            (0, [0., 0., 0.]),
+            (1, [0., 4., 0.]),
+            (2, [0., 0., 4.]),
+            (3, [0., 0.5, 0.5]),
+            (4, [0., 1., 0.5]),
+            (5, [0., 0.5, 1.]),
+            (6, [0., -1., 1.]),
+            (7, [0., 2., 1.]),
+            (8, [0., 2., -1.]),
+            (9, [0., 2., 0.]),
+            (10, [0., 3., -1.]),
+            (11, [0., 1., -1.]),
+        ]);
+        assert!(!compatible_triangles(
+            [0, 1, 2],
+            [3, 4, 5],
+            &p,
+            [0, 1],
+            false
+        ));
+        assert!(!compatible_triangles(
+            [0, 1, 2],
+            [6, 7, 8],
+            &p,
+            [0, 1],
+            false
+        ));
+        assert!(!compatible_triangles(
+            [0, 1, 2],
+            [9, 10, 11],
+            &p,
+            [0, 1],
+            false
+        ));
+    }
+}
