+fn ident(id: usize) -> StratumIdentity {
+    StratumIdentity {
+        id,
+        owner_node_id: -1,
+        leaf_index: 0,
+        local_index: 0,
+        sign: 1.,
+    }
+}
+fn line(ys: &[f64]) -> FeatureCurve {
+    let a = Stratum::plane(ident(0), 1., 0., 0., 0.);
+    let b = Stratum::plane(ident(1), 0., 0., 1., 0.);
+    make_traced_curve(
+        0,
+        [0, 1],
+        ys.iter().flat_map(|&y| [0., y, 0.]).collect(),
+        false,
+        a,
+        b,
+        crate::sfcc::feature_curves::TracedRefine {
+            curve_eps: 1e-12,
+            min_cross: 1e-3,
+            max_displacement: 0.1,
+        },
+        -1,
+    )
+}
+#[test]
+fn connection_c_pinned_height_handles_rounding_plateaus_and_rejects_reversals() {
+    for ys in [
+        vec![1., 1f64.next_up(), 1f64.next_up().next_up()],
+        vec![1f64.next_up().next_up(), 1f64.next_up(), 1.],
+    ] {
+        let c = line(&ys);
+        let direction = (ys[2] - ys[0]).signum();
+        let mut seen = Vec::new();
+        for i in 0..=128 {
+            let t = i as f64 / 64.;
+            let q = c.height_pinned_point_c([0., 2.], t).unwrap();
+            seen.push(q[1]);
+        }
+        assert!(seen.windows(2).all(|w| direction * (w[1] - w[0]) >= 0.));
+        assert!(
+            seen.windows(2).any(|w| w[1] == w[0]),
+            "rounded order cannot promise strict increase"
+        );
+        for (i, &y) in ys.iter().enumerate() {
+            assert_eq!(
+                c.height_pinned_point_c([0., 2.], i as f64).unwrap()[1].to_bits(),
+                y.to_bits()
+            );
+        }
+    }
+    let reversed = line(&[1., 2., 1.]);
+    assert!(reversed.height_pinned_point_c([0., 2.], 0.5).is_none());
+    assert!(reversed.height_pinned_point_c([0., 1.], 0.5).is_some());
+    let a = Stratum::plane(ident(0), 1., 0., 0., 0.);
+    let b = Stratum::plane(ident(1), 0., 1., 0., 0.);
+    assert!(
+        crate::sfcc::newton::project_to_carrier_pair_at_height_c(
+            &a,
+            &b,
+            [0., 0., 0.],
+            1e-12,
+            1e-3,
+            0.1
+        )
+        .is_none(),
+        "full carrier rank does not imply XZ rank"
+    );
+    let z = Stratum::plane(ident(1), 0., 0., 1., 0.);
+    assert!(
+        crate::sfcc::newton::project_to_carrier_pair_at_height_c(
+            &a,
+            &z,
+            [1., 2., 1.],
+            1e-12,
+            1e-3,
+            0.
+        )
+        .is_none(),
+        "fixed displacement budget"
+    );
+}
