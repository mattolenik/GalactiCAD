+//! Clone-owned storage reservation for the isolated private source view.
+//! Shared Arc payloads are retained, not recursively cloned. This bounds the
+//! clone's requested layouts plus declared headroom; it is not process RSS.
+use super::feature_set::SfccFeatureSet;
+use std::mem::{align_of, size_of};
+
+pub(crate) const LIMIT: usize = 64 * 1024 * 1024;
+pub(crate) const LEDGER_RESERVATION: usize = 16 * 1024;
+pub(crate) const MAX_ROWS: usize = 32;
+#[derive(Clone, Debug)]
+#[cfg_attr(feature = "serde", derive(serde::Serialize))]
+pub(crate) struct Failure {
+    pub category: &'static str,
+    pub operation: &'static str,
+    pub lhs: usize,
+    pub rhs: usize,
+}
+pub(crate) type Result<T> = std::result::Result<T, Failure>;
+fn add(category: &'static str, a: usize, b: usize) -> Result<usize> {
+    a.checked_add(b).ok_or(Failure {
+        category,
+        operation: "checked_add_overflow",
+        lhs: a,
+        rhs: b,
+    })
+}
+fn mul(category: &'static str, a: usize, b: usize) -> Result<usize> {
+    a.checked_mul(b).ok_or(Failure {
+        category,
+        operation: "checked_mul_overflow",
+        lhs: a,
+        rhs: b,
+    })
+}
+#[derive(Clone, Debug, Default)]
+#[cfg_attr(feature = "serde", derive(serde::Serialize))]
+pub(crate) struct Row {
+    pub category: &'static str,
+    pub allocations: usize,
+    pub elements: usize,
+    pub layout_bytes: usize,
+    pub reserved_bytes: usize,
+    pub alignment: usize,
+    pub table_capacity_sum: usize,
+    pub table_bucket_upper_sum: usize,
+    pub table_element_size: Option<usize>,
+    pub shared_handles: usize,
+    pub shared_handle_inline_bytes: usize,
+}
+#[derive(Clone, Debug)]
+#[cfg_attr(feature = "serde", derive(serde::Serialize))]
+pub(crate) struct Ledger {
+    pub rows: Vec<Row>,
+    pub owned_reservation: usize,
+}
+impl Ledger {
+    pub(crate) fn new() -> Self {
+        Self {
+            rows: Vec::with_capacity(MAX_ROWS),
+            owned_reservation: 0,
+        }
+    }
+    fn row(&mut self, category: &'static str) -> Result<&mut Row> {
+        if let Some(i) = self.rows.iter().position(|r| r.category == category) {
+            return Ok(&mut self.rows[i]);
+        }
+        if self.rows.len() >= MAX_ROWS {
+            return Err(Failure {
+                category,
+                operation: "ledger_category_cap",
+                lhs: self.rows.len(),
+                rhs: MAX_ROWS,
+            });
+        }
+        self.rows.push(Row {
+            category,
+            ..Row::default()
+        });
+        Ok(self.rows.last_mut().unwrap())
+    }
+    pub(crate) fn allocation(
+        &mut self,
+        category: &'static str,
+        elements: usize,
+        element_size: usize,
+        alignment: usize,
+    ) -> Result<()> {
+        if elements == 0 || element_size == 0 {
+            return Ok(());
+        }
+        if alignment == 0 || !alignment.is_power_of_two() || alignment > 64 {
+            return Err(Failure {
+                category,
+                operation: "unsupported_alignment",
+                lhs: alignment,
+                rhs: 64,
+            });
+        }
+        let payload = mul(category, elements, element_size)?;
+        // Double requested layout plus128 bytes per allocation and alignment
+        // slack: explicit allocation-class/headroom reservation, not Debug text.
+        let reserved = add(
+            category,
+            add(category, mul(category, payload, 2)?, 128)?,
+            alignment - 1,
+        )?;
+        let total = add(category, self.owned_reservation, reserved)?;
+        let row = self.row(category)?;
+        if row.alignment != 0 && row.alignment != alignment {
+            return Err(Failure {
+                category,
+                operation: "mixed_category_alignment",
+                lhs: row.alignment,
+                rhs: alignment,
+            });
+        }
+        row.alignment = alignment;
+        let values = (
+            add(category, row.allocations, 1)?,
+            add(category, row.elements, elements)?,
+            add(category, row.layout_bytes, payload)?,
+            add(category, row.reserved_bytes, reserved)?,
+        );
+        (
+            row.allocations,
+            row.elements,
+            row.layout_bytes,
+            row.reserved_bytes,
+        ) = values;
+        self.owned_reservation = total;
+        Ok(())
+    }
+    pub(crate) fn vector<T>(&mut self, category: &'static str, v: &Vec<T>) -> Result<()> {
+        self.allocation(category, v.capacity(), size_of::<T>(), align_of::<T>())
+    }
+    pub(crate) fn boxed<T>(&mut self, category: &'static str) -> Result<()> {
+        self.allocation(category, 1, size_of::<T>(), align_of::<T>())
+    }
+    pub(crate) fn inline_copy<T: Copy>(&mut self, _: &T) {}
+    pub(crate) fn shared<T: ?Sized>(
+        &mut self,
+        category: &'static str,
+        handle: &std::sync::Arc<T>,
+    ) -> Result<()> {
+        let row = self.row(category)?;
+        row.shared_handles = add(category, row.shared_handles, 1)?;
+        row.shared_handle_inline_bytes = add(
+            category,
+            row.shared_handle_inline_bytes,
+            std::mem::size_of_val(handle),
+        )?;
+        Ok(())
+    }
+    pub(crate) fn table<T>(&mut self, category: &'static str, capacity: usize) -> Result<()> {
+        if capacity == 0 {
+            return Ok(());
+        }
+        if align_of::<T>() > 16 {
+            return Err(Failure {
+                category,
+                operation: "unsupported_hash_entry_alignment",
+                lhs: align_of::<T>(),
+                rhs: 16,
+            });
+        }
+        // Verified against ROOT's Rust1.99/hashbrown0.17.1. Without removals,
+        // capacity is the full effective capacity; bucket count <=2*(cap+1).
+        // Include one control byte/bucket and64 bytes for trailing group+padding.
+        let buckets = mul(category, add(category, capacity, 1)?, 2)?;
+        let layout = add(
+            category,
+            mul(category, buckets, add(category, size_of::<T>(), 1)?)?,
+            64,
+        )?;
+        self.allocation(category, layout, 1, align_of::<T>().max(16))?;
+        let row = self.row(category)?;
+        row.table_capacity_sum = add(category, row.table_capacity_sum, capacity)?;
+        row.table_bucket_upper_sum = add(category, row.table_bucket_upper_sum, buckets)?;
+        row.table_element_size = Some(size_of::<T>());
+        Ok(())
+    }
+    pub(crate) fn unsupported(&self, category: &'static str, operation: &'static str) -> Failure {
+        Failure {
+            category,
+            operation,
+            lhs: 0,
+            rhs: 0,
+        }
+    }
+}
+#[derive(Debug)]
+#[cfg_attr(feature = "serde", derive(serde::Serialize))]
+pub(crate) struct Report {
+    pub staged_bytes: usize,
+    pub staged_semantics: &'static str,
+    pub feature_inline_bytes: usize,
+    pub accounting_overhead_bytes: usize,
+    pub native_report_storage_bound: usize,
+    pub native_row_capacity: usize,
+    pub ledger: Ledger,
+    pub combined_bytes: Option<usize>,
+    pub complete: bool,
+    pub allowed: bool,
+    pub failure: Option<Failure>,
+    pub cap: usize,
+    pub scope: &'static str,
+}
+pub(crate) fn inspect(f: &SfccFeatureSet, staged: usize, staged_semantics: &'static str) -> Report {
+    let mut ledger = Ledger::new();
+    let walk = f.private_owned_storage_a(&mut ledger);
+    let complete = walk.is_ok();
+    let mut failure = walk.err();
+    let combined = (|| {
+        let base = add("combined", staged, size_of::<SfccFeatureSet>())?;
+        let base = add("combined", base, LEDGER_RESERVATION)?;
+        add("combined", base, ledger.owned_reservation)
+    })();
+    let combined_bytes = match combined {
+        Ok(n) => Some(n),
+        Err(e) => {
+            if failure.is_none() {
+                failure = Some(e);
+            }
+            None
+        }
+    };
+    if failure.is_none() && combined_bytes.is_some_and(|n| n > LIMIT) {
+        failure = Some(Failure {
+            category: "combined",
+            operation: "64MiB_cap",
+            lhs: combined_bytes.unwrap(),
+            rhs: LIMIT,
+        });
+    }
+    let native_row_capacity = ledger.rows.capacity();
+    Report{native_report_storage_bound:super::private_storage_observation::NATIVE_STORAGE_BOUND,native_row_capacity,staged_bytes:staged,staged_semantics,feature_inline_bytes:size_of::<SfccFeatureSet>(),accounting_overhead_bytes:LEDGER_RESERVATION,ledger,combined_bytes,complete,allowed:failure.is_none(),failure,cap:LIMIT,scope:"owned clone layouts with explicit allocation headroom plus supplied staging; excludes retained immutable Arc payloads and process RSS"}
+}
