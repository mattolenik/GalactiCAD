+//! Consumed curve-49 edges mapped to one source-exposed closed arc; no raw Newton continuity claim.
+use super::*;
+use crate::sfcc::shared_twisted_proof::correlated_c::transport_a::Transport;
+use std::collections::BTreeMap;
+type R<T> = std::result::Result<T, String>;
+
+struct Arc<'a> {
+    source: Source<'a>,
+    branch: activation_a::MeridianBound,
+    level: I,
+    y: I,
+    terminal: Image,
+    z_end: f64,
+    generated: bool,
+}
+impl<'a> Arc<'a> {
+    fn bind(
+        f: &'a SfccFeatureSet,
+        chart: usize,
+        point: [f64; 3],
+        z_end: f64,
+        generated: bool,
+    ) -> Option<Self> {
+        let source = Source::bind(f, chart)?;
+        if source.p.nx2 != 0. || source.p.nz2 != 1. || !z_end.is_finite() {
+            return None;
+        }
+        let branch = activation_a::meridian_bound(
+            source.groove,
+            I::point(source.radius),
+            I::point(point[1]),
+        )?;
+        let level = if generated {
+            div(I::point(source.offset), source.weight)?
+        } else {
+            I::point(source.chamfer_radius)
+        };
+        if level.lo <= 0. {
+            return None;
+        }
+        let y = quotient(
+            level
+                .sub(mul(branch.nr, I::point(source.radius))?)?
+                .sub(branch.offset)?,
+            branch.ny,
+        )?;
+        let ly = y.sub(I::point(source.p.pos_y))?;
+        if !source.p.h.is_finite() || source.p.h <= 0. || ly.lo < -source.p.h || ly.hi > source.p.h
+        {
+            return None;
+        }
+        let u = sqrt(square(I::point(source.radius))?.sub(square(I::point(source.p.v0z))?)?)?;
+        if u.lo <= 0. {
+            return None;
+        }
+        let v = I::point(source.p.v0z);
+        upper_source_a::finite_profile_level(source.p, source.native, [u, v], I::point(0.))?;
+        let (sn, cs) =
+            sin_cos(div(ly.add(I::point(source.p.h))?, 2. * source.p.h)?.mul(source.p.twist_rad)?)?;
+        let terminal = [
+            mul(u, cs)?
+                .sub(mul(v, sn)?)?
+                .add(I::point(source.center[0]))?,
+            y,
+            mul(u, sn)?
+                .add(mul(v, cs)?)?
+                .add(I::point(source.center[2]))?,
+        ];
+        if terminal[0].hi >= source.center[0]
+            || terminal[2].lo <= source.center[2]
+            || terminal[2].hi >= z_end
+            || z_end >= source.center[2] + source.radius
+        {
+            return None;
+        }
+        let check = activation_a::meridian_bound(source.groove, I::point(source.radius), y)?;
+        if !same_meridian(branch, check) || abs_lower(branch.ny) <= 0. {
+            return None;
+        }
+        Some(Self {
+            source,
+            branch,
+            level,
+            y,
+            terminal,
+            z_end,
+            generated,
+        })
+    }
+    fn image(&self, z: I) -> Option<Image> {
+        let rz = z.sub(I::point(self.source.center[2]))?;
+        let rad = square(I::point(self.source.radius))?.sub(square(rz)?)?;
+        if rz.lo <= 0. || rad.lo <= 0. {
+            return None;
+        }
+        Some([
+            sqrt(rad)?.mul(-1.)?.add(I::point(self.source.center[0]))?,
+            self.y,
+            z,
+        ])
+    }
+    fn piece(&self, s: I) -> Option<Value> {
+        if s.lo < 0. || s.hi > 1. {
+            return None;
+        }
+        let z = self.terminal[2].add(mul(s, I::point(self.z_end).sub(self.terminal[2])?)?)?;
+        let p = self.image(z)?;
+        let source = &self.source;
+        let x = p[0].sub(I::point(source.center[0]))?;
+        let rz = p[2].sub(I::point(source.center[2]))?;
+        let ly = self.y.sub(I::point(source.p.pos_y))?;
+        let (sn, cs) =
+            sin_cos(div(ly.add(I::point(source.p.h))?, 2. * source.p.h)?.mul(source.p.twist_rad)?)?;
+        let u = mul(x, cs)?.add(mul(rz, sn)?)?;
+        let v = mul(rz, cs)?.sub(mul(x, sn)?)?;
+        let e = v.sub(I::point(source.p.v0z))?;
+        let profile = upper_source_a::finite_profile_level(source.p, source.native, [u, v], e)?;
+        let native_cap = upper_source_a::cap_margin(self.y, source.p.pos_y, source.p.h, e)?;
+        let cylinder_cap =
+            upper_source_a::cap_margin(self.y, source.center[1], source.half, I::point(0.))?;
+        let xprime = quotient(rz, x.mul(-1.)?)?;
+        let ez = mul(sn.mul(-1.)?, xprime)?.add(cs)?;
+        if ez.hi >= 0. {
+            return None;
+        }
+        let other = activation_a::meridian_bound(source.other, I::point(source.radius), self.y)?;
+        let groove = activation_a::meridian_bound(source.groove, I::point(source.radius), self.y)?;
+        if other.distance.lo <= source.inner_radius
+            || groove.distance.lo <= 0.
+            || !same_meridian(groove, self.branch)
