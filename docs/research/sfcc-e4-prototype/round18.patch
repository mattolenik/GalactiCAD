+//! Checked live staging terms and bounded native resource observations.
+//! JSON materialization belongs to the existing post-constructor diagnostic.
+use super::source_storage_a::{Failure, Ledger, Report, LIMIT, MAX_ROWS};
+use std::{
+    cell::RefCell,
+    mem::{align_of, size_of},
+};
+
+#[derive(Clone, Copy, Debug)]
+#[cfg_attr(feature = "serde", derive(serde::Serialize))]
+pub(crate) enum Input {
+    PointCount(usize),
+    Face {
+        axis: usize,
+        key: i64,
+        length: i64,
+        segments: usize,
+        pins: usize,
+    },
+    PointKey {
+        point: usize,
+        bytes: usize,
+    },
+    Formula,
+}
+#[derive(Debug)]
+#[cfg_attr(feature = "serde", derive(serde::Serialize))]
+pub(crate) struct StagingFailure {
+    pub arithmetic: Failure,
+    pub input: Input,
+}
+#[derive(Debug, Default)]
+#[cfg_attr(feature = "serde", derive(serde::Serialize))]
+pub(crate) struct Terms {
+    pub items_times_512: Option<usize>,
+    pub points_times_1024: Option<usize>,
+    pub key_bytes_times_4: Option<usize>,
+    pub helper_16384_times_1024: Option<usize>,
+    pub pieces_128_times_4096: Option<usize>,
+}
+#[derive(Debug)]
+#[cfg_attr(feature = "serde", derive(serde::Serialize))]
+pub(crate) struct StagingReport {
+    pub staged_items: Option<usize>,
+    pub needed_point_count: usize,
+    pub point_key_bytes: Option<usize>,
+    pub items_prefix: usize,
+    pub key_bytes_prefix: usize,
+    pub terms: Terms,
+    pub fixed_helper_bytes: Option<usize>,
+    pub staged_bytes: Option<usize>,
+    pub cap: usize,
+    pub allowed: bool,
+    pub failure: Option<StagingFailure>,
+    pub scope: &'static str,
+    pub historical_round16_staged_bytes: Option<usize>,
+}
+impl StagingReport {
+    fn fail(
+        &mut self,
+        category: &'static str,
+        operation: &'static str,
+        lhs: usize,
+        rhs: usize,
+        input: Input,
+    ) {
+        if self.failure.is_none() {
+            self.failure = Some(StagingFailure {
+                arithmetic: Failure {
+                    category,
+                    operation,
+                    lhs,
+                    rhs,
+                },
+                input,
+            });
+        }
+    }
+    fn product(
+        &mut self,
+        category: &'static str,
+        n: usize,
+        factor: usize,
+        input: Input,
+    ) -> Option<usize> {
+        let value = n.checked_mul(factor);
+        if value.is_none() {
+            self.fail(category, "checked_mul_overflow", n, factor, input);
+        }
+        value
+    }
+}
+/// Inputs are borrowed counts/keys from the live required faces/needed points.
+/// Synthetic controls use this SAME checked path and label their input scope.
+pub(crate) fn staging(
+    faces: impl IntoIterator<Item = (usize, i64, i64, usize, usize)>,
+    keys: impl IntoIterator<Item = (usize, usize)>,
+    points: usize,
+    scope: &'static str,
+) -> StagingReport {
+    let mut out = StagingReport {
+        staged_items: None,
+        needed_point_count: points,
+        point_key_bytes: None,
+        items_prefix: 0,
+        key_bytes_prefix: 0,
+        terms: Terms::default(),
+        fixed_helper_bytes: None,
+        staged_bytes: None,
+        cap: LIMIT,
+        allowed: false,
+        failure: None,
+        scope,
+        historical_round16_staged_bytes: None,
+    };
+    out.terms.points_times_1024 =
+        out.product("staging.points", points, 1024, Input::PointCount(points));
+    out.terms.helper_16384_times_1024 = out.product("staging.helper", 16384, 1024, Input::Formula);
+    out.terms.pieces_128_times_4096 = out.product("staging.pieces", 128, 4096, Input::Formula);
+    out.fixed_helper_bytes = out
+        .terms
+        .helper_16384_times_1024
+        .zip(out.terms.pieces_128_times_4096)
+        .and_then(|(a, b)| a.checked_add(b));
+    if out.fixed_helper_bytes.is_none() {
+        out.fail(
+            "staging.fixed_helper",
+            "checked_add_overflow",
+            out.terms.helper_16384_times_1024.unwrap_or(0),
+            out.terms.pieces_128_times_4096.unwrap_or(0),
+            Input::Formula,
+        );
+    }
+    let mut items_complete = true;
+    for (axis, key, length, segments, pins) in faces {
+        let input = Input::Face {
+            axis,
+            key,
+            length,
+            segments,
+            pins,
+        };
+        let Some(next) = out.items_prefix.checked_add(segments) else {
+            out.fail(
+                "staging.segment_sum",
+                "checked_add_overflow",
+                out.items_prefix,
+                segments,
+                input,
+            );
+            items_complete = false;
+            break;
+        };
+        out.items_prefix = next;
+        let Some(next) = out.items_prefix.checked_add(pins) else {
+            out.fail(
+                "staging.pin_sum",
+                "checked_add_overflow",
+                out.items_prefix,
+                pins,
+                input,
+            );
+            items_complete = false;
+            break;
+        };
+        out.items_prefix = next;
+    }
+    if items_complete {
+        out.staged_items = Some(out.items_prefix);
+        out.terms.items_times_512 =
+            out.product("staging.items", out.items_prefix, 512, Input::Formula);
+    }
+    let mut keys_complete = true;
+    for (point, bytes) in keys {
+        let Some(next) = out.key_bytes_prefix.checked_add(bytes) else {
+            out.fail(
+                "staging.key_sum",
+                "checked_add_overflow",
+                out.key_bytes_prefix,
+                bytes,
+                Input::PointKey { point, bytes },
+            );
+            keys_complete = false;
+            break;
+        };
+        out.key_bytes_prefix = next;
+    }
+    if keys_complete {
+        out.point_key_bytes = Some(out.key_bytes_prefix);
+        out.terms.key_bytes_times_4 =
+            out.product("staging.key_bytes", out.key_bytes_prefix, 4, Input::Formula);
+    }
+    let terms = [
+        out.terms.items_times_512,
+        out.terms.points_times_1024,
+        out.terms.key_bytes_times_4,
+        out.terms.helper_16384_times_1024,
+        out.terms.pieces_128_times_4096,
+    ];
+    let mut sum = Some(0usize);
+    for term in terms {
+        sum = match (sum, term) {
+            (Some(a), Some(b)) => match a.checked_add(b) {
+                Some(v) => Some(v),
+                None => {
+                    out.fail(
+                        "staging.combined",
+                        "checked_add_overflow",
+                        a,
+                        b,
+                        Input::Formula,
+                    );
+                    None
+                }
+            },
+            _ => None,
+        };
+    }
+    out.staged_bytes = sum;
+    if let Some(total) = sum {
+        if total > LIMIT {
+            out.fail("staging", "64MiB_cap", total, LIMIT, Input::Formula);
+        }
+    }
+    out.allowed = out.failure.is_none() && sum.is_some();
+    out
+}
+
+#[derive(Debug, Default)]
+#[cfg_attr(feature = "serde", derive(serde::Serialize))]
+pub(crate) struct Observation {
+    pub staging: Option<StagingReport>,
+    pub source: Option<Report>,
+}
+// One preallocated row buffer, with the SAME layout headroom policy as A.
+// Inline allowance covers retained state plus builder/caller move locations,
+// two row temporaries and error temporaries. No JSON tree is covered here.
+pub(crate) const NATIVE_STORAGE_BOUND: usize =
+    2 * MAX_ROWS * size_of::<super::source_storage_a::Row>()
+        + 128
+        + align_of::<super::source_storage_a::Row>()
+        - 1
+        + size_of::<RefCell<Option<Observation>>>()
+        + 3 * size_of::<Report>()
+        + 3 * size_of::<StagingReport>()
+        + 2 * size_of::<Ledger>()
+        + 2 * size_of::<super::source_storage_a::Row>()
+        + 2 * size_of::<Failure>()
+        + size_of::<[Option<usize>; 5]>()
+        + size_of::<Terms>()
+        + size_of::<Input>()
+        + size_of::<StagingFailure>();
+const _: () = assert!(NATIVE_STORAGE_BOUND <= super::source_storage_a::LEDGER_RESERVATION);
+thread_local! {static OBSERVATION:RefCell<Option<Observation>>=const{RefCell::new(None)};}
+pub(crate) struct Scope;
+pub(crate) fn begin() -> Scope {
+    OBSERVATION.with(|s| {
+        let mut state = s.borrow_mut();
+        assert!(state.is_none(), "nested native storage observation");
+        *state = Some(Observation::default());
+    });
+    Scope
+}
+impl Scope {
+    pub(crate) fn take(self) -> Observation {
+        OBSERVATION
+            .with(|s| s.borrow_mut().take())
+            .unwrap_or_default()
+    }
+}
+impl Drop for Scope {
+    fn drop(&mut self) {
+        OBSERVATION.with(|s| {
+            s.borrow_mut().take();
+        });
+    }
+}
+pub(crate) fn record_staging(report: StagingReport) {
+    OBSERVATION.with(|s| {
+        if let Some(v) = s.borrow_mut().as_mut() {
+            v.staging = Some(report);
+        }
+    });
+}
+/// Drop a previous ledger before constructing another, so repeated focused
+/// probes do not hold two row buffers under one native-storage reservation.
+pub(crate) fn prepare_source() {
+    OBSERVATION.with(|s| {
+        if let Some(v) = s.borrow_mut().as_mut() {
+            v.source.take();
+        }
+    });
+}
+pub(crate) fn record_source(report: Report) {
+    OBSERVATION.with(|s| {
+        if let Some(v) = s.borrow_mut().as_mut() {
+            v.source = Some(report);
+        }
+    });
+}
+
