+pub(crate) fn certify(
+    features: &SfccFeatureSet,
+    a: usize,
+    b: usize,
+    lo: [f64; 3],
+    hi: [f64; 3],
+) -> Option<Certificate> {
+    if !(0..3).all(|k| lo[k].is_finite() && hi[k].is_finite() && lo[k] <= hi[k]) {
+        return None;
+    }
+    let ca = features.curves.get(a)?;
+    let cb = features.curves.get(b)?;
+    let common = *ca.adjacent_strata.iter().find(|&&id| {
+        cb.adjacent_strata.contains(&id) && features.strata[id].certificate_cylinder().is_some()
+    })?;
+    let ia = *ca.adjacent_strata.iter().find(|&&id| id != common)?;
+    let ib = *cb.adjacent_strata.iter().find(|&&id| id != common)?;
+    let (sa, sb) = (&features.strata[ia], &features.strata[ib]);
+    let mut candidates = Vec::new();
+    if let Some(r) = native_restriction(sa, sb).or_else(|| native_restriction(sb, sa)) {
+        candidates.push(r);
+    }
+    if ia == ib {
+        // The single Field curve may be the first graph edge. Its source leaf
+        // still supplies the equation; no nearest-carrier assignment is made.
+        for s in &features.strata {
+            if let Some((p, l, o, r)) = s.round_twisted_source(sa) {
+                candidates.push((p, l, Some((o, r))));
+            }
+        }
+    }
+    for (p, leaf, other) in candidates {
+        let Some((_, g, _, _)) = twisted(p, lo, hi) else {
+            continue;
+        };
+        if source_restrictions(p, leaf, other, lo, hi).is_none() {
+            continue;
+        }
+        let cylinder = features.strata[common].certificate_cylinder()?;
+        let Some((_, radial)) = radial(cylinder.0, cylinder.1, cylinder.2, lo, hi) else {
+            continue;
+        };
+        let proof = Certificate {
+            p,
+            cylinder,
+            lo,
+            hi,
+            jacobian: [radial, g],
+        };
+        if (0..3).any(|axis| proof.unique_face(axis)) {
+            return Some(proof);
+        }
+    }
+    None
+}
