+        lo = (hi - 1.).max(curve.t_min);
+    }
+    let tube = curve.projection_tube(lo, hi).unwrap();
+    let residuals = |p: [f64; 3]| -> Vec<Value> {
+        curve.adjacent_strata.iter().map(|&sid|{
+        let s=&f.strata[sid];let v=s.raw_field(p[0],p[1],p[2]).normalized_equation().unwrap();
+        json!({"stratum":sid,"normalizedResidual":v.value,"strictResidualPass":v.value.is_finite()&&v.value.abs()<=refine.curve_eps,
+            "strictDomainPass":s.domain_contains(p,refine.curve_eps)||curve.upper_source_member(&f.strata,sid,t,p,refine.curve_eps)})
+    }).collect()
+    };
+    let candidate_checks = residuals(candidate);
+    let own_checks = residuals(own);
+    let allowance = budget.allowance().min(8. * refine.curve_eps);
+    let own_physical = distance(own.map(I::point), make(physical)).unwrap()[1];
+    let own_generated = distance(own.map(I::point), make(generated)).unwrap()[1];
+    let direct = distance(candidate.map(I::point), own.map(I::point)).unwrap()[1];
+    let mut upper_grid = grid;
+    upper_grid[1] += face[2];
+    upper_grid[2] += face[2];
+    let low_face = crate::math::grid::point_to_world(&lat, grid[0], grid[1], grid[2]);
+    let high_face =
+        crate::math::grid::point_to_world(&lat, upper_grid[0], upper_grid[1], upper_grid[2]);
+    let face_contains =
+        |image: Image| (1..3).all(|k| image[k].lo > low_face[k] && image[k].hi < high_face[k]);
+    let candidate_physical = distance(candidate.map(I::point), make(physical)).unwrap()[1];
+    let candidate_generated = distance(candidate.map(I::point), make(generated)).unwrap()[1];
+    let original_contract_pass = curve.adjacent_strata.iter().all(|&sid| {
+        let s = &f.strata[sid];
+        (s.domain_contains(own, budget.allowance())
+            || curve.upper_source_member(&f.strata, sid, t, own, budget.allowance()))
+            && s.raw_field(own[0], own[1], own[2])
+                .normalized_equation()
+                .is_some_and(|v| v.value.is_finite() && v.value.abs() <= budget.allowance())
+    });
+    let admitted = original_contract_pass
+        && candidate_physical <= allowance
+        && candidate_generated <= allowance
+        && contains(tube, own.map(I::point))
+        && own_physical <= allowance
+        && own_generated <= allowance
+        && direct <= allowance
+        && face_contains(make(physical))
+        && face_contains(make(generated))
+        && contains(tube, make(physical))
+        && contains(tube, make(generated))
+        && contains(tube, candidate.map(I::point))
+        && candidate_checks
+            .iter()
+            .all(|r| r["strictResidualPass"] == true && r["strictDomainPass"] == true);
+    proof["numericalAssociation"] = json!({"originalParameterBits":t.to_bits(),"originalPointBits":point.map(f64::to_bits),"ownQueryBits":own.map(f64::to_bits),
+        "ownStrictCarrierChecks":own_checks,"candidateStrictCarrierChecks":candidate_checks,"strictCarrierResidualLimit":refine.curve_eps,
+        "primaryAssociationAllowance":budget.allowance(),"curve49FaceAllowance":8.*refine.curve_eps,"retainedAssociationAllowance":allowance,
+        "originalOwnContractPass":original_contract_pass,"candidateToPhysicalImageUpper":candidate_physical,"candidateToGeneratedImageUpper":candidate_generated,"ownInOriginalTube":contains(tube,own.map(I::point)),
+        "ownToPhysicalFeatureUpper":own_physical,"ownToGeneratedFeatureUpper":own_generated,"candidateToOwnUpper":direct,
+        "originalFace":face,"originalFaceRectangle":[low_face,high_face],"physicalFeatureImageStrictlyInFace":face_contains(make(physical)),"generatedFeatureImageStrictlyInFace":face_contains(make(generated)),
+        "originalTube":[tube.0,tube.1],"physicalFeatureImageInTube":contains(tube,make(physical)),"generatedFeatureImageInTube":contains(tube,make(generated)),
+        "candidateAdmittedAsOriginalParameterAssociation":admitted,"parameterContinuityOrExactIdealParameterizationProved":false,
+        "chargedBefore":before,"chargedAfter":budget.charged_queries(),"newOwnQueryAttempts":1,"limitsChanged":false,"mutationPerformed":false});
+    if let Ok(path) = std::env::var("SFCC_FEATURE49_A_RECEIPT") {
+        std::fs::write(path, serde_json::to_vec_pretty(&proof).unwrap()).unwrap();
+    }
+    assert!(proof["physicalFeatureZeroAndExposureProved"] == true);
+    assert_eq!(budget.charged_queries(), before + 1);
+}
